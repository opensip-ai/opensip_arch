# Python bytecode. The corpus's checkers are always invoked as `python3 -I -B`,
# which suppresses these; any .pyc present is the residue of an invocation that
# omitted -B. They are build artifacts, never evidence.
__pycache__/
*.pyc

# Documentation tooling residue (never evidence)
__pycache__/
*.pyc
*.sqlite-shm
*.sqlite-wal
