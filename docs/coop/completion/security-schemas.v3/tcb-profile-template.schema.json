  "supportedVersionOrBuildSelector": {
   "type": "object",
   "properties": {
    "tag": {
     "const": "EXACT-BUILD"
    },
    "identifierScheme": {
     "enum": [
      "macos-product-build",
      "linux-distro-userspace"
     ]
    },
    "canonicalIdentifier": {
     "type": "string",
     "maxLength": 128,
     "minLength": 1
    },
    "valueSource": {
     "enum": [
      "MEASURED-2026-09-04",
      "PUBLISHED-FACT",
      "RELEASE-MEASURED",
      "DECIDED"
     ]
    }
   },
   "required": [
    "tag",
    "identifierScheme",
    "canonicalIdentifier",
    "valueSource"
   ],
   "additionalProperties": false
  },
  "filesystemWhereItAffectsResolution": {
