{
 "type": "object",
 "properties": {
  "templateSchema": {
   "const": 1
  },
  "platformProfileKey": {
   "type": "string",
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^P-(MACOS|LINUX)-(ARM64|X86_64)-[A-Z0-9]+-(APFS|EXT4)$"
  },
  "osFamily": {
   "enum": [
    "macos",
    "linux"
