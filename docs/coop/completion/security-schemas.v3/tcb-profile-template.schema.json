         "value": {
          "type": "object",
          "properties": {
           "authenticityCore": {
            "type": "object",
            "properties": {
             "scheme": {
              "enum": [
               "codesign",
               "package-db",
               "macos-sealed-boot",
               "publisher-signed-boot"
              ]
