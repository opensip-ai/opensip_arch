  "reproducerSource": "import copy,importlib.util,json,pathlib,sys\nsys.dont_write_bytecode=True\nP=pathlib.Path('/Users/sb/code/opensip-ai/opensip/docs/coop/completion');spec=importlib.util.spec_from_file_location('control',P/'control-completion.check.v3.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ncs=json.loads((P/'control-completion.cases.v3.json').read_text())['cases'];base=next(c for c in cs if c['id']=='MATRIX/ping/STEADY/host-to-component');results=[]\ndef probe(name,body):\n c=copy.deepcopy(base);raw=body.encode();c['frameHex']=(len(raw).to_bytes(4,'big')+raw).hex()\n try:actual=m.run_case(c)\n except Exception as e:actual={'exception':repr(e)}\n results.append({'name':name,'json':body,'context':c['context'],'actual':actual})\nfor name,b in [\n ('zero-seq-only','{\"type\":\"ping\",\"seq\":0,\"controlMajor\":1,\"body\":{\"nonce\":\"n\"}}'),\n ('zero-seq-plus-unknown-body-field','{\"type\":\"ping\",\"seq\":0,\"controlMajor\":1,\"body\":{\"nonce\":\"n\",\"unknown\":0}}'),\n ('overflow-seq-plus-wrong-body-type','{\"type\":\"ping\",\"seq\":9007199254740992,\"controlMajor\":1,\"body\":[]}'),\n ('large-seq-plus-invalid-major','{\"type\":\"ping\",\"seq\":11111111111111111,\"controlMajor\":\"invalid\",\"body\":{\"nonce\":\"n\"}}'),\n ('zero-seq-plus-unknown-message','{\"type\":\"unknown\",\"seq\":0,\"controlMajor\":1,\"body\":{}}'),\n ('malformed-trailing-comma','{\"type\":\"ping\",\"seq\":1,\"controlMajor\":1,\"body\":{\"nonce\":\"n\",}}'),\n ('surrogate-known-string','{\"type\":\"ping\",\"seq\":1,\"controlMajor\":1,\"body\":{\"nonce\":\"\\\\ud800\"}}'),\n ('duplicate-escaped-key','{\"type\":\"ping\",\"seq\":1,\"controlMajor\":1,\"body\":{\"nonce\":\"n\",\"\\\\u006eonce\":\"n\"}}')]:probe(name,b)\npathlib.Path('/tmp/control-independent-probes.v3.json').write_text(json.dumps(results,indent=2)+'\\n')\nfor x in results:print(x['name'],x['actual'])\n",
  "positiveFindings": [
