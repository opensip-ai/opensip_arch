{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "required": [
          "resultScratchRoot"
        ]
      },
      "if": {
        "properties": {
          "handles": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "resultScratchRoot"
          ]
        }
      }
    }
  ],
  "properties": {
    "bootstrapVersion": {
      "const": 1,
      "type": "integer"
    },
    "handles": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "effectClass": {
                  "const": "HE-2"
                }
              }
            },
            "then": {
              "properties": {
                "commitClass": {
                  "const": "REVERSIBLE"
                }
              }
            }
          }
        ],
        "properties": {
          "authorizationRef": {
            "maxLength": 35,
            "minLength": 35,
            "pattern": "^ah:[0-9a-f]{32}$",
            "type": "string"
          },
          "commitClass": {
            "enum": [
              "REVERSIBLE",
              "IRREVERSIBLE"
            ]
          },
          "effectClass": {
            "enum": [
              "HE-1",
              "HE-2"
            ]
          },
          "operationRef": {
            "maxLength": 35,
            "minLength": 35,
            "pattern": "^op-[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "effectClass",
          "authorizationRef",
          "operationRef",
          "commitClass"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    },
    "resultScratchRoot": {
      "description": "Absolute host-created result directory; native no-follow/owner/mode admission remains required.",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 4096
    }
  },
  "required": [
    "bootstrapVersion",
    "handles"
  ],
  "type": "object"
}
