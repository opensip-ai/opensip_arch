    "source": "import pathlib,json,importlib.util,copy\nP=pathlib.Path('/Users/sb/code/opensip-ai/opensip/docs/coop/completion');s=importlib.util.spec_from_file_location('performance_repair_review',P/'check_g13_result_design_v4.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m);rows=[]\nold=json.loads((P/'analysis-performance-independent-review.v1.json').read_text())['independentProbes']['probes']\nfor p in old[:3]:\n observed=m.valid(p['input'],None,p['trustedRunners']);rows.append({'id':'exact-original/'+p['id'],'expected':False,'actual':observed,'passed':observed is False,'scope':'Exact old vector also contains now-invalid placeholder OS strings on other platforms; isolated attribution tested below.'})\ndef test(label,platform,field,value,expected):\n x=m.reference();trusted={p['platform']:{k:p['runner'][k] for k in m.HARDWARE} for p in x['performance']};next(p for p in x['performance'] if p['platform']==platform)['runner'][field]=value;trusted[platform][field]=value;actual=m.valid(x,None,trusted);rows.append({'id':label,'platform':platform,'field':field,'value':value,'expected':expected,'actual':actual,'passed':actual==expected})\nfor platform,gib in [('macos-arm64',7),('macos-x86_64',14),('linux-x86_64',16),('linux-arm64',16)]:\n for label,quarters,delta,expected in [('lower',gib*4-3,0,True),('lower-minus1',gib*4-3,-1,False),('upper',gib*4+3,0,True),('upper-plus1',gib*4+3,1,False)]:test(platform+'/'+label,platform,'ramBytes',quarters*(2**30//4)+delta,expected)\nfor label,field,value in [('one-TiB','ramBytes',2**40),('one-byte','ramBytes',1),('os26','osVersion','26.0'),('newline','osVersion','15.6\\n'),('unicode-digit','osVersion','15.\uff16'),('wrong-major','osVersion','115.6')]:test('isolated/'+label,'macos-arm64',field,value,False)\ntest('os-major-only','macos-arm64','osVersion','15',True);test('os-patch','macos-arm64','osVersion','15.6.1',True)\ntest('linux-trailing-space','linux-x86_64','osVersion','24.04 ',False)\nr={'total':len(rows),'passed':sum(x['passed'] for x in rows),'probes':rows};pathlib.Path('/tmp/analysis-performance-probes.v2.json').write_text(json.dumps(r,indent=2)+'\\n');print(r['passed'],r['total']);assert r['passed']==r['total']\n"
