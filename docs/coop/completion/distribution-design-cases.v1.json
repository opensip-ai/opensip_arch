    {
      "id": "G02.logical-at-limit",
      "model": "installed_size",
      "input": [
        {
          "device": 1,
          "inode": 1,
          "type": "file",
          "length": 80000000,
          "blocks": 0
        }
      ],
      "expected": {
        "logical": 80000000,
        "allocated": 0,
        "budgetBytes": 80000000,
        "status": "PASS"
      },
      "rows": [
        "DR-101"
      ]
    },
