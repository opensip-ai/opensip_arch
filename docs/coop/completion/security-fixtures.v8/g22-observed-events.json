  "NT-TCB-PROFILE-UNQUALIFIED"
 ],
 "legacyStateIdsCovered": [
  "G07.loader.entrypoint-replacement",
  "G07.loader.loader-replacement",
  "G07.loader.path-substitution",
  "G07.loader.shell-substitution",
  "G07.loader.system-runtime-substitution",
  "G22.linux-arm64.hostile-loader-system-library-tool",
  "G22.linux-x86_64.hostile-loader-system-library-tool",
