{
  "type": "object",
  "properties": {
    "schemaMajor": {
      "const": 1
    },
    "gate": {
      "const": "harness.DR-G13.typescript-quality.preview"
    },
    "matrixDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "corpusDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "hostDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "providerClosureDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string",
            "minLength": 1
          },
          "fixtureResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fixtureId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "actualCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "missingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "extraCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "duplicateCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expectationMatched": {
                  "type": "boolean"
                },
                "differenceArtifactDigest": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    }
                  ]
                }
              },
              "required": [
                "fixtureId",
                "expectedCount",
                "actualCount",
                "missingCount",
                "extraCount",
                "duplicateCount",
                "expectationMatched",
                "differenceArtifactDigest"
              ],
              "additionalProperties": false
            }
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NON-PASS"
            ]
          },
          "performanceObservationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "cellId",
          "fixtureResults",
          "result",
          "performanceObservationId"
        ],
        "additionalProperties": false
      },
      "minItems": 24,
      "maxItems": 24
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "macos-arm64",
              "macos-x86_64",
              "linux-x86_64",
              "linux-arm64"
            ]
          },
          "profileId": {
            "const": "whole-analyze-1000modules.v1"
          },
          "runner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "cpuModel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "vcpu": {
                    "const": 4
                  },
                  "ramBytes": {
                    "const": 8589934592
                  },
                  "osVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "osBuild": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kernel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "filesystem": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hostDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "providerClosureDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "compilerDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "runtimeDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "cacheState": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurementToolDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "concurrency": {
                    "const": 1
                  }
                },
                "required": [
                  "cpuModel",
                  "vcpu",
                  "ramBytes",
                  "osVersion",
                  "osBuild",
                  "kernel",
                  "filesystem",
                  "hostDigest",
                  "providerClosureDigest",
                  "compilerDigest",
                  "runtimeDigest",
                  "cacheState",
                  "measurementToolDigest",
                  "concurrency"
                ],
                "additionalProperties": false
              }
            ]
          },
          "measurements": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "coldDurationNs": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "minItems": 30,
                    "maxItems": 30
                  },
                  "warmDurationNs": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "minItems": 30,
                    "maxItems": 30
                  },
                  "warmups": {
                    "const": 5
                  },
                  "observedTreePeakRssBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sumIndividualHighWaterRssBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "baselineColdP95Ns": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ]
                  },
                  "baselineWarmP95Ns": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ]
                  },
                  "baselineRssBytes": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ]
                  }
                },
                "required": [
                  "coldDurationNs",
                  "warmDurationNs",
                  "warmups",
                  "observedTreePeakRssBytes",
                  "sumIndividualHighWaterRssBytes",
                  "baselineColdP95Ns",
                  "baselineWarmP95Ns",
                  "baselineRssBytes"
                ],
                "additionalProperties": false
              }
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NON-PASS"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "observationId",
          "platform",
          "profileId",
          "runner",
          "measurements",
          "result",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NON-PASS"
      ]
    },
    "baselineStatus": {
      "enum": [
        "FIRST-BASELINE",
        "ESTABLISHED"
      ]
    },
    "baselineArtifactDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      ]
    }
  },
  "required": [
    "schemaMajor",
    "gate",
    "matrixDigest",
    "corpusDigest",
    "hostDigest",
    "providerClosureDigest",
    "cells",
    "performance",
    "result",
    "baselineStatus",
    "baselineArtifactDigest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:g13:result:1",
  "$comment": "PROPOSED result grammar. Semantic validator must require exact matrix cell IDs and fixture sets, unique IDs, every fixture matched, four platform metrics, ceiling+regression checks, correct subject digest joins. Structural validity alone is never PASS."
}
