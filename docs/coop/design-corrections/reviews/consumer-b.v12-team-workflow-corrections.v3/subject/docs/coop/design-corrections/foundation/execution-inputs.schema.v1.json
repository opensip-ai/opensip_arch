{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opensip.product.execution-inputs.1",
  "title": "ExecutionInputsV1 — host-captured evaluator INPUT observation (DRAFT)",
  "description": "Post-Plan evaluator INPUT. Identity is raw SHA-256 of C(this record), not an H-domain and not a Plan parameter. planId is an explicit locator; the Plan descriptor has no planId field. Observes stage returns. Not findings, verdict, or proof. HostCapture is a TCB trust boundary: sealed replay checks proof selection equals this inventory; it cannot certify a malicious host omission. NativeCoverageAccount is references plus explicit applicability; completeness, coverage answer, resolution state, and ALL native causes derive from every owner entry of this cell/program/view/provider/U/pair. selectedRefs does not name execution-inputs (circular); graph evaluationInputRefs / proof.executionInputsDigest hold the blob digest. Physical store censuses (retainedObjectKeys/retainedBlobDigests) are NOT part of this record — they are operational capture metadata excluded from Run identity. Compatible with M3 canonical-record registration of execution-inputs and candidate-producer-result. Standing: isolated successor; frozen21/live untouched.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "executionPlanId",
    "evaluatorClosure",
    "enumerationPlanDigest",
    "analysisSpecDigest",
    "hostCapture",
    "selectedRefs",
    "cellOutcomes",
    "nativeCoverageAccounts",
    "candidateResultRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])",
      "description": "Explicit locator. Compared to the caller-supplied plan_id, never read off the Plan descriptor."
    },
    "executionPlanId": {
      "type": "string",
      "pattern": "^exec-plan2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "evaluatorClosure": {
      "type": "string",
      "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "enumerationPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "analysisSpecDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "hostCapture": {
      "$ref": "#/$defs/HostCaptureV1"
    },
    "selectedRefs": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/InputRefV1"
      },
      "x-opensip-order": "canonical-set"
    },
    "cellOutcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/CellProgramOutcomeV1"
      },
      "x-opensip-order": "ordinal"
    },
    "nativeCoverageAccounts": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/NativeCoverageAccountV1"
      },
      "x-opensip-order": "sequence"
    },
    "candidateResultRefs": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/DigestHex"
      },
      "x-opensip-order": "canonical-set"
    }
  },
  "x-opensip-new-internal-faults": {
    "standing": "NEW/internal. Typed missing/invalid/lost routes; object mismatch is not a missing pointer. Completeness is derived, not a host scalar.",
    "keys": [
      "EXECUTION_INPUTS_SCHEMA",
      "EXECUTION_INPUTS_STORE_REQUIRED",
      "EXECUTION_INPUTS_PLAN_JOIN",
      "EXECUTION_INPUTS_EXECUTION_PLAN_JOIN",
      "EXECUTION_INPUTS_ENUMERATION_DIGEST",
      "EXECUTION_INPUTS_EVALUATOR_CLOSURE",
      "EXECUTION_INPUTS_CELL_TOTALITY",
      "EXECUTION_INPUTS_INVENTORY_KIND",
      "EXECUTION_INPUTS_VIEW_TOTALITY",
      "EXECUTION_INPUTS_REF_POINTER",
      "EXECUTION_INPUTS_REF_LOST_BYTES",
      "EXECUTION_INPUTS_REF_INVALID_BYTES",
      "EXECUTION_INPUTS_REF_MISMATCH",
      "EXECUTION_INPUTS_EVIDENCE_UNAVAILABLE",
      "EXECUTION_INPUTS_STAGE_PRODUCER",
      "EXECUTION_INPUTS_STAGE_ORDINAL",
      "EXECUTION_INPUTS_RECEIPT_TOTALITY",
      "EXECUTION_INPUTS_COVERAGE_DERIVE",
      "EXECUTION_INPUTS_NATIVE_COVERAGE_TOTALITY",
      "EXECUTION_INPUTS_OUTCOME_DERIVE",
      "EXECUTION_INPUTS_CANDIDATE_REQUIRED",
      "EXECUTION_INPUTS_CANDIDATE_GROUP",
      "EXECUTION_INPUTS_CANDIDATE_BIND",
      "EXECUTION_INPUTS_OUTPUT_BACKLINK",
      "EXECUTION_INPUTS_VCS_APPLICABILITY",
      "EXECUTION_INPUTS_ORDER",
      "EXECUTION_INPUTS_SELECTED_COVER",
      "EXECUTION_INPUTS_CAUSE_CARRIER",
      "EXECUTION_INPUTS_CAUSE_ENUM_DRIFT",
      "EXECUTION_INPUTS_KIND_MAP",
      "EXECUTION_INPUTS_ENUMERATOR",
      "EXECUTION_INPUTS_HOST_DERIVED",
      "EXECUTION_INPUTS_CANDIDATE_SOURCE"
    ]
  },
  "$defs": {
    "DigestHex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "LogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\\\u0000]{1,255}(/[^/\\\\\\u0000]{1,255})*(?![\\s\\S])",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "DeficiencyV2": {
      "type": "string",
      "enum": [
        "language-tier-unsupported",
        "provider-unavailable",
        "input-closure-incomplete",
        "budget-exhausted",
        "confidence-floor-unmet",
        "derivation-policy-unmet",
        "resolution-incomplete",
        "external-consumers-unknown",
        "required-relation-missing"
      ]
    },
    "NativeCause": {
      "type": "string",
      "enum": [
        "body-language-owner-ambiguous",
        "body-language-owner-unenumerated",
        "body-language-ownership-missing",
        "capability-missing",
        "config-flag-stripped",
        "generated-file-missing",
        "generated-file-out-of-bounds",
        "generated-output-unavailable",
        "linker-unavailable",
        "lockfile-missing",
        "missing-dependency-source",
        "no-program-unit",
        "node-modules-outside-read-set",
        "source-replacement-outside-snapshot"
      ]
    },
    "InputRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "digest"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "view",
            "import",
            "coverage",
            "subject-inventory",
            "target-attribution",
            "incoming-search",
            "candidate-producer-result"
          ]
        },
        "digest": {
          "$ref": "#/$defs/DigestHex"
        }
      }
    },
    "StageReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "stageSpecDigest",
        "producerClosure",
        "outputDomains",
        "outputRefs",
        "state",
        "unavailableReason"
      ],
      "description": "Host observation of one admitted execution-plan stage obligation. Receipt ordinals are unique and total over execution-plan.stages. outputDomains equal that stage's admitted outputDomains; outputRefs domains are a subset of those domains. Imports are Plan-selected INPUT and are not stage products. Optional unavailable stages carry typed state, never silent omission. selectedRefs for stage-produced domains equals the union of complete-receipt outputRefs (exact totality, not a subset).",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "stageSpecDigest": {
          "$ref": "#/$defs/DigestHex"
        },
        "producerClosure": {
          "type": "string",
          "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "outputDomains": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "x-opensip-order": "canonical-set"
        },
        "outputRefs": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/InputRefV1"
          },
          "x-opensip-order": "canonical-set"
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "unavailable"
          ]
        },
        "unavailableReason": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "unavailable-binding",
                "optional-unselected",
                "provider-unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "unavailableReason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "outputRefs": {
                "maxItems": 0
              },
              "unavailableReason": {
                "type": "string"
              }
            },
            "not": {
              "properties": {
                "unavailableReason": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "HostCaptureV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody",
        "observation",
        "stageReceipts",
        "hostDerivedRefs"
      ],
      "description": "TCB trust boundary, not a mathematically independent second witness. Equality of selectedRefs to this captured inventory does not prove a non-malicious host. Physical object/blob censuses are operational capture metadata excluded from this record and from Run identity. Ambient unselected store contents must not change C(this).",
      "properties": {
        "custody": {
          "const": "host-tcb-evidence-store"
        },
        "observation": {
          "const": "stage-return"
        },
        "stageReceipts": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/StageReceiptV1"
          },
          "x-opensip-order": "ordinal"
        },
        "hostDerivedRefs": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/InputRefV1"
          },
          "x-opensip-order": "canonical-set",
          "description": "Explicit custody of host-derived typed inputs: subject-inventory, candidate-producer-result, target-attribution, incoming-search. Not stage products unless the admitted stage outputDomains names that domain. selectedRefs blob-domain members must equal this set."
        }
      }
    },
    "CellProgramOutcomeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "cellOrdinal",
        "programOrdinal",
        "capabilityId",
        "languageMode",
        "workspaceRoot",
        "required",
        "kinds",
        "universe",
        "enumeratorStatus",
        "enumeratorClosure",
        "state",
        "deficiency",
        "nativeCause",
        "stageOrdinal",
        "stageOrdinalNullReason",
        "inventoryDigests",
        "viewDigests",
        "candidateResultDigest"
      ],
      "description": "One row per enumeration binding. state/deficiency/nativeCause MUST equal the derived aggregate of inventories, coverage accounts, and candidate stage result. Host cannot mint a complete semantic by asserting the row.",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "capabilityId": {
          "type": "string",
          "enum": [
            "inventory",
            "syntax",
            "imports",
            "references",
            "calls",
            "types",
            "reachability",
            "clones-fact",
            "clones-near",
            "clones-cross-tsjs",
            "unresolved-edge"
          ]
        },
        "languageMode": {
          "type": "string",
          "enum": [
            "ts-tsconfig",
            "js-allowjs",
            "js-synthesized",
            "rust-cargo",
            "rust-cargo-prepared",
            "syntax-only"
          ]
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "required": {
          "type": "boolean"
        },
        "kinds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "file",
              "symbol",
              "package"
            ]
          },
          "x-opensip-order": "canonical-set"
        },
        "universe": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "enumeratorStatus": {
          "type": "string",
          "enum": [
            "selected",
            "unselected"
          ]
        },
        "enumeratorClosure": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "deficiency": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeficiencyV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCause": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "stageOrdinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            {
              "type": "null"
            }
          ]
        },
        "stageOrdinalNullReason": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "unavailable-binding",
                "optional-unselected"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "inventoryDigests": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        },
        "viewDigests": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set",
          "description": "view2 H suffixes, never sha256(C(view)). Must equal captured receipt views attributed to this cell/program/U/producer."
        },
        "candidateResultDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "deficiency": {
                "type": "null"
              },
              "nativeCause": {
                "type": "null"
              },
              "stageOrdinal": {
                "type": "integer"
              },
              "stageOrdinalNullReason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stageOrdinal": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "stageOrdinalNullReason": {
                "type": "string"
              }
            },
            "not": {
              "properties": {
                "stageOrdinalNullReason": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "NativeCoverageAccountV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellOrdinal",
        "programOrdinal",
        "relation",
        "resolution",
        "sourceUniverse",
        "targetUniverse",
        "applicability",
        "coverageIds"
      ],
      "description": "References plus explicit applicability for one matrix relation@rung on one binding. coverage/state/deficiency/nativeCause/scopeIds/examinedExhaustive are NOT host fields; admission derives them from ALL owner CoverageResultV3 entries of this cell/program/returned-view/enumerator/U/pair. complete is never a self-asserted scalar. coverageIds for a supported-available pair MUST equal every matching partition in this cell's returned views, not a selected-complete subset. Empty coverageIds on supported-available means native-work-incomplete, not fabricated Coverage.",
      "properties": {
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "relation": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "sourceUniverse": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetUniverse": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability": {
          "type": "string",
          "enum": [
            "supported-available",
            "unsupported-typed",
            "unavailable-unselected",
            "unavailable-null-universe",
            "inapplicable-vcs"
          ]
        },
        "coverageIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "enum": [
                  "inapplicable-vcs",
                  "unsupported-typed",
                  "unavailable-unselected",
                  "unavailable-null-universe"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "coverageIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "CandidateProducerResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "planId",
        "executionPlanId",
        "cellOrdinal",
        "programOrdinal",
        "capabilityId",
        "languageMode",
        "universe",
        "producerClosure",
        "stageOrdinal",
        "state",
        "deficiency",
        "nativeCause",
        "authority",
        "semanticEquivalenceClaimed",
        "automaticDeletionEligible",
        "examinedPaths",
        "groupDigests",
        "sourceBodies"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "planId": {
          "type": "string",
          "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "executionPlanId": {
          "type": "string",
          "pattern": "^exec-plan2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "capabilityId": {
          "type": "string",
          "enum": [
            "clones-near",
            "clones-cross-tsjs"
          ]
        },
        "languageMode": {
          "type": "string",
          "enum": [
            "ts-tsconfig",
            "js-allowjs",
            "js-synthesized",
            "rust-cargo",
            "rust-cargo-prepared",
            "syntax-only"
          ]
        },
        "universe": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "producerClosure": {
          "type": "string",
          "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "stageOrdinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "deficiency": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeficiencyV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCause": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "const": "candidate-only"
        },
        "semanticEquivalenceClaimed": {
          "const": false
        },
        "automaticDeletionEligible": {
          "const": false
        },
        "examinedPaths": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/LogicalPath"
          },
          "x-opensip-order": "canonical-set"
        },
        "groupDigests": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        },
        "sourceBodies": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CandidateSourceBodyV1"
          },
          "x-opensip-order": "canonical-set",
          "description": "Retained candidate-only body coordinates for this envelope. id is an opaque producer body id, not a filesystem path and not native evaluation-subject authority. path/contentSha256/byteLength join the admitted snapshot SOURCE FILE row the opaque id is anchored to — byteLength is that file's snapshot length, not a body-span length. A future body-span option is not a qualifying compiler and is not required here. Adapter maps are derived only from this retained array."
        }
      }
    },
    "CandidateSourceBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "contentSha256",
        "byteLength",
        "universe"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Opaque candidate body/symbol coordinate (clone_groups bodies[].id). Not a native identity domain. Whole-file snapshot join is acceptable only as this explicit opaque provider coordinate."
        },
        "path": {
          "$ref": "#/$defs/LogicalPath"
        },
        "contentSha256": {
          "$ref": "#/$defs/DigestHex"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Admitted snapshot SOURCE FILE length for the path this opaque id is anchored to. Not a body-span. Whole-file snapshot join is acceptable only as this explicit opaque provider coordinate. A future full body-span option is not a qualifying compiler and is not required here."
        },
        "universe": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
