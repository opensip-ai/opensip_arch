        "ignorePaths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "x-opensip-order": "sequence"
        }
      },
      "required": []
