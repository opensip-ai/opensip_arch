    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^import2:[0-9a-f]{64}(?![\\s\\S])"
          },
          "x-opensip-order": "sequence"
        }
      },
      "required": []
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "oneOf": [
            {
              "type": "null"
