        "maxRuns": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          ]
        },
        "maxAgeSeconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          ]
        }
      },
      "required": []
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion"
  ]
}
