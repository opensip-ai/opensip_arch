                      },
                      {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
                          },
                          "max": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
                          },
                          "includeMin": {
                            "type": "boolean"
                          },
                          "includeMax": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "min",
                          "max",
                          "includeMin",
                          "includeMax"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "stableId",
                  "versionConstraint"
