                "additionalProperties": false
              }
            ]
          },
          "maxItems": 128,
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stableId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
              }
            },
            "required": [
              "stableId",
              "version"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true,
          "maxItems": 128,
          "x-opensip-order": "sequence"
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stableId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
              }
            },
            "required": [
              "stableId",
              "version"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true,
          "maxItems": 128,
          "x-opensip-order": "sequence"
        },
        "allowedScopes": {
          "oneOf": [
            {
              "const": [
                "global"
              ]
            },
            {
              "const": [
                "project",
                "global"
              ]
            }
          ]
        }
      },
      "required": []
