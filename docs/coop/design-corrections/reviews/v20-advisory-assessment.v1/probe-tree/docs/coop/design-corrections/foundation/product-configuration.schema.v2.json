    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._:-]*(?![\\s\\S])"
          },
          "x-opensip-order": "sequence"
        },
        "waiverIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._:-]*(?![\\s\\S])"
          },
          "x-opensip-order": "sequence"
        }
      },
      "required": []
