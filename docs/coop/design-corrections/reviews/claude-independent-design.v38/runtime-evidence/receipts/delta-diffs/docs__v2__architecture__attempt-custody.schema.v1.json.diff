-  "proposedPrivateDDL": "CREATE TABLE attempt_custody (\n  store_generation_digest TEXT NOT NULL CHECK (length(store_generation_digest) = 64 AND store_generation_digest GLOB '[0-9a-f]*'),\n  namespace_id    TEXT NOT NULL CHECK (length(namespace_id) BETWEEN 1 AND 4096),\n  execution_id    TEXT NOT NULL CHECK (execution_id GLOB 'exec1_[0-9a-f]*' AND length(execution_id) = 38),\n  operation_ref   TEXT NOT NULL CHECK (operation_ref GLOB 'op-[0-9a-f]*' AND length(operation_ref) = 35),\n  record_schema   INTEGER NOT NULL CHECK (record_schema = 1),\n  phase           TEXT NOT NULL CHECK (phase IN ('admitted','settled')),\n  settled_outcome TEXT CHECK (settled_outcome IS NULL OR settled_outcome IN ('committed','refused')),\n  CHECK ((phase = 'admitted' AND settled_outcome IS NULL)\n      OR (phase = 'settled'  AND settled_outcome IS NOT NULL)),\n  PRIMARY KEY (store_generation_digest, namespace_id, execution_id)\n) WITHOUT ROWID;\nCREATE TRIGGER ac_no_delete BEFORE DELETE ON attempt_custody\n  BEGIN SELECT RAISE(ABORT, 'attempt custody is append-and-settle only'); END;\nCREATE TRIGGER ac_monotone BEFORE UPDATE ON attempt_custody\n  BEGIN\n    SELECT CASE WHEN OLD.phase = 'settled'\n      THEN RAISE(ABORT, 'attempt custody is already settled') END;\n    SELECT CASE WHEN NEW.phase <> 'settled' OR NEW.settled_outcome IS NULL\n      THEN RAISE(ABORT, 'the only lawful transition is admitted to settled') END;\n    SELECT CASE WHEN NEW.store_generation_digest <> OLD.store_generation_digest\n              OR NEW.namespace_id <> OLD.namespace_id\n              OR NEW.execution_id <> OLD.execution_id\n              OR NEW.operation_ref <> OLD.operation_ref\n              OR NEW.record_schema <> OLD.record_schema\n      THEN RAISE(ABORT, 'attempt custody identity is immutable') END;\n  END;\n",
+  "proposedPrivateDDL": "CREATE TABLE attempt_custody (\n  store_generation_digest TEXT NOT NULL CHECK (typeof(store_generation_digest) = 'text' AND length(store_generation_digest) = 64 AND instr(store_generation_digest, char(0)) = 0 AND store_generation_digest NOT GLOB '*[^0-9a-f]*'),\n  namespace_id    TEXT NOT NULL CHECK (typeof(namespace_id) = 'text' AND length(namespace_id) BETWEEN 1 AND 4096),\n  execution_id    TEXT NOT NULL CHECK (typeof(execution_id) = 'text' AND length(execution_id) = 38 AND instr(execution_id, char(0)) = 0 AND execution_id GLOB 'exec1_*' AND substr(execution_id, 7) NOT GLOB '*[^0-9a-f]*'),\n  operation_ref   TEXT NOT NULL CHECK (typeof(operation_ref) = 'text' AND length(operation_ref) = 35 AND instr(operation_ref, char(0)) = 0 AND operation_ref GLOB 'op-*' AND substr(operation_ref, 4) NOT GLOB '*[^0-9a-f]*'),\n  record_schema   INTEGER NOT NULL CHECK (typeof(record_schema) = 'integer' AND record_schema = 1),\n  phase           TEXT NOT NULL CHECK (phase IN ('admitted','settled')),\n  settled_outcome TEXT CHECK (settled_outcome IS NULL OR settled_outcome IN ('committed','refused')),\n  CHECK ((phase = 'admitted' AND settled_outcome IS NULL)\n      OR (phase = 'settled'  AND settled_outcome IS NOT NULL)),\n  PRIMARY KEY (store_generation_digest, namespace_id, execution_id)\n) WITHOUT ROWID;\nCREATE TRIGGER ac_no_delete BEFORE DELETE ON attempt_custody\n  BEGIN SELECT RAISE(ABORT, 'attempt custody is append-and-settle only'); END;\nCREATE TRIGGER ac_monotone BEFORE UPDATE ON attempt_custody\n  BEGIN\n    SELECT CASE WHEN OLD.phase = 'settled'\n      THEN RAISE(ABORT, 'attempt custody is already settled') END;\n    SELECT CASE WHEN NEW.phase <> 'settled' OR NEW.settled_outcome IS NULL\n      THEN RAISE(ABORT, 'the only lawful transition is admitted to settled') END;\n    SELECT CASE WHEN NEW.store_generation_digest <> OLD.store_generation_digest\n              OR NEW.namespace_id <> OLD.namespace_id\n              OR NEW.execution_id <> OLD.execution_id\n              OR NEW.operation_ref <> OLD.operation_ref\n              OR NEW.record_schema <> OLD.record_schema\n      THEN RAISE(ABORT, 'attempt custody identity is immutable') END;\n  END;\n",
   "ddlStanding": "SELECTED placement: the storage-owned evidence ledger, within the already inventoried crates/storage/src/ledger_store.rs, commit.rs and recovery.rs modules. The authorized settlement sweep writes through that same ledger and the same table, so it needs no separate DDL. This is a settled selection.",
+  "ddlGrammarCorrection": {"standing": "Source37 owner correction (review advisory A37-01), revised after root reproduced embedded-NUL and ASCII-hex BLOB admissions against the source37 v1 bytes, and again after root showed that the source37 v2 byte-length predicate refused lawful rows in UTF-16 databases. The planned private DDL is corrected in place. No product implementation or deployed ledger table was created from the earlier bytes; reference in-memory SQLite instances were created from them by earlier design checks and review probes, and those instances and their receipts remain historical evidence.", "law": "Every column's storage class is enforced: by typeof() on store_generation_digest, namespace_id, execution_id and operation_ref (text) and on record_schema (integer), and by exact enumeration on phase and settled_outcome. Each hex-bearing column is an exact whole TEXT value: length(column) = N, instr(column, char(0)) = 0, its prefix GLOB and NOT GLOB '*[^0-9a-f]*' over the whole value, matching this record's patterns ^[0-9a-f]{64}, ^exec1_[0-9a-f]{32} and ^op-[0-9a-f]{32}. The conjunction does not depend on the database text encoding (exercised under UTF-8, UTF-16le and UTF-16be); no encoding is required.", "authority": "The ledger's record admission remains the owner of the closed record; the DDL is defence in depth. namespace_id keeps its character-length bound, which SQLite counts before any embedded NUL; the record's own minLength and maxLength govern. No member, phase, outcome, key or join changes."},
   "readOnlyRecoveryUse": {
