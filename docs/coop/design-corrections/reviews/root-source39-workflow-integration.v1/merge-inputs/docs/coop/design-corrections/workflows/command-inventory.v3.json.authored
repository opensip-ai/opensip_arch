{
  "schemaFamily": "opensip.product.command-inventory",
  "schemaMajor": 3,
  "standing": "Single intended evaluator3 command and renderer inventory; current acceptance is governed by the correction record. Commands and authorization classes retain their existing owners; this descriptor does not qualify a host or renderer.",
  "commands": [
    {
      "name": "default",
      "cli": "opensip",
      "owner": "workflow",
      "grammarStanding": "declared",
      "requestClass": "analysis",
      "authority": "authoritative-default",
      "authorizationClass": "none",
      "advisory": false,
      "steps": [
        "analysis",
        "render"
      ],
      "formats": [
        "human",
        "json",
        "sarif",
        "html",
        "agent"
      ],
      "parityFields": [
        "run-id",
        "verdict",
        "required-coverage",
        "deficiency",
        "findings",
        "termination-class",
        "retention-disclosure",
        "capability-availability"
      ],
      "writesTrackedIntent": false,
      "repositoryExecution": "never",
      "firstSourceWrite": true,
      "flags": [
        {
          "flag": "--allow-backup-custody",
          "owner": "identity",
          "class": "authorization",
          "join": "identity \u00a75 and security S3: detected backup custody requires this invocation acknowledgment or admitted storage policy before first source-derived write (storage.backup-choice-required). UNKNOWN admits with mandatory unknown disclosure. Does not write policy."
        },
        {
          "flag": "--project",
          "owner": "security",
          "class": "selection",
          "join": "security S3: at most one explicit project authority root, examined exactly once; workspace selection uses repeatable --workspace-root."
        },
        {
          "flag": "--trust-group",
          "owner": "security",
          "class": "authorization",
          "join": "security S3: authorizes one gid for group-write custody; recorded in provenance; configuration cannot grant it"
        },
        {
          "flag": "--trust-project-owner",
          "owner": "security",
          "class": "authorization",
          "join": "security S3: waives only the owner check and only with an explicit --project path"
        },
        {
          "flag": "--workspace-root",
          "owner": "security",
          "class": "selection",
          "join": "security S3: repeatable logical workspace unit path below the one project root; exact custody admission, no config-granted trust; internal explicitJoins is the parsed projection."
        }
      ]
    },
    {
      "name": "recommend",
      "cli": "opensip recommend [--emit-config-proposal PATH]",
      "owner": "workflow",
      "grammarStanding": "declared",
      "requestClass": "query",
