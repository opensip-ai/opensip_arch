  "sharedFlags": [
    {
      "flag": "--allow-backup-custody",
      "owner": "identity",
      "class": "authorization",
      "join": "identity \u00a75 and security S3: detected backup custody requires this invocation acknowledgment or admitted storage policy before first source-derived write (storage.backup-choice-required). UNKNOWN admits with mandatory unknown disclosure. Does not write policy."
    },
    {
      "flag": "--project",
      "owner": "security",
      "class": "selection",
      "join": "security S3: at most one explicit project authority root, examined exactly once; workspace selection uses repeatable --workspace-root."
    },
    {
      "flag": "--trust-group",
      "owner": "security",
      "class": "authorization",
      "join": "security S3: authorizes one gid for group-write custody; recorded in provenance; configuration cannot grant it"
    },
    {
      "flag": "--trust-project-owner",
      "owner": "security",
      "class": "authorization",
      "join": "security S3: waives only the owner check and only with an explicit --project path"
    },
    {
      "flag": "--ephemeral",
      "owner": "workflow",
      "class": "selection",
      "join": "\u00a71: explicitly non-authoritative; cannot supply baseline/repair/verify prerequisites"
    },
    {
      "flag": "--yes-policy",
      "owner": "workflow",
      "class": "authorization",
      "join": "\u00a76: selects consentSource=policy (pre-existing policy record); the only lawful consent in CI"
    },
    {
      "flag": "--workspace-root",
      "owner": "security",
      "class": "selection",
      "join": "security S3: repeatable logical workspace unit path below the one project root; exact custody admission, no config-granted trust; internal explicitJoins is the parsed projection."
    }
  ],
  "renderers": [
    {
      "format": "human",
      "version": 1,
      "applicability": [
        "analysis",
        "query",
        "mutation",
        "lifecycle",
        "execution",
        "meta",
        "trust"
      ],
      "requiredFailureClass": "operational-failed",
      "parityRule": "prints every parity field of the command verbatim or by a documented fixed label; never omits termination-class"
    },
    {
      "format": "json",
      "version": 3,
      "applicability": [
        "analysis",
        "query",
        "mutation",
        "lifecycle",
        "execution",
        "serve",
        "meta",
        "trust"
      ],
      "requiredFailureClass": "operational-failed",
      "parityRule": "the CommandEnvelope major 3 is the parity reference for every other renderer; every query-class command carries its complete typed result in the carrier its queryDispatch.surface selects (queryResponse for graph-query-response, queryRecord otherwise) and every parity field is read at its queryDispatch.parityPaths pointer"
    },
    {
      "format": "sarif",
      "version": 1,
      "applicability": [
        "analysis"
      ],
      "requiredFailureClass": "operational-failed",
      "parityRule": "SARIF 2.1.0 results equal the declared findings projection one-to-one; run.properties carries the same declared verdict and deficiency, never invented nulls. Every SARIF command declares the common analysis parity fields; all renderers use that one host projection. Not applicable to non-analysis commands (OUTPUT.FORMAT_NOT_APPLICABLE, request-rejected)."
    },
    {
      "format": "html",
      "version": 1,
      "applicability": [
        "analysis",
        "query"
      ],
      "requiredFailureClass": "operational-failed",
      "parityRule": "static single-file rendering of the envelope with resolution-completeness and disclosures; identical counts and identities; no script-fetched data"
    },
    {
      "format": "agent",
      "version": 1,
      "applicability": [
        "analysis",
        "query",
        "mutation",
        "lifecycle",
        "execution",
        "serve",
        "trust"
      ],
      "requiredFailureClass": "operational-failed",
      "parityRule": "the JSON envelope plus agentHints; hints never alter a parity field"
    }
  ],
  "goldens": [
    {
      "id": "default-first-use-durable",
      "command": "default",
      "situation": "fresh project, providers installed, no policy file",
      "class": "success",
      "exitCode": 0,
      "remedy": "none; retention DEFAULTED durable-unbounded was disclosed before first write; no policy file written"
    },
    {
      "id": "default-missing-required-closure",
      "command": "default",
      "situation": "the required TypeScript provider closure is not installed",
      "class": "indeterminate",
      "exitCode": 3,
      "reasonCode": "COVERAGE.PROVIDER_UNAVAILABLE",
      "domainDetail": "COMPONENT.REQUIRED_CLOSURE_NOT_INSTALLED",
      "remedy": "opensip install provider-typescript"
    },
    {
      "id": "default-closure-bytes-corrupt",
      "command": "default",
      "situation": "the installed provider closure fails digest verification",
      "class": "operational-failed",
      "exitCode": 4,
      "errorCode": "HOST.IO_FAILURE",
      "domainDetail": "DELIVERY.CLOSURE_BYTES_CORRUPT",
      "remedy": "opensip doctor; then opensip install provider-typescript --reinstall"
    },
    {
      "id": "default-closure-unspawnable",
      "command": "default",
      "situation": "the installed provider closure verifies but cannot be spawned on this platform profile",
      "class": "operational-failed",
      "exitCode": 4,
