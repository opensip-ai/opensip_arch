+    holds = all(_equal({k: p.get(k) for k in fields}, {k: owner[k] for k in fields}) for p in recovered)
+    return {"ok": True, "deliveryTermination": None, "renderings": renderings, "parityHolds": holds, "parity": owner}
 
 
