+def parity_from_human(body):
+    """Recover parity from the human rendering's labelled canonical-JSON lines alone."""
+    out = {}
+    for line in body.splitlines():
+        label, _, value = line.partition(": ")
+        out[label] = canonical.parse(value.encode())
+    return out
+
