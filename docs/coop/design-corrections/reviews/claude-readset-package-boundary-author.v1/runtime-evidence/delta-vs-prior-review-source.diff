+def listed_package_authorizes_read(package,path,dependency_segments):
+    """Explicit nested package custody (identity section 3, consumer24 A4). A listed installPath or realPath
+    authorizes a read file below it only while the relative suffix below that exact directory has no further exact
+    dependency-tree segment: a nested installed package needs its own retained row whose directory lies below that
+    boundary. The listed directory is an arbitrary admitted CanonicalPath (a package-manager store directory or a
+    workspace link included); nothing is parsed from its spelling, and its own segments may contain node_modules."""
+    if not path.startswith(package+'/'):return False
+    return not any(segment in dependency_segments for segment in path[len(package)+1:].split('/'))
 
