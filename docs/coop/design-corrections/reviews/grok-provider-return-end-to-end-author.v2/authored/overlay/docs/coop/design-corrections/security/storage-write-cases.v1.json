{
  "standing": "Backup-custody choice before the first source-derived write (identity-and-evidence section 5 / TM V17, JOINT-INTERFACES storage custody join) evaluated by storage_write_admission. backupStatus is an asserted OS classification. Same-author expectations.",
  "model": "storage-write",
  "cases": [
    {
      "id": "backed-up-root-without-choice-refuses-precondition",
      "input": {
        "backupStatus": "BACKED_UP"
      },
      "expect": {
        "result": "REFUSE",
        "refusal": "REQUEST.PRECONDITION_FAILED",
        "detail": "storage.backup-choice-required",
        "d9": {
          "class": "request-rejected",
          "exit": 2,
          "code": "REQUEST.PRECONDITION_FAILED"
        },
        "policyFileWritten": false,
        "rootIdentityChanged": false
      }
    },
    {
      "id": "unknown-backup-status-is-not-not-backed-up",
      "input": {
        "backupStatus": "UNKNOWN",
        "ci": true
      },
      "expect": {
        "result": "ADMIT",
        "choice": "unknown-disclosed",
        "policyFileWritten": false
      }
    },
    {
      "id": "allow-backup-custody-flag-admits-this-invocation-only",
      "input": {
        "backupStatus": "BACKED_UP",
        "allowBackupCustody": true
      },
      "expect": {
        "result": "ADMIT",
        "choice": "invocation-flag",
        "policyFileWritten": false
      }
    },
    {
      "id": "admitted-storage-policy-record-admits",
      "input": {
        "backupStatus": "BACKED_UP",
        "admittedPolicyRecord": "7777777777777777777777777777777777777777777777777777777777777777"
      },
      "expect": {
        "result": "ADMIT",
        "choice": "admitted-policy-record:7777777777777777777777777777777777777777777777777777777777777777"
      }
    },
    {
      "id": "flag-integer-one-is-not-true",
      "input": {
        "backupStatus": "BACKED_UP",
        "allowBackupCustody": 1
      },
      "expect": {
        "result": "REFUSE"
      }
    },
    {
      "id": "ephemeral-needs-no-choice",
      "input": {
        "backupStatus": "BACKED_UP",
        "ephemeral": true
      },
      "expect": {
        "result": "ADMIT",
        "choice": "ephemeral"
      }
    },
    {
      "id": "not-backed-up-admits",
      "input": {
        "backupStatus": "NOT_BACKED_UP"
      },
      "expect": {
        "result": "ADMIT",
        "choice": "not-required"
      }
    },
    {
      "id": "unknown-vocabulary-is-model-rejection",
      "input": {
        "backupStatus": "maybe"
      },
      "expectReject": "BACKUP_STATUS_VOCABULARY"
    }
  ]
}
