{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opensip.qualification.product-report.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaMajor",
    "hostDigest",
    "providerClosureDigest",
    "harnessDigest",
    "matrixDigest",
    "corpusDigest",
    "runnerId",
    "profileId",
    "environmentDigest",
    "cells",
    "qualificationRequestId"
  ],
  "properties": {
    "schemaMajor": {
      "const": 3
    },
    "hostDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "providerClosureDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "harnessDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "matrixDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "corpusDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "runnerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cellId",
          "warmupRuns",
          "elapsedNanos",
          "peakRssBytes",
          "observations",
          "exitStatus"
        ],
        "properties": {
          "cellId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "warmupRuns": {
            "const": 3
          },
          "elapsedNanos": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          },
          "peakRssBytes": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          },
          "observations": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "subject",
                "value"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "value": {
                  "type": "string",
                  "maxLength": 1048576
                }
              }
            }
          },
          "exitStatus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "qualificationRequestId": {
      "type": "string",
      "pattern": "^req1_[0-9a-f]{32}(?![\\s\\S])"
    }
  }
}
