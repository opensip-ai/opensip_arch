# 7. Relation-specific minimum-resolution predicates
# ---------------------------------------------------------------------------
def min_resolution_table():
    """Derive the complete registered (relation, rung) applicability table and
    the state-dependent count/class/attempt rules (native S4.3 RC-0/RC-1)."""
    rows = []
    for rel in sorted(G.RELATIONS):
        for rung in G.RELATIONS[rel]["ladder"]:
            resolved = rung in G.RESOLVED_RUNGS
            rows.append({
                "relation": rel, "rung": rung, "ladderIndex":
                    G.RELATIONS[rel]["ladder"].index(rung),
                "resolvedRung": resolved,
                "resolutionCompletenessState":
                    "one of complete/incomplete/partial/not-attempted"
                    if resolved else "not-applicable",
                "attempted": None if resolved else False,
                "unresolvedEdgeCount": None if resolved else 0,
                "unresolvedEdgeClasses": None if resolved else [],
                "anchorClass": G.RELATIONS[rel]["anchorLaw"]["class"],
                "anchorCardinality":
                    G.RELATIONS[rel]["anchorLaw"].get("cardinality",
                        ">= %d" % G.RELATIONS[rel]["anchorLaw"].get("minimum", 0)),
                "subjectKind": G.RELATIONS[rel].get("subjectKind"),
                "universeRule": G.RELATIONS[rel]["universeRule"],
                "coverageTotality": bool(G.RELATIONS[rel].get("coverageTotality")),
            })
    return rows


def min_resolution_predicates():
    """Qualifying and insufficient facts/Coverage at syntactic, resolved and
    type levels, per relation ladder index (no global rank exists)."""
    cases = []

    def sat(rel, have, want):
        ladder = G.RELATIONS[rel]["ladder"]
        if want not in ladder:
            return "REFUSED:minResolution not a rung of %s" % rel
        if have not in ladder:
            return "REFUSED:fact rung not a rung of %s" % rel
        return ladder.index(have) >= ladder.index(want)

    for rel, have, want, label in [
            ("declares", "syntactic", "syntactic", "syntactic qualifies"),
            ("references", "syntactic-name-match", "resolved-binding",
             "syntactic fact is INSUFFICIENT for a resolved demand"),
            ("references", "resolved-binding", "resolved-binding",
             "resolved qualifies"),
            ("types", "annotated", "checked",
             "annotated is INSUFFICIENT for a type demand"),
            ("types", "checked", "checked", "checked qualifies"),
            ("imports", "resolved-target", "syntactic-specifier",
             "a stronger rung satisfies a weaker demand"),
            ("declares", "resolved-callee", "syntactic",
             "a rung of ANOTHER relation is refused, not ranked"),
            ("clones", "normalized-body-hash", "checked",
             "cross-relation comparison is an admission refusal"),
    ]:
        cases.append({"relation": rel, "factRung": have, "minResolution": want,
                      "result": sat(rel, have, want), "label": label})
    return cases


# ---------------------------------------------------------------------------
# 8. D9 extension check against the inherited artifact
# ---------------------------------------------------------------------------
def d9_extension_check():
    d9 = O.doc("d9")
    common = O.doc("common")["$defs"]
    inherited_causes = set(d9["codeMaps"]["faultCauseToErrorCode"])
    inherited_axis = set(d9["scenarioAxesSchema"]["properties"]["faultCause"]["enum"])
    successor = set(common["D9FaultCause"]["enum"])
    added = sorted(successor - inherited_axis)
    return {
        "inheritedFaultCauseToErrorCode": sorted(inherited_causes),
        "inheritedScenarioAxisEnum": sorted(inherited_axis),
        "successorD9FaultCause": sorted(successor),
        "addedByTheSuccessor": added,
        "addedIsExactlyHostInvariant": added == ["host-invariant"],
        "hostInvariantHasNoInheritedErrorCodeMapping":
            "host-invariant" not in inherited_causes,
        "mappedErrorCodeExistsInInheritedVocabulary":
            "SYSTEM.OUTCOME.ILLEGAL_STATE" in set(d9["codeVocabulary"]["errorCodes"])
            if isinstance(d9.get("codeVocabulary"), dict)
            and "errorCodes" in d9.get("codeVocabulary", {}) else None,
        "classToExitCodeUnchanged":
            d9["classToExitCode"] == {"success": 0, "policy-failed": 1,
                                      "request-rejected": 2, "indeterminate": 3,
                                      "operational-failed": 4, "interrupted": 130},
        "successorClassEnumEqualsInherited":
            set(common["D9Class"]["enum"]) == set(d9["classToExitCode"]),
        "reasonCodesUnchanged":
            set(common["D9ReasonCode"]["enum"])
            == set(d9["codeMaps"]["deficiencyToReasonCode"].values()),
        "errorCodesSupersetCheck": sorted(
            set(common["D9ErrorCode"]["enum"])
            - set(d9["codeMaps"]["faultCauseToErrorCode"].values())
            - set(d9["codeMaps"]["rejectionCauseToErrorCode"].values())),
    }
