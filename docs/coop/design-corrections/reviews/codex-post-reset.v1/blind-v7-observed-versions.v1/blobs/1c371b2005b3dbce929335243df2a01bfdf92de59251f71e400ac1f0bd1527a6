SCOPE_DOC_SCHEMA_DIGEST = O.doc_digest("policy-document")


def scope_policy_parameter(include, exclude):
    """identity S3 payload registry, `parameter` class, row
    workflows/schemas/policy-document.schema.json#/$defs/ScopeDocumentV1."""
    doc = {"schemaFamily": "opensip.product.scope", "schemaMajor": 1,
           "include": list(include), "exclude": list(exclude)}
    errs = O.validate("policy-document", "#/$defs/ScopeDocumentV1", doc)
    assert not errs, errs
    return doc, {"schemaDigest": SCOPE_DOC_SCHEMA_DIGEST,
                 "payloadDigest": raw_digest(doc)}


def comparison_scope_axis():
    """Two Plans differing ONLY in the bound scope-policy parameter."""
    kit = B.Kit()
    w = kit.w
    kit.file("src/a.ts", "export const a = 1;\n")
    kit.file("src/generated/big.ts", "export const g = 1;\n")

    prov, _ = kit.closure("provider", {"bin/p": b"p\n"}, "1.0.0")
    ev_, _ = kit.closure("evaluator", {"bin/e": b"e\n"}, "1.0.0")
    det, _ = kit.closure("detector", {"r.json": b"{}\n"}, "1.0.0")

    scope_desc = {"schemaVersion": 2, "workspaceRoots": ["."],
                  "pathPrefixes": [], "excludedPathPrefixes": [".git"]}
    budget = {"unit": "work-units", "limit": 1000}
    config = {"analysis": {"profileId": "default", "capabilities": ["inventory"],
                           "budget": dict(budget)},
