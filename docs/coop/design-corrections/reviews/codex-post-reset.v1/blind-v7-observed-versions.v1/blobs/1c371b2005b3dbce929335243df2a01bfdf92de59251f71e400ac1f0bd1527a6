# 6. Repair descriptor projection from ORIGINAL native evidence
# ---------------------------------------------------------------------------
NATIVE_RELATIONS = set(G.RELATIONS.keys())
IMPORTED_RELATIONS = {"runtime-observation", "history-change"}


def admit_evidence_requirement(req):
    """workflows S6: the PLANE is decided at admission from the relation's
    registry membership, never from the value; the two vocabularies are
    disjoint and a cross-plane value refuses."""
    faults = []
    rel = req["relation"]
    if rel in NATIVE_RELATIONS:
        plane = "native"
        ladder = G.RELATIONS[rel]["ladder"]
        if req["minResolution"] not in ladder:
            faults.append("ATOM_MIN_RESOLUTION_NOT_ON_RELATION_LADDER:%s@%s"
                          % (rel, req["minResolution"]))
        allowed = set(O.doc("common")["$defs"]["NativeSufficiencyDeficiency"]["enum"])
    elif rel in IMPORTED_RELATIONS:
        plane = "imported"
        if req["minResolution"] != "observed":
            faults.append("IMPORTED_RELATION_RUNG_NOT_ON_LADDER:%s@%s"
                          % (rel, req["minResolution"]))
        allowed = set(O.doc("common")["$defs"]["ImportedRequirementDeficiency"]["enum"])
    else:
        return ["EVIDENCE_REQUIREMENT_RELATION_UNREGISTERED:" + rel], None
    if req["satisfied"] is False:
        if "deficiency" not in req:
            faults.append("EVIDENCE_REQUIREMENT_DEFICIENCY_REQUIRED")
        elif req["deficiency"] not in allowed:
            faults.append("EVIDENCE_REQUIREMENT_CROSS_PLANE_VALUE:%s/%s"
                          % (plane, req["deficiency"]))
    elif "deficiency" in req:
        faults.append("EVIDENCE_REQUIREMENT_DEFICIENCY_FORBIDDEN")
    faults += ["SCHEMA:" + m for m in
               O.validate("repair", "#/$defs/EvidenceRequirement", req)]
    return faults, plane


def repair_projection(closed_world, requirements, edits, recipe_trust="admitted",
                      evidence_origin="native-analysis"):
    proj = {k: closed_world[k] for k in
            ("deadCodeRepairEligible", "exportsClosed", "entryPointsRecognized",
             "nonliteralLoading", "externalConsumers")}
    unsafe = [e for e in edits if e["action"] in ("delete", "replace")]
    unmet = []
    # the gate is decided against the EVIDENCE RUN's own ClosedWorldV2, before
    # any descriptor is built
    if unsafe and (not closed_world["deadCodeRepairEligible"]
                   or evidence_origin == "imported-prepared-declared"):
        unmet.append({"code": "REPAIR.CLOSED_WORLD_NOT_ESTABLISHED",
                      "remedy": "; ".join(closed_world["reasons"])
                                or "establish native closed-world evidence",
                      "subject": "delete/replace"})
    if recipe_trust != "admitted":
        unmet.append({"code": "REPAIR.RECIPE_TRUST_REVOKED"
                              if recipe_trust == "revoked"
                              else "REPAIR.RECIPE_TRUST_REVOKED",
                      "remedy": "re-admit the recipe closure under current trust"})
    for r in requirements:
        if not r["satisfied"]:
            unmet.append({"code": "REPAIR.EVIDENCE_REQUIREMENT_UNSATISFIED"
                          if "REPAIR.EVIDENCE_REQUIREMENT_UNSATISFIED" in DDC
                          else "REPAIR.CLOSED_WORLD_NOT_ESTABLISHED",
                          "remedy": "requirement over %s@%s reports %s"
                                    % (r["relation"], r["minResolution"],
                                       r.get("deficiency")),
                          "subject": r["relation"]})
    return proj, unmet, not unmet


def build_repair_vectors():
    out = {}
    # the ORIGINAL native evidence record (seven members), from a Run
    cw_eligible = {"exportsClosed": "closed", "entryPointsRecognized": "all",
                   "nonliteralLoading": "none",
                   "externalConsumers": "none-declared",
                   "dynamicDispatch": "present", "reasons": [],
                   "deadCodeRepairEligible": True}
    cw_open = {"exportsClosed": "open", "entryPointsRecognized": "partial",
               "nonliteralLoading": "present",
               "externalConsumers": "possible",
               "dynamicDispatch": "present",
               "reasons": ["manifest publishes exports",
                           "nonliteral loading observed"],
               "deadCodeRepairEligible": False}
    reqs_ok = [{"relation": "references", "minResolution": "resolved-binding",
                "completeness": "complete", "satisfied": True},
               {"relation": "runtime-observation", "minResolution": "observed",
                "completeness": "partial-acceptable", "satisfied": True}]
    reqs_bad = [{"relation": "references", "minResolution": "resolved-binding",
                 "completeness": "complete", "satisfied": False,
                 "deficiency": "resolution-incomplete"},
                {"relation": "history-change", "minResolution": "observed",
                 "completeness": "complete", "satisfied": False,
                 "deficiency": "import-revision-range-insufficient"}]
    cross = [{"relation": "references", "minResolution": "resolved-binding",
              "completeness": "complete", "satisfied": False,
              "deficiency": "import-unmapped-only"},
             {"relation": "runtime-observation", "minResolution": "observed",
              "completeness": "complete", "satisfied": False,
              "deficiency": "resolution-incomplete"}]
    wrong_rung = [{"relation": "declares", "minResolution": "resolved-callee",
                   "completeness": "complete", "satisfied": True}]

    admissions = {}
    for label, rs in (("valid", reqs_ok), ("valid-unsatisfied", reqs_bad),
                      ("cross-plane", cross), ("rung-of-another-relation",
                                               wrong_rung)):
        admissions[label] = [admit_evidence_requirement(r)[0] for r in rs]
    out["evidenceRequirementAdmission"] = admissions

    edits_delete = [{"path": "src/dead.ts", "action": "delete",
                     "preimageDigest": sha256hex(b"dead\n"),
                     "postimageDigest": None, "postimageBytes": 0}]
    for label, cw, rs, origin in (
            ("eligible", cw_eligible, reqs_ok, "native-analysis"),
            ("closed-world-not-established", cw_open, reqs_ok, "native-analysis"),
            ("declared-prepared-origin", cw_eligible, reqs_ok,
             "imported-prepared-declared"),
            ("unsatisfied-requirement", cw_eligible, reqs_bad,
             "native-analysis")):
        proj, unmet, applicable = repair_projection(cw, rs, edits_delete,
                                                    evidence_origin=origin)
        desc = {"schemaFamily": "opensip.product.repair-plan", "schemaMajor": 1,
                "projectId": PROJECT, "snapshotId": "snapshot2:" + "3d" * 32,
                "evidenceRunId": "run2:" + "4e" * 32,
                "planId": "plan2:" + "5f" * 32,
                "recipe": {"contributionId": "opensip.first-party",
                           "recipeId": "remove-unused-export",
                           "recipeVersion": "1.0.0",
                           "closureId": "closure2:" + "6a" * 32},
                "recipeTrust": "admitted", "evidenceOrigin": origin,
                "closedWorld": proj, "targets": ["finding-key2:" + "7b" * 32],
                "edits": edits_delete, "totalPostimageBytes": 0,
                "evidenceRequirements": rs,
                "permittedEditScope": ["src/**"],
                "applicable": applicable, "unmetPreconditions": unmet,
                "limitations": ["a candidate is never a deletion prerequisite"]}
        rid = "repairplan2:" + H("workflow.repair-plan", desc)
        out.setdefault("plans", {})[label] = {
            "repairPlanId": rid, "descriptor": desc,
            "schemaErrors": O.validate("repair", "#/$defs/RepairPlanV1",
                                       {"repairPlanId": rid, "descriptor": desc}),
            "applicable": applicable,
            "unmetCodes": [u["code"] for u in unmet],
            "projectionOmits": ["dynamicDispatch", "reasons"]}
    # a literal copy of ClosedWorldV2 is REFUSED in the descriptor projection
    bad = dict(out["plans"]["eligible"]["descriptor"])
    bad["closedWorld"] = dict(cw_eligible)
    out["literalClosedWorldCopyRefused"] = O.validate(
        "repair", "#/$defs/RepairPlanDescriptor", bad)
    return out


