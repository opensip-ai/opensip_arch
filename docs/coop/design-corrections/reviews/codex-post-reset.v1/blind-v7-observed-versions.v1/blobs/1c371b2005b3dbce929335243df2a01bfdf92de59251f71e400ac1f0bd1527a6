# ---------------------------------------------------------------------------
# 1. Zero-config selection over several workspace units
# ---------------------------------------------------------------------------
def default_selection(units):
    """native S1.4: for each discovered unit request every capability whose
    (capability, unit languageMode) cell is not NOT-SELECTED, required=true,
    provenance DEFAULTED.  UNSUPPORTED-TYPED cells are included deliberately."""
    rows = []
    for root, mode in units:
        for cap in CAPS:
            cell = CELL[(cap, mode)]
            if cell["state"] == "NOT-SELECTED":
                continue
            rows.append({"capabilityId": cap, "languageMode": mode,
                         "workspaceRoot": root, "required": True})
    return sorted(rows, key=lambda r: C(r))


def release_absence_notices(step_id, rows, declared):
    """The public availability leaf for ONE analysis step's selection."""
    notices = []
    for r in rows:
        if (r["capabilityId"], r["languageMode"]) in declared:
            continue
        cap = r["capabilityId"]
        candidate_only = MATRIX["capabilities"][CAPS.index(cap)]["relations"] == []
        notices.append({
            "code": "native.capability-unavailable",
            "capabilityId": cap,
            "languageMode": r["languageMode"],
            "workspaceRoot": r["workspaceRoot"],
            "remedy": ("this release declares no provider for this capability; "
                       "it has no Coverage entry because it is candidate-only"
                       if candidate_only else
                       "this release declares no provider for this capability; "
                       "its Coverage carries the disclosed unavailable pair")})
    return {"stepId": step_id, "noticeCount": len(notices), "notices": notices}


def capability_availability(steps):
    return {"stepCount": len(steps),
            "totalNoticeCount": sum(s["noticeCount"] for s in steps),
            "steps": steps}


def build_availability_vectors():
    out = {}
    units = [(".", "ts-tsconfig"), ("crates/core", "rust-cargo"),
             ("docs", "syntax-only")]
    sel_all = default_selection(units)
    out["defaultSelectionRowCount"] = len(sel_all)
    out["defaultSelectionPerMode"] = {
        m: len([c for c in CAPS if CELL[(c, m)]["state"] != "NOT-SELECTED"])
        for _, m in units}

    # The installed release declares LESS than the product requires.
    declared = set()
    for cap in CAPS:
        for _, mode in units:
            if CELL[(cap, mode)]["state"] == "NOT-SELECTED":
                continue
            if cap in ("clones-near", "clones-cross-tsjs"):
                continue                       # candidate-only, not declared
            if cap == "types" and mode == "rust-cargo":
                continue                       # a fact-producing absence
            declared.add((cap, mode))

    # single-step command: one analysis step
    s0 = release_absence_notices(0, sel_all, declared)
    out["singleStep"] = capability_availability([s0])
    # named multi-step invocation: DIFFERENT selections at different steps
    s1 = release_absence_notices(1, default_selection([(".", "ts-tsconfig")]),
                                 declared)
    s3 = release_absence_notices(3, default_selection(
        [("crates/core", "rust-cargo")]), declared)
    out["multiStep"] = capability_availability([s1, s3])
    # a step that selected and found nothing absent contributes an EMPTY entry
    out["emptyEntry"] = capability_availability(
        [release_absence_notices(0, default_selection([(".", "ts-tsconfig")]),
                                 set((c, "ts-tsconfig") for c in CAPS))])
    out["noSelection"] = capability_availability([])
    return out


# ---------------------------------------------------------------------------
# 2. Command envelopes: originating boundary decides class and code
# ---------------------------------------------------------------------------
def envelope(kind, termination, exit_code, **extra):
    e = {"schemaFamily": "opensip.product.envelope", "schemaMajor": 2,
         "kind": kind, "requestId": REQ, "termination": termination,
         "exitCode": exit_code}
    e.update(extra)
    return e


def bounded_subject(raw):
    """native S10 bounded diagnostic projection, counting UNICODE SCALARS."""
    if len(raw) <= 1024:
        return raw
    marker = "...#sha256:"
    head = 1024 - len(marker) - 64
    return raw[:head] + marker + hashlib.sha256(raw.encode("utf-8")).hexdigest()


def failure_envelopes():
    out = {}
    # (a) EXTERNAL CONFIGURATION: the user configured an unregistered capability
    key = "native.requested-capability-unregistered:made-up-capability"
    subj = key.split(":", 1)[1]
    det = {"code": "CONFIG.INVALID",
           "remedy": "remove or correct analysis.capabilities in opensip.json",
           "subject": bounded_subject(subj)}
    out["external-configuration"] = envelope(
        "failure", {"class": "request-rejected", "errorCode": "CONFIG.INVALID",
                    "domainDetail": det}, 2, errors=[det])

    # (b) EXTERNALLY SUPPLIED / RETAINED SPEC, origin known external:
    #     no public DomainDetailCode names the condition, so domainDetail is
    #     lawfully ABSENT on the termination and the envelope's errors array is
    #     supplied from the route's own envelopeDetail.
    det_b = {"code": "native.capability-spec-invalid",
             "remedy": "supply an analysis specification whose capabilities are "
                       "registered in the native capability matrix",
             "subject": bounded_subject("made-up-capability")}
    out["externally-supplied-spec"] = envelope(
        "failure", {"class": "request-rejected",
                    "errorCode": "REQUEST.PRECONDITION_FAILED"}, 2,
        errors=[det_b])

    # (c) HOST-GENERATED INTERNAL LAYER: a host bug minting its own invalid spec
    det_c = {"code": "HOST.INVARIANT_VIOLATED",
             "remedy": "report this host defect with the retained operational "
                       "diagnostic record",
             "subject": bounded_subject("analysis-spec")}
    out["host-generated-internal"] = envelope(
        "failure", {"class": "operational-failed",
                    "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
                    "faultCause": "host-invariant"}, 4, errors=[det_c])

    # (d) PRODUCER BOUNDARY: a Coverage cause/carrier violation
    det_d = {"code": "native.coverage-cause-unsupported",
             "remedy": "the provider emitted a deficiency/cause pair the "
                       "registry does not permit; re-run with a conforming "
                       "provider",
             "subject": bounded_subject(
                 "native.coverage-cause-not-for-deficiency:"
                 "input-closure-incomplete:capability-missing".split(":", 1)[1])}
    out["producer-boundary"] = envelope(
        "failure", {"class": "operational-failed",
                    "errorCode": "PROVIDER.PROTOCOL_VIOLATION",
                    "faultCause": "provider-protocol"}, 4, errors=[det_d])

    # (e) a well-formed request for a NOT-SELECTED cell is origin-independent
    det_e = {"code": "PROVIDER.NOT_SELECTED",
             "remedy": "clones-cross-tsjs is outside D-371 for rust-cargo; "
                       "remove it from the request",
             "subject": bounded_subject("clones-cross-tsjs@rust-cargo")}
    out["not-selected-cell"] = envelope(
        "failure", {"class": "request-rejected",
                    "errorCode": "REQUEST.UNSATISFIABLE",
                    "domainDetail": det_e}, 2, errors=[det_e])

    # (f) the BOUNDED diagnostic projection: a structurally valid 4096-char
    #     languageMode overflows BoundedText(1024)
    long_mode = "m" * 4096
    raw = "native.requested-capability-mode-unregistered:" + long_mode
    sub = bounded_subject(raw.split(":", 1)[1])
    det_f = {"code": "CONFIG.INVALID",
             "remedy": "use a registered language mode",
             "subject": sub}
    out["bounded-subject"] = envelope(
        "failure", {"class": "request-rejected", "errorCode": "CONFIG.INVALID",
                    "domainDetail": det_f}, 2, errors=[det_f])
    out["_boundedSubjectLen"] = len(sub)
    out["_boundedSubjectDigest"] = sub[-64:]
    out["_boundedSubjectDigestIsOfUntruncated"] = (
        sub[-64:] == hashlib.sha256(long_mode.encode("utf-8")).hexdigest())

    # (g) required-output failure AFTER a committed Run
    det_g = {"code": "DELIVERY.RENDERER_FAILED_AFTER_COMMIT",
             "remedy": "re-render the retained Run; the Run is unchanged"}
    out["required-delivery-after-commit"] = envelope(
        "failure", {"class": "operational-failed",
                    "errorCode": "DELIVERY.REQUIRED_FAILED",
                    "faultCause": "delivery-required",
                    "runId": "run2:" + "1c" * 32,
                    "domainDetail": det_g}, 4, errors=[det_g])
    return out


# ---------------------------------------------------------------------------
# 3. Pinned purge refusal (identity S5 + workflows S12)
# ---------------------------------------------------------------------------
def pinned_purge_refusal(run_id, pins):
    disc = {"runId": run_id,
            "activePins": sorted(pins, key=lambda p: p["pinId"].encode("utf-8")),
            "consequences": ["named-pins-revoked",
                             "dependent-evidence-replay-unavailable",
                             "sealed-history-retained"]}
    det = {"code": "evidence.pinned",
           "remedy": "revoke the named pins through the explicit destructive "
                     "purge authorization, or purge a Run that is not pinned",
           "subject": run_id, "purgeDisclosure": disc}
    return envelope("failure",
                    {"class": "request-rejected",
                     "errorCode": "REQUEST.PRECONDITION_FAILED",
                     "domainDetail": det}, 2, errors=[det])


# ---------------------------------------------------------------------------
# 4. Generic mutation replay scope vs the distinct repair-apply key
# ---------------------------------------------------------------------------
def mutation_keys():
    scope = {"schemaVersion": 1, "requestId": REQ, "stepId": 2,
             "projectId": PROJECT, "operation": "waiver-change"}
    generic_key = H("workflow.mutation-intent", scope)     # BARE 64-hex
    repair_plan_id = "repairplan2:" + "7e" * 32
    base_snapshot = "snapshot2:" + "5a" * 32
    apply_pre = {"operation": "repair-apply", "projectId": PROJECT,
                 "repairPlanId": repair_plan_id,
                 "baseSnapshotId": base_snapshot}
    apply_key = raw_digest(apply_pre)                      # RAW SHA-256 of C()
    # a DIFFERENT fresh request never deduplicates the first one's mutation
    scope2 = dict(scope, requestId="req1_" + "c4" * 16)
    return {"replayScope": scope,
            "replayScopeCanonicalBytes": C(scope).decode(),
            "genericIdempotencyKey": generic_key,
            "genericKeyIsBare64Hex": len(generic_key) == 64,
            "freshRequestKey": H("workflow.mutation-intent", scope2),
            "freshRequestKeyDiffers":
                H("workflow.mutation-intent", scope2) != generic_key,
            "repairApplyPreimage": apply_pre,
            "repairApplyPreimageBytes": C(apply_pre).decode(),
            "repairApplyKey": apply_key,
            "recipesAreDifferent": apply_key != generic_key,
            "repairApplyIsRawNotH":
                apply_key != H("workflow.mutation-intent", apply_pre)}


