MATRIX = O.doc("matrix")
CAPS = [c["id"] for c in MATRIX["capabilities"]]
CELL = {(c["capability"], c["mode"]): c for c in MATRIX["cells"]}
INV = O.doc("command-inventory")
COMMANDS = {c["name"]: c for c in INV["commands"]}
