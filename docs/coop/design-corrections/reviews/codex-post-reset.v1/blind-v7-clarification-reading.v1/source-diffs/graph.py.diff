+    def admit_every_retained_object(self, w):
+        """CLARIFICATION v1: admit EVERY retained typed object against its
+        owning schema AND its declared x-opensip-order.  Returns the measured
+        coverage so the report can state scope rather than assert totality."""
+        covered, uncovered = {}, []
+        for key, desc in sorted(w.objects.items()):
+            if key.startswith("sha256:"):
+                hx = key.split(":", 1)[1]
+                dom = w.frames[hx][0]
+                sel = native_selector(dom)
+                if sel is None:
+                    uncovered.append((key, dom))
+                    self.bad("UNREGISTERED_H_DOMAIN[retained-object]", dom)
+                    continue
+                document, selector = sel
+            else:
+                dom = {v: k for k, v in O.IDENTITY_PREFIX.items()}.get(
+                    key.split(":", 1)[0])
+                if dom is None or dom not in FOUNDATION_SELECTOR:
+                    uncovered.append((key, dom))
+                    self.bad("RETAINED_OBJECT_DOMAIN_UNREGISTERED", str(dom))
+                    continue
+                document, selector = "identity", FOUNDATION_SELECTOR[dom]
+            self.schema(document, selector, desc, dom)
+            covered[dom] = covered.get(dom, 0) + 1
+        self.objectAdmissionCoverage = {"byDomain": covered,
+                                        "uncovered": uncovered}
+        return covered
