+# CLARIFICATION v1 (root feedback item 1).  native S1.2 requires "every grammar
+# definition, the bundle manifest and the normalizer specification present in
+# the RETAINED TREE" of the admitted kind=grammar closure.  The ORIGINAL builder
+# put unrelated placeholder bytes in the tree and retained the actual
+# bundleDigest / grammarDigest bytes as loose CAS blobs, so the declared members
+# were absent from their own closure tree.  The tree is now BUILT FROM the exact
+# bytes the bundle declares.
+GRAMMAR_BUNDLE_MANIFEST = b"opensip grammar bundle manifest v4.2.0\n"
+GRAMMAR_NORMALIZER_SPEC = (b"opensip grammar normalizer specification v1.0.0\n"
+                           b"clone normalisation levels L0-L3\n")
+
+
+def grammar_definition_bytes(lang):
+    return ("opensip grammar definition: %s v1.0.0\n" % lang).encode("utf-8")
+
+
+def grammar_tree(langs):
+    """The exact tree members native S1.2 requires to be present."""
+    tree = {"bundle/manifest.json": GRAMMAR_BUNDLE_MANIFEST,
+            "spec/normalizer.txt": GRAMMAR_NORMALIZER_SPEC}
+    for lang in langs:
+        tree["grammars/%s.grammar" % lang] = grammar_definition_bytes(lang)
+    return tree
 
 
