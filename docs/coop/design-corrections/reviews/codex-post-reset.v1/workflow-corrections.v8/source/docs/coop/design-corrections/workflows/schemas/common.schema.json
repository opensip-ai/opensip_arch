{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:product-v1:workflows:common",
  "title": "Shared closed primitives for the product-v1 workflows and surfaces unit (PROPOSED, revised after Codex feedback v1)",
  "description": "Every identity text form is either the existing host form (ProjectId PROJECT-ID-V1, RequestId, ExecutionId EXECUTION-ID-V1 from c2-plan-stage-schema.v4) or a product major-two successor named in foundation/identity-schemas.v2.json (snapshot2, plan2, closure2, import2, fact2, coverage2, view2, exec-plan2, finding-key2, evidence2, run2). Workflow-owned identities are H(domain, descriptor) under the foundation canonical recipe with the domains listed in the contract; this unit never defines a second canonicalizer. No float-typed field exists anywhere in this unit; loaders refuse float lexemes, -0, duplicate keys and lone surrogates before schema validation.",
  "$defs": {
    "RequestId": {
      "type": "string",
      "pattern": "^req1_[0-9a-f]{32}(?![\\s\\S])"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj1-[0-9a-f]{64}(?![\\s\\S])"
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "^exec1_[0-9a-f]{32}(?![\\s\\S])",
      "description": "EXECUTION-ID-V1: exact selector docs/coop/artifacts/c2-plan-stage-schema.v4.json $.planIntent.wireTypes.executionId (grammar only; that artifact records under ownershipHonesty/RES-C2V4-01 that no producing recipe is declared anywhere in the corpus). Production values are host-minted 128-bit operational identifiers of the same shape as REQUEST-ID-V1; they are never derived from content. The reference model's values are SYNTHETIC fixture labels (see workflows_model.synthetic_execution_id) and are not a recipe. The historical R-1 fixture grammar 'execution:<text>' is not admitted by this unit."
    },
    "SnapshotId": {
      "type": "string",
      "pattern": "^snapshot2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "PlanId": {
      "type": "string",
      "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ClosureId": {
      "type": "string",
      "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ImportId": {
      "type": "string",
      "pattern": "^import2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^evidence2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ExecutionPlanId": {
      "type": "string",
      "pattern": "^exec-plan2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "CoverageId": {
      "type": "string",
      "pattern": "^coverage2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^finding-key2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "RepairPlanId": {
      "type": "string",
      "pattern": "^repairplan2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ReceiptId": {
      "type": "string",
      "pattern": "^receipt2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "BaselineId": {
      "type": "string",
      "pattern": "^baseline2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ComparisonResultId": {
      "type": "string",
      "pattern": "^comparison2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "PolicyTestResultId": {
      "type": "string",
      "pattern": "^policytest2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "CandidateId": {
      "type": "string",
      "pattern": "^candidate2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "ContributionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "CanonicalIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*(?![\\s\\S])"
    },
    "SemanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])",
      "maxLength": 128
    },
    "LogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\\\u0000]{1,255}(/[^/\\\\\\u0000]{1,255})*(?![\\s\\S])",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      },
      "description": "Strict sealed logical path: relative, slash-separated, no empty/dot/dot-dot/NUL/backslash segments, each segment at most 255 bytes-as-characters. Used for snapshot inventories, edits, archive members, cwd and every identity-bearing path. Never a user-typed OS path."
    },
    "UserInputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "A user-named OS path (baseline file, import artifact, output file). Opened only through the security unit's nofollow/ACL custody; never enters any content identity; recorded in operational records only."
    },
    "GlobPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\\\u0000]+(?![\\s\\S])",
      "description": "Closed glob over LogicalPath: literal characters plus '*', '?' and a whole-segment '**'. No brace, class or escape syntax."
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "UtcDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "BoundedText": {
      "type": "string",
      "maxLength": 1024
    },
    "Uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "Uint53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "StepId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "StageOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "D9Class": {
      "type": "string",
      "enum": [
        "success",
        "policy-failed",
        "request-rejected",
        "indeterminate",
        "operational-failed",
        "interrupted"
