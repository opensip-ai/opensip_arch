        "remedy"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/DomainDetailCode"
        },
        "remedy": {
          "$ref": "#/$defs/BoundedText"
        },
        "subject": {
          "$ref": "#/$defs/BoundedText"
        },
        "purgeDisclosure": {
          "$ref": "#/$defs/PinnedPurgeDisclosure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "evidence.pinned"
              }
            }
          },
          "then": {
            "required": [
              "subject",
              "purgeDisclosure"
            ]
          },
          "else": {
            "not": {
              "required": [
                "purgeDisclosure"
              ]
            }
          }
        }
      ]
    },
    "StepTermination": {
      "type": "object",
      "description": "D9-shaped per-step or aggregate termination. exitCode is never stored; it derives from class by the fixed table (0,1,2,3,4,130). Branch contract: success carries no errorCode/reasonCodes/signal; policy-failed requires runId, or authority=ephemeral when the failing analysis was explicitly non-authoritative and therefore has no Run; request-rejected and operational-failed require errorCode (operational-failed also a non-none faultCause); indeterminate requires reasonCodes; interrupted requires signal and may carry runId only when a Run was committed before the interrupt.",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/D9Class"
        },
        "authority": {
          "type": "string",
          "enum": [
            "authoritative",
            "ephemeral"
          ]
        },
        "errorCode": {
          "$ref": "#/$defs/D9ErrorCode"
        },
        "faultCause": {
          "$ref": "#/$defs/D9FaultCause"
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/D9ReasonCode"
          },
          "x-opensip-order": "sequence"
        },
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "executionId": {
          "$ref": "#/$defs/ExecutionId"
        },
        "coverageId": {
          "$ref": "#/$defs/CoverageId"
        },
        "signal": {
          "$ref": "#/$defs/D9Signal"
        },
        "domainDetail": {
          "$ref": "#/$defs/DomainDetail"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "success"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "errorCode"
                  ]
                },
                {
                  "required": [
                    "reasonCodes"
                  ]
                },
                {
                  "required": [
                    "signal"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "policy-failed"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "runId"
                ]
              },
              {
                "required": [
                  "authority"
                ],
                "properties": {
                  "authority": {
                    "const": "ephemeral"
                  }
                },
                "not": {
                  "required": [
                    "runId"
                  ]
                }
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "errorCode"
                  ]
                },
                {
                  "required": [
                    "signal"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "authority"
            ],
            "properties": {
              "authority": {
                "const": "ephemeral"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "runId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "request-rejected"
              }
            }
          },
          "then": {
            "required": [
              "errorCode"
            ],
            "not": {
              "required": [
                "signal"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "operational-failed"
              }
            }
          },
          "then": {
            "required": [
              "errorCode",
              "faultCause"
            ],
            "properties": {
              "faultCause": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "indeterminate"
              }
            }
          },
          "then": {
            "required": [
              "reasonCodes"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "errorCode"
                  ]
                },
                {
                  "required": [
                    "signal"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "interrupted"
              }
            }
          },
          "then": {
            "required": [
              "signal"
            ],
            "not": {
              "required": [
                "errorCode"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "domainDetail"
            ],
            "properties": {
              "domainDetail": {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "const": "evidence.pinned"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "errorCode"
            ],
            "properties": {
              "class": {
                "const": "request-rejected"
              },
              "errorCode": {
                "const": "REQUEST.PRECONDITION_FAILED"
              }
            }
          }
        }
      ]
    },
    "VcsRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "commit",
        "dirty"
      ],
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "git"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "SourceCorrespondence": {
      "type": "object",
      "description": "Mandatory correspondence of external evidence to analyzed source. exact-snapshot binds a snapshot2 and is the only correspondence that is mapped by itself. vcs-revision binds a commit plus dirty flag and optional build identity; a commit string (even clean) or a declared build identity is a STATEMENT and cannot prove which generated/runtime bytes correspond to which snapshot bytes, so vcs-revision evidence is consumable only when an admitted SourceMappingV1 (imported-evidence schema) joins every consumed generated path to a snapshot2 inventory entry by digest; otherwise it is unmapped-only. The wrapper's sourceCorrespondenceDigest is the raw SHA-256 of this record's canonical bytes, retained as a blob.",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact-snapshot",
            "vcs-revision"
          ]
        },
        "snapshotId": {
          "$ref": "#/$defs/SnapshotId"
        },
        "vcsRevision": {
          "$ref": "#/$defs/VcsRevision"
        },
        "buildIdentity": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMappingDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256Hex"
            },
            {
              "type": "null"
            }
          ],
          "description": "raw SHA-256 of the canonical SourceMappingV1 bytes admitted with this evidence, or null when none was supplied (then vcs-revision evidence is unmapped-only)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exact-snapshot"
              }
            }
          },
          "then": {
            "required": [
              "snapshotId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "vcsRevision"
                  ]
                },
                {
                  "required": [
                    "buildIdentity"
                  ]
                },
                {
                  "required": [
                    "sourceMappingDigest"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vcs-revision"
              }
            }
          },
          "then": {
            "required": [
              "vcsRevision",
              "buildIdentity",
              "sourceMappingDigest"
            ],
            "not": {
              "required": [
                "snapshotId"
              ]
            }
          }
        }
      ]
    },
    "Blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/LogicalPath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        }
      }
    },
    "RepairAuthorizationRef": {
      "type": "string",
      "pattern": "^security\\.repair-apply-authorization\\.v1:[0-9a-f]{64}(?![\\s\\S])",
      "description": "Exact product H(security.repair-apply-authorization.v1, admitted RepairApplyAuthorizationV1) with the security.repair-apply-authorization.v1 prefix; current host admission is mandatory."
    },
    "RepairRecoveryAuthorizationRef": {
      "type": "string",
      "pattern": "^security\\.repair-recovery-authorization\\.v1:[0-9a-f]{64}(?![\\s\\S])"
    },
    "RepairJournalRef": {
      "type": "string",
      "pattern": "^security\\.repair-apply-journal-identity\\.v1:[0-9a-f]{64}(?![\\s\\S])"
    },
    "InstallationTransitionJournalRef": {
      "type": "string",
      "pattern": "^security\\.installation-transition-journal\\.v1:[0-9a-f]{64}(?![\\s\\S])"
    },
    "PinnedPurgeDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "activePins",
        "consequences"
      ],
      "description": "Complete current pin inventory observed under the purge writer lease. Operational pinId is a host-ledger name scoped to this Run, not a content identity or authority token. Never truncate this disclosure or infer destructive consent from it.",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "activePins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "x-opensip-order": {
            "by": [
              "pinId"
            ]
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pinId",
              "kind"
            ],
            "properties": {
              "pinId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "enum": [
                  "baseline",
                  "repair-prerequisite",
                  "backup-export",
                  "other-authorized"
                ]
              }
            }
          }
        },
        "consequences": {
          "type": "array",
          "const": [
            "named-pins-revoked",
            "dependent-evidence-replay-unavailable",
            "sealed-history-retained"
          ],
          "items": {
            "type": "string"
          },
          "x-opensip-order": "sequence"
        }
      }
    }
  }
}
