        }
      },
      "description": "Product successor of inherited opensip.relation.types.v1 (fact-plane.v1 relationPayloadSchemaRegistryV1). Field set, types, enums, required and optional members are reproduced exactly; only the canonical ENCODING is superseded (C, not CBOR)."
    },
    "UInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "description": "Inherited UInt64. The inherited profile forbade negative integers in relation payloads; every integer field here is therefore unsigned, which is that rule expressed in the schema instead of in a codec."
    },
    "UnresolvedEdgeKindV1": {
      "type": "string",
      "enum": [
        "build-script-generated-unavailable",
        "cfg-excluded-region",
        "computed-member-access",
        "dynamic-import-nonliteral",
        "entry-point-unrecognized",
        "external-module-boundary",
        "ffi-extern",
        "generic-bound-dispatch",
        "indirect-eval",
        "macro-expansion-unavailable",
        "reflective-access",
        "require-nonliteral",
        "structural-dispatch",
        "trait-object-dynamic-dispatch",
        "untyped-any-call",
        "unresolved-module-specifier"
      ],
      "description": "native-evidence section 4.4, closed at sixteen members."
    },
    "UnresolvedEdgePayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail",
        "edgeKind",
        "referrer",
        "relation",
        "targetModule",
        "targetScope"
      ],
      "properties": {
        "referrer": {
