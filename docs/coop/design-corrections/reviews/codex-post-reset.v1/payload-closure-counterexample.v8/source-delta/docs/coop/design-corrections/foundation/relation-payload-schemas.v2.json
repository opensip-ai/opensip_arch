            "imports",
            "reachability",
            "references",
            "types"
          ]
        },
        "edgeKind": {
          "$ref": "#/$defs/UnresolvedEdgeKindV1"
        },
        "targetScope": {
          "type": "string",
          "enum": [
            "external",
            "module",
            "universe",
            "unknown"
          ]
        },
        "targetModule": {
          "oneOf": [
            {
              "$ref": "#/$defs/CanonicalText"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        }
      },
      "description": "native-evidence section 4.4 relation unresolved-edge, ladder [observed], universeRule same-only. targetModule is explicitly null when absent: the field set is closed, so an absent optional is spelled null rather than omitted."
    },
