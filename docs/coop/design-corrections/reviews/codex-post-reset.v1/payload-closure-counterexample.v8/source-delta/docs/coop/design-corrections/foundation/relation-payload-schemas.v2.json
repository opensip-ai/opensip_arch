    },
    "Sha256Text": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "SubjectIdV1": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4096,
      "pattern": "^[a-z][a-z0-9-]*:[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
      "description": "Inherited SubjectIdV1: CanonicalText holding a non-empty lowercase ASCII namespace, a colon and a non-empty opaque NFC identity."
    },
    "TypesPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "typeText"
      ],
      "properties": {
        "subject": {
