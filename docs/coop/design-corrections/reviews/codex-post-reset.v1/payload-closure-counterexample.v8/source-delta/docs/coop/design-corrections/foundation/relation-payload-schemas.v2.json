  "$defs": {
    "CallsPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calleeText",
        "caller"
      ],
      "properties": {
        "caller": {
          "$ref": "#/$defs/SubjectIdV1"
        },
        "calleeText": {
          "$ref": "#/$defs/CanonicalText"
        },
        "resolvedCallee": {
          "$ref": "#/$defs/SubjectIdV1"
        }
      },
      "description": "Product successor of inherited opensip.relation.calls.v1 (fact-plane.v1 relationPayloadSchemaRegistryV1). Field set, types, enums, required and optional members are reproduced exactly; only the canonical ENCODING is superseded (C, not CBOR)."
    },
    "CanonicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000\\\\]+(?![\\s\\S])",
      "description": "Inherited CanonicalPath: non-empty NFC project-relative path, slash separators, no empty/dot/dot-dot segment, no leading slash or backslash."
    },
    "CanonicalText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
      "description": "Inherited CanonicalText: non-empty NFC text with no C0/C1 control characters. NFC text is an ADMISSION rule, not an encoder rule: C never normalizes. The host admits a relation payload only when every text value is already NFC, exactly as the inherited deterministic-CBOR profile required, and refuses otherwise."
    },
    "ClonesPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodyIdentity",
        "normalisationLevel",
        "normalisationVersion"
      ],
      "properties": {
        "bodyIdentity": {
          "$ref": "#/$defs/Sha256Text"
        },
        "normalisationLevel": {
          "type": "string",
          "enum": [
            "L0-verbatim",
            "L1-lexical",
            "L2-comment-insensitive",
            "L3-identifier-insensitive"
          ]
        },
        "normalisationVersion": {
          "$ref": "#/$defs/DigestHex"
        }
      },
      "description": "Product successor of inherited opensip.relation.clones.v1 (fact-plane.v1 relationPayloadSchemaRegistryV1). Field set, types, enums, required and optional members are reproduced exactly; only the canonical ENCODING is superseded (C, not CBOR)."
    },
    "ControlFlowPayloadV1": {
