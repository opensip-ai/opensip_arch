+def admit_parameter_selection(parameters):
+    """AT MOST ONE selected parameter per registered row, for ONE spec (CB8-MUST-1).
+
+    A parameter row is a Plan INPUT and its payload is the value the analysis runs with. Two
+    entries resolving to one row put two values in one input slot, and nothing in the graph decides
+    which is the Plan's: both are admitted by identity closure, both satisfy the existential
+    workflow scope binding verifier, and both enter analysisSpecDigest and therefore PlanId. The
+    registry law already refuses an arbitrary selection between two ROWS
+    (PAYLOAD_PARAMETER_AMBIGUOUS_ROW); this is the same refusal one level down, over two SPEC
+    ENTRIES, which that rule never constrained.
+
+    NO DEFAULT, no first-listed or last-listed winner and no merge: the caller states one
+    parameter or none. ZERO stays legal - an ordinary analysis that needs no scope-policy input
+    selects none and closes - and a caller that DOES need one still meets the explicit
+    missing-selection refusal at the workflow binding verifier, so absence is never silently
+    substituted and the foundation scope-descriptor never stands in for ScopeDocumentV1.
+
+    Whole-item duplicates are a DIFFERENT and already-answered defect: `parameters` is uniqueItems
+    with x-opensip-order canonical-set, so two byte-identical entries refuse on the schema and on
+    the collection order law before this is reached. This owns only DISTINCT entries citing one
+    row, which neither of those can see. An entry citing an unregistered document is left alone
+    here too: the payload admission owns that and names it (PAYLOAD_PARAMETER_UNREGISTERED).
+
+    Pure over the parameters array: no Run graph, no blobs and no host state, which is why the
+    pre-Plan boundary and retained Run closure can both call exactly this."""
+    if PAYLOADS['classes']['parameter']['selectionCardinality']['atMostOnePerSpec'] is not True:
+        raise C.AdmissionError('PARAMETER_SELECTION_LAW_UNPUBLISHED')
+    seen={}
+    for entry in parameters:
+        row=parameter_row_of(entry['schemaDigest'])
+        if row is None:continue
+        seen[row]=seen.get(row,0)+1
+    for row in sorted(seen):
+        if seen[row]>1:raise C.AdmissionError('ANALYSIS_SPEC_PARAMETER_SELECTION_AMBIGUOUS:'+row)
+    return parameters
 
