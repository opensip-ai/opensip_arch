+_PARAMETER_ROW_DIGESTS=None
+def parameter_row_of(schema_digest):
+    """The closed `parameter` registry row a spec entry's schemaDigest resolves to, or None.
+
+    It is the SAME resolution `registry_row` performs inside a closure, hoisted so the two
+    boundaries that own the SELECTION law can ask the question without a Run graph. The digest is
+    the raw SHA-256 of the row document's exact full bytes, and it is computed from the registry
+    rather than restated, so a row added to `x-opensip-payload-registry` is covered here with no
+    further edit. `PAYLOAD_PARAMETER_AMBIGUOUS_ROW` - two ROWS one digest resolves to - is a
+    different question and stays where it is; this returns None for that case and lets the closure
+    raise its own, more specific refusal."""
+    global _PARAMETER_ROW_DIGESTS
+    if _PARAMETER_ROW_DIGESTS is None:
+        _PARAMETER_ROW_DIGESTS={}
+        for key,row in PAYLOADS['classes']['parameter']['rows'].items():
+            digest=hashlib.sha256((HERE.parent/row['document']).read_bytes()).hexdigest()
+            _PARAMETER_ROW_DIGESTS.setdefault(digest,[]).append(key)
+    rows=_PARAMETER_ROW_DIGESTS.get(schema_digest)
+    return rows[0] if rows is not None and len(rows)==1 else None
