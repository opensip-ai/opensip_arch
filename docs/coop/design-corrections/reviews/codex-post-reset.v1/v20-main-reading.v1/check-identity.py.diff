+def assert_complete(entry,**extra):
+    """Inject a CONSISTENTLY asserted `complete` Coverage claim, in place.
+
+    RC-6 (CB8-MUST-3) refuses `coverage=complete` beside `examinedExhaustive=false`, and it runs at
+    the PRODUCER boundary - one layer before every Run-closure capability/dialect prerequisite. A
+    vector that flipped `coverage` alone on an entry the producer had built as an honest `unknown`
+    would therefore stop at RC-6 and would no longer reach the guard it was written to exercise:
+    the deeper guard would be masked and the control would silently stop measuring it.
+
+    So the lie is made INTERNALLY COHERENT: the entry also asserts that it examined the partition
+    exhaustively. That is a strictly more adversarial provider - one that lies consistently - and it
+    leaves the guard under test as the only thing that can refuse it. RC-6's own vectors assert the
+    INCOHERENT pair on purpose and are separate."""
+    entry.update(coverage='complete',deficiency=None,nativeCause=None,**extra)
+    entry['resolutionCompleteness']=dict(entry['resolutionCompleteness'],examinedExhaustive=True)
+    return entry
