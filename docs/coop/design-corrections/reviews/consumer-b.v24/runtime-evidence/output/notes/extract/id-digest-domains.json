      "typescriptStdlibMerkleRoot": "same, and it is a retained artifact digest not a language identity",
      "standardLibraryComponentDigests": "same",
      "languageMode": "configuration and program assembly, not the language",
      "synthesizerVersion": "the option synthesizer, not the compiler that reads the body",
      "packageModuleType": "module resolution semantics, not body interpretation",
      "anchorPath": "the path establishes the variant and then does not enter the record; two identical bodies at different paths in one variant have one identity"
     },
     "bodyLanguages": [
      "typescript",
      "javascript"
     ],
     "bodyLanguageByVariant": {
