{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:product-v1:evaluator-emission-plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyDigest",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "x-opensip-digest": {
        "representation": "canonical-record",
        "retention": "preimage",
        "record": {
          "document": "workflows/schemas/policy-document.v2.schema.json",
          "selector": "#/$defs/PolicyDocumentV2"
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "contributionId",
          "ruleStableId",
          "semanticsMajor",
          "detectorClosure",
          "stabilityClass",
          "emissionProfile"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contributionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ruleStableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "semanticsMajor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "detectorClosure": {
            "type": "string",
            "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
          },
          "stabilityClass": {
            "const": "path-stable"
          },
          "emissionProfile": {
            "const": "declarative-subject-v1"
          }
        }
      },
      "uniqueItems": true,
      "x-opensip-order": {
        "by": [
          "ruleId"
        ]
      }
    }
  },
  "description": "Acyclic pre-Plan parameter. Exactly one explicit binding for every policy rule including disabled. Policy is independently resolved; never hashes this parameter. All RuleProgramRef fields equal policy; detectorClosure is a Plan-selected kind=detector closure. This binds provenance, not a signature-token oracle: inventory detector projections supply tokens. Duplicate rule IDs refuse. No claim to derive a third-party contribution manifest from a closure name.",
  "x-opensip-uniqueness": {
    "rules": [
      "ruleId"
    ],
    "fingerprintRuleNamespace": [
      "ruleStableId",
      "semanticsMajor"
    ],
    "law": "All rows including disabled; enforced at evaluator3 Plan admission. No two rules may mint the same fingerprint namespace."
  },
  "x-opensip-parameter-registry-extension": {
    "document": "foundation/evaluator-emission-plan.schema.v1.json",
    "selector": "#",
    "keyIsTheDocumentNotThePair": true,
    "atMostOnePerSpec": true,
    "requiredForEvaluatorMajors": [
      3
    ]
  }
}
