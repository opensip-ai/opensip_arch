+def foundation_digest_annotation_coverage(document_schema):
+    """Every bare 64-hex position of one record document, and whether an `x-opensip-digest` covers it.
+
+    A position is a node whose `pattern` is the bare digest pattern, or a local `$ref` to a `$def` that
+    is. It is covered by an annotation on the leaf, on a branch, on an `items` node or on the enclosing
+    property node (the nullable `oneOf` shape) - never by one on the terminal `DigestHex` `$def`, which
+    would exempt every field of that form at once. Schema-only: it decides law coherence, not bytes."""
+    defs=document_schema.get('$defs',{})
+    hex_defs={name for name,node in defs.items() if type(node) is dict and node.get('pattern')==BARE_HEX_DIGEST_PATTERN}
+    seen={}
+    def walk(node,path,covered,chain=()):
+        if type(node) is list:
+            for index,item in enumerate(node):walk(item,path+'['+str(index)+']',covered,chain)
+            return
+        if type(node) is not dict:return
+        covered=covered or 'x-opensip-digest' in node
+        reference=node.get('$ref')
+        local=isinstance(reference,str) and reference.startswith('#/$defs/')
+        if node.get('pattern')==BARE_HEX_DIGEST_PATTERN or (local and reference.split('/')[-1] in hex_defs):
+            seen[path]=seen.get(path,True) and covered
+            return
+        if local and reference.split('/')[-1] in defs and reference not in chain:
+            walk(defs[reference.split('/')[-1]],path,covered,chain+(reference,))
+        for key,child in node.items():
+            if key=='properties' and type(child) is dict:
+                for name,schema in child.items():walk(schema,path+'/'+name,covered)
+            elif key in ('items','additionalProperties'):walk(child,path+'[]',covered)
+            elif key in ('oneOf','anyOf','allOf') and type(child) is list:
+                for index,branch in enumerate(child):walk(branch,path+'|'+key+str(index),covered)
+    walk({k:v for k,v in document_schema.items() if k!='$defs'},'#',False)
+    for name,node in defs.items():
+        if name not in hex_defs:walk(node,'#/$defs/'+name,False)
+    return {'total':len(seen),'annotated':sum(1 for ok in seen.values() if ok),
+            'unannotated':sorted(path for path,ok in seen.items() if not ok)}
+
