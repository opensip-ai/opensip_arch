{
 "type": "object",
 "properties": {
  "catalogSchema": {
   "const": 1
  },
  "snapshotVersion": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9223372036854775807
  },
  "issuedAt": {
   "type": "string",
   "maxLength": 20,
   "minLength": 1,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "expiresAt": {
   "type": "string",
   "maxLength": 20,
   "minLength": 1,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "rootVersionRequired": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9223372036854775807
  },
  "revocationVersionRequired": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9223372036854775807
  },
  "reservedRootCommands": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
   },
   "maxItems": 256,
   "minItems": 0,
   "uniqueItems": true
  },
  "releases": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "stableId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     },
     "publisher": {
      "type": "string",
      "maxLength": 4194304,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
     },
     "sourceClass": {
      "enum": [
       "first-party",
       "explicitly-trusted"
      ]
     },
     "version": {
      "type": "string",
      "maxLength": 4194304,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
     },
     "manifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "minLength": 64
     },
     "manifestPreimageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "minLength": 64
     },
     "envelopeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "minLength": 64
     },
     "hostCoreConstraint": {
      "type": "object",
      "properties": {
       "min": {
        "type": "string",
        "maxLength": 4194304,
        "minLength": 1,
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
       },
       "max": {
        "type": "string",
        "maxLength": 4194304,
        "minLength": 1,
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
       },
       "includeMin": {
        "type": "boolean"
       },
       "includeMax": {
        "type": "boolean"
       }
      },
      "required": [
       "min",
       "max",
       "includeMin",
       "includeMax"
      ],
      "additionalProperties": false
     },
     "artifacts": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "platform": {
         "enum": [
          "macos-arm64",
          "macos-x86_64",
          "linux-x86_64",
          "linux-arm64"
         ]
        },
        "archiveProfileId": {
         "type": "string",
         "maxLength": 64,
         "minLength": 1
        },
        "archiveDigest": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$",
         "maxLength": 64,
         "minLength": 64
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$",
         "maxLength": 64,
         "minLength": 64
        }
       },
       "required": [
        "platform",
        "archiveProfileId",
        "archiveDigest",
        "sha256"
       ],
       "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
     }
    },
    "required": [
     "stableId",
     "publisher",
     "sourceClass",
     "version",
     "manifestDigest",
     "manifestPreimageSha256",
     "envelopeDigest",
     "hostCoreConstraint",
     "artifacts"
    ],
    "additionalProperties": false
   },
   "maxItems": 100000,
   "minItems": 0
  }
 },
 "required": [
  "catalogSchema",
  "snapshotVersion",
  "issuedAt",
  "expiresAt",
  "rootVersionRequired",
  "revocationVersionRequired",
  "reservedRootCommands",
  "releases"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:opensip:design:catalog:1",
 "title": "opensip-catalog.1 (release catalog; TR-INDEX signed; supersedes the signed half of component-manifest-schemas.v11 indexSchema)"
}
