   "case": "annotation-publishes-the-producer-interface-registration",
   "ok": true,
   "detail": {
    "representation": "raw-artifact",
    "artifactClass": "producer-interface-stage-output-schema",
    "artifact": "the exact complete bytes of the stage output schema document REGISTERED BY this stage-spec's producerClosure: the member of that closure's tree at registeredBy.treePath",
    "registeredBy": {
     "closureField": "producerClosure",
     "treePath": "opensip-interface/stage-output/{operation}.schema.json",
     "operationSegment": "^[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])",
     "declaration": "x-opensip-stage-output",
     "declares": {
      "schemaVersion": 1,
      "operation": "stage-spec.operation",
      "outputDomains": "stage-spec.outputDomains"
     },
     "refusals": [
      "STAGE_OUTPUT_SCHEMA_OPERATION_NOT_A_PATH_SEGMENT",
      "STAGE_OUTPUT_SCHEMA_UNREGISTERED",
      "STAGE_OUTPUT_SCHEMA_REGISTRATION_MISMATCH",
      "STAGE_OUTPUT_SCHEMA_DOCUMENT_INVALID",
      "STAGE_OUTPUT_SCHEMA_DECLARATION_MISMATCH"
     ],
     "law": "Retained bytes are not a registration. The producer interface that owns the operation owns its output schema, so the schema is registered exactly when the Plan-selected producer closure carries it at the tree path for that operation; a new operation is registered by shipping its interface document in the admitted closure, never by a host or platform table."
    }
   }
  },
