+  project_key_digest TEXT    NOT NULL CHECK (typeof(project_key_digest) = 'text'
+                               AND length(project_key_digest) = 64
+                               AND instr(project_key_digest, char(0)) = 0
+                               AND project_key_digest NOT GLOB '*[^0-9a-f]*'),
