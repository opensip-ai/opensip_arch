{
 "type": "object",
 "properties": {
  "envelopeSchema": {
   "const": 2
  },
  "subject": {
   "type": "object",
   "properties": {
    "kind": {
     "enum": [
      "manifest",
      "catalog",
      "root",
      "revocation",
      "inventory",
      "payload"
     ]
    },
    "domain": {
     "enum": [
      "opensip.metadata.catalog.1",
      "opensip.metadata.inventory.1",
      "opensip.metadata.manifest.1",
      "opensip.metadata.payload.1",
      "opensip.metadata.revocation.1",
      "opensip.metadata.root.1"
     ]
    },
    "storedSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "maxLength": 64,
     "minLength": 64
    },
    "preimageSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "maxLength": 64,
     "minLength": 64
    }
   },
   "required": [
    "kind",
    "domain",
    "storedSha256",
    "preimageSha256"
   ],
   "additionalProperties": false
  },
  "role": {
   "enum": [
    "ROOT",
    "TR-CORE",
    "TR-INDEX",
    "TR-COMPONENT",
    "TR-BUNDLE"
   ]
  },
  "namespace": {
   "type": "string",
   "maxLength": 4194304,
   "minLength": 1,
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "signatures": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "minLength": 64
     },
     "alg": {
      "const": "ed25519"
     },
     "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "maxLength": 128,
      "minLength": 128
     }
    },
    "required": [
     "keyId",
     "alg",
     "signature"
    ],
    "additionalProperties": false
   },
   "maxItems": 16,
   "minItems": 1,
   "uniqueItems": true
  }
 },
 "required": [
  "envelopeSchema",
  "subject",
  "role",
  "namespace",
  "signatures"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:opensip:design:signature-envelope:2",
 "title": "opensip-signature-envelope.2"
}
