+def _dependency_totality_gaps(rel: str, source_u: str, want_t: str | None, inputs: dict,
+                              owed_subjects: set[str], owed_kind: str | None, view: dict) -> list[str]:
+    """Contract section 4, dependency totality: same-kind dependency positions that do not cover EVERY owed subject.
+
+    A position is filled by whichever selected partitions exist, so before this check one subject's
+    dependency partition closed the dependency for a whole primary partition {f, g}, while the same
+    subjects regrouped into disjoint primary partitions did not. An owed subject is COVERED for
+    dependency relation R when some `_scopes_exact` scope at exact (R, rung, S) contains it and pairs at
+    least one Coverage at exact (R, rung, S, T). Only positions present in `view` are checked: an absent
+    position is already answered by the native owner. Different-kind dependencies stay whole-source and
+    are not subject-checked, and an empty owed set owes no subject. The result is a list of relations in
+    `_depends_chain` order; the caller evaluates the view without them, it fabricates nothing.
+    """
+    if not owed_subjects:
+        return []
+    gaps = []
+    for dep in _depends_chain(rel):
+        drel, drung = dep["relation"], dep["minResolution"]
+        if drel not in view or (owed_kind and _source_kind_for_relation(drel) != owed_kind):
+            continue
+        covs = _coverages_exact(inputs, drel, drung, source_u, want_t)
+        covered = set()
+        for sid, sc in _scopes_exact(inputs, drel, drung, source_u):
+            held = {nid for nid in owed_subjects if _scope_contains(sc, nid)}
+            if held and _pair_scope_coverages(sid, sc, covs, inputs):
+                covered |= held
+        if owed_subjects - covered:
+            gaps.append(drel)
+    return gaps
 
 
