{
  "kind": "standingRule",
  "selector": "native-capability-matrix.v2.json languageModes; identity-schemas.v3 domainSets native-context",
  "modes": [
    {
      "mode": "ts-tsconfig",
      "analysisPath": "native.context.typescript.v2 + native.semantic-universe.typescript.v2",
      "representable": true
    },
    {
      "mode": "js-allowjs",
      "analysisPath": "native.context.typescript.v2 + native.semantic-universe.typescript.v2",
      "representable": true
    },
    {
      "mode": "js-synthesized",
      "analysisPath": "native.context.typescript.v2 + native.semantic-universe.typescript.v2",
      "representable": true
    },
    {
      "mode": "rust-cargo",
      "analysisPath": "native.context.rust.v2 + native.semantic-universe.rust.v2",
      "representable": true
    },
    {
      "mode": "rust-cargo-prepared",
      "analysisPath": "native.context.rust.v2 + native.semantic-universe.rust.v2",
      "representable": true
    },
    {
      "mode": "syntax-only",
      "analysisPath": "native.context.syntax.v2 + native.semantic-universe.syntax.v2 (grammar bundle)",
      "representable": true
    }
  ],
  "chosenGrammar": "syntax-only uses SyntaxGrammarBundleV1; ts/js use TypeScriptNativeContextV2; rust uses NativeContextV2"
}
