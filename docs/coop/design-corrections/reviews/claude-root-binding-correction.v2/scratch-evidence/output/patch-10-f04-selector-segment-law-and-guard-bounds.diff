+                             % (UNIT_ROOT_FAULT, where, selector, len(value), low, high))
+    if regex.match(value) is None:
+        raise AdmissionError("%s:%s:%s:%r" % (UNIT_ROOT_FAULT, where, selector, value))
 
 
