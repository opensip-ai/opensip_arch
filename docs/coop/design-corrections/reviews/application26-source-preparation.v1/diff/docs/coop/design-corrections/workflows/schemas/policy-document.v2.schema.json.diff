+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "field": {
+                "const": "exitStatus"
+              },
+              "cmp": {
+                "enum": [
+                  "eq",
+                  "neq",
+                  "gte",
+                  "lte"
+                ]
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "integer",
+                "minimum": 0,
+                "maximum": 255
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "cmp": {
+                "const": "in"
+              },
+              "field": {
+                "not": {
+                  "const": "exitStatus"
+                }
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "array",
+                "items": {
+                  "type": "string"
+                },
+                "x-opensip-order": "sequence"
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "cmp": {
+                "enum": [
+                  "eq",
+                  "neq",
+                  "prefix",
+                  "glob"
+                ]
+              },
+              "field": {
+                "not": {
+                  "const": "exitStatus"
+                }
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "string"
+              }
+            }
+          }
+        }
+      ]
+    },
+    "Atom": {
