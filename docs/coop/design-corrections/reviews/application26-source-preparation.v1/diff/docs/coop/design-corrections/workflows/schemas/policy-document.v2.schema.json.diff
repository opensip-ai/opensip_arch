+              "cmp": {
+                "enum": [
+                  "eq",
+                  "neq",
+                  "in",
+                  "gte",
+                  "lte"
+                ]
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "field": {
+                "const": "exitStatus"
+              },
+              "cmp": {
+                "const": "in"
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "array",
+                "minItems": 1,
+                "maxItems": 64,
+                "uniqueItems": true,
