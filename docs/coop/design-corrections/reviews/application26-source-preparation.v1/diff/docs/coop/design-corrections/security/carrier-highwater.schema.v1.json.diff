+++ b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/security/carrier-highwater.schema.v1.json
@@ -0,0 +1,63 @@
+{
+ "$schema": "https://json-schema.org/draft/2020-12/schema",
+ "$id": "urn:opensip:design:carrier-high-water:1",
+ "title": "PROPOSED private CarrierHighWaterV1 (SC-TRUST per-carrier floor)",
+ "status": "PROPOSED-NOT-SELF-ACCEPTED",
+ "standing": "Design/reference proposal only: no acceptance, no readiness, no application and no implementation authorization.",
+ "description": "Closes a gap: the SC-TRUST per-carrier high-water has no validated shape anywhere in the frozen corpus, while the witness beside it has a strict closed shape validated before any comparison (security-completion.v8 section 5.4). The read-only recovery floor case depends on lastSeq and tailSha256, so the floor record needs the same discipline. Renames carrierFormat-1's 'project' to 'projectKeyDigest' to match the v8 carrier naming. Private operational record; not a public wire schema, not an authority token, and not a semantic identity. Written only under the S7 install fence at operation start and end, never under a project lease.",
+ "type": "object",
+ "additionalProperties": false,
+ "required": [
+  "highWaterSchema",
+  "projectKeyDigest",
+  "grantGeneration",
+  "lastSeq",
+  "tailSha256"
+ ],
+ "properties": {
+  "highWaterSchema": {
+   "type": "integer",
+   "const": 1,
+   "description": "Exactly the integer 1; never a float or boolean."
+  },
+  "projectKeyDigest": {
+   "type": "string",
+   "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
+   "description": "SHA-256 of the projectKey UTF-8 bytes, lowercase hex. Same value the witness uses to name its carrier and the same value the private association carries as journalCarrierDigest."
+  },
+  "grantGeneration": {
+   "type": "integer",
+   "minimum": 1,
+   "maximum": 9223372036854775807
+  },
+  "lastSeq": {
+   "type": "integer",
+   "minimum": 0,
+   "maximum": 9007199254740991,
+   "description": "Highest sequence observed durable at an operation boundary for this carrier and generation. 0 means no observed boundary yet. The uint53 cap applies, matching the physical carrier and not the broader i64 logical record shape."
+  },
+  "tailSha256": {
+   "oneOf": [
+    {
+     "type": "string",
+     "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
+    },
+    {
+     "type": "null"
+    }
+   ],
+   "description": "The domain-framed body_sha256 of the row at lastSeq, i.e. SHA256(opensip.metadata.journal.1 || 0x00 || C(body)). NOT a raw SHA-256 of the body text. Null only when lastSeq is 0. The member must be present; an absent member is not a null."
+  }
+ },
+ "extraAdmissionRules": [
+  "tailSha256 is null if and only if lastSeq is 0.",
+  "Validate this shape before any comparison, exactly as the witness shape is validated. Any violation is a custody condition, never a repair licence.",
+  "A read-only request never raises, lowers or writes this record. Only the ordinary S7 operation-boundary handoff under the fence writes it.",
+  "A tail below lastSeq is the F22 quarantine condition and is never a confirmation.",
+  "A poisoned or restored floor is not lowered by migration or rollback; only S4.5 lowers it."
+ ],
+ "notAClaim": [
+  "Not a cryptographic proof of any prefix. It establishes non-rollback below the last OBSERVED operation boundary only.",
+  "A rollback to a state above the last observed floor performed while no operation was running is not detected, exactly as security-completion.v8 section 5.4 Detection bound states."
+ ]
+}
