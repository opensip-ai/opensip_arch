diff --git a/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/sarif-adapter.schema.json b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/sarif-adapter.schema.json
new file mode 100644
index 00000000..ea6cba61
--- /dev/null
+++ b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/sarif-adapter.schema.json
@@ -0,0 +1,333 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:opensip:product-v1:workflows:evaluator3:sarif-adapter:2",
+  "title": "Closed SARIF 2.1.0 adapter output for evaluator3 findings",
+  "description": "A SARIF 2.1.0 log subset produced from FindingSurface rows. One result per finding3. partialFingerprints only when matched. This is the SARIF document, not the intermediate FindingSurface.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "version",
+    "runs"
+  ],
+  "properties": {
+    "version": {
+      "const": "2.1.0"
+    },
+    "runs": {
+      "type": "array",
+      "minItems": 1,
+      "maxItems": 1,
+      "items": {
+        "$ref": "#/$defs/Run"
+      },
+      "x-opensip-order": "sequence"
+    }
+  },
+  "$defs": {
+    "Run": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "tool",
+        "results",
+        "properties"
+      ],
+      "properties": {
+        "tool": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "driver"
+          ],
+          "properties": {
+            "driver": {
+              "type": "object",
+              "additionalProperties": false,
+              "required": [
+                "name",
+                "rules"
+              ],
+              "properties": {
+                "name": {
+                  "const": "opensip"
+                },
+                "rules": {
+                  "type": "array",
+                  "maxItems": 512,
+                  "items": {
+                    "type": "object",
+                    "additionalProperties": false,
+                    "required": [
+                      "id"
+                    ],
+                    "properties": {
+                      "id": {
+                        "type": "string",
+                        "minLength": 1,
+                        "maxLength": 4096
+                      },
+                      "shortDescription": {
+                        "type": "object",
+                        "additionalProperties": false,
+                        "required": [
+                          "text"
+                        ],
+                        "properties": {
+                          "text": {
+                            "type": "string",
+                            "minLength": 1,
+                            "maxLength": 4096
+                          }
+                        }
+                      },
+                      "messageStrings": {
+                        "type": "object",
+                        "additionalProperties": false,
+                        "minProperties": 1,
+                        "patternProperties": {
+                          "^.+$": {
+                            "type": "object",
+                            "additionalProperties": false,
+                            "required": [
+                              "text"
+                            ],
+                            "properties": {
+                              "text": {
+                                "type": "string",
+                                "minLength": 1,
+                                "maxLength": 4096
+                              }
+                            }
+                          }
+                        },
+                        "description": "Required for every message.id referenced by a result of this rule."
+                      }
+                    }
+                  },
+                  "x-opensip-order": {
+                    "by": [
+                      "id"
+                    ]
+                  }
+                }
+              }
+            }
+          }
+        },
+        "results": {
+          "type": "array",
+          "maxItems": 100000,
+          "items": {
+            "$ref": "#/$defs/Result"
+          },
+          "x-opensip-order": "sequence"
+        },
+        "properties": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "verdict"
+          ],
+          "properties": {
+            "verdict": {
+              "type": "string",
+              "enum": [
+                "pass",
+                "fail",
+                "indeterminate"
+              ]
+            },
+            "deficiency": {
+              "type": "string",
+              "minLength": 1,
+              "maxLength": 4096
+            }
+          }
+        }
+      }
+    },
+    "Result": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "ruleId",
+        "level",
+        "message",
+        "locations",
+        "properties"
+      ],
+      "properties": {
+        "ruleId": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 4096
+        },
+        "level": {
+          "type": "string",
+          "enum": [
+            "note",
+            "warning",
+            "error"
+          ]
+        },
+        "message": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "id",
+            "text"
+          ],
+          "properties": {
+            "id": {
+              "type": "string",
+              "minLength": 1,
+              "maxLength": 4096
+            },
+            "text": {
+              "type": "string",
+              "minLength": 1,
+              "maxLength": 4096
+            },
+            "properties": {
+              "type": "object",
+              "additionalProperties": {
+                "type": [
+                  "string",
+                  "integer",
+                  "boolean"
+                ]
+              }
+            }
+          }
+        },
+        "suppressions": {
+          "type": "array",
+          "maxItems": 8,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "kind",
+              "status"
+            ],
+            "properties": {
+              "kind": {
+                "type": "string",
+                "enum": [
+                  "external"
+                ]
+              },
+              "status": {
+                "type": "string",
+                "enum": [
+                  "accepted"
+                ]
+              }
+            }
+          },
+          "description": "SARIF 2.1 suppressions. Present iff the finding is waived. kind=external (policy waiver), status=accepted.",
+          "x-opensip-order": "sequence"
+        },
+        "partialFingerprints": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "opensip/finding-key2"
+          ],
+          "properties": {
+            "opensip/finding-key2": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Fingerprint"
+            }
+          }
+        },
+        "locations": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 1,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "physicalLocation"
+            ],
+            "properties": {
+              "physicalLocation": {
+                "type": "object",
+                "additionalProperties": false,
+                "required": [
+                  "artifactLocation"
+                ],
+                "properties": {
+                  "artifactLocation": {
+                    "type": "object",
+                    "additionalProperties": false,
+                    "required": [
+                      "uri"
+                    ],
+                    "properties": {
+                      "uri": {
+                        "type": "string",
+                        "minLength": 1,
+                        "maxLength": 8192,
+                        "description": "Percent-encoded logical path (RFC 3986). Not a raw LogicalPath."
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          },
+          "x-opensip-order": "sequence"
+        },
+        "properties": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "findingId",
+            "subjectId",
+            "correspondence",
+            "waived",
+            "citations"
+          ],
+          "properties": {
+            "findingId": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/FindingId"
+            },
+            "subjectId": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/SubjectId"
+            },
+            "correspondence": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Correspondence"
+            },
+            "waived": {
+              "type": "boolean"
+            },
+            "citations": {
+              "type": "array",
+              "maxItems": 100000,
+              "items": {
+                "type": "object",
+                "additionalProperties": false,
+                "required": [
+                  "domain",
+                  "digest"
+                ],
+                "properties": {
+                  "domain": {
+                    "type": "string",
+                    "minLength": 1,
+                    "maxLength": 64
+                  },
+                  "digest": {
+                    "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Sha256Hex"
+                  }
+                }
+              },
+              "x-opensip-order": "canonical-set"
+            }
+          }
+        }
+      }
+    }
+  }
+}
