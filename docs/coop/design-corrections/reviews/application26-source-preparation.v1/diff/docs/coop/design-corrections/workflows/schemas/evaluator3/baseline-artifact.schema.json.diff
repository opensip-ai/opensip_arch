diff --git a/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/baseline-artifact.schema.json b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/baseline-artifact.schema.json
new file mode 100644
index 00000000..27d80547
--- /dev/null
+++ b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/workflows/schemas/evaluator3/baseline-artifact.schema.json
@@ -0,0 +1,375 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:opensip:product-v1:workflows:evaluator3:baseline:2",
+  "title": "BaselineArtifact schemaMajor 2 — evaluator3 unmatched-occurrence profile",
+  "description": "Identity-bearing descriptor schemaMajor is 2 because unmatchedOccurrences is a required member of the H('workflow.baseline', descriptor) preimage. Historical schemaMajor 1 artifacts are refused (BASELINE.SCHEMA_MAJOR_UNSUPPORTED / REQUEST.SCHEMA_MAJOR_UNSUPPORTED). They MUST NOT be admitted by treating a missing unmatched array as []. RunId is run3. Fingerprint recipe remains finding-fingerprint / finding-key2. Policy embed is PolicyDocumentV2; Scope/Waiver remain V1 on the original owner document.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "baselineId",
+    "descriptor",
+    "custody"
+  ],
+  "properties": {
+    "baselineId": {
+      "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/BaselineId"
+    },
+    "descriptor": {
+      "$ref": "#/$defs/BaselineDescriptor"
+    },
+    "custody": {
+      "$ref": "#/$defs/Custody"
+    }
+  },
+  "$defs": {
+    "BaselineDescriptor": {
+      "type": "object",
+      "description": "Identity-bearing: H('workflow.baseline', descriptor). Excludes RequestId, ExecutionId, clocks, receipts, host release and signatures.",
+      "additionalProperties": false,
+      "required": [
+        "schemaFamily",
+        "schemaMajor",
+        "originProjectId",
+        "source",
+        "runId",
+        "planId",
+        "fingerprintRecipe",
+        "detectorClosure",
+        "pivotClosure",
+        "context",
+        "contextDocuments",
+        "ruleCoverage",
+        "entries",
+        "unmatchedOccurrences"
+      ],
+      "properties": {
+        "schemaFamily": {
+          "const": "opensip.product.baseline"
+        },
+        "schemaMajor": {
+          "const": 2
+        },
+        "originProjectId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/ProjectId"
+        },
+        "source": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "snapshotId"
+          ],
+          "properties": {
+            "snapshotId": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/SnapshotId"
+            },
+            "vcsRevision": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/VcsRevision"
+            }
+          }
+        },
+        "runId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/RunId"
+        },
+        "planId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/PlanId"
+        },
+        "fingerprintRecipe": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "domain",
+            "recipeMajor"
+          ],
+          "properties": {
+            "domain": {
+              "const": "finding-fingerprint"
+            },
+            "recipeMajor": {
+              "type": "integer",
+              "minimum": 2,
+              "maximum": 65535
+            }
+          }
+        },
+        "detectorClosure": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 64,
+          "items": {
+            "$ref": "#/$defs/DetectorClosureEntry"
+          },
+          "x-opensip-order": "sequence"
+        },
+        "pivotClosure": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 256,
+          "uniqueItems": true,
+          "items": {
+            "$ref": "#/$defs/PivotClosureEntry"
+          },
+          "description": "Complete executable closure required to run E0: every detector, the evaluator, stdlib/toolchain closures and registered schema digests. Fact dual-emission (legacy fingerprints) is fingerprint migration only and never appears here.",
+          "x-opensip-order": {
+            "by": [
+              "closureId"
+            ]
+          }
+        },
+        "context": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:comparison:2#/$defs/EvaluationContext"
+        },
+        "contextDocuments": {
+          "type": "object",
+          "description": "Embedded typed documents whose digests equal context.*Digest. They make E1..E3 computable on a fresh CI host.",
+          "additionalProperties": false,
+          "required": [
+            "policy",
+            "scope",
+            "waivers"
+          ],
+          "properties": {
+            "policy": {
+              "$ref": "urn:opensip:product-v1:policy-document:2#/$defs/PolicyDocumentV2"
+            },
+            "scope": {
+              "$ref": "urn:opensip:product-v1:workflows:policy-document#/$defs/ScopeDocumentV1"
+            },
+            "waivers": {
+              "$ref": "urn:opensip:product-v1:workflows:policy-document#/$defs/WaiverSetV1"
+            }
+          }
+        },
+        "ruleCoverage": {
+          "type": "array",
+          "maxItems": 4096,
+          "items": {
+            "$ref": "urn:opensip:product-v1:workflows:evaluator3:comparison:2#/$defs/RuleCoverage"
+          },
+          "x-opensip-order": "sequence"
+        },
+        "entries": {
+          "type": "array",
+          "minItems": 0,
+          "maxItems": 1048576,
+          "items": {
+            "$ref": "#/$defs/BaselineEntry"
+          },
+          "description": "sorted strictly ascending by fingerprint UTF-8 bytes; duplicates rejected",
+          "x-opensip-order": {
+            "by": [
+              "fingerprint"
+            ]
+          }
+        },
+        "unmatchedOccurrences": {
+          "type": "array",
+          "maxItems": 1048576,
+          "items": {
+            "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/UnmatchedOccurrence"
+          },
+          "uniqueItems": true,
+          "x-opensip-order": {
+            "by": [
+              "findingId"
+            ]
+          },
+          "description": "Every unmatched finding3 of the origin Run. Empty is an explicit complete-correspondence assertion for unmatched, not an implicit default for schemaMajor 1."
+        }
+      }
+    },
+    "DetectorClosureEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "detectorId",
+        "closureId",
+        "semanticsMajor",
+        "semanticVersion",
+        "contributionId",
+        "manifestDigest"
+      ],
+      "properties": {
+        "detectorId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/CanonicalIdentifier"
+        },
+        "closureId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/ClosureId"
+        },
+        "semanticsMajor": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 65535
+        },
+        "semanticVersion": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/SemanticVersion"
+        },
+        "contributionId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/ContributionId"
+        },
+        "manifestDigest": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Sha256Hex"
+        }
+      }
+    },
+    "PivotClosureEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "closureId",
+        "kind",
+        "manifestDigest",
+        "protocolMajor",
+        "platform"
+      ],
+      "properties": {
+        "closureId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/ClosureId"
+        },
+        "kind": {
+          "type": "string",
+          "enum": [
+            "detector",
+            "evaluator",
+            "provider",
+            "toolchain",
+            "stdlib",
+            "schema-set"
+          ]
+        },
+        "manifestDigest": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Sha256Hex"
+        },
+        "protocolMajor": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 65535
+        },
+        "platform": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 64
+        }
+      }
+    },
+    "BaselineEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "fingerprint",
+        "ruleId",
+        "detectorId",
+        "stabilityClass",
+        "subjectPath",
+        "waived"
+      ],
+      "properties": {
+        "fingerprint": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Fingerprint"
+        },
+        "legacyFingerprint": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 256,
+          "description": "present only inside a fingerprint dual-emission window; supplies identity migration, never a prior executable algorithm"
+        },
+        "ruleId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/CanonicalIdentifier"
+        },
+        "detectorId": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/CanonicalIdentifier"
+        },
+        "stabilityClass": {
+          "type": "string",
+          "enum": [
+            "rename-stable",
+            "path-stable",
+            "span-fallback"
+          ]
+        },
+        "subjectPath": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/LogicalPath"
+        },
+        "waived": {
+          "type": "boolean"
+        }
+      }
+    },
+    "Custody": {
+      "type": "object",
+      "description": "Non-identity custody envelope. Time and host release are disclosure only; they never enter baselineId.",
+      "additionalProperties": false,
+      "required": [
+        "exportedByHostRelease",
+        "exportedAtUtc",
+        "runRetainedAtExport",
+        "retentionPins"
+      ],
+      "properties": {
+        "exportedByHostRelease": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/SemanticVersion"
+        },
+        "exportedAtUtc": {
+          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/UtcTimestamp"
+        },
+        "runRetainedAtExport": {
+          "type": "boolean"
+        },
+        "retentionPins": {
+          "type": "array",
+          "maxItems": 320,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "pattern": "^(run3|closure2):[0-9a-f]{64}(?![\\s\\S])"
+          },
+          "description": "retention roots the origin host pinned at adoption: the Run and every pivot closure; loss of a pin is disclosed as availability partial, never as a silent two-way fallback",
+          "x-opensip-order": "sequence"
+        },
+        "closureBundle": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "path",
+            "sha256",
+            "bytes"
+          ],
+          "properties": {
+            "path": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/UserInputPath"
+            },
+            "sha256": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Sha256Hex"
+            },
+            "bytes": {
+              "type": "integer",
+              "minimum": 1,
+              "maximum": 4294967296
+            }
+          },
+          "description": "optional signed portable bundle carrying the pivot closure bytes for a fresh CI host; its signature/trust admission is the security unit's contract"
+        },
+        "signature": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "scheme",
+            "keyId",
+            "value"
+          ],
+          "properties": {
+            "scheme": {
+              "const": "ed25519"
+            },
+            "keyId": {
+              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/Sha256Hex"
+            },
+            "value": {
+              "type": "string",
+              "pattern": "^[0-9a-f]{128}(?![\\s\\S])"
+            }
+          }
+        }
+      }
+    }
+  }
+}
