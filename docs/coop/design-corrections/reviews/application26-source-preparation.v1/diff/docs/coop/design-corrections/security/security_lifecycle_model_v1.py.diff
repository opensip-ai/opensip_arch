+def validate_discovery_provenance(value):
+    """Explicit version dispatch for the discovery provenance record (XA-02 / CR-25).
+
+    Version 1 is the historical record: `{path, reason, markerCount}` pruned rows with a non-null count and
+    marker-derived anchors only. Version 2 is what this instrument now produces. A changed record is NEVER
+    named V1: the schemaVersion selects the definition, and an unknown version is refused rather than being
+    validated against the nearest neighbour.
+
+    THIS IS THE READ LANE. It admits every version this kit defines so historical bytes stay readable and
+    schema-validatable, and it is deliberately NOT a current-operation admission. Converting a provenance
+    record into an admitted boundary inventory for a current discovery is the separate current-operation
+    boundary in DD.boundary_inventory_from_provenance, which admits only DD.CURRENT_PROVENANCE_VERSION and
+    refuses a historical version explicitly. Passing this check is not permission to execute."""
+    if not isinstance(value, dict) or type(value.get('schemaVersion')) is not int:
+        raise Reject('DISCOVERY_PROVENANCE_SHAPE')
+    name = DISCOVERY_PROVENANCE_RECORDS.get(value['schemaVersion'])
+    if name is None:
+        raise Reject('DISCOVERY_PROVENANCE_VERSION_UNKNOWN:%d' % value['schemaVersion'])
+    return validate_input(name, value)
+
