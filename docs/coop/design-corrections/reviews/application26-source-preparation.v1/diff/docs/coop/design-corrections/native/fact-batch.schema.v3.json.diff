diff --git a/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/native/fact-batch.schema.v3.json b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/native/fact-batch.schema.v3.json
