+    "planId": {
+      "type": "string",
+      "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])",
+      "description": "Must equal the Plan whose Analyze stage minted the named facts."
+    },
+    "producerClosure": {
+      "type": "string",
+      "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])",
+      "description": "Must equal each named fact's producerClosure. Named closure MUST be Plan-selected kind=provider. This is the wrapper that encoded compiler-native resolution into SubjectIdV1 payloads; occupancy mapping is the second output of that same encoding."
