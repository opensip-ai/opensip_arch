+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "opensip.product.provider-target-attribution-return.2",
+  "title": "ProviderTargetAttributionReturnV2 \u2014 non-wire projection shape and internal fault registry",
+  "description": "This envelope is not an accepted worker delivery interface, digest domain or Run preimage. Worker delivery is OccupancyCompanionV1 on negotiated FactBatchV3. The host fills Plan/stage provenance and the minted fact identity to project TargetAttributionV2 records. The envelope shape remains available to validate diagnostic inputs; the current capture and fault laws are declared below. An envelope alone cannot authorize capture.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "planId",
+    "producerClosure",
+    "stageOrdinal",
+    "records"
