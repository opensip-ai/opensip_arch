+      "type": "integer",
+      "minimum": 0,
+      "maximum": 65535,
+      "description": "Exact execution-plan stage ordinal whose Analyze minted the facts. Joins hostCapture.stageReceipts[ordinal]. Not a protocol3 phase."
+    },
+    "records": {
+      "type": "array",
+      "maxItems": 100000,
+      "items": {
+        "$ref": "opensip.product.target-attribution.2"
+      },
