+++ b/tmp/opensip-design-corrections/candidate-subject.v26/docs/coop/design-corrections/foundation/check-evaluator-faults.v3.py
@@ -0,0 +1,65 @@
+"""Public StepTermination and whole-envelope controls for typed evaluator faults."""
+import copy, hashlib, importlib.util, json
+from pathlib import Path
+HERE=Path(__file__).resolve().parent
+s=importlib.util.spec_from_file_location('fault3',HERE/'evaluator_fault_model.v3.py')
+M=importlib.util.module_from_spec(s);s.loader.exec_module(M)
+
+def main():
+    rows=[];raw=b'{"owner":"synthetic-boundary-control","decisions":["original"]}'
+    pair_closure=M.SCHEMA['allOf'][-1]['anyOf']
+    pairs=[b['properties']['condition']['const']+':'+b['properties']['origin']['const'] for b in pair_closure]
+    assert len(pairs)==len(set(pairs)) and set(pairs)==set(M.ROUTES)
+    rows.append({'case':'schema-and-route-pair-totality','result':'ADMIT'})
+    native=json.loads((HERE.parent/'native/native-evidence.schemas.v2.json').read_text())
+    origins={o for r in native['x-opensip-public-route-registry']['keys'].values() for o in r['possibleOrigins']}
+    assert set(M.SCHEMA['x-opensip-native-origin-map'].values())<=set(origins)
+    rows.append({'case':'native-origin-map-owner-membership','result':'ADMIT'})
+    def obs(condition,origin):
+        return {'schemaVersion':3,'condition':condition,'origin':origin,
+                'diagnosticDigest':hashlib.sha256(raw).hexdigest(),'reference':'retained:fixture',
+                'limit':({'field':'selectedPrograms','observed':65,'maximum':64} if condition=='selection-limit-exceeded' else
+                         {'field':'proof.predicates','observed':100001,'maximum':100000} if condition=='output-bound-exceeded' else None)}
+    for key in M.ROUTES:
+        condition,origin=key.split(':');o=obs(condition,origin);r=M.route(o,raw)
+        e=M.failure_envelope(o,raw,'req1_'+'1'*32)
+        assert r['diagnosticBytes']==raw and r['observation']==o
+        assert e['termination']==r['termination'] and e['exitCode']==r['exitCode']
+        rows.append({'case':key,'result':'ADMIT','class':r['termination']['class'],'errorCode':r['termination']['errorCode'],'detail':r['termination']['domainDetail']['code']})
+    def refuses(name,fn,expected):
+        try:fn()
+        except Exception as exc:
+            if expected not in str(exc):raise
+            rows.append({'case':name,'result':'REFUSE','reason':expected})
+        else:raise AssertionError(name)
+    refuses('unknown-origin-pair',lambda:M.C.validate(M.SCHEMA,obs('promised-bytes-lost','provider-return')),'is not valid under any of the given schemas')
+    refuses('invalid-bytes-are-not-loss',lambda:M.C.validate(M.SCHEMA,obs('input-identity-invalid','evidence-store')),'is not valid under any of the given schemas')
+    refuses('diagnostic-custody-mismatch',lambda:M.route(obs('input-join-invalid','provider-return'),raw+b'!'),'EVALUATOR_FAULT_DIAGNOSTIC_CUSTODY')
+    bad=obs('selection-limit-exceeded','host-pre-plan');bad['limit']['observed']=64
+    refuses('within-bound-is-not-fault',lambda:M.route(bad,raw),'EVALUATOR_FAULT_NOT_OVER_LIMIT')
+    o=obs('required-output-pointer-omitted','provider-return');r=M.route(o,raw);e=M.failure_envelope(o,raw,'req1_'+'2'*32)
+    for name,mutate in [('exit',lambda x:x.update(exitCode=2)),('public-detail',lambda x:x['errors'][0].update(code='evidence.missing')),('termination-origin',lambda x:x['termination'].update(errorCode='HOST.IO_FAILURE'))]:
+        bad=copy.deepcopy(e);mutate(bad)
+        refuses('envelope-'+name,lambda:M.validate_envelope(bad,r),'EVALUATOR_FAULT_ENVELOPE_PARITY')
+    # Existing owner carriers agree on their public routes; diagnosis remains
+    # unchanged. This does not stand in for a LIVE D9 successor artifact.
+    I=M.load('fault_owner_identity3',HERE/'identity-model.v3.py')
+    for condition,origin,exc in [('promised-bytes-lost','evidence-store',I.EvidenceUnavailable('retained:fixture')),('complete-replay-mismatch','retained-regeneration',I.RegenerationMismatch('retained:fixture'))]:
+        o=M.owner_observation(exc,raw)
+        assert (o['condition'],o['origin'])==(condition,origin)
+        actual=M.route(o,raw)['termination']
+        assert M.C.equal_typed(actual,exc.termination)
+        rows.append({'case':'owner-carrier-'+condition,'result':'ADMIT'})
+    for origin in ['retained-regeneration','host-internal']:
+        bad=obs('complete-replay-mismatch',origin);bad['reference']=None
+        refuses('replay-reference-required-'+origin,lambda:M.C.validate(M.SCHEMA,bad),"is not of type 'string'")
+    bad=obs('output-bound-exceeded','host-serialization');bad['limit']=None
+    refuses('output-bound-measurement-required',lambda:M.C.validate(M.SCHEMA,bad),"is not of type 'object'")
+    bad=obs('output-bound-exceeded','host-serialization');bad['limit']['observed']=100000
+    refuses('output-within-bound-is-not-fault',lambda:M.route(bad,raw),'EVALUATOR_FAULT_NOT_OVER_LIMIT')
+    exc=I.RegenerationMismatch('retained:fixture');exc.termination['domainDetail']['remedy']='invented remedy'
+    refuses('owner-carrier-remedy-mismatch',lambda:M.owner_observation(exc,raw),'EVALUATOR_FAULT_OWNER_CARRIER')
+    report={'standing':'bounded reference route controls; no LIVE D9 successor artifact or host qualification','passed':True,'count':len(rows),'checks':rows}
+    print(json.dumps(report,indent=2));return report
+
+if __name__=='__main__':main()
