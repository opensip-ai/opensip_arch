 "limitations": {
  "L-JS1": "synthesized options: paths/baseUrl/rootDirs/custom types unknown; such specifiers are unresolved-module-specifier edges",
  "L-JS2": "dynamic JavaScript forms (computed member access, non-literal require/import(), indirect eval, reflective access, any-typed calls) are unresolved edges; universal negatives are then resolution-incomplete",
  "L-JS3": "types@checked facts on JavaScript subjects without annotation or JSDoc carry derivationKind=compiler-inferred; exact under the admitted universe, no probabilistic confidence; rule packs may require derivationPolicy=declared-only",
  "L-RS1": "every activated non-path Cargo.lock package must be in the sealed dependency source set; otherwise dependent crates' semantic rungs are input-closure-incomplete",
  "L-RS2": "dyn Trait and generic-bound calls resolve to the trait method declaration and are recorded as dynamic-dispatch unresolved edges",
  "L-RS3": "non-prepared mode: external proc-macro invocations and build-script outputs are unavailable; generated-dependent types are input-closure-incomplete (generated-output-unavailable)",
  "L-RS4": "prepared mode consumes only inert expansion/directive rows; a site without a matching row is macro-expansion-unavailable",
  "L-FW1": "reachability universal negatives need an origin set; unrecognized frameworks without explicit origins yield resolution-incomplete (entry-point-unrecognized)",
  "L-CL1": "cross-tsjs candidates use tsjs-erasure-v1 syntax projection; bodies with runtime-significant TypeScript tokens are excluded; never a fact, never a deletion prerequisite",
  "inventory": "Inventory relations are produced by the shared discovery rule and the VCS observation; no compiler, provider or grammar is executed for them. Naming the producing component here qualifies no platform and measures nothing.",
  "syntaxOnlyGrammarClass": "The host bundles grammars for seven languages: rust, typescript, javascript (syntaxClass code) and json, toml, markdown, yaml (syntaxClass data-document). Code grammars have the section 6.3 body spans and the published L2/L3 normalisation tables, so they bear clone body identity and the code-construct syntax relations. Data/document grammars are bundled and accounted - their files are grammar-only members bearing inventory evidence, never unsupported-file - but this kit publishes no tokenisation, literalKind mapping or normalisation law for them, so they mint no body identity and produce no code-construct fact. The syntax and clones cells above are qualified accordingly; nothing that was previously representable has been narrowed, and data-format syntax facts remain a bounded future capability that would need a published tokenisation law first."
 },
 "cellStates": [
  "SUPPORTED-DESIGN",
  "UNSUPPORTED-TYPED",
  "NOT-SELECTED"
 ],
 "platformInvariantDesign": true,
 "platformQualified": false,
 "jsOptionSemantics": {
  "allowJs": "admits .js/.mjs/.cjs/.jsx roots into the TypeScript program (source: typescriptlang.org/tsconfig/allowJs, read 2026-09-06); it is a program-membership option",
  "checkJs": "enables diagnostics for JavaScript files (source: typescriptlang.org/tsconfig/checkJs, read 2026-09-06); it changes reported errors, not what is resolved; it is a universe key, not a capability gate",
  "resolutionCompleteness": "claimed only by CoverageV3.resolutionCompleteness after resolution was attempted over an exhaustive examined partition with a complete stage; neither allowJs nor checkJs implies it"
 },
