+def semantic_refusal_controls():
+    # A digest-valid, fully reminted result can still be semantically false.
+    # Reuse the maintained mutation constructor, not an arbitrary close_run stub.
+    foundation = HERE.parent / "foundation"
+    semantic = load("query_refusal_semantic3", foundation / "check-semantic-replay.v3.py")
+    mutants = load("query_refusal_mutants3", foundation / "check-replay.v3.py")
+    graph, positive, actual = semantic.case_declares_exists()
+    run, objects, blobs = mutants.remint_finding(
+        *positive, lambda finding, _blobs: finding.update(severity="warning")
+    )
+    run_key, _ = Q.identity3().open_run_closure(run, objects, blobs)
+    check("semantic-query-mutant-structural-admit-new-identity", run_key != actual["runId"])
+    symbol = next(row for row in graph["inputs"]["population"].values() if row["kind"] == "symbol")
+    req = request("graph.neighbors", run["projectId"], {"runId": run_key}, {
+        "relation": "references", "minResolution": "resolved-binding", "direction": "outgoing",
+        "endpoint": ep(symbol["universe"], "symbol", symbol["row"]["nativeSubjectId"]),
+    })
+    refuse("semantic-query-mutant-refuses", lambda: Q.execute_graph_query(req, run, objects, blobs, host=host_obs()),
+           "HOST.IO_FAILURE", "evidence.corrupt")
+    try:
+        Q.execute_graph_query(req, run, objects, blobs, host=host_obs())
+    except Q.QueryRefusal as exc:
+        env = exc.envelope()
+        check("semantic-query-mutant-retains-replay-boundary",
