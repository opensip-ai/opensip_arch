+def sweep_journal_record_dispatch():
+    """Current journal records are recordSchema 3 / run3 and the closed JournalRecord fields.
+    Historical schema-2 is not read as 3. Mixed prefixes refuse. Revocation still blocks SEAL.
+    Prefix dispatch is not close_run. Linearize remains an abstract brokered-effect schedule."""
+    checked = 0
+    out = model.linearize(['GRANT g1', 'SEAL'])
+    assert out['sealed'] is True and out['journal'][1]['recordSchema'] == 3
+    assert out['journal'][1]['runId'] == model.FIXTURE_SEAL_RUN_ID
+    assert model.admit_journal_record(out['journal'][1])['result'] == 'CURRENT'
+    checked += 1
+    blocked = model.linearize(['GRANT g1', 'REV trust-revoked', 'SEAL'])
+    assert blocked['sealed'] is False and blocked['sealRefused'] == 'SEAL_AFTER_REV'
+    checked += 1
+    try:
+        model.admit_journal_record({'recordType': 'SEAL', 'recordSchema': 2, 'grantGeneration': 1, 'seq': 1,
+                                    'operationRef': 'op', 'runId': 'run2:' + 'a' * 64})
+        raise AssertionError('historical schema-2 admitted as current')
+    except model.Reject as e:
+        assert str(e) == 'JOURNAL_RECORD_SCHEMA_HISTORICAL'
+        checked += 1
+    try:
+        model.admit_journal_record({'recordType': 'SEAL', 'recordSchema': 3, 'grantGeneration': 1, 'seq': 1,
+                                    'operationRef': 'op', 'runId': 'run2:' + 'a' * 64})
+        raise AssertionError('schema-3 run2 mixed prefix admitted')
+    except model.Reject as e:
+        assert str(e) == 'JOURNAL_RECORD_MIXED_PREFIX'
+        checked += 1
+    try:
+        model.admit_journal_record({'recordSchema': 3, 'grantGeneration': 1, 'seq': 1,
+                                    'operationRef': 'op', 'runId': 'run3:' + 'a' * 64})
+        raise AssertionError('schema-3 missing recordType admitted')
+    except model.Reject as e:
+        assert str(e) == 'JOURNAL_RECORD_SCHEMA_INVALID'
+        checked += 1
+    try:
+        model.admit_seal_run_id_prefix(model.FIXTURE_SEAL_RUN_ID)
+        raise AssertionError('fixture runId treated as prefix authority')
+    except model.Reject as e:
+        assert str(e) == 'SEAL_RUN_ID_FIXTURE_NOT_AUTHORITY'
+        checked += 1
+    live = 'run3:' + 'a' * 64
+    prefix = model.admit_seal_run_id_prefix(live)
+    assert prefix['authority'] == 'run3-pattern' and prefix['standing'] == 'prefix-dispatch'
+    checked += 1
+    return {'name': 'journal-record-schema-3-run3-historical-2-mixed-prefix-revocation-blocks-seal',
+            'checked': checked, 'holds': True}
+
