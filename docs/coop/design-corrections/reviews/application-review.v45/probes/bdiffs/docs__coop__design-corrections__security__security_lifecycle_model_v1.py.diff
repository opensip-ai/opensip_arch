+FIXTURE_SEAL_RUN_ID = 'run3:' + '0' * 64
+_RUN3 = re.compile(r'^run3:[0-9a-f]{64}$')
+_RUN2 = re.compile(r'^run2:[0-9a-f]{64}$')
