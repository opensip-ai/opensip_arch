+def disposition_rows(record, key):
+    """Lossless access to actual keyed or id-bearing array rows; never award a grade.
+
+    Returned pointers address the original review bytes. Duplicate ids, mistyped
+    rows and conflicting keyed ids refuse before assembly; no last-key-wins.
+    """
+    value = record[key]
+    assert type(value) in (dict, list), 'Disposition collection must be object or array: ' + key
+    rows, pointers = {}, {}
+    pairs = value.items() if type(value) is dict else enumerate(value)
+    for position, row in pairs:
+        assert type(row) is dict, 'Disposition row must be object'
+        rid = position if type(value) is dict else row.get('id')
+        assert type(rid) is str and rid and '/' not in rid and '~' not in rid, 'Invalid disposition id'
+        assert 'id' not in row or row['id'] == rid, 'Conflicting disposition id'
+        assert rid not in rows, 'Duplicate disposition id: ' + rid
+        rows[rid] = row
+        pointers[rid] = '/' + key + '/' + str(position)
+    return rows, pointers
 
 
