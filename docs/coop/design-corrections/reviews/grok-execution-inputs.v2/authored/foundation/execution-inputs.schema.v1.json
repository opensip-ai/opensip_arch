{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opensip.product.execution-inputs.1",
  "title": "ExecutionInputsV1 — host-captured evaluator INPUT observation (DRAFT)",
  "description": "Post-Plan evaluator INPUT. Identity is raw SHA-256 of C(this record), not an H-domain and not a Plan parameter. planId is an explicit locator; the Plan descriptor has no planId field. Observes stage returns. Not findings, verdict, or proof. HostCapture is a TCB trust boundary: sealed replay checks proof selection equals this inventory; it cannot certify a malicious host omission. Standing: isolated successor; frozen21/live untouched. Root registers ProofInputRef later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "executionPlanId",
    "evaluatorClosure",
    "enumerationPlanDigest",
    "analysisSpecDigest",
    "hostCapture",
    "selectedRefs",
    "cellOutcomes",
    "nativeCoverageAccounts",
    "candidateResultRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])",
      "description": "Explicit locator. Compared to the caller-supplied plan_id, never read off the Plan descriptor."
    },
    "executionPlanId": {
      "type": "string",
      "pattern": "^exec-plan2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "evaluatorClosure": {
      "type": "string",
      "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "enumerationPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "analysisSpecDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "hostCapture": {
      "$ref": "#/$defs/HostCaptureV1"
    },
    "selectedRefs": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/InputRefV1"
      },
      "x-opensip-order": "canonical-set"
    },
    "cellOutcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/CellProgramOutcomeV1"
      },
      "x-opensip-order": "ordinal"
    },
    "nativeCoverageAccounts": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/NativeCoverageAccountV1"
      },
      "x-opensip-order": "sequence"
    },
    "candidateResultRefs": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/DigestHex"
      },
      "x-opensip-order": "canonical-set"
    }
  },
  "x-opensip-new-internal-faults": {
    "standing": "NEW/internal. Typed missing/invalid/lost routes; object mismatch is not a missing pointer.",
    "keys": [
      "EXECUTION_INPUTS_SCHEMA",
      "EXECUTION_INPUTS_STORE_REQUIRED",
      "EXECUTION_INPUTS_PLAN_JOIN",
      "EXECUTION_INPUTS_EXECUTION_PLAN_JOIN",
      "EXECUTION_INPUTS_ENUMERATION_DIGEST",
      "EXECUTION_INPUTS_EVALUATOR_CLOSURE",
      "EXECUTION_INPUTS_CELL_TOTALITY",
      "EXECUTION_INPUTS_INVENTORY_KIND",
      "EXECUTION_INPUTS_VIEW_TOTALITY",
      "EXECUTION_INPUTS_REF_POINTER",
      "EXECUTION_INPUTS_REF_LOST_BYTES",
      "EXECUTION_INPUTS_REF_INVALID_BYTES",
      "EXECUTION_INPUTS_REF_MISMATCH",
      "EXECUTION_INPUTS_STAGE_PRODUCER",
      "EXECUTION_INPUTS_STAGE_ORDINAL",
      "EXECUTION_INPUTS_COVERAGE_DERIVE",
      "EXECUTION_INPUTS_NATIVE_COVERAGE_TOTALITY",
      "EXECUTION_INPUTS_CANDIDATE_REQUIRED",
      "EXECUTION_INPUTS_CANDIDATE_GROUP",
      "EXECUTION_INPUTS_CANDIDATE_BIND",
      "EXECUTION_INPUTS_OUTPUT_BACKLINK",
      "EXECUTION_INPUTS_VCS_APPLICABILITY",
      "EXECUTION_INPUTS_ORDER",
      "EXECUTION_INPUTS_SELECTED_COVER",
      "EXECUTION_INPUTS_CAUSE_CARRIER",
      "EXECUTION_INPUTS_CAUSE_ENUM_DRIFT",
      "EXECUTION_INPUTS_KIND_MAP",
      "EXECUTION_INPUTS_ENUMERATOR"
    ]
  },
  "$defs": {
    "DigestHex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "LogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\\\u0000]{1,255}(/[^/\\\\\\u0000]{1,255})*(?![\\s\\S])",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "DeficiencyV2": {
      "type": "string",
      "enum": [
        "language-tier-unsupported",
        "provider-unavailable",
        "input-closure-incomplete",
        "budget-exhausted",
        "confidence-floor-unmet",
        "derivation-policy-unmet",
        "resolution-incomplete",
        "external-consumers-unknown",
        "required-relation-missing"
      ]
    },
    "NativeCause": {
      "type": "string",
      "enum": [
        "body-language-owner-ambiguous",
        "body-language-owner-unenumerated",
        "body-language-ownership-missing",
        "capability-missing",
        "config-flag-stripped",
        "generated-file-missing",
        "generated-file-out-of-bounds",
        "generated-output-unavailable",
        "linker-unavailable",
        "lockfile-missing",
        "missing-dependency-source",
        "no-program-unit",
        "node-modules-outside-read-set",
        "source-replacement-outside-snapshot"
      ]
    },
    "InputRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "digest"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "view",
            "import",
            "coverage",
            "subject-inventory",
            "target-attribution",
            "incoming-search",
            "candidate-producer-result"
          ]
        },
        "digest": {
          "$ref": "#/$defs/DigestHex"
        }
      }
    },
    "StageReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "stageSpecDigest",
        "producerClosure",
        "outputRefs"
      ],
      "description": "Host observation of one admitted execution-plan stage return. SelectedRefs must equal the union of these outputRefs (plus canonical-record inventories/candidates the enumeration stage retained). Not every object in the store.",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "stageSpecDigest": {
          "$ref": "#/$defs/DigestHex"
        },
        "producerClosure": {
          "type": "string",
          "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "outputRefs": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/InputRefV1"
          },
          "x-opensip-order": "canonical-set"
        }
      }
    },
    "HostCaptureV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody",
        "observation",
        "stageReceipts"
      ],
      "description": "TCB trust boundary, not a mathematically independent second witness. retainedObjectKeys/retainedBlobDigests are custody inventories of the same host.",
      "properties": {
        "custody": {
          "const": "host-tcb-evidence-store"
        },
        "observation": {
          "const": "stage-return"
        },
        "stageReceipts": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/StageReceiptV1"
          },
          "x-opensip-order": "ordinal"
        },
        "retainedObjectKeys": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "x-opensip-order": "utf8"
        },
        "retainedBlobDigests": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        }
      }
    },
    "CellProgramOutcomeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "cellOrdinal",
        "programOrdinal",
        "capabilityId",
        "languageMode",
        "workspaceRoot",
        "required",
        "kinds",
        "universe",
        "enumeratorStatus",
        "enumeratorClosure",
        "state",
        "deficiency",
        "nativeCause",
        "stageOrdinal",
        "stageOrdinalNullReason",
        "inventoryDigests",
        "viewDigests",
        "candidateResultDigest"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "capabilityId": {
          "type": "string",
          "enum": [
            "inventory",
            "syntax",
            "imports",
            "references",
            "calls",
            "types",
            "reachability",
            "clones-fact",
            "clones-near",
            "clones-cross-tsjs",
            "unresolved-edge"
          ]
        },
        "languageMode": {
          "type": "string",
          "enum": [
            "ts-tsconfig",
            "js-allowjs",
            "js-synthesized",
            "rust-cargo",
            "rust-cargo-prepared",
            "syntax-only"
          ]
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "required": {
          "type": "boolean"
        },
        "kinds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "file",
              "symbol",
              "package"
            ]
          },
          "x-opensip-order": "canonical-set"
        },
        "universe": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "enumeratorStatus": {
          "type": "string",
          "enum": [
            "selected",
            "unselected"
          ]
        },
        "enumeratorClosure": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "deficiency": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeficiencyV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCause": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "stageOrdinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            {
              "type": "null"
            }
          ]
        },
        "stageOrdinalNullReason": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "unavailable-binding",
                "optional-unselected"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "inventoryDigests": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        },
        "viewDigests": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set",
          "description": "view2 H suffixes, never sha256(C(view))."
        },
        "candidateResultDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "deficiency": {
                "type": "null"
              },
              "nativeCause": {
                "type": "null"
              },
              "stageOrdinal": {
                "type": "integer"
              },
              "stageOrdinalNullReason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stageOrdinal": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "stageOrdinalNullReason": {
                "type": "string"
              }
            },
            "not": {
              "properties": {
                "stageOrdinalNullReason": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "NativeCoverageAccountV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellOrdinal",
        "programOrdinal",
        "relation",
        "resolution",
        "sourceUniverse",
        "targetUniverse",
        "accountState",
        "deficiency",
        "nativeCause",
        "coverageIds",
        "scopeIds",
        "coverage",
        "resolutionCompletenessState",
        "examinedExhaustive"
      ],
      "description": "Account of one matrix relation@rung for one binding. coverageIds are coverage2 H suffixes of foundation envelopes {scopeId, payloadSchemaDigest, payloadDigest}. coverage/resolution/state/deficiency MUST equal the referenced owner records. complete with empty coverageIds is invalid. unavailable/unselected/unsupported/inapplicable use empty coverageIds and typed accountState — not fabricated Coverage at null U.",
      "properties": {
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "relation": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "sourceUniverse": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetUniverse": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "accountState": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "unavailable",
            "inapplicable",
            "unsupported"
          ]
        },
        "deficiency": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeficiencyV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCause": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverageIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        },
        "scopeIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^scope2:[0-9a-f]{64}(?![\\s\\S])"
          },
          "x-opensip-order": "canonical-set"
        },
        "coverage": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "complete",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "resolutionCompletenessState": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "complete",
                "incomplete",
                "partial",
                "not-attempted",
                "not-applicable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "examinedExhaustive": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accountState": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "coverageIds": {
                "minItems": 1
              },
              "coverage": {
                "const": "complete"
              },
              "deficiency": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accountState": {
                "enum": [
                  "inapplicable",
                  "unsupported",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "coverageIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "CandidateProducerResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "planId",
        "executionPlanId",
        "cellOrdinal",
        "programOrdinal",
        "capabilityId",
        "languageMode",
        "universe",
        "producerClosure",
        "stageOrdinal",
        "state",
        "deficiency",
        "nativeCause",
        "authority",
        "semanticEquivalenceClaimed",
        "automaticDeletionEligible",
        "examinedPaths",
        "groupDigests"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "planId": {
          "type": "string",
          "pattern": "^plan2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "executionPlanId": {
          "type": "string",
          "pattern": "^exec-plan2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "cellOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "programOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "capabilityId": {
          "type": "string",
          "enum": [
            "clones-near",
            "clones-cross-tsjs"
          ]
        },
        "languageMode": {
          "type": "string",
          "enum": [
            "ts-tsconfig",
            "js-allowjs",
            "js-synthesized",
            "rust-cargo",
            "rust-cargo-prepared",
            "syntax-only"
          ]
        },
        "universe": {
          "oneOf": [
            {
              "$ref": "#/$defs/DigestHex"
            },
            {
              "type": "null"
            }
          ]
        },
        "producerClosure": {
          "type": "string",
          "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "stageOrdinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "deficiency": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeficiencyV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCause": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "const": "candidate-only"
        },
        "semanticEquivalenceClaimed": {
          "const": false
        },
        "automaticDeletionEligible": {
          "const": false
        },
        "examinedPaths": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/LogicalPath"
          },
          "x-opensip-order": "canonical-set"
        },
        "groupDigests": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DigestHex"
          },
          "x-opensip-order": "canonical-set"
        }
      }
    }
  }
}
