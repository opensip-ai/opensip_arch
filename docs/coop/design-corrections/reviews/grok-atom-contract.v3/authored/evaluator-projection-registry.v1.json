  "kindApplicability": {
    "endpointSource": "Atom.endpoint default source (or omitted). Rule subjectEnumeration.subjectKind file|symbol|package must be in relation.sourceSubjectKind / sourceSubjectKinds. subjectEnumeration.subjectKind=export is lawful iff the relation admits symbol (export selects exported symbols).",
    "endpointTarget": "Uses relation.targetKinds, NOT sourceSubjectKind. Rule kind file|symbol|package must be a member of targetKinds. export enumerates exported symbols and is lawful iff targetKinds contains symbol. Unary relations and unresolved-edge: ATOM_ENDPOINT_UNAVAILABLE. calls/references/imports at a rung that forbids the resolved-* field: ATOM_ENDPOINT_UNAVAILABLE."
  },
  "owedPartitions": {
    "parameter": "foundation/enumeration-plan.schema.v1.json EnumerationPlanV1 (already a Plan parameter). Program bindings carry universe H or universe=null unavailable.",
    "atomCapability": "capabilityForRelation[atom.relation]. Cells whose capabilityId equals that id AND whose programBindings are the Plan-selected native programs for that capability.",
    "owedSourcePrograms": "ALL programBindings of those cells. Available binding: universe H is an owed source universe. Unavailable binding (universe=null): unknown obligation (does not become empty).",
    "outgoing": {
      "bind": "sourceUniverse=current evaluation universe U; current subject occupies sourceField",
      "scopes": "every selected subject-scope of (relation, minResolution, sourceUniverse=U) that contains the current source subject. Do NOT invent coverage keys for target universes T merely because admitted-target allows T and no edge to T was observed. same-only implies targetUniverse=U. Existing facts with any admitted targetUniverse still match.",
      "examination": "per-source-universe exhaustive examination of independently enumerated source subjects (SubjectInventoryV1 + scopes). Missing expected source subjects or missing Coverage entry for the owed (relation,minResolution,U,*) => unknown."
    },
    "incoming": {
      "bind": "targetUniverse=current U; current subject occupies targetNativeIdField after native-id compare",
      "owedSources": "every compatible (same engineFamilies) owed source program, including those with zero matching facts",
      "scopes": "all selected scopes of each owed source (relation, minResolution, sourceUniverse=S, targetUniverse=U) that cover that program's independently enumerated SOURCE subjects. Scope selection is independent of MATCHING facts. Existing coveragePartitionLaw disjointness applies. Do not build an unrepresentable empty cartesian scope over every (source subject, target subject) pair.",
      "absence": "per-source-universe exhaustive examination of those source subjects PLUS native ClosedWorldV2 / unresolved-edge policy (sufficiency_v2 universal-negative) about current target. Cross-family sources are not owed; their existing facts still match.",
      "unknownIf": "unavailable owed binding; uncovered expected source subjects; missing Coverage for an owed (relation,minResolution,S,U); coverage unknown/partial/not-attempted where absence is required"
    },
    "allCovered": {
      "requestedRung": "atom.minResolution only, never all higher rungs",
      "notApplicable": "allowed and required on non-resolved rungs (native-evidence.md RC-1). Do not demand resolutionCompleteness.state=complete there.",
      "resolved": "the five resolved pairs keep RC-2 completeness for universal-negative none; all-covered itself is the examination claim (coverage=complete and examinedExhaustive=true) at the requested rung."
    }
  },
  "importObservationNullLaw": {
    "document": "workflows/schemas/imported-evidence.schema.json#/$defs/ImportObservationV1",
    "rule": "Required keys; null member means the observation semantics do not apply to the kind. Do not read selection.completenessEstablished for runtime/history.",
    "runtime": {
      "nonNull": [
        "window",
        "population"
      ],
      "mustBeNull": [
