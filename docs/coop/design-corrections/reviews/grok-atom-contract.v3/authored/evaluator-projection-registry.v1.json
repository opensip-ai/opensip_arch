      }
    },
    "owedIncomingCompatible": "same engine family only",
    "crossFamilyOwedEdges": {
      "default": "not-owed",
      "label": "NEW ATOM_CROSS_FAMILY_EDGE_NOT_OWED",
      "note": "Do not assume TypeScript/JavaScript/Rust/syntax semantic edges. Existing admitted-target facts whose sourceUniverse and targetUniverse differ in family STILL MATCH if native IDs match; they are not deleted. They are not owed for absence completeness."
