      ]
    },
    "dependency": {
      "mustBeNull": [
        "window",
        "population",
        "selection",
        "revisionRange"
      ],
      "atom": false
    },
    "prepared": {
      "mustBeNull": [
        "window",
        "population",
        "selection",
        "revisionRange"
      ],
      "atom": false
    }
  },
  "collectionScopeLaw": {
    "type": "enum",
    "enum": [
      "all-paths",
      "in-scope-paths",
      "listed-paths"
    ],
    "inObservationalScope": {
      "all-paths": "path is in wrapper ImportScopeDescriptor extent intersect snapshot inventory",
      "in-scope-paths": "that extent intersect plan.scope-descriptor (and ScopeDocumentV1 globs when the Plan selected that parameter)",
      "listed-paths": "path is a HistorySubject.path in THIS payload. A path not listed is out of scope (history-outside-collection-scope), not examined-absent"
    }
  },
  "runtimeSubjectOrder": {
    "keep": true,
    "notCanonicalSetOfWholeRows": "whole-row canonical-set would sort by hits/observability first and CHANGE established order. Forbidden as a replacement.",
    "comparator": "UTF-8 path ascending; then absent-symbol BEFORE present-symbol; then UTF-8 symbol when present",
    "uniqueKey": "(path, ABSENT) or (path, symbol)",
    "annotationProposal": {
      "x-opensip-order": "runtime-subject-path-symbol",
      "standing": "NEW comparator token pending canonical.py vocabulary integration; until then the comparator is this registry plus imported-evidence prose"
    }
  },
  "historySubjectOrder": {
    "order": "strict unique path UTF-8",
    "uniqueKey": "path"
  },
  "testRowOrder": {
    "order": "existing sequence (producer order)",
    "uniqueTestId": true,
    "choice": "unique testId admission is deliberately required so test-case ordinal addresses plus testId are unambiguous. Duplicate testId refuses NEW TEST_PAYLOAD_DUPLICATE_TEST_ID. Sequence is NOT rewritten to canonical-set."
  },
  "importQuantifiers": {
    "owedWrappers": "every Plan-SELECTED import2 of the atom evidenceKind that is relevant to the current subject (wrapper scope intersects current logicalPath / history observational scope). NOT merely proof.evaluationInputRefs. A selected relevant wrapper omitted from evaluationInputRefs cannot hide uncertainty on negatives.",
    "consumable": "mapped current (StalenessRule current); unmapped-only never feeds polarity set R",
    "polaritySetR": {
      "runtime": [
        "observed-hit",
        "observable-unhit"
      ],
      "neverInR": [
        "unobservable",
        "unmapped"
      ],
      "observabilityFilter": "may select disclosure of unobservable/unmapped rows; MUST NOT put them in R; MUST NOT make exists true"
    },
    "kleene": {
      "exists": "true if any owed consumable wrapper contributes a polarity match, even if siblings are partial/incomplete",
      "none": "false if any known polarity match exists, even if another wrapper is partial. True only if every OWED relevant wrapper is observationally complete AND R is empty. Else indeterminate.",
      "count-at-most": "false once known distinct ObservationAddress count > N, even if siblings partial. True only if every owed relevant wrapper is complete AND count <= N. Else indeterminate when count <= N.",
      "all-covered": "true only if every owed relevant wrapper is complete AND every selected current subject has a covering row (runtime observed-hit or observable-unhit; history in-scope subject row). Never false."
    },
    "runtimeComplete": "wrapper.completeness=complete AND observation.window non-null AND population present AND population != unknown",
    "historyComplete": "wrapper.completeness=complete AND payload.revisionRange.truncated=false",
    "countUnit": "distinct ObservationAddress rows, never hits",
    "optionalRequired": "optional-absent is indeterminate truth with non-gating disclosure (IMPORT.ABSENT_FOR_PREDICATE). NEVER called retained no-match. required-absent is gating indeterminate. Causes are a SET, not a single unknownCause."
  },
  "testResultLaw": {
    "payload": "workflows/schemas/test-execution.schema.json#/$defs/TestPayloadV1",
    "noPayloadErrorField": true,
    "noSpawnField": true,
    "processResult": {
      "error": "timedOut==true OR signal!=null OR exitStatus==null",
      "failed": "else exitStatus!=0 OR any tests[].outcome==fail; if any tests[].outcome==error, error takes precedence over failed",
      "passed": "else exitStatus==0. This is the process result, NOT a proof that all intended tests ran."
    },
    "emptyTestsNonzeroExit": "tests=[] AND exitStatus==1 is a consumable failed test-execution scope observation",
    "test-execution": "COARSE claim: applies to selected evaluation subjects whose inventory logicalPath is in the wrapper ImportScopeDescriptor. No synthetic per-subject failure.",
    "test-result": "binds ONLY tests[] rows that carry subjectPath. Unassigned rows (no subjectPath) are accounted only via the execution summary (test-execution), never attributed to a file.",
    "completeness": "TestPayloadV1.selection.completenessEstablished (and matching ImportObservationV1.selection) governs completeness claims (none/all-covered/count-at-most true). Known process outcome may still make exists true / none false when completenessEstablished=false.",
    "noImplicitExecution": "Requires an admitted test-execution step or producer=independent-prepared import. No implied repository spawn."
  },
  "globPrefix": {
    "prefix": "UTF-8 byte prefix of the projected scalar string. Empty prefix is schema-illegal (minLength 1).",
    "glob": "Same GlobPattern as PolicyDocumentV1 include/exclude: only *, ? and whole-segment **. Evaluated on the projected string.",
    "enumerationGlobs": "subjectEnumeration include/exclude match retained inventory logicalPath (InventoryRowV1.path), never SubjectIdV1 spelling and never universe H.",
    "symbolSubjectFilterGlob": "FieldFilter glob/prefix on field=subject for a symbol current subject uses inventory logicalPath when the projection is a path; when the projection is nativeSubjectId, glob is on that exact string."
  },
  "impossibleLiteral": {
    "eqNeqInOnClosedEnum": "If the filter value (or each in[] member) is not a member of that field's closed value set AT THIS relation, admission refuse ATOM_FILTER_ENUM_LITERAL_UNKNOWN (NEW/internal). Includes subjectKind/targetKind token export, observability tokens on history, testResult spelling from the other grain.",
    "prefixGlobOnEnum": "patterns are not enum members; admitted; match if the actual token string matches.",
    "universe": "value must be a portable domain token from engineFamilies.portableUniverseDomains to be a possible match. A different valid domain is deterministic nomatch. A 64-hex or sha256: string is not a domain token: deterministic nomatch (not CONFIG.INVALID). Universe filter never merges H identities.",
    "resolutionEq": "value must be a member of THIS atom relation's ladder or ATOM_FILTER_ENUM_LITERAL_UNKNOWN."
  },
  "comparatorTable": {
    "subject": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false
    },
    "target": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false
    },
    "resolution": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false
    },
    "universe": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false
    },
    "confidenceMillionths": {
      "eq": false,
      "neq": false,
      "in": false,
      "prefix": false,
      "glob": false,
      "gte": true,
      "lte": true,
      "value": "integer-0-1000000"
    },
    "subjectKind": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false,
      "enum": [
        "file",
        "symbol",
        "package"
      ]
    },
    "targetKind": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false,
      "enum": [
        "file",
        "symbol",
        "package"
      ],
      "unknownKind": "targetAttribution.kind=unknown => filter result unknown (indeterminate matching), not nomatch"
    },
    "observability": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false,
      "enum": [
        "observed-hit",
        "observable-unhit",
        "unobservable",
        "unmapped"
      ]
    },
    "testResult": {
      "eq": true,
      "neq": true,
      "in": "string-array",
      "prefix": true,
      "glob": true,
      "gte": false,
      "lte": false,
      "enumByRelation": {
        "test-execution": [
          "passed",
          "failed",
          "error"
        ],
        "test-result": [
          "pass",
          "fail",
          "skip",
          "error"
        ]
      }
    },
    "exitStatus": {
      "eq": true,
      "neq": true,
      "in": "integer-array",
      "prefix": false,
      "glob": false,
      "gte": true,
      "lte": true,
      "value": "integer-0-255-or-array-thereof",
      "nullExitStatus": "unknown, not nomatch"
    }
  },
  "fieldFilterSuccessor": {
    "standing": "Proposed successor of policy-document FieldFilter. Root integrates. Integer arrays are lawful ONLY for field=exitStatus AND cmp=in. String arrays for every other in.",
    "addedFields": [
      "testResult",
      "exitStatus"
    ],
    "numericFields": [
      "confidenceMillionths",
      "exitStatus"
    ]
  },
  "witness": {
    "rootOwnsShape": true,
    "noImportObservationRowDomain": true,
    "observationAddress": {
      "importId": "import2: hex; binds the exact wrapper/payload",
      "selector": [
        "runtime-subject",
        "history-subject",
        "test-case",
        "test-execution"
      ],
      "ordinal": "0-based index into RuntimePayloadV1.subjects / HistoryPayloadV1.subjects / TestPayloadV1.tests in the retained sequence; null iff selector=test-execution"
    },
    "kinds": [
      "boolean",
      "native-atom",
      "imported-atom"
    ],
    "booleanMatchArraysEmpty": true,
    "uncertainAddressesPreserved": true,
    "causesAreASet": true,
    "optionalUnknown": "indeterminate truth + non-gating disclosure; never named retained no-match"
  },
  "repairVsPolicy": {
    "policyAdmitAtomRelations": [
      "file",
      "package",
      "vcs-change",
      "clones",
      "declares",
      "literal",
      "types",
      "control-flow",
      "reachability",
      "calls",
      "references",
      "imports",
      "unresolved-edge",
      "runtime-observation",
      "history-change",
      "test-execution",
      "test-result"
    ],
    "repairImportedRequirementProducers": [
      "runtime-observation",
      "history-change"
    ],
    "repairRefuses": [
      "test-execution",
      "test-result"
    ],
    "availabilityOnlyNoAtom": [
      "dependency",
      "prepared"
    ],
    "noUnknownProducer": "admit_evidence_requirement must refuse any imported relation whose repairRequirementProducer is not true. No default producer."
  },
  "refusals": {
    "standing": "NEW/internal pending root public-detail / D9 route-registry integration unless noted as existing.",
    "keys": [
      {
        "key": "ATOM_KIND_INCOMPATIBLE",
        "when": "enumeration kind vs endpoint kind set"
      },
      {
        "key": "ATOM_ENDPOINT_UNAVAILABLE",
        "when": "endpoint=target where targetKinds empty or rung forbids resolved field"
      },
      {
        "key": "ATOM_FILTER_FIELD_FORBIDDEN",
        "when": "filter field projection is forbidden for this relation/rung"
      },
      {
        "key": "ATOM_FILTER_ENUM_LITERAL_UNKNOWN",
        "when": "eq/neq/in value not in closed enum at this relation"
      },
      {
        "key": "ATOM_FILTER_COMPARATOR_ILLEGAL",
        "when": "cmp not in comparatorTable for the field"
      },
      {
        "key": "ATOM_CROSS_FAMILY_EDGE_NOT_OWED",
        "when": "label only; not a policy refusal — incoming absence does not owe that source"
      },
      {
        "key": "ATOM_EVIDENCE_KIND_MISMATCH",
        "when": "native atom carries evidence, or imported atom missing/wrong evidenceKind"
      },
      {
        "key": "REPAIR.EVIDENCE_RELATION_NO_PRODUCER",
        "when": "repair EvidenceRequirement names test-execution or test-result",
        "existing": false,
        "note": "NEW/internal spelling; repair already refuses cross-plane values"
      },
      {
        "key": "TEST_PAYLOAD_DUPLICATE_TEST_ID",
        "when": "duplicate tests[].testId"
      },
      {
        "key": "RUNTIME_SUBJECT_DUPLICATE_KEY",
        "when": "duplicate (path, symbol-or-ABSENT)"
      },
      {
        "key": "HISTORY_SUBJECT_DUPLICATE_PATH",
        "when": "duplicate HistorySubject.path"
      }
    ]
  },
  "$defs": {
    "ObservationAddressV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importId",
        "selector",
        "ordinal"
      ],
      "properties": {
        "importId": {
          "type": "string",
          "pattern": "^import2:[0-9a-f]{64}(?![\\s\\S])"
        },
        "selector": {
          "type": "string",
          "enum": [
            "runtime-subject",
            "history-subject",
            "test-case",
            "test-execution"
          ]
        },
        "ordinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048575
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selector": {
                "const": "test-execution"
              }
            }
          },
          "then": {
            "properties": {
              "ordinal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selector": {
                "enum": [
                  "runtime-subject",
                  "history-subject",
                  "test-case"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ordinal": {
                "type": "integer"
              }
            },
            "not": {
              "properties": {
                "ordinal": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "AtomCauseV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "optional-absent",
            "required-absent",
            "incomplete-observation",
            "omitted-selected-wrapper",
            "unobservable-subject",
            "unmapped-subject",
            "import-unmapped-only",
            "coverage-unknown",
            "target-metadata-unknown",
            "target-kind-unknown",
            "enumeration-unknown",
            "selector-unbound",
            "unavailable-program-binding",
            "uncovered-expected-source-subject",
            "missing-relation-coverage",
            "test-completeness-not-established",
            "null-exit-status",
            "history-outside-collection-scope",
            "history-truncated",
            "observation-window-insufficient"
          ]
        },
        "importId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^import2:[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "universe": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FieldFilterSuccessorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "cmp",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "subject",
            "target",
            "resolution",
            "universe",
            "confidenceMillionths",
            "subjectKind",
            "targetKind",
            "observability",
            "testResult",
            "exitStatus"
          ]
        },
        "cmp": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "in",
            "prefix",
            "glob",
            "gte",
            "lte"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "x-opensip-order": "sequence"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "x-opensip-order": "sequence"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "confidenceMillionths"
              }
            }
          },
          "then": {
            "properties": {
              "cmp": {
                "enum": [
                  "gte",
                  "lte"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "exitStatus"
              }
            }
          },
          "then": {
            "properties": {
              "cmp": {
                "enum": [
                  "eq",
                  "neq",
                  "in",
                  "gte",
                  "lte"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "exitStatus"
              },
              "cmp": {
                "const": "in"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "exitStatus"
              },
              "cmp": {
                "enum": [
                  "eq",
                  "neq",
                  "gte",
                  "lte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmp": {
                "const": "in"
              },
              "field": {
                "not": {
                  "const": "exitStatus"
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmp": {
                "enum": [
                  "eq",
                  "neq",
                  "prefix",
                  "glob"
                ]
              },
              "field": {
                "not": {
                  "const": "exitStatus"
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "AtomSuccessorV1": {
      "type": "object",
      "description": "Proposed Atom extension: optional endpoint. Root integrates into policy-document.schema.json. Default source when omitted.",
      "additionalProperties": false,
      "required": [
        "op",
        "relation",
        "minResolution",
        "filters"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "exists",
            "none",
            "count-at-most",
            "all-covered"
          ]
        },
        "relation": {
          "type": "string"
        },
        "minResolution": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "enum": [
            "source",
            "target"
          ],
          "default": "source"
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/FieldFilterSuccessorV1"
          },
          "x-opensip-order": "sequence"
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "evidence": {
          "type": "string",
          "enum": [
            "runtime",
            "test",
            "history"
          ]
        }
      }
    }
  }
}
