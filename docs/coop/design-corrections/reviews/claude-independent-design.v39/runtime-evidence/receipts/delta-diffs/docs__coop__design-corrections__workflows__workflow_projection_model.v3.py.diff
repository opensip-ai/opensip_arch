+def fingerprint_absence_known(knowledge_view, extent, rule_id, path, subject_key=None) -> bool:
+    """Known non-emission of one fingerprint at one side: structural non-selection, or evaluated absence under the
+    law _bind_pivot_runs/compare_admitted_v3 apply to pivots.
+
+    Requires the owning rule's complete hit set (enabled, evaluated, complete enumeration, every selected root
+    determinate, not budget-exhausted), the path absence law over the attested extent, and correspondence knowledge:
+    no unmatched occurrence of that side that might be the fingerprint (correspondence_barrier). Missing admitted
+    root predicate proofs or extent is unknown, never false.
+    """
+    if selection_excludes(knowledge_view.get("policy"), (extent or {}).get("scopeDocument"), rule_id, path):
+        return True
+    if not rule_id or extent is None:
