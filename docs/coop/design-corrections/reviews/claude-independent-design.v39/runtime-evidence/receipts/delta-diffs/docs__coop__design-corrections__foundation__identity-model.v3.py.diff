+def snapshot_pruned_tree_faults(source_inventory,read_layouts):
+    """identity section 3 `sourceInventory` law (consumer24 A4), over the retained snapshot inventory and the
+    retained resolution read-set layouts of the Plan-selected native contexts. Returns offending paths (UTF-8 order).
+
+    The inventory is the deterministic custody walk of the admitted first-party files - which the shared discovery
+    rule never walks into a pruned tree - PLUS exactly the bytes the analysis actually read from outside that walk.
+    A row inside a pruned tree is therefore lawful only as a READ: inside a DEPENDENCY tree it must lie inside a
+    package directory (`installPath` or `realPath`) of a retained ResolvedNodeModulesLayoutV1 whose context committed
+    nodeModulesInReadSet, with no further exact `node_modules` segment between that listed directory and the file:
+    explicit nested package custody, so a nested installed package is authorized only by its own row and never
+    through an enclosing listed directory. A VCS-tree or Cargo build-output row is never a read input of any
+    published universe, and the VCS exclusion is checked at every depth before any package authorization. Listed
+    directories are arbitrary admitted CanonicalPaths compared by exact segment prefix; no package root is parsed.
+    Replay decides every INVENTORIED row against the listed directories, nested boundaries included. That no other
+    file was read, that no read file is missing from the inventory, or that the host walked every first-party file,
+    is a host TCB observation a bytes-only replay cannot establish, and this join does not claim it."""
+    DD=native_admission().DD
+    paths=[row['path'] for row in source_inventory]
+    cargo_roots=DD.cargo_roots_from_markers(paths)
+    packages={entry[field].rstrip('/') for layout in read_layouts for entry in layout['entries'] for field in ('installPath','realPath')}
+    faults=[]
+    for path in paths:
+        # Discovery reports the outermost pruned tree. A package read allowance must not
+        # hide a deeper VCS segment: VCS custody bytes are never selected program reads.
+        if any(segment in DD.VCS_TREE_SEGMENTS for segment in path.split('/')):
+            faults.append(path)
+            continue
+        hit=DD.classify_path(path,cargo_roots)
+        if hit is None:continue
+        if hit[1]=='dependency-tree' and any(listed_package_authorizes_read(package,path,DD.DEPENDENCY_TREE_SEGMENTS)
+                                             for package in packages):continue
+        faults.append(path)
+    return sorted(faults,key=lambda p:p.encode('utf-8'))
+
+def listed_package_authorizes_read(package,path,dependency_segments):
+    """Explicit nested package custody (identity section 3, consumer24 A4). A listed installPath or realPath
+    authorizes a read file below it only while the relative suffix below that exact directory has no further exact
+    dependency-tree segment: a nested installed package needs its own retained row whose directory lies below that
+    boundary. The listed directory is an arbitrary admitted CanonicalPath (a package-manager store directory or a
+    workspace link included); nothing is parsed from its spelling, and its own segments may contain node_modules."""
+    if not path.startswith(package+'/'):return False
+    return not any(segment in dependency_segments for segment in path[len(package)+1:].split('/'))
