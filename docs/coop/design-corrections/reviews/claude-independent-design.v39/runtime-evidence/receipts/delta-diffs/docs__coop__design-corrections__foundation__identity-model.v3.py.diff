+def body_eligibility_table(universe_row):
+    """`{suffix: label}` deciding whether a path is BODY-ELIGIBLE under one native semantic universe
+    (x-opensip-digest-domains.bodyEligibilityLaw).
+
+    Read from the row's own `languageVersionBinding.bodyEligibility`, never restated here:
+    `dialect-table` is that row's published closed dialect table, `closed-suffix-set` is its listed
+    suffixes. The answer depends on the universe DOMAIN alone - never on ownership, program
+    membership, grammar selection or resolution - so an eligible path whose owner or inputs are
+    incomplete stays owed. A row without a declaration refuses rather than defaulting."""
+    binding=(universe_row or {}).get('languageVersionBinding') or {}
+    language=str((universe_row or {}).get('language'))
+    eligibility=binding.get('bodyEligibility')
+    if not isinstance(eligibility,dict):raise C.AdmissionError('BODY_ELIGIBILITY_UNDECLARED:'+language)
+    if eligibility.get('form')=='dialect-table':
+        dialect=binding.get('dialect') or {}
+        if dialect.get('form')!='closed-suffix-table' or not isinstance(dialect.get('table'),dict) or not dialect['table']:
+            raise C.AdmissionError('BODY_ELIGIBILITY_FORM:'+language)
+        return dict(dialect['table'])
+    if eligibility.get('form')=='closed-suffix-set':
+        suffixes=eligibility.get('suffixes')
+        if not isinstance(suffixes,list) or not suffixes or any(type(s) is not str or not s for s in suffixes):
+            raise C.AdmissionError('BODY_ELIGIBILITY_FORM:'+language)
+        return {suffix:suffix for suffix in suffixes}
+    raise C.AdmissionError('BODY_ELIGIBILITY_FORM:'+language)
 
 
