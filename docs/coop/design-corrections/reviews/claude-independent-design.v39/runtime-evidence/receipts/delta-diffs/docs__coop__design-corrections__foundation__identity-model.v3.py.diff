+# The closing digest law over the FOUNDATION RECORD DOCUMENTS this closure walks through a
+# {document, selector} record. identity-schemas and the relation document carry their own sweeps.
+FOUNDATION_DIGEST_LAW_OWN_SWEEP=('foundation/identity-schemas.v2.json','foundation/identity-schemas.v3.json',
+                                 'foundation/relation-payload-schemas.v2.json')
+BARE_HEX_DIGEST_PATTERN='^[0-9a-f]{64}(?![\\s\\S])'
+_FOUNDATION_DOCUMENTS={}
+def foundation_record_document(document):
+    """The parsed pinned bytes of one foundation record document, loaded once per identity copy."""
+    if document not in _FOUNDATION_DOCUMENTS:
+        _FOUNDATION_DOCUMENTS[document]=json.loads((HERE.parent/document).read_text())
+    return _FOUNDATION_DOCUMENTS[document]
