+_ADMITTED_PREDICATE_NODES=set()
+def admit_program_predicate_node(node):
+    """A fragment-retained digest is still a digest of a NAMED record. `program-predicate.nodeDigest`
+    names its record in its own annotation, so the located node is validated against exactly that
+    {document, selector} before its digest is compared - the annotation is the authority, not this
+    function. The rule program is RuleProgramV2, so the record is the v2 policy document's Predicate;
+    the v1 selector refuses every v2-only discriminator (`endpoint`, `all-covered`). Memoized by the
+    node's canonical bytes because one node is located once per (subject, predicate)."""
+    record=SCHEMA['$defs']['program-predicate']['properties']['nodeDigest']['x-opensip-digest']['record']
+    key=(record['document'],record['selector'],C.canonical(node))
+    if key in _ADMITTED_PREDICATE_NODES:return node
+    try:validate_registered_record(record['document'],record['selector'],node)
+    except C.AdmissionError as exc:raise C.AdmissionError('PROGRAM_PREDICATE_NODE_RECORD:'+record['selector']) from exc
+    _ADMITTED_PREDICATE_NODES.add(key)
+    return node
