+STAGE_OUTPUT_INTERFACE_DIRECTORY='opensip-interface/stage-output/'
+STAGE_OUTPUT_DECLARATION='x-opensip-stage-output'
+_STAGE_OPERATION_SEGMENT=re.compile(r'[a-z0-9][a-z0-9._-]{0,127}')
+def stage_output_schema_member_path(operation):
+    """The exact producer-closure tree path that registers the output schema of `operation`."""
+    if type(operation) is not str or _STAGE_OPERATION_SEGMENT.fullmatch(operation) is None:
+        raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_OPERATION_NOT_A_PATH_SEGMENT:'+repr(operation))
+    return STAGE_OUTPUT_INTERFACE_DIRECTORY+operation+'.schema.json'
+
+def admit_stage_output_schema(spec,producer,raw):
+    """Stage output schema OWNERSHIP (identity section 3 stage-spec; consumer24 S1). Returns the parsed document.
+
+    `outputSchemaDigest` used to be admitted as any retained blob: an arbitrary retained byte string became the
+    'registered' output schema by assertion. The owner of an operation's output contract is the producer interface
+    that defines the operation, so registration is membership in THAT closure: the stage-spec's producerClosure must
+    carry, at `opensip-interface/stage-output/<operation>.schema.json`, exactly these bytes, and the document must be
+    a JSON Schema 2020-12 document declaring `x-opensip-stage-output` = {schemaVersion 1, operation, outputDomains}
+    equal to the stage-spec's own. Each failure refuses by its own name; retained-but-unregistered bytes refuse as
+    UNREGISTERED, never as a lookup miss that some fallback could satisfy."""
+    path=stage_output_schema_member_path(spec['operation'])
+    members=[row for row in producer['tree'] if row['path']==path]
+    if not members:raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_UNREGISTERED:'+path)
+    if members[0]['sha256']!=spec['outputSchemaDigest']:raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_REGISTRATION_MISMATCH:'+path)
+    if type(raw) is not bytes or hashlib.sha256(raw).hexdigest()!=spec['outputSchemaDigest']:raise C.AdmissionError('BLOB_DIGEST')
+    from jsonschema import Draft202012Validator
+    from jsonschema.exceptions import SchemaError
+    try:document=C.parse(raw)
+    except (C.AdmissionError,ValueError) as exc:raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_DOCUMENT_INVALID:'+path) from exc
+    if type(document) is not dict or document.get('$schema')!='https://json-schema.org/draft/2020-12/schema':
+        raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_DOCUMENT_INVALID:'+path)
+    try:Draft202012Validator.check_schema(document)
+    except SchemaError as exc:raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_DOCUMENT_INVALID:'+path) from exc
+    declared={'schemaVersion':1,'operation':spec['operation'],'outputDomains':spec['outputDomains']}
+    if not C.equal_typed(document.get(STAGE_OUTPUT_DECLARATION),declared):
+        raise C.AdmissionError('STAGE_OUTPUT_SCHEMA_DECLARATION_MISMATCH:'+path)
+    return document
+
+NORMALIZATION_MAP_PATH=DIGESTS['normalizationSpecificationLaw']['closureTreePath']
+def admit_normalization_specification(level,level_version,closure,blob_of):
+    """The clones level specification's OWNER and LOCATION (normalizationSpecificationLaw; consumer24 S2).
+
+    `normalisationVersion` used to be admitted as ANY retained blob: a specification of another level, of another
+    language's closure or of nothing at all re-hashed and closed. It is now the specification the closure that
+    interprets the body publishes for THIS level: that closure's tree carries C(normalization-specification-map) at
+    NORMALIZATION_MAP_PATH, the map's row for `level` names `level_version`, and that digest is a member of the same
+    tree. `blob_of` is the Run's retained-byte accessor, so absent promised bytes stay retention loss."""
+    members={row['path']:row for row in closure['tree']}
+    if NORMALIZATION_MAP_PATH not in members:raise C.AdmissionError('BODY_NORMALIZATION_MAP_MISSING:'+NORMALIZATION_MAP_PATH)
+    raw=blob_of(members[NORMALIZATION_MAP_PATH]['sha256'])
+    try:record=C.parse(raw)
+    except (C.AdmissionError,ValueError) as exc:raise C.AdmissionError('BODY_NORMALIZATION_MAP_INVALID') from exc
+    if C.canonical(record)!=raw:raise C.AdmissionError('BODY_NORMALIZATION_MAP_INVALID')
+    schema=copy.deepcopy(SCHEMA);schema['$ref']='#/$defs/normalization-specification-map'
+    try:C.validate(schema,record)
+    except (C.AdmissionError,C.ValidationError) as exc:raise C.AdmissionError('BODY_NORMALIZATION_MAP_INVALID') from exc
+    levels=[row['level'].encode('utf-8') for row in record['levels']]
+    if any(not a<b for a,b in zip(levels,levels[1:])):raise C.AdmissionError('BODY_NORMALIZATION_MAP_INVALID')
+    mapped=[row for row in record['levels'] if row['level']==level]
+    if not mapped:raise C.AdmissionError('BODY_NORMALIZATION_LEVEL_UNMAPPED:'+str(level))
+    if mapped[0]['specificationDigest']!=level_version:raise C.AdmissionError('BODY_NORMALIZATION_LEVEL_VERSION_MISMATCH:'+str(level))
+    if level_version not in {row['sha256'] for row in closure['tree']}:
+        raise C.AdmissionError('BODY_NORMALIZATION_SPECIFICATION_NOT_IN_CLOSURE:'+str(level))
+    blob_of(level_version)
+    return record
