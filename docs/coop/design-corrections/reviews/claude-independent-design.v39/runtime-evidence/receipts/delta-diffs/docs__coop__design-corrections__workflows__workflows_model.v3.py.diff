+# ---------------------------------------------------------- policy.test (evaluator3 PolicyTestSuiteV2)
+# The current input is schemas/evaluator3/policy-test.schema.json PolicyTestSuiteV2 (candidate PolicyDocumentV2). The retained
+# PolicyTestSuiteV1 and workflows_model.v1.run_policy_test are the historical workflow1 profile only; this module's private
+# _base keeps them unchanged. Admission precedence is that document's x-opensip-admission-precedence: suite major, then
+# candidate major (REQUEST.SCHEMA_MAJOR_UNSUPPORTED / EVALUATION.MIXED_OUTPUT_MAJOR, the current policy major refusal of
+# workflow_projection_model.v3; never relabelled or grammar-classified), then the closed schema (errorCode CONFIG.INVALID,
+# D9 rejection cause config-invalid, with POLICY.IMPERATIVE_KEY_REFUSED for a PolicyDocumentV2 grammar violation and
+# otherwise the shared registered CONFIG.INVALID detail), then fixture and override admission (CONFIG.INVALID), then the
+# current resolver, whose refusals of an admitted suite keep their own details.
+import copy
+POLICY_DOCUMENT_MAJOR=2
+POLICY_TEST_SUITE_MAJOR=2
+POLICY_TEST_SUITE_REF='urn:opensip:product-v1:workflows:evaluator3:policy-test:2#/$defs/PolicyTestSuiteV2'
+_POLICY_GRAMMAR=None
+def _policy_grammar():
+    global _POLICY_GRAMMAR
+    if _POLICY_GRAMMAR is None:_POLICY_GRAMMAR=json.loads((PROFILE_ROOT/'schemas'/'policy-document.v2.schema.json').read_text())
+    return _POLICY_GRAMMAR
+
+_POLICY_TEST_MODEL=None
+def policy_test_model():
+    """The evaluator3 fixture evaluator: current atom law over the PolicyTestSuiteV2 facts fixture representation."""
+    global _POLICY_TEST_MODEL
+    if _POLICY_TEST_MODEL is None:
+        spec=importlib.util.spec_from_file_location('policy_test_fixture_owner3',PROFILE_ROOT/'policy_test_model.v3.py')
+        _POLICY_TEST_MODEL=importlib.util.module_from_spec(spec);spec.loader.exec_module(_POLICY_TEST_MODEL)
+    return _POLICY_TEST_MODEL
+
+def _grammar_alternatives(nodes,doc):
+    """Leaf alternatives admitted at one position: local $refs resolved and oneOf/anyOf branches flattened. An allOf member
+    constrains the SAME instance, so only a structural member ($ref, type, members, items or its own branches) is followed and
+    a conditional if/then member is never an alternative. A non-local $ref is opaque."""
+    out,stack=[],list(nodes)
+    while stack:
+        n=stack.pop()
+        if not isinstance(n,dict):continue
+        ref=n.get('$ref')
+        if isinstance(ref,str):
+            stack.append(doc['$defs'][ref.split('/')[-1]]) if ref.startswith('#/$defs/') else out.append({'opaque':True})
+            continue
+        branches=[c for k in ('oneOf','anyOf') for c in n.get(k,[])]
+        structural=[c for c in n.get('allOf',[]) if isinstance(c,dict) and any(k in c for k in ('$ref','type','properties','items','oneOf','anyOf'))]
+        stack.extend(branches+structural)
+        if not (branches or structural) or any(k in n for k in ('type','properties','items','const','enum')):out.append(n)
+    return out
+
+def _admits_scalar(a):
+    if a.get('opaque'):return True
+    if 'properties' in a or 'items' in a:return False
+    t=a.get('type')
+    return t is None or t=='string' or (isinstance(t,list) and 'string' in t)
+
+def policy_grammar_violation(value,nodes=None,doc=None):
+    """True exactly when the closed policy grammar admits the value under NO alternative at its position for one of the two
+    reasons section 5 names: an object member that no closed alternative at that position declares (a hook, script,
+    include or exec key), or a string where every alternative is an object (a string expression). Every other schema
+    failure (a wrong enum value, a missing member, a bound) is not a grammar violation."""
+    doc=doc or _policy_grammar()
+    alts=_grammar_alternatives(nodes if nodes is not None else [doc['$defs']['PolicyDocumentV2']],doc)
+    objects=[a for a in alts if a.get('type')=='object' or 'properties' in a]
+    if isinstance(value,str):
+        return bool(objects) and not any(_admits_scalar(a) for a in alts)
+    if isinstance(value,dict):
+        if not objects:return False
+        declared=set().union(*(set(a.get('properties',{})) for a in objects))
+        if all(a.get('additionalProperties') is False for a in objects) and set(value)-declared:return True
+        return any(policy_grammar_violation(v,[a['properties'][k] for a in objects if k in a.get('properties',{})],doc) for k,v in value.items())
+    if isinstance(value,list):
+        items=[a['items'] for a in alts if isinstance(a.get('items'),dict)]
+        return bool(items) and any(policy_grammar_violation(v,items,doc) for v in value)
+    return False
+
+def _other_major(record,family,major):
+    return isinstance(record,dict) and record.get('schemaFamily')==family and type(record.get('schemaMajor')) is int and record['schemaMajor']!=major
+
+def _policy_major_refusal(what,major):
+    return Refusal('REQUEST.SCHEMA_MAJOR_UNSUPPORTED','EVALUATION.MIXED_OUTPUT_MAJOR',
+                   'evaluator3 policy test admits PolicyTestSuiteV2 with a PolicyDocumentV2 candidate; a '+what+' of another major is not relabelled or coerced',str(major))
+
+def admit_policy_test_suite(suite):
+    """policy.test admission, before any evaluation (workflows-and-surfaces section 5), in the precedence above."""
+    if _other_major(suite,'opensip.product.policy-test',POLICY_TEST_SUITE_MAJOR):raise _policy_major_refusal('suite',suite['schemaMajor'])
+    policy=suite.get('candidatePolicy') if isinstance(suite,dict) else None
+    if _other_major(policy,'opensip.product.policy',POLICY_DOCUMENT_MAJOR):raise _policy_major_refusal('candidate policy',policy['schemaMajor'])
+    try:
+        projection_owner().validate_profile(POLICY_TEST_SUITE_REF,suite)
+    except (ValidationError,canonical.AdmissionError) as exc:
+        if policy is not None and policy_grammar_violation(policy):
+            raise Refusal('CONFIG.INVALID','POLICY.IMPERATIVE_KEY_REFUSED','the policy DSL is declarative data only') from exc
+        raise Refusal('CONFIG.INVALID','CONFIG.INVALID','correct the suite so it satisfies PolicyTestSuiteV2') from exc
+    faults=policy_test_model().suite_faults(suite)
+    if faults:raise Refusal('CONFIG.INVALID','CONFIG.INVALID','correct the suite so it satisfies PolicyTestSuiteV2',faults[0][:512])
+    return suite
+
+def run_policy_test(suite,scope=None):
+    """The evaluator3 authoring test over an ADMITTED PolicyTestSuiteV2. In this profile it replaces the imported historical
+    workflows_model.v1.run_policy_test (still _base.run_policy_test), whose globals bind the historical resolver and
+    evaluator. The current resolver and atom owner resolve the candidate, the unchanged WaiverSetV1 owner resolves waivers,
+    and policy_test_model.v3 evaluates each case. The result stays PolicyTestResultV1 (policytest2): suiteDigest is H over the
+    admitted PolicyTestSuiteV2 and the candidate and effective digests are over PolicyDocumentV2 bytes."""
+    T=policy_test_model()
+    scope=scope or {'schemaFamily':'opensip.product.scope','schemaMajor':1,'include':['**'],'exclude':[]}
+    res={'schemaFamily':'opensip.product.policy-test-result','schemaMajor':1,'suiteDigest':canonical.identity('workflow.policy-test-suite',suite),
+         'candidatePolicyDigest':doc_digest(suite['candidatePolicy']),'overridesApplied':list(suite.get('overrides',[])),'enforcementUnchanged':True,'resolverRefusals':[]}
+    try:
+        policy=resolve_policy(copy.deepcopy(suite['candidatePolicy']))
+        effective_waivers,waiver_resolution=resolve_waivers(suite['waivers'],suite.get('asOfDate'))
+        res['resolverAccepted']=True
+    except Refusal as refusal:
+        res.update(resolverAccepted=False,resolverRefusals=[refusal.termination()['domainDetail']],effectivePolicyDigest=res['candidatePolicyDigest'],
+                   waiverResolution={'asOfDate':suite.get('asOfDate','0000-00-00'),'effectiveCount':0,'expired':[],
+                                     'duplicatesRejected':[refusal.subject] if refusal.detail=='POLICY.DUPLICATE_WAIVER' else []},
+                   results=[],summary={'passed':0,'failed':0,'indeterminate':0,'notExecutable':0})
+        res['policyTestResultId']=wid('policytest2','workflow.policy-test-result',res)
+        return res,refusal
+    effective=T.apply_overrides(policy,suite.get('overrides',[]))
+    res['effectivePolicyDigest']=doc_digest(effective)
+    res['waiverResolution']=waiver_resolution
+    res['results']=[T.case_result(effective,scope,effective_waivers,case) for case in suite['cases']]
+    summary={'passed':0,'failed':0,'indeterminate':0,'notExecutable':0}
+    for case in res['results']:summary['notExecutable' if case['outcome']=='not-executable' else case['outcome']]+=1
+    res['summary']=summary
+    res['policyTestResultId']=wid('policytest2','workflow.policy-test-result',res)
+    return res,None
+
+def run_admitted_policy_test(suite):
+    """policy.test: admit the PolicyTestSuiteV2, then run the evaluator3 authoring test. An admission refusal raises (goldens
+    policy-test-suite-major-unsupported, policy-test-imperative-key, policy-test-suite-inadmissible); a resolver refusal
+    returns (result, refusal) and terminates request-rejected with its own detail (golden policy-test-duplicate-waiver);
+    only a resolver-accepted result is a policy-test-result carrier."""
+    return run_policy_test(admit_policy_test_suite(suite))
