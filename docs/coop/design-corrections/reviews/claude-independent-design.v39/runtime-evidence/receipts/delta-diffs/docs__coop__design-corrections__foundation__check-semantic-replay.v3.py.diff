+                    if spec.get("inventory") == "other":
+                        receipt["inventoryDigest"] = "f" * 64
+                    elif spec.get("inventory") == "missing-object":
+                        receipt["inventoryDigest"] = M.commit_inventory(derived["runId"], dict(list(objects.items())[1:]), blobs)[1]
+                observation = {"stepId": 0, "durability": spec.get("durability", "authoritative"),
+                               "attempts": attempts, "commitReceipt": receipt,
+                               "requiredClosureNotInstalled": spec.get("closureNotInstalled", False)}
