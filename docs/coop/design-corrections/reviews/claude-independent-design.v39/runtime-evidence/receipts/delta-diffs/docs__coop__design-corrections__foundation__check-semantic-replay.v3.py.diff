+            candidate = dict(case["termination"]) if "termination" in case else dict(derived)
+            for key in case.get("remove", []):
+                candidate.pop(key, None)
+            candidate.update(case.get("set", {}))
+            candidate = placeholders(candidate)
+            observation = None
+            spec = case.get("observation")
+            if spec is not None:
+                if run is not None:
+                    execution_plan = objects[run["evaluationSealId"]][1]["executionPlanId"]
+                    stage_count = len(objects[execution_plan][1]["stages"])
+                    own_plan = run["planId"]
+                else:  # ephemeral cases compose no Run, so no plan join applies
+                    execution_plan, stage_count, own_plan = "exec-plan2:" + "2" * 64, 1, "plan2:" + "2" * 64
+                plan = "plan2:" + "0" * 64 if spec.get("plan") == "other" else own_plan
+                binding = {"planId": plan,
+                           "executionPlanId": "exec-plan2:" + "0" * 64 if spec.get("executionPlan") == "other" else execution_plan,
+                           "stageCount": stage_count + spec.get("stageCountDelta", 0),
+                           # a host observation, never derived from the plan: "all" is the fixture's assumption
+                           "stagesCompleted": {"all": stage_count, "partial": stage_count - 1,
+                                               "over": stage_count + 1}[spec.get("stagesCompleted", "all")]}
+                if "firstFailedStage" in spec:
+                    binding["firstFailedStage"] = spec["firstFailedStage"]
+                attempts = []
+                for tag in spec["attempts"]:
+                    if tag == "busy":
+                        attempts.append({"executionId": ids["busy"], "outcome": "failed", "faultCause": "ledger-busy",
+                                         "retried": True})
