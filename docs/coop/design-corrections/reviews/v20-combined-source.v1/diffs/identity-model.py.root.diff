+_REGISTERED_SCHEMA_DOCUMENTS=None
+def registered_schema_documents():
+    """The closed set of payload-registry schema DOCUMENTS, keyed by the raw SHA-256 of their exact
+    full bytes. Derived from the ONE registry (`x-opensip-payload-registry`) and from nowhere else,
+    so a row added there is registered here with no second list to drift from it."""
+    global _REGISTERED_SCHEMA_DOCUMENTS
+    if _REGISTERED_SCHEMA_DOCUMENTS is None:
+        documents=set()
+        for body in PAYLOADS['classes'].values():
+            if 'document' in body:documents.add(body['document'])
+            for row in body.get('rows',{}).values():documents.add(row['document'])
+        _REGISTERED_SCHEMA_DOCUMENTS={hashlib.sha256((HERE.parent/d).read_bytes()).hexdigest() for d in sorted(documents)}
+    return _REGISTERED_SCHEMA_DOCUMENTS
+
+
 def close_run(run,objects,blobs):
