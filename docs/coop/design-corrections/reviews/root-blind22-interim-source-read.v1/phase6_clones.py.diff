+            ('insufficient-fact-beside-complete-coverage',
+             [fact(rel, lower)] if lower else [], [scope], [payload(rel, rung)], cells,
+             {'exists': 'false', 'none': 'true'},
+             'a fact on a LOWER rung of the same ladder does not witness the atom; examined '
+             'absence at the atom rung is a determinate negative'),
+            ('insufficient-typed-coverage', [], [scope],
+             [payload(rel, rung, 'unknown', 'input-closure-incomplete', 'no-program-unit')], cells,
+             {'exists': 'indeterminate', 'none': 'indeterminate'},
+             's4 outgoing 4: unsatisfied view -> coverage-unknown with the typed carrier'),
+            ('missing-relation-coverage-is-three-valued', [], [], [], cells,
+             {'exists': 'indeterminate', 'none': 'indeterminate'},
+             's4 outgoing 2: no containing scope -> uncovered-expected-source-subject; never a '
+             'vacuous false'),
+            ('known-fact-beside-missing-coverage', [fact(rel, rung)], [], [], cells,
+             {'exists': 'true', 'none': 'false'},
+             's4 "a known match still makes exists true, none false"'),
+        ]
+        if resolved:
+            specs.append(('partial-resolution-under-a-universal-negative', [], [scope],
+                          [payload(rel, rung, state='partial')], cells,
+                          {'exists': 'false', 'none': 'indeterminate'},
+                          'native s4.6 step 6 applies to the universal negative only'))
+        cases = []
