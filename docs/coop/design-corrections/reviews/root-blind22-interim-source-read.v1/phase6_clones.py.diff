+def min_resolution_atom_law():
+    """The three levels evaluated as ATOMS under the generation-22 atom contract s4 (not only as
+    sufficiency results): qualifying fact + complete Coverage; an insufficient fact (lower rung
+    of the same ladder, or none on a one-rung ladder) beside complete Coverage; insufficient
+    typed Coverage; missing relation Coverage (the three-valued case); a known fact beside
+    missing Coverage (completeness independent of truth); and, on the resolved levels, a
+    partial resolution under a universal negative. Coverage payloads are TEMPLATED from real
+    admitted payloads of the TypeScript Run and admitted against CoverageResultV3 before use;
+    facts are minimal records carrying only what the evaluator reads."""
+    st, c, _doc = load('typescript')
+    templates = {}
+    for cid, cv in c.coverages_seen.items():
+        pay = c.canonical_record(cv['payloadDigest'], B.NATIVE_DOC, '#/$defs/CoverageResultV3',
+                                 'P6MRT')
+        templates.setdefault(pay['key']['resolution'] in E.RESOLVED_RUNGS, pay)
+    U = [t.split('#', 1)[1] for t in st.objects
+         if t.startswith('native.semantic-universe.typescript.v2#')][0]
+    DOM = 'native.semantic-universe.typescript.v2'
+    nid = 'ts:src/min.ts#f'
+    subject = {'schemaVersion': 3, 'universe': U, 'kind': 'symbol', 'nativeSubjectId': nid}
+    levels = [('syntactic', 'declares', 'syntactic', None, 'syntax'),
+              ('resolved', 'imports', 'resolved-target', 'syntactic-specifier', 'imports'),
+              ('type', 'types', 'checked', 'annotated', 'types')]
+    field = {'declares': 'declared', 'imports': 'importer', 'types': 'subject'}
+    sid, cid = 'scope2:' + '5' * 64, 'coverage2:' + '6' * 64
+
+    def payload(rel, rung, coverage='complete', deficiency=None, nc=None, state=None):
+        p = json.loads(json.dumps(templates[rung in E.RESOLVED_RUNGS]))
+        p['key'].update({'relation': rel, 'resolution': rung, 'sourceUniverse': U,
+                         'targetUniverse': U})
+        p['entry'].update({'relation': rel, 'resolution': rung, 'coverage': coverage,
+                           'deficiency': deficiency, 'nativeCause': nc})
+        if state:
+            p['entry']['resolutionCompleteness']['state'] = state
+        return p
+
+    def fact(rel, rung, n=1):
+        return {'id': 'fact2:%s' % (('%d' % n) * 64), 'record': {
+            'relation': rel, 'resolution': rung, 'sourceUniverse': U, 'anchors': []},
+            'payload': {field[rel]: nid}}
+
+    out = []
+    for level, rel, rung, lower, cap in levels:
