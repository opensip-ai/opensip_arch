+# The schema's operational faultCause/errorCode pairs are exactly the host fault map, so the retained D9
+# codeDerivation cannot drift between the public carrier and the host projection.
+_OPERATIONAL = next(b['then'] for b in SCHEMAS[U + 'common']['$defs']['StepTermination']['allOf']
+                    if b['if'].get('properties', {}).get('class', {}).get('const') == 'operational-failed')
+check('termination.fault-pairs-equal-host-fault-map',
+      [(r['properties']['faultCause']['const'], r['properties']['errorCode']['const']) for r in _OPERATIONAL['anyOf']]
+      == list(M.FAULT_TO_ERROR.items()))
