+def _scope_descriptor(sc: dict) -> dict:
+    """The subject-scope carrier fields of a retained scope, passed through exactly as present.
+
+    A missing or ill-typed field is NOT defaulted and does NOT skip validation: the native carrier
+    (identity-schemas.v3 `subject-scope`, all eight fields required) decides admission. An earlier
+    revision returned None here for a scope lacking a field, so a scope with no `enumeratorClosure`
+    key silently escaped the carrier and reached the untagged-scope fallbacks, while the same scope
+    with an explicit null was refused. Both now refuse `ATOM_NATIVE_CARRIER` (contract section 4).
+    """
+    desc = {k: sc[k] for k in SUBJECT_SCOPE_FIELDS if k in sc}
+    if type(desc.get("subjects")) is list:
+        desc["subjects"] = sorted(desc["subjects"], key=C.canonical)
+    return desc
 
 
