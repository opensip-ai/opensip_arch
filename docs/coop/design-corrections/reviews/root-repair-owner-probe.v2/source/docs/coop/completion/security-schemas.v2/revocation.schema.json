{
 "type": "object",
 "properties": {
  "revocationSchema": {
   "const": 1
  },
  "revocationVersion": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9223372036854775807
  },
  "issuedAt": {
   "type": "string",
   "maxLength": 20,
   "minLength": 1,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "rootVersion": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9223372036854775807
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "subjectKind": {
      "enum": [
       "keyId",
       "namespace",
       "release",
       "catalogSnapshot"
      ]
     },
     "subject": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
     },
     "reason": {
      "enum": [
       "key-compromise",
       "superseded",
       "defect",
       "policy"
      ]
     },
     "revokedAt": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
     }
    },
    "required": [
     "subjectKind",
     "subject",
     "reason",
     "revokedAt"
    ],
    "additionalProperties": false
   },
   "maxItems": 4096,
   "minItems": 0
  }
 },
 "required": [
  "revocationSchema",
  "revocationVersion",
  "issuedAt",
  "rootVersion",
  "entries"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:opensip:design:revocation:1",
 "title": "opensip-revocation.1"
}
