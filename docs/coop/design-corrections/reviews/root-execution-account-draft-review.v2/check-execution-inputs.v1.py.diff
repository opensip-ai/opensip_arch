+                "derivedOutcomes": [], "derivedAccounts": []}
+    return {"result": "ADMIT", "refusals": [], "requiredCellDeficiencies": [],
+            "derivedOutcomes": [{"state": "complete"}], "derivedAccounts": [],
+            "precedenceTable": got}
