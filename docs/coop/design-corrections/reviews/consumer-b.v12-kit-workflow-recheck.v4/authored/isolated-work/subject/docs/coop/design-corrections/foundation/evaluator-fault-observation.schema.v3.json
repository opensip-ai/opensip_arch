{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:evaluator-fault-observation:3",
  "title": "Trusted evaluator boundary observation, not producer-authored authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "condition",
    "origin",
    "diagnosticDigest",
    "reference",
    "limit"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "condition": {
      "enum": [
        "complete-replay-mismatch",
        "input-identity-invalid",
        "input-join-invalid",
        "input-schema-invalid",
        "output-bound-exceeded",
        "promised-bytes-lost",
        "required-output-pointer-omitted",
        "selection-limit-exceeded"
      ]
    },
    "origin": {
      "enum": [
        "evidence-store",
        "external-configuration",
        "external-specification",
        "host-internal",
        "host-pre-plan",
        "host-serialization",
        "provider-return",
        "release-declaration",
        "retained-regeneration"
      ]
    },
    "diagnosticDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "limit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "observed",
            "maximum"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "condition": {
            "enum": [
              "selection-limit-exceeded",
              "output-bound-exceeded"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "limit": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "limit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "enum": [
              "required-output-pointer-omitted",
              "promised-bytes-lost",
              "complete-replay-mismatch"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "condition": {
              "const": "input-schema-invalid"
            },
            "origin": {
              "const": "external-configuration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-schema-invalid"
            },
            "origin": {
              "const": "external-specification"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-schema-invalid"
            },
            "origin": {
              "const": "release-declaration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-schema-invalid"
            },
            "origin": {
              "const": "provider-return"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-schema-invalid"
            },
            "origin": {
              "const": "host-internal"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-identity-invalid"
            },
            "origin": {
              "const": "external-configuration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-identity-invalid"
            },
            "origin": {
              "const": "external-specification"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-identity-invalid"
            },
            "origin": {
              "const": "release-declaration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-identity-invalid"
            },
            "origin": {
              "const": "provider-return"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-identity-invalid"
            },
            "origin": {
              "const": "host-internal"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-join-invalid"
            },
            "origin": {
              "const": "external-configuration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-join-invalid"
            },
            "origin": {
              "const": "external-specification"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-join-invalid"
            },
            "origin": {
              "const": "release-declaration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-join-invalid"
            },
            "origin": {
              "const": "provider-return"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "input-join-invalid"
            },
            "origin": {
              "const": "host-internal"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "selection-limit-exceeded"
            },
            "origin": {
              "const": "external-configuration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "selection-limit-exceeded"
            },
            "origin": {
              "const": "external-specification"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "selection-limit-exceeded"
            },
            "origin": {
              "const": "host-pre-plan"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "required-output-pointer-omitted"
            },
            "origin": {
              "const": "provider-return"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "required-output-pointer-omitted"
            },
            "origin": {
              "const": "host-internal"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "promised-bytes-lost"
            },
            "origin": {
              "const": "evidence-store"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "complete-replay-mismatch"
            },
            "origin": {
              "const": "retained-regeneration"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "complete-replay-mismatch"
            },
            "origin": {
              "const": "host-internal"
            }
          }
        },
        {
          "properties": {
            "condition": {
              "const": "output-bound-exceeded"
            },
            "origin": {
              "const": "host-serialization"
            }
          }
        }
      ]
    }
  ],
  "x-opensip-routes": {
    "input-schema-invalid:external-configuration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "CONFIG.INVALID"
      },
      "detail": "CONFIG.INVALID",
      "remedy": "Correct the supplied configuration using the retained admission diagnostic."
    },
    "input-schema-invalid:external-specification": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Supply a specification admitted under the selected contract."
    },
    "input-schema-invalid:release-declaration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Install a release with an admitted declaration."
    },
    "input-schema-invalid:provider-return": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "PROVIDER.PROTOCOL_VIOLATION",
        "faultCause": "provider-protocol"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Correct the provider output and rerun the stage; retain its admission diagnostic."
    },
    "input-schema-invalid:host-internal": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
        "faultCause": "host-invariant"
      },
      "detail": "HOST.INVARIANT_VIOLATED",
      "remedy": "Report the host defect with the retained diagnostic."
    },
    "input-identity-invalid:external-configuration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "CONFIG.INVALID"
      },
      "detail": "CONFIG.INVALID",
      "remedy": "Correct the supplied configuration using the retained admission diagnostic."
    },
    "input-identity-invalid:external-specification": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Supply a specification admitted under the selected contract."
    },
    "input-identity-invalid:release-declaration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Install a release with an admitted declaration."
    },
    "input-identity-invalid:provider-return": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "PROVIDER.PROTOCOL_VIOLATION",
        "faultCause": "provider-protocol"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Correct the provider output and rerun the stage; retain its admission diagnostic."
    },
    "input-identity-invalid:host-internal": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
        "faultCause": "host-invariant"
      },
      "detail": "HOST.INVARIANT_VIOLATED",
      "remedy": "Report the host defect with the retained diagnostic."
    },
    "input-join-invalid:external-configuration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "CONFIG.INVALID"
      },
      "detail": "CONFIG.INVALID",
      "remedy": "Correct the supplied configuration using the retained admission diagnostic."
    },
    "input-join-invalid:external-specification": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Supply a specification admitted under the selected contract."
    },
    "input-join-invalid:release-declaration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.PRECONDITION_FAILED"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Install a release with an admitted declaration."
    },
    "input-join-invalid:provider-return": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "PROVIDER.PROTOCOL_VIOLATION",
        "faultCause": "provider-protocol"
      },
      "detail": "EVALUATION.INPUT_REFUSED",
      "remedy": "Correct the provider output and rerun the stage; retain its admission diagnostic."
    },
    "input-join-invalid:host-internal": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
        "faultCause": "host-invariant"
      },
      "detail": "HOST.INVARIANT_VIOLATED",
      "remedy": "Report the host defect with the retained diagnostic."
    },
    "selection-limit-exceeded:external-configuration": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.UNSATISFIABLE"
      },
      "detail": "EVALUATION.SELECTION_LIMIT",
      "remedy": "Narrow the selected field to its published limit before creating a Plan."
    },
    "selection-limit-exceeded:external-specification": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.UNSATISFIABLE"
      },
      "detail": "EVALUATION.SELECTION_LIMIT",
      "remedy": "Narrow the selected field to its published limit before creating a Plan."
    },
    "selection-limit-exceeded:host-pre-plan": {
      "termination": {
        "class": "request-rejected",
        "errorCode": "REQUEST.UNSATISFIABLE"
      },
      "detail": "EVALUATION.SELECTION_LIMIT",
      "remedy": "Narrow the selected field to its published limit before creating a Plan."
    },
    "required-output-pointer-omitted:provider-return": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "PROVIDER.PROTOCOL_VIOLATION",
        "faultCause": "provider-protocol"
      },
      "detail": "EVALUATION.REQUIRED_OUTPUT_OMITTED",
      "remedy": "The provider must return every required outcome pointer, including a typed unavailable outcome."
    },
    "required-output-pointer-omitted:host-internal": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
        "faultCause": "host-invariant"
      },
      "detail": "EVALUATION.REQUIRED_OUTPUT_OMITTED",
      "remedy": "Report the missing host-owned outcome with its retained diagnostic."
    },
    "promised-bytes-lost:evidence-store": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "HOST.IO_FAILURE",
        "faultCause": "host-io"
      },
      "detail": "evidence.missing",
      "remedy": "Restore the exact retained closure bytes or report their unavailability."
    },
    "complete-replay-mismatch:retained-regeneration": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "HOST.IO_FAILURE",
        "faultCause": "host-io"
      },
      "detail": "evidence.regeneration-mismatch",
      "remedy": "Retain the sealed Run and investigate the differing regeneration result."
    },
    "complete-replay-mismatch:host-internal": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE",
        "faultCause": "host-invariant"
      },
      "detail": "HOST.INVARIANT_VIOLATED",
      "remedy": "Report the evaluator defect with both retained output derivations."
    },
    "output-bound-exceeded:host-serialization": {
      "termination": {
        "class": "operational-failed",
        "errorCode": "OUTPUT.SERIALIZATION_FAILED",
        "faultCause": "output-serialization"
      },
      "detail": "EVALUATION.OUTPUT_BOUND_EXCEEDED",
      "remedy": "Narrow the analysis output or select a release with a larger published bound; never truncate a Run."
    }
  },
  "x-opensip-custody": "Host records the actual invoking boundary, keeps origin on re-admission, and retains the exact owner diagnostic bytes by raw sha256. Decision messages do not choose a route. Unknown condition/origin pairs refuse.",
  "x-opensip-native-origin-map": {
    "external-configuration": "external-configuration",
    "external-specification": "externally-supplied-spec",
    "host-internal": "host-generated-internal-layer",
    "release-declaration": "authenticated-release-declaration",
    "provider-return": "producer-boundary"
  }
}
