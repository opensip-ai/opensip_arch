      "text": "<system-reminder>\nBackground task \"call-4e4ad0f3-1a38-487b-8976-da69455a354d-25\" completed (exit code: 0).\nCommand: PY=/tmp/opensip-architecture-review-env/bin/python\n$PY -I -B << 'PY'\nimport hashlib, os\nfrom pathlib import Path\nSUCC = Path(\"/tmp/opensip-design-corrections/target-identity-successor.v1\")\nFROZEN = Path(\"/tmp/opensip-design-corrections/candidate-subject.v24\")\nMANIFEST_PATHS = {\n\"docs/coop/design-corrections/foundation/atom-evaluation-contract.v1.md\",\n\"docs/coop/design-corrections/foundation/atom_model.v1.py\",\n\"docs/coop/design-corrections/foundation/check-atoms.v1.py\",\n\"docs/coop/design-corrections/foundation/check-execution-inputs.v1.py\",\n\"docs/coop/design-corrections/foundation/check-semantic-replay.v3.py\",\n\"docs/coop/design-corrections/foundation/evaluator-projection-registry.v1.json\",\n\"docs/coop/design-corrections/foundation/evaluator_semantic_fixture.v3.py\",\n\"docs/coop/design-corrections/foundation/execution-inputs-contract.v1.md\",\n\"docs/coop/design-corrections/foundation/execution_inputs_model.v1.py\",\n\"docs/coop/design-corrections/foundation/identity-model.v3.py\",\n\"docs/coop/design-corrections/foundation/identity-schemas.v3.json\",\n\"docs/coop/design-corrections/foundation/shared-profile-decisions.v1.md\",\n\"docs/coop/design-corrections/foundation/target-attribution.schema.v2.json\",\n\"docs/coop/design-corrections/workflows/check-query-projection.v3.py\",\n\"docs/coop/design-corrections/workflows/query-projection-contract.v3.md\",\n\"docs/coop/design-corrections/workflows/query_projection_model.v3.py\",\n\"docs/v2/contracts/product-v1/identity-and-evidence.md\",\n\"docs/v2/contracts/product-v1/native-evidence.md\",\n}\n\ndef sha(p):\n    h=hashlib.sha256()\n    with open(p,'rb') as f:\n        for chunk in iter(lambda: f.read(1024*1024), b''):\n            h.update(chunk)\n    return h.hexdigest()\n\nsucc_files=set()\nfrozen_files=set()\nfor root, dirs, files in os.walk(SUCC):\n    # skip huge review histories? user said no unrelated review histories but we need to know if successor has extra changes\n    for fn in files:\n        p=Path(root)/fn\n        rel=p.relative_to(SUCC).as_posix()\n        succ_files.add(rel)\nfor root, dirs, files in os.walk(FROZEN):\n    for fn in files:\n        p=Path(root)/fn\n        rel=p.relative_to(FROZEN).as_posix()\n        frozen_files.add(rel)\n\nonly_succ=sorted(succ_files-frozen_files)\nonly_frozen=sorted(frozen_files-succ_files)\ncommon=succ_files & frozen_files\nchanged=[]\n# hash common files; skip reviews tree for speed? We need complete picture. Hashing 12k files is ok.\nfor i,rel in enumerate(sorted(common)):\n    sp=SUCC/rel\n    fp=FROZEN/rel\n    if sp.stat().st_size != fp.stat().st_size:\n        changed.append(rel)\n        continue\n    if sha(sp)!=sha(fp):\n        changed.append(rel)\n\nprint(\"succ_file_count\", len(succ_files))\nprint(\"frozen_file_count\", len(frozen_files))\nprint(\"only_succ_count\", len(only_succ))\nprint(\"only_frozen_count\", len(only_frozen))\nprint(\"size_or_hash_changed\", len(changed))\nprint(\"ONLY_SUCC\")\nfor r in only_succ:\n    print(\" \", r)\nprint(\"ONLY_FROZEN\")\nfor r in only_frozen:\n    print(\" \", r)\nprint(\"CHANGED_NOT_IN_MANIFEST\")\nextra_changed=[r for r in changed if r not in MANIFEST_PATHS]\nprint(\"extra_changed_count\", len(extra_changed))\nfor r in extra_changed:\n    print(\" \", r)\nprint(\"MANIFEST_NOT_CHANGED\")\nfor r in sorted(MANIFEST_PATHS):\n    if r not in only_succ and r not in changed:\n        print(\" \", r)\nprint(\"CHANGED_IN_MANIFEST\", len([r for r in changed if r in MANIFEST_PATHS]))\nPY | Duration: 21.1s\nUse get_command_or_subagent_output(\"call-4e4ad0f3-1a38-487b-8976-da69455a354d-25\") to see the full output.\n</system-reminder>",
