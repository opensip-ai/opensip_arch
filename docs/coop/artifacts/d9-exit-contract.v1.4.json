{
  "artifact": "opensip.d9-exit-contract",
  "version": "1.4",
  "status": "candidate-agent-3",
  "supersedes": "1.3",
  "purpose": "Total host-owned process-exit contract: HostTermination union, derivation rules, schema-complete golden fixtures with prohibited-effect assertions.",
  "resolves": {
    "A2-D9-V13-01": "Axes are now enumerated, not boolean. required coverage unsatisfied now pairs with verdict=indeterminate; a boolean could not express unknown/not-applicable, which is what forced the semantically false inputs.",
    "A2-D9-V13-02": "Baseline recipe incompatibility no longer encoded as coverage failure: requiredCoverage=satisfied, verdict=indeterminate, reason BASELINE.RECIPE_UNSUPPORTED with its own remedy.",
    "A2-D9-V13-03": "All 39 goldens carry a falsifiable scenario sentence. 37 restored from v1.1 (dropped in v1.2 and not noticed when v1.3 was built); 2 newly authored.",
    "A2-D9-V13-04": "exitCode removed from all 39 payloads; explicit nulls removed; every axis field declared in the schema; all reason codes mapped into the closed vocabulary. Error-code spellings from v1.2 migrated into the closed vocabulary; the mapping is recorded.",
    "A2-D9-V13-05": "Executable checker retained at artifacts/check-d9.py. It validates schema conformance, payload conformance, forbidden fields, vocabulary closure, derivation agreement, class coverage and finalization transitions \u2014 not merely class equality.",
    "A2-D9-V13-06": "Reason and error vocabularies carry explicit remedy text per code, including COVERAGE.LANGUAGE_TIER_UNSUPPORTED which connects the P-4 loud-tier decision to termination.",
    "A2-D9-V13-07": "Nullability resolved by absence. finalizationTransitions is a full table asserting a settled termination is unchanged by any later event, for every class.",
    "A2-D9-V13-08": "expectedEffects added for optional/required delivery and all three repair-verification cases."
  },
  "decisionDependencies": [
    {
      "id": "AGREEMENT.37",
      "source": "agents-log2.md#areas-of-agreement",
      "claim": "one host-owned total mapper, one process-boundary write site"
    },
    {
      "id": "ARCH.OUTCOME",
      "source": "architecture/07-outcomes-and-failure.md",
      "claim": "termination is one total union; verdict and termination are distinct"
    },
    {
      "id": "ARCH.COVERAGE-PASS",
      "source": "architecture/02-domain-model.md#the-run-is-multi-axis",
      "claim": "required partial coverage can never yield pass"
    },
    {
      "id": "P-4",
      "source": "artifacts/claim-register.v1.json",
      "claim": "syntax-tier languages surface unrun predicates loudly"
    },
    {
      "id": "METHOD.RULE-3",
      "source": "architecture/10-method.md",
      "claim": "the binding object must be checkable"
    }
  ],
  "exitClasses": [
    {
      "class": "success",
      "code": 0,
      "meaning": "The requested operation completed; an analysis passed or was advisory; or a serve process completed cooperative shutdown."
    },
    {
      "class": "policy-failed",
      "code": 1,
      "meaning": "A valid, sufficiently covered analysis completed and project-owned policy failed."
    },
    {
      "class": "request-rejected",
      "code": 2,
      "meaning": "Usage, configuration, admission, compatibility, lookup-address, resolver failure, or mutation-precondition rejection."
    },
    {
      "class": "indeterminate",
      "code": 3,
      "meaning": "The host produced an honest terminal result but required evidence, convergence, or negotiable recipe support was unavailable."
    },
    {
      "class": "operational-failed",
      "code": 4,
      "meaning": "Host, provider, protocol, integrity, durability, required-delivery, contention, or output-materialization failure prevented reliable completion."
    },
    {
      "class": "interrupted",
      "code": 130,
      "meaning": "The user interrupted a finite (non-serve-stop) operation and cooperative cleanup ran where possible."
    }
  ],
  "classToExitCode": {
    "success": 0,
    "policy-failed": 1,
    "request-rejected": 2,
    "indeterminate": 3,
    "operational-failed": 4,
    "interrupted": 130
  },
  "hostTerminationUnion": {
    "discriminator": "class",
    "unknownFieldPolicy": "reject",
    "nullabilityPolicy": "Optional fields are ABSENT or present-and-valid. No field is ever explicitly null; absence is the only way to express 'not applicable'. This resolves A2-D9-V12-07: a pre-admission failure omits runId entirely rather than carrying null.",
    "exitCodeInPayload": "NOT a union field. exitCode is derived from class via classToExitCode and must not be stored on HostTermination, so the two can never disagree (A2-D9-V12-01).",
    "fieldTypes": {
      "runId": {
        "type": "string",
        "format": "RunId",
        "nullable": false
      },
      "executionId": {
        "type": "string",
        "format": "ExecutionId",
        "nullable": false
      },
      "errorCode": {
        "type": "string",
        "format": "namespaced-error-code",
        "nullable": false
      },
      "reasonCodes": {
        "type": "array",
        "items": "string",
        "minItems": 1,
        "nullable": false
      },
      "coverageId": {
        "type": "string",
        "format": "ContentDigest",
        "nullable": false
      },
      "signal": {
        "type": "string",
        "enum": [
          "SIGINT",
          "SIGTERM",
          "SIGHUP"
        ],
        "nullable": false
      },
      "details": {
        "type": "object",
        "nullable": false
      }
    },
    "variants": [
      {
        "class": "success",
        "required": [],
        "optional": [
          "runId",
          "executionId"
        ]
      },
      {
        "class": "policy-failed",
        "required": [
          "runId"
        ],
        "optional": [
          "executionId"
        ]
      },
      {
        "class": "request-rejected",
        "required": [
          "errorCode"
        ],
        "optional": [
          "details",
          "executionId"
        ]
      },
      {
        "class": "indeterminate",
        "required": [
          "reasonCodes"
        ],
        "optional": [
          "runId",
          "coverageId",
          "executionId"
        ]
      },
      {
        "class": "operational-failed",
        "required": [
          "errorCode"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      },
      {
        "class": "interrupted",
        "required": [
          "signal"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      }
    ],
    "forbiddenFields": [
      "exitCode"
    ],
    "forbiddenFieldsRationale": "exitCode is derived from class by classToExitCode. Storing it permits the two to disagree \u2014 v1.3 declared this and then shipped it in all 38 goldens."
  },
  "codeVocabulary": {
    "closed": true,
    "reasonCodes": [
      "COVERAGE.PROVIDER_UNAVAILABLE",
      "COVERAGE.LANGUAGE_TIER_UNSUPPORTED",
      "COVERAGE.REQUIRED_RELATION_MISSING",
      "COVERAGE.BUDGET_EXHAUSTED",
      "SNAPSHOT.CONVERGENCE_EXHAUSTED",
      "BASELINE.RECIPE_UNSUPPORTED",
      "VERDICT.INDETERMINATE",
      "QUERY.COMPLETENESS_UNMET"
    ],
    "errorCodes": [
      "IDENTITY.UNKNOWN",
      "IDENTITY.EXPIRED",
      "REQUEST.UNKNOWN_OPTION",
      "REQUEST.SCHEMA_MAJOR_UNSUPPORTED",
      "REQUEST.UNSATISFIABLE",
      "REQUEST.PRECONDITION_FAILED",
      "CONFIG.INVALID",
      "EXTENSION.ADMISSION_REJECTED",
      "EXTENSION.INSTALL_IO_FAILED",
      "HOST.IO_FAILURE",
      "LEDGER.BUSY_TIMEOUT",
      "LEDGER.CORRUPT",
      "PROVIDER.PROTOCOL_VIOLATION",
      "DURABILITY.COMMIT_FAILED",
      "DELIVERY.REQUIRED_FAILED",
      "OUTPUT.SERIALIZATION_FAILED",
      "SERVE.PROTOCOL_FAULT",
      "SYSTEM.OUTCOME.ILLEGAL_STATE"
    ],
    "remedies": {
      "COVERAGE.PROVIDER_UNAVAILABLE": "install or enable the provider",
      "COVERAGE.LANGUAGE_TIER_UNSUPPORTED": "language ships at the syntax tier; this predicate cannot run (P-4)",
      "COVERAGE.REQUIRED_RELATION_MISSING": "widen scope so the relation can be derived",
      "COVERAGE.BUDGET_EXHAUSTED": "raise the budget or narrow scope",
      "SNAPSHOT.CONVERGENCE_EXHAUSTED": "quiesce the worktree and retry",
      "BASELINE.RECIPE_UNSUPPORTED": "run baseline upgrade",
      "VERDICT.INDETERMINATE": "resolve the upstream indeterminacy",
      "QUERY.COMPLETENESS_UNMET": "relax the completeness requirement or widen scope"
    },
    "rule": "A code outside this vocabulary is a contract violation. Codes are grouped by remedy: two codes with the same remedy are a smell, two remedies behind one code is a defect.",
    "spellingMigration": {
      "from": "v1.2 ad-hoc spellings",
      "map": {
        "PROVIDER.PROTOCOL": "PROVIDER.PROTOCOL_VIOLATION",
        "LEDGER.DURABILITY": "DURABILITY.COMMIT_FAILED",
        "PLAN.AUTHORITY_CONFLICT": "REQUEST.UNSATISFIABLE",
        "USAGE.UNKNOWN_OPTION": "REQUEST.UNKNOWN_OPTION",
        "SCHEMA.UNSUPPORTED_MAJOR": "REQUEST.SCHEMA_MAJOR_UNSUPPORTED",
        "HOST.IO": "HOST.IO_FAILURE",
        "IDENTITY.NEVER_EXISTED": "IDENTITY.UNKNOWN",
        "RESOLVER.EMPTY_DOMAIN": "IDENTITY.UNKNOWN",
        "MUTATION.PRECONDITION": "REQUEST.PRECONDITION_FAILED",
        "EXTENSION.ADMISSION": "EXTENSION.ADMISSION_REJECTED",
        "EXTENSION.INSTALL_IO": "EXTENSION.INSTALL_IO_FAILED",
        "SERVE.PROTOCOL": "SERVE.PROTOCOL_FAULT",
        "OUTPUT.SERIALIZE": "OUTPUT.SERIALIZATION_FAILED"
      },
      "note": "The canonical spelling choice is arbitrary; the CLOSURE requirement is not. v1.3 declared a closed vocabulary and shipped 12 error codes plus 5 reason codes outside it \u2014 the retained checker (D5) is what makes that impossible to repeat."
    }
  },
  "scenarioAxesSchema": {
    "properties": {
      "commandKind": {
        "enum": [
          "run",
          "query",
          "mutation",
          "serve",
          "any"
        ],
        "required": true
      },
      "admission": {
