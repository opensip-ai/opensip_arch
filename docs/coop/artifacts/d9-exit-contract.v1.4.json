        "required": true
      },
      "lifecycle": {
        "enum": [
          "pre-run",
          "coherent-terminal-run",
          "cannot-seal-coherent-run",
          "not-applicable"
        ],
        "required": true
      },
      "requiredCoverage": {
        "enum": [
          "satisfied",
          "unsatisfied",
          "unknown",
          "not-applicable"
        ],
        "required": true
      },
      "verdict": {
        "enum": [
          "pass",
          "advisory",
          "fail",
          "indeterminate",
          "unavailable",
          "not-applicable"
        ],
        "required": true
      },
      "durability": {
        "enum": [
          "committed",
          "failed",
          "not-required",
          "not-applicable"
        ],
        "required": true
      },
      "interruption": {
        "enum": [
          "none",
          "signal-before-finalization",
          "signal-after-finalization"
        ],
        "required": true
      },
      "requiredPostconditions": {
        "enum": [
          "met",
          "failed",
          "not-applicable"
        ],
        "required": true
      },
      "domainCondition": {
        "enum": [
          "none",
          "host-fault",
          "precondition-failed",
          "verification-propagated",
          "addressed-identity-unresolved",
          "clean-shutdown",
          "graceful-signal-stop",
          "serve-fault",
          "optional-delivery-failed"
        ],
        "required": true
      }
    },
    "additionalProperties": false,
    "nullPolicy": "No axis is ever explicitly null. not-applicable is a value; absence is invalid.",
    "whyEnums": "v1.3 used booleans. A boolean cannot express unknown or not-applicable, which forced inputs asserting states the architecture forbids (verdict=pass with required coverage unsatisfied). The type was wrong and the wrong type produced the wrong values."
  },
