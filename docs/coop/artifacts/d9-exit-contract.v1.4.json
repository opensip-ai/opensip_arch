  "invariants": [
    {
      "id": "invariant-one-mapper",
      "text": "Only the host finalizer constructs HostTermination; one map class\u2192exitCode; one controllable process-exit write site."
    },
    {
      "id": "invariant-envelope-parity",
      "text": "For finite CLI commands, CommandEnvelope.termination equals process termination when serialization succeeds."
    },
    {
      "id": "invariant-failure-preadmit",
      "text": "FailureResult is constructible without project or Run identity."
    },
    {
      "id": "invariant-no-policy-as-error",
      "text": "Policy verdict never becomes Error; operational failure never becomes Finding."
    },
    {
      "id": "invariant-optional-egress",
      "text": "Optional Cloud/export failure cannot alter local Run verdict."
    },
    {
      "id": "invariant-durability",
      "text": "Durability failure cannot report success for an authoritative Run."
    },
    {
      "id": "invariant-finalization-commit",
      "text": "There is a finalization commit point after HostTermination is settled and required postconditions evaluated. Signals before it may yield interrupted; signals after it cannot reclassify termination."
    },
    {
      "id": "invariant-orphan-recovery",
      "text": "Interruption/crash during authoritative publication leaves ledger recoverable; orphans are abandoned, never sealed success."
    },
    {
      "id": "invariant-verdict-vs-termination",
      "text": "Envelope projects verdict and HostTermination as distinct fields."
    },
    {
      "id": "invariant-exit0-not-attestation",
      "text": "Exit 0 alone is never a durable attestation; authority is a required postcondition."
    },
    {
      "id": "invariant-identity-expiry",
      "text": "IDENTITY.EXPIRED requires a retained RunId tombstone; otherwise IDENTITY.UNKNOWN."
    },
    {
      "id": "invariant-baseline-no-mass-netnew",
      "text": "Unsupported/unnegotiable fingerprint recipe: comparisonPerformed=false and comparisonDerivedFindingCount=0."
    }
  ],
