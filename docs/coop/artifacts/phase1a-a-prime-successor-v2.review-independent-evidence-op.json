    ]
  },
  "blockingFindings": [
    {
      "id": "IR-E5OP4-01",
      "severity": "BLOCKING",
      "title": "Caller-carried store index can mint the opaque pre-core authority handle",
      "claimRejected": "EP6/RR13-01 mechanically authenticates project/store ownership before core invocation.",
      "evidence": [
        "EvaluationAuthorityAdmissionInputV1 is an ordinary JSON value and contains evaluationAuthorityStoreIndex itself.",
        "The sole candidate constructor has the effective signature admit_evaluation_authority(value); it accepts no ProjectStore, StoreReader, transaction, ledger capability or authenticated store receipt from outside that value.",
        "The constructor filters the caller-carried rows for one (projectId,evaluationAuthoritySealRef) match and then creates _AdmittedEvaluationAuthorityV1.",
        "A regression probe loaded only evaluation-proof.v6.json, passed its JSON authorityAdmissionInput to that one-argument constructor, and minted the private handle without any store interaction.",
        "The handle is non-serializable, but output opacity does not authenticate the provenance of its serialized inputs.",
        "Evidence v5 imports this exact EP6 constructor. Its separate API sketch mentioning ProjectStore does not bind or replace the constructor and therefore cannot repair the pre-core trust boundary.",
        "Atomic post-core RunAuthorityIndexV1 publication only equality-copies the admitted refs; it cannot retrospectively prove those refs came from the project ledger."
      ],
      "attack": {
        "name": "SELF-CONTAINED-FICTITIOUS-STORE",
        "result": "ACCEPTED-BY-CONTRACT-SHAPE",
        "steps": [
          "Construct a byte-consistent C2/RI/receipt/manifest/seal payload for an attacker-controlled project view.",
          "Place the matching EvaluationAuthorityIndexV1 row inside the same admission JSON.",
          "Call admit_evaluation_authority(value) without presenting a project-bound store reader.",
          "Receive the same private capability type that core accepts."
        ],
        "whyExistingNegativesMissIt": "The negatives detect mismatch, duplicate rows, unknown fields, owner strings, booleans and forged output handles. They do not distinguish an authoritative store read from a perfectly self-consistent store fiction supplied in the input."
      },
      "impact": [
        "RR13-01-ADMISSION remains open.",
        "The earlier IR-E4OP3-01 project mismatch is repaired only conditionally; same-project consistency is not same-project store authority.",
        "R14 Evidence transfer and R12 dependency/evidence packet acceptance remain blocked transitively.",
        "OP4's G19 candidate mechanism cannot be accepted even as a complete design mechanism.",
        "No seal, application, product qualification or authority promotion is permitted."
      ],
      "requiredChange": [
        "Make the sole authority constructor require a non-serializable project-scoped StoreReader/transaction capability that the caller cannot encode in the admission value.",
        "Resolve EvaluationAuthorityIndexV1 and all referenced raw records through that capability, or consume typed authenticated store-read results whose issuer is bound outside the caller-supplied payload.",
        "Remove caller-carried evaluationAuthorityStoreIndex as authority; at most retain it as a non-authoritative expected-value assertion checked against the store read.",
        "Unify Evidence v5's ProjectStore API sketch with EP6's one exact constructor so there is no second or decorative admission recipe.",
        "Add an executable negative in which an entirely coherent fabricated index/receipt/manifest/seal universe is rejected because it is absent from the real project store.",
        "Regenerate EP, RT, VERSIONING, Evidence, OPERABILITY and response pins and obtain another independent combined rereview."
      ]
    }
  ],
