  "selectedRepairMethod": {
    "id": "HOST-STORE-PROVEN-AUTHORITY-AND-SAME-STORE-FINALIZATION",
    "summary": "Remove every store/index row from untrusted EvaluationAuthorityCandidateV1. A host-admitted opaque ProjectStoreAuthorityV1 performs exact C2/RI/raw/semantic validation, immutable CAS publish-or-verify, unique index insert-or-verify and trusted reread before minting a store-instance-bound handle; Evidence v6 requires that identical store/handle at atomic finalization.",
    "preCore": [
      "reject non-closed candidates and any caller-carried store/index/owner/boolean/ref authority",
      "require an opaque nonserializable ProjectStoreAuthorityV1 created only after project marker/registry/open-root admission",
      "recompute exact C2/RI/raw/semantic authority and publish-or-exact-verify immutable CAS",
      "insert-or-exact-verify one immutable (ProjectId,evaluationAuthoritySealRef) index row",
      "reread index/CAS through the same trusted port, then mint a store-instance/project/EAS-bound AdmittedEvaluationAuthorityV1"
    ],
    "postCore": "Evidence v6 commit_run requires the identical ProjectStoreAuthorityV1 and admitted handle, rereads authority index/CAS inside the final transaction, rederives unchanged TerminalRunV1 and RunAuthorityIndexV1 identities, and atomically inserts-or-verifies Terminal/RunIndex/AttemptLink/CustodyRoot/RunAuthorityIndex/outbox."
  },
