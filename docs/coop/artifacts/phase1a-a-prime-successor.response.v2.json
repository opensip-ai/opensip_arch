  "selectedRepairMethod": {
    "id": "SAME-PROJECT-RAW-RECEIPT-OPAQUE-ADMISSION-AND-POSTCORE-JOIN",
    "summary": "Recompute the exact C2/RI authority chain in one ProjectId; verify three closed raw receipt records and one unique store index; construct only a module-private non-serializable authority handle; derive raw custody from its actual graph; equality-rejoin it after core in atomic RunAuthorityIndexV1.",
    "preCore": [
      "C2 validate/canonicalize/recommit frozen PlanIntent",
      "RI validate/rederive SnapshotDescriptor/SnapshotId and PlanDescriptor/PlanId",
      "closed-decode/re-encode and rehash AdmittedResolvedInputsV1, PlanAuthorityReceiptV1 and EvaluationAuthorityAdmissionV1",
      "resolve manifest/seal semantic commitments to raw canonical records",
      "lookup exactly one (ProjectId,evaluationAuthoritySealRef) store-index row",
      "mint non-serializable AdmittedEvaluationAuthorityV1 and invoke pure core"
    ],
    "postCore": "Re-derive TerminalRunV1, equality-join all authority identities, then atomically write RunAuthorityIndexV1 with Terminal/RunIndex/AttemptLink/CustodyRoot/outbox. The index is outside every content identity."
  },
