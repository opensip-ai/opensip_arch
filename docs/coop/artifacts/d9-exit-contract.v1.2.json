{
  "artifact": "opensip.d9-exit-contract",
  "version": "1.2",
  "status": "candidate-agent-1",
  "supersedes": "opensip.d9-exit-contract v1.1",
  "date": "2026-07-29",
  "purpose": "Total host-owned process-exit contract: HostTermination union, derivation rules, schema-complete golden fixtures with prohibited-effect assertions.",
  "decisionDependencies": [
    {
      "id": "item-37",
      "role": "one host finalizer, one process-boundary exit write site"
    },
    {
      "id": "C4-F3",
      "role": "fingerprint recipe migration; no mass false net-new"
    },
    {
      "id": "C2-snapshot",
      "role": "convergence-exhausted is indeterminate"
    },
    {
      "id": "C5-storage",
      "role": "busy-timeout classified; multi-process safety assumed via storage protocol not proven by this artifact"
    },
    {
      "id": "item-38",
      "role": "project owns policy; D9 assumes policy verdict already host-resolved"
    },
    {
      "id": "D3-retention",
      "role": "IDENTITY.EXPIRED requires tombstone or IDENTITY.UNKNOWN"
    }
  ],
  "conformanceClaims": [
    {
      "id": "CC-D9-01",
      "obligation": "exitCode = map(HostTermination.class) only",
      "evidence": [
        "invariant-one-mapper",
        "all golden expectedTermination.exitCode"
      ]
    },
    {
      "id": "CC-D9-02",
      "obligation": "every golden HostTermination satisfies union required fields",
      "evidence": [
        "goldenCases",
        "hostTerminationUnion"
      ]
    },
    {
      "id": "CC-D9-03",
      "obligation": "unsupported fingerprint recipe yields indeterminate and performs no comparison-derived findings",
      "evidence": [
        "baseline-compare-unsupported-recipe"
      ]
    },
    {
      "id": "CC-D9-04",
      "obligation": "optional cloud failure does not change local success",
      "evidence": [
        "optional-cloud-egress-failed"
      ]
    },
    {
      "id": "CC-D9-05",
      "obligation": "required delivery failure is operational-failed after sealed pass",
      "evidence": [
        "required-delivery-failed"
      ]
    },
    {
      "id": "CC-D9-06",
      "obligation": "post-finalization-commit signals cannot reclassify HostTermination",
      "evidence": [
        "user-interrupt-post-finalization-commit",
        "invariant-finalization-commit"
      ]
    },
    {
      "id": "CC-D9-07",
      "obligation": "serve graceful SIGINT/SIGTERM maps to success",
      "evidence": [
        "serve-graceful-signal-stop"
      ]
    },
    {
      "id": "CC-D9-08",
      "obligation": "latest resolver on empty domain is request-rejected",
      "evidence": [
        "query-latest-resolver-empty-domain"
      ]
    }
  ],
  "exitClasses": [
    {
      "class": "success",
      "code": 0,
      "meaning": "The requested operation completed; an analysis passed or was advisory; or a serve process completed cooperative shutdown."
    },
    {
      "class": "policy-failed",
      "code": 1,
      "meaning": "A valid, sufficiently covered analysis completed and project-owned policy failed."
    },
    {
      "class": "request-rejected",
      "code": 2,
      "meaning": "Usage, configuration, admission, compatibility, lookup-address, resolver failure, or mutation-precondition rejection."
    },
    {
      "class": "indeterminate",
      "code": 3,
      "meaning": "The host produced an honest terminal result but required evidence, convergence, or negotiable recipe support was unavailable."
    },
    {
      "class": "operational-failed",
      "code": 4,
      "meaning": "Host, provider, protocol, integrity, durability, required-delivery, contention, or output-materialization failure prevented reliable completion."
    },
    {
      "class": "interrupted",
      "code": 130,
      "meaning": "The user interrupted a finite (non-serve-stop) operation and cooperative cleanup ran where possible."
    }
  ],
  "hostTerminationUnion": {
    "discriminator": "class",
    "variants": [
      {
        "class": "success",
        "required": [],
        "optional": []
      },
      {
        "class": "policy-failed",
        "required": [
          "runId"
        ],
        "optional": []
      },
      {
        "class": "request-rejected",
