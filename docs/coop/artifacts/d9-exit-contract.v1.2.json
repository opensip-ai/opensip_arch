        ]
      },
      {
        "class": "indeterminate",
        "required": [
          "reasonCodes"
        ],
        "optional": [
          "runId",
          "coverageId"
        ]
      },
      {
        "class": "operational-failed",
        "required": [
          "errorCode"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      },
      {
        "class": "interrupted",
        "required": [
          "signal"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      }
    ]
  },
  "classToExitCode": {
    "success": 0,
    "policy-failed": 1,
    "request-rejected": 2,
    "indeterminate": 3,
    "operational-failed": 4,
    "interrupted": 130
  },
  "analysisDerivation": {
    "requiredInputs": [
      "lifecycle",
      "requiredCoverage",
      "verdict",
      "durability",
      "interruption",
      "requiredPostconditions",
      "finalizationCommitReached"
    ],
    "rulesInOrder": [
      {
        "when": "finalizationCommitReached and HostTermination already settled",
        "action": "ignore reclassification; optional transport shutdown only"
      },
      {
        "when": "interruption is user-signal AND NOT finalizationCommitReached AND commandKind in {run,query,mutation}",
        "termination": "interrupted"
      },
      {
        "when": "cannot seal coherent terminal Run (protocol/integrity/execution fault)",
        "termination": "operational-failed"
      },
      {
        "when": "authoritative durability required but commit failed OR required postcondition failed",
        "termination": "operational-failed"
      },
      {
        "when": "convergence exhausted OR required Coverage unsatisfied OR fingerprint-recipe-unsupported OR verdict indeterminate",
        "termination": "indeterminate"
      },
      {
        "when": "sealed + required Coverage ok + durability ok + verdict fail",
        "termination": "policy-failed"
      },
      {
        "when": "sealed + required Coverage ok + durability ok + verdict pass|advisory",
        "termination": "success"
      },
      {
        "when": "no rule matches",
        "termination": "operational-failed",
        "errorCode": "SYSTEM.OUTCOME.ILLEGAL_STATE"
      }
    ]
  },
  "nonAnalysisDerivation": {
    "rules": [
      "A valid empty query result is success; absence is data unless the command addresses one required identity or uses a single-identity resolver.",
      "Bad arguments, authored-config errors, unsupported schema majors, incompatible contributions, missing addressed identities, failed resolvers (including latest on empty domain), authority conflicts (ephemeral Plan when authoritative required), and failed mutation preconditions are request-rejected.",
      "A query with an explicit completeness requirement that cannot be met is indeterminate.",
      "Baseline compare against an unsupported/unnegotiable fingerprint recipe is indeterminate (never policy-failed via mass false net-new).",
      "Host, datastore, provider-protocol, installation-I/O, ledger busy-timeout, required-delivery, and output-serialization failures are operational-failed; errorCodes distinguish retryable contention from corruption.",
      "A mutation with a linked verification Run propagates that Run's success, policy-failed, indeterminate, or operational-failed termination while retaining the mutation receipt.",
      "A protocol server that shuts down normally OR completes cooperative SIGINT/SIGTERM cleanup is success; a host/protocol fault is operational-failed; user-interrupt class is not used for clean serve stop."
    ]
  },
  "invariants": [
    {
      "id": "invariant-one-mapper",
      "text": "Only the host finalizer constructs HostTermination; one map class\u2192exitCode; one controllable process-exit write site."
    },
    {
      "id": "invariant-envelope-parity",
      "text": "For finite CLI commands, CommandEnvelope.termination equals process termination when serialization succeeds."
    },
    {
      "id": "invariant-failure-preadmit",
      "text": "FailureResult is constructible without project or Run identity."
    },
    {
      "id": "invariant-no-policy-as-error",
      "text": "Policy verdict never becomes Error; operational failure never becomes Finding."
    },
    {
      "id": "invariant-optional-egress",
      "text": "Optional Cloud/export failure cannot alter local Run verdict."
    },
    {
      "id": "invariant-durability",
      "text": "Durability failure cannot report success for an authoritative Run."
    },
    {
      "id": "invariant-finalization-commit",
      "text": "There is a finalization commit point after HostTermination is settled and required postconditions evaluated. Signals before it may yield interrupted; signals after it cannot reclassify termination."
    },
    {
      "id": "invariant-orphan-recovery",
      "text": "Interruption/crash during authoritative publication leaves ledger recoverable; orphans are abandoned, never sealed success."
    },
    {
      "id": "invariant-verdict-vs-termination",
      "text": "Envelope projects verdict and HostTermination as distinct fields."
    },
    {
      "id": "invariant-exit0-not-attestation",
      "text": "Exit 0 alone is never a durable attestation; authority is a required postcondition."
    },
    {
      "id": "invariant-identity-expiry",
      "text": "IDENTITY.EXPIRED requires a retained RunId tombstone; otherwise IDENTITY.UNKNOWN."
    },
    {
      "id": "invariant-baseline-no-mass-netnew",
      "text": "Unsupported/unnegotiable fingerprint recipe: comparisonPerformed=false and comparisonDerivedFindingCount=0."
    }
  ],
