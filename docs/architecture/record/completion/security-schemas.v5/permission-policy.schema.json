{
 "type": "object",
 "properties": {
  "policySchema": {
   "const": 1
  },
  "policyScope": {
   "enum": [
    "project",
    "global"
   ]
  },
  "grants": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "stableId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     },
     "token": {
      "enum": [
       "PT-FS-READ-PROJECT",
       "PT-FS-READ-COMPONENT",
       "PT-FS-WRITE-HOST-STATE",
       "PT-PROC-EXEC-DECLARED",
       "PT-NET-EGRESS",
       "PT-ENV-READ",
       "PT-HOST-EFFECT-BROKERED"
      ]
     },
     "scope": {
      "type": "object",
      "properties": {
       "pathPrefixes": {
        "type": "array",
        "items": {
         "type": "string",
         "maxLength": 1024,
         "minLength": 1
        },
        "maxItems": 256,
        "minItems": 0,
        "uniqueItems": true
       },
       "variables": {
        "type": "array",
        "items": {
         "type": "string",
         "maxLength": 256,
         "minLength": 1
        },
        "maxItems": 256,
        "minItems": 0,
        "uniqueItems": true
       },
       "programs": {
        "type": "array",
        "items": {
         "type": "string",
         "maxLength": 1024,
         "minLength": 1
        },
        "maxItems": 64,
        "minItems": 0,
        "uniqueItems": true
       },
       "endpoints": {
        "type": "array",
        "items": {
         "type": "string",
         "maxLength": 512,
         "minLength": 1
        },
        "maxItems": 64,
        "minItems": 0,
        "uniqueItems": true
       },
       "stateClass": {
        "enum": [
         "SC-CACHE",
         "SC-OPS"
        ]
       }
      },
      "required": [],
      "additionalProperties": false
     }
    },
    "required": [
     "stableId",
     "token",
     "scope"
    ],
    "additionalProperties": false
   },
   "maxItems": 1024,
   "minItems": 0
  },
  "denies": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "stableId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     },
     "token": {
      "enum": [
       "PT-FS-READ-PROJECT",
       "PT-FS-READ-COMPONENT",
       "PT-FS-WRITE-HOST-STATE",
       "PT-PROC-EXEC-DECLARED",
       "PT-NET-EGRESS",
       "PT-ENV-READ",
       "PT-HOST-EFFECT-BROKERED"
      ]
     }
    },
    "required": [
     "stableId",
     "token"
    ],
    "additionalProperties": false
   },
   "maxItems": 1024,
   "minItems": 0
  },
  "consents": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "actionClass": {
      "enum": [
       "CA-1-HOST-HEAD",
       "CA-3",
       "CA-4-HOST"
      ]
     },
     "actionSubtype": {
      "enum": [
       "SPAWN",
       "OUT_OF_ROOT_READ",
       "PATH-TRUST-STATE-REFRESH"
      ]
     },
     "resourceScope": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 1024,
       "minLength": 1
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
     },
     "endpointSet": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 512,
       "minLength": 1
      },
      "maxItems": 16,
      "minItems": 0,
      "uniqueItems": true
     },
     "checkIds": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 128,
       "minLength": 1
      },
      "maxItems": 256,
      "minItems": 0,
      "uniqueItems": true
     }
    },
    "required": [
     "actionClass",
     "actionSubtype",
     "resourceScope",
     "endpointSet",
     "checkIds"
    ],
    "additionalProperties": false
   },
   "maxItems": 256,
   "minItems": 0
  }
 },
 "required": [
  "policySchema",
  "policyScope",
  "grants",
  "denies",
  "consents"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:opensip:design:permission-policy:1",
 "title": "opensip-permission-policy.1 (pre-existing-policy carrier; closed; carries no confinement-required member)"
}
