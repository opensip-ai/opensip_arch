{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:design:ci-ownership:1",
  "type": "object",
  "properties": {
    "schemaMajor": {
      "const": 1
    },
    "baseTree": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$(?![\\s\\S])"
    },
    "headTree": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$(?![\\s\\S])"
    },
    "previousComponents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "currentComponents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "previousUnits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$(?![\\s\\S])"
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "currentUnits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$(?![\\s\\S])"
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "previousOwners": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "array",
