            },
            {
              "enum": [
                "CORE",
                "PROTOCOL",
                "SEMANTIC",
                "LOCK",
                "OFFLINE",
                "BUNDLE"
              ]
            }
          ]
        },
        "uniqueItems": true,
        "maxItems": 100000
      },
      "maxProperties": 100000
    },
    "currentOwners": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
