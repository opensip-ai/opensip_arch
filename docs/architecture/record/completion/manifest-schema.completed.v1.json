{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:completion:manifest:1",
  "$comment": "Proposed closed structural manifest schema; cross-field/path/ref/host-policy checks are mandatory separate phases. No signature or product admission claim.",
  "type": "object",
  "properties": {
    "manifestSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "kind": {
      "const": "component"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?![\\s\\S])"
    },
    "displayName": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(?![\\s\\S])"
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "role": {
      "const": "analyzer"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    },
    "declarations": {
      "type": "object",
      "properties": {
        "licenses": {
          "$ref": "#/$defs/declaration"
        },
        "sbom": {
          "$ref": "#/$defs/declaration"
        },
        "attestation": {
          "$ref": "#/$defs/declaration"
        },
        "platformQualification": {
          "$ref": "#/$defs/declaration"
        },
        "capabilityParityEvidence": {
          "$ref": "#/$defs/declaration"
        },
        "performanceBaseline": {
          "$ref": "#/$defs/declaration"
        }
      },
      "required": [
        "licenses",
        "sbom",
        "attestation",
        "platformQualification",
        "capabilityParityEvidence",
        "performanceBaseline"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "permission": {
            "enum": [
              "PT-FS-READ-PROJECT",
              "PT-FS-READ-COMPONENT",
              "PT-FS-WRITE-HOST-STATE",
              "PT-PROC-EXEC-DECLARED",
              "PT-NET-EGRESS",
              "PT-ENV-READ",
              "PT-HOST-EFFECT-BROKERED"
