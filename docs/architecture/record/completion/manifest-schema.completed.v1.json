          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "componentState": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "manifest",
        "hostCore",
        "control",
        "providerProtocol",
        "componentState"
      ],
      "additionalProperties": false
    }
