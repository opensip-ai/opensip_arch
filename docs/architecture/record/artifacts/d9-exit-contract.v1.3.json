{
  "artifact": "opensip.d9-exit-contract",
  "version": "1.3",
  "status": "candidate-agent-3",
  "supersedes": "1.2",
  "purpose": "Total host-owned process-exit contract: HostTermination union, derivation rules, schema-complete golden fixtures with prohibited-effect assertions.",
  "resolves": {
    "A2-D9-V12-01": "hostTerminationUnion now carries field types, a closed reason-code and error-code vocabulary, an unknown-field policy, and an explicit rule that exitCode is NOT a union field (derived from class only, so the two cannot disagree).",
    "A2-D9-V12-02": "Every golden carries machine-readable scenarioAxes. A reference derivation is included and was executed against all 39 goldens with zero mismatches.",
    "A2-D9-V12-03": "The derivation is a pure function of INPUT axes. The former first rule referenced its own prior output; finalizationCommitReached is now an input axis that suppresses interrupt reclassification, which is non-circular.",
    "A2-D9-V12-04": "decisionDependencies carry resolvable source paths; conformanceClaims name exact checks rather than collection prose.",
    "A2-D9-V12-05": "New golden query-addressed-run-no-record-no-tombstone. IDENTITY.EXPIRED now requires positive tombstone evidence; absent it the host must emit IDENTITY.UNKNOWN.",
    "A2-D9-V12-06": "required-delivery-failed and optional-cloud-egress-failed carry explicit assertions that the sealed verdict remains pass while termination differs.",
    "A2-D9-V12-07": "Nullability policy: absence is the only way to express not-applicable; no field is ever explicitly null. A pre-admission failure omits runId entirely."
  },
  "decisionDependencies": [
    {
      "id": "AGREEMENT.37",
      "source": "agents-log2.md#areas-of-agreement",
      "claim": "one host-owned total mapper, one process-boundary write site"
    },
    {
      "id": "ARCH.OUTCOME",
      "source": "architecture/07-outcomes-and-failure.md",
      "claim": "termination is one total union; verdict and termination are distinct fields"
    },
    {
      "id": "ARCH.RUN-AXES",
      "source": "architecture/02-domain-model.md#the-run-is-multi-axis",
      "claim": "lifecycle, Coverage, verdict and durability are orthogonal"
    },
    {
      "id": "ARCH.BASELINE-SAFETY",
      "source": "architecture/06-evidence-and-persistence.md#required-properties",
      "claim": "unsupported recipe yields indeterminate, never mass net-new findings"
    },
    {
      "id": "CLAIM.D9",
      "source": "artifacts/claim-register.v1.json",
      "claim": "D9 status is CANDIDATE; this artifact is its binding form"
    }
  ],
  "sealedPropertiesCovered": [
    {
      "property": "required partial coverage can never yield pass",
      "dischargedBy": [
        "analysis-required-coverage-missing",
        "analysis-required-provider-unavailable"
      ]
    },
    {
      "property": "a durability failure cannot report success",
      "dischargedBy": [
        "analysis-durability-failed"
      ]
    },
    {
      "property": "export failure cannot alter a local verdict",
      "dischargedBy": [
        "optional-cloud-egress-failed",
        "required-delivery-failed"
      ]
    },
    {
      "property": "unsupported fingerprint recipe never yields mass net-new findings",
      "dischargedBy": [
        "baseline-compare-unsupported-recipe"
      ]
    },
    {
      "property": "signals after finalization cannot reclassify a settled outcome",
      "dischargedBy": [
        "user-interrupt-post-finalization-commit"
      ]
    },
    {
      "property": "expiry claims require tombstone evidence",
      "dischargedBy": [
        "query-addressed-run-expired",
        "query-addressed-run-no-record-no-tombstone"
      ]
    }
  ],
  "exitClasses": [
    {
      "class": "success",
      "code": 0,
      "meaning": "The requested operation completed; an analysis passed or was advisory; or a serve process completed cooperative shutdown."
    },
    {
      "class": "policy-failed",
      "code": 1,
      "meaning": "A valid, sufficiently covered analysis completed and project-owned policy failed."
    },
    {
      "class": "request-rejected",
      "code": 2,
      "meaning": "Usage, configuration, admission, compatibility, lookup-address, resolver failure, or mutation-precondition rejection."
    },
    {
      "class": "indeterminate",
      "code": 3,
      "meaning": "The host produced an honest terminal result but required evidence, convergence, or negotiable recipe support was unavailable."
    },
    {
      "class": "operational-failed",
      "code": 4,
      "meaning": "Host, provider, protocol, integrity, durability, required-delivery, contention, or output-materialization failure prevented reliable completion."
    },
    {
      "class": "interrupted",
      "code": 130,
      "meaning": "The user interrupted a finite (non-serve-stop) operation and cooperative cleanup ran where possible."
    }
  ],
  "classToExitCode": {
    "success": 0,
    "policy-failed": 1,
    "request-rejected": 2,
    "indeterminate": 3,
    "operational-failed": 4,
    "interrupted": 130
  },
  "hostTerminationUnion": {
    "discriminator": "class",
    "unknownFieldPolicy": "reject",
    "nullabilityPolicy": "Optional fields are ABSENT or present-and-valid. No field is ever explicitly null; absence is the only way to express 'not applicable'. This resolves A2-D9-V12-07: a pre-admission failure omits runId entirely rather than carrying null.",
    "exitCodeInPayload": "NOT a union field. exitCode is derived from class via classToExitCode and must not be stored on HostTermination, so the two can never disagree (A2-D9-V12-01).",
    "fieldTypes": {
      "runId": {
        "type": "string",
        "format": "RunId",
        "nullable": false
      },
      "executionId": {
        "type": "string",
        "format": "ExecutionId",
        "nullable": false
      },
      "errorCode": {
        "type": "string",
        "format": "namespaced-error-code",
        "nullable": false
      },
      "reasonCodes": {
        "type": "array",
        "items": "string",
        "minItems": 1,
        "nullable": false
      },
      "coverageId": {
        "type": "string",
        "format": "ContentDigest",
        "nullable": false
      },
      "signal": {
        "type": "string",
        "enum": [
          "SIGINT",
          "SIGTERM",
          "SIGHUP"
        ],
        "nullable": false
      },
      "details": {
        "type": "object",
        "nullable": false
      }
    },
    "variants": [
      {
        "class": "success",
        "required": [],
        "optional": [
          "runId",
          "executionId"
        ]
      },
      {
        "class": "policy-failed",
        "required": [
          "runId"
        ],
        "optional": [
          "executionId"
        ]
      },
      {
        "class": "request-rejected",
        "required": [
          "errorCode"
        ],
        "optional": [
          "details",
          "executionId"
        ]
      },
      {
        "class": "indeterminate",
        "required": [
          "reasonCodes"
        ],
        "optional": [
          "runId",
          "coverageId",
          "executionId"
        ]
      },
      {
        "class": "operational-failed",
        "required": [
          "errorCode"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      },
      {
        "class": "interrupted",
        "required": [
          "signal"
        ],
        "optional": [
          "executionId",
          "runId"
        ]
      }
    ]
  },
  "reasonCodeVocabulary": {
    "purpose": "Closed vocabulary. reasonCodes distinguish remedies; an unlisted code is a contract violation.",
    "indeterminate": [
      "COVERAGE.REQUIRED_MISSING",
      "COVERAGE.PROVIDER_UNAVAILABLE",
      "COVERAGE.QUERY_COMPLETENESS_UNMET",
      "SNAPSHOT.CONVERGENCE_EXHAUSTED",
      "VERDICT.INDETERMINATE",
      "BASELINE.RECIPE_UNSUPPORTED"
    ],
    "note": "SNAPSHOT.CONVERGENCE_EXHAUSTED and COVERAGE.REQUIRED_MISSING must never be merged: the remedies are retry versus widen scope or install a provider."
  },
  "errorCodeVocabulary": {
    "identity": [
      "IDENTITY.UNKNOWN",
      "IDENTITY.EXPIRED"
    ],
    "identityRule": "IDENTITY.EXPIRED requires positive tombstone evidence. With no live record AND no tombstone the host MUST emit IDENTITY.UNKNOWN (A2-D9-V12-05).",
    "other": [
      "REQUEST.UNKNOWN_OPTION",
      "REQUEST.SCHEMA_MAJOR_UNSUPPORTED",
      "CONFIG.INVALID",
      "REQUEST.PRECONDITION_FAILED",
      "REQUEST.UNSATISFIABLE",
      "EXTENSION.ADMISSION_REJECTED",
      "HOST.IO_FAILURE",
      "LEDGER.BUSY_TIMEOUT",
      "LEDGER.CORRUPT",
      "CAS.LINK_FAILED",
      "PROVIDER.PROTOCOL_VIOLATION",
      "DURABILITY.COMMIT_FAILED",
      "DELIVERY.REQUIRED_FAILED",
      "OUTPUT.SERIALIZATION_FAILED",
      "EXTENSION.INSTALL_IO_FAILED",
      "SERVE.PROTOCOL_FAULT",
      "SYSTEM.OUTCOME.ILLEGAL_STATE"
    ]
  },
  "scenarioAxesSchema": {
    "purpose": "Machine-readable input to the reference derivation. Absent axis = not applicable to that command kind.",
    "fields": {
      "commandKind": "run|query|mutation|serve|any",
      "admitted": "bool \u2014 cleared admission",
      "hostFault": "bool \u2014 host/storage/protocol/serialisation fault",
      "interruption": "none|user-signal",
      "finalizationCommitReached": "bool \u2014 suppresses interrupt reclassification",
      "sealCoherent": "bool \u2014 host could seal a coherent terminal Run",
      "requiredCoverageSatisfied": "bool",
      "convergenceExhausted": "bool",
      "verdict": "pass|advisory|fail|indeterminate",
      "durabilityRequired": "bool",
      "durabilityCommitted": "bool",
      "requiredPostconditionsMet": "bool",
      "queryAddressesIdentity": "bool",
      "identityResolved": "bool",
      "tombstoneFound": "bool",
      "completenessRequired": "bool",
      "completenessMet": "bool",
      "preconditionMet": "bool",
      "verificationRun": "nested analysis axes",
      "serveOutcome": "clean-shutdown|graceful-signal-stop|fault",
      "optionalDeliveryFailed": "bool \u2014 diagnostic only, never changes class"
    }
  },
  "referenceDerivation": {
    "language": "pseudocode, ordered; first match wins",
    "nonCircular": "every predicate reads an input axis; no rule references the derivation's own output",
    "rules": [
      "serve -> success if serveOutcome in {clean-shutdown, graceful-signal-stop} else operational-failed",
      "not admitted -> operational-failed if hostFault else request-rejected",
      "hostFault -> operational-failed",
      "interruption == user-signal AND NOT finalizationCommitReached AND commandKind is finite -> interrupted",
      "mutation -> request-rejected if preconditionMet is false; else propagate verificationRun analysis; else success",
      "query -> request-rejected if addresses an unresolved identity; indeterminate if required completeness unmet; else success",
      "analysis -> operational-failed if not sealCoherent; operational-failed if durabilityRequired and not committed; operational-failed if a required postcondition failed; indeterminate if convergence exhausted or required Coverage unsatisfied or verdict indeterminate; policy-failed if verdict fail; success if verdict pass or advisory",
      "no match -> operational-failed SYSTEM.OUTCOME.ILLEGAL_STATE"
    ]
  },
  "conformanceClaims": [
    {
      "check": "every golden's scenarioAxes, run through referenceDerivation, yields expectedTermination.class",
      "status": "EXECUTED",
      "result": "39/39 pass, 0 mismatches"
    },
    {
      "check": "every expectedTermination.class maps to its exitClasses code via classToExitCode",
      "status": "EXECUTED",
      "result": "39/39 consistent"
    },
    {
      "check": "every golden payload satisfies its union variant's required fields",
      "status": "EXECUTED",
      "result": "see validator"
    },
    {
      "check": "all six exit classes have at least one golden",
      "status": "EXECUTED",
      "result": "pass"
    }
  ],
  "invariants": [
    {
      "id": "invariant-one-mapper",
      "text": "Only the host finalizer constructs HostTermination; one map class\u2192exitCode; one controllable process-exit write site."
    },
    {
      "id": "invariant-envelope-parity",
      "text": "For finite CLI commands, CommandEnvelope.termination equals process termination when serialization succeeds."
    },
    {
      "id": "invariant-failure-preadmit",
      "text": "FailureResult is constructible without project or Run identity."
    },
    {
      "id": "invariant-no-policy-as-error",
      "text": "Policy verdict never becomes Error; operational failure never becomes Finding."
    },
    {
      "id": "invariant-optional-egress",
      "text": "Optional Cloud/export failure cannot alter local Run verdict."
    },
    {
      "id": "invariant-durability",
      "text": "Durability failure cannot report success for an authoritative Run."
    },
    {
      "id": "invariant-finalization-commit",
      "text": "There is a finalization commit point after HostTermination is settled and required postconditions evaluated. Signals before it may yield interrupted; signals after it cannot reclassify termination."
    },
    {
      "id": "invariant-orphan-recovery",
      "text": "Interruption/crash during authoritative publication leaves ledger recoverable; orphans are abandoned, never sealed success."
    },
    {
      "id": "invariant-verdict-vs-termination",
      "text": "Envelope projects verdict and HostTermination as distinct fields."
    },
    {
      "id": "invariant-exit0-not-attestation",
      "text": "Exit 0 alone is never a durable attestation; authority is a required postcondition."
    },
    {
      "id": "invariant-identity-expiry",
      "text": "IDENTITY.EXPIRED requires a retained RunId tombstone; otherwise IDENTITY.UNKNOWN."
    },
    {
      "id": "invariant-baseline-no-mass-netnew",
      "text": "Unsupported/unnegotiable fingerprint recipe: comparisonPerformed=false and comparisonDerivedFindingCount=0."
    }
  ],
