+#[test]
+fn system_sources_are_refusal_only_evidence_without_custody() {
+    let run = Run::new();
+    let (s, home, githome) = scratch();
+    let project = repository(&home, &githome);
+    let env = vars(&[("HOME", home.to_str().unwrap())]);
+    let system = s.0.join("system");
+    mkdir(&system);
+    // Absent: the leaf, an intermediate component, and a dangling link
+    // (`ENOENT` anywhere on the path).
+    let leaf = system.join("gitconfig");
+    let component = system.join("missing/etc/gitconfig");
+    let dangling = system.join("dangling");
+    std::os::unix::fs::symlink(system.join("nowhere"), &dangling).unwrap();
+    let observed = run.observe(&home, &project, &env, &[&leaf, &component, &dangling]).unwrap();
+    assert!(is_absent(&observed, &leaf) && is_absent(&observed, &component) && is_absent(&observed, &dangling));
+    // Present: read and parsed with no custody judged, so a file anyone can
+    // write is still read; its bytes are the evidence.
+    let body = b"[credential]\n\thelper = osxkeychain\n[init]\n\tdefaultBranch = main\n";
+    write(&leaf, body);
+    fs::set_permissions(&leaf, fs::Permissions::from_mode(0o666)).unwrap();
+    let observed = run.observe(&home, &project, &env, &[&leaf]).unwrap();
+    assert_eq!(read_bytes(&observed, &leaf), Some(&body[..]));
+    // Symbolic links are followed, at the leaf and on the path (as `/etc`
+    // is on macOS).
+    let linked_leaf = system.join("linked-leaf");
+    std::os::unix::fs::symlink(&leaf, &linked_leaf).unwrap();
+    let real = system.join("private/etc");
+    mkdir(&real);
+    write(&real.join("gitconfig"), body);
+    std::os::unix::fs::symlink("private/etc", system.join("etc")).unwrap();
+    let through = system.join("etc/gitconfig");
+    let observed = run.observe(&home, &project, &env, &[&linked_leaf, &through]).unwrap();
+    assert_eq!(read_bytes(&observed, &linked_leaf), Some(&body[..]));
+    assert_eq!(read_bytes(&observed, &through), Some(&body[..]));
+    // Exactly the cap is read; one byte over refuses.
+    let mut capped = b"[core]\n".to_vec();
+    capped.resize(CONFIG_CAP - 1, b'#');
+    capped.push(b'\n');
+    write(&leaf, &capped);
+    assert!(run.observe(&home, &project, &env, &[&leaf]).is_ok());
+    capped.insert(0, b'\n');
+    write(&leaf, &capped);
+    assert_eq!(reason(run.observe(&home, &project, &env, &[&leaf])), "config-oversized");
+    // The closed parse and its refusals apply as to every source.
+    for (text, expected) in [
+        ("[core]\n\tworktree = /x\n", "config-worktree"),
+        ("[core]\n\tbare = true\n", "config-bare"),
+        ("[include]\n\tpath = /x\n", "config-include"),
+        ("[extensions]\n\tobjectFormat = sha256\n", "config-extensions"),
+        ("[core]\n\tprecomposeUnicode = false\n", "config-precompose"),
+        ("[a.b]\n", "config-syntax"),
+    ] {
+        write(&leaf, text.as_bytes());
+        assert_eq!(refused(text), expected, "{text:?}");
+        assert_eq!(reason(run.observe(&home, &project, &env, &[&leaf])), expected, "{text:?}");
+    }
+    // A directory or a FIFO (opened without waiting) is not regular.
+    let fifo = system.join("fifo");
+    assert!(Command::new("/usr/bin/mkfifo").arg(&fifo).env_clear().status().unwrap().success());
+    assert_eq!(reason(run.observe(&home, &project, &env, &[&system])), "system-source-not-regular");
+    assert_eq!(reason(run.observe(&home, &project, &env, &[&fifo])), "system-source-not-regular");
+    // Unreadable: permission, and a path through a regular file.
+    write(&leaf, body);
+    fs::set_permissions(&leaf, fs::Permissions::from_mode(0o000)).unwrap();
+    if fs::read(&leaf).is_err() {
+        assert_eq!(reason(run.observe(&home, &project, &env, &[&leaf])), "system-source-unreadable");
+    }
+    fs::set_permissions(&leaf, fs::Permissions::from_mode(0o644)).unwrap();
+    assert_eq!(reason(run.observe(&home, &project, &env, &[&leaf.join("below")])), "system-source-unreadable");
+}
