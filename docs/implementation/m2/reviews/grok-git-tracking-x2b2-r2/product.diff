+// ------------------------------------------------------- real git, scratch
+
+struct Scratch(PathBuf);
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = Command::new("/bin/chmod").args(["-R", "-N"]).arg(&self.0).stderr(std::process::Stdio::null()).status();
+        let _ = Command::new("/bin/chmod").args(["-R", "u+rwX"]).arg(&self.0).stderr(std::process::Stdio::null()).status();
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+/// A scratch root holding a 0700 `home` (H) and a separate `githome`, the
+/// HOME git runs with, so git never reads or writes H's global config.
+fn scratch() -> (Scratch, PathBuf, PathBuf) {
+    let nonce: String = opensip_platform::request_entropy().unwrap().iter().map(|b| format!("{b:02x}")).collect();
+    let root = crate::test_scratch::temp_dir().join(format!("opensip-x2b2-{nonce}"));
+    fs::create_dir(&root).unwrap();
+    fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+    let root = fs::canonicalize(&root).unwrap();
+    let home = root.join("home");
+    fs::create_dir(&home).unwrap();
+    fs::set_permissions(&home, fs::Permissions::from_mode(0o700)).unwrap();
+    let githome = root.join("githome");
+    fs::create_dir(&githome).unwrap();
+    (Scratch(root), home, githome)
+}
+fn git(githome: &Path, directory: &Path, args: &[&str]) -> String {
+    let output = Command::new("/usr/bin/git")
+        .args(["-c", "user.name=t", "-c", "user.email=t@example.invalid", "-c", "init.defaultBranch=main", "-c", "core.hooksPath=/dev/null"])
+        .args(args)
+        .current_dir(directory)
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", githome)
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "git {args:?}: {}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout).unwrap()
+}
+fn mkdir(path: &Path) {
+    fs::create_dir_all(path).unwrap();
+}
+fn write(path: &Path, bytes: &[u8]) {
+    fs::write(path, bytes).unwrap();
+}
+fn uid() -> u32 {
+    fs::metadata(crate::test_scratch::temp_dir()).unwrap().uid()
+}
+fn premise() -> AclOmissionPremise {
+    let flag = Box::leak(Box::new(AtomicBool::new(false)));
+    let attempt = InitialInstallationAttempt::for_tests(flag, None).unwrap();
+    AclOmissionPremise::for_tests(&attempt, &[b"apfs"])
+}
+fn any_volume(_: &DescriptorFilesystem) -> bool {
+    true
+}
+fn no_volume(_: &DescriptorFilesystem) -> bool {
+    false
+}
+
+/// One observation of `root` under `home` with the test premise, a clean
+/// environment and the given system sources.
+struct Run {
+    premise: AclOmissionPremise,
+    volume: fn(&DescriptorFilesystem) -> bool,
+}
+impl Run {
+    fn new() -> Self {
+        Self { premise: premise(), volume: any_volume }
+    }
+    fn observe(&self, home: &Path, root: &Path, environment: &[(OsString, OsString)], system: &[&Path]) -> Result<TrackingObservation, Failure> {
+        let groups = BTreeSet::new();
+        let volume = self.volume;
+        let policy = ProjectChainPolicy::new(Some(&self.premise), &volume, &groups);
+        let mut ledger = WorkLedger::new();
+        ledger.scope(|work| {
+            let chain = walk_project_chain(home, root, uid(), &policy, work)
+                .map_err(|_| WorkFailure::Operation(TrackingRefusal::VcsUnsupported("chain")))?;
+            let inputs = TrackingInputs { chain: &chain, uid: uid(), policy: &policy, home, environment, system_sources: system };
+            observe_tracking(&inputs, work)
+        })
+    }
+    fn clean(&self, home: &Path, root: &Path) -> Result<TrackingObservation, Failure> {
+        self.observe(home, root, &vars(&[("HOME", home.to_str().unwrap())]), &[])
+    }
+}
+fn reason(result: Result<TrackingObservation, Failure>) -> &'static str {
+    match result {
+        Err(WorkFailure::Operation(TrackingRefusal::VcsUnsupported(reason))) => reason,
+        Err(WorkFailure::Operation(TrackingRefusal::MarkerTracked)) => "marker-tracked",
+        other => panic!("expected a refusal, got {other:?}"),
+    }
+}
+/// `home/code/project` holding a repository with one committed file and
+/// the marker present but untracked.
+fn repository(home: &Path, githome: &Path) -> PathBuf {
+    let project = home.join("code/project");
+    mkdir(&project);
+    git(githome, &project, &["init", "-q"]);
+    write(&project.join("README"), b"x\n");
+    git(githome, &project, &["add", "README"]);
+    git(githome, &project, &["commit", "-q", "-m", "init"]);
+    mkdir(&project.join(".opensip"));
+    write(&project.join(".opensip/project-id.v1"), b"marker\n");
+    project
+}
