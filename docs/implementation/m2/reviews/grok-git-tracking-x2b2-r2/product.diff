+#[test]
+fn system_sources_are_rechecked_by_re_reading() {
+    let (s, home, githome) = scratch();
+    let project = repository(&home, &githome);
+    let premise = premise();
+    let groups = BTreeSet::new();
+    let volume = any_volume;
+    let policy = ProjectChainPolicy::new(Some(&premise), &volume, &groups);
+    let env = vars(&[("HOME", home.to_str().unwrap())]);
+    let source = s.0.join("gitconfig");
+    let sources = [source.as_path()];
+    let chain = WorkLedger::new().scope(|work| walk_project_chain(&home, &project, uid(), &policy, work)).unwrap();
+    let inputs = TrackingInputs { chain: &chain, uid: uid(), policy: &policy, home: &home, environment: &env, system_sources: &sources };
+    // Each pass on a fresh ledger: a refusal closes the ledger it ran on.
+    let observe = || WorkLedger::new().scope(|work| observe_tracking(&inputs, work)).unwrap();
+    let recheck = |observed: &TrackingObservation| WorkLedger::new().scope(|work| recheck_tracking(observed, &inputs, work));
+    let changed = |observed: &TrackingObservation| {
+        matches!(recheck(observed), Err(WorkFailure::Operation(TrackingRefusal::VcsUnsupported("evidence-changed"))))
+    };
+    // The same absence rechecks; a source that appears is a change.
+    let absent = observe();
+    assert!(recheck(&absent).is_ok());
+    write(&source, b"[init]\n\tdefaultBranch = main\n");
+    assert!(changed(&absent));
+    // The same bytes recheck, even rewritten as a new file (no metadata is
+    // compared); other bytes, or removal, are a change.
+    let present = observe();
+    fs::remove_file(&source).unwrap();
+    write(&source, b"[init]\n\tdefaultBranch = main\n");
+    assert!(recheck(&present).is_ok());
+    write(&source, b"[init]\n\tdefaultBranch = trunk\n");
+    assert!(changed(&present));
+    fs::remove_file(&source).unwrap();
+    assert!(changed(&present));
+    // The read is charged: a ledger that covers the pass without the
+    // source's bytes refuses on the budget.
+    write(&source, &vec![b'#'; 4096]);
+    let mut full = WorkLedger::new();
+    full.scope(|work| observe_tracking(&inputs, work)).unwrap();
+    let with = full.used();
+    let none = TrackingInputs { system_sources: &[], ..inputs };
+    let mut probe = WorkLedger::new();
+    probe.scope(|work| observe_tracking(&none, work)).unwrap();
+    let without = probe.used();
+    assert!(with.bytes >= without.bytes + 4096);
+    let mut short = WorkLedger::with_limits(WorkCost { objects: with.objects, edges: with.edges, bytes: without.bytes + 4095 }).unwrap();
+    assert!(matches!(short.scope(|work| observe_tracking(&inputs, work)), Err(WorkFailure::Budget(_))));
+}
