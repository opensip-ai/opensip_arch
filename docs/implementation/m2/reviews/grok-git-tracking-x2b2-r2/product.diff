+#[test]
+fn real_git_indexes_of_every_version_decode_exactly() {
+    let (_s, home, githome) = scratch();
+    let project = repository(&home, &githome);
+    for i in 0..40 {
+        let dir = project.join(format!("dir{i:02}/nested/deeper"));
+        mkdir(&dir);
+        write(&dir.join("file.rs"), format!("{i}\n").as_bytes());
+    }
+    git(&githome, &project, &["add", "-A"]);
+    // An intent-to-add entry carries the extended flag (versions 3 and 4).
+    write(&project.join("later.txt"), b"later\n");
+    git(&githome, &project, &["add", "-N", "later.txt"]);
+    for version in ["2", "3", "4"] {
+        if version == "2" {
+            // Version 2 cannot hold the extended flag; git refuses to write it.
+            git(&githome, &project, &["rm", "-q", "--cached", "later.txt"]);
+        }
+        git(&githome, &project, &["update-index", "--index-version", version]);
+        let raw = fs::read(project.join(".git/index")).unwrap();
+        assert_eq!(u32::from_be_bytes(raw[4..8].try_into().unwrap()), version.parse().unwrap());
+        let decoded = decode_index(&raw).unwrap();
+        let listed: Vec<String> = git(&githome, &project, &["ls-files", "-s", "-z"])
+            .split('\0')
+            .filter(|l| !l.is_empty())
+            .map(|l| l.split_once('\t').unwrap().1.to_owned())
+            .collect();
+        assert_eq!(paths(&decoded), listed, "v{version}");
+        if version == "2" {
+            git(&githome, &project, &["add", "-N", "later.txt"]);
+        }
+    }
+}
