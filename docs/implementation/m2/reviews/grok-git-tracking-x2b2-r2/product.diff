+/// Work `open_fixed_regular_following` performs for `path`: the
+/// NUL-terminated path, one `open`, and one kind-check status read. Callers
+/// charge this before calling it.
+#[cfg(target_os = "macos")]
+pub fn open_fixed_regular_following_cost(path: &std::path::Path) -> crate::WorkCost {
+    let status = path_binding::status_read_cost();
+    crate::WorkCost {
+        objects: 1,
+        edges: 1usize.saturating_add(status.edges),
+        bytes: path
+            .as_os_str()
+            .len()
+            .saturating_add(1)
+            .saturating_add(status.bytes),
+    }
+}
+/// Open a fixed absolute path for reading, following symbolic links, and
+/// require a regular file. `O_NONBLOCK` avoids waiting on a FIFO, which is
+/// then refused as not regular. This proves nothing about the path's
+/// custody or the file's owner: it is for evidence that can only refuse.
+#[cfg(target_os = "macos")]
+pub fn open_fixed_regular_following(path: &std::path::Path) -> io::Result<File> {
+    use std::os::unix::ffi::OsStrExt;
+    let raw = path.as_os_str().as_bytes();
+    if !raw.starts_with(b"/") {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "path is not absolute",
+        ));
+    }
+    let name = CString::new(raw).map_err(|_| io::ErrorKind::InvalidInput)?;
+    // SAFETY: name is NUL-terminated; open retains its own descriptor. No
+    // create flag is present, so no mode is required.
+    let fd = unsafe {
+        libc::open(
+            name.as_ptr(),
+            libc::O_RDONLY | libc::O_CLOEXEC | libc::O_NONBLOCK,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful open returns one new owned descriptor. File closes
+    // it exactly once, including the error path below.
+    let opened = unsafe { File::from_raw_fd(fd) };
+    if !opened.metadata()?.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "entry is not a regular file",
+        ));
+    }
+    Ok(opened)
+}
