+fn the_recheck_sees_changed_evidence_and_the_pass_is_charged() {
+    let (_s, home, githome) = scratch();
+    let project = repository(&home, &githome);
+    let premise = premise();
+    let groups = BTreeSet::new();
+    let volume = any_volume;
+    let policy = ProjectChainPolicy::new(Some(&premise), &volume, &groups);
+    let env = vars(&[("HOME", home.to_str().unwrap())]);
+    let mut ledger = WorkLedger::new();
+    let chain = ledger.scope(|work| walk_project_chain(&home, &project, uid(), &policy, work)).unwrap();
+    let inputs = TrackingInputs { chain: &chain, uid: uid(), policy: &policy, home: &home, environment: &env, system_sources: &[] };
+    let before = ledger.used();
+    let observed = ledger.scope(|work| observe_tracking(&inputs, work)).unwrap();
+    let pass = ledger.used();
+    assert!(pass.edges > before.edges && pass.objects > before.objects);
+    assert!(ledger.scope(|work| recheck_tracking(&observed, &inputs, work)).is_ok());
+    // A new file staged rewrites the index: the recheck refuses.
+    write(&project.join("new.txt"), b"n\n");
+    git(&githome, &project, &["add", "new.txt"]);
+    assert!(matches!(
+        ledger.scope(|work| recheck_tracking(&observed, &inputs, work)),
+        Err(WorkFailure::Operation(TrackingRefusal::VcsUnsupported("evidence-changed")))
+    ));
+    // A short ledger refuses on the budget.
+    let used = pass;
+    let mut short = WorkLedger::with_limits(WorkCost { objects: used.objects - before.objects, edges: (used.edges - before.edges) / 2, bytes: used.bytes }).unwrap();
+    assert!(matches!(short.scope(|work| observe_tracking(&inputs, work)), Err(WorkFailure::Budget(_))));
+}
