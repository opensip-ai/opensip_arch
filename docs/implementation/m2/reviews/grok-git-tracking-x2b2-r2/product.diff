+#[test]
+fn every_index_refusal() {
+    let good = Synthetic::new(2).entry("a", 0o100644, false).entry("b", 0o100644, false).bytes();
+    // Checksum.
+    let mut flipped = good.clone();
+    flipped[12 + 30] ^= 1;
+    assert_eq!(decode_index(&flipped), Err("index-checksum"));
+    // Signature, version.
+    let mut body = good[..good.len() - 20].to_vec();
+    body[0] = b'X';
+    assert_eq!(decode_index(&seal(body)), Err("index-malformed"));
+    for version in [1u32, 5] {
+        let mut body = good[..good.len() - 20].to_vec();
+        body[4..8].copy_from_slice(&version.to_be_bytes());
+        assert_eq!(decode_index(&seal(body)), Err("index-version"));
+    }
+    // Version 2 with the extended flag.
+    let mut v2ext = Synthetic::new(3).entry("a", 0o100644, true).body();
+    v2ext[4..8].copy_from_slice(&2u32.to_be_bytes());
+    assert_eq!(decode_index(&seal(v2ext)), Err("index-extended-flags"));
+    // Name length mismatch.
+    let mut named = Synthetic::new(2).entry("abc", 0o100644, false).body();
+    named[12 + 61] = 2;
+    assert_eq!(decode_index(&seal(named)), Err("index-name-length"));
+    // Nonzero padding.
+    let mut padded = Synthetic::new(2).entry("abc", 0o100644, false).body();
+    let last = padded.len() - 1;
+    padded[last] = 1;
+    assert_eq!(decode_index(&seal(padded)), Err("index-malformed"));
+    // Version 4 strip longer than the previous path (first entry: empty).
+    let mut v4 = Synthetic::new(4).entry("a", 0o100644, false).body();
+    v4[12 + 62] = 5;
+    assert_eq!(decode_index(&seal(v4)), Err("index-prefix"));
+    // Count larger than the entries, and trailing bytes that are not an extension.
+    let mut counted = good[..good.len() - 20].to_vec();
+    counted[8..12].copy_from_slice(&3u32.to_be_bytes());
+    assert!(decode_index(&seal(counted)).is_err());
+    let mut trailing = good[..good.len() - 20].to_vec();
+    trailing.extend_from_slice(b"TREE");
+    assert_eq!(decode_index(&seal(trailing)), Err("index-malformed"));
+    let mut short_ext = good[..good.len() - 20].to_vec();
+    short_ext.extend_from_slice(b"TREE\0\0\0\x09ab");
+    assert_eq!(decode_index(&seal(short_ext)), Err("index-malformed"));
+    assert_eq!(decode_index(b"DIRC"), Err("index-malformed"));
+}
