+/// The `Read` evidence for `source`, if the pass read it.
+fn read_bytes<'a>(observed: &'a TrackingObservation, source: &Path) -> Option<&'a [u8]> {
+    observed.evidence().iter().find_map(|sample| match sample {
+        Sample::Read(label, raw) if label.as_slice() == source.as_os_str().as_bytes() => Some(raw.as_slice()),
+        _ => None,
+    })
+}
+fn is_absent(observed: &TrackingObservation, source: &Path) -> bool {
+    observed
+        .evidence()
+        .iter()
+        .any(|sample| matches!(sample, Sample::Absent(label) if label.as_slice() == source.as_os_str().as_bytes()))
+}
