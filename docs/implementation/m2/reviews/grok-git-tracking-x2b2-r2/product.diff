+// --------------------------------------------------- a synthetic index
+
+struct Synthetic {
+    version: u32,
+    entries: Vec<(Vec<u8>, u32, bool)>,
+    extensions: Vec<([u8; 4], Vec<u8>)>,
+}
+impl Synthetic {
+    fn new(version: u32) -> Self {
+        Self { version, entries: Vec::new(), extensions: Vec::new() }
+    }
+    fn entry(mut self, path: &str, mode: u32, extended: bool) -> Self {
+        self.entries.push((path.as_bytes().to_vec(), mode, extended));
+        self
+    }
+    fn extension(mut self, sig: &[u8; 4], body: &[u8]) -> Self {
+        self.extensions.push((*sig, body.to_vec()));
+        self
+    }
+    /// The bytes before the checksum.
+    fn body(&self) -> Vec<u8> {
+        let mut out = b"DIRC".to_vec();
+        out.extend_from_slice(&self.version.to_be_bytes());
+        out.extend_from_slice(&(self.entries.len() as u32).to_be_bytes());
+        let mut previous: Vec<u8> = Vec::new();
+        for (path, mode, extended) in &self.entries {
+            let start = out.len();
+            out.extend_from_slice(&[0; 24]);
+            out.extend_from_slice(&mode.to_be_bytes());
+            out.extend_from_slice(&[0; 12]);
+            out.extend_from_slice(&[0x11; 20]);
+            let mut flags = path.len().min(0xFFF) as u16;
+            if *extended {
+                flags |= 0x4000;
+            }
+            out.extend_from_slice(&flags.to_be_bytes());
+            if *extended {
+                out.extend_from_slice(&0x4000u16.to_be_bytes());
+            }
+            if self.version == 4 {
+                let common = previous.iter().zip(path).take_while(|(a, b)| a == b).count();
+                out.extend_from_slice(&encode_varint(previous.len() - common));
+                out.extend_from_slice(&path[common..]);
+                out.push(0);
+            } else {
+                out.extend_from_slice(path);
+                let pad = 8 - ((out.len() - start) % 8);
+                out.extend(std::iter::repeat_n(0, pad));
+            }
+            previous.clone_from(path);
+        }
+        for (sig, body) in &self.extensions {
+            out.extend_from_slice(sig);
+            out.extend_from_slice(&(body.len() as u32).to_be_bytes());
+            out.extend_from_slice(body);
+        }
+        out
+    }
+    fn bytes(&self) -> Vec<u8> {
+        seal(self.body())
+    }
+}
+fn seal(mut body: Vec<u8>) -> Vec<u8> {
+    let sum = sha1(&body);
+    body.extend_from_slice(&sum);
+    body
+}
+fn encode_varint(mut value: usize) -> Vec<u8> {
+    let mut bytes = vec![(value & 0x7f) as u8];
+    value >>= 7;
+    while value != 0 {
+        value -= 1;
+        bytes.push(0x80 | (value & 0x7f) as u8);
+        value >>= 7;
+    }
+    bytes.reverse();
+    bytes
+}
+fn paths(entries: &[IndexEntry]) -> Vec<String> {
+    entries.iter().map(|e| String::from_utf8(e.path.clone()).unwrap()).collect()
+}
+
+#[test]
+fn every_index_version_decodes_exactly() {
+    let names = ["a", "abc/def", "abc/deg", "abcdefghij", "z/.opensip/project-id.v1"];
+    for version in [2, 3, 4] {
+        let mut index = Synthetic::new(version);
+        for (i, name) in names.iter().enumerate() {
+            index = index.entry(name, 0o100644, version >= 3 && i % 2 == 0);
+        }
+        let decoded = decode_index(&index.bytes()).unwrap();
+        assert_eq!(paths(&decoded), names, "v{version}");
+    }
+    // Varint offsets above one byte, and a 0xFFF-long path.
+    let long = "d/".repeat(200) + "x";
+    let longest = "p".repeat(5000);
+    for version in [2, 3, 4] {
+        let index = Synthetic::new(version)
+            .entry(&long, 0o100644, false)
+            .entry("e", 0o100644, false)
+            .entry(&longest, 0o100644, false);
+        assert_eq!(paths(&decode_index(&index.bytes()).unwrap()), [long.clone(), "e".into(), longest.clone()]);
+    }
+    for (value, bytes) in [(0, vec![0]), (127, vec![0x7f]), (128, vec![0x80, 0x00]), (300, vec![0x81, 0x2c]), (16511, vec![0xff, 0x7f]), (16512, vec![0x80, 0x80, 0x00])] {
+        assert_eq!(encode_varint(value), bytes);
+        assert_eq!(varint(&bytes), Some((value, bytes.len())));
+    }
+}
