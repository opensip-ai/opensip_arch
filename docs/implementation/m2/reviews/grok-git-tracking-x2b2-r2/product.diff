+// Law X2 r7 item 6a (unit X2b-2). Pure tests of the closed config parse,
+// the environment refusal, SHA-1, the index decoder and the marker match;
+// index decoding cross-checked against real `git` output; and native
+// observations on scratch homes holding scratch Git repositories built with
+// real `git` commands. Git runs with a cleared environment, a scratch HOME
+// that is not the tested H, and no system config, so it reads and writes
+// nothing outside its scratch repository. Nothing here touches a real
+// repository. Probes of fixed system paths are read-only.
+use super::*;
+use crate::custody::project_chain::walk_project_chain;
+use crate::initial_installation::InitialInstallationAttempt;
+use crate::trust::AclOmissionPremise;
+use opensip_platform::WorkLedger;
+use std::collections::BTreeSet;
+use std::fs;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::PathBuf;
+use std::process::Command;
+use std::sync::atomic::AtomicBool;
+
+// ------------------------------------------------------------------- SHA-1
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+#[test]
+fn sha1_matches_the_fips_vectors() {
+    assert_eq!(hex(&sha1(b"")), "da39a3ee5e6b4b0d3255bfef95601890afd80709");
+    assert_eq!(hex(&sha1(b"abc")), "a9993e364706816aba3e25717850c26c9cd0d89d");
+    assert_eq!(
+        hex(&sha1(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
+        "84983e441c3bd26ebaae4aa1f95129e5e54670f1"
+    );
+    assert_eq!(
+        hex(&sha1(&vec![b'a'; 1_000_000])),
+        "34aa973cd4c4daa4f61eeb2bdbad27316534016f"
+    );
+}
+
+// -------------------------------------------------------- the config parse
+
+fn ok(text: &str) -> Vec<ConfigEntry> {
+    parse_config(text.as_bytes()).unwrap()
