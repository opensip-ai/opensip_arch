+#[test]
+fn every_refusal_names_its_item_8_row() {
+    use RegistrationRow as Row;
+    assert_eq!(
+        NamespaceRefusal::NotEligible(Classification::OneSided).row(),
+        Row::RootCustody("identity-recovery-required")
+    );
+    assert_eq!(
+        NamespaceRefusal::NotEligible(Classification::RecoveryNeeded {
+            namespace: "n".into(),
+            project: "p".into()
+        })
+        .row(),
+        Row::RootCustody("identity-recovery-required")
+    );
+    assert_eq!(
+        NamespaceRefusal::NotEligible(Classification::Contradiction).row(),
+        Row::RootCustody("identity-contradiction")
+    );
+    assert_eq!(
+        NamespaceRefusal::NotEligible(Classification::FirstUseCandidate).row(),
+        Row::Invariant
+    );
+    assert_eq!(NamespaceRefusal::Busy(WRITER_LEASE).row(), Row::Busy);
+    assert_eq!(
+        NamespaceRefusal::Missing(Owner::Namespace, READERS_LEASE).row(),
+        Row::Incomplete
+    );
+    assert_eq!(
+        NamespaceRefusal::Owner(RegistrationRefusal::Custody(Owner::Namespace, "private")).row(),
+        Row::InstallationCustody("private")
+    );
+    assert_eq!(
+        NamespaceRefusal::Owner(RegistrationRefusal::Changed(Owner::Namespace)).row(),
+        Row::Admission(super::super::project_admission::ProjectAdmissionRow::RequiredFilesChanged)
+    );
+    assert_eq!(
+        NamespaceRefusal::Invariant("active-row").row(),
+        Row::Invariant
+    );
+    assert_eq!(WriterLease::AppendWrite.mode(), LeaseMode::AppendWrite);
+    assert_eq!(WriterLease::Exclusive.mode(), LeaseMode::Exclusive);
