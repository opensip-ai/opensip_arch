+#[test]
+fn a_busy_carrier_is_the_busy_row_and_no_lock_outlives_it() {
+    let (fixture, project, n) = eligible("x2d-busy");
+    let namespace = namespace_path(&fixture, &n);
+
+    // EXCLUSIVE with a reader present: `writer.lease` is taken, then
+    // `readers.lease` refuses; the writer lock is released before return,
+    // while the fence is still held.
+    let reader = hold(&namespace.join(READERS_LEASE), LockMode::Shared);
+    let (mut writer, _trees) = self::writer(&fixture, "x2d-busy-exclusive");
+    let subject = admitted(&mut writer, &project);
+    let target = writer.admit_namespace(subject, &inputs()).unwrap();
+    assert_eq!(
+        writer_row(target.lease_writer(WriterLease::Exclusive, &inputs())),
+        ProjectWriteRow::Project(RegistrationRow::Busy)
+    );
+    assert!(free(&namespace.join(WRITER_LEASE), LockMode::Exclusive));
+    assert!(!fence_free(&fixture));
+    // The refusal spent the gate: no retry under this fence.
+    assert!(matches!(
+        writer.admit_project_root(&project, None, NO_GROUPS),
+        Err(ProjectWriteRefusal::Latched)
+    ));
+    writer.release().unwrap();
+    drop(reader);
+
+    // APPEND-WRITE with another writer present.
+    let other = hold(&namespace.join(WRITER_LEASE), LockMode::Exclusive);
+    let (mut writer, _trees) = self::writer(&fixture, "x2d-busy-append");
+    let subject = admitted(&mut writer, &project);
+    let target = writer.admit_namespace(subject, &inputs()).unwrap();
+    assert_eq!(
+        writer_row(target.lease_writer(WriterLease::AppendWrite, &inputs())),
+        ProjectWriteRow::Project(RegistrationRow::Busy)
+    );
+    assert!(free(&namespace.join(READERS_LEASE), LockMode::Exclusive));
+    assert!(!fence_free(&fixture));
+    writer.release().unwrap();
+    drop(other);
+
+    // SHARED-READ with an EXCLUSIVE holder present; the session latches.
+    let exclusive = hold(&namespace.join(READERS_LEASE), LockMode::Exclusive);
+    let session = fixture.session(None).unwrap();
+    let (admission, tracking) = session_subject(&session, &project);
+    let target = session
+        .admit_namespace(admission, tracking, &inputs())
+        .unwrap();
+    assert_eq!(
+        session_row(target.lease_shared(&inputs())),
+        RegistrationRow::Busy
+    );
+    assert!(session.is_latched());
+    assert!(free(&namespace.join(WRITER_LEASE), LockMode::Exclusive));
+    drop(session);
+    drop(exclusive);
+    assert!(unlocked(&fixture, &n));
+}
