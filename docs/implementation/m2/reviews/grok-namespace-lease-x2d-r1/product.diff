+// Law X2 r8 item 7 (unit X2d), on scratch homes only. Each test publishes a
+// real P0 under a scratch H (`installation_read_fixture`), registers a
+// scratch project under that H with an ordinary writer over 462's signed
+// test trees (unit X2c), and then admits its namespace and takes a lease on
+// a writer's gate or a read session. Other holders are simulated by
+// nonblocking `flock`s on separate descriptors of the same carriers, which
+// conflict exactly as another process's would. Tracking reads an empty
+// environment and no system sources. Nothing here opens the real account's
+// I or runs Git.
+use super::super::first_registration::{
+    ProjectWriteRefusal, ProjectWriteRow, RegisteredProject, Seam,
+};
+use super::super::installation_admission::{DurableWriteGate, GateSeam, HomeSource};
+use super::super::installation_read::{NamespaceSessionRefusal, ReadSession};
+use super::super::installation_read_fixture::{ReadFixture, private};
+use super::super::ordinary_writer::{OrdinaryWriteAdmission, admit_with};
+use super::super::project_admission::{MARKER_DIRECTORY, REGISTRY};
+use super::super::read_premise::{Write, WritePlatformReceipt, produce_for};
+use super::*;
+use crate::initial_installation::InitialInstallationAttempt;
+use crate::trust::{ReadProducers, read_producers};
+use std::collections::BTreeSet;
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicBool;
+
+// ---------------------------------------------------------------- helpers
+
+fn directory(path: &Path, mode: u32) {
+    fs::create_dir(path).unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(mode)).unwrap();
+}
+/// A project under the fixture's H, 0755 with no ACL, as on a stock Mac.
+fn fixture_project(fixture: &ReadFixture) -> PathBuf {
+    let code = fixture.home.join("code");
+    directory(&code, 0o755);
+    let project = code.join("project");
+    directory(&project, 0o755);
+    project
+}
+/// An ordinary writer on the fixture's I, and the signed trees it needs.
+fn writer(fixture: &ReadFixture, tag: &str) -> (OrdinaryWriteAdmission, ReadProducers) {
+    let producers = read_producers(&format!("{tag}-write"), true, Some(&fixture.home));
+    let receipt = produce_for::<Write>(
+        InitialInstallationAttempt::for_tests(&AtomicBool::new(false), None),
+        InitialInstallationAttempt::observe_actor,
+        |attempt| producers.core(attempt),
+        |attempt, actor, core| producers.platform(attempt, actor, core),
+    )
+    .unwrap();
+    let admission = admit_with(
+        receipt,
+        WritePlatformReceipt::recheck,
+        || DurableWriteGate::for_tests(&AtomicBool::new(false), None),
+        |gate, receipt| {
+            gate.admit_with(
+                receipt.qualification(),
+                HomeSource::Fixture(&fixture.home),
+                &GateSeam::live(),
+            )
+        },
+    )
+    .unwrap();
+    (admission, producers)
+}
+const NO_GROUPS: &BTreeSet<u32> = &BTreeSet::new();
+fn inputs() -> ProjectInputs<'static> {
+    ProjectInputs {
+        trust_groups: NO_GROUPS,
+        environment: &[],
+        system_sources: &[],
+    }
+}
+/// The root admission and its tracking observation on the writer's gate.
+fn admitted(writer: &mut OrdinaryWriteAdmission, project: &Path) -> NamespaceSubject {
+    let admission = writer.admit_project_root(project, None, NO_GROUPS).unwrap();
+    let tracking = writer
+        .observe_project_tracking_with(&admission, &inputs())
+        .unwrap();
+    NamespaceSubject::Eligible {
+        admission,
+        tracking,
+    }
+}
+/// A first registration of `project` on the writer's gate (unit X2c).
+fn register(writer: &mut OrdinaryWriteAdmission, project: &Path) -> RegisteredProject {
+    let NamespaceSubject::Eligible {
+        admission,
+        tracking,
+    } = admitted(writer, project)
+    else {
+        unreachable!()
+    };
+    writer
+        .register_first_use_with(admission, tracking, &inputs(), &Seam::live())
+        .unwrap()
+}
+/// A fixture whose project is registered (ACTIVE, marker, namespace) by a
+/// writer that has since released its fence: the project is Eligible.
+fn eligible(tag: &str) -> (ReadFixture, PathBuf, String) {
+    let fixture = ReadFixture::new(tag);
+    let project = fixture_project(&fixture);
+    let (mut writer, _trees) = writer(&fixture, &format!("{tag}-register"));
+    let registered = register(&mut writer, &project);
+    let n = registered.namespace_id().to_owned();
+    drop(registered);
+    writer.release().unwrap();
+    (fixture, project, n)
+}
+/// The Eligible root's admission and tracking on a read session.
+fn session_subject(
+    session: &ReadSession,
+    project: &Path,
+) -> (ProjectRootAdmission, TrackingObservation) {
+    let admission = session
+        .admit_project_root(project, None, NO_GROUPS)
+        .unwrap();
+    let tracking = session
+        .observe_project_tracking_with(&admission, NO_GROUPS, &[], &[])
+        .unwrap();
+    (admission, tracking)
+}
+fn namespace_path(fixture: &ReadFixture, n: &str) -> PathBuf {
+    fixture.installation.join(HOST).join(PROJECTS).join(n)
+}
+/// Whether another holder could take `mode` on the carrier at `path` now:
+/// one nonblocking `flock` on a fresh descriptor, released at once.
+fn free(path: &Path, mode: LockMode) -> bool {
+    FileLock::try_acquire(File::open(path).unwrap(), mode)
+        .unwrap()
+        .is_some()
+}
+/// Another holder's lock on the carrier at `path`.
+fn hold(path: &Path, mode: LockMode) -> FileLock {
+    FileLock::try_acquire(File::open(path).unwrap(), mode)
+        .unwrap()
+        .unwrap()
+}
+/// Whether the installation fence is free (no holder in any process).
+fn fence_free(fixture: &ReadFixture) -> bool {
+    free(
+        &fixture.installation.join("lifecycle.fence"),
+        LockMode::Exclusive,
+    )
+}
+/// Neither carrier of N is locked by anyone.
+fn unlocked(fixture: &ReadFixture, n: &str) -> bool {
+    let namespace = namespace_path(fixture, n);
+    free(&namespace.join(WRITER_LEASE), LockMode::Exclusive)
+        && free(&namespace.join(READERS_LEASE), LockMode::Exclusive)
+}
+fn writer_row<T: std::fmt::Debug>(result: Result<T, ProjectWriteRefusal>) -> ProjectWriteRow {
+    match result {
+        Err(refusal) => refusal.row(),
+        Ok(value) => panic!("expected a refusal, got {value:?}"),
+    }
+}
+fn session_row<T: std::fmt::Debug>(result: Result<T, NamespaceSessionRefusal>) -> RegistrationRow {
+    match result {
+        Err(NamespaceSessionRefusal::Namespace(WorkFailure::Operation(refusal))) => refusal.row(),
+        other => panic!("expected a namespace refusal, got {other:?}"),
+    }
+}
+/// A private 0600 file with the zero-rights owner allow, as X2c makes the
+/// carriers.
+fn private_file_at(path: &Path) {
+    fs::write(path, b"").unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600)).unwrap();
+    private(path);
+}
