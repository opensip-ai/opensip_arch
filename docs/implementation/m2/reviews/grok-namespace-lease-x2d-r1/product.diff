+#[test]
+fn a_budget_shortfall_at_the_lease_leaves_no_lock() {
+    let (fixture, project, n) = eligible("x2d-budget");
+    // Measure the whole act on a session with the owner's caps.
+    let measured = {
+        let session = fixture.session(None).unwrap();
+        let (admission, tracking) = session_subject(&session, &project);
+        let target = session
+            .admit_namespace(admission, tracking, &inputs())
+            .unwrap();
+        let before = session.used();
+        let fenced = target.lease_shared(&inputs()).unwrap();
+        let after = session.used();
+        drop(fenced);
+        (before, after)
+    };
+    let (before, after) = measured;
+    assert!(after.edges > before.edges);
+    // A ledger that runs out anywhere inside the lease step refuses on the
+    // budget row with no project lock held and the fence still held.
+    for k in 0..4usize {
+        let cut = |a: usize, b: usize| a + (b - a) * k / 4;
+        let limits = WorkCost {
+            objects: cut(before.objects, after.objects).max(before.objects),
+            edges: cut(before.edges, after.edges),
+            bytes: cut(before.bytes, after.bytes),
+        };
+        let session = fixture.session(Some(limits)).unwrap();
+        let (admission, tracking) = session_subject(&session, &project);
+        let target = session
+            .admit_namespace(admission, tracking, &inputs())
+            .unwrap();
+        assert_eq!(session.used(), before, "deterministic up to the lease");
+        let result = target.lease_shared(&inputs());
+        assert!(
+            matches!(
+                result,
+                Err(NamespaceSessionRefusal::Namespace(WorkFailure::Budget(_)))
+                    | Err(NamespaceSessionRefusal::Session(_))
+            ),
+            "{result:?}"
+        );
+        drop(result);
+        assert!(unlocked(&fixture, &n));
+        assert!(!fence_free(&fixture));
+    }
+}
