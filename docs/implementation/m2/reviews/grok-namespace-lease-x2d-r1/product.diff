+#[test]
+fn a_missing_or_foreign_namespace_refuses_before_any_lock() {
+    fn refused(fixture: &ReadFixture, project: &Path) -> RegistrationRow {
+        let session = fixture.session(None).unwrap();
+        let (admission, tracking) = session_subject(&session, project);
+        session_row(session.admit_namespace(admission, tracking, &inputs()))
+    }
+    // A carrier positively absent: the installation is incomplete.
+    let (fixture, project, n) = eligible("x2d-no-readers");
+    fs::remove_file(namespace_path(&fixture, &n).join(READERS_LEASE)).unwrap();
+    assert_eq!(refused(&fixture, &project), RegistrationRow::Incomplete);
+
+    // N itself absent (moved aside).
+    let (fixture, project, n) = eligible("x2d-no-namespace");
+    let namespace = namespace_path(&fixture, &n);
+    fs::rename(&namespace, namespace.with_file_name("moved")).unwrap();
+    assert_eq!(refused(&fixture, &project), RegistrationRow::Incomplete);
+
+    // N readable by others: not installation-private.
+    let (fixture, project, n) = eligible("x2d-mode");
+    fs::set_permissions(
+        namespace_path(&fixture, &n),
+        fs::Permissions::from_mode(0o755),
+    )
+    .unwrap();
+    assert_eq!(
+        refused(&fixture, &project),
+        RegistrationRow::InstallationCustody("private")
+    );
+
+    // A carrier replaced by a symbolic link.
+    let (fixture, project, n) = eligible("x2d-link");
+    let namespace = namespace_path(&fixture, &n);
+    fs::remove_file(namespace.join(WRITER_LEASE)).unwrap();
+    std::os::unix::fs::symlink(READERS_LEASE, namespace.join(WRITER_LEASE)).unwrap();
+    assert_eq!(
+        refused(&fixture, &project),
+        RegistrationRow::InstallationCustody("symlink")
+    );
+
+    // A carrier that is not private (0644).
+    let (fixture, project, n) = eligible("x2d-carrier-mode");
+    fs::set_permissions(
+        namespace_path(&fixture, &n).join(READERS_LEASE),
+        fs::Permissions::from_mode(0o644),
+    )
+    .unwrap();
+    assert_eq!(
+        refused(&fixture, &project),
+        RegistrationRow::InstallationCustody("private")
+    );
+}
