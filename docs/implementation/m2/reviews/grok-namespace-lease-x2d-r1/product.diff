+#[test]
+fn a_fresh_registration_leases_append_write_under_the_fence() {
+    let fixture = ReadFixture::new("x2d-fresh");
+    let project = fixture_project(&fixture);
+    let (mut writer, _trees) = writer(&fixture, "x2d-fresh");
+    let registered = register(&mut writer, &project);
+    let n = registered.namespace_id().to_owned();
+    let namespace = namespace_path(&fixture, &n);
+    let target = writer
+        .admit_namespace(NamespaceSubject::Registered(registered), &inputs())
+        .unwrap();
+    // N is R2's ACTIVE row's; the target takes no project lock.
+    assert_eq!(target.namespace_id(), n);
+    assert_eq!(target.row().status(), ProjectRegistryStatus::Active);
+    assert!(matches!(target.subject(), NamespaceSubject::Registered(_)));
+    assert!(unlocked(&fixture, &n));
+    let mut fenced = target
+        .lease_writer(WriterLease::AppendWrite, &inputs())
+        .unwrap();
+    assert_eq!(fenced.mode(), LeaseMode::AppendWrite);
+    assert_eq!(fenced.namespace_id(), n);
+    // APPEND-WRITE: `writer.lease` exclusively, `readers.lease` untouched,
+    // so readers never wait on the writer.
+    assert!(!free(&namespace.join(WRITER_LEASE), LockMode::Exclusive));
+    assert!(!free(&namespace.join(WRITER_LEASE), LockMode::Shared));
+    assert!(free(&namespace.join(READERS_LEASE), LockMode::Shared));
+    assert!(free(&namespace.join(READERS_LEASE), LockMode::Exclusive));
+    // The fence is still held: X2d never releases it.
+    assert!(!fence_free(&fixture));
+    fenced.recheck(&inputs()).unwrap();
+    // Dropping releases the lease; the fence goes only with the writer.
+    drop(fenced);
+    assert!(unlocked(&fixture, &n));
+    assert!(!fence_free(&fixture));
+    writer.release().unwrap();
+    assert!(fence_free(&fixture));
+}
