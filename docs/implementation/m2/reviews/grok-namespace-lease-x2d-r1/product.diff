+#[test]
+fn the_target_holds_no_project_lock_for_the_floor_step() {
+    // X3b's floor step runs between the target and the lease, under the
+    // fence: its probe takes `writer.lease` LOCK_EX|LOCK_NB through the
+    // retained namespace and releases it at once.
+    let (fixture, project, n) = eligible("x2d-floor-seam");
+    let (mut writer, _trees) = writer(&fixture, "x2d-floor-seam");
+    let subject = admitted(&mut writer, &project);
+    let target = writer.admit_namespace(subject, &inputs()).unwrap();
+    let probe = target
+        .namespace_directory()
+        .open_regular(WRITER_LEASE)
+        .unwrap();
+    let probe = FileLock::try_acquire(probe, LockMode::Exclusive)
+        .unwrap()
+        .expect("no project lock is held before the lease");
+    probe.release().unwrap();
+    assert!(!fence_free(&fixture));
+    let fenced = target
+        .lease_writer(WriterLease::AppendWrite, &inputs())
+        .unwrap();
+    assert_eq!(fenced.row().namespace_id(), n);
+    drop(fenced);
+    writer.release().unwrap();
