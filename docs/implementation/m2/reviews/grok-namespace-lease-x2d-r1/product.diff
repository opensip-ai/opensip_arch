@@ -0,0 +1,799 @@
+// Law X2 r8 item 7 (unit X2d): namespace admission and leases. For an
+// Eligible root (N from R0's ACTIVE row) or a root this admission has just
+// registered (N from R2's ACTIVE row), never from a caller, under the held
+// installation fence and on the holder's one ledger:
+// - `admit`: the root admission's own recheck (chain, incarnation, marker,
+//   registry owner, v1 absence) with item 6a's tracking observation, or the
+//   registered project's recheck; then `I/host`, `I/host/projects`, N and
+//   both lease files confirmed under installation-private custody and
+//   retained. No project lock is taken. The result, `NamespaceTarget`, is
+//   the seam where X3b's floor step runs (X3b r8 items 1 and 3, composed by
+//   X3b-3): under the fence, with R current and no project lock held.
+// - `lease`: the same rechecks again, then S7's lease without blocking on
+//   the retained carriers (SHARED-READ: `readers.lease` LOCK_SH|LOCK_NB;
+//   APPEND-WRITE: `writer.lease` LOCK_EX|LOCK_NB; EXCLUSIVE: `writer.lease`
+//   then `readers.lease`, both LOCK_EX|LOCK_NB), the locked carriers' name
+//   bindings and the namespace's rechecked, and the holder's full recheck.
+//   A busy or failed lock, or any later refusal, releases every project
+//   lock already taken, in reverse order, while the fence is still held.
+// The result is `FencedNamespace`: the held lease, the ACTIVE row snapshot
+// and the root admission. It borrows the fence's holder, so the fence
+// cannot be released while it lives. This unit never releases the fence:
+// item 7a (unit X2e) decides when; until then a `FencedNamespace` can only
+// be dropped, which releases its lease, and the fence goes with its holder
+// afterwards. No lease is taken without the fence: the read-only recovery
+// selector's fence-free SHARED-READ (item 7's r6 exception) is X6's and is
+// not here. Library only.
+use super::first_registration::{
+    HOST, Owner, PROJECTS, ProjectInputs, READERS_LEASE, RegisteredProject, RegistrationRefusal,
+    RegistrationRow, STATUS, Step, WRITER_LEASE, admission, capture_cost, identity, name_cost,
+    private, private_child, private_file, rebind, recheck_registered, same_private, tracking,
+};
+use super::git_tracking::{TrackingInputs, TrackingObservation, recheck_tracking};
+use super::installation_admission::{DurableInstallation, RequiredFile, plus, times};
+use super::project_admission::{Classification, ProjectRootAdmission};
+use super::project_chain::ProjectChainPolicy;
+use crate::private_access::observe_private_directory;
+use opensip_identity::{ProjectRegistryEntry, ProjectRegistryStatus};
+use opensip_platform::{
+    DescriptorMetadata, FileLock, LockMode, RetainedDirectory, WorkCost, WorkFailure, WorkScope,
+};
+use std::ffi::OsStr;
+use std::fs::File;
+use std::io;
+use std::path::Path;
+
+/// One nonblocking lock attempt: the carrier's kind check (a status read),
+/// its close-on-exec check and the `flock` itself.
+const LOCK: WorkCost = WorkCost {
+    objects: 0,
+    edges: 3,
+    bytes: 512,
+};
+
+// ------------------------------------------------------------- refusals
+
+/// S7's three lease modes (law X2 item 7).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum LeaseMode {
+    /// `readers.lease` LOCK_SH|LOCK_NB only.
+    SharedRead,
+    /// `writer.lease` LOCK_EX|LOCK_NB only.
+    AppendWrite,
+    /// `writer.lease` LOCK_EX|LOCK_NB, then `readers.lease` LOCK_EX|LOCK_NB.
+    Exclusive,
+}
+/// The modes a writer's gate may take. A read session takes SHARED-READ
+/// only; there is no upgrade from one mode to another.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum WriterLease {
+    AppendWrite,
+    Exclusive,
+}
+impl WriterLease {
+    fn mode(self) -> LeaseMode {
+        match self {
+            Self::AppendWrite => LeaseMode::AppendWrite,
+            Self::Exclusive => LeaseMode::Exclusive,
+        }
+    }
+}
+
+/// Why namespace admission or its lease refused. Each variant has one item
+/// 8 row (`row`).
+#[derive(Debug)]
+pub(crate) enum NamespaceRefusal {
+    /// Item 4: only Eligible grants namespace admission.
+    NotEligible(Classification),
+    /// A recheck, custody, binding or I/O refusal on an owner, with X2c's
+    /// rows unchanged.
+    Owner(RegistrationRefusal),
+    /// `host`, `projects`, N or a lease file is positively absent although
+    /// R's ACTIVE row names N: the installation is incomplete.
+    Missing(Owner, &'static str),
+    /// A project lock is held elsewhere: this carrier refused LOCK_NB.
+    Busy(&'static str),
+    /// A composition that cannot arise from the admitted inputs.
+    Invariant(&'static str),
+}
+impl NamespaceRefusal {
+    pub(crate) fn row(&self) -> RegistrationRow {
+        use RegistrationRow as Row;
+        match self {
+            Self::NotEligible(Classification::RecoveryNeeded { .. } | Classification::OneSided) => {
+                Row::RootCustody("identity-recovery-required")
+            }
+            Self::NotEligible(Classification::Contradiction) => {
+                Row::RootCustody("identity-contradiction")
+            }
+            // A FirstUseCandidate registers first, on the write gate; asking
+            // for its namespace is a broken composition.
+            Self::NotEligible(
+                Classification::FirstUseCandidate | Classification::Eligible { .. },
+            ) => Row::Invariant,
+            Self::Owner(refusal) => refusal.row(),
+            Self::Missing(..) => Row::Incomplete,
+            Self::Busy(_) => Row::Busy,
+            Self::Invariant(_) => Row::Invariant,
+        }
+    }
+}
+pub(crate) type Failure = WorkFailure<NamespaceRefusal>;
+fn refuse<T>(refusal: NamespaceRefusal) -> Result<T, Failure> {
+    Err(WorkFailure::Operation(refusal))
+}
+/// An owner's refusal, with X2c's row.
+fn registration(failure: WorkFailure<RegistrationRefusal>) -> Failure {
+    match failure {
+        WorkFailure::Budget(budget) => WorkFailure::Budget(budget),
+        WorkFailure::Operation(refusal) => WorkFailure::Operation(NamespaceRefusal::Owner(refusal)),
+    }
+}
+
+// ------------------------------------------------------- the fence holder
+
+/// What a step sees on the held fence: the retained I, the invoking user,
+/// H's spelling, the registry as the holder retains it, the chain policy
+/// with the holder's premise, and the inputs item 6a reads only to refuse.
+/// The write gate also lends its `DurableInstallation`, which a registered
+/// project's recheck needs.
+pub(crate) struct Held<'a, 'p> {
+    pub(super) installation: &'a RetainedDirectory,
+    pub(super) uid: u32,
+    pub(super) home: &'a Path,
+    pub(super) judged: &'a RequiredFile,
+    pub(super) policy: &'a ProjectChainPolicy<'p>,
+    pub(super) inputs: &'a ProjectInputs<'a>,
+    pub(super) durable: Option<&'a DurableInstallation>,
+}
+/// The owner of the held installation fence: the ordinary writer's gate or
+/// the read session. Implemented beside each, where their private state is.
+pub(crate) trait FenceHolder {
+    type Refusal: std::fmt::Debug;
+    /// One charged step under the held fence on the holder's one ledger,
+    /// then the holder's full recheck while the fence is still held. Any
+    /// refusal spends the gate or latches the session; a value the step
+    /// returned is dropped before the refusal returns.
+    fn fenced<R>(
+        &mut self,
+        inputs: &ProjectInputs<'_>,
+        action: impl FnOnce(&Held<'_, '_>, &mut WorkScope<'_>) -> Result<R, Failure>,
+    ) -> Result<R, Self::Refusal>;
+}
+
+// ------------------------------------------------------------ the subject
+
+/// The root admission item 7 leases for: an Eligible root with its tracking
+/// observation (R0), or a project this admission has just registered (R2).
+pub(crate) enum NamespaceSubject {
+    Eligible {
+        admission: ProjectRootAdmission,
+        tracking: TrackingObservation,
+    },
+    Registered(RegisteredProject),
+}
+impl std::fmt::Debug for NamespaceSubject {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Eligible { admission, .. } => f.debug_tuple("Eligible").field(admission).finish(),
+            Self::Registered(registered) => f.debug_tuple("Registered").field(registered).finish(),
+        }
+    }
+}
+/// The ACTIVE row of the current registry owner R that names N: R0's for an
+/// Eligible root (exactly one live row at N, the classification's), or R2's
+/// for a fresh registration (which must still classify Eligible). Charged
+/// as one scan of R's rows.
+fn active_row(
+    subject: &NamespaceSubject,
+    work: &mut WorkScope<'_>,
+) -> Result<ProjectRegistryEntry, Failure> {
+    let (document, expected) = match subject {
+        NamespaceSubject::Eligible { admission, .. } => {
+            let Classification::Eligible { namespace, project } = admission.classification() else {
+                return refuse(NamespaceRefusal::NotEligible(
+                    admission.classification().clone(),
+                ));
+            };
+            (
+                admission.registry().document(),
+                (namespace.clone(), project.clone()),
+            )
+        }
+        NamespaceSubject::Registered(registered) => (
+            registered.registry().document(),
+            (
+                registered.namespace_id().to_owned(),
+                registered.project_id().to_owned(),
+            ),
+        ),
+    };
+    let scan = WorkCost {
+        objects: 1,
+        edges: document.entries().len().max(1),
+        bytes: document.raw().len(),
+    };
+    work.run(scan, |_| {
+        if let NamespaceSubject::Registered(registered) = subject {
+            let eligible = Classification::Eligible {
+                namespace: expected.0.clone(),
+                project: expected.1.clone(),
+            };
+            if registered.classification() != eligible {
+                return refuse(NamespaceRefusal::Invariant("not-eligible"));
+            }
+        }
+        let mut rows = document
+            .entries()
+            .iter()
+            .filter(|entry| entry.namespace_id() == expected.0);
+        match (rows.next(), rows.next()) {
+            (Some(row), None)
+                if row.status() == ProjectRegistryStatus::Active
+                    && row.project_id() == expected.1 =>
+            {
+                Ok(row.clone())
+            }
+            _ => refuse(NamespaceRefusal::Invariant("active-row")),
+        }
+    })
+}
+/// The subject's own recheck under the held fence: the root admission's
+/// (chain, incarnation, marker, R0 and v1 absence) and item 6a's tracking
+/// observation against this admission's chain, or the registered project's
+/// (every owner item 6 published, R2 and the tracking observation).
+fn recheck_subject(
+    subject: &NamespaceSubject,
+    held: &Held<'_, '_>,
+    work: &mut WorkScope<'_>,
+) -> Result<(), Failure> {
+    match subject {
+        NamespaceSubject::Eligible {
+            admission: root,
+            tracking: observed,
+        } => {
+            root.recheck(held.uid, held.installation, held.judged, held.policy, work)
+                .map_err(|failure| registration(admission(failure)))?;
+            let inputs = TrackingInputs {
+                chain: root.chain(),
+                uid: held.uid,
+                policy: held.policy,
+                home: held.home,
+                environment: held.inputs.environment,
+                system_sources: held.inputs.system_sources,
+            };
+            recheck_tracking(observed, &inputs, work)
+                .map_err(|failure| registration(tracking(failure)))
+        }
+        NamespaceSubject::Registered(registered) => {
+            let Some(durable) = held.durable else {
+                return refuse(NamespaceRefusal::Invariant("registered-without-gate"));
+            };
+            recheck_registered(
+                registered,
+                durable,
+                held.policy,
+                held.inputs,
+                Step::Lease,
+                work,
+            )
+            .map_err(registration)
+        }
+    }
+}
+
+// ---------------------------------------------------------- the namespace
+
+/// One lease carrier: its retained no-follow descriptor and the full sample
+/// it was judged private with.
+struct Carrier {
+    name: &'static str,
+    file: File,
+    metadata: DescriptorMetadata,
+}
+/// `I/host`, `I/host/projects` and N, retained and judged private.
+struct Namespace {
+    id: String,
+    host: RetainedDirectory,
+    projects: RetainedDirectory,
+    directory: RetainedDirectory,
+}
+/// An installation-private directory that R's ACTIVE row requires: present
+/// (absence is the incomplete row), private, exactly named, and on its
+/// parent's device.
+fn required_directory(
+    parent: &RetainedDirectory,
+    name: &str,
+    owner: Owner,
+    uid: u32,
+    work: &mut WorkScope<'_>,
+) -> Result<RetainedDirectory, Failure> {
+    let Some(child) =
+        private_child(parent, name, uid, Step::Lease, owner, work).map_err(registration)?
+    else {
+        return refuse(NamespaceRefusal::Missing(owner, "absent"));
+    };
+    if identity(child.as_file(), Step::Lease, owner, work)
+        .map_err(registration)?
+        .0
+        != identity(parent.as_file(), Step::Lease, owner, work)
+            .map_err(registration)?
+            .0
+    {
+        return refuse(NamespaceRefusal::Owner(RegistrationRefusal::Custody(
+            owner,
+            "volume-unsupported",
+        )));
+    }
+    Ok(child)
+}
+/// One lease carrier opened no-follow under N and judged private (owned by
+/// the invoking user, 0600, one link, no foreign ACL grant). Absence is the
+/// incomplete row; a link or another kind is custody.
+fn open_carrier(
+    directory: &RetainedDirectory,
+    name: &'static str,
+    uid: u32,
+    work: &mut WorkScope<'_>,
+) -> Result<Carrier, Failure> {
+    let file = work.run(RetainedDirectory::open_regular_cost(name), |_| {
+        directory
+            .open_regular(name)
+            .map_err(|error| WorkFailure::Operation(carrier_open_refusal(name, error)))
+    })?;
+    let metadata =
+        private_file(&file, Step::Lease, Owner::Namespace, uid, work).map_err(registration)?;
+    Ok(Carrier {
+        name,
+        file,
+        metadata,
+    })
+}
+fn carrier_open_refusal(name: &'static str, error: io::Error) -> NamespaceRefusal {
+    use RegistrationRefusal as R;
+    if error.kind() == io::ErrorKind::NotFound {
+        NamespaceRefusal::Missing(Owner::Namespace, name)
+    } else if error.raw_os_error() == Some(super::first_registration::ELOOP) {
+        NamespaceRefusal::Owner(R::Custody(Owner::Namespace, "symlink"))
+    } else if error.kind() == io::ErrorKind::InvalidInput {
+        NamespaceRefusal::Owner(R::Custody(Owner::Namespace, "not-a-regular-file"))
+    } else {
+        NamespaceRefusal::Owner(R::Io(Step::Lease, Owner::Namespace, error))
+    }
+}
+/// Item 7's first bullet: the namespace directory and both lease files
+/// under custody, through the retained I. For a registered project the
+/// confirmed N must be the very directory item 6 published.
+fn confirm_namespace(
+    subject: &NamespaceSubject,
+    id: &str,
+    held: &Held<'_, '_>,
+    work: &mut WorkScope<'_>,
+) -> Result<(Namespace, [Carrier; 2]), Failure> {
+    let host = required_directory(held.installation, HOST, Owner::Host, held.uid, work)?;
+    let projects = required_directory(&host, PROJECTS, Owner::Projects, held.uid, work)?;
+    let directory = required_directory(&projects, id, Owner::Namespace, held.uid, work)?;
+    if let NamespaceSubject::Registered(registered) = subject
+        && identity(directory.as_file(), Step::Lease, Owner::Namespace, work)
+            .map_err(registration)?
+            != identity(
+                registered.namespace().as_file(),
+                Step::Lease,
+                Owner::Namespace,
+                work,
+            )
+            .map_err(registration)?
+    {
+        return refuse(NamespaceRefusal::Owner(RegistrationRefusal::Changed(
+            Owner::Namespace,
+        )));
+    }
+    let writer = open_carrier(&directory, WRITER_LEASE, held.uid, work)?;
+    let readers = open_carrier(&directory, READERS_LEASE, held.uid, work)?;
+    Ok((
+        Namespace {
+            id: id.to_owned(),
+            host,
+            projects,
+            directory,
+        },
+        [writer, readers],
+    ))
+}
+/// The cost of `recheck_directories`.
+fn directories_cost(id: &str) -> WorkCost {
+    let one = |name: &str| {
+        plus(&[
+            opensip_platform::open_child_directory_cost(OsStr::new(name)),
+            times(STATUS, 2),
+            name_cost(),
+            capture_cost(),
+        ])
+    };
+    plus(&[one(HOST), one(PROJECTS), one(id)])
+}
+/// Each retained directory is still the one its name binds under its
+/// retained parent, still exactly named, and still private.
+fn recheck_directories(
+    namespace: &Namespace,
+    held: &Held<'_, '_>,
+    work: &mut WorkScope<'_>,
+) -> Result<(), Failure> {
+    let links = [
+        (held.installation, HOST, &namespace.host, Owner::Host),
+        (
+            &namespace.host,
+            PROJECTS,
+            &namespace.projects,
+            Owner::Projects,
+        ),
+        (
+            &namespace.projects,
+            namespace.id.as_str(),
+            &namespace.directory,
+            Owner::Namespace,
+        ),
+    ];
+    for (parent, name, child, owner) in links {
+        rebind(parent, name, child, Step::Lease, owner, work).map_err(registration)?;
+        observe_private_directory(child.as_file(), held.uid, work)
+            .map_err(|failure| registration(private(Step::Lease, owner)(failure)))?;
+    }
+    Ok(())
+}
+/// The cost of `recheck_binding`.
+fn binding_cost(name: &str) -> WorkCost {
+    plus(&[RetainedDirectory::open_regular_cost(name), capture_cost()])
+}
+/// The carrier's name under N still binds a private file with exactly the
+/// carrier's judged sample: the same file (device and inode), unchanged.
+/// A missing, linked or replaced name is a change.
+fn recheck_binding(
+    directory: &RetainedDirectory,
+    name: &'static str,
+    metadata: &DescriptorMetadata,
+    uid: u32,
+    work: &mut WorkScope<'_>,
+) -> Result<(), Failure> {
+    let named = work.run(RetainedDirectory::open_regular_cost(name), |_| {
+        directory.open_regular(name).map_err(|error| {
+            WorkFailure::Operation(
+                if error.kind() == io::ErrorKind::NotFound
+                    || error.kind() == io::ErrorKind::InvalidInput
+                    || error.raw_os_error() == Some(super::first_registration::ELOOP)
+                {
+                    NamespaceRefusal::Owner(RegistrationRefusal::Changed(Owner::Namespace))
+                } else {
+                    NamespaceRefusal::Owner(RegistrationRefusal::Io(
+                        Step::Lease,
+                        Owner::Namespace,
+                        error,
+                    ))
+                },
+            )
+        })
+    })?;
+    same_private(&named, metadata, Step::Lease, Owner::Namespace, uid, work).map_err(registration)
+}
+
+// ---------------------------------------------------------------- the lease
+
+/// The project locks held, in acquisition order: `writer.lease` (level 1)
+/// before `readers.lease` (level 2). Dropping releases them in reverse
+/// order. Each keeps the sample its carrier was judged with.
+struct HeldLease {
+    writer: Option<(FileLock, DescriptorMetadata)>,
+    readers: Option<(FileLock, DescriptorMetadata)>,
+}
+impl Drop for HeldLease {
+    fn drop(&mut self) {
+        drop(self.readers.take());
+        drop(self.writer.take());
+    }
+}
+impl HeldLease {
+    fn carriers(&self) -> impl Iterator<Item = (&'static str, &DescriptorMetadata)> {
+        [
+            self.writer.as_ref().map(|(_, m)| (WRITER_LEASE, m)),
+            self.readers.as_ref().map(|(_, m)| (READERS_LEASE, m)),
+        ]
+        .into_iter()
+        .flatten()
+    }
+}
+/// One nonblocking lock on a retained carrier. Busy is the busy row; any
+/// other failure is host I/O. Nothing waits.
+fn lock(
+    carrier: Carrier,
+    mode: LockMode,
+    work: &mut WorkScope<'_>,
+) -> Result<(FileLock, DescriptorMetadata), Failure> {
+    let Carrier {
+        name,
+        file,
+        metadata,
+    } = carrier;
+    work.run(LOCK, |_| match FileLock::try_acquire(file, mode) {
+        Ok(Some(lock)) => Ok((lock, metadata)),
+        Ok(None) => refuse(NamespaceRefusal::Busy(name)),
+        Err(error) => refuse(NamespaceRefusal::Owner(RegistrationRefusal::Io(
+            Step::Lease,
+            Owner::Namespace,
+            error,
+        ))),
+    })
+}
+/// Item 7's second bullet, as one effect whose whole work is reserved
+/// before the first lock: the locks in S7's order, then each locked
+/// carrier's name binding and the namespace's directories rechecked. A
+/// busy or failed lock, or a failed recheck, drops `held`, which releases
+/// every lock already taken in reverse order; the fence is never touched.
+fn take_lease(
+    namespace: &Namespace,
+    carriers: [Carrier; 2],
+    mode: LeaseMode,
+    uid: u32,
+    held_fence: &Held<'_, '_>,
+    work: &mut WorkScope<'_>,
+) -> Result<HeldLease, Failure> {
+    let [writer, readers] = carriers;
+    let writer = (mode != LeaseMode::SharedRead).then_some(writer);
+    let readers = (mode != LeaseMode::AppendWrite).then_some(readers);
+    let locks = usize::from(writer.is_some()) + usize::from(readers.is_some());
+    let bindings: Vec<WorkCost> = [writer.as_ref(), readers.as_ref()]
+        .into_iter()
+        .flatten()
+        .map(|carrier| binding_cost(carrier.name))
+        .collect();
+    let reserve = plus(&[
+        times(LOCK, locks),
+        plus(&bindings),
+        directories_cost(&namespace.id),
+    ]);
+    effect_lease(work, reserve, |work| {
+        let mut held = HeldLease {
+            writer: None,
+            readers: None,
+        };
+        if let Some(writer) = writer {
+            held.writer = Some(lock(writer, LockMode::Exclusive, work)?);
+        }
+        if let Some(readers) = readers {
+            let selector = if mode == LeaseMode::Exclusive {
+                LockMode::Exclusive
+            } else {
+                LockMode::Shared
+            };
+            held.readers = Some(lock(readers, selector, work)?);
+        }
+        for (name, metadata) in held.carriers() {
+            recheck_binding(&namespace.directory, name, metadata, uid, work)?;
+        }
+        recheck_directories(namespace, held_fence, work)?;
+        Ok(held)
+    })
+}
+/// One effect whose whole work is reserved before it starts (467 item 6),
+/// as X2c's `effect`: the body spends only from the reserve, and a
+/// shortfall fails closed before the work it would cover.
+fn effect_lease<R>(
+    work: &mut WorkScope<'_>,
+    reserve: WorkCost,
+    action: impl FnOnce(&mut WorkScope<'_>) -> Result<R, Failure>,
+) -> Result<R, Failure> {
+    work.effect(WorkCost::default(), reserve, |post| {
+        post.prepaid(reserve, action)
+    })
+}
+
+// ------------------------------------------------- the target and the lease
+
+/// Item 7's namespace, admitted and confirmed under the held fence, with no
+/// project lock taken. Private, not Clone. It borrows the fence's holder.
+///
+/// This is the seam where X3b's floor step runs (X3b r8 item 3; composed
+/// by X3b-3 with X2e): under the held fence, with R current, before any
+/// lease and with no project lock held. `namespace_directory` and `row` are
+/// what that step reads. `lease` rechecks everything again before the
+/// first lock, so whatever ran in between is seen.
+pub(crate) struct NamespaceTarget<H: FenceHolder> {
+    holder: H,
+    subject: NamespaceSubject,
+    row: ProjectRegistryEntry,
+    namespace: Namespace,
+    carriers: [Carrier; 2],
+}
+impl<H: FenceHolder> std::fmt::Debug for NamespaceTarget<H> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NamespaceTarget")
+            .field("namespace", &self.namespace.id)
+            .finish_non_exhaustive()
+    }
+}
+/// Item 7: admit the subject's namespace under `holder`'s held fence. N is
+/// R's ACTIVE row's, never a caller's. The subject is rechecked, the
+/// namespace and both carriers are confirmed and retained, and the
+/// holder's full recheck runs. No lock is taken.
+pub(super) fn admit<H: FenceHolder>(
+    mut holder: H,
+    subject: NamespaceSubject,
+    inputs: &ProjectInputs<'_>,
+) -> Result<NamespaceTarget<H>, H::Refusal> {
+    let (row, namespace, carriers) = holder.fenced(inputs, |held, work| {
+        let row = active_row(&subject, work)?;
+        recheck_subject(&subject, held, work)?;
+        let (namespace, carriers) = confirm_namespace(&subject, row.namespace_id(), held, work)?;
+        Ok((row, namespace, carriers))
+    })?;
+    Ok(NamespaceTarget {
+        holder,
+        subject,
+        row,
+        namespace,
+        carriers,
+    })
+}
+impl<H: FenceHolder> NamespaceTarget<H> {
+    /// N, from R's ACTIVE row.
+    pub(crate) fn namespace_id(&self) -> &str {
+        self.row.namespace_id()
+    }
+    /// The ACTIVE row snapshot of the current registry owner R.
+    pub(crate) fn row(&self) -> &ProjectRegistryEntry {
+        &self.row
+    }
+    /// The retained, confirmed `I/host/projects/N`, for X3b's floor step
+    /// (its probe and its read-only observation). No authority beyond the
+    /// held fence.
+    pub(crate) fn namespace_directory(&self) -> &RetainedDirectory {
+        &self.namespace.directory
+    }
+    pub(crate) fn subject(&self) -> &NamespaceSubject {
+        &self.subject
+    }
+    /// Item 7's lease in `mode`, without blocking: the subject, the
+    /// namespace and both retained carriers are rechecked; then the locks,
+    /// each locked carrier's binding and the directories; then the
+    /// holder's full recheck. Every refusal leaves no project lock held and
+    /// the fence still held.
+    fn lease(
+        self,
+        mode: LeaseMode,
+        inputs: &ProjectInputs<'_>,
+    ) -> Result<FencedNamespace<H>, H::Refusal> {
+        let Self {
+            mut holder,
+            subject,
+            row,
+            namespace,
+            carriers,
+        } = self;
+        let lease = holder.fenced(inputs, |held, work| {
+            recheck_subject(&subject, held, work)?;
+            recheck_directories(&namespace, held, work)?;
+            for carrier in &carriers {
+                same_private(
+                    &carrier.file,
+                    &carrier.metadata,
+                    Step::Lease,
+                    Owner::Namespace,
+                    held.uid,
+                    work,
+                )
+                .map_err(registration)?;
+                recheck_binding(
+                    &namespace.directory,
+                    carrier.name,
+                    &carrier.metadata,
+                    held.uid,
+                    work,
+                )?;
+            }
+            take_lease(&namespace, carriers, mode, held.uid, held, work)
+        })?;
+        Ok(FencedNamespace {
+            lease,
+            mode,
+            holder,
+            subject,
+            row,
+            namespace,
+        })
+    }
+}
+impl<'w> NamespaceTarget<&'w mut super::ordinary_writer::OrdinaryWriteAdmission> {
+    /// APPEND-WRITE or EXCLUSIVE on the writer's gate.
+    pub(crate) fn lease_writer(
+        self,
+        mode: WriterLease,
+        inputs: &ProjectInputs<'_>,
+    ) -> Result<
+        FencedNamespace<&'w mut super::ordinary_writer::OrdinaryWriteAdmission>,
+        super::first_registration::ProjectWriteRefusal,
+    > {
+        self.lease(mode.mode(), inputs)
+    }
+}
+impl<'s> NamespaceTarget<&'s super::installation_read::ReadSession> {
+    /// SHARED-READ on the read session.
+    pub(crate) fn lease_shared(
+        self,
+        inputs: &ProjectInputs<'_>,
+    ) -> Result<
+        FencedNamespace<&'s super::installation_read::ReadSession>,
+        super::installation_read::NamespaceSessionRefusal,
+    > {
+        self.lease(LeaseMode::SharedRead, inputs)
+    }
+}
+
+/// Item 7's result: the held lease, the ACTIVE row snapshot and the root
+/// admission, with the fence's holder borrowed, so the fence is still held.
+/// Private, not Clone, with no serialized form, no upgrade and no release
+/// of the fence. Until item 7a's handoff (unit X2e) it can only be
+/// rechecked or dropped; dropping releases the lease (`readers.lease`
+/// before `writer.lease`), and the fence goes later with its holder.
+pub(crate) struct FencedNamespace<H: FenceHolder> {
+    lease: HeldLease,
+    mode: LeaseMode,
+    holder: H,
+    subject: NamespaceSubject,
+    row: ProjectRegistryEntry,
+    namespace: Namespace,
+}
+impl<H: FenceHolder> std::fmt::Debug for FencedNamespace<H> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("FencedNamespace")
+            .field("namespace", &self.namespace.id)
+            .field("mode", &self.mode)
+            .finish_non_exhaustive()
+    }
+}
+impl<H: FenceHolder> FencedNamespace<H> {
+    pub(crate) fn mode(&self) -> LeaseMode {
+        self.mode
+    }
+    /// N, from R's ACTIVE row.
+    pub(crate) fn namespace_id(&self) -> &str {
+        self.row.namespace_id()
+    }
+    /// The ACTIVE row snapshot of the current registry owner R.
+    pub(crate) fn row(&self) -> &ProjectRegistryEntry {
+        &self.row
+    }
+    /// The root admission: an Eligible root with its tracking observation,
+    /// or the registered project.
+    pub(crate) fn subject(&self) -> &NamespaceSubject {
+        &self.subject
+    }
+    /// The retained, leased `I/host/projects/N`.
+    pub(crate) fn namespace_directory(&self) -> &RetainedDirectory {
+        &self.namespace.directory
+    }
+    /// The whole recheck set under the held fence and the lease: the
+    /// subject, the namespace's directories, each locked carrier's name
+    /// binding, then the holder's full recheck. A refusal spends the gate or
+    /// latches the session; the lease stays held until this is dropped.
+    pub(crate) fn recheck(&mut self, inputs: &ProjectInputs<'_>) -> Result<(), H::Refusal> {
+        let Self {
+            lease,
+            holder,
+            subject,
+            namespace,
+            ..
+        } = self;
+        holder.fenced(inputs, |held, work| {
+            recheck_subject(subject, held, work)?;
+            recheck_directories(namespace, held, work)?;
+            for (name, metadata) in lease.carriers() {
+                recheck_binding(&namespace.directory, name, metadata, held.uid, work)?;
+            }
+            Ok(())
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    include!("namespace_lease_tests.rs");
+}
