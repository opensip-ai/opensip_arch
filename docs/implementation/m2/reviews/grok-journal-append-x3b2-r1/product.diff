+    assert_eq!((t.schema, t.kind, t.seq), (1, "TERMINAL", CARRIER_CAP));
+    assert!(t.body.contains(r#""cause":"grantGenerationClosure""#));
+    assert_eq!(t.request_ref, None);
+    assert_eq!(t.run_id, None);
+    // Refusals: the physical operation grammar, the fixture Run, a non-run3
+    // id, a non-object epoch, an overlong reason, a malformed wall clock.
+    for bad in ["op-0123", "OP-0123456789abcdef0123456789abcdef", "x"] {
+        assert_eq!(
+            build_record(N, &init, bad, &Body::Draft(&ra())),
+            Err(RecordRefusal::OperationRef)
+        );
+    }
+    let fixture = format!("run3:{}", "0".repeat(64));
+    assert_eq!(
+        build_record(N, &init, OP, &Body::Seal(&fixture)),
+        Err(RecordRefusal::Schema(JournalError::FixtureRun))
+    );
+    let run2 = format!("run2:{}", "5".repeat(64));
+    assert!(matches!(
+        build_record(N, &init, OP, &Body::Seal(&run2)),
+        Err(RecordRefusal::Schema(_))
+    ));
+    let not_object = RecordDraft::Rev {
+        reason: "policy".into(),
