+#[test]
+fn each_record_builds_as_its_closed_body_with_the_selected_chain() {
+    let init = CommittedTail::init();
+    let seal_id = run_id();
+    let seal = build_record(N, &init, OP, &Body::Seal(&seal_id)).unwrap();
+    assert_eq!((seal.schema, seal.kind, seal.seq), (3, "SEAL", 1));
+    assert_eq!(seal.run_id.as_deref(), Some(seal_id.as_str()));
+    // The domain-framed body hash and the genesis previous value.
+    let mut framed = b"opensip.metadata.journal.1\0".to_vec();
+    framed.extend_from_slice(seal.body.as_bytes());
+    assert_eq!(
+        seal.body_sha256,
+        opensip_identity::digest_hex(&opensip_identity::raw_sha256(&framed))
+    );
+    let mut genesis = b"opensip.journal.genesis.1\0".to_vec();
+    genesis.extend_from_slice(N.as_bytes());
+    genesis.extend_from_slice(b"\x001");
+    assert_eq!(
+        seal.prev_sha256,
+        opensip_identity::digest_hex(&opensip_identity::raw_sha256(&genesis))
+    );
+    // chain_law 1: SHA-256(ascii_hex(body_sha256[k-1]) || ascii_decimal(k-1)).
+    let tail = CommittedTail {
+        generation: 1,
+        seq: 1,
+        body: Some(seal.body_sha256.clone()),
+    };
+    let next = build_record(N, &tail, OP, &Body::Draft(&rev())).unwrap();
+    assert_eq!(
+        next.prev_sha256,
+        opensip_identity::digest_hex(&opensip_identity::raw_sha256(
+            format!("{}1", seal.body_sha256).as_bytes()
+        ))
+    );
+    assert!(
+        next.body
+            .contains(r#""trustEpochObserved":{"revocationVersion":7}"#)
+    );
+    for (draft, kind) in [(ra(), "RA"), (rev(), "REV"), (cln(), "CLN")] {
+        let r = build_record(N, &init, OP, &Body::Draft(&draft)).unwrap();
+        assert_eq!((r.schema, r.kind), (3, kind));
+        assert_eq!(
+            JournalRecord::parse(r.body.as_bytes()).unwrap().canonical(),
+            r.body.as_bytes()
+        );
+    }
+    let accepted = build_record(N, &init, OP, &Body::Draft(&ra())).unwrap();
+    assert_eq!(accepted.request_ref.as_deref(), Some("request-1"));
+    // TERMINAL is the frozen recordSchema-1 body.
+    let slot = CommittedTail {
+        generation: 1,
+        seq: LAST_ORDINARY_SEQ,
+        body: Some(h('a')),
