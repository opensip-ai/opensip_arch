+    let cleaned = append(&lock, &location, &cln()).unwrap();
+    assert_eq!((revoked.seq(), cleaned.seq()), (3, 4));
+    let rows = f.rows();
+    assert_eq!(
+        rows.iter().map(|r| r.2.as_str()).collect::<Vec<_>>(),
+        ["RA", "SEAL", "REV", "CLN"]
+    );
+    assert_eq!(rows[3].3, cleaned.body_sha256());
+    assert_eq!(
+        f.witness_now(),
+        (
+            1,
+            4,
+            Some(cleaned.body_sha256().to_string()),
+            WitnessState::Committed
+        )
+    );
+    // The reader's own prefix admission accepts every appended row: body
+    // bytes, digests, chain, physical mirrors and the SEAL's Run.
+    let snapshot = CurrentCarrierSnapshot::open(&f.carrier(), N).unwrap();
+    let prefix = snapshot.capture(1, 16, 1 << 20).unwrap();
+    assert_eq!(prefix.records.len(), 4);
+    drop(snapshot);
+    // The append writes no trust state, and leaves no temporary witness.
+    assert_eq!(fs::read(f.floor_path()).unwrap(), floor);
+    let names: Vec<_> = fs::read_dir(&f.namespace_path)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().into_string().unwrap())
+        .filter(|n| n.starts_with("grant-journal.witness.json."))
+        .collect();
+    assert!(names.is_empty(), "{names:?}");
+    // The next operation starts consistent and copies the floor forward.
+    assert_eq!(f.next_start(), StartReconciliation::Consistent);
+}
