+/// A carrier whose tail is the last ordinary slot. The slot is unreachable by
+/// contiguous append, so the append trigger is lifted and reinstalled
+/// verbatim (carrier-format.v3 §13), leaving the definitions byte-equal.
+fn at_the_last_ordinary_slot(f: &Fixture) -> CommittedTail {
+    f.created();
+    let c = rusqlite::Connection::open(f.carrier()).unwrap();
+    let trigger: String = c
+        .query_row(
+            "SELECT sql FROM sqlite_schema WHERE name='gj3_append_laws'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    c.execute_batch("DROP TRIGGER gj3_append_laws").unwrap();
+    c.execute(
+        "INSERT INTO grant_journal_v3(grantGeneration,seq,record_schema,record_type,operation_ref,body,body_sha256,prev_sha256) VALUES(1,?1,3,'RA',?2,'{}',?3,?4)",
+        rusqlite::params![LAST_ORDINARY_SEQ, OP, h('a'), h('b')],
+    )
+    .unwrap();
+    c.execute_batch(&trigger).unwrap();
+    drop(c);
+    f.plant_witness(1, LAST_ORDINARY_SEQ, Some(&h('a')), true);
+    CommittedTail {
+        generation: 1,
+        seq: LAST_ORDINARY_SEQ,
+        body: Some(h('a')),
+    }
+}
