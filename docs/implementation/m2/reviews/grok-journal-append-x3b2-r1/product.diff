+#[test]
+fn each_step_failure_is_certain_before_visibility_and_undetermined_after() {
+    use AppendStep::*;
+    // Certain: nothing committed, the lock is not latched, and the next
+    // append on the same lock completes over whatever PENDING was left.
+    for (step, pending_left) in [(Built, false), (BeforeInsert, true)] {
+        let f = Fixture::new();
+        let lock = f.started().with_hook(at(step, Fault::Fail));
+        let location = f.location();
+        let r = refused(append(&lock, &location, &ra()));
+        assert_eq!(r.row(), CarrierRow::HostIo, "{step:?}");
+        assert!(f.rows().is_empty());
+        assert_eq!(f.witness_now().3 == WitnessState::Pending, pending_left);
+        let lock = JournalAppendLock { hook: None, ..lock };
+        assert_eq!(
+            append(&lock, &location, &ra()).unwrap().seq(),
+            1,
+            "{step:?}"
+        );
+        assert_eq!(f.witness_now().3, WitnessState::Committed);
+    }
+    // Undetermined: the lock latches, refuses every further effect, and
+    // reconciles to the stated outcome; the end step copies that tail only.
+    for (step, rows, floor_seq) in [
+        (PendingPublished, 0, None),
+        (Inserted, 0, None),
+        (Committed, 1, Some(1)),
+        (CommittedPublished, 1, Some(1)),
+    ] {
+        let f = Fixture::new();
+        let lock = f.started().with_hook(at(step, Fault::Fail));
+        let location = f.location();
+        let r = undetermined(append(&lock, &location, &ra()));
+        assert_eq!(r.row(), CarrierRow::HostIo, "{step:?}");
+        assert_eq!(f.rows().len(), rows, "{step:?}");
+        let r = refused(append(&lock, &location, &cln()));
+        assert!(matches!(
+            r,
+            CarrierRefusal::Append(AppendRefusal::Undetermined)
+        ));
+        let reconciled = WorkLedger::new()
+            .scope(|w| lock.reconcile_undetermined(&location, w))
+            .unwrap();
+        let tail = match reconciled {
+            UncertainReconciliation::Copyable(tail) => tail,
+            other => panic!("{step:?}: {other:?}"),
+        };
+        assert_eq!(
+            (f.witness_now().1, f.witness_now().3),
+            (rows as i64, WitnessState::Committed),
+            "{step:?}"
+        );
+        // Still latched after reconciliation.
+        assert!(matches!(
+            refused(append(&lock, &location, &cln())),
+            CarrierRefusal::Append(AppendRefusal::Undetermined)
+        ));
+        let outcome = WorkLedger::new()
+            .scope(|w| end_step(&location, EndInput::Uncertain(Some(tail)), w))
+            .unwrap();
+        let floor: CarrierFloor = f.floor();
+        match floor_seq {
+            Some(seq) => {
+                assert_eq!(outcome, EndOutcome::CopiedForward);
+                assert_eq!(floor.seq, seq);
+            }
+            None => {
+                assert_eq!(outcome, EndOutcome::Unchanged);
+                assert_eq!(floor.seq, 0);
+            }
+        }
+    }
+    // Reconciliation is only for an undetermined outcome.
+    let f = Fixture::new();
+    let lock = f.started();
+    let location = f.location();
+    let r = refusal(WorkLedger::new().scope(|w| lock.reconcile_undetermined(&location, w)));
+    assert!(matches!(
+        r,
+        CarrierRefusal::Append(AppendRefusal::NoUncertainOutcome)
+    ));
+}
