+#[test]
+fn terminal_takes_only_the_reserved_slot_and_closes_the_generation() {
+    let f = Fixture::new();
+    let lock = f.started();
+    let location = f.location();
+    let r = refused(append(&lock, &location, &terminal()));
+    assert!(matches!(
+        r,
+        CarrierRefusal::Append(AppendRefusal::TerminalSlot)
+    ));
+    assert_eq!(r.row(), CarrierRow::Invariant);
+    assert!(f.rows().is_empty());
+
+    let g = Fixture::new();
+    let tail = at_the_last_ordinary_slot(&g);
+    let lock = g.lock_at(&tail);
+    let location = g.location();
+    let witness = fs::read(g.witness()).unwrap();
+    let r = refused(append(&lock, &location, &ra()));
+    assert!(matches!(r, CarrierRefusal::Append(AppendRefusal::Capacity)));
+    assert_eq!(fs::read(g.witness()).unwrap(), witness);
+    let closed = append(&lock, &location, &terminal()).unwrap();
+    assert_eq!(
+        (closed.seq(), closed.record_type()),
+        (CARRIER_CAP, "TERMINAL")
+    );
+    let c = rusqlite::Connection::open(g.carrier()).unwrap();
+    let (schema, run, request): (i64, Option<String>, Option<String>) = c
+        .query_row(
+            "SELECT record_schema,run_id,request_ref FROM grant_journal_v3 WHERE seq=?1",
+            [CARRIER_CAP],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )
+        .unwrap();
+    assert_eq!((schema, run, request), (1, None, None));
+    assert_eq!(
+        g.witness_now(),
+        (
+            1,
+            CARRIER_CAP,
+            Some(closed.body_sha256().to_string()),
+            WitnessState::Committed
+        )
+    );
+    // Nothing follows a TERMINAL in its generation; rollover is not here.
+    for draft in [cln(), terminal()] {
+        assert!(matches!(
+            refused(append(&lock, &location, &draft)),
+            CarrierRefusal::Append(AppendRefusal::Capacity)
+        ));
+    }
+}
