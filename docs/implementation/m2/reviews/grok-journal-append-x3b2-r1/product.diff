+#[test]
+fn a_seal_holds_level_four_until_released_and_level_three_is_never_retaken() {
+    let f = Fixture::new();
+    let (steps, hook) = recorder();
+    let lock = f.started().with_hook(hook);
+    let location = f.location();
+    let mut ledger = WorkLedger::new();
+    let mut held = ledger
+        .scope(|w| lock.begin(&location, w)?.acquire())
+        .unwrap();
+    let mut out = Vec::new();
+    let _ = ledger.scope(|w| {
+        out.push(held.append_seal(OP, &run_id(), w));
+        // A second record under one level-4 hold: level 3 is closed.
+        out.push(held.append_seal(OP, &run_id(), w));
+        Ok::<(), WorkFailure<()>>(())
+    });
+    let second = out.pop().unwrap();
+    out.pop().unwrap().unwrap();
+    assert!(matches!(
+        refused(second),
+        CarrierRefusal::Append(AppendRefusal::LockOrder)
+    ));
+    // Level 4 is still held after the SEAL committed: no level 3 under it.
+    let r = refusal(WorkLedger::new().scope(|w| lock.begin(&location, w).map(|_| ())));
+    assert!(matches!(
+        r,
+        CarrierRefusal::Append(AppendRefusal::LockOrder)
+    ));
+    assert_eq!(r.row(), CarrierRow::Invariant);
+    assert!(
+        !steps
+            .lock()
+            .unwrap()
+            .contains(&AppendStep::ReleasedLevelFour)
+    );
+    held.release();
+    let released: Vec<_> = steps
+        .lock()
+        .unwrap()
+        .iter()
+        .copied()
+        .filter(|s| {
+            matches!(
+                s,
+                AppendStep::ReleasedLevelFour | AppendStep::ReleasedLevelThree
+            )
+        })
+        .collect();
+    assert_eq!(
+        released,
+        [
+            AppendStep::ReleasedLevelFour,
+            AppendStep::ReleasedLevelThree
+        ]
+    );
+    assert_eq!(append(&lock, &location, &cln()).unwrap().seq(), 2);
+}
