+#[test]
+fn a_busy_journal_transaction_refuses_at_once_and_holds_nothing() {
+    let f = Fixture::new();
+    let lock = f.started();
+    let location = f.location();
+    let other = rusqlite::Connection::open(f.carrier()).unwrap();
+    other.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let began = Instant::now();
+    let r = refused(append(&lock, &location, &ra()));
+    assert!(began.elapsed() < Duration::from_secs(1));
+    assert!(matches!(r, CarrierRefusal::Busy), "{r:?}");
+    assert_eq!(r.row(), CarrierRow::Busy);
+    other.execute_batch("ROLLBACK").unwrap();
+    // Nothing was held: level 4 is free and the next append succeeds.
+    assert_eq!(append(&lock, &location, &ra()).unwrap().seq(), 1);
+    // A second level 3 while one is open is busy too, never waited on.
+    let first = WorkLedger::new()
+        .scope(|w| lock.begin(&location, w))
+        .unwrap();
+    let r = refusal(WorkLedger::new().scope(|w| lock.begin(&location, w).map(|_| ())));
+    assert!(matches!(r, CarrierRefusal::Busy), "{r:?}");
+    drop(first);
+}
