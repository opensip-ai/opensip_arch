+#[test]
+fn the_append_reserves_its_confirmations_before_the_first_effect() {
+    let f = Fixture::new();
+    let lock = f.started();
+    let location = f.location();
+    let mut probe = WorkLedger::new();
+    let held = probe
+        .scope(|w| lock.begin(&location, w)?.acquire())
+        .unwrap();
+    let opened = probe.used();
+    drop(held);
+    let mut short = WorkLedger::with_limits(WorkCost {
+        objects: opened.objects + 64,
+        edges: opened.edges + 1024,
+        bytes: opened.bytes + 1024,
+    })
+    .unwrap();
+    let witness = fs::read(f.witness()).unwrap();
+    assert!(matches!(
+        append_on(&lock, &location, &ra(), &mut short),
+        Err(AppendError::Refused(WorkFailure::Budget(
+            WorkBudgetError::Bytes
+        )))
+    ));
+    assert_eq!(fs::read(f.witness()).unwrap(), witness);
+    assert!(f.rows().is_empty());
+    // The reservation covers what one witness publication actually charges.
+    let bytes = witness_bytes(N, 1, 1, Some(&h('d')), false).unwrap();
+    let mut measured = WorkLedger::new();
+    measured
+        .scope(|w| publish_private_file(location.namespace, "probe.json", &bytes, location.uid, w))
+        .unwrap();
+    let used = measured.used();
+    let reserved = witness_publication_cost(bytes.len());
+    assert!(
+        used.objects <= reserved.objects
+            && used.edges <= reserved.edges
+            && used.bytes <= reserved.bytes,
+        "{used:?} > {reserved:?}"
+    );
+}
