+//! Law X3b r6 item 11's tests for X3b-2, on scratch installations only:
+//! record building for SEAL, REV, CLN, RA and TERMINAL against the reader's
+//! own prefix admission, each protocol step in order, the SEAL-path level-4
+//! hold and the stop order, busy at level 3, the S6 block after REV, a crash
+//! at each step reconciling OK, REVERT, ADVANCE or OK, each step's failure
+//! classified certain or undetermined, the latch and the reconciliation after
+//! an undetermined outcome, the reserved terminal slot, and the reservation.
+use super::super::start::{
+    EndInput, EndOutcome, StartReconciliation, UncertainReconciliation, carrier_start, end_step,
+};
+use super::super::tests::{Fixture, N, h, quarantine, refusal};
+use super::*;
+use crate::journal_store::{CarrierFloor, Witness, WitnessState};
+use opensip_platform::{WorkBudgetError, WorkLedger};
+use std::fs;
+use std::sync::{Arc, Mutex as StdMutex};
+use std::time::{Duration, Instant};
+
+const OP: &str = "op-0123456789abcdef0123456789abcdef";
+fn run_id() -> String {
+    format!("run3:{}", "5".repeat(64))
+}
+fn ra() -> RecordDraft {
+    RecordDraft::Ra {
+        request_ref: "request-1".into(),
+    }
+}
+fn rev() -> RecordDraft {
+    let epoch = crate::trust::metadata::parse(br#"{"revocationVersion":7}"#).unwrap();
+    RecordDraft::Rev {
+        reason: "observer-fail-stop".into(),
+        trust_epoch_observed: Some(epoch),
+    }
+}
+fn cln() -> RecordDraft {
+    RecordDraft::Cln {
+        residuals: vec!["seal-without-commit".into()],
+    }
+}
+fn terminal() -> RecordDraft {
+    RecordDraft::Terminal {
+        wall_clock_data: "2026-10-01T00:00:00Z".into(),
+    }
+}
+
+impl Fixture {
+    /// A created carrier, started at INIT, and its lock.
+    fn started(&self) -> JournalAppendLock {
+        self.created();
+        self.lock_at(&CommittedTail::init())
+    }
+    fn lock_at(&self, expected: &CommittedTail) -> JournalAppendLock {
+        let location = self.location();
+        let start = WorkLedger::new()
+            .scope(|w| carrier_start(&location, expected, w))
+            .unwrap();
+        JournalAppendLock::after_start(&location, start).unwrap()
+    }
+    fn witness_now(&self) -> (i64, i64, Option<String>, WitnessState) {
+        let w = Witness::from_file_bytes(&fs::read(self.witness()).unwrap())
+            .unwrap()
+            .record;
+        (w.generation, w.seq, w.body, w.state)
+    }
+    fn rows(&self) -> Vec<(i64, i64, String, String)> {
+        let c = rusqlite::Connection::open(self.carrier()).unwrap();
+        let mut s = c
+            .prepare("SELECT grantGeneration,seq,record_type,body_sha256 FROM grant_journal_v3 ORDER BY grantGeneration,seq")
+            .unwrap();
+        s.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)))
+            .unwrap()
+            .collect::<rusqlite::Result<_>>()
+            .unwrap()
+    }
+    /// The next operation's view: the floor step, then the carrier start.
+    fn next_start(&self) -> StartReconciliation {
+        let location = self.location();
+        let (_, expected) = WorkLedger::new()
+            .scope(|w| super::super::floor_step_observed(&location, w))
+            .unwrap();
+        WorkLedger::new()
+            .scope(|w| carrier_start(&location, &expected.unwrap(), w))
+            .unwrap()
+            .reconciliation()
+    }
+}
+
+/// One whole append on one ledger: level 3, level 4, then the record.
+fn append_on(
+    lock: &JournalAppendLock,
+    location: &CarrierLocation<'_>,
+    draft: &RecordDraft,
+    ledger: &mut WorkLedger,
+) -> Result<AppendedRecord, AppendError> {
+    let held = match ledger.scope(|w| lock.begin(location, w)?.acquire()) {
+        Ok(held) => held,
+        Err(e) => return Err(AppendError::Refused(e)),
+    };
+    let mut out = None;
+    let _ = ledger.scope(|w| {
+        out = Some(held.append(OP, draft, w));
+        Ok::<(), WorkFailure<()>>(())
+    });
+    out.unwrap()
+}
+fn append(
+    lock: &JournalAppendLock,
+    location: &CarrierLocation<'_>,
+    draft: &RecordDraft,
+) -> Result<AppendedRecord, AppendError> {
+    append_on(lock, location, draft, &mut WorkLedger::new())
+}
+fn refused(result: Result<AppendedRecord, AppendError>) -> CarrierRefusal {
+    match result {
+        Err(AppendError::Refused(WorkFailure::Operation(r))) => r,
+        other => panic!("expected a certain refusal, got {other:?}"),
+    }
+}
+fn undetermined(result: Result<AppendedRecord, AppendError>) -> CarrierRefusal {
+    match result {
+        Err(AppendError::Undetermined(WorkFailure::Operation(r))) => r,
+        other => panic!("expected an undetermined outcome, got {other:?}"),
+    }
+}
+fn recorder() -> (
+    Arc<StdMutex<Vec<AppendStep>>>,
+    impl Fn(AppendStep) -> Option<Fault>,
+) {
+    let steps = Arc::new(StdMutex::new(Vec::new()));
+    let seen = steps.clone();
+    (steps, move |step| {
+        seen.lock().unwrap().push(step);
+        None
+    })
+}
+fn at(target: AppendStep, fault: Fault) -> impl Fn(AppendStep) -> Option<Fault> {
+    move |step| (step == target).then_some(fault)
+}
