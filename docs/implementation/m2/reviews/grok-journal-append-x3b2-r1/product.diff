+#[test]
+fn the_append_never_waits_and_never_writes_trust_state() {
+    let source = include_str!("carrier_append.rs");
+    let code = &source[..source.find("#[cfg(test)]\n#[path").unwrap()];
+    // Level 4 is only ever tried, never waited on; nothing sleeps or retries.
+    assert!(!code.contains(".lock()"));
+    assert_eq!(code.matches(".try_lock()").count(), 3);
+    for forbidden in [
+        "busy_timeout(",
+        "Duration",
+        "sleep",
+        "write_floor",
+        "FLOORS_NAME",
+        "carrier-floors",
+        "carrier_quarantine",
+        "OR REPLACE",
+    ] {
+        assert!(!code.contains(forbidden), "{forbidden}");
+    }
+    // One INSERT and one COMMIT per append.
+    assert_eq!(code.matches("INSERT INTO grant_journal_v3").count(), 1);
+    assert_eq!(code.matches(r#"execute_batch("COMMIT")"#).count(), 1);
+}
