@@ -0,0 +1,584 @@
+//! Law X3c r7 unit X3c-2: object publication over `blob_store` (item 4), the
+//! non-waiting level-3 `PreparedLedger` (item 5), staging (item 6), the owned
+//! prepared-commit adapter and the durability classification of its `COMMIT`
+//! (item 7), each charged (item 9) and mapped to item 10's rows.
+//!
+//! Everything here runs under the namespace writer lease the caller holds.
+//! X3d composes it: X3d holds X3b's journal transaction before calling
+//! [`begin_prepared_ledger`], stages only after the durable `SEAL` and
+//! `COMMITTED` witness, and calls [`PreparedLedgerCommit::commit`] only through
+//! X4's single-use `AdmissionPermit` while level 4 is held. This module cannot
+//! name those security types; its types make the storage half of the order
+//! structural instead: an object needs a committed attempt row, the ledger
+//! transaction needs every object's barriers, staging consumes the transaction
+//! and the adapter's one consuming method performs only `COMMIT`.
+//!
+//! Nothing here deletes, renames or reuses an object after a failure, settles
+//! `attempt_custody`, reads an outcome back or retries a `COMMIT` (item 11).
+use super::super::{
+    ExistingWriter, LedgerError, WriteTransaction, pin_transactions, recovery_pins,
+};
+use super::{
+    AdmittedAttempt, AdmittedLedger, ObjectDirectory, ProjectLedgerRefusal, Refused, classify_open,
+    open_verified, refuse, same_file,
+};
+use crate::{
+    availability::AvailabilityRecord,
+    blob_store::{BlobDisposition, BlobError, SuppliedDigestDirectory, VerifiedBlob},
+    pin_inventory::Inventory,
+    recovery::{AssociationCandidate, ReceiptCandidate, SuppliedBinding},
+};
+use opensip_identity::{RegisteredSchemas, digest_hex};
+use opensip_platform::{
+    DirectoryBarrier, PublicationStage, RetainedDirectory, WorkBudgetError, WorkCost, WorkFailure,
+    WorkScope,
+};
+use std::{collections::BTreeSet, io};
+
+/// Item 9, per object: the object and its edges for the private temporary
+/// file, its write and read-back, the file barrier, the exclusive link and the
+/// directory barrier, plus a confirmation's open, full read, both barriers and
+/// reopen. Its byte length is charged on top.
+const OBJECT_COST: WorkCost = WorkCost {
+    objects: 1,
+    edges: 12,
+    bytes: 512,
+};
+/// The level-3 `BEGIN IMMEDIATE` on the verified connection.
+const BEGIN_COST: WorkCost = WorkCost {
+    objects: 1,
+    edges: 4,
+    bytes: 1 << 12,
+};
+/// Staging's fixed statements (schema checks, joins and inserts for the pair,
+/// the Run material, availability and pins) and the one `COMMIT` they precede,
+/// reserved before the first insert. The staged bodies are charged on top.
+const STAGE_COST: WorkCost = WorkCost {
+    objects: 16,
+    edges: 128,
+    bytes: 1 << 16,
+};
+const COMMIT_COST: WorkCost = WorkCost {
+    objects: 1,
+    edges: 4,
+    bytes: 1 << 12,
+};
+/// macOS `ELOOP`: `O_NOFOLLOW` met a symbolic link at the object name.
+const ELOOP: i32 = 62;
+
+/// One object the Run declares: its SHA-256 and length, and the bytes.
+pub(crate) struct DeclaredObject {
+    digest: [u8; 32],
+    length: u64,
+    bytes: Vec<u8>,
+}
+impl DeclaredObject {
+    pub(crate) fn new(digest: [u8; 32], length: u64, bytes: Vec<u8>) -> Self {
+        Self {
+            digest,
+            length,
+            bytes,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ObjectDisposition {
+    /// Written by this attempt: file barrier, exclusive link, directory barrier.
+    PublishedNew,
+    /// An existing name whose every byte matched, after this attempt's own
+    /// file and directory barriers.
+    ConfirmedExisting,
+}
+#[derive(Debug)]
+pub(crate) struct PublishedObject {
+    digest: String,
+    length: u64,
+    disposition: ObjectDisposition,
+    barrier: DirectoryBarrier,
+}
+impl PublishedObject {
+    pub(crate) fn digest(&self) -> &str {
+        &self.digest
+    }
+    pub(crate) fn length(&self) -> u64 {
+        self.length
+    }
+    pub(crate) fn disposition(&self) -> ObjectDisposition {
+        self.disposition
+    }
+    pub(crate) fn barrier(&self) -> DirectoryBarrier {
+        self.barrier
+    }
+}
+/// Every object of one commit, each with both barriers complete, for one
+/// admitted attempt (item 4). Only [`publish_objects`] makes one, and
+/// [`begin_prepared_ledger`] consumes it: level 3 follows every barrier.
+pub(crate) struct PublishedObjects {
+    execution: String,
+    objects: Vec<PublishedObject>,
+}
+impl PublishedObjects {
+    pub(crate) fn objects(&self) -> &[PublishedObject] {
+        &self.objects
+    }
+    fn digests(&self) -> BTreeSet<&str> {
+        self.objects.iter().map(|o| o.digest.as_str()).collect()
+    }
+}
+
+/// Crate-private crash points inside one object's publication (item 12a).
+/// Each leaves the on-disk state a process death at that step leaves, then
+/// stops the attempt with no cleanup, as the dead process would.
+#[cfg(test)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ObjectStep {
+    /// Part of the bytes are in the private temporary file.
+    TemporaryWrite,
+    /// All bytes are in the temporary file; its file barrier has not run.
+    BeforeFileBarrier,
+    /// The file barrier and the exclusive link ran; the name is visible.
+    AfterLink,
+    /// As `AfterLink`, but the power loss before the directory barrier lost
+    /// the link: the name is absent and the barriered temporary file remains.
+    BeforeDirectoryBarrier,
+}
+
+/// Item 4 (step 3) and item 9: publish every declared object into
+/// `objects/sha256/` for the admitted attempt. Every object's length and
+/// SHA-256 are checked, and every byte is reserved on the operation ledger,
+/// before the first write; a commit that cannot be reserved refuses on the
+/// budget row and is never truncated. Each object is then published new, or
+/// an exclusive-publication collision with unchanged visibility is confirmed
+/// byte for byte. A failure stops publication; already-published objects stay.
+pub(crate) fn publish_objects(
+    attempt: &AdmittedAttempt,
+    directory: &ObjectDirectory,
+    declared: Vec<DeclaredObject>,
+    work: &mut WorkScope<'_>,
+) -> Refused<PublishedObjects> {
+    publish_objects_inner(
+        attempt,
+        directory,
+        declared,
+        work,
+        #[cfg(test)]
+        None,
+    )
+}
+
+fn publication_cost(declared: &[DeclaredObject]) -> Option<WorkCost> {
+    declared.iter().try_fold(WorkCost::default(), |total, o| {
+        let bytes = usize::try_from(o.length).ok()?;
+        total.checked_add(OBJECT_COST)?.checked_add(WorkCost {
+            bytes,
+            ..WorkCost::default()
+        })
+    })
+}
+
+fn publish_objects_inner(
+    attempt: &AdmittedAttempt,
+    directory: &ObjectDirectory,
+    declared: Vec<DeclaredObject>,
+    work: &mut WorkScope<'_>,
+    #[cfg(test)] crash: Option<(usize, ObjectStep)>,
+) -> Refused<PublishedObjects> {
+    let total =
+        publication_cost(&declared).ok_or(WorkFailure::Budget(WorkBudgetError::Arithmetic))?;
+    work.run(total, |_| {
+        // Every check precedes every write (item 4).
+        let mut seen = BTreeSet::new();
+        let mut blobs = Vec::with_capacity(declared.len());
+        for object in declared {
+            if !seen.insert(object.digest) {
+                return refuse(ProjectLedgerRefusal::ObjectDeclaration);
+            }
+            let blob = VerifiedBlob::from_owned(object.digest, object.length, object.bytes)
+                .map_err(|_| WorkFailure::Operation(ProjectLedgerRefusal::ObjectDeclaration))?;
+            blobs.push((object.digest, object.length, blob));
+        }
+        let retained = directory.retained();
+        let store = retained
+            .as_file()
+            .try_clone()
+            .map_err(BlobError::Io)
+            .and_then(SuppliedDigestDirectory::new)
+            .map_err(|e| WorkFailure::Operation(host_io(e)))?;
+        let mut objects = Vec::with_capacity(blobs.len());
+        for (index, (digest, length, blob)) in blobs.into_iter().enumerate() {
+            #[cfg(not(test))]
+            let _ = index;
+            #[cfg(test)]
+            if let Some((at, step)) = crash
+                && at == index
+            {
+                return Err(simulate_crash(retained, &digest, &blob, step));
+            }
+            let stored = store
+                .publish(&blob)
+                .map_err(|e| WorkFailure::Operation(object_failure(retained, e)))?;
+            objects.push(PublishedObject {
+                digest: digest_hex(&digest),
+                length,
+                disposition: match stored.disposition {
+                    BlobDisposition::PublishedNew => ObjectDisposition::PublishedNew,
+                    BlobDisposition::ConfirmedExisting => ObjectDisposition::ConfirmedExisting,
+                },
+                barrier: stored.barrier,
+            });
+        }
+        Ok(PublishedObjects {
+            execution: attempt.execution.clone(),
+            objects,
+        })
+    })
+}
+
+fn host_io(error: BlobError) -> ProjectLedgerRefusal {
+    ProjectLedgerRefusal::Io(match error {
+        BlobError::Io(e) => e,
+        other => io::Error::other(format!("{other:?}")),
+    })
+}
+
+/// Item 10: an occupied name that is not a regular file, or a regular file
+/// whose bytes, length, links or write permissions do not match, is
+/// `LEDGER.CORRUPT` and is never overwritten (F04). Any other failure before
+/// a `COMMIT` is host I/O, including an indeterminate link or barrier.
+fn object_failure(directory: &RetainedDirectory, error: BlobError) -> ProjectLedgerRefusal {
+    match error {
+        // Prepare's own refusal of a non-regular entry at the digest name: an
+        // OS error would carry its errno; this one is the primitive's check.
+        BlobError::Publication(e)
+            if e.stage() == PublicationStage::Prepare
+                && e.source_error().kind() == io::ErrorKind::InvalidInput
+                && e.source_error().raw_os_error().is_none() =>
+        {
+            ProjectLedgerRefusal::Corrupt
+        }
+        BlobError::Publication(e) => {
+            ProjectLedgerRefusal::Io(io::Error::other(format!("object publication: {e}")))
+        }
+        // Confirmation of an existing name.
+        BlobError::Io(e) => match directory.is_reachable() {
+            Ok(false) => {
+                ProjectLedgerRefusal::Custody(opensip_security::StoreCustodyRefusal::NameChanged)
+            }
+            Err(e) => ProjectLedgerRefusal::Io(e),
+            Ok(true)
+                if e.kind() == io::ErrorKind::InvalidData
+                    || e.kind() == io::ErrorKind::InvalidInput
+                    || e.raw_os_error() == Some(ELOOP) =>
+            {
+                ProjectLedgerRefusal::Corrupt
+            }
+            Ok(true) => ProjectLedgerRefusal::Io(e),
+        },
+        other => host_io(other),
+    }
+}
+
+#[cfg(test)]
+fn simulate_crash(
+    directory: &RetainedDirectory,
+    digest: &[u8; 32],
+    blob: &VerifiedBlob,
+    step: ObjectStep,
+) -> WorkFailure<ProjectLedgerRefusal> {
+    use std::io::Write;
+    let bytes = blob.bytes_for_tests();
+    let staging = || {
+        let tag: String = opensip_platform::request_entropy()
+            .unwrap()
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        directory
+            .create_exclusive_regular(&format!(".opensip-stage-{tag}"))
+            .unwrap()
+    };
+    match step {
+        ObjectStep::TemporaryWrite => staging().write_all(&bytes[..bytes.len() / 2]).unwrap(),
+        ObjectStep::BeforeFileBarrier | ObjectStep::BeforeDirectoryBarrier => {
+            staging().write_all(bytes).unwrap()
+        }
+        ObjectStep::AfterLink => {
+            let mut f = directory
+                .create_exclusive_regular(&digest_hex(digest))
+                .unwrap();
+            f.write_all(bytes).unwrap();
+            f.sync_all().unwrap();
+        }
+    }
+    WorkFailure::Operation(ProjectLedgerRefusal::Io(io::Error::other(
+        "simulated crash",
+    )))
+}
+
+/// Item 5: the evidence ledger's level-3 write transaction. Owned, single
+/// use, not Clone, with no SQL surface; dropping it only rolls back locally.
+pub(crate) struct PreparedLedger {
+    transaction: WriteTransaction,
+    store: String,
+    namespace: String,
+    execution: String,
+    operation: String,
+    objects: PublishedObjects,
+}
+
+/// Item 5 (step 4): `BEGIN IMMEDIATE` on the admitted ledger with
+/// `busy_timeout = 0`, after every object's barriers (it consumes the
+/// published set). X3d calls it only while it holds X3b's journal
+/// transaction and never under level 4. Busy or any failure returns the
+/// refusal holding no ledger transaction, for X3d's consuming journal abort.
+pub(crate) fn begin_prepared_ledger(
+    ledger: &AdmittedLedger,
+    attempt: &AdmittedAttempt,
+    objects: PublishedObjects,
+    work: &mut WorkScope<'_>,
+) -> Refused<PreparedLedger> {
+    if objects.execution != attempt.execution {
+        return refuse(ProjectLedgerRefusal::StagingMismatch);
+    }
+    if !same_file(&ledger.file, &ledger.path)
+        .map_err(|e| WorkFailure::Operation(ProjectLedgerRefusal::Io(e)))?
+    {
+        return refuse(ProjectLedgerRefusal::IdentityChanged);
+    }
+    let connection = open_verified(&ledger.path, work)?;
+    work.run(BEGIN_COST, |_| {
+        let transaction = ExistingWriter(connection)
+            .begin()
+            .map_err(|e| WorkFailure::Operation(classify_open(e)))?;
+        Ok(PreparedLedger {
+            transaction,
+            store: attempt.store.clone(),
+            namespace: attempt.namespace.clone(),
+            execution: attempt.execution.clone(),
+            operation: attempt.operation.clone(),
+            objects,
+        })
+    })
+}
+
+/// Item 6: the joined values X3d's staging callback hands over after the
+/// durable `SEAL` and `COMMITTED` witness. The receipt and association are
+/// the exact bytes; `carrier` is the journal carrier digest they bind.
+pub(crate) struct CommitRows<'a> {
+    pub(crate) carrier: &'a str,
+    pub(crate) receipt: &'a ReceiptCandidate,
+    pub(crate) association: &'a AssociationCandidate,
+    pub(crate) manifest: Vec<u8>,
+    pub(crate) inventory: Vec<u8>,
+    pub(crate) availability: AvailabilityRecord,
+    pub(crate) pins: &'a Inventory,
+}
+/// Supplied parse and read bounds for staging; not a default policy.
+#[derive(Clone, Copy)]
+pub(crate) struct StagingLimits {
+    pub(crate) per_record_work: usize,
+    pub(crate) pin_rows: usize,
+    pub(crate) pin_text_bytes: usize,
+}
+
+impl PreparedLedger {
+    /// Item 6 (step 6): stage, in this open transaction with nothing
+    /// committed, the receipt and association (`stage_recovery_pair`), the
+    /// Run material whose blob digests must equal the published objects
+    /// exactly, the initial availability record and the Run's pins as a first
+    /// publication under the attempt's operationRef. The staged bodies and the
+    /// `COMMIT` are charged before the first insert. Any failure drops the
+    /// transaction, which rolls back: all rows or none (F11).
+    pub(crate) fn stage(
+        mut self,
+        schemas: &RegisteredSchemas,
+        rows: CommitRows<'_>,
+        limits: StagingLimits,
+        work: &mut WorkScope<'_>,
+    ) -> Refused<PreparedLedgerCommit> {
+        let body = [
+            rows.receipt.raw.len(),
+            rows.association.raw.len(),
+            rows.manifest.len(),
+            rows.inventory.len(),
+            rows.availability.raw().len(),
+            usize::try_from(rows.pins.disclosure_bytes()).unwrap_or(usize::MAX),
+        ]
+        .into_iter()
+        .try_fold(0usize, usize::checked_add)
+        .ok_or(WorkFailure::Budget(WorkBudgetError::Arithmetic))?;
+        let cost = STAGE_COST
+            .checked_add(COMMIT_COST)
+            .and_then(|c| {
+                c.checked_add(WorkCost {
+                    bytes: body,
+                    ..WorkCost::default()
+                })
+            })
+            .ok_or(WorkFailure::Budget(WorkBudgetError::Arithmetic))?;
+        work.run(cost, |_| {
+            let staging = |e: LedgerError| WorkFailure::Operation(classify_staging(e));
+            let binding = SuppliedBinding {
+                store: &self.store,
+                namespace: &self.namespace,
+                carrier: rows.carrier,
+                execution: &self.execution,
+            };
+            if rows.association.operation != self.operation
+                || rows.receipt.run != rows.association.run
+            {
+                return refuse(ProjectLedgerRefusal::StagingMismatch);
+            }
+            self.transaction
+                .stage_recovery_pair(&binding, rows.receipt, rows.association)
+                .map_err(staging)?;
+            let blobs = self
+                .transaction
+                .stage_run_material(
+                    schemas,
+                    &binding,
+                    &rows.receipt.inventory,
+                    rows.manifest,
+                    rows.inventory,
+                    limits.per_record_work,
+                )
+                .map_err(staging)?;
+            let declared: BTreeSet<&str> = blobs.iter().map(String::as_str).collect();
+            if declared.len() != blobs.len() || declared != self.objects.digests() {
+                return refuse(ProjectLedgerRefusal::StagingMismatch);
+            }
+            self.transaction
+                .stage_availability(
+                    schemas,
+                    &binding,
+                    None,
+                    rows.availability,
+                    limits.per_record_work,
+                )
+                .map_err(staging)?;
+            let none = Inventory::from_rows(rows.receipt.run.clone(), Vec::new())
+                .map_err(|e| staging(LedgerError::PinInventory(e)))?;
+            self.transaction
+                .stage_pin_change(
+                    &binding,
+                    pin_transactions::PinChange {
+                        expected: &none,
+                        desired: rows.pins,
+                        operation: &self.operation,
+                        first_publication: true,
+                        read_limits: recovery_pins::PinReadLimits {
+                            rows: limits.pin_rows,
+                            text_bytes: limits.pin_text_bytes,
+                        },
+                    },
+                )
+                .map_err(staging)?;
+            if self.transaction.poisoned {
+                return refuse(ProjectLedgerRefusal::StagingMismatch);
+            }
+            Ok(PreparedLedgerCommit {
+                transaction: self.transaction,
+                execution: self.execution,
+                #[cfg(test)]
+                before_commit: None,
+            })
+        })
+    }
+}
+
+/// Item 10 for a staging failure inside the held transaction. A stored schema
+/// that is not the selected DDL is `LEDGER.CORRUPT`; SQLite and I/O failures
+/// are host I/O; values that do not join, or that a retained key already
+/// holds, are the invariant row (a broken composition, never a retry).
+fn classify_staging(error: LedgerError) -> ProjectLedgerRefusal {
+    match error {
+        LedgerError::Configuration(name) if name.ends_with("_schema") => {
+            ProjectLedgerRefusal::Corrupt
+        }
+        LedgerError::Attempt(_) => ProjectLedgerRefusal::Corrupt,
+        LedgerError::Sql(e) if retained_key(&e) => ProjectLedgerRefusal::StagingMismatch,
+        LedgerError::Sql(e) | LedgerError::RollbackFailed(e) => ProjectLedgerRefusal::Sql(e),
+        LedgerError::Io(e) => ProjectLedgerRefusal::Io(e),
+        LedgerError::Configuration(_)
+        | LedgerError::Recovery(_)
+        | LedgerError::RunMaterial(_)
+        | LedgerError::Availability(_)
+        | LedgerError::PinMutation(_)
+        | LedgerError::PinInventory(_) => ProjectLedgerRefusal::StagingMismatch,
+        other => classify_open(other),
+    }
+}
+fn retained_key(error: &rusqlite::Error) -> bool {
+    matches!(error, rusqlite::Error::SqliteFailure(_, Some(message))
+        if message == "retained key cannot be replaced")
+}
+
+/// Item 6's owned prepared-commit adapter. Its one consuming method performs
+/// only `COMMIT`; X3d calls it only inside X4's `AdmissionPermit::consume`.
+/// Not Clone; dropping it rolls back locally and commits nothing.
+pub(crate) struct PreparedLedgerCommit {
+    transaction: WriteTransaction,
+    execution: String,
+    #[cfg(test)]
+    before_commit: Option<fn(&rusqlite::Connection)>,
+}
+
+/// Item 7: the durability classification of the evidence `COMMIT`.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum LedgerCommitOutcome {
+    /// `COMMIT` returned success under `synchronous=FULL`, `fullfsync` and
+    /// WAL: the commit is durable. Only now may X3d build `PublishedCommit`.
+    Committed { execution: String },
+    /// `COMMIT` returned an error or the connection was lost. Neither state is
+    /// inferred; the attempt row stays `admitted` for X6; nothing retries.
+    Undetermined { execution: String },
+}
+impl LedgerCommitOutcome {
+    /// Item 10's row: none for a durable commit; `DURABILITY.COMMIT_FAILED`
+    /// with the ExecutionId retained for an undetermined one.
+    pub(crate) fn refusal(&self) -> Option<ProjectLedgerRefusal> {
+        match self {
+            Self::Committed { .. } => None,
+            Self::Undetermined { .. } => Some(ProjectLedgerRefusal::CommitUndetermined),
+        }
+    }
+}
+
+impl PreparedLedgerCommit {
+    pub(crate) fn commit(self) -> LedgerCommitOutcome {
+        #[cfg(test)]
+        if let Some(hook) = self.before_commit {
+            hook(&self.transaction.connection);
+        }
+        let execution = self.execution;
+        // Staging returned this adapter only unpoisoned, and it has no other
+        // method, so the only failure left is the COMMIT itself.
+        match self.transaction.commit() {
+            Ok(_) => LedgerCommitOutcome::Committed { execution },
+            Err(_) => LedgerCommitOutcome::Undetermined { execution },
+        }
+    }
+    /// Crate-private fault injection (item 11): run `hook` on the open
+    /// connection immediately before `COMMIT`.
+    #[cfg(test)]
+    pub(crate) fn with_commit_hook(mut self, hook: fn(&rusqlite::Connection)) -> Self {
+        self.before_commit = Some(hook);
+        self
+    }
+}
