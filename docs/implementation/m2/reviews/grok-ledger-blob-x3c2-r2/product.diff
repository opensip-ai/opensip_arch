+#[test]
+fn a_crash_at_each_object_step_keeps_earlier_objects_and_the_next_attempt_completes() {
+    for step in [
+        ObjectStep::TemporaryWrite,
+        ObjectStep::BeforeFileBarrier,
+        ObjectStep::AfterLink,
+        ObjectStep::BeforeDirectoryBarrier,
+    ] {
+        let mut setup = Setup::new();
+        let attempt = setup.attempt(EXEC);
+        let objects = &setup.objects;
+        let crashed = operation(&mut setup.work, |w| {
+            publish_objects_crashing(
+                &attempt,
+                objects,
+                vec![declared(A), declared(B)],
+                w,
+                (1, step),
+            )
+        });
+        assert!(crashed.is_err(), "{step:?}");
+        let residue = setup.entries();
+        assert!(residue.contains(&hex(A)), "{step:?}: earlier object stays");
+        let staging: Vec<_> = residue
+            .iter()
+            .filter(|n| n.starts_with(".opensip-stage-"))
+            .cloned()
+            .collect();
+        match step {
+            ObjectStep::AfterLink => {
+                assert!(staging.is_empty());
+                assert_eq!(fs::read(setup.objects_path().join(hex(B))).unwrap(), B);
+            }
+            _ => {
+                assert_eq!(staging.len(), 1, "{step:?}");
+                assert!(!residue.contains(&hex(B)));
+            }
+        }
+        // The crashed attempt's row stays admitted; no ledger row was staged.
+        assert_eq!(setup.attempt_phase(EXEC), "admitted");
+        assert_eq!(setup.count("commit_receipts"), 0);
+        // A fresh process (fresh ledger, new ExecutionId) completes.
+        let mut fresh = WorkLedger::new();
+        std::mem::swap(&mut setup.work, &mut fresh);
+        let next = setup.attempt(EXEC2);
+        let published = setup
+            .publish(&next, vec![declared(A), declared(B)])
+            .unwrap();
+        let dispositions: Vec<_> = published
+            .objects()
+            .iter()
+            .map(PublishedObject::disposition)
+            .collect();
+        let b = if step == ObjectStep::AfterLink {
+            ObjectDisposition::ConfirmedExisting
+        } else {
+            ObjectDisposition::PublishedNew
+        };
+        assert_eq!(dispositions, [ObjectDisposition::ConfirmedExisting, b]);
+        // The residue is never deleted by an attempt (only X6's GC removes it).
+        let after = setup.entries();
+        assert!(after.is_superset(&residue), "{step:?}");
+        assert_eq!(fs::read(setup.objects_path().join(hex(B))).unwrap(), B);
+    }
+}
