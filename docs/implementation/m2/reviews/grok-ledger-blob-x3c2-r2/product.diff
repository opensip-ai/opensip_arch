+#[test]
+fn an_unequal_or_foreign_entry_at_an_object_name_is_ledger_corrupt_and_kept() {
+    type Make = fn(&std::path::Path);
+    let cases: [(&str, Make); 7] = [
+        ("unequal bytes", |p| {
+            fs::write(p, b"first evidence objecX").unwrap()
+        }),
+        ("short", |p| fs::write(p, b"first").unwrap()),
+        ("long", |p| {
+            fs::write(p, b"first evidence object!!").unwrap()
+        }),
+        ("directory", |p| fs::create_dir(p).unwrap()),
+        ("symlink", |p| {
+            std::os::unix::fs::symlink("/dev/null", p).unwrap()
+        }),
+        ("shared write", |p| {
+            fs::write(p, A).unwrap();
+            fs::set_permissions(p, fs::Permissions::from_mode(0o666)).unwrap();
+        }),
+        ("second link", |p| {
+            fs::write(p, A).unwrap();
+            fs::hard_link(p, p.with_file_name("other")).unwrap();
+        }),
+    ];
+    for (name, make) in cases {
+        let mut setup = Setup::new();
+        let attempt = setup.attempt(EXEC);
+        let path = setup.objects_path().join(hex(A));
+        make(&path);
+        let before = setup.entries();
+        let observed = fs::symlink_metadata(&path).unwrap();
+        // B is published first and stays: a failure never removes an object.
+        assert_eq!(
+            row(setup.publish(&attempt, vec![declared(B), declared(A)])),
+            ProjectLedgerRow::LedgerCorrupt,
+            "{name}"
+        );
+        let after = fs::symlink_metadata(&path).unwrap();
+        assert_eq!(
+            (after.ino(), after.mode(), after.len()),
+            (observed.ino(), observed.mode(), observed.len()),
+            "{name}: never overwritten"
+        );
+        let mut expected = before;
+        expected.insert(hex(B));
+        assert_eq!(setup.entries(), expected, "{name}");
+    }
+}
