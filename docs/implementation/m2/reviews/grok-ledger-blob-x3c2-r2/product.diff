+#[test]
+fn an_error_from_commit_is_undetermined_and_nothing_is_retried_or_read_back() {
+    let schemas = availability_registry();
+    let mut setup = Setup::new();
+    let attempt = setup.attempt(EXEC);
+    let m = material(EXEC, 1, 7, &[A]);
+    let p = pins(&m.run);
+    let published = setup.publish(&attempt, vec![declared(A)]).unwrap();
+    let prepared = setup.begin(&attempt, published).unwrap();
+    let adapter = stage(
+        &mut setup,
+        prepared,
+        &schemas,
+        rows(&m, availability(&schemas, &m.run, 0), &p),
+    )
+    .unwrap()
+    .with_commit_hook(break_commit);
+    let outcome = adapter.commit();
+    assert_eq!(
+        outcome,
+        LedgerCommitOutcome::Undetermined {
+            execution: EXEC.into()
+        }
+    );
+    assert_eq!(
+        outcome.refusal().map(|r| r.row()),
+        Some(ProjectLedgerRow::DurabilityCommitFailed)
+    );
+    // This injected failure rolled back; the classification did not infer it.
+    // The attempt row stays admitted for X6, and the objects stay.
+    assert_eq!(setup.count("commit_receipts"), 0);
+    assert_eq!(setup.attempt_phase(EXEC), "admitted");
+    assert!(setup.entries().contains(&hex(A)));
+}
