+#[test]
+fn a_staging_failure_at_any_row_commits_nothing() {
+    let schemas = availability_registry();
+    // A prior durable commit owns commit sequence 1 and journal sequence 7.
+    let mut setup = Setup::new();
+    let first = setup.attempt(EXEC);
