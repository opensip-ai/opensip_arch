+#[test]
+fn no_x3c2_path_deletes_settles_waits_or_reads_back() {
+    let source = include_str!("project_commit.rs");
+    for forbidden in [
+        "remove_file",
+        "remove_dir",
+        "fs::rename",
+        "renameat",
+        "unlink",
+        "DELETE FROM",
+        "OR REPLACE",
+        "UPDATE attempt_custody",
+        "ReadSnapshot",
+        "Duration",
+        "busy_timeout(",
+    ] {
+        assert!(!source.contains(forbidden), "{forbidden}");
+    }
+    // The adapter's one consuming method performs only COMMIT, once.
+    assert_eq!(source.matches(".commit()").count(), 1);
+}
