+// Law X3c r7 item 12a, X3c-2 part, on X3c-1's crate-private scratch location
+// (a held test writer lease, no production seam): object publication new,
+// confirmed and colliding; a crash at each object step; budget refusal before
+// the first object; the non-waiting level-3 transaction; staging all-or-none;
+// the durable commit; an undetermined commit; and no path deleting an object.
+use super::super::super::{LedgerStanding, ReadSnapshot, tests::availability_registry};
+use super::super::tests::{EXEC, N, Scratch, admitted, operation, record, row};
+use super::super::{
+    AdmittedAttempt, AdmittedLedger, NamespaceDirectory, ObjectDirectory, ProjectLedgerRow,
+    admit_attempt, admit_namespace_directory, admit_object_directory,
+};
+use super::*;
+use opensip_identity::{
+    JsonValue as V, canonical_bytes, hash_canonical_value, parse_json, raw_sha256,
+};
+use opensip_platform::WorkLedger;
+use std::{
+    collections::BTreeSet,
+    fs,
+    os::unix::fs::{MetadataExt, PermissionsExt},
+    path::PathBuf,
+    time::{Duration, Instant},
+};
+
+const EXEC2: &str = "exec1_fedcba9876543210fedcba9876543210";
+const CARRIER: &str = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
+
+struct Setup {
+    s: Scratch,
+    work: WorkLedger,
+    ledger: AdmittedLedger,
+    _namespace: NamespaceDirectory,
+    objects: ObjectDirectory,
+}
+impl Setup {
+    fn new() -> Self {
+        let s = Scratch::new();
+        let mut work = WorkLedger::new();
+        let ledger = admitted(&s, &mut work);
+        let location = s.location();
+        let namespace = operation(&mut work, |w| admit_namespace_directory(&location, w)).unwrap();
+        let objects = operation(&mut work, |w| {
+            admit_object_directory(&location, &namespace, w)
+        })
+        .unwrap();
+        drop(location);
+        Self {
+            s,
+            work,
+            ledger,
+            _namespace: namespace,
+            objects,
+        }
+    }
+    fn attempt(&mut self, execution: &str) -> AdmittedAttempt {
+        let location = self.s.location();
+        let ledger = &self.ledger;
+        operation(&mut self.work, |w| {
+            admit_attempt(&location, ledger, &record(execution), w)
+        })
+        .unwrap()
+    }
+    fn objects_path(&self) -> PathBuf {
+        self.s.namespace_path().join("objects/sha256")
+    }
+    fn ledger_path(&self) -> PathBuf {
+        self.s.namespace_path().join("ledger.sqlite")
+    }
+    fn entries(&self) -> BTreeSet<String> {
+        fs::read_dir(self.objects_path())
+            .unwrap()
+            .map(|e| e.unwrap().file_name().into_string().unwrap())
+            .collect()
+    }
+    fn publish(
+        &mut self,
+        attempt: &AdmittedAttempt,
+        declared: Vec<DeclaredObject>,
+    ) -> Refused<PublishedObjects> {
+        let objects = &self.objects;
+        operation(&mut self.work, |w| {
+            publish_objects(attempt, objects, declared, w)
+        })
+    }
+    fn begin(
+        &mut self,
+        attempt: &AdmittedAttempt,
+        published: PublishedObjects,
+    ) -> Refused<PreparedLedger> {
+        let ledger = &self.ledger;
+        operation(&mut self.work, |w| {
+            begin_prepared_ledger(ledger, attempt, published, w)
+        })
+    }
+    fn count(&self, table: &str) -> i64 {
+        ReadSnapshot::open(&self.ledger_path())
+            .unwrap()
+            .0
+            .query_row(&format!("SELECT count(*) FROM {table}"), [], |r| r.get(0))
+            .unwrap()
+    }
+    fn attempt_phase(&self, execution: &str) -> String {
+        ReadSnapshot::open(&self.ledger_path())
+            .unwrap()
+            .0
+            .query_row(
+                "SELECT phase FROM attempt_custody WHERE execution_id=?1",
+                [execution],
+                |r| r.get(0),
+            )
+            .unwrap()
+    }
+}
+
+fn declared(bytes: &[u8]) -> DeclaredObject {
+    DeclaredObject::new(raw_sha256(bytes), bytes.len() as u64, bytes.to_vec())
+}
+fn hex(bytes: &[u8]) -> String {
+    digest_hex(&raw_sha256(bytes))
+}
+const A: &[u8] = b"first evidence object";
+const B: &[u8] = b"second evidence object, a little longer";
+
+fn canonical(value: V) -> Vec<u8> {
+    canonical_bytes(&value).unwrap()
+}
+fn object(pairs: Vec<(&str, V)>) -> V {
+    V::Object(pairs.into_iter().map(|(k, v)| (k.to_owned(), v)).collect())
+}
+fn s(text: &str) -> V {
+    V::String(text.into())
+}
+fn int(n: i128) -> V {
+    V::Integer(opensip_identity::JsonInteger::new(n).unwrap())
+}
+
+/// Every joined value of one commit for `execution`, binding `blobs`.
+struct Material {
+    receipt: ReceiptCandidate,
+    association: AssociationCandidate,
+    manifest: Vec<u8>,
+    inventory: Vec<u8>,
+    run: String,
+}
+fn material(execution: &str, sequence: u64, journal_seq: u64, blobs: &[&[u8]]) -> Material {
+    let manifest = canonical(object(vec![
+        ("schemaVersion", int(3)),
+        ("projectId", s(&format!("prj1-{}", "a".repeat(64)))),
+        // Each execution's Run is distinct.
+        (
+            "snapshotId",
+            s(&format!("snapshot2:{0}{0}", &execution[6..])),
+        ),
+        ("planId", s(&format!("plan2:{}", "c".repeat(64)))),
+        ("evidenceId", s(&format!("evidence3:{}", "d".repeat(64)))),
+        ("evaluationSealId", s(&format!("seal3:{}", "e".repeat(64)))),
+        ("capabilityManifestId", s(&"f".repeat(64))),
+    ]));
+    let run = format!(
+        "run3:{}",
+        digest_hex(&hash_canonical_value("run", &parse_json(&manifest).unwrap()).unwrap())
+    );
+    let mut digests: Vec<String> = blobs.iter().map(|b| hex(b)).collect();
+    digests.sort();
+    let inventory = canonical(object(vec![
+        ("schemaVersion", int(2)),
+        ("runId", s(&run)),
+        ("objects", V::Array(Vec::new())),
+        (
+            "blobDigests",
+            V::Array(digests.iter().map(|d| s(d)).collect()),
+        ),
+    ]));
+    let inventory_digest = hex(&inventory);
+    let receipt = ReceiptCandidate::parse(&canonical(object(vec![
+        ("schemaVersion", int(2)),
+        ("runId", s(&run)),
+        ("executionId", s(execution)),
+        ("namespaceId", s(N)),
+        ("commitSequence", int(sequence.into())),
+        ("inventoryDigest", s(&inventory_digest)),
+        ("sealedAssurance", s("replayable")),
+        ("signerKeyId", s("signer")),
+    ])))
+    .unwrap();
+    let association = AssociationCandidate::parse(&canonical(object(vec![
+        ("recordSchema", int(1)),
+        ("storeGenerationDigest", s(&"ab".repeat(32))),
+        ("namespaceId", s(N)),
+        ("executionId", s(execution)),
+        ("runId", s(&run)),
+        ("inventoryDigest", s(&inventory_digest)),
+        ("commitSequence", s(&sequence.to_string())),
+        ("receiptBytesSha256", s(&hex(&receipt.raw))),
+        ("journalCarrierDigest", s(CARRIER)),
+        ("grantGeneration", int(1)),
+        ("journalSeq", int(journal_seq.into())),
+        ("journalBodySha256", s(&"1".repeat(64))),
+        ("operationRef", s(&format!("op-{}", "cd".repeat(16)))),
+    ])))
+    .unwrap();
+    Material {
+        receipt,
+        association,
+        manifest,
+        inventory,
+        run,
+    }
+}
+fn availability(schemas: &RegisteredSchemas, run: &str, generation: u64) -> AvailabilityRecord {
+    AvailabilityRecord::parse(
+        schemas,
+        &canonical(object(vec![
+            ("schemaVersion", int(2)),
+            ("runId", s(run)),
+            ("generation", int(generation.into())),
+            ("state", s("retained")),
+            ("missingRefs", V::Array(Vec::new())),
+            ("reason", s("observed")),
+        ])),
+        2_000_000,
+    )
+    .unwrap()
+}
+fn pins(run: &str) -> Inventory {
+    Inventory::from_rows(run.into(), vec![("baseline-1".into(), "baseline".into())]).unwrap()
+}
+const LIMITS: StagingLimits = StagingLimits {
+    per_record_work: 2_000_000,
+    pin_rows: 10_000,
+    pin_text_bytes: 1 << 20,
+};
+fn rows<'a>(
+    m: &'a Material,
+    availability: AvailabilityRecord,
+    pins: &'a Inventory,
+) -> CommitRows<'a> {
+    CommitRows {
+        carrier: CARRIER,
+        receipt: &m.receipt,
+        association: &m.association,
+        manifest: m.manifest.clone(),
+        inventory: m.inventory.clone(),
+        availability,
+        pins,
+    }
+}
+fn stage(
+    setup: &mut Setup,
+    prepared: PreparedLedger,
+    schemas: &RegisteredSchemas,
+    rows: CommitRows<'_>,
+) -> Refused<PreparedLedgerCommit> {
+    operation(&mut setup.work, |w| {
+        prepared.stage(schemas, rows, LIMITS, w)
+    })
+}
