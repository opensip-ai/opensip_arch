+#[test]
+fn objects_are_published_new_then_confirmed_and_never_overwritten() {
+    let mut setup = Setup::new();
+    let attempt = setup.attempt(EXEC);
+    let published = setup
+        .publish(&attempt, vec![declared(A), declared(B), declared(b"")])
+        .unwrap();
+    assert_eq!(published.objects().len(), 3);
+    for (object, bytes) in published.objects().iter().zip([A, B, b""]) {
+        assert_eq!(object.disposition(), ObjectDisposition::PublishedNew);
+        assert_eq!(object.digest(), hex(bytes));
+        assert_eq!(object.length(), bytes.len() as u64);
+        assert!(matches!(
+            object.barrier(),
+            DirectoryBarrier::FullFlush | DirectoryBarrier::Fsync
+        ));
+        let path = setup.objects_path().join(object.digest());
+        assert_eq!(fs::read(&path).unwrap(), bytes);
+        let m = fs::symlink_metadata(&path).unwrap();
+        assert!(m.is_file());
+        assert_eq!(m.mode() & 0o7777, 0o600);
+        assert_eq!(m.nlink(), 1);
+    }
+    // No temporary file is left behind by a completed publication.
+    assert_eq!(
+        setup.entries(),
+        [hex(A), hex(B), hex(b"")].into_iter().collect()
+    );
+    // A second attempt in the same namespace confirms every existing name
+    // byte for byte and completes its own barriers; nothing is rewritten.
+    let inode = fs::metadata(setup.objects_path().join(hex(A)))
+        .unwrap()
+        .ino();
+    let second = setup.attempt(EXEC2);
+    let again = setup
+        .publish(&second, vec![declared(A), declared(B)])
+        .unwrap();
+    assert!(
+        again
+            .objects()
+            .iter()
+            .all(|o| o.disposition() == ObjectDisposition::ConfirmedExisting)
+    );
+    assert_eq!(
+        fs::metadata(setup.objects_path().join(hex(A)))
+            .unwrap()
+            .ino(),
+        inode
+    );
+    assert!(!setup.work.is_failed());
+}
