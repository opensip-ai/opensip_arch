+    )
+    .unwrap();
+    assert!(matches!(
+        adapter.commit(),
+        LedgerCommitOutcome::Committed { .. }
+    ));
+    let second = setup.attempt(EXEC2);
+    type Case = fn(&RegisteredSchemas) -> (Material, Option<AvailabilityRecord>, Option<Inventory>);
+    let cases: [(&str, Case); 6] = [
+        // The receipt pair collides with the prior commit's sequence (the pair
+        // is the first insert: nothing else is reached).
+        ("pair sequence", |_| {
+            (material(EXEC2, 1, 8, &[A, B]), None, None)
+        }),
+        // Run material whose blobs differ from the published objects.
+        ("blob set", |_| (material(EXEC2, 2, 8, &[A]), None, None)),
+        // Availability for another Run, after the pair and material.
+        ("availability run", |schemas| {
+            let m = material(EXEC2, 2, 8, &[A, B]);
+            (
+                m,
+                Some(availability(
+                    schemas,
+                    &format!("run3:{}", "9".repeat(64)),
+                    0,
+                )),
+                None,
+            )
+        }),
+        // A non-initial availability generation.
+        ("availability generation", |schemas| {
+            let m = material(EXEC2, 2, 8, &[A, B]);
+            let a = availability(schemas, &m.run, 1);
+            (m, Some(a), None)
+        }),
+        // Pins for another Run, the last stager.
+        ("pins run", |_| {
+            let m = material(EXEC2, 2, 8, &[A, B]);
+            (m, None, Some(pins(&format!("run3:{}", "9".repeat(64)))))
+        }),
+        // The prior commit's pin facts already hold this operationRef.
+        ("pin operation reused", |_| {
+            (material(EXEC2, 2, 8, &[A, B]), None, None)
+        }),
+    ];
+    for (name, case) in cases {
+        let (m, a, p) = case(&schemas);
+        let a = a.unwrap_or_else(|| availability(&schemas, &m.run, 0));
+        let p = p.unwrap_or_else(|| pins(&m.run));
+        let published = setup
+            .publish(&second, vec![declared(A), declared(B)])
+            .unwrap();
+        let prepared = setup.begin(&second, published).unwrap();
+        let result = stage(&mut setup, prepared, &schemas, rows(&m, a, &p));
+        assert_eq!(row(result), ProjectLedgerRow::Invariant, "{name}");
+        // The failed attempt's ledger is closed; a new one continues.
+        let mut fresh = WorkLedger::new();
+        std::mem::swap(&mut setup.work, &mut fresh);
+        for table in [
+            "commit_receipts",
+            "commit_associations",
+            "commit_run_material",
+            "evidence_availability",
+            "active_run_pins",
+            "pin_change_facts",
+        ] {
+            assert_eq!(setup.count(table), 1, "{name}: {table}");
+        }
+        assert!(setup.entries().contains(&hex(B)), "{name}: objects stay");
+        assert_eq!(setup.attempt_phase(EXEC2), "admitted");
+    }
+}
