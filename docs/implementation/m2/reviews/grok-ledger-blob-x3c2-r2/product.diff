+impl WriteTransaction {
+    /// Law X3c r7 item 6: stage the Run's manifest and commit inventory in the
+    /// open transaction, after the receipt pair. The stored schema must be the
+    /// selected DDL, the receipt staged in this transaction must name `run`,
+    /// and both bodies are admitted exactly as recovery reads them (manifest
+    /// identity, canonical bytes, inventory Run and the receipt's inventory
+    /// digest). Returns the inventory's blob digests for the caller's exact
+    /// comparison with its published objects. A failed INSERT poisons this
+    /// transaction. Nothing is committed here.
+    pub(super) fn stage_run_material(
+        &mut self,
+        schemas: &RegisteredSchemas,
+        binding: &SuppliedBinding<'_>,
+        inventory_digest: &str,
+        manifest: Vec<u8>,
+        inventory: Vec<u8>,
+        work: usize,
+    ) -> Result<Vec<String>, LedgerError> {
+        if self.poisoned {
+            return Err(LedgerError::Configuration("transaction_poisoned"));
+        }
+        let expected = Connection::open_in_memory()?;
+        expected.execute_batch(DDL)?;
+        if definitions(&self.connection)? != definitions(&expected)? {
+            return Err(LedgerError::Configuration("run_material_schema"));
+        }
+        let run = paired_run(&self.connection, binding)?;
+        let material = parse_material(schemas, &run, inventory_digest, manifest, inventory, work)
+            .map_err(LedgerError::RunMaterial)?;
+        self.poisoned = true;
+        let changed = self.connection.execute(
+            "INSERT INTO commit_run_material VALUES(?1,?2,?3,?4,?5,?6)",
+            rusqlite::params![
+                binding.store,
+                binding.namespace,
+                binding.execution,
+                run,
+                material.manifest,
+                material.inventory
+            ],
+        )?;
+        if changed != 1 {
+            return Err(LedgerError::Configuration("run_material_insert_count"));
+        }
+        self.poisoned = false;
+        Ok(material.blobs)
+    }
+}
