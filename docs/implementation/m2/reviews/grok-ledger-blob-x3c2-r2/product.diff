+#[test]
+fn the_ledger_transaction_never_waits_and_holds_nothing_when_busy() {
+    let mut setup = Setup::new();
+    let attempt = setup.attempt(EXEC);
+    let other = rusqlite::Connection::open(setup.ledger_path()).unwrap();
+    other.busy_timeout(Duration::ZERO).unwrap();
+    other.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let published = setup.publish(&attempt, vec![declared(A)]).unwrap();
+    let started = Instant::now();
+    assert_eq!(
+        row(setup.begin(&attempt, published)),
+        ProjectLedgerRow::Busy
+    );
+    assert!(started.elapsed() < Duration::from_secs(1), "never waits");
+    other.execute_batch("ROLLBACK").unwrap();
+    // The refused call holds no transaction: another writer proceeds at once.
+    other.execute_batch("BEGIN IMMEDIATE; ROLLBACK").unwrap();
+    // A held prepared ledger is itself the level-3 writer others see busy.
+    // (The refused operation's ledger is closed; a new operation continues.)
+    let mut fresh = WorkLedger::new();
+    std::mem::swap(&mut setup.work, &mut fresh);
+    let published = setup.publish(&attempt, vec![declared(A)]).unwrap();
+    let prepared = setup.begin(&attempt, published).unwrap();
+    assert!(other.execute_batch("BEGIN IMMEDIATE").is_err());
+    drop(prepared);
+    other.execute_batch("BEGIN IMMEDIATE; ROLLBACK").unwrap();
+}
