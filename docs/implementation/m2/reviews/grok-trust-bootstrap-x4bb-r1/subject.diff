+#[test]
+fn the_gate_follows_two_confirmed_publications_of_one_hold_in_order() {
+    // X4T-b judgment call 9 with X4B-b: a fence hold whose first read
+    // confirmed the acceptance and then a floor write advances the gate after
+    // each, in order; the second before the first is a changed file.
+    use crate::trust::{RetainedCurrentTrust, publish_trust};
+    use opensip_platform::WorkLedger;
+    for in_order in [true, false] {
+        let (_scratch, home) = scratch();
+        let (r, _s) = published(&format!("x4bb-advance-{in_order}"), &home);
+        let mut gate = new_gate(None);
+        let mut admitted = run(&mut gate, &r, &home, &Probe::default(), &live, &nothing).unwrap();
+        let confirmations = {
+            let read = admitted.current_trust();
+            let file = read.file.expect("state.v1 is a required file");
+            let raw = read.raw.to_vec();
+            let sample = file.metadata().clone();
+            let opensip_identity::JsonValue::Object(capsule) =
+                opensip_identity::parse_json(&raw).unwrap()
+            else {
+                panic!("capsule")
+            };
+            let fence = GateFence {
+                i: read.installation,
+                uid: read.uid,
+                groups: Default::default(),
+            };
+            WorkLedger::new()
+                .scope(|work| {
+                    let mut owner = RetainedCurrentTrust::bind(
+                        read.installation,
+                        read.uid,
+                        &capsule["store"],
+                        &raw,
+                        &sample,
+                        work,
+                    )
+                    .map_err(|e| WorkFailure::Operation(format!("{e:?}")))?;
+                    for _ in 0..2 {
+                        publish_trust(&fence, &mut owner, &[], &raw, work)
+                            .map_err(|e| WorkFailure::Operation(format!("{e:?}")))?;
+                    }
+                    Ok(owner.confirmations().to_vec())
+                })
+                .unwrap()
+        };
+        assert_eq!(confirmations.len(), 2);
+        assert_eq!(confirmations[1].predecessor(), confirmations[0].metadata());
+        if in_order {
+            for confirmed in &confirmations {
+                admitted.advance_current(confirmed).unwrap();
+            }
+            assert_eq!(
+                admitted.current_trust().file.unwrap().metadata(),
+                confirmations[1].metadata()
+            );
+            gate.recheck(&admitted, &r.platform).unwrap();
+        } else {
+            assert!(matches!(
+                admitted.advance_current(&confirmations[1]),
+                Err(GateRefusal::Custody(CustodyRefusal::Changed))
+            ));
+        }
+        admitted.release().unwrap();
+    }
+}
