+/// Item 1 step 2's order, over any admission and acceptance: one
+/// admission; on F absent only, the acceptance and then the one confirming
+/// admission, whose F absent is the host invariant row. Any other first
+/// result, a view or another refusal, is returned as is and nothing else
+/// runs. No third admission runs.
+fn first_read_sequence<S, R>(
+    state: &mut S,
+    mut admit: impl FnMut(&mut S) -> Result<R, TrustRefusal>,
+    accept: impl FnOnce(&mut S) -> Result<(), TrustRefusal>,
+) -> Result<R, TrustRefusal> {
+    match admit(state) {
+        Err(refusal) if refusal.row == TrustRow::NoAdmittedTimeContext => {}
+        other => return other,
+    }
+    accept(state)?;
+    match admit(state) {
+        Err(refusal) if refusal.row == TrustRow::NoAdmittedTimeContext => {
+            refuse(TrustRow::Invariant, ("second-f-absent", refusal.cause))
+        }
+        other => other,
+    }
+}
+
+/// Item 1 step 2 (unit X4B-b): the body of the operation monitor's single
+/// first `read`, under the held fence with no project lock and before any
+/// lease, all on the caller's ledger (item 8):
+/// 1. X4T's fenced admission (with its write-ahead) on the retained owner;
+/// 2. on F absent only, and only for a fenced read that is not report-only,
+///    items 2 to 6 on `inputs.observation`, the read's own clock sample:
+///    the payload of `source`, then `accept_bootstrap`, whose confirmed
+///    `state.v1` replaces the retained owner;
+/// 3. the one confirming admission on that owner, same sample, returned.
+///
+/// Every confirmed publication stays on the owner, in order
+/// (`RetainedCurrentTrust::confirmations`), for the gate to follow.
+pub(crate) fn bootstrapping_first_read(
+    work: &mut WorkScope<'_>,
+    fence: &dyn HeldFence,
+    owner: &mut RetainedCurrentTrust,
+    inputs: &ViewInputs<'_>,
+    invocation: &V,
+    source: &BootstrapSource<'_>,
+) -> Result<AdmittedCurrentTrust, TrustRefusal> {
+    if !matches!(inputs.mode, ReadMode::Fenced { report: false }) {
+        // Report-only (458c's mode): F absent is reported, never accepted.
+        return fenced_first_read(work, fence, owner, inputs, invocation);
+    }
+    let mut state = (work, owner);
+    first_read_sequence(
+        &mut state,
+        |(work, owner)| fenced_first_read(work, fence, owner, inputs, invocation),
+        |(work, owner)| {
+            let observation = inputs
+                .observation
+                .map_or_else(|| refuse(TrustRow::HostIo, "observation"), Ok)?;
+            let payload = source.payload(work)?;
+            accept_bootstrap(work, fence, owner, &payload, observation, invocation).map(|_| ())
+        },
+    )
+}
