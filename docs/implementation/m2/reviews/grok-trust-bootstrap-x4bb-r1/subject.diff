+/// Item 2: the F-absent branch's one payload source, the running core's
+/// `InitialCore` that X1's write receipt retains. Only the write receipt
+/// lends one (`WritePlatformReceipt::bootstrap_source`), so no read session
+/// can bootstrap. The payload is copied, and charged, only on F absent.
+pub(crate) struct BootstrapSource<'a> {
+    core: Option<&'a super::super::super::InitialCore>,
+}
+impl std::fmt::Debug for BootstrapSource<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BootstrapSource").finish_non_exhaustive()
+    }
+}
+impl<'a> BootstrapSource<'a> {
+    /// The running core's embedded bootstrap payload (item 2).
+    pub(crate) fn running_core(core: &'a super::super::super::InitialCore) -> Self {
+        Self { core: Some(core) }
+    }
+    /// A test of a store that is never F absent (X4T-0's accepted stores):
+    /// reaching the branch is the host invariant row.
+    #[cfg(test)]
+    pub(crate) fn unreached() -> Self {
+        Self { core: None }
+    }
+    fn payload(&self, work: &mut WorkScope<'_>) -> Result<BootstrapPayload, TrustRefusal> {
+        match self.core {
+            Some(core) => BootstrapPayload::from_initial_core(core, work),
+            None => refuse(TrustRow::Invariant, "bootstrap-source"),
+        }
+    }
