    "file": {
      "anchorLaw": {
        "cardinality": 0,
        "class": "inventory",
        "rule": "The claim is the snapshot inventory row itself: path, content digest and byte length, all joined by this relation`s own inventoried-file snapshotJoin over the retained bytes. Nothing further was read, so nothing further is cited."
      },
      "bodyIdentityJoin": false,
      "coverageTotality": {
        "matchLaw": "A fact discharges THIS scope's obligation only if it agrees with the scope on EVERY coordinate listed in matchOn. Those are the four CoverageKeyV2 coordinates other than the subject-scope commitment itself, plus the owning snapshot. An earlier revision matched relation and resolution ALONE, and that is not enough in a view that carries more than one universe: the view-level fact/scope join is EXISTENTIAL - each fact must agree with SOME scope on relation, rung and both universes - so a TypeScript file fact is lawfully in a view that also carries a syntax-universe scope, and it then paid that scope's missing-file obligation. A complete Run exhibited exactly that (root diagnostic attempt3: two complete file@enumerated scopes for `a.ts`, only the TypeScript fact, ADMIT). Totality is a claim about what THIS universe examined, so it must be discharged by evidence produced in THIS universe; a fact from another universe is a different interpretation of the same bytes and is not the same observation.",
        "matchOn": [
          "snapshotId",
          "relation",
          "resolution",
          "sourceUniverse",
          "targetUniverse"
        ],
        "over": "subjects",
        "pathField": "path",
        "refusal": "COVERAGE_INVENTORY_TOTALITY_OMITS_PATH",
        "rule": "When a subject-scope for file@enumerated carries entry.coverage `complete`, every one of its subjects that appears in the analysed snapshot sourceInventory must have an admitted file@enumerated fact in the same view whose payload `path` is that subject. A subject outside the inventory is owed nothing.",
        "rung": "enumerated",
        "snapshotIsListedDeliberately": "The owning snapshot is already forced transitively - Run closure requires every fact and every subject-scope to carry the Run's own snapshotId - so listing it changes no outcome today, and a control confirms the transitive refusal (REFERENCE_SOURCE_JOIN). It is listed anyway because this law reads ONE scope's obligation out of a SHARED view, and a join that silently depends on an invariant enforced somewhere else is the same class of implicit coupling that produced the cross-universe defect."
      },
      "inheritedOptional": [],
      "inheritedRequired": [
        "byteLength",
        "contentSha256",
        "path"
      ],
      "ladder": [
        "enumerated"
      ],
      "rungs": {},
      "selector": "#/$defs/FilePayloadV1",
      "snapshotJoins": [
        {
          "anchorPathField": "path",
          "digestField": "contentSha256",
          "form": "inventoried-file",
          "lengthField": "byteLength",
          "note": "anchorPathField closes the second-owner case: a file payload is admissible only under a fact whose every anchor lies in the very file the payload claims, so an arbitrary anchor can never be borrowed to satisfy a foreign file claim. It is universally quantified, so it says nothing at zero anchors and it never covered `package` or `vcs-change` at all; the registry `anchorLaw` now closes the inventory class at zero anchors and refuses the borrowed anchor for all three relations before this row is reached. This row is retained as the narrower statement it always was, not as the operative inventory defence.",
          "pathField": "path",
          "retainedBlob": true
        }
      ],
