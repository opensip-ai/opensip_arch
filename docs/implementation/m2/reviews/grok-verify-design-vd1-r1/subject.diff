+class PassageSupersessionTests(unittest.TestCase):
+    """VD1: an explicit, linear supersession of an inventory description meaning.
+
+    History: inv0 rows b.py(0) d.py(1); inv1 adds c.py, so d.py is /files/2;
+    inv2 (history(2)) adds a.py, so d.py is /files/3.
+    """
+
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.fx = Fx(tmp.name)
