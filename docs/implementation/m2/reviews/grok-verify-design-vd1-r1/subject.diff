+    def inherited_root(self, count=1):
+        pins = self.history(count)
+        base, final = pins[0], pins[-1]
+        root = self.fx.contract([base], [ov(base, 1, 'D0', 'D1')])['record']
+        index = 2 if count == 1 else 3
+        self.fx.lock['inventoryPassageInheritance'] = [proj(final, index, 'D0', 'D1')]
+        return pins, root
+
+    def test_supersession_of_inherited_row_on_final_inventory(self):
+        (base, final), root = self.inherited_root()
+        self.fx.contract([final], supersessions=[sup(final, 2, 'D1', 'D2', root, base, 1)])
+        result = self.verify()
+        self.assertEqual(result['inventoryPassageSupersessions'], 1)
+        # A final-inventory link is checked, not projected: the lock is unchanged.
+        self.assertEqual(result['inventoryPassageInheritance'], [proj(final, 2, 'D0', 'D1')])
+
+    def test_chain_of_supersessions_extends_the_tail(self):
+        (base, final), root = self.inherited_root()
+        first = self.fx.contract([final], supersessions=[sup(final, 2, 'D1', 'D2', root, base, 1)])['record']
+        self.fx.contract([final], supersessions=[sup(final, 2, 'D2', 'D3', first, final, 2)])
+        self.assertEqual(self.verify()['inventoryPassageSupersessions'], 2)
+
+    def test_supersession_of_direct_final_override(self):
