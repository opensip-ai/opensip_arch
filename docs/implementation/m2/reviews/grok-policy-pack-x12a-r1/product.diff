+//! Law X12 r3 item 10, evaluator side (unit X12a). The synthetic test registry
+//! below is compiled only under cfg(test); a source pin shows that no
+//! production path names it.
+extern crate std;
+use super::*;
+use alloc::{string::ToString, vec};
+use opensip_identity::{IdentityCandidate, ObjectInput};
+use std::sync::OnceLock;
+
+const TEST_ID: &str = "opensip.test.fixture.pack:1";
+const TEST_SHA: &str = "24e412654bdec20bb256bc0582a1d6bfa0bbabb57a9857a0a18a08b3dd5af01d";
+// The golden-typescript compiled program digest of plan-policy-fixtures.json,
+// which compiles the same policy blob through compile_plan_policy.
+const TEST_PROGRAM_SHA: &str = "41f496a3b9f4d7ada615e517f9bcfb0a3c439323328f3ba19205a7a8a4fb7048";
+const TEST_DOCUMENT: &[u8] =
+    include_bytes!("../tests/fixtures/policy-pack-test-fixture.policy.json");
+const TEST_PACKS: PackRegistry<'static> = PackRegistry {
+    rows: include_bytes!("../tests/fixtures/policy-pack-test-registry.json"),
+    documents: &[("policy-pack-test-fixture.policy.json", TEST_DOCUMENT)],
+};
+const WORK: usize = 10_000_000;
+
+fn schemas() -> &'static RegisteredSchemas {
+    static SCHEMAS: OnceLock<RegisteredSchemas> = OnceLock::new();
+    SCHEMAS.get_or_init(|| {
+        let root = concat!(env!("CARGO_MANIFEST_DIR"), "/../../");
+        let raw: Vec<Vec<u8>> = RegisteredSchemas::source_requirements()
+            .iter()
+            .map(|p| std::fs::read(format!("{root}{}", p.source_path())).unwrap())
+            .collect();
+        let refs: Vec<&[u8]> = raw.iter().map(Vec::as_slice).collect();
+        RegisteredSchemas::from_sources(&refs).unwrap()
+    })
+}
+fn admit(registry: &PackRegistry<'_>, source: PackSource<'_>) -> Result<AdmittedPack, PackRefusal> {
+    admit_from(registry, schemas(), &source, PACK_TRAVERSAL_STEPS)
+}
+fn named(registry: &PackRegistry<'_>, id: &str) -> Result<AdmittedPack, PackRefusal> {
+    admit(registry, PackSource::Named(id))
+}
+fn supplied(bytes: &[u8], provenance: SuppliedProvenance) -> PackSource<'_> {
+    PackSource::Supplied { bytes, provenance }
+}
+const BOTH: [SuppliedProvenance; 2] = [SuppliedProvenance::User, SuppliedProvenance::ThirdParty];
+fn hex32(s: &str) -> [u8; 32] {
+    lower_hex(s).unwrap()
+}
+fn test_document() -> V {
+    parse_json(TEST_DOCUMENT).unwrap()
+}
+/// Insert `value` at a pointer whose parent exists (`/a/0/b`).
+fn put(doc: &mut V, pointer: &str, value: V) {
+    let parts: Vec<&str> = pointer[1..].split('/').collect();
+    let (last, path) = parts.split_last().unwrap();
+    let mut node = doc;
+    for part in path {
+        node = match node {
+            V::Object(o) => o.get_mut(*part).unwrap(),
+            V::Array(a) => &mut a[part.parse::<usize>().unwrap()],
+            _ => panic!("{pointer}"),
+        };
+    }
+    match node {
+        V::Object(o) => {
+            o.insert((*last).into(), value);
+        }
+        V::Array(a) => a[last.parse::<usize>().unwrap()] = value,
+        _ => panic!("{pointer}"),
+    }
+}
+fn bytes_of(doc: &V) -> Vec<u8> {
+    canonical_bytes(doc).unwrap()
+}
+fn s(v: &str) -> V {
+    V::String(v.into())
+}
+/// (packId, name, version, policyDocument, policySha256, contributions)
+type Row<'a> = (&'a str, &'a str, i128, &'a str, &'a str, &'a [&'a str]);
+type PlanInputs = (
+    String,
+    BTreeMap<String, ObjectInput>,
+    BTreeMap<[u8; 32], Vec<u8>>,
+);
+fn registry_rows(rows: &[Row<'_>]) -> Vec<u8> {
+    let mut out = String::from("{\"schemaVersion\":1,\"standing\":\"test\",\"rows\":[");
+    for (i, (id, name, version, doc, sha, contributions)) in rows.iter().enumerate() {
+        if i > 0 {
+            out.push(',');
+        }
+        let c: Vec<String> = contributions.iter().map(|c| format!("\"{c}\"")).collect();
+        out.push_str(&format!(
+            "{{\"packId\":\"{id}\",\"name\":\"{name}\",\"version\":{version},\"policyDocument\":\"{doc}\",\"policySha256\":\"{sha}\",\"contributions\":[{}]}}",
+            c.join(",")
+        ));
+    }
+    out.push_str("]}");
+    out.into_bytes()
+}
+fn one_row(document: &[u8], sha: &str, contributions: &[&str]) -> (Vec<u8>, Vec<u8>, String) {
+    (
+        registry_rows(&[(
+            TEST_ID,
+            "opensip.test.fixture.pack",
+            1,
+            "pack.json",
+            sha,
+            contributions,
+        )]),
+        document.to_vec(),
+        format!("pack:{TEST_ID}"),
+    )
+}
+fn defect(rows: &[u8], document: &[u8]) -> PackRefusal {
+    let documents = [("pack.json", document)];
+    let registry = PackRegistry {
+        rows,
+        documents: &documents,
+    };
+    named(&registry, TEST_ID).unwrap_err()
+}
