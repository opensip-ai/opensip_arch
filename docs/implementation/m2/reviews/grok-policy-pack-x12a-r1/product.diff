+#[test]
+fn self_inconsistent_registries_are_row_4() {
+    let fault = |id: &str| PackRefusal::HostInvariant {
+        subject: format!("pack:{id}"),
+        defect: PackDefect::Registry,
+    };
+    let row = |id, name, version, sha: &'static str| {
+        (id, name, version, "pack.json", sha, &["fixture"][..])
+    };
+    let bad_rows: Vec<Vec<u8>> = vec![
+        // packId differs from name:version.
+        registry_rows(&[row(TEST_ID, "opensip.test.fixture.pack", 2, TEST_SHA)]),
+        registry_rows(&[row(
+            "opensip.test.fixture.pack:01",
+            "opensip.test.fixture.pack",
+            1,
+            TEST_SHA,
+        )]),
+        registry_rows(&[row(
+            "Opensip.test.fixture.pack:1",
+            "Opensip.test.fixture.pack",
+            1,
+            TEST_SHA,
+        )]),
+        registry_rows(&[row(
+            "opensip.test:fixture:1",
+            "opensip.test:fixture",
+            1,
+            TEST_SHA,
+        )]),
+        registry_rows(&[row(
+            "opensip.test.fixture.pack:0",
+            "opensip.test.fixture.pack",
+            0,
+            TEST_SHA,
+        )]),
+        // Uppercase digest.
+        registry_rows(&[row(
+            TEST_ID,
+            "opensip.test.fixture.pack",
+            1,
+            "24E412654BDEC20BB256BC0582A1D6BFA0BBABB57A9857A0A18A08B3DD5AF01D",
+        )]),
+        // Duplicate rows (and so a document used twice).
+        registry_rows(&[
+            row(TEST_ID, "opensip.test.fixture.pack", 1, TEST_SHA),
+            row(TEST_ID, "opensip.test.fixture.pack", 1, TEST_SHA),
+        ]),
+        // A document the table does not hold.
+        registry_rows(&[(
+            TEST_ID,
+            "opensip.test.fixture.pack",
+            1,
+            "absent.json",
+            TEST_SHA,
+            &["fixture"],
+        )]),
+        // An empty contribution set.
+        registry_rows(&[(
+            TEST_ID,
+            "opensip.test.fixture.pack",
+            1,
+            "pack.json",
+            TEST_SHA,
+            &[],
+        )]),
+        // Unknown or missing keys.
+        b"{\"schemaVersion\":1,\"standing\":\"x\",\"rows\":[],\"extra\":1}".to_vec(),
+        b"{\"schemaVersion\":2,\"standing\":\"x\",\"rows\":[]}".to_vec(),
+        b"{\"schemaVersion\":1,\"rows\":[]}".to_vec(),
+        b"not json".to_vec(),
+    ];
+    for rows in &bad_rows {
+        assert_eq!(
+            defect(rows, TEST_DOCUMENT),
+            fault(TEST_ID),
+            "{}",
+            String::from_utf8_lossy(rows)
+        );
+    }
+    // A document no row names.
+    let empty = registry_rows(&[]);
+    assert_eq!(defect(&empty, TEST_DOCUMENT), fault(TEST_ID));
+    // An empty registry with an empty table is consistent: not bundled.
+    let registry = PackRegistry {
+        rows: &empty,
+        documents: &[],
+    };
+    assert_eq!(
+        named(&registry, TEST_ID).unwrap_err(),
+        PackRefusal::NotBundled {
+            pack_id: TEST_ID.into()
+        }
+    );
+}
