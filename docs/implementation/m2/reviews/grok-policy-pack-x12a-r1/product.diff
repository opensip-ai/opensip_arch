+#[test]
+fn check_plan_pack_joins_analysis_spec_and_policy_digest() {
+    let refused = |cause: &str| Err::<(), _>(PolicyAdmissionError::Refused(cause.into()));
+    // The synthetic corpus Plan names "fixture.file-observed": not bundled.
+    for registry in [&RELEASE_PACKS, &TEST_PACKS] {
+        assert_eq!(
+            plan_check(registry, &["fixture.file-observed"], None, 1000).map(|_| ()),
+            refused("PLAN_POLICY_PACK_NOT_BUNDLED")
+        );
+    }
+    // A test-pack Plan with the matching digest joins.
+    let checks = plan_check(&TEST_PACKS, &[TEST_ID], Some(TEST_SHA), 1000).unwrap();
+    assert_eq!(checks.pack_id(), TEST_ID);
+    // In M2 the release registry bundles nothing, so the same Plan is refused.
+    assert_eq!(
+        plan_check(&RELEASE_PACKS, &[TEST_ID], Some(TEST_SHA), 1000).map(|_| ()),
+        refused("PLAN_POLICY_PACK_NOT_BUNDLED")
+    );
+    // Any other policy digest is refused.
+    for other in [
+        "0".repeat(64),
+        "f710d52e75330cef453dbb4f11e4c59e2bf4d12f5a9e0d0e7eb67235f5a7e3f3".into(),
+    ] {
+        assert_eq!(
+            plan_check(&TEST_PACKS, &[TEST_ID], Some(&other), 1000).map(|_| ()),
+            refused("PLAN_POLICY_PACK_DIGEST")
+        );
+    }
+    // Exactly one pack: zero, two, or an unversioned ID.
+    assert_eq!(
+        plan_check(&TEST_PACKS, &[], Some(TEST_SHA), 1000).map(|_| ()),
+        refused("PLAN_POLICY_PACK_COUNT")
+    );
+    assert_eq!(
+        plan_check(
+            &TEST_PACKS,
+            &[TEST_ID, "opensip.test.other.pack:1"],
+            Some(TEST_SHA),
+            1000
+        )
+        .map(|_| ()),
+        refused("PLAN_POLICY_PACK_COUNT")
+    );
+    assert_eq!(
+        plan_check(
+            &TEST_PACKS,
+            &["opensip.test.fixture.pack"],
+            Some(TEST_SHA),
+            1000
+        )
+        .map(|_| ()),
+        refused("PLAN_POLICY_PACK_NOT_BUNDLED")
+    );
+    assert!(matches!(
+        plan_check(&TEST_PACKS, &[TEST_ID], Some(TEST_SHA), 0),
+        Err(PolicyAdmissionError::Limit)
+    ));
+    // A self-inconsistent registry is the registry law fault.
+    let broken = PackRegistry {
+        rows: b"{}",
+        documents: &[],
+    };
+    assert!(matches!(
+        plan_check(&broken, &[TEST_ID], Some(TEST_SHA), 1000),
+        Err(PolicyAdmissionError::RegistryLaw)
+    ));
+}
