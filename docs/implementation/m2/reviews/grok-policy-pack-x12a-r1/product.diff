+/// The imperative classifier of workflows-and-surfaces §5, applied exactly
+/// (law X12 r3 item 6.2): a member that no closed PolicyDocumentV2 alternative
+/// declares at its position, or a string where every closed alternative at its
+/// position is an object. The first such member in canonical order wins.
+struct Classifier {
+    documents: BTreeMap<String, V>,
+}
+const ANNOTATIONS: &[&str] = &["description", "default", "title"];
+fn annotation(key: &str) -> bool {
+    ANNOTATIONS.contains(&key) || key.starts_with("x-")
+}
+impl Classifier {
+    fn load(schemas: &RegisteredSchemas) -> Result<Self, PackDefect> {
+        let mut documents = BTreeMap::new();
+        for raw in CLASSIFIER_SOURCES {
+            let document = parse_json(raw).map_err(|_| PackDefect::Registry)?;
+            let id = match optional(&document, "$id") {
+                Some(V::String(id)) => id.clone(),
+                _ => return Err(PackDefect::Registry),
+            };
+            let pin = RegisteredSchemas::source_requirements()
+                .iter()
+                .find(|p| p.schema_id() == id)
+                .ok_or(PackDefect::Registry)?;
+            if pin.bytes() != raw.len() || pin.sha256() != raw_sha256(raw) {
+                return Err(PackDefect::Registry);
+            }
+            if id == POLICY_SCHEMA_ID
+                && schemas
+                    .schema(POLICY_SCHEMA_ID, POLICY_SCHEMA_SELECTOR)
+                    .map_err(|_| PackDefect::Registry)?
+                    .document_sha256()
+                    != pin.sha256()
+            {
+                return Err(PackDefect::Registry);
+            }
+            if documents.insert(id, document).is_some() {
+                return Err(PackDefect::Registry);
+            }
+        }
+        Ok(Self { documents })
+    }
+    fn resolve<'s>(
+        &'s self,
+        owner: &'s str,
+        reference: &str,
+    ) -> Result<(&'s str, &'s V), PackDefect> {
+        let (doc, pointer) = reference.split_once('#').ok_or(PackDefect::Registry)?;
+        let (id, mut node) = if doc.is_empty() {
+            let (k, v) = self
+                .documents
+                .get_key_value(owner)
+                .ok_or(PackDefect::Registry)?;
+            (k.as_str(), v)
+        } else {
+            let (k, v) = self
+                .documents
+                .get_key_value(doc)
+                .ok_or(PackDefect::Registry)?;
+            (k.as_str(), v)
+        };
+        let path = pointer.strip_prefix('/').ok_or(PackDefect::Registry)?;
+        for part in path.split('/') {
+            let part = part.replace("~1", "/").replace("~0", "~");
+            node = optional(node, &part).ok_or(PackDefect::Registry)?;
+        }
+        Ok((id, node))
+    }
+    /// Expand $ref, oneOf and anyOf into leaf alternatives. A combinator may
+    /// carry only annotations beside it; a leaf object alternative must be
+    /// closed. Anything else is a classifier law fault (row 4).
+    fn expand<'s>(
+        &'s self,
+        owner: &'s str,
+        node: &'s V,
+        depth: usize,
+        out: &mut Vec<(&'s str, &'s V)>,
+    ) -> Result<(), PackDefect> {
+        let V::Object(o) = node else {
+            return Err(PackDefect::Registry);
+        };
+        if depth > 32 {
+            return Err(PackDefect::Registry);
+        }
+        for combinator in ["$ref", "oneOf", "anyOf"] {
+            if let Some(v) = o.get(combinator) {
+                if o.keys().any(|k| k != combinator && !annotation(k)) {
+                    return Err(PackDefect::Registry);
+                }
+                if let V::String(r) = v {
+                    let (id, target) = self.resolve(owner, r)?;
+                    return self.expand(id, target, depth + 1, out);
+                }
+                let V::Array(alternatives) = v else {
+                    return Err(PackDefect::Registry);
+                };
+                for alternative in alternatives {
+                    self.expand(owner, alternative, depth + 1, out)?;
+                }
+                return Ok(());
+            }
+        }
+        if o.contains_key("patternProperties")
+            || o.contains_key("unevaluatedProperties")
+            || o.contains_key("prefixItems")
+            || o.contains_key("$defs")
+        {
+            return Err(PackDefect::Registry);
+        }
+        let object = o.get("type") == Some(&V::String("object".into()));
+        if (object || o.contains_key("properties"))
+            && !(object && o.get("additionalProperties") == Some(&V::Bool(false)))
+        {
+            return Err(PackDefect::Registry);
+        }
+        out.push((owner, node));
+        Ok(())
+    }
+    fn first_imperative(&self, value: &V) -> Result<Option<String>, PackDefect> {
+        let root = self
+            .documents
+            .get(POLICY_SCHEMA_ID)
+            .ok_or(PackDefect::Registry)?;
+        let root = optional(
+            optional(root, "$defs").ok_or(PackDefect::Registry)?,
+            "PolicyDocumentV2",
+        )
+        .ok_or(PackDefect::Registry)?;
+        let mut alternatives = Vec::new();
+        self.expand(POLICY_SCHEMA_ID, root, 0, &mut alternatives)?;
+        let mut pointer = String::new();
+        self.walk(value, &alternatives, &mut pointer)
+    }
+    fn walk(
+        &self,
+        value: &V,
+        alternatives: &[(&str, &V)],
+        pointer: &mut String,
+    ) -> Result<Option<String>, PackDefect> {
+        let typed =
+            |(_, a): &&(&str, &V), t: &str| optional(a, "type") == Some(&V::String(t.into()));
+        match value {
+            V::Object(members) => {
+                let objects: Vec<_> = alternatives.iter().filter(|a| typed(a, "object")).collect();
+                for (key, child) in members {
+                    let mark = pointer.len();
+                    pointer.push('/');
+                    pointer.push_str(&key.replace('~', "~0").replace('/', "~1"));
+                    let mut inner = Vec::new();
+                    let mut declared = false;
+                    for (owner, a) in &objects {
+                        if let Some(p) = optional(a, "properties").and_then(|p| optional(p, key)) {
+                            declared = true;
+                            self.expand(owner, p, 0, &mut inner)?;
+                        }
+                    }
+                    if !declared {
+                        return Ok(Some(pointer.clone()));
+                    }
+                    if let Some(found) = self.walk(child, &inner, pointer)? {
+                        return Ok(Some(found));
+                    }
+                    pointer.truncate(mark);
+                }
+                Ok(None)
+            }
+            V::Array(items) => {
+                let mut inner = Vec::new();
+                for (owner, a) in alternatives.iter().filter(|a| typed(a, "array")) {
+                    if let Some(i) = optional(a, "items") {
+                        self.expand(owner, i, 0, &mut inner)?;
+                    }
+                }
+                for (index, item) in items.iter().enumerate() {
+                    let mark = pointer.len();
+                    pointer.push_str(&format!("/{index}"));
+                    if let Some(found) = self.walk(item, &inner, pointer)? {
+                        return Ok(Some(found));
+                    }
+                    pointer.truncate(mark);
+                }
+                Ok(None)
+            }
+            V::String(_)
+                if !alternatives.is_empty() && alternatives.iter().all(|a| typed(&a, "object")) =>
+            {
+                Ok(Some(pointer.clone()))
+            }
+            _ => Ok(None),
+        }
+    }
+}
+
+/// Retained Plan join diagnostics (law X12 r3 item 9). Inert: not a Run proof.
+pub struct PlanPackChecks {
+    pack_id: String,
+}
+impl PlanPackChecks {
+    pub fn pack_id(&self) -> &str {
+        &self.pack_id
+    }
+}
+
+/// Require the retained analysis-spec to name exactly one bundled packId and
+/// plan.policyDigest to equal that row's policySha256. Provided for the host's
+/// just-built Plan and X12d's Run closure; not wired into replay (item 9).
+pub fn check_plan_pack(
+    inputs: &RetainedInputs<'_>,
+    plan_id: &str,
+    budget: TraversalBudget,
+) -> Result<PlanPackChecks, PolicyAdmissionError> {
+    check_plan_pack_in(&RELEASE_PACKS, inputs, plan_id, budget)
+}
+fn check_plan_pack_in(
+    registry: &PackRegistry<'_>,
+    inputs: &RetainedInputs<'_>,
+    plan_id: &str,
+    budget: TraversalBudget,
+) -> Result<PlanPackChecks, PolicyAdmissionError> {
+    let mut reader = PolicyReader {
+        inputs,
+        meter: Meter { budget },
+    };
+    let plan = reader.object(plan_id, IdentityDomain::Plan)?;
+    reader.step()?;
+    let analysis = inputs
+        .identity_record_shape(
+            sha256_text(&format!(
+                "sha256:{}",
+                text(field(&plan, "analysisSpecDigest")?)?
+            ))?,
+            "analysis-spec",
+            budget.descriptor_work,
+        )
+        .map_err(PolicyAdmissionError::Record)?;
+    let ids = array(field(&analysis, "policyPackIds")?)?;
+    let [V::String(id)] = ids else {
+        return Err(PolicyAdmissionError::Refused(
+            "PLAN_POLICY_PACK_COUNT".into(),
+        ));
+    };
+    let rows = registry
+        .rows()
+        .map_err(|_| PolicyAdmissionError::RegistryLaw)?;
+    let row = rows
+        .iter()
+        .find(|r| &r.pack_id == id)
+        .ok_or_else(|| PolicyAdmissionError::Refused("PLAN_POLICY_PACK_NOT_BUNDLED".into()))?;
+    policy_require(
+        field(&plan, "policyDigest")? == &V::String(digest_hex(&row.policy_sha256)),
+        "PLAN_POLICY_PACK_DIGEST",
+    )?;
+    Ok(PlanPackChecks {
+        pack_id: row.pack_id.clone(),
+    })
+}
