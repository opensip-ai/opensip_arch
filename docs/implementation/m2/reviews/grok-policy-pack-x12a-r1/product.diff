+// Bundled policy-pack admission (law X12 r3 items 2 to 7 and 9; unit X12a).
+// "Bundled" means compiled into the signed core: the registry and every pack
+// document are include_bytes! data. Nothing is read from a project, an
+// installation, an account, the environment, a flag or the network.
+use opensip_identity::{RegisteredSchemas, SchemaAdmissionError, SchemaError};
+
+const POLICY_SCHEMA_ID: &str = "urn:opensip:product-v1:policy-document:2";
+const POLICY_SCHEMA_SELECTOR: &str = "/$defs/PolicyDocumentV2";
+
+/// The release registry: zero rows in M2 (law X12 r3 item 4). Its documents
+/// table is empty, so no release row can name a document.
+const RELEASE_PACKS: PackRegistry<'static> = PackRegistry {
+    rows: include_bytes!("pack-registry.json"),
+    documents: &[],
+};
+
+/// The policy schema closure the imperative classifier reads: the exact
+/// schema sources the host registry pins, each rechecked against
+/// RegisteredSchemas::source_requirements before use.
+const CLASSIFIER_SOURCES: &[&[u8]] = &[
+    include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../schemas/sources/policy-v2.schema.json"
+    )),
+    include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../schemas/sources/common-v1.schema.json"
+    )),
+    include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../schemas/sources/imported-v1.schema.json"
+    )),
+];
+
+/// Rule/atom and contribution traversal steps (items 6.6 and 6.7). Sized to
+/// the DSL's own bounds: per rule at most 5 evidenceUse rows and 65 predicate
+/// nodes, each atom at most 1 + 16 x (1 + 64) steps, in two passes (policy and
+/// compiled program), so 512 rules need under 2^27 steps. A document that
+/// passes the schema never reaches it; reaching it is row 4.
+const PACK_TRAVERSAL_STEPS: usize = 1 << 27;
+/// Closed-schema work for one document (item 6.3). parse_json already bounds a
+/// document to 4 MiB and depth 32; this allows over 250 units per byte.
+const PACK_SCHEMA_WORK: usize = 1 << 30;
+
+/// The inert boundary input (law X12 r3 item 5). It claims nothing. `Supplied`
+/// exists only to be refused: no bytes are ever admitted as a pack.
+#[derive(Debug, Clone, Copy)]
+pub enum PackSource<'a> {
+    /// A pack ID, matched byte for byte against the bundled registry.
+    Named(&'a str),
+    /// A policy document found in a project, named by a flag or offered by a
+    /// component.
+    Supplied {
+        bytes: &'a [u8],
+        provenance: SuppliedProvenance,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SuppliedProvenance {
+    User,
+    ThirdParty,
+}
+impl SuppliedProvenance {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::User => "user",
+            Self::ThirdParty => "third-party",
+        }
+    }
+}
+
+/// An admitted bundled pack. It cannot be constructed, cloned, defaulted or
+/// deserialized outside admit_pack; holding one is the only admission.
+/// ```compile_fail
+/// use opensip_evaluator::AdmittedPack;
+/// let forged = AdmittedPack {
+///     pack_id: String::new(), policy_digest: [0; 32],
+///     program: opensip_identity::JsonValue::Null, program_digest: [0; 32],
+/// };
+/// ```
+#[derive(Debug)]
+pub struct AdmittedPack {
+    pack_id: String,
+    policy_digest: [u8; 32],
+    program: V,
+    program_digest: [u8; 32],
+}
+impl AdmittedPack {
+    /// The registry row's exact packId, `<name>:<version>`.
+    pub fn pack_id(&self) -> &str {
+        &self.pack_id
+    }
+    /// Raw SHA-256 of the bundled document's canonical bytes (plan.policyDigest).
+    pub fn policy_digest(&self) -> [u8; 32] {
+        self.policy_digest
+    }
+    /// The compiled RuleProgramV2.
+    pub fn program(&self) -> &V {
+        &self.program
+    }
+    /// Raw SHA-256 of the compiled program's canonical bytes.
+    pub fn program_digest(&self) -> [u8; 32] {
+        self.program_digest
+    }
+}
+
+/// Why a bundled document, the registry or the classifier's schema closure is
+/// defective. Diagnostic only: every one of these is law X12 r3 row 4.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PackDefect {
+    /// A self-inconsistent registry, or a classifier or schema-registry fault.
+    Registry,
+    /// Item 6.1 on bundled bytes.
+    Lexical,
+    /// Item 6.2 on bundled bytes, with the member's JSON Pointer.
+    Imperative(String),
+    /// Item 6.3 on bundled bytes.
+    Schema,
+    /// Item 6.5: canonical bytes do not hash to policySha256.
+    Digest,
+    /// Item 6.6: the rule and atom law's cause.
+    RuleLaw(String),
+    /// Item 6.7: a contributionId outside the row's set.
+    Contribution(String),
+    /// A traversal limit.
+    Limit,
+}
+
+/// One refusal of law X12 r3 item 7. The host maps each variant, by an
+/// exhaustive match, into the termination shape (unit X12b).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PackRefusal {
+    /// Row 1: a Named ID the bundled registry does not hold.
+    NotBundled { pack_id: String },
+    /// Row 2: a Supplied document that passes items 6.1 to 6.3.
+    SuppliedPack {
+        provenance: SuppliedProvenance,
+        sha256: [u8; 32],
+    },
+    /// Row 3: a Supplied document failing item 6.2.
+    ImperativeMember { pointer: String },
+    /// Row 3a: a Supplied document failing item 6.1 or 6.3.
+    SuppliedInvalid {
+        provenance: SuppliedProvenance,
+        sha256: [u8; 32],
+    },
+    /// Row 4: a defect in the signed core, never the caller's input.
+    HostInvariant { subject: String, defect: PackDefect },
+}
+impl PackRefusal {
+    /// The row's subject: the presented ID, the supplied digest, the member's
+    /// pointer, or `pack:<packId>`.
+    pub fn subject(&self) -> String {
+        match self {
+            Self::NotBundled { pack_id } => pack_id.clone(),
+            Self::SuppliedPack { provenance, sha256 }
+            | Self::SuppliedInvalid { provenance, sha256 } => supplied_subject(*provenance, sha256),
+            Self::ImperativeMember { pointer } => pointer.clone(),
+            Self::HostInvariant { subject, .. } => subject.clone(),
+        }
+    }
+}
+fn supplied_subject(provenance: SuppliedProvenance, sha256: &[u8; 32]) -> String {
+    format!(
+        "supplied:{}:sha256:{}",
+        provenance.name(),
+        digest_hex(sha256)
+    )
+}
+
+/// Admit one pack source against the release registry (law X12 r3 items 5 and
+/// 6). Pure: no I/O, lock or ledger. `schemas` is the host's exact pinned
+/// schema registry, used only for closed-schema validation.
+pub fn admit_pack(
+    schemas: &RegisteredSchemas,
+    source: &PackSource<'_>,
+) -> Result<AdmittedPack, PackRefusal> {
+    admit_from(&RELEASE_PACKS, schemas, source, PACK_TRAVERSAL_STEPS)
+}
+
+struct PackRegistry<'a> {
+    rows: &'a [u8],
+    documents: &'a [(&'a str, &'a [u8])],
+}
+struct PackRow<'a> {
+    pack_id: String,
+    document: &'a [u8],
+    policy_sha256: [u8; 32],
+    contributions: BTreeSet<String>,
+}
+fn name_text(s: &str) -> bool {
+    let b = s.as_bytes();
+    !b.is_empty()
+        && b[0].is_ascii_lowercase()
+        && b.iter().all(|c| {
+            c.is_ascii_lowercase() || c.is_ascii_digit() || matches!(c, b'.' | b'_' | b'-')
+        })
+}
+fn lower_hex(s: &str) -> Option<[u8; 32]> {
+    let b = s.as_bytes();
+    if b.len() != 64
+        || !b
+            .iter()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(c))
+    {
+        return None;
+    }
+    let mut out = [0u8; 32];
+    for (i, pair) in b.chunks(2).enumerate() {
+        let v = |c: u8| {
+            if c.is_ascii_digit() {
+                c - b'0'
+            } else {
+                c - b'a' + 10
+            }
+        };
+        out[i] = (v(pair[0]) << 4) | v(pair[1]);
+    }
+    Some(out)
+}
+impl<'a> PackRegistry<'a> {
+    /// The whole registry's self-consistency. Any failure is row 4.
+    fn rows(&self) -> Result<Vec<PackRow<'a>>, PackDefect> {
+        let bad = PackDefect::Registry;
+        let doc = parse_json(self.rows).map_err(|_| PackDefect::Registry)?;
+        let V::Object(top) = &doc else {
+            return Err(bad);
+        };
+        let keys: Vec<&str> = top.keys().map(String::as_str).collect();
+        if keys != ["rows", "schemaVersion", "standing"]
+            || top["schemaVersion"]
+                != V::Integer(JsonInteger::new(1).map_err(|_| PackDefect::Registry)?)
+            || !matches!(top["standing"], V::String(_))
+        {
+            return Err(bad);
+        }
+        let V::Array(rows) = &top["rows"] else {
+            return Err(bad);
+        };
+        let mut out: Vec<PackRow<'a>> = Vec::new();
+        let mut used = BTreeSet::new();
+        for row in rows {
+            let V::Object(r) = row else {
+                return Err(PackDefect::Registry);
+            };
+            let keys: Vec<&str> = r.keys().map(String::as_str).collect();
+            if keys
+                != [
+                    "contributions",
+                    "name",
+                    "packId",
+                    "policyDocument",
+                    "policySha256",
+                    "version",
+                ]
+            {
+                return Err(PackDefect::Registry);
+            }
+            let (
+                V::String(name),
+                V::Integer(version),
+                V::String(pack_id),
+                V::String(document),
+                V::String(sha),
+                V::Array(contributions),
+            ) = (
+                &r["name"],
+                &r["version"],
+                &r["packId"],
+                &r["policyDocument"],
+                &r["policySha256"],
+                &r["contributions"],
+            )
+            else {
+                return Err(PackDefect::Registry);
+            };
+            // Item 3: `<name>:<version>`, decimal, no sign, no leading zero.
+            if !name_text(name)
+                || !(1..=i128::from(u32::MAX)).contains(&version.get())
+                || *pack_id != format!("{name}:{}", version.get())
+                || out
+                    .last()
+                    .is_some_and(|p| p.pack_id.as_str() >= pack_id.as_str())
+            {
+                return Err(PackDefect::Registry);
+            }
+            let policy_sha256 = lower_hex(sha).ok_or(PackDefect::Registry)?;
+            let mut set = BTreeSet::new();
+            for c in contributions {
+                let V::String(c) = c else {
+                    return Err(PackDefect::Registry);
+                };
+                if !name_text(c) || set.last().is_some_and(|l: &String| l >= c) {
+                    return Err(PackDefect::Registry);
+                }
+                set.insert(c.clone());
+            }
+            let mut found = self.documents.iter().filter(|(n, _)| n == document);
+            let (Some((_, bytes)), None) = (found.next(), found.next()) else {
+                return Err(PackDefect::Registry);
+            };
+            if set.is_empty() || !used.insert(document.as_str()) {
+                return Err(PackDefect::Registry);
+            }
+            out.push(PackRow {
+                pack_id: pack_id.clone(),
+                document: bytes,
+                policy_sha256,
+                contributions: set,
+            });
+        }
+        if used.len() != self.documents.len() {
+            return Err(PackDefect::Registry);
+        }
+        Ok(out)
+    }
+}
+
+/// Items 6.1 to 6.3, in order; the first failure ends admission.
+enum Declarative {
+    Lexical,
+    Imperative(String),
+    Schema,
+    Fault(PackDefect),
+}
+fn declarative(schemas: &RegisteredSchemas, bytes: &[u8]) -> Result<V, Declarative> {
+    let value = parse_json(bytes).map_err(|_| Declarative::Lexical)?;
+    let classifier = Classifier::load(schemas).map_err(Declarative::Fault)?;
+    if let Some(pointer) = classifier
+        .first_imperative(&value)
+        .map_err(Declarative::Fault)?
+    {
+        return Err(Declarative::Imperative(pointer));
+    }
+    let handle = schemas
+        .schema(POLICY_SCHEMA_ID, POLICY_SCHEMA_SELECTOR)
+        .map_err(|_| Declarative::Fault(PackDefect::Registry))?;
+    match handle.admit_json(bytes, PACK_SCHEMA_WORK) {
+        Ok(_) => Ok(value),
+        Err(SchemaAdmissionError::Mismatch) => Err(Declarative::Schema),
+        Err(SchemaAdmissionError::Schema(SchemaError::Limit)) => {
+            Err(Declarative::Fault(PackDefect::Limit))
+        }
+        Err(_) => Err(Declarative::Fault(PackDefect::Registry)),
+    }
+}
+
+fn admit_from(
+    registry: &PackRegistry<'_>,
+    schemas: &RegisteredSchemas,
+    source: &PackSource<'_>,
+    steps: usize,
+) -> Result<AdmittedPack, PackRefusal> {
+    let (id, rows) = match *source {
+        PackSource::Supplied { bytes, provenance } => {
+            let sha256 = raw_sha256(bytes);
+            // Admission is by identity only: whatever these bytes are, they are
+            // refused (item 6, after step 3), including a bundled pack's bytes.
+            return Err(match declarative(schemas, bytes) {
+                Ok(_) => PackRefusal::SuppliedPack { provenance, sha256 },
+                Err(Declarative::Imperative(pointer)) => PackRefusal::ImperativeMember { pointer },
+                Err(Declarative::Lexical | Declarative::Schema) => {
+                    PackRefusal::SuppliedInvalid { provenance, sha256 }
+                }
+                Err(Declarative::Fault(defect)) => PackRefusal::HostInvariant {
+                    subject: supplied_subject(provenance, &sha256),
+                    defect,
+                },
+            });
+        }
+        PackSource::Named(id) => (id, registry.rows()),
+    };
+    let fault = |defect| PackRefusal::HostInvariant {
+        subject: format!("pack:{id}"),
+        defect,
+    };
+    // Item 4: byte-exact match, no normalization.
+    let rows = rows.map_err(fault)?;
+    let Some(row) = rows.iter().find(|r| r.pack_id == id) else {
+        return Err(PackRefusal::NotBundled { pack_id: id.into() });
+    };
+    // Items 6.1 to 6.3 ran on bundled bytes, not caller input: any failure is
+    // a signed-core defect (row 4, never row 3).
+    let policy = declarative(schemas, row.document).map_err(|e| {
+        fault(match e {
+            Declarative::Lexical => PackDefect::Lexical,
+            Declarative::Imperative(p) => PackDefect::Imperative(p),
+            Declarative::Schema => PackDefect::Schema,
+            Declarative::Fault(d) => d,
+        })
+    })?;
+    // Item 6.5.
+    let canonical = canonical_bytes(&policy).map_err(|_| fault(PackDefect::Lexical))?;
+    let policy_digest = raw_sha256(&canonical);
+    if policy_digest != row.policy_sha256 {
+        return Err(fault(PackDefect::Digest));
+    }
+    // Item 6.6, then 6.7.
+    let law = |e: PolicyAdmissionError| {
+        fault(match e {
+            PolicyAdmissionError::Limit => PackDefect::Limit,
+            PolicyAdmissionError::Refused(cause) => PackDefect::RuleLaw(cause),
+            _ => PackDefect::RuleLaw("POLICY_SHAPE".into()),
+        })
+    };
+    let mut meter = Meter {
+        budget: TraversalBudget {
+            steps,
+            depth: 1,
+            descriptor_work: PACK_SCHEMA_WORK,
+        },
+    };
+    let program = compile_program(&mut meter, &V::String(digest_hex(&policy_digest)), &policy)
+        .map_err(law)?;
+    let program_bytes = canonical_bytes(&program).map_err(|_| fault(PackDefect::Registry))?;
+    match schemas
+        .schema(POLICY_SCHEMA_ID, "/$defs/RuleProgramV2")
+        .map_err(|_| fault(PackDefect::Registry))?
+        .admit_json(&program_bytes, PACK_SCHEMA_WORK)
+    {
+        Ok(_) => {}
+        Err(SchemaAdmissionError::Schema(SchemaError::Limit)) => {
+            return Err(fault(PackDefect::Limit));
+        }
+        Err(_) => return Err(fault(PackDefect::RuleLaw("RULE_PROGRAM_SHAPE".into()))),
+    }
+    check_program_laws(&mut meter, &policy, &program).map_err(law)?;
+    for rule in array(field(&policy, "rules").map_err(|_| fault(PackDefect::Schema))?)
+        .map_err(|_| fault(PackDefect::Schema))?
+    {
+        meter.step().map_err(law)?;
+        let contribution = field(rule, "ruleProgramRef")
+            .and_then(|r| field(r, "contributionId"))
+            .and_then(text)
+            .map_err(|_| fault(PackDefect::Schema))?;
+        if !row.contributions.contains(contribution) {
+            return Err(fault(PackDefect::Contribution(contribution.into())));
+        }
+    }
+    Ok(AdmittedPack {
+        pack_id: row.pack_id.clone(),
+        policy_digest,
+        program_digest: raw_sha256(&program_bytes),
+        program,
+    })
+}
