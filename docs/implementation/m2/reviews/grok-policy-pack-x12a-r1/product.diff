+#[test]
+fn bundled_defects_are_row_4_never_row_3() {
+    let subject = format!("pack:{TEST_ID}");
+    let fault = |defect| PackRefusal::HostInvariant {
+        subject: subject.clone(),
+        defect,
+    };
+    // Digest mismatch.
+    let (rows, doc, _) = one_row(TEST_DOCUMENT, &"0".repeat(64), &["fixture"]);
+    assert_eq!(defect(&rows, &doc), fault(PackDefect::Digest));
+    // A contribution outside the row's set.
+    let (rows, doc, _) = one_row(TEST_DOCUMENT, TEST_SHA, &["other"]);
+    assert_eq!(
+        defect(&rows, &doc),
+        fault(PackDefect::Contribution("fixture".into()))
+    );
+    // Rule and atom law: a relation outside the atom registry.
+    let mut bad = test_document();
+    put(
+        &mut bad,
+        "/rules/0/emitWhen/relation",
+        s("no-such-relation"),
+    );
+    let raw = bytes_of(&bad);
+    let (rows, doc, _) = one_row(&raw, &digest_hex(&raw_sha256(&raw)), &["fixture"]);
+    assert_eq!(
+        defect(&rows, &doc),
+        fault(PackDefect::RuleLaw(
+            "POLICY_RULE_NOT_ADMISSIBLE:policy:no-consumer:POLICY.UNKNOWN_RULE".into()
+        ))
+    );
+    // An imperative member in a bundled document (RF-1): row 4, not row 3.
+    for (pointer, value) in [
+        ("/rules/0/exec", s("rm -rf /")),
+        ("/rules/0/emitWhen", s("exists(file)")),
+        ("/script", s("x")),
+    ] {
+        let mut bad = test_document();
+        put(&mut bad, pointer, value);
+        let raw = bytes_of(&bad);
+        let (rows, doc, _) = one_row(&raw, &digest_hex(&raw_sha256(&raw)), &["fixture"]);
+        let refusal = defect(&rows, &doc);
+        assert_eq!(refusal, fault(PackDefect::Imperative(pointer.into())));
+        assert_eq!(refusal.subject(), subject);
+        assert!(!matches!(refusal, PackRefusal::ImperativeMember { .. }));
+    }
+    // Lexical and closed-schema failures of bundled bytes.
+    let (rows, doc, _) = one_row(b"{\"rules\":", TEST_SHA, &["fixture"]);
+    assert_eq!(defect(&rows, &doc), fault(PackDefect::Lexical));
+    let mut v1 = test_document();
+    put(
+        &mut v1,
+        "/schemaMajor",
+        V::Integer(JsonInteger::new(1).unwrap()),
+    );
+    let raw = bytes_of(&v1);
+    let (rows, doc, _) = one_row(&raw, &digest_hex(&raw_sha256(&raw)), &["fixture"]);
+    assert_eq!(defect(&rows, &doc), fault(PackDefect::Schema));
+    // A traversal limit.
+    assert_eq!(
+        admit_from(&TEST_PACKS, schemas(), &PackSource::Named(TEST_ID), 1).unwrap_err(),
+        fault(PackDefect::Limit)
+    );
+}
