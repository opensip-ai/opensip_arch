+fn plan_inputs(analysis_ids: &[&str], policy_sha: Option<&str>) -> PlanInputs {
+    let fixture = parse_json(include_bytes!(
+        "../tests/fixtures/policy-pack-plan-fixture.json"
+    ))
+    .unwrap();
+    let plan = field(&fixture, "plan").unwrap();
+    let analysis = field(&fixture, "analysisSpec").unwrap();
+    let analysis_raw: Vec<u8> = {
+        let h = text(field(analysis, "hex").unwrap()).unwrap();
+        (0..h.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap())
+            .collect()
+    };
+    let mut descriptor = field(plan, "descriptor").unwrap().clone();
+    let mut blobs = BTreeMap::new();
+    let id = if analysis_ids == ["fixture.file-observed"] && policy_sha.is_none() {
+        blobs.insert(raw_sha256(&analysis_raw), analysis_raw);
+        text(field(plan, "id").unwrap()).unwrap().to_string()
+    } else {
+        let mut spec = parse_json(&analysis_raw).unwrap();
+        put(
+            &mut spec,
+            "/policyPackIds",
+            V::Array(analysis_ids.iter().map(|i| s(i)).collect()),
+        );
+        let spec_raw = bytes_of(&spec);
+        put(
+            &mut descriptor,
+            "/analysisSpecDigest",
+            s(&digest_hex(&raw_sha256(&spec_raw))),
+        );
+        if let Some(sha) = policy_sha {
+            put(&mut descriptor, "/policyDigest", s(sha));
+        }
+        blobs.insert(raw_sha256(&spec_raw), spec_raw);
+        IdentityCandidate::from_json(
+            schemas(),
+            IdentityDomain::Plan,
+            &bytes_of(&descriptor),
+            WORK,
+        )
+        .unwrap()
+        .identifier()
+        .to_string()
+    };
+    let objects = BTreeMap::from([(
+        id.clone(),
+        ObjectInput {
+            domain: IdentityDomain::Plan,
+            descriptor,
+        },
+    )]);
+    (id, objects, blobs)
+}
+fn plan_check(
+    registry: &PackRegistry<'_>,
+    ids: &[&str],
+    sha: Option<&str>,
+    steps: usize,
+) -> Result<PlanPackChecks, PolicyAdmissionError> {
+    let (id, objects, blobs) = plan_inputs(ids, sha);
+    let inputs = RetainedInputs::new(schemas(), &objects, &blobs);
+    check_plan_pack_in(
+        registry,
+        &inputs,
+        &id,
+        TraversalBudget {
+            steps,
+            depth: 96,
+            descriptor_work: WORK,
+        },
+    )
+}
