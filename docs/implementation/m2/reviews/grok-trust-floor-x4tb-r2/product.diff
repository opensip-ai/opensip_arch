+        let mut owner = bound(&site);
+        let inputs = ViewInputs {
+            mode: ReadMode::Reread,
+            observation: None,
+            project_policy: None,
+            core_closure: fixture::CORE_CLOSURE,
+        };
+        assert_eq!(read(&site, &mut owner, &inputs).unwrap_err().row, TrustRow::HostIo);
+    })
+}
+
+/// A capsule of exactly `len` canonical bytes: the owner's capsule with one
+/// more namespace on TR-CORE's acceptance, padded to length. Only `publish`'s
+/// decode and closed shape see it; it is never admitted as trust.
+fn padded(raw: &[u8], len: usize) -> Vec<u8> {
+    let capsule = opensip_identity::parse_json(raw).unwrap();
+    let with = |n: usize| {
+        let mut c = object(&capsule).unwrap().clone();
+        let mut roles = object(&c["roles"]).unwrap().clone();
+        let mut core = object(&roles["TR-CORE"]).unwrap().clone();
+        let mut accepted = object(&core["accepted"]).unwrap().clone();
+        let V::Array(mut names) = accepted["namespaces"].clone() else {
+            panic!("namespaces")
+        };
+        names.push(s(&format!("z{}", "a".repeat(n))));
+        accepted.insert("namespaces".into(), V::Array(names));
+        core.insert("accepted".into(), V::Object(accepted));
+        roles.insert("TR-CORE".into(), V::Object(core));
+        c.insert("roles".into(), V::Object(roles));
+        canonical_bytes(&V::Object(c)).unwrap()
+    };
+    let base = with(0).len();
+    let out = with(len - base);
+    assert_eq!(out.len(), len);
+    out
+}
+/// One `publish` of a `len`-byte capsule beside an already present, equal
+/// `len`-byte record, on `ledger`: both exact rereads at that length.
+fn publish_at(len: usize, ledger: &mut WorkLedger) -> (Site, Result<(), TrustRefusal>, Vec<u8>) {
+    let site = site(&Spec::default());
+    let mut owner = bound(&site);
+    let capsule = padded(owner.raw(), len);
+    let record = vec![b'r'; len];
+    let path = site.root.join(format!("trust/records/{}", hex(&record)));
+    fs::write(&path, &record).unwrap();
+    fs::set_permissions(&path, Permissions::from_mode(0o600)).unwrap();
+    let result = ledger
+        .scope(|w| {
+            publish(
+                &site.fence,
+                &mut owner,
+                &[TrustWrite::node(Collection::Records, record.clone())],
+                &capsule,
+                w,
+            )
+            .map_err(WorkFailure::Operation)
+        })
+        .map_err(|e| match e {
+            WorkFailure::Operation(refusal) => refusal,
+            WorkFailure::Budget(b) => TrustRefusal {
+                row: TrustRow::Budget,
+                cause: format!("{b:?}"),
+            },
+        });
+    if result.is_ok() {
+        assert_eq!(owner.confirmed().unwrap().raw(), capsule.as_slice());
+    }
+    (site, result, capsule)
+}
+
+#[test]
+fn the_reservation_covers_both_exact_rereads_at_every_growth_boundary() {
+    crate::test_scratch::settled(|| {
+        // RF-1's lengths: each growth boundary of the reread up to the trust
+        // record parser's 131072-byte cap.
+        for len in [16384, 20480, 32768, 53248, 65536, 118784, 131072] {
+            let mut measuring = WorkLedger::new();
+            let (_, measured, _) = publish_at(len, &mut measuring);
+            measured.unwrap_or_else(|e| panic!("{len}: {e:?}"));
+            let used = measuring.used();
+            // An exactly sufficient ledger completes: the pointer moved and
+            // the owner advanced from the reread.
+            let mut exact = WorkLedger::with_limits(used).unwrap();
+            let (site, done, capsule) = publish_at(len, &mut exact);
+            done.unwrap_or_else(|e| panic!("{len} exact: {e:?}"));
+            assert_eq!(fs::read(current_path(&site)).unwrap(), capsule);
+            // One byte less refuses before any effect: the same file, and no
+            // temporary name beside it.
+            let mut short = WorkLedger::with_limits(WorkCost {
+                bytes: used.bytes - 1,
+                ..used
+            })
+            .unwrap();
+            let (site, refused, _) = publish_at(len, &mut short);
+            let before = site.store.files.iter().find(|f| f.path.ends_with("/state.v1")).unwrap();
+            assert_eq!(refused.unwrap_err().row, TrustRow::Budget, "{len}");
+            assert_eq!(fs::read(current_path(&site)).unwrap(), before.bytes);
+            let dir = current_path(&site).parent().unwrap().to_owned();
+            let names: Vec<_> = fs::read_dir(&dir)
+                .unwrap()
+                .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+                .filter(|n| n.starts_with("state.v1"))
+                .collect();
+            assert_eq!(names, ["state.v1"], "{len}");
+        }
+    })
+}
