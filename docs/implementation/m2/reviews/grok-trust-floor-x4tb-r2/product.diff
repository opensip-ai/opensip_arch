+        assert_eq!(text(record, "evalHighWater"), &s("2026-10-02T01:00:00Z"));
+        assert_eq!(text(record, "anchor"), &obs);
+        let old_record = text(text(&old, "clock"), "record");
+        for key in [
+            "lastAccepted",
+            "rootVersion",
+            "indexSnapshotVersion",
+            "revocationVersion",
+            "revocationIssuedAt",
+            "catalogExpiresAt",
+            "rootExpiresAt",
+        ] {
+            assert_eq!(text(record, key), text(old_record, key), "{key}");
+        }
+        for key in ["roles", "heads", "history", "store", "staged", "batch", "sourceFence"] {
+            assert_eq!(text(&new, key), text(&old, key), "{key}");
+        }
