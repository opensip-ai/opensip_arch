+            text(text(&new, "clock"), "timeEvidence"),
+            text(text(&old, "clock"), "timeEvidence"),
+            "L did not advance: the time evidence is kept"
+        );
+        assert_eq!(text(&new, "revision"), &integer(3));
+        assert_eq!(text(&new, "previous"), &s(&hex(&before)));
+        // The descriptor sits in the predecessor's bucket; the before image,
+        // the evaluation, the operation input and the event are records.
+        let bucket = site
+            .root
+            .join(format!("trust/publications/by-predecessor/{}", hex(&before)));
+        assert_eq!(fs::read_dir(&bucket).unwrap().count(), 1);
+        assert!(
+            site.root
+                .join(format!("trust/records/{}", hex(&before)))
+                .exists()
+        );
+        let head = text(&new, "eventHead");
+        assert_eq!(text(head, "sequence"), &integer(int(text(text(&old, "eventHead"), "sequence")).unwrap() + 1));
+        // The pre-acceptance-free predecessor's floors are this hold's own.
+        assert_eq!(owner.prior_floors().len(), 1);
+        // Every fenced recheck now compares against the confirmed owner.
+        WorkLedger::new()
+            .scope(|w| owner.recheck(site.uid, w).map_err(WorkFailure::Operation))
+            .unwrap();
+    })
