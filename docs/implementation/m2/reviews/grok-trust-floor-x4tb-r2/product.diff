+#[test]
+fn a_confirmed_trust_publication_is_the_only_advance_of_the_state_v1_owner() {
+    use crate::trust::{RetainedCurrentTrust, publish_trust};
+    use opensip_platform::WorkLedger;
+    for advance in [true, false] {
+        let (_scratch, home) = scratch();
+        let (r, s) = published(&format!("x4tb-advance-{advance}"), &home);
+        let mut gate = new_gate(None);
+        let mut admitted = run(&mut gate, &r, &home, &Probe::default(), &live, &nothing).unwrap();
+        let confirmed = {
+            let read = admitted.current_trust();
+            let file = read.file.expect("state.v1 is a required file");
+            assert_eq!(file.relative(), format!("trust/stores/{s}/state.v1"));
+            let raw = read.raw.to_vec();
+            let sample = file.metadata().clone();
+            let opensip_identity::JsonValue::Object(capsule) =
+                opensip_identity::parse_json(&raw).unwrap()
+            else {
+                panic!("capsule")
+            };
+            let fence = GateFence {
+                i: read.installation,
+                uid: read.uid,
+                groups: Default::default(),
+            };
+            WorkLedger::new()
+                .scope(|work| {
+                    let mut owner = RetainedCurrentTrust::bind(
+                        read.installation,
+                        read.uid,
+                        &capsule["store"],
+                        &raw,
+                        &sample,
+                        work,
+                    )
+                    .map_err(|e| WorkFailure::Operation(format!("{e:?}")))?;
+                    // X4B-a's protocol with no dependencies: the same bytes,
+                    // a new confirmed file.
+                    publish_trust(&fence, &mut owner, &[], &raw, work)
+                        .map_err(|e| WorkFailure::Operation(format!("{e:?}")))?;
+                    Ok(owner.confirmed().unwrap().clone())
+                })
+                .unwrap()
+        };
+        assert_ne!(
+            &confirmed.metadata().clone(),
+            admitted.current_trust().file.unwrap().metadata()
+        );
+        assert_eq!(
+            confirmed.predecessor(),
+            admitted.current_trust().file.unwrap().metadata()
+        );
+        let registry = |a: &DurableInstallation| {
+            a.required()
+                .iter()
+                .find(|f| f.relative() == "project-registry.v2")
+                .unwrap()
+                .metadata()
+                .clone()
+        };
+        let registry_before = registry(&admitted);
+        if advance {
+            admitted.advance_current(&confirmed).unwrap();
+            // Only from the reconfirmed predecessor, as `advance_registry`;
+            // the registry's own retained sample is untouched.
+            assert!(matches!(
+                admitted.advance_current(&confirmed),
+                Err(GateRefusal::Custody(CustodyRefusal::Changed))
+            ));
+            assert_eq!(registry(&admitted), registry_before);
+            assert_eq!(admitted.current_trust().file.unwrap().metadata(), confirmed.metadata());
+            assert_eq!(admitted.current_trust().raw, confirmed.raw());
+            gate.recheck(&admitted, &r.platform).unwrap();
+        } else {
+            let refused = gate.recheck(&admitted, &r.platform);
+            assert!(
+                matches!(refused, Err(GateRefusal::Custody(CustodyRefusal::Changed))),
+                "{refused:?}"
+            );
+        }
+        admitted.release().unwrap();
+    }
+}
