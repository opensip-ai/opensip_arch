+// Law X4T r9 items 7, 8 and 12 (X4T-a2 and X4T-b), on scratch installations
+// under the ACL test scratch with X4T-0's signed accepted store. Nothing here
+// opens the real account's I.
+use super::super::super::super::accepted_store_fixture::{self as fixture, Spec};
+use super::super::{TrustStanding, admit_native, check_accepted_by, check_evidence_floors, view_budget};
+use super::*;
+use crate::custody::installation_fence::SuppliedInstallationFence;
+use opensip_platform::{RetainedDirectoryPath, WorkLedger};
+use std::fs::{self, Permissions};
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+struct Site {
+    root: PathBuf,
+    store: fixture::AcceptedStore,
+    fence: SuppliedInstallationFence,
+    uid: u32,
+}
+impl Drop for Site {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
+fn site(spec: &Spec) -> Site {
+    let id = digest_hex(&raw_sha256(&opensip_platform::request_entropy().unwrap()));
+    let root = crate::test_scratch::acl_scratch().join(format!("opensip-x4tb-{id}"));
+    fs::create_dir(&root).unwrap();
+    fs::set_permissions(&root, Permissions::from_mode(0o700)).unwrap();
+    let root = fs::canonicalize(root).unwrap();
+    let uid = fs::metadata(&root).unwrap().uid();
+    fs::write(root.join("lifecycle.fence"), b"").unwrap();
+    fs::set_permissions(root.join("lifecycle.fence"), Permissions::from_mode(0o600)).unwrap();
+    let store = fixture::generate(spec);
+    store.write(&root);
+    let path = Arc::new(RetainedDirectoryPath::open(&root, 128).unwrap());
+    let fence =
+        SuppliedInstallationFence::try_acquire(path, uid, &std::collections::BTreeSet::new())
+            .unwrap()
+            .unwrap();
+    Site {
+        root,
+        store,
+        fence,
+        uid,
+    }
+}
+fn current_path(site: &Site) -> PathBuf {
+    site.root
+        .join(format!("trust/stores/{}/state.v1", fixture::STORE))
+}
+/// The session's one read of `state.v1`, as X3a's gate retains it: its
+/// bytes and the custody sample of the same judgment.
+fn owner(site: &Site, work: &mut WorkScope<'_>) -> Result<RetainedCurrentTrust, TrustRefusal> {
+    let relative = format!("trust/stores/{}/state.v1", fixture::STORE);
+    let sample = observe_private_file(site.fence.directory(), &relative, site.uid, work).unwrap();
+    let raw = fs::read(current_path(site)).unwrap();
+    RetainedCurrentTrust::bind(
+        site.fence.directory(),
+        site.uid,
+        &site.store.store,
+        &raw,
+        &sample,
+        work,
+    )
+}
+fn observation(boot: &str, mono: i64, wall: &str) -> V {
+    opensip_identity::parse_json(
+        format!(r#"{{"bootId":"{boot}","mono":{mono},"wall":"{wall}"}}"#).as_bytes(),
+    )
+    .unwrap()
+}
+fn fenced(report: bool, obs: &V) -> ViewInputs<'_> {
+    ViewInputs {
+        mode: ReadMode::Fenced { report },
+        observation: Some(obs),
+        project_policy: None,
+        core_closure: fixture::CORE_CLOSURE,
+    }
+}
+fn invocation() -> V {
+    obj([
+        ("executionId", s("exec1_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")),
+        ("requestId", s("req1_ffffffffffffffffffffffffffffffff")),
+        ("stepId", integer(0)),
+    ])
+}
+fn read(
+    site: &Site,
+    owner: &mut RetainedCurrentTrust,
+    inputs: &ViewInputs<'_>,
+) -> Result<AdmittedCurrentTrust, TrustRefusal> {
+    let mut ledger = WorkLedger::new();
+    ledger
+        .scope(|work| {
+            fenced_first_read(work, &site.fence, owner, inputs, &invocation())
+                .map_err(WorkFailure::Operation)
+        })
+        .map_err(|e| match e {
+            WorkFailure::Operation(refusal) => refusal,
+            WorkFailure::Budget(b) => panic!("ledger {b:?}"),
+        })
+}
+fn bound(site: &Site) -> RetainedCurrentTrust {
+    WorkLedger::new()
+        .scope(|work| owner(site, work).map_err(WorkFailure::<TrustRefusal>::Operation))
+        .unwrap()
+}
+fn text<'v>(v: &'v V, key: &str) -> &'v V {
+    &object(v).unwrap()[key]
+}
+/// Every trust file under `root`, by collection and digest, as an in-memory
+/// store for the read-only owners.
+fn files(root: &Path) -> BTreeMap<(Collection, [u8; 32]), Vec<u8>> {
+    let mut out = BTreeMap::new();
+    let mut stack = vec![root.join("trust")];
+    while let Some(dir) = stack.pop() {
+        for entry in fs::read_dir(&dir).unwrap() {
+            let path = entry.unwrap().path();
+            if path.is_dir() {
+                stack.push(path);
+                continue;
+            }
+            let rel = path.strip_prefix(root).unwrap().to_string_lossy().into_owned();
+            let collection = if rel.starts_with("trust/records/") {
+                Collection::Records
+            } else if rel.starts_with("trust/objects/") {
+                Collection::Objects
+            } else if rel.starts_with("trust/publications/") {
+                Collection::Publications
+            } else if rel.contains("/events/") {
+                Collection::Events
+            } else {
+                continue;
+            };
+            let bytes = fs::read(&path).unwrap();
+            out.insert((collection, raw_sha256(&bytes)), bytes);
+        }
+    }
+    out
+}
