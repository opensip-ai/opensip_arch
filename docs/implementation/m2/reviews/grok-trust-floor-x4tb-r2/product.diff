+#[test]
+fn accepted_by_outside_the_chain_must_be_an_earlier_accepted_event_of_that_role() {
+    crate::test_scratch::settled(|| {
+        let site = site(&Spec::default());
+        let mut owner = bound(&site);
+        let obs = observation("boot-1", 3607, "2026-10-02T01:00:00Z");
+        read(&site, &mut owner, &fenced(false, &obs)).unwrap();
+        let held = files(&site.root);
+        let reader = || {
+            |c: Collection, h: [u8; 32], cap: usize| -> Result<Vec<u8>, ()> {
+                let raw = held.get(&(c, h)).ok_or(())?;
+                if raw.len() > cap {
+                    return Err(());
+                }
+                Ok(raw.clone())
+            }
+        };
+        let capsule = owner.capsule().clone();
+        let publication = text(&capsule, "publication");
+        let descriptor = held
+            .iter()
+            .find(|((c, h), _)| {
+                *c == Collection::Publications && s(&digest_hex(h)) == *text(publication, "sha256")
+            })
+            .map(|(_, raw)| opensip_identity::parse_json(raw).unwrap())
+            .unwrap();
+        let mut b = view_budget();
+        let bindings = current_record_bindings::bind(
+            &mut b,
+            &site.store.store,
+            &capsule,
+            &descriptor,
+            &mut reader(),
+        )
+        .unwrap();
+        // The four accepted roles' events are all outside the chain: four reads.
+        let start = b.counters();
+        check_accepted_by(&mut b, &capsule, &descriptor, bindings.trace(), &mut reader()).unwrap();
+        assert_eq!(b.counters().0 - start.0, 4);
+        let roles = text(&capsule, "roles");
+        let by = |role: &str| text(text(text(roles, role), "accepted"), "by").clone();
+        let with_by = |role: &str, value: V| {
+            let mut c = object(&capsule).unwrap().clone();
+            let mut r = object(&c["roles"]).unwrap().clone();
+            let mut one = object(&r[role]).unwrap().clone();
+            let mut accepted = object(&one["accepted"]).unwrap().clone();
+            accepted.insert("by".into(), value);
+            one.insert("accepted".into(), V::Object(accepted));
+            r.insert(role.into(), V::Object(one));
+            c.insert("roles".into(), V::Object(r));
+            V::Object(c)
+        };
+        let edit = |value: &V, key: &str, to: V| {
+            let mut o = object(value).unwrap().clone();
+            o.insert(key.into(), to);
+            V::Object(o)
+        };
+        let head = text(&capsule, "eventHead").clone();
+        let p0_creation = {
+            // The P0 creation event (sequence 1): earlier, but not a role event.
+            let mut found = None;
+            for ((c, h), raw) in &held {
+                if *c == Collection::Events {
+                    let v = opensip_identity::parse_json(raw).unwrap();
+                    if text(&v, "kind") == &s("creation") {
+                        let mut r = object(&reference(raw)).unwrap().clone();
+                        r.insert("storeInstanceId".into(), s(fixture::STORE));
+                        r.insert("sequence".into(), integer(1));
+                        assert_eq!(digest_hex(h), *match &r["sha256"] { V::String(t) => t, _ => panic!() });
+                        found = Some(V::Object(r));
+                    }
+                }
+            }
+            found.unwrap()
+        };
+        for (label, value) in [
+            ("another role's earlier event", by("TR-CORE")),
+            ("a missing event", edit(&by("TR-INDEX"), "sha256", s(&"ab".repeat(32)))),
+            (
+                "another store's reference",
+                edit(&by("TR-INDEX"), "storeInstanceId", s(&"2".repeat(32))),
+            ),
+            ("an earlier event that is not a role event", p0_creation.clone()),
+            ("the current chain's clock-write", head.clone()),
+        ] {
+            let tampered = with_by("TR-INDEX", value);
+            let mut b = view_budget();
+            let refusal =
+                check_accepted_by(&mut b, &tampered, &descriptor, bindings.trace(), &mut reader())
+                    .unwrap_err();
+            assert_eq!(refusal.row, TrustRow::Incomplete, "{label}: {}", refusal.cause);
+        }
+    })
+}
