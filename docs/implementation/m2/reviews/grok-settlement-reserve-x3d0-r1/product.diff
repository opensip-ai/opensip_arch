+//! Law X3d r6 item 8, unit X3d-0: the settlement reserve through the public
+//! API only. Pure accounting and borrow tests; no journal, carrier or native
+//! effect. The cases are item 13's X3d-0 list.
+use opensip_platform::{
+    SettlementReserve, WorkBudgetError as BudgetFailure, WorkCost as Cost, WorkFailure as Failure,
+    WorkLedger,
+};
+use std::cell::Cell;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+
+fn edges(n: usize) -> Cost {
+    Cost {
+        edges: n,
+        ..Cost::default()
+    }
+}
+
+fn closed<T>(result: Result<T, Failure<()>>) {
+    assert_eq!(result.err(), Some(Failure::Budget(BudgetFailure::Closed)));
+}
+
+// Every ordinary entry point refuses a failed ledger, exactly as before.
+fn refuses_everything_outside_settle(ledger: &mut WorkLedger) {
+    assert!(ledger.is_failed());
+    closed(ledger.scope::<(), ()>(|_| panic!("scope after the latch")));
+    closed(ledger.charge::<()>(Cost::default()));
+    closed(ledger.run::<(), ()>(Cost::default(), |_| panic!("run after the latch")));
+    closed(ledger.retained_record::<(), ()>(0, |_| panic!("record after the latch")));
+    closed(
+        ledger.effect::<(), ()>(Cost::default(), Cost::default(), |_| {
+            panic!("effect after the latch")
+        }),
+    );
+}
+
+// Each way the ledger closes after the reserve was taken.
+fn close_by_nested_failure(ledger: &mut WorkLedger) {
+    assert_eq!(
+        ledger.scope(|s| s.run::<(), _>(edges(1), |_| Err(Failure::Operation(())))),
+        Err(Failure::Operation(()))
+    );
+}
+fn close_by_unwind(ledger: &mut WorkLedger) {
+    assert!(
+        catch_unwind(AssertUnwindSafe(|| {
+            let _ = ledger.run::<(), ()>(edges(1), |_| panic!("native adapter unwound"));
+        }))
+        .is_err()
+    );
+}
+fn close_by_swallowed_failure(ledger: &mut WorkLedger) {
+    closed(ledger.scope(|s| {
+        let _ = s.run::<(), ()>(Cost::default(), |_| Err(Failure::Operation(())));
+        Ok::<_, Failure<()>>(())
+    }));
+}
+fn close_by_budget_overrun(ledger: &mut WorkLedger) {
+    assert_eq!(
+        ledger.charge::<()>(edges(usize::MAX)),
+        Err(Failure::Budget(BudgetFailure::Edges))
+    );
+}
+fn close_by_postcheck_overrun(ledger: &mut WorkLedger) {
+    assert_eq!(
+        ledger.effect::<(), ()>(Cost::default(), edges(1), |post| post.spend(edges(2))),
+        Err(Failure::Budget(BudgetFailure::ReservedPostcheck))
+    );
+}
+
+#[test]
+fn settlement_is_spendable_after_each_way_the_ledger_closes() {
+    type Closer = fn(&mut WorkLedger);
+    let closers: [(&str, Closer); 5] = [
+        ("nested failure", close_by_nested_failure),
+        ("unwind", close_by_unwind),
+        ("swallowed failure", close_by_swallowed_failure),
+        ("budget overrun", close_by_budget_overrun),
+        ("postcheck overrun", close_by_postcheck_overrun),
+    ];
+    for (name, close) in closers {
+        let mut ledger = WorkLedger::new();
+        let reserve = ledger.reserve_settlement(edges(4)).unwrap();
+        assert_eq!(ledger.used(), edges(4), "{name}: charged at once");
+        close(&mut ledger);
+        refuses_everything_outside_settle(&mut ledger);
+        let used = ledger.used();
+        let ran = Cell::new(false);
+        let value = ledger
+            .settle::<_, ()>(reserve, |work| {
+                ran.set(true);
+                work.charge(edges(1))?;
+                work.run(edges(3), |_| Ok(name))
+            })
+            .unwrap();
+        assert!(ran.get(), "{name}: admitted after the latch");
+        assert_eq!(value, name);
+        assert_eq!(ledger.used(), used, "{name}: drawn from the allowance");
+        // The settlement reopens nothing.
+        refuses_everything_outside_settle(&mut ledger);
+    }
+}
+
+#[test]
+fn charges_inside_settle_draw_only_from_the_allowance() {
+    // The limits are exhausted and the ledger has failed; every charge below
+    // still succeeds because it draws only from the settlement's allowance.
+    let limits = Cost {
+        objects: 2,
+        edges: 20,
+        bytes: 64,
+    };
+    let mut ledger = WorkLedger::with_limits(limits).unwrap();
+    let reserve = ledger.reserve_settlement(limits).unwrap();
+    assert_eq!(ledger.used(), limits);
+    close_by_budget_overrun(&mut ledger);
+    ledger
+        .settle::<_, ()>(reserve, |work| {
+            let before = work.used();
+            work.charge(edges(2))?;
+            work.run(edges(1), |inner| inner.charge(edges(1)))?;
+            work.retained_record(16, |_| Ok(()))?;
+            // A nested effect reserves its postchecks from the same allowance,
+            // and its prepaid run carves from those postchecks.
+            work.effect(edges(2), edges(8), |post| {
+                post.prepaid(edges(5), |paid| {
+                    paid.charge(edges(1))?;
+                    paid.run(edges(1), |_| Ok(()))?;
+                    paid.effect(edges(1), edges(2), |nested| {
+                        nested.spend(edges(1))?;
+                        nested.prepaid(edges(1), |deep| deep.charge(edges(1)))
+                    })
+                })?;
+                post.spend(edges(3))
+            })?;
+            assert_eq!(work.used(), before);
+            Ok(())
+        })
+        .unwrap();
+    assert_eq!(ledger.used(), limits);
+    assert!(ledger.is_failed());
+}
+
+#[test]
+fn overrun_inside_settle_is_refused_before_the_work_and_latches_both() {
+    // A direct overrun, on a ledger that was still open.
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(3)).unwrap();
+    let ran = Cell::new(false);
+    assert_eq!(
+        ledger.settle::<(), ()>(reserve, |work| {
+            work.charge(edges(2))?;
+            work.run(edges(2), |_| {
+                ran.set(true);
+                Ok(())
+            })
+        }),
+        Err(Failure::Budget(BudgetFailure::ReservedPostcheck))
+    );
+    assert!(!ran.get());
+    assert_eq!(ledger.used(), edges(3));
+    refuses_everything_outside_settle(&mut ledger);
+
+    // A swallowed overrun latches the settlement: nothing more is drawn.
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(5)).unwrap();
+    close_by_nested_failure(&mut ledger);
+    closed(ledger.settle::<(), ()>(reserve, |work| {
+        assert_eq!(
+            work.charge::<()>(edges(6)),
+            Err(Failure::Budget(BudgetFailure::ReservedPostcheck))
+        );
+        assert!(work.is_failed());
+        closed(work.charge::<()>(Cost::default()));
+        closed(work.run::<(), ()>(Cost::default(), |_| panic!("after the overrun")));
+        Ok(())
+    }));
+    refuses_everything_outside_settle(&mut ledger);
+
+    // An effect whose reservation exceeds the allowance never runs.
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(4)).unwrap();
+    assert_eq!(
+        ledger.settle::<(), ()>(reserve, |work| {
+            work.effect(edges(2), edges(3), |_| {
+                panic!("effect beyond the allowance")
+            })
+        }),
+        Err(Failure::Budget(BudgetFailure::ReservedPostcheck))
+    );
+    refuses_everything_outside_settle(&mut ledger);
+}
+
+#[test]
+fn err_or_unwind_inside_settle_latches_both() {
+    // A returned Err.
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(2)).unwrap();
+    assert_eq!(
+        ledger.settle::<(), _>(reserve, |work| {
+            work.charge(edges(1))?;
+            Err(Failure::Operation("REV append busy"))
+        }),
+        Err(Failure::Operation("REV append busy"))
+    );
+    refuses_everything_outside_settle(&mut ledger);
+
+    // A nested Err that the action swallows still latches the settlement.
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(4)).unwrap();
+    let second = Cell::new(false);
+    closed(ledger.settle::<(), ()>(reserve, |work| {
+        let _ = work.run::<(), ()>(edges(1), |_| Err(Failure::Operation(())));
+        // No CLN after a failed REV: the second step is refused.
+        closed(work.run::<(), ()>(edges(1), |_| {
+            second.set(true);
+            Ok(())
+        }));
+        Ok(())
+    }));
+    assert!(!second.get());
+    refuses_everything_outside_settle(&mut ledger);
+
+    // An unwind, on an already failed ledger and on an open one.
+    for prefail in [true, false] {
+        let mut ledger = WorkLedger::new();
+        let reserve = ledger.reserve_settlement(edges(2)).unwrap();
+        if prefail {
+            close_by_unwind(&mut ledger);
+        }
+        assert!(
+            catch_unwind(AssertUnwindSafe(|| {
+                let _ = ledger.settle::<(), ()>(reserve, |work| {
+                    work.charge(edges(1))?;
+                    panic!("end-path append unwound")
+                });
+            }))
+            .is_err()
+        );
+        refuses_everything_outside_settle(&mut ledger);
+    }
+}
