+#[test]
+fn a_successful_settlement_on_an_open_ledger_leaves_it_open_and_refunds_nothing() {
+    let mut ledger = WorkLedger::new();
+    let reserve = ledger.reserve_settlement(edges(5)).unwrap();
+    ledger
+        .settle::<_, ()>(reserve, |work| work.charge(edges(1)))
+        .unwrap();
+    assert!(!ledger.is_failed());
+    assert_eq!(ledger.used(), edges(5));
+    ledger.charge::<()>(edges(1)).unwrap();
+    assert_eq!(ledger.used(), edges(6));
+    // Dropping a reserve unspent forfeits it; nothing returns to the limits.
+    let mut ledger = WorkLedger::new();
+    let _ = ledger.reserve_settlement(edges(5)).unwrap();
+    assert_eq!(ledger.used(), edges(5));
+    assert!(!ledger.is_failed());
+}
