+#[test]
+fn no_production_source_reserves_or_settles_yet() {
+    // X3d-0 has no production caller. X3d-1 (law X3d r6 items 8 and 13)
+    // replaces this pin with one that admits exactly StoppedSession's private
+    // end-path step for `reserve_settlement` and `finish` for `settle`. A
+    // `settle` call needs a `SettlementReserve`, which only
+    // `reserve_settlement` constructs, so naming neither excludes both.
+    let _: Option<SettlementReserve> = None;
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let allowed = [
+        root.join("crates/platform/src/work_ledger.rs"),
+        root.join("crates/platform/src/lib.rs"),
+    ];
+    let mut stack = vec![root.join("crates"), root.join("apps")];
+    let mut sources = 0;
+    while let Some(dir) = stack.pop() {
+        for entry in std::fs::read_dir(&dir).unwrap() {
+            let path = entry.unwrap().path();
+            if path.is_dir() {
+                // Integration tests are not production source.
+                if path
+                    .file_name()
+                    .is_some_and(|n| n == "tests" || n == "target" || n == "node_modules")
+                {
+                    continue;
+                }
+                stack.push(path);
+                continue;
+            }
+            if path.extension().is_none_or(|e| e != "rs") || allowed.contains(&path) {
+                continue;
+            }
+            sources += 1;
+            let text = std::fs::read_to_string(&path).unwrap();
+            for name in ["reserve_settlement", "SettlementReserve"] {
+                assert!(!text.contains(name), "{} names {name}", path.display());
+            }
+        }
+    }
+    assert!(sources > 100, "walked the workspace sources");
+    let lib = std::fs::read_to_string(&allowed[1]).unwrap();
+    assert_eq!(lib.matches("SettlementReserve").count(), 1);
+    assert!(!lib.contains("reserve_settlement"));
+}
