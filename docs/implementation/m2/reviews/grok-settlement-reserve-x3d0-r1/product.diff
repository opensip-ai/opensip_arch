+#[test]
+fn a_reserve_from_another_instance_is_refused_before_its_action() {
+    let mut issuer = WorkLedger::new();
+    let foreign = issuer.reserve_settlement(edges(2)).unwrap();
+
+    // To a ledger with no reserve of its own.
+    let mut other = WorkLedger::new();
+    closed(other.settle::<(), ()>(foreign, |_| panic!("foreign settlement ran")));
+    assert_eq!(other.used(), Cost::default());
+    refuses_everything_outside_settle(&mut other);
+    // The issuer is unaffected, and its reserve was consumed by the refusal.
+    assert!(!issuer.is_failed());
+    assert_eq!(issuer.used(), edges(2));
+
+    // To a ledger that holds its own reserve: refused, and that ledger's own
+    // reserve is still the only one it admits.
+    let mut issuer = WorkLedger::new();
+    let foreign = issuer.reserve_settlement(edges(2)).unwrap();
+    let mut other = WorkLedger::new();
+    let own = other.reserve_settlement(edges(1)).unwrap();
+    closed(other.settle::<(), ()>(foreign, |_| panic!("foreign settlement ran")));
+    refuses_everything_outside_settle(&mut other);
+    other
+        .settle::<_, ()>(own, |work| work.charge(edges(1)))
+        .unwrap();
+}
