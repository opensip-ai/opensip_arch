+#[test]
+fn ledgers_without_a_settlement_are_unchanged() {
+    // Taking and spending a reserve on one ledger changes nothing on another.
+    let mut settled = WorkLedger::new();
+    let reserve = settled.reserve_settlement(edges(1)).unwrap();
+    let mut plain = WorkLedger::new();
+    close_by_nested_failure(&mut plain);
+    settled.settle::<_, ()>(reserve, |_| Ok(())).unwrap();
+    refuses_everything_outside_settle(&mut plain);
+    assert_eq!(plain.used(), edges(1));
+}
