+#[test]
+fn one_reservation_per_instance_and_none_on_a_closed_ledger() {
+    // A second reservation, while the first is outstanding, is refused
+    // Closed, takes nothing and latches. The first stays spendable.
+    let mut ledger = WorkLedger::new();
+    let first = ledger.reserve_settlement(edges(2)).unwrap();
+    assert_eq!(
+        ledger.reserve_settlement(edges(1)).err(),
+        Some(BudgetFailure::Closed)
+    );
+    assert_eq!(ledger.used(), edges(2));
+    refuses_everything_outside_settle(&mut ledger);
+    ledger
+        .settle::<_, ()>(first, |work| work.charge(edges(2)))
+        .unwrap();
+
+    // After it was spent, too.
+    let mut ledger = WorkLedger::new();
+    let first = ledger.reserve_settlement(edges(1)).unwrap();
+    ledger.settle::<_, ()>(first, |_| Ok(())).unwrap();
+    assert!(!ledger.is_failed());
+    assert_eq!(
+        ledger.reserve_settlement(edges(1)).err(),
+        Some(BudgetFailure::Closed)
+    );
+    assert_eq!(ledger.used(), edges(1));
+    refuses_everything_outside_settle(&mut ledger);
+
+    // A closed ledger refuses the reservation and takes nothing.
+    let mut ledger = WorkLedger::new();
+    close_by_swallowed_failure(&mut ledger);
+    let used = ledger.used();
+    assert_eq!(
+        ledger.reserve_settlement(edges(1)).err(),
+        Some(BudgetFailure::Closed)
+    );
+    assert_eq!(ledger.used(), used);
+    refuses_everything_outside_settle(&mut ledger);
+
+    // A cost beyond the remaining limits is refused on its dimension, takes
+    // nothing and latches, with no new BudgetFailure variant.
+    for (cost, expected) in [
+        (
+            Cost {
+                objects: 3,
+                ..Cost::default()
+            },
+            BudgetFailure::Objects,
+        ),
+        (edges(3), BudgetFailure::Edges),
+        (
+            Cost {
+                bytes: 3,
+                ..Cost::default()
+            },
+            BudgetFailure::Bytes,
+        ),
+    ] {
+        let mut ledger = WorkLedger::with_limits(Cost {
+            objects: 2,
+            edges: 2,
+            bytes: 2,
+        })
+        .unwrap();
+        assert_eq!(ledger.reserve_settlement(cost).err(), Some(expected));
+        assert_eq!(ledger.used(), Cost::default());
+        refuses_everything_outside_settle(&mut ledger);
+    }
+}
