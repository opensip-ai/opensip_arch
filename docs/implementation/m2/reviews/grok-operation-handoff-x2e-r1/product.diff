+//! Law X3b r10 items 1, 3, 3a, 4 and 11 (unit X3b-3, composed with X2e's
+//! operation handoff, law X2 r8 item 7a): the journal half of one writer
+//! operation. It adds no carrier semantics; it composes X3b-1's and X3b-2's
+//! steps in the order X2's single fence hold fixes:
+//! - `operation_floor_step`: item 3's floor step at X2's lease-free point,
+//!   under the fence with no project lock held, keeping the observation the
+//!   start must confirm;
+//! - `operation_start`: inside X2e's handoff, under the fence and the
+//!   operation's APPEND-WRITE or EXCLUSIVE lease, item 3a's creation when
+//!   the floor step found INIT, then item 4's carrier start, then item 6's
+//!   `JournalAppendLock` from that start;
+//! - `operation_end_copy`: item 4's end step, steps 4 and 5, after the
+//!   operation's lease is released and the fence retaken by the composition
+//!   owner, with no project lock held. After an uncertain outcome the
+//!   composition owner never calls it (r9: nothing follows; the next
+//!   writer's floor step and start reconcile).
+//!
+//! `CarrierLocation::admitted` is item 11's production constructor: it is
+//! built only from the `CarrierPlace` X2e's handoff confirms, never from a
+//! caller's paths. Every refusal keeps its item 8 row (`CarrierRow`); the
+//! composition owner names it. Library only.
+use super::append::JournalAppendLock;
+#[cfg(test)]
+pub(crate) use super::append::{AppendError, RecordDraft};
+use super::start::{EndInput, carrier_start, end_step};
+pub(crate) use super::start::{EndOutcome, StartReconciliation};
+use super::{
+    CarrierLocation, CarrierRefusal, CommittedTail, CreationOutcome, FloorStepOutcome, Refused,
+    create_carrier, floor_step_observed, refuse,
+};
+use crate::custody::operation_handoff::CarrierPlace;
+use opensip_platform::WorkScope;
+
+impl<'a> CarrierLocation<'a> {
+    /// Item 11's production constructor: the location of the namespace X2e
+    /// admitted, leased and confirmed, with the `I/trust` it confirmed under
+    /// the same fence. There is no other production constructor.
+    pub(crate) fn admitted(place: &CarrierPlace<'a>) -> Self {
+        Self {
+            trust: place.trust(),
+            namespace: place.namespace(),
+            namespace_path: place.namespace_path(),
+            namespace_id: place.namespace_id(),
+            uid: place.uid(),
+        }
+    }
+}
+
+/// Item 3's result at the lease-free point: what the floor step did, and the
+/// committed tail the carrier start must confirm (absent only when the probe
+/// found `writer.lease` busy and the step was skipped). Private, not Clone.
+#[derive(Debug)]
+pub(crate) struct OperationFloor {
+    outcome: FloorStepOutcome,
+    observed: Option<CommittedTail>,
+}
+impl OperationFloor {
+    pub(crate) fn outcome(&self) -> &FloorStepOutcome {
+        &self.outcome
+    }
+}
+
+/// Item 3: the floor step, under the fence with no project lock held, before
+/// X2d takes the lease. A skip on a busy `writer.lease` writes nothing; X2d
+/// then reports the busy row.
+pub(crate) fn operation_floor_step(
+    location: &CarrierLocation<'_>,
+    work: &mut WorkScope<'_>,
+) -> Refused<OperationFloor> {
+    let (outcome, observed) = floor_step_observed(location, work)?;
+    Ok(OperationFloor { outcome, observed })
+}
+
+/// Item 4's start, as the operation holds it: the append lock (item 6), the
+/// start tail X4 binds its epoch to, what reconciliation did, and whether
+/// item 3a's creation ran. Private, not Clone; no append authority beyond
+/// the lock, which needs the operation's lease and level 3 to be used.
+pub(crate) struct OperationCarrier {
+    lock: JournalAppendLock,
+    tail: (i64, i64, Option<String>),
+    reconciliation: StartReconciliation,
+    created: Option<CreationOutcome>,
+}
+impl std::fmt::Debug for OperationCarrier {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OperationCarrier")
+            .field("tail", &self.tail)
+            .field("reconciliation", &self.reconciliation)
+            .field("created", &self.created)
+            .finish_non_exhaustive()
+    }
+}
+impl OperationCarrier {
+    /// The start tail: grant generation, committed sequence and body hash.
+    pub(crate) fn start_tail(&self) -> (i64, i64, Option<&str>) {
+        (self.tail.0, self.tail.1, self.tail.2.as_deref())
+    }
+    pub(crate) fn reconciliation(&self) -> StartReconciliation {
+        self.reconciliation
+    }
+    /// Item 3a's outcome, when the floor step found INIT.
+    pub(crate) fn created(&self) -> Option<CreationOutcome> {
+        self.created
+    }
+    /// The carrier's one append lock (item 6).
+    pub(crate) fn lock(&self) -> &JournalAppendLock {
+        &self.lock
+    }
+}
+
+/// Inside X2e's handoff, after the transfer and before the fence's release,
+/// under the operation's writer lease: item 3a's creation when the floor
+/// step found INIT (it re-observes its own preconditions), then item 4's
+/// start against the floor step's observation, then the append lock. A
+/// floor step skipped on a busy `writer.lease` left no observation to
+/// confirm: if the lease was nevertheless taken (the other writer released
+/// it in between), the start refuses on the busy row and writes nothing.
+pub(crate) fn operation_start(
+    location: &CarrierLocation<'_>,
+    floor: OperationFloor,
+    work: &mut WorkScope<'_>,
+) -> Refused<OperationCarrier> {
+    let OperationFloor { outcome, observed } = floor;
+    let Some(expected) = observed else {
+        return refuse(CarrierRefusal::Busy);
+    };
+    let created = match outcome {
+        FloorStepOutcome::InitFloorWritten | FloorStepOutcome::InitPending => {
+            Some(create_carrier(location, work)?)
+        }
+        _ => None,
+    };
+    let start = carrier_start(location, &expected, work)?;
+    let tail = {
+        let (generation, seq, body) = start.tail();
+        (generation, seq, body.map(str::to_owned))
+    };
+    let reconciliation = start.reconciliation();
+    let lock = JournalAppendLock::after_start(location, start)?;
+    Ok(OperationCarrier {
+        lock,
+        tail,
+        reconciliation,
+        created,
+    })
+}
+
+/// Item 4's end step, steps 4 and 5, after every journal outcome of the
+/// operation was certain: probe `writer.lease`, read the tail, copy the
+/// floor forward only if it is higher. The composition owner has released
+/// the lease, retaken the fence and holds no project lock.
+pub(crate) fn operation_end_copy(
+    location: &CarrierLocation<'_>,
+    work: &mut WorkScope<'_>,
+) -> Refused<EndOutcome> {
+    end_step(location, EndInput::Certain, work)
+}
