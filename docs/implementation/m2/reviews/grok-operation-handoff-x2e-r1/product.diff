+#[test]
+fn a_started_namespace_keeps_its_leases_but_not_the_exact_footprint() {
+    // Unit X2e: once X3b's carrier start has populated N, the registered
+    // recheck holds N to `Started`: private, both leases present, private
+    // and empty. `Exact` (X2c's and X2d's) still refuses the extra entries.
+    let fixture = ReadFixture::new("x2e-footprint");
+    let n = fixture.home.join("n");
+    private_directory(&n);
+    for name in [WRITER_LEASE, READERS_LEASE, "grant-journal.sqlite"] {
+        let file = n.join(name);
+        fs::write(&file, b"").unwrap();
+        fs::set_permissions(&file, fs::Permissions::from_mode(0o600)).unwrap();
+        private(&file);
+    }
+    let uid = fs::metadata(&n).unwrap().uid();
+    let retained = RetainedDirectory::from_retained_handle(File::open(&n).unwrap()).unwrap();
+    let check = |footprint| {
+        opensip_platform::WorkLedger::new()
+            .scope(|work| confirm_namespace_files(&retained, uid, footprint, Step::Handoff, work))
+    };
+    assert!(matches!(
+        check(Footprint::Exact),
+        Err(WorkFailure::Operation(RegistrationRefusal::Changed(
+            Owner::Namespace
+        )))
+    ));
+    check(Footprint::Started).unwrap();
+    // A lease that is no longer empty, or gone, is a change either way.
+    fs::write(n.join(READERS_LEASE), b"x").unwrap();
+    assert!(matches!(
+        check(Footprint::Started),
+        Err(WorkFailure::Operation(RegistrationRefusal::Changed(
+            Owner::Namespace
+        )))
+    ));
+    fs::remove_file(n.join(READERS_LEASE)).unwrap();
+    assert!(matches!(
+        check(Footprint::Started),
+        Err(WorkFailure::Operation(RegistrationRefusal::Changed(
+            Owner::Namespace
+        )))
+    ));
+}
