+//! Law X3b r10 items 3, 3a, 4 and 11 for unit X3b-3's journal half, on X3b-1's
+//! scratch carrier fixture: the floor step's observation carried to the
+//! start, creation only after an INIT floor step, the busy skip that leaves
+//! nothing to confirm, and the end copy after certain appends. The real
+//! composition under the fence and the lease is X2e's (operation_handoff).
+use super::super::append::RecordDraft;
+use super::super::tests::Fixture;
+use super::*;
+use opensip_platform::{FileLock, LockMode, WorkFailure, WorkLedger};
+use std::fs::{self, File};
+
+fn floor(f: &Fixture) -> Refused<OperationFloor> {
+    WorkLedger::new().scope(|w| operation_floor_step(&f.location(), w))
+}
+fn start(f: &Fixture, floor: OperationFloor) -> Refused<OperationCarrier> {
+    WorkLedger::new().scope(|w| operation_start(&f.location(), floor, w))
+}
+fn end(f: &Fixture) -> Refused<EndOutcome> {
+    WorkLedger::new().scope(|w| operation_end_copy(&f.location(), w))
+}
+/// One `RA` through the started carrier's lock.
+fn append_ra(f: &Fixture, carrier: &OperationCarrier) {
+    let location = f.location();
+    WorkLedger::new()
+        .scope(|w| {
+            let held = carrier.lock().begin(&location, w)?.acquire()?;
+            held.append(
+                &format!("op-{}", "a".repeat(32)),
+                &RecordDraft::Ra {
+                    request_ref: "request-1".into(),
+                },
+                w,
+            )
+            .map_err(|error| match error {
+                super::super::append::AppendError::Refused(f)
+                | super::super::append::AppendError::Undetermined(f) => f,
+            })
+        })
+        .unwrap();
+}
+
+#[test]
+fn an_init_floor_step_creates_then_starts_and_the_end_copy_follows_appends() {
+    let f = Fixture::new();
+    let observed = floor(&f).unwrap();
+    assert_eq!(observed.outcome(), &FloorStepOutcome::InitFloorWritten);
+    assert!(f.floor_path().exists());
+    // The floor step writes nothing in the namespace.
+    assert!(!f.carrier().exists() && !f.witness().exists());
+    let carrier = start(&f, observed).unwrap();
+    assert_eq!(carrier.created(), Some(CreationOutcome::Created));
+    assert_eq!(carrier.reconciliation(), StartReconciliation::Consistent);
+    assert_eq!(carrier.start_tail(), (1, 0, None));
+    assert!(f.carrier().exists() && f.witness().exists());
+    // Certain appends, then the end copy raises the floor to the tail.
+    let floor_before = fs::read(f.floor_path()).unwrap();
+    assert_eq!(end(&f).unwrap(), EndOutcome::Unchanged);
+    append_ra(&f, &carrier);
+    assert_eq!(fs::read(f.floor_path()).unwrap(), floor_before);
+    drop(carrier);
+    assert_eq!(end(&f).unwrap(), EndOutcome::CopiedForward);
+    assert_ne!(fs::read(f.floor_path()).unwrap(), floor_before);
+    // The next operation's floor step finds the floor at the tail.
+    let next = floor(&f).unwrap();
+    assert_eq!(next.outcome(), &FloorStepOutcome::Unchanged);
+    let carrier = start(&f, next).unwrap();
+    assert_eq!(carrier.created(), None);
+    assert_eq!(carrier.start_tail().1, 1);
+}
+
+#[test]
+fn an_init_floor_found_without_a_carrier_resumes_creation_at_the_start() {
+    let f = Fixture::new();
+    // A crash after the floor-first INIT write: the floor is there, no carrier.
+    let first = floor(&f).unwrap();
+    assert_eq!(first.outcome(), &FloorStepOutcome::InitFloorWritten);
+    drop(first);
+    let resumed = floor(&f).unwrap();
+    assert_eq!(resumed.outcome(), &FloorStepOutcome::InitPending);
+    let carrier = start(&f, resumed).unwrap();
+    assert_eq!(carrier.created(), Some(CreationOutcome::Created));
+    assert_eq!(carrier.start_tail(), (1, 0, None));
+}
+
+#[test]
+fn a_skipped_floor_step_leaves_nothing_to_confirm_and_the_start_refuses_busy() {
+    let f = Fixture::new();
+    let busy = FileLock::try_acquire(
+        File::open(f.namespace_path.join("writer.lease")).unwrap(),
+        LockMode::Exclusive,
+    )
+    .unwrap()
+    .unwrap();
+    let skipped = floor(&f).unwrap();
+    assert_eq!(skipped.outcome(), &FloorStepOutcome::Skipped);
+    assert!(!f.floors().exists());
+    // The other writer released `writer.lease` before this one's lease.
+    drop(busy);
+    match start(&f, skipped) {
+        Err(WorkFailure::Operation(refusal)) => {
+            assert!(matches!(refusal, CarrierRefusal::Busy));
+            assert_eq!(refusal.row(), super::super::CarrierRow::Busy);
+        }
+        other => panic!("{other:?}"),
+    }
+    assert!(!f.carrier().exists() && !f.witness().exists() && !f.floors().exists());
+}
+
+#[test]
+fn the_end_copy_is_skipped_while_another_writer_holds_the_lease() {
+    let f = Fixture::new();
+    let carrier = start(&f, floor(&f).unwrap()).unwrap();
+    append_ra(&f, &carrier);
+    drop(carrier);
+    let floor_before = fs::read(f.floor_path()).unwrap();
+    let busy = FileLock::try_acquire(
+        File::open(f.namespace_path.join("writer.lease")).unwrap(),
+        LockMode::Exclusive,
+    )
+    .unwrap()
+    .unwrap();
+    assert_eq!(end(&f).unwrap(), EndOutcome::Skipped);
+    assert_eq!(fs::read(f.floor_path()).unwrap(), floor_before);
+    drop(busy);
+}
