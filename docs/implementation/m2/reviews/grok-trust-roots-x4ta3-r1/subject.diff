+// Law X4T r10 item 3 (X4T-a3): the accepted root N of a retained head's
+// recorded chain. The head is the signing root M; N is the first `rootChain`
+// document of the payload metadata closure the head's root admission names.
+pub(super) struct ChainAnchor {
+    document: V,
+    root: ValidatedRootPayload,
+}
+impl ChainAnchor {
+    pub(super) fn authentication_context(
+        &self,
+        chain_budget: ChainBudget,
+    ) -> AuthenticationContext<'_> {
+        AuthenticationContext {
+            accepted_ref: &self.document,
+            accepted_root: &self.root,
+            chain_budget,
+        }
+    }
+}
+// The closure join: the chain must end on exactly the head's document, both
+// body and envelope references; a value-only match is not enough. N is the
+// first document's body, admitted as a root. Its own threshold, first identity
+// and the links N+1..M stay `verify_captured_core`'s.
+pub(super) fn bind_chain_anchor(
+    budget: &mut Budget,
+    closure_ref: &V,
+    head: &RetainedHead,
+    store: &mut impl crate::trust::root_payload::retained_metadata_index::Store,
+) -> Result<ChainAnchor, Error> {
+    budget.scope(|b| {
+        let raw = b.load(Collection::Records, closure_ref, store)?;
+        let closure =
+            S::admit(Definition::PayloadMetadataClosureV1, &raw).map_err(|_| Error::Shape)?;
+        let chain = array(&object(&closure).unwrap()["rootChain"]).unwrap();
+        // The closed shape already requires one to 64 documents.
+        let (Some(first), Some(last)) = (chain.first(), chain.last()) else {
+            return Err(Error::EmptyChain);
+        };
+        if last != head.document() {
+            return Err(Error::FinalIdentity);
+        }
+        let body = b.load(Collection::Objects, &object(first).unwrap()["body"], store)?;
+        let value = super::super::metadata::parse(&body).map_err(|_| Error::FirstIdentity)?;
+        let root = super::admit(&value, [true, true]).map_err(|_| Error::FirstIdentity)?;
+        Ok(ChainAnchor {
+            document: first.clone(),
+            root,
+        })
+    })
+}
