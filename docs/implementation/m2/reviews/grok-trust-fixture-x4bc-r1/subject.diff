+    let catalog = canonical_text(&format!(
+        r#"{{"catalogSchema":1,"expiresAt":"{}","issuedAt":"2026-10-01T00:00:00Z","releases":[{}],"reservedRootCommands":[],"revocationVersionRequired":1,"rootVersionRequired":{root_version},"snapshotVersion":1}}"#,
+        if knobs.catalog_expired {
