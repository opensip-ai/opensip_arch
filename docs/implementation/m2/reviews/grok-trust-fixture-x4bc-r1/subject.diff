+        if *revoked {
+            listed.push(("keyId", digest_hex(&key(Knobs::SIGNERS[role][2]))));
+        }
     }
+    let entries: Vec<String> = listed
+        .iter()
+        .map(|(kind, subject)| {
+            format!(
+                r#"{{"reason":"superseded","revokedAt":"{issued}","subject":"{subject}","subjectKind":"{kind}"}}"#
