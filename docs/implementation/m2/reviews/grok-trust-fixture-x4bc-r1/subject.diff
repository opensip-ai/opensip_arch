+        })
+        .collect();
+    let revocation = canonical_text(&format!(
+        r#"{{"entries":[{}],"issuedAt":"{issued}","revocationSchema":1,"revocationVersion":{},"rootVersion":{root_version}}}"#,
+        entries.join(","),
