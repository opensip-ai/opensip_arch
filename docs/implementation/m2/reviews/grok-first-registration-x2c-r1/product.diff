+#[test]
+fn document_lengths_and_later_spellings_are_exact() {
+    let rows: Vec<V> = (0..5)
+        .map(|i| {
+            row_json(
+                &numbered_project(i),
+                &numbered_namespace(i),
+                ["RESERVED", "ACTIVE", "RETIRED", "ABANDONED", "ACTIVE"][i],
+                format!("/p{i}").as_bytes(),
+                &[i as u8 + 1; 16],
+                i as u64,
+                -5,
+                7,
+            )
+        })
+        .collect();
+    let empty = document_bytes(Vec::new()).len();
+    let lengths: Vec<usize> = rows
+        .iter()
+        .map(|r| canonical_bytes(r).unwrap().len())
+        .collect();
+    let whole = document_bytes(rows.clone());
+    assert_eq!(document_length(empty, lengths.iter().copied()), whole.len());
+    assert_eq!(document_length(empty, std::iter::empty()), empty);
+    // Each live row's worst later spelling is exactly one byte longer.
+    let document = ProjectRegistryDocument::decode(&whole).unwrap();
+    for entry in document.entries() {
+        let now = canonical_bytes(&existing_row(entry, entry.status()).unwrap())
+            .unwrap()
+            .len();
+        let later = canonical_bytes(&existing_row(entry, worst_status(entry.status())).unwrap())
+            .unwrap()
+            .len();
+        let live = matches!(
+            entry.status(),
+            ProjectRegistryStatus::Reserved | ProjectRegistryStatus::Active
+        );
+        assert_eq!(later, now + usize::from(live));
+    }
+    // Re-encoding every decoded row reproduces the exact bytes.
+    let again: Vec<V> = document
+        .entries()
+        .iter()
+        .map(|e| existing_row(e, e.status()).unwrap())
+        .collect();
+    assert_eq!(document_bytes(again), whole);
+}
