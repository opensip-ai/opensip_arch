+#[test]
+fn a_registered_projects_recheck_sees_a_later_registry_change() {
+    let fixture = ReadFixture::new("x2c-after");
+    let project = fixture_project(&fixture);
+    let (mut writer, _trees) = writer(&fixture, "x2c-after");
+    let registered = register(&mut writer, &project, &Seam::live()).unwrap();
+    let path = fixture.installation.join(REGISTRY);
+    let bytes = fs::read(&path).unwrap();
+    fs::write(&path, bytes).unwrap();
+    let refusal = writer
+        .recheck_registered(&registered, &inputs())
+        .unwrap_err();
+    assert_eq!(
+        refusal.row(),
+        project_row(RegistrationRow::Admission(
+            ProjectAdmissionRow::RequiredFilesChanged
+        ))
+    );
+    spent(&mut writer, &project);
+}
