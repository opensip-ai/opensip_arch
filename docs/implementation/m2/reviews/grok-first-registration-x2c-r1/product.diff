+#[test]
+fn a_registry_or_marker_change_before_active_refuses_without_active() {
+    // The registry rewritten in place after RESERVED: R1's reconfirmation.
+    let fixture = ReadFixture::new("x2c-r1");
+    let project = fixture_project(&fixture);
+    let path = fixture.installation.join(REGISTRY);
+    let rewrite = |at: Point| {
+        if at == Point::MarkerWritten {
+            let bytes = fs::read(&path).unwrap();
+            fs::write(&path, bytes).unwrap();
+        }
+        false
+    };
+    let (mut writer, _trees) = writer(&fixture, "x2c-r1");
+    assert_eq!(
+        row(register(&mut writer, &project, &seam(&rewrite))),
+        project_row(RegistrationRow::Admission(
+            ProjectAdmissionRow::RequiredFilesChanged
+        ))
+    );
+    spent(&mut writer, &project);
+    let document = ProjectRegistryDocument::decode(&registry(&fixture)).unwrap();
+    assert_eq!(
+        document.entries()[0].status(),
+        ProjectRegistryStatus::Reserved
+    );
+
+    // The marker replaced after it was written: the marker owner's recheck.
+    let fixture = ReadFixture::new("x2c-marker");
+    let project = fixture_project(&fixture);
+    let marker = project.join(MARKER_DIRECTORY).join(MARKER_FILE);
+    let replace_marker = |at: Point| {
+        if at == Point::ActiveWritten {
+            let bytes = fs::read(&marker).unwrap();
+            fs::remove_file(&marker).unwrap();
+            fs::write(&marker, bytes).unwrap();
+        }
+        false
+    };
+    let (mut writer, _trees) = self::writer(&fixture, "x2c-marker");
+    // The change lands after ACTIVE's temporary file, so R1's reconfirm
+    // already passed; the stop comes from the name recheck after the rename
+    // only if the registry changed. Here ACTIVE publishes, and the final
+    // recheck sees the replaced marker.
+    assert_eq!(
+        row(register(&mut writer, &project, &seam(&replace_marker))),
+        project_row(RegistrationRow::Admission(
+            ProjectAdmissionRow::RequiredFilesChanged
+        ))
+    );
+    spent(&mut writer, &project);
+
+    // The marker replaced before step 6: no ACTIVE at all.
+    let fixture = ReadFixture::new("x2c-marker6");
+    let project = fixture_project(&fixture);
+    let marker = project.join(MARKER_DIRECTORY).join(MARKER_FILE);
+    let replace_early = |at: Point| {
+        if at == Point::MarkerWritten {
+            let bytes = fs::read(&marker).unwrap();
+            fs::remove_file(&marker).unwrap();
+            fs::write(&marker, bytes).unwrap();
+            fs::set_permissions(&marker, fs::Permissions::from_mode(0o600)).unwrap();
+            private(&marker);
+        }
+        false
+    };
+    let (mut writer, _trees) = self::writer(&fixture, "x2c-marker6");
+    assert_eq!(
+        row(register(&mut writer, &project, &seam(&replace_early))),
+        project_row(RegistrationRow::Admission(
+            ProjectAdmissionRow::RequiredFilesChanged
+        ))
+    );
+    let document = ProjectRegistryDocument::decode(&registry(&fixture)).unwrap();
+    assert_eq!(
+        document.entries()[0].status(),
+        ProjectRegistryStatus::Reserved
+    );
+}
