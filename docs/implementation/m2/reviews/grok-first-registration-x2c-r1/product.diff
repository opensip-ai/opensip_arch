+pub(crate) struct ProjectInputs<'a> {
+    pub(crate) trust_groups: &'a BTreeSet<u32>,
+    pub(crate) environment: &'a [(OsString, OsString)],
+    pub(crate) system_sources: &'a [&'a Path],
+}
