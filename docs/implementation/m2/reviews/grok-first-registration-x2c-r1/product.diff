+// Law X2 r8 item 6 (unit X2c), on scratch homes only. Each test publishes a
+// real P0 under a scratch H (`installation_read_fixture`), admits an
+// ordinary writer on it over 462's signed test trees (the write receipt and
+// the 468 gate with the scratch H), and registers a scratch project under
+// that H. Tracking reads an empty environment and no system sources.
+// Nothing here opens the real account's I or runs Git.
+use super::super::installation_admission::{GateSeam, HomeSource};
+use super::super::installation_read_fixture::{ReadFixture, private};
+use super::super::ordinary_writer::{OrdinaryWriteAdmission, admit_with};
+use super::super::project_admission::{ProjectRootAdmission, REGISTRY};
+use super::super::read_premise::{Write, WritePlatformReceipt, produce_for};
+use super::*;
+use crate::initial_installation::InitialInstallationAttempt;
+use crate::trust::{ReadProducers, read_producers};
+use opensip_identity::parse_json;
+use std::cell::Cell;
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::sync::atomic::AtomicBool;
+
+// ---------------------------------------------------------------- helpers
+
+fn directory(path: &Path, mode: u32) {
+    fs::create_dir(path).unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(mode)).unwrap();
+}
+/// A private installation directory, as the creator makes them.
+fn private_directory(path: &Path) {
+    directory(path, 0o700);
+    private(path);
+}
+/// A project under the fixture's H, 0755 with no ACL, as on a stock Mac.
+fn fixture_project(fixture: &ReadFixture) -> PathBuf {
+    let code = fixture.home.join("code");
+    directory(&code, 0o755);
+    let project = code.join("project");
+    directory(&project, 0o755);
+    project
+}
+/// An ordinary writer on the fixture's I, and the signed trees it needs.
+fn writer(fixture: &ReadFixture, tag: &str) -> (OrdinaryWriteAdmission, ReadProducers) {
+    let producers = read_producers(&format!("{tag}-write"), true, Some(&fixture.home));
+    let receipt = produce_for::<Write>(
+        InitialInstallationAttempt::for_tests(&AtomicBool::new(false), None),
+        InitialInstallationAttempt::observe_actor,
+        |attempt| producers.core(attempt),
+        |attempt, actor, core| producers.platform(attempt, actor, core),
+    )
+    .unwrap();
+    let admission = admit_with(
+        receipt,
+        WritePlatformReceipt::recheck,
+        || DurableWriteGate::for_tests(&AtomicBool::new(false), None),
+        |gate, receipt| {
+            gate.admit_with(
+                receipt.qualification(),
+                HomeSource::Fixture(&fixture.home),
+                &GateSeam::live(),
+            )
+        },
+    )
+    .unwrap();
+    (admission, producers)
+}
+const NO_GROUPS: &BTreeSet<u32> = &BTreeSet::new();
+fn inputs() -> ProjectInputs<'static> {
+    ProjectInputs {
+        trust_groups: NO_GROUPS,
+        environment: &[],
+        system_sources: &[],
+    }
+}
+/// The admission and the tracking observation on the writer's gate.
+fn admitted(
+    writer: &mut OrdinaryWriteAdmission,
+    project: &Path,
+) -> (ProjectRootAdmission, TrackingObservation) {
+    let admission = writer.admit_project_root(project, None, NO_GROUPS).unwrap();
+    let tracking = writer
+        .observe_project_tracking_with(&admission, &inputs())
+        .unwrap();
+    (admission, tracking)
+}
+fn register(
+    writer: &mut OrdinaryWriteAdmission,
+    project: &Path,
+    seam: &Seam<'_>,
+) -> Result<RegisteredProject, ProjectWriteRefusal> {
+    let (admission, tracking) = admitted(writer, project);
+    writer.register_first_use_with(admission, tracking, &inputs(), seam)
+}
+fn row(result: Result<RegisteredProject, ProjectWriteRefusal>) -> ProjectWriteRow {
+    match result {
+        Err(refusal) => refusal.row(),
+        Ok(registered) => panic!("expected a refusal, got {registered:?}"),
+    }
+}
+fn project_row(subject: RegistrationRow) -> ProjectWriteRow {
+    ProjectWriteRow::Project(subject)
+}
+/// A read session's classification of the root, after the writer is gone.
+fn classified(fixture: &ReadFixture, project: &Path) -> Classification {
+    let session = fixture.session(None).unwrap();
+    session
+        .admit_project_root(project, None, NO_GROUPS)
+        .unwrap()
+        .classification()
+        .clone()
+}
+fn registry(fixture: &ReadFixture) -> Vec<u8> {
+    fs::read(fixture.installation.join(REGISTRY)).unwrap()
+}
+fn names(path: &Path) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(path)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().into_string().unwrap())
+        .collect();
+    names.sort();
+    names
+}
+fn temporaries(fixture: &ReadFixture) -> usize {
+    names(&fixture.installation)
+        .iter()
+        .filter(|n| n.starts_with("project-registry.v2."))
+        .count()
+}
+fn mode(path: &Path) -> u32 {
+    fs::symlink_metadata(path).unwrap().mode() & 0o7777
+}
+fn seam<'a>(fault: &'a dyn Fn(Point) -> bool) -> Seam<'a> {
+    Seam {
+        fault: Some(fault),
+        draw: None,
+        live: std::marker::PhantomData,
+    }
+}
+/// The writer is spent: every later step refuses as latched.
+fn spent(writer: &mut OrdinaryWriteAdmission, project: &Path) {
+    assert!(matches!(
+        writer.admit_project_root(project, None, NO_GROUPS),
+        Err(ProjectWriteRefusal::Latched)
+    ));
+}
+
+/// One registry row as canonical JSON.
+#[allow(clippy::too_many_arguments)]
+fn row_json(
+    project: &str,
+    namespace: &str,
+    status: &str,
+    path: &[u8],
+    volume: &[u8; 16],
+    inode: u64,
+    seconds: i64,
+    nanos: u32,
+) -> V {
+    parse_json(
+        format!(
+            r#"{{"projectId":"{project}","namespaceId":"{namespace}","status":"{status}","allocationKind":"random","root":{{"platform":"macos","canonicalPathBytesHex":"{}","volumeIdentity":{{"kind":"macos-apfs-volume-uuid-v1","value":"{}"}},"inodeId":"{inode}","birthSeconds":{seconds},"birthNanoseconds":{nanos}}}}}"#,
+            hex(path),
+            hex(volume),
+        )
+        .as_bytes(),
+    )
+    .unwrap()
+}
+fn numbered_project(i: usize) -> String {
+    format!("prj1-{i:064x}")
+}
+fn numbered_namespace(i: usize) -> String {
+    format!("{i:08x}-0000-4000-8000-000000000000")
+}
+fn document_bytes(rows: Vec<V>) -> Vec<u8> {
+    canonical_bytes(&document_value(rows).unwrap()).unwrap()
+}
+/// The root's incarnation as the admission samples it.
+fn observed(project: &Path) -> Incarnation {
+    let path = opensip_platform::RetainedDirectoryPath::open_project_root(project, 256).unwrap();
+    let birth = path.directory().observe_birth().unwrap();
+    let volume = path.directory().observe_volume().unwrap();
+    Incarnation {
+        volume: *volume.uuid_bytes(),
+        inode: birth.metadata().inode,
+        birth_seconds: birth.birth_seconds(),
+        birth_nanoseconds: birth.birth_nanoseconds(),
+    }
+}
+/// The root's own registry row at `status`, and its marker.
+fn own_row(project: &Path, i: usize, status: &str) -> V {
+    let inc = observed(project);
+    row_json(
+        &numbered_project(i),
+        &numbered_namespace(i),
+        status,
+        project.as_os_str().as_bytes(),
+        &inc.volume,
+        inc.inode,
+        inc.birth_seconds,
+        inc.birth_nanoseconds,
+    )
+}
+fn write_marker(project: &Path, i: usize) {
+    let opensip = project.join(MARKER_DIRECTORY);
+    directory(&opensip, 0o700);
+    let marker = opensip.join(MARKER_FILE);
+    fs::write(&marker, marker_bytes(&numbered_project(i))).unwrap();
+    fs::set_permissions(&marker, fs::Permissions::from_mode(0o600)).unwrap();
+    private(&marker);
+}
