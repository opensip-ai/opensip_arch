+        .collect();
+    fixture.write(REGISTRY, &document_bytes(rows));
+    let before = registry(&fixture);
+    let (mut writer, _trees) = writer(&fixture, "x2c-rows");
+    assert_eq!(
+        row(register(&mut writer, &project, &Seam::live())),
+        project_row(RegistrationRow::ScopeLimit(
+            "registry-rows:4097>4096".into()
+        ))
+    );
+    assert_eq!(registry(&fixture), before);
+    assert!(!fixture.installation.join(HOST).exists());
+
+    // A registry 64 bytes under the cap: the RESERVED document is over it.
+    let fixture = ReadFixture::new("x2c-bytes");
+    let project = fixture_project(&fixture);
+    fixture.write(REGISTRY, &filled("RETIRED", PROJECT_REGISTRY_CAP - 64));
+    let (mut writer, _trees) = self::writer(&fixture, "x2c-bytes");
+    match row(register(&mut writer, &project, &Seam::live())) {
+        ProjectWriteRow::Project(RegistrationRow::ScopeLimit(subject)) => {
+            let (field, rest) = subject.split_once(':').unwrap();
+            let (n, limit) = rest.split_once('>').unwrap();
+            assert_eq!((field, limit), ("registry-bytes", "4194304"));
+            assert!(n.parse::<usize>().unwrap() > PROJECT_REGISTRY_CAP);
+        }
+        other => panic!("{other:?}"),
+    }
+    assert!(!fixture.installation.join(HOST).exists());
+
+    // ACTIVE rows: RESERVED fits, but every live row's later terminal
+    // spelling is one byte longer, and that document would not fit.
+    let fixture = ReadFixture::new("x2c-later");
+    let project = fixture_project(&fixture);
+    let new_row = {
+        let inc = observed(&project);
+        canonical_bytes(&row_json(
+            &numbered_project(1),
+            &numbered_namespace(1),
+            "RESERVED",
+            project.as_os_str().as_bytes(),
+            &inc.volume,
+            inc.inode,
+            inc.birth_seconds,
+            inc.birth_nanoseconds,
+        ))
+        .unwrap()
+        .len()
+    };
+    let existing = filled("ACTIVE", PROJECT_REGISTRY_CAP - new_row - 1 - 16);
+    let live = ProjectRegistryDocument::decode(&existing)
+        .unwrap()
+        .entries()
+        .len();
+    assert!(existing.len() + 1 + new_row <= PROJECT_REGISTRY_CAP);
+    assert!(existing.len() + 1 + new_row + live + 1 > PROJECT_REGISTRY_CAP);
+    fixture.write(REGISTRY, &existing);
+    let (mut writer, _trees) = self::writer(&fixture, "x2c-later");
+    let terminal = existing.len() + 1 + new_row + live + 1;
+    assert_eq!(
+        row(register(&mut writer, &project, &Seam::live())),
+        project_row(RegistrationRow::ScopeLimit(format!(
+            "registry-bytes:{terminal}>4194304"
+        )))
+    );
+    assert!(!fixture.installation.join(HOST).exists());
+}
