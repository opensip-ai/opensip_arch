+#[test]
+fn first_registration_publishes_reserved_namespace_marker_then_active() {
+    let fixture = ReadFixture::new("x2c-ok");
+    let project = fixture_project(&fixture);
+    let r0 = registry(&fixture);
+    let (mut writer, _trees) = writer(&fixture, "x2c-ok");
+    let registered = register(&mut writer, &project, &Seam::live()).unwrap();
+    let n = registered.namespace_id().to_owned();
+    let id = registered.project_id().to_owned();
+    assert_eq!(
+        registered.classification(),
+        Classification::Eligible {
+            namespace: n.clone(),
+            project: id.clone()
+        }
+    );
+    // The registry: R0's empty history plus exactly one ACTIVE random row
+    // binding this root's path and native incarnation.
+    assert_ne!(registry(&fixture), r0);
+    let document = ProjectRegistryDocument::decode(&registry(&fixture)).unwrap();
+    assert_eq!(document.raw(), registered.registry().document().raw());
+    let [entry] = document.entries() else {
+        panic!("one row");
+    };
+    assert_eq!(entry.status(), ProjectRegistryStatus::Active);
+    assert_eq!(entry.allocation_kind(), ProjectAllocationKind::Random);
+    assert_eq!(
+        (entry.project_id(), entry.namespace_id()),
+        (id.as_str(), n.as_str())
+    );
+    assert_eq!(entry.root().path_bytes(), project.as_os_str().as_bytes());
+    let inc = observed(&project);
+    assert_eq!(entry.root().volume_uuid_bytes(), &inc.volume);
+    assert_eq!(
+        (
+            entry.root().inode(),
+            entry.root().birth_seconds(),
+            entry.root().birth_nanoseconds()
+        ),
+        (inc.inode, inc.birth_seconds, inc.birth_nanoseconds)
+    );
+    // The namespace: private parents, and exactly two empty private leases.
+    let host = fixture.installation.join(HOST);
+    let projects = host.join(PROJECTS);
+    let namespace = projects.join(&n);
+    for dir in [&host, &projects, &namespace] {
+        assert_eq!(mode(dir), 0o700, "{dir:?}");
+    }
+    assert_eq!(names(&projects), vec![n.clone()]);
+    assert_eq!(names(&namespace), vec!["readers.lease", "writer.lease"]);
+    for lease in [WRITER_LEASE, READERS_LEASE] {
+        let path = namespace.join(lease);
+        assert_eq!(mode(&path), 0o600);
+        assert_eq!(fs::metadata(&path).unwrap().len(), 0);
+    }
+    // The marker: 0600, the exact frame, in a new 0700 `.opensip`.
+    let opensip = project.join(MARKER_DIRECTORY);
+    assert_eq!(mode(&opensip), 0o700);
+    assert_eq!(names(&opensip), vec![MARKER_FILE]);
+    let marker = fs::read(opensip.join(MARKER_FILE)).unwrap();
+    assert_eq!(marker.len(), 92);
+    assert_eq!(ProjectIdMarker::decode(&marker).unwrap().project_id(), id);
+    // No temporary file stays: both temporaries became the registry.
+    assert_eq!(temporaries(&fixture), 0);
+    // The gate's retained registry sample advanced with each publication:
+    // its recheck and the registered project's recheck pass.
+    writer.recheck_registered(&registered, &inputs()).unwrap();
+    // Registering again is not a first use: the same writer would refuse.
+    drop(registered);
+    writer.release().unwrap();
+    assert_eq!(
+        classified(&fixture, &project),
+        Classification::Eligible {
+            namespace: n.clone(),
+            project: id.clone()
+        }
+    );
+    let (mut again, _trees) = self::writer(&fixture, "x2c-ok-again");
+    assert_eq!(
+        row(register(&mut again, &project, &Seam::live())),
+        ProjectWriteRow::Project(RegistrationRow::Invariant)
+    );
+    assert_eq!(
+        ProjectRegistryDocument::decode(&registry(&fixture))
+            .unwrap()
+            .entries()
+            .len(),
+        1
+    );
+}
