+            namespace,
+            opensip,
+            marker,
+        };
+        let reserved = Some("RESERVED");
+        let recovery = || Classification::RecoveryNeeded {
+            namespace: String::new(),
+            project: String::new(),
+        };
+        [
+            (
+                P::ReservedWritten,
+                p(None, false, false, false, false, None),
+                Classification::FirstUseCandidate,
+            ),
+            (
+                P::ReservedRenamed,
+                p(reserved, false, false, false, false, None),
+                recovery(),
+            ),
+            (
+                P::ReservedConfirmed,
+                p(reserved, false, false, false, false, None),
+                recovery(),
+            ),
+            (
+                P::ParentsReady,
+                p(reserved, true, false, false, false, None),
+                recovery(),
+            ),
+            (
+                P::NamespaceStaged,
+                p(reserved, true, true, false, false, None),
+                recovery(),
+            ),
+            (
+                P::NamespacePublished,
+                p(reserved, true, false, true, false, None),
+                recovery(),
+            ),
+            (
+                P::MarkerDirectoryReady,
+                p(reserved, true, false, true, true, None),
+                recovery(),
+            ),
+            (
+                P::MarkerCreated,
+                p(reserved, true, false, true, true, Some(0)),
+                Classification::Contradiction,
+            ),
+            (
+                P::MarkerWritten,
+                p(reserved, true, false, true, true, Some(92)),
+                recovery(),
+            ),
+            (
+                P::ActiveWritten,
+                p(reserved, true, false, true, true, Some(92)),
+                recovery(),
+            ),
+            (
+                P::ActiveRenamed,
+                p(Some("ACTIVE"), true, false, true, true, Some(92)),
+                Classification::Eligible {
+                    namespace: String::new(),
+                    project: String::new(),
+                },
+            ),
+        ]
+    };
+    for (index, (point, expected, class)) in cases.into_iter().enumerate() {
+        let fixture = ReadFixture::new(&format!("x2c-stop{index}"));
+        let project = fixture_project(&fixture);
+        let (mut writer, _trees) = writer(&fixture, &format!("x2c-stop{index}"));
+        let fault = move |at: Point| at == point;
+        let result = register(&mut writer, &project, &seam(&fault));
+        assert_eq!(
+            row(result),
+            project_row(RegistrationRow::HostIo),
+            "{point:?}"
+        );
+        spent(&mut writer, &project);
+        writer.release().unwrap();
+        assert_eq!(prefix(&fixture, &project), expected, "{point:?}");
+        // Leftovers are the registry owner's explicit-recovery cases: a
+        // fresh read admission never sees a first use after RESERVED.
+        let observed = classified(&fixture, &project);
+        assert_eq!(
+            std::mem::discriminant(&observed),
+            std::mem::discriminant(&class),
+            "{point:?}: {observed:?}"
+        );
+        // A temporary file stays only where its rename did not run.
+        let left = matches!(point, P::ReservedWritten | P::ActiveWritten);
+        assert_eq!(temporaries(&fixture), usize::from(left), "{point:?}");
+    }
+}
