+// ------------------------------------------- durable prefixes and changes
+
+/// What the disk holds after a stop.
+#[derive(Debug, PartialEq, Eq)]
+struct Prefix {
+    status: Option<&'static str>,
+    parents: bool,
+    stage: bool,
+    namespace: bool,
+    opensip: bool,
+    marker: Option<usize>,
+}
+fn prefix(fixture: &ReadFixture, project: &Path) -> Prefix {
+    let document = ProjectRegistryDocument::decode(&registry(fixture)).unwrap();
+    let status = document.entries().first().map(|e| status_text(e.status()));
+    let projects = fixture.installation.join(HOST).join(PROJECTS);
+    let entries = if projects.exists() {
+        names(&projects)
+    } else {
+        Vec::new()
+    };
+    let marker = project.join(MARKER_DIRECTORY).join(MARKER_FILE);
+    Prefix {
+        status,
+        parents: projects.exists(),
+        stage: entries
+            .iter()
+            .any(|n| n.starts_with(".opensip-stage-install-")),
+        namespace: entries.iter().any(|n| !n.starts_with('.')),
+        opensip: project.join(MARKER_DIRECTORY).exists(),
+        marker: marker
+            .exists()
+            .then(|| fs::metadata(&marker).unwrap().len() as usize),
+    }
+}
