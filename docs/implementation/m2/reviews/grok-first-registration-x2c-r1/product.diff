+/// A registry whose canonical length is `target` or at most three bytes
+/// less, built from rows with long paths at `status`. Live
+/// rows get distinct ProjectIds, paths and incarnations.
+fn filled(status: &str, target: usize) -> Vec<u8> {
+    let make = |i: usize, width: usize| {
+        row_json(
+            &numbered_project(i + 100),
+            &numbered_namespace(i + 100),
+            status,
+            format!("/{i:0>width$}").as_bytes(),
+            &[0x22; 16],
+            // Fixed-width inodes keep every row's length the same.
+            i as u64 + 1_000_000,
+            0,
+            0,
+        )
+    };
+    let empty = document_bytes(Vec::new()).len();
+    let full = canonical_bytes(&make(0, 4095)).unwrap().len();
+    let short = canonical_bytes(&make(0, 8)).unwrap().len();
+    let mut rows = Vec::new();
+    let mut length = empty;
+    // Whole rows while more than two whole rows' room remains.
+    while target - length > 2 * (full + 1) {
+        rows.push(make(rows.len(), 4095));
+        length += full + usize::from(rows.len() > 1);
+    }
+    // Two last rows share the rest (hex adds two bytes per path byte).
+    let half = (target - length - 2) / 2;
+    for _ in 0..2 {
+        rows.push(make(rows.len(), 8 + (half - short) / 2));
+    }
+    let bytes = document_bytes(rows);
+    assert!(
+        bytes.len() <= target && bytes.len() + 3 >= target,
+        "{} {target}",
+        bytes.len()
+    );
+    ProjectRegistryDocument::decode(&bytes).unwrap();
+    bytes
+}
