+#[test]
+fn revert_advance_and_init_write_only_the_witness() {
+    // REVERT: PENDING one beyond the tail.
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 2, Some(&h('e')), false);
+    let floor = fs::read(f.floor_path()).unwrap();
+    let start = f.start(&tail(1, Some(&h('d')))).unwrap();
+    assert_eq!(start.reconciliation(), StartReconciliation::Reverted);
+    assert_eq!(
+        f.witness_state(),
+        (1, 1, Some(h('d')), WitnessState::Committed)
+    );
+    // ADVANCE: PENDING at the tail with its body.
+    f.append_raw(2, &h('e'));
+    f.plant_witness(1, 2, Some(&h('e')), false);
+    let start = f.start(&tail(2, Some(&h('e')))).unwrap();
+    assert_eq!(start.reconciliation(), StartReconciliation::Advanced);
+    assert_eq!(start.tail(), (1, 2, Some(h('e').as_str())));
+    assert_eq!(
+        f.witness_state(),
+        (1, 2, Some(h('e')), WitnessState::Committed)
+    );
+    // INIT: an empty journal with no witness.
+    let g = Fixture::new();
+    g.created();
+    fs::remove_file(g.witness()).unwrap();
+    let start = g.start(&CommittedTail::init()).unwrap();
+    assert_eq!(start.reconciliation(), StartReconciliation::Initialized);
+    assert_eq!(g.witness_state(), (1, 0, None, WitnessState::Committed));
+    // The start never writes the floor.
+    assert_eq!(fs::read(f.floor_path()).unwrap(), floor);
+}
