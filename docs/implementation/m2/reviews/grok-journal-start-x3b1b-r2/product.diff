+#[test]
+fn reconciliation_after_an_uncertain_outcome_copies_only_ok_revert_or_advance() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 1, Some(&h('d')), true);
+    assert_eq!(
+        f.reconcile().unwrap(),
+        UncertainReconciliation::Copyable(ReconciledTail(tail(1, Some(&h('d')))))
+    );
+    // REVERT writes the witness, then is copyable from the committed tail.
+    f.plant_witness(1, 2, Some(&h('e')), false);
+    assert_eq!(
+        f.reconcile().unwrap(),
+        UncertainReconciliation::Copyable(ReconciledTail(tail(1, Some(&h('d')))))
+    );
+    assert_eq!(
+        f.witness_state(),
+        (1, 1, Some(h('d')), WitnessState::Committed)
+    );
+    // QUARANTINE writes nothing.
+    fs::remove_file(f.witness()).unwrap();
+    assert_eq!(
+        f.reconcile().unwrap(),
+        UncertainReconciliation::Quarantined(Quarantine::WitnesslessRestore)
+    );
+    assert!(!f.witness().exists());
+    // INIT writes the witness COMMITTED 0, as the start does, but is not
+    // copyable: the end step then copies nothing.
+    let g = Fixture::new();
+    g.created();
+    fs::remove_file(g.witness()).unwrap();
+    let floor = fs::read(g.floor_path()).unwrap();
+    assert_eq!(g.reconcile().unwrap(), UncertainReconciliation::Initialize);
+    assert_eq!(g.witness_state(), (1, 0, None, WitnessState::Committed));
+    assert_eq!(
+        g.end(EndInput::Uncertain(None)).unwrap(),
+        EndOutcome::NotCopied
+    );
+    assert_eq!(fs::read(g.floor_path()).unwrap(), floor);
+    // A second reconciliation now finds OK.
+    assert_eq!(
+        g.reconcile().unwrap(),
+        UncertainReconciliation::Copyable(ReconciledTail(CommittedTail::init()))
+    );
+}
