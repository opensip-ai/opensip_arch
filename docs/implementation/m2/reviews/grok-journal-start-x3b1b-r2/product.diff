+//! The carrier start and the end step of law X3b r6 item 4 (unit X3b-1b),
+//! with the post-uncertainty reconciliation that X3d r3's `finish` relies on
+//! (X3b items 4 and 5; X3d item 7 steps 1 and 3). The start runs under the
+//! fence and the operation lease and writes only the witness. The end step
+//! runs under the fence with no project lock held and writes only the floor.
+//! Taking and releasing the fence and the lease belongs to the composition
+//! owner (X3b-3, with X2e); these functions take the location only.
+use super::{
+    CarrierClass, CarrierLocation, CarrierRefusal, CommittedTail, FLOORS_NAME, FloorDecision,
+    FloorObservation, Quarantine, Refused, WITNESS_NAME, WRITER_LEASE, canonical_namespace_id,
+    carrier_digest, classify_carrier, compare_with_floor, lease_probe_cost, lift, observe_floor,
+    observe_witness, publish_private_file, quarantine_kind, reconcile_witness, refuse,
+    witness_bytes, write_floor,
+};
+use crate::journal_store::WitnessProposal;
+use crate::private_access::observe_private_directory;
+use opensip_platform::{FileLock, LockMode, WorkFailure, WorkScope};
+use std::ffi::OsStr;
+
+/// What the carrier start's reconciliation did to the witness.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum StartReconciliation {
+    /// OK: the witness already named the committed tail. Nothing was written.
+    Consistent,
+    /// REVERT: a PENDING one beyond the tail became COMMITTED at the tail.
+    Reverted,
+    /// ADVANCE: a PENDING at the tail became COMMITTED at the tail.
+    Advanced,
+    /// INIT: an empty journal with no witness gained `COMMITTED 0`.
+    Initialized,
+}
+
+/// The carrier start's result: the start tail X4 binds its epoch to, and
+/// the reconciliation that ran. It grants no append authority by itself.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct CarrierStart {
+    tail: CommittedTail,
+    reconciliation: StartReconciliation,
+}
+impl CarrierStart {
+    /// The start tail: grant generation, committed sequence and its body hash.
+    pub(crate) fn tail(&self) -> (i64, i64, Option<&str>) {
+        (
+            self.tail.generation,
+            self.tail.seq,
+            self.tail.body.as_deref(),
+        )
+    }
+    pub(crate) fn reconciliation(&self) -> StartReconciliation {
+        self.reconciliation
+    }
+}
+
+/// Item 4's carrier start, inside X2e under the fence and the operation lease
+/// (APPEND-WRITE or EXCLUSIVE), after creation when the floor step found INIT.
+/// `expected` is the tail `floor_step_observed` returned. The carrier is
+/// opened and classified (format and `SHA-256(N)` binding), the tail and the
+/// witness are read, and the tail is confirmed equal to `expected` before any
+/// write. Then `reconcile_witness` runs: REVERT, ADVANCE and INIT write only
+/// the witness, by the file protocol; QUARANTINE refuses and writes nothing.
+/// The start writes no floor.
+pub(crate) fn carrier_start(
+    location: &CarrierLocation<'_>,
+    expected: &CommittedTail,
+    work: &mut WorkScope<'_>,
+) -> Refused<CarrierStart> {
+    if !canonical_namespace_id(location.namespace_id) {
+        return refuse(CarrierRefusal::NamespaceId);
+    }
+    let tail = match classify_carrier(location, work)? {
+        CarrierClass::Current(tail) => tail,
+        // Creation precedes the start whenever the floor step found no carrier.
+        CarrierClass::None => return refuse(CarrierRefusal::TailChanged),
+    };
+    let witness = observe_witness(location, work)?;
+    if &tail != expected {
+        return refuse(CarrierRefusal::TailChanged);
+    }
+    let reconciliation = match reconcile_witness(location.namespace_id, &tail, &witness) {
+        WitnessProposal::Consistent => StartReconciliation::Consistent,
+        WitnessProposal::Revert => {
+            write_committed_witness(location, &tail, work)?;
+            StartReconciliation::Reverted
+        }
+        WitnessProposal::Advance => {
+            write_committed_witness(location, &tail, work)?;
+            StartReconciliation::Advanced
+        }
+        WitnessProposal::Initialize => {
+            write_committed_witness(location, &tail, work)?;
+            StartReconciliation::Initialized
+        }
+        WitnessProposal::Quarantine => {
+            return refuse(CarrierRefusal::Quarantine(quarantine_kind(&witness)));
+        }
+        WitnessProposal::Unavailable => return refuse(CarrierRefusal::Unreadable),
+    };
+    Ok(CarrierStart {
+        tail,
+        reconciliation,
+    })
+}
+/// The witness `COMMITTED` at the committed tail, by the file protocol.
+fn write_committed_witness(
+    location: &CarrierLocation<'_>,
+    tail: &CommittedTail,
+    work: &mut WorkScope<'_>,
+) -> Refused<()> {
+    let bytes = witness_bytes(
+        location.namespace_id,
+        tail.generation,
+        tail.seq,
+        tail.body.as_deref(),
+        true,
+    )
+    .ok_or(WorkFailure::Operation(CarrierRefusal::Unreadable))?;
+    publish_private_file(location.namespace, WITNESS_NAME, &bytes, location.uid, work)
+        .map_err(lift(CarrierRefusal::File))
+}
+
+/// A committed tail established by reconciliation after an uncertain
+/// outcome. Only `reconcile_after_uncertain` makes one, so the end step can
+/// copy nothing but a reconciled tail (X3d item 7 step 3).
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct ReconciledTail(CommittedTail);
+
+/// The outcome of reconciling after an uncertain journal commit or barrier.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum UncertainReconciliation {
+    /// OK, REVERT or ADVANCE: the floor copy may run, from this tail only.
+    Copyable(ReconciledTail),
+    /// QUARANTINE: the floor stays untouched; the writer stored nothing.
+    Quarantined(Quarantine),
+    /// INIT: an empty journal with no witness. The witness `COMMITTED 0` was
+    /// written, as the start writes it; INIT is not OK, REVERT or ADVANCE,
+    /// so the floor copy stays off.
+    Initialize,
+}
+
+/// After a failure after visibility (item 5, §5.6), still under the
+/// operation lease: reopen the carrier and run `reconcile_witness`, writing
+/// only the witness on REVERT, ADVANCE or INIT (item 4). A refusal (including a read or
+/// write failure) is returned as `Err`; the floor stays untouched and the
+/// next opener reconciles.
+pub(crate) fn reconcile_after_uncertain(
+    location: &CarrierLocation<'_>,
+    work: &mut WorkScope<'_>,
+) -> Refused<UncertainReconciliation> {
+    if !canonical_namespace_id(location.namespace_id) {
+        return refuse(CarrierRefusal::NamespaceId);
+    }
+    let tail = match classify_carrier(location, work)? {
+        CarrierClass::Current(tail) => tail,
+        CarrierClass::None => return refuse(CarrierRefusal::TailChanged),
+    };
+    let witness = observe_witness(location, work)?;
+    match reconcile_witness(location.namespace_id, &tail, &witness) {
+        WitnessProposal::Consistent => Ok(UncertainReconciliation::Copyable(ReconciledTail(tail))),
+        WitnessProposal::Revert | WitnessProposal::Advance => {
+            write_committed_witness(location, &tail, work)?;
+            Ok(UncertainReconciliation::Copyable(ReconciledTail(tail)))
+        }
+        WitnessProposal::Initialize => {
+            write_committed_witness(location, &tail, work)?;
+            Ok(UncertainReconciliation::Initialize)
+        }
+        WitnessProposal::Quarantine => Ok(UncertainReconciliation::Quarantined(quarantine_kind(
+            &witness,
+        ))),
+        WitnessProposal::Unavailable => refuse(CarrierRefusal::Unreadable),
+    }
+}
+
+/// What the end step copies.
+#[derive(Debug)]
+pub(crate) enum EndInput {
+    /// The operation's journal outcomes were all durable: copy the committed
+    /// tail read under the end step's probe.
+    Certain,
+    /// The operation had an uncertain journal outcome. `Some` carries the
+    /// tail reconciliation established, the only tail copied; `None` (a
+    /// quarantine, INIT or failed reconciliation) copies nothing and runs no
+    /// effect at all.
+    Uncertain(Option<ReconciledTail>),
+}
+
+/// The end step's result. A refusal is disclosed by the caller and never
+/// rewrites the operation's outcome.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum EndOutcome {
+    /// `writer.lease` was busy: a later writer's start observed a tail at or
+    /// above ours. Nothing was copied.
+    Skipped,
+    /// An uncertain outcome without a copyable reconciliation: nothing ran.
+    NotCopied,
+    /// The floor already equals the tail.
+    Unchanged,
+    /// The floor was copied forward to the tail.
+    CopiedForward,
+}
+
+/// Item 4's end step, run after the operation lease is released and the
+/// fence retaken (by the composition owner), with no project lock held:
+/// probe `writer.lease` without waiting, read the tail to copy while the
+/// probe is held, release the probe, then copy the floor forward only if the
+/// tail is higher. The floor never moves down; a missing floor is
+/// `floorLost` and a floor above the tail is regression, each writing nothing.
+pub(crate) fn end_step(
+    location: &CarrierLocation<'_>,
+    input: EndInput,
+    work: &mut WorkScope<'_>,
+) -> Refused<EndOutcome> {
+    if !canonical_namespace_id(location.namespace_id) {
+        return refuse(CarrierRefusal::NamespaceId);
+    }
+    let reconciled = match input {
+        EndInput::Uncertain(None) => return Ok(EndOutcome::NotCopied),
+        EndInput::Uncertain(Some(ReconciledTail(tail))) => Some(tail),
+        EndInput::Certain => None,
+    };
+    let probe = work.run(lease_probe_cost(), |_| {
+        let file = location
+            .namespace
+            .open_regular(WRITER_LEASE)
+            .map_err(|e| WorkFailure::Operation(CarrierRefusal::Io(e)))?;
+        FileLock::try_acquire(file, LockMode::Exclusive)
+            .map_err(|e| WorkFailure::Operation(CarrierRefusal::Io(e)))
+    })?;
+    let Some(probe) = probe else {
+        return Ok(EndOutcome::Skipped);
+    };
+    let tail = match reconciled {
+        Some(tail) => tail,
+        None => match classify_carrier(location, work)? {
+            CarrierClass::Current(tail) => tail,
+            CarrierClass::None => {
+                return refuse(CarrierRefusal::Quarantine(Quarantine::UncertainTailLoss));
+            }
+        },
+    };
+    drop(probe);
+    let floors = location
+        .trust
+        .open_child_directory_if_present_accounted(OsStr::new(FLOORS_NAME), work)
+        .map_err(lift(CarrierRefusal::Io))?
+        .ok_or(WorkFailure::Operation(CarrierRefusal::Quarantine(
+            Quarantine::FloorLost,
+        )))?;
+    observe_private_directory(floors.as_file(), location.uid, work)
+        .map_err(lift(CarrierRefusal::Private))?;
+    let floor = match observe_floor(&floors, location, work)? {
+        FloorObservation::Present(floor) => floor,
+        FloorObservation::Absent => {
+            return refuse(CarrierRefusal::Quarantine(Quarantine::FloorLost));
+        }
+    };
+    if floor.project != carrier_digest(location.namespace_id) {
+        return refuse(CarrierRefusal::Binding);
+    }
+    match compare_with_floor(&floor, &tail) {
+        FloorDecision::CopyForward(tail) => {
+            write_floor(
+                &floors,
+                location,
+                tail.generation,
+                tail.seq,
+                tail.body.as_deref(),
+                work,
+            )?;
+            Ok(EndOutcome::CopiedForward)
+        }
+        FloorDecision::Unchanged => Ok(EndOutcome::Unchanged),
+        FloorDecision::Quarantine(kind) => refuse(CarrierRefusal::Quarantine(kind)),
+        FloorDecision::WriteInitFloor | FloorDecision::ResumeInit | FloorDecision::Unavailable => {
+            refuse(CarrierRefusal::Unreadable)
+        }
+    }
+}
