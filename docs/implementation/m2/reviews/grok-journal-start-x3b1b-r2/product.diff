+#[test]
+fn the_end_step_copies_the_committed_tail_forward_and_never_down() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 1, Some(&h('d')), true);
+    assert_eq!(f.end(EndInput::Certain).unwrap(), EndOutcome::CopiedForward);
+    assert_eq!(f.floor_state(), (1, 1, Some(h('d'))));
+    assert_eq!(f.end(EndInput::Certain).unwrap(), EndOutcome::Unchanged);
+    // The probe was released before the floor write.
+    drop(f.hold_writer_lease());
+    // A floor above the tail is regression and is not rewritten.
+    f.plant_floor(N, 1, 3, Some(&h('c')));
+    let before = fs::read(f.floor_path()).unwrap();
+    assert_eq!(
+        quarantine(f.end(EndInput::Certain)),
+        Quarantine::FloorRegression
+    );
+    assert_eq!(fs::read(f.floor_path()).unwrap(), before);
+    // A missing floor is floorLost, and none is created.
+    fs::remove_file(f.floor_path()).unwrap();
+    assert_eq!(quarantine(f.end(EndInput::Certain)), Quarantine::FloorLost);
+    assert!(!f.floor_path().exists());
+}
