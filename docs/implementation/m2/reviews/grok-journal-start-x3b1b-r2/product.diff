+#[test]
+fn a_consistent_start_writes_nothing_and_returns_the_start_tail() {
+    let f = Fixture::new();
+    f.created();
+    let witness = fs::metadata(f.witness()).unwrap().ino();
+    let floor = fs::read(f.floor_path()).unwrap();
+    let _lease = f.hold_writer_lease();
+    let start = f.start(&CommittedTail::init()).unwrap();
+    assert_eq!(start.reconciliation(), StartReconciliation::Consistent);
+    assert_eq!(start.tail(), (1, 0, None));
+    assert_eq!(fs::metadata(f.witness()).unwrap().ino(), witness);
+    assert_eq!(fs::read(f.floor_path()).unwrap(), floor);
+}
