+#[test]
+fn a_busy_writer_lease_skips_the_end_copy() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 1, Some(&h('d')), true);
+    let held = f.hold_writer_lease();
+    assert_eq!(f.end(EndInput::Certain).unwrap(), EndOutcome::Skipped);
+    assert_eq!(f.floor_state(), (1, 0, None));
+    drop(held);
+}
