+//! Law X3b r6 item 4's tests for X3b-1b, on scratch installations only: the
+//! carrier start's confirmation and reconciliation writes (OK, REVERT,
+//! ADVANCE, INIT, QUARANTINE), the post-uncertainty reconciliation, and the
+//! end step's probe, never-down copy, reconciled-tail-only copy and refusals.
+use super::super::tests::{Fixture, N, h, quarantine, refusal};
+use super::*;
+use crate::journal_store::{CarrierFloor, Witness, WitnessState};
+use opensip_platform::WorkLedger;
+use std::fs::{self, File};
+use std::os::unix::fs::MetadataExt;
+
+impl Fixture {
+    fn start(&self, expected: &CommittedTail) -> Refused<CarrierStart> {
+        WorkLedger::new().scope(|w| carrier_start(&self.location(), expected, w))
+    }
+    fn end(&self, input: EndInput) -> Refused<EndOutcome> {
+        WorkLedger::new().scope(|w| end_step(&self.location(), input, w))
+    }
+    fn reconcile(&self) -> Refused<UncertainReconciliation> {
+        WorkLedger::new().scope(|w| reconcile_after_uncertain(&self.location(), w))
+    }
+    fn witness_state(&self) -> (i64, i64, Option<String>, WitnessState) {
+        let w = Witness::from_file_bytes(&fs::read(self.witness()).unwrap())
+            .unwrap()
+            .record;
+        (w.generation, w.seq, w.body, w.state)
+    }
+    fn floor_state(&self) -> (i64, i64, Option<String>) {
+        let f: CarrierFloor = self.floor();
+        (f.generation, f.seq, f.body)
+    }
+    fn hold_writer_lease(&self) -> FileLock {
+        FileLock::try_acquire(
+            File::options()
+                .read(true)
+                .write(true)
+                .open(self.namespace_path.join("writer.lease"))
+                .unwrap(),
+            LockMode::Exclusive,
+        )
+        .unwrap()
+        .unwrap()
+    }
+}
+fn tail(seq: i64, body: Option<&str>) -> CommittedTail {
+    CommittedTail {
+        generation: 1,
+        seq,
+        body: body.map(str::to_string),
+    }
+}
