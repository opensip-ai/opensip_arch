+#[test]
+fn after_an_uncertain_outcome_only_the_reconciled_tail_is_copied() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 1, Some(&h('d')), true);
+    let reconciled = match f.reconcile().unwrap() {
+        UncertainReconciliation::Copyable(tail) => tail,
+        other => panic!("{other:?}"),
+    };
+    // A later writer appended after the lease was released.
+    f.append_raw(2, &h('e'));
+    f.plant_witness(1, 2, Some(&h('e')), true);
+    assert_eq!(
+        f.end(EndInput::Uncertain(Some(reconciled))).unwrap(),
+        EndOutcome::CopiedForward
+    );
+    assert_eq!(f.floor_state(), (1, 1, Some(h('d'))));
+    // Without a copyable reconciliation nothing runs, even with a higher tail.
+    let before = fs::read(f.floor_path()).unwrap();
+    let held = f.hold_writer_lease();
+    assert_eq!(
+        f.end(EndInput::Uncertain(None)).unwrap(),
+        EndOutcome::NotCopied
+    );
+    drop(held);
+    assert_eq!(fs::read(f.floor_path()).unwrap(), before);
+}
