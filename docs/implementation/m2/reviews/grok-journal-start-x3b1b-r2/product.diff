+#[test]
+fn a_quarantine_at_start_refuses_and_writes_nothing() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    let expected = tail(1, Some(&h('d')));
+    fs::remove_file(f.witness()).unwrap();
+    assert_eq!(
+        quarantine(f.start(&expected)),
+        Quarantine::WitnesslessRestore
+    );
+    assert!(!f.witness().exists());
+    fs::write(f.witness(), b"{bad").unwrap();
+    assert_eq!(quarantine(f.start(&expected)), Quarantine::WitnessMalformed);
+    assert_eq!(fs::read(f.witness()).unwrap(), b"{bad");
+    f.plant_witness(1, 3, Some(&h('e')), true);
+    assert_eq!(
+        quarantine(f.start(&expected)),
+        Quarantine::ProtocolViolation
+    );
+}
