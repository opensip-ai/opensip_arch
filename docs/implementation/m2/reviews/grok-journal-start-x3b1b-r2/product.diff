+#[test]
+fn a_moved_tail_or_missing_carrier_refuses_before_any_write() {
+    let f = Fixture::new();
+    f.created();
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 2, Some(&h('e')), false);
+    let before = fs::read(f.witness()).unwrap();
+    let r = refusal(f.start(&CommittedTail::init()));
+    assert!(matches!(r, CarrierRefusal::TailChanged), "{r:?}");
+    assert_eq!(r.row(), super::super::CarrierRow::LedgerCorrupt);
+    assert_eq!(fs::read(f.witness()).unwrap(), before);
+    let g = Fixture::new();
+    g.plant_floor(N, 1, 0, None);
+    assert!(matches!(
+        refusal(g.start(&CommittedTail::init())),
+        CarrierRefusal::TailChanged
+    ));
+    assert!(!g.witness().exists());
+}
