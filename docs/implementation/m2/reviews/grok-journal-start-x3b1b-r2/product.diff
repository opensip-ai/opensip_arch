+#[test]
+fn the_floor_step_reports_the_tail_the_start_must_confirm() {
+    let f = Fixture::new();
+    let (outcome, expected) = WorkLedger::new()
+        .scope(|w| super::super::floor_step_observed(&f.location(), w))
+        .unwrap();
+    assert_eq!(outcome, super::super::FloorStepOutcome::InitFloorWritten);
+    assert_eq!(expected, Some(CommittedTail::init()));
+    f.create().unwrap();
+    let held = f.hold_writer_lease();
+    let (outcome, expected) = WorkLedger::new()
+        .scope(|w| super::super::floor_step_observed(&f.location(), w))
+        .unwrap();
+    assert_eq!(
+        (outcome, expected),
+        (super::super::FloorStepOutcome::Skipped, None)
+    );
+    drop(held);
+    f.append_raw(1, &h('d'));
+    f.plant_witness(1, 1, Some(&h('d')), true);
+    let (_, expected) = WorkLedger::new()
+        .scope(|w| super::super::floor_step_observed(&f.location(), w))
+        .unwrap();
+    assert_eq!(expected, Some(tail(1, Some(&h('d')))));
+}
