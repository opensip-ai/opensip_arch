+/// The fenced read through X4T-b's `fenced_first_read`, or through X4B-b's
+/// `bootstrapping_first_read`, whose first result here is not F absent.
+fn read_by(
+    site: &Site,
+    owner: &mut RetainedCurrentTrust,
+    inputs: &ViewInputs<'_>,
+    bootstrapping: bool,
+) -> Result<AdmittedCurrentTrust, TrustRefusal> {
+    use super::super::trust_bootstrap::{BootstrapSource, bootstrapping_first_read};
+    if !bootstrapping {
