+// ------------------------------------------------- re-commit (X3c r8, X3c-3)
+
+/// The snapshot seed of the one Run the re-commit tests commit twice.
+const SEED: &str = "5eed5eed5eed5eed5eed5eed5eed5eed";
+const EXEC3: &str = "exec1_00000000000000000000000000000003";
+
+/// Every row of every table of the ledger, each as its columns' SQL
+/// `quote()` text (a BLOB as its hex), by table.
+fn dump(setup: &Setup) -> std::collections::BTreeMap<String, BTreeSet<String>> {
+    let snapshot = ReadSnapshot::open(&setup.ledger_path()).unwrap();
+    let c = &snapshot.0;
+    let names = |sql: &str| -> Vec<String> {
+        c.prepare(sql)
+            .unwrap()
+            .query_map([], |r| r.get(0))
+            .unwrap()
+            .map(Result::unwrap)
+            .collect()
+    };
+    names("SELECT name FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")
+        .into_iter()
+        .map(|table| {
+            let select = names(&format!("SELECT name FROM pragma_table_info('{table}')"))
+                .iter()
+                .map(|column| format!("quote(\"{column}\")"))
+                .collect::<Vec<_>>()
+                .join("||'|'||");
+            let rows = names(&format!("SELECT {select} FROM \"{table}\""));
+            (table, rows.into_iter().collect())
+        })
+        .collect()
+}
+/// The first commit of the Run `SEED` names, by `EXEC`, with one declared
+/// pin, committed.
+fn first_commit(setup: &mut Setup, schemas: &RegisteredSchemas) -> Material {
+    let first = setup.attempt(EXEC);
+    let m = material_of(SEED, EXEC, 1, 7, &[A, B]);
+    let p = pins(&m.run);
+    let published = setup
+        .publish(&first, vec![declared(A), declared(B)])
+        .unwrap();
+    let prepared = setup.begin(&first, published).unwrap();
+    let adapter = stage(
+        setup,
+        prepared,
+        schemas,
+        rows(&m, availability(schemas, &m.run, 0), &p),
+    )
+    .unwrap();
+    assert!(matches!(
+        adapter.commit(),
+        LedgerCommitOutcome::Committed { .. }
+    ));
+    m
+}
+fn no_pins(run: &str) -> Inventory {
+    Inventory::from_rows(run.into(), Vec::new()).unwrap()
+}
+
+/// Law X3c r8 item 12b (unit X3c-3), staging's half: a second attempt
+/// staging the same Run is a re-commit. Every object is confirmed; it stages
+/// its own receipt, association and Run material (byte-identical to the
+/// first's) at the next sequence, and no availability record or pin change;
+/// every earlier row is byte-identical afterwards.
+#[test]
+fn a_re_commit_stages_its_own_rows_and_no_availability_or_pins() {
+    let schemas = availability_registry();
+    let mut setup = Setup::new();
+    let m1 = first_commit(&mut setup, &schemas);
+    let before = dump(&setup);
+    let second = setup.attempt(EXEC2);
+    let m2 = material_of(SEED, EXEC2, 2, 8, &[A, B]);
+    assert_eq!(m2.run, m1.run);
+    let none = no_pins(&m2.run);
+    let published = setup
+        .publish(&second, vec![declared(A), declared(B)])
+        .unwrap();
+    assert!(
+        published
+            .objects()
+            .iter()
+            .all(|o| o.disposition() == ObjectDisposition::ConfirmedExisting)
+    );
+    let prepared = setup.begin(&second, published).unwrap();
+    let adapter = stage(
+        &mut setup,
+        prepared,
+        &schemas,
+        rows(&m2, availability(&schemas, &m2.run, 0), &none),
+    )
+    .unwrap();
+    assert_eq!(setup.count("commit_receipts"), 1, "staged, not committed");
+    assert_eq!(
+        adapter.commit(),
+        LedgerCommitOutcome::Committed {
+            execution: EXEC2.into()
+        }
+    );
+    for (table, n) in [
+        ("attempt_custody", 2),
+        ("commit_receipts", 2),
+        ("commit_associations", 2),
+        ("commit_run_material", 2),
+        ("evidence_availability", 1),
+        ("active_run_pins", 1),
+        ("pin_change_facts", 1),
+    ] {
+        assert_eq!(setup.count(table), n, "{table}");
+    }
+    let after = dump(&setup);
+    for (table, rows) in &before {
+        assert!(
+            rows.is_subset(&after[table]),
+            "{table}: an earlier row changed"
+        );
+    }
+    let snapshot = ReadSnapshot::open(&setup.ledger_path()).unwrap();
+    let material: Vec<(Vec<u8>, Vec<u8>)> = snapshot
+        .0
+        .prepare("SELECT manifest,inventory FROM commit_run_material ORDER BY execution")
+        .unwrap()
+        .query_map([], |r| Ok((r.get(0)?, r.get(1)?)))
+        .unwrap()
+        .map(Result::unwrap)
+        .collect();
+    assert_eq!(
+        material,
+        vec![(m1.manifest.clone(), m1.inventory.clone()); 2]
+    );
+    let sequences: Vec<String> = snapshot
+        .0
+        .prepare("SELECT commit_sequence FROM commit_associations ORDER BY length(commit_sequence),commit_sequence")
+        .unwrap()
+        .query_map([], |r| r.get(0))
+        .unwrap()
+        .map(Result::unwrap)
+        .collect();
+    assert_eq!(sequences, ["1", "2"]);
+    // The re-commit's own receipt joins its own attempt; E1's row is as it was.
+    let binding = SuppliedBinding {
+        store: &"ab".repeat(32),
+        namespace: N,
+        carrier: CARRIER,
+        execution: EXEC2,
+    };
+    assert_eq!(
+        snapshot.recovery_ledger(&binding).unwrap().standing(),
+        &LedgerStanding::ContinueCarrier {
+            pending_settlement: true,
+            legacy_custody_unknown: false
+        }
+    );
+    assert_eq!(setup.attempt_phase(EXEC), "admitted");
+    assert!(!setup.work.is_failed());
+}
