+
+/// What staging charges (law X3c r8 item 9, unit X3c-3): the pair's and the
+/// material's statements and bodies, the standing read and the `COMMIT`;
+/// then a first commit's availability and pin statements and bodies, or a
+/// re-commit's comparison and the bodies it may read.
+fn staging_cost(m: &Material, a: &AvailabilityRecord, p: &Inventory, first: bool) -> WorkCost {
+    let bytes = |n: usize| WorkCost {
+        bytes: n,
+        ..WorkCost::default()
+    };
+    let common = [
+        STAGE_COST,
+        STANDING_COST,
+        COMMIT_COST,
+        bytes(m.receipt.raw.len()),
+        bytes(m.association.raw.len()),
+        bytes(m.manifest.len()),
+        bytes(m.inventory.len()),
+    ];
+    let branch = if first {
+        [
+            FIRST_COMMIT_COST,
+            bytes(a.raw().len()),
+            bytes(p.disclosure_bytes() as usize),
+        ]
+    } else {
+        [
+            COMPARE_COST,
+            bytes(m.manifest.len()),
+            bytes(m.inventory.len()),
+        ]
+    };
+    common
+        .into_iter()
+        .chain(branch)
+        .try_fold(WorkCost::default(), WorkCost::checked_add)
+        .unwrap()
+}
+/// Stage `m` for `attempt` under a ledger of exactly `limits` (or none),
+/// returning the result and what that ledger used.
+fn stage_limited(
+    setup: &mut Setup,
+    schemas: &RegisteredSchemas,
+    attempt: &AdmittedAttempt,
+    m: &Material,
+    p: &Inventory,
+    limits: Option<WorkCost>,
+) -> (Refused<PreparedLedgerCommit>, WorkCost) {
+    let published = setup
+        .publish(attempt, vec![declared(A), declared(B)])
+        .unwrap();
+    let prepared = setup.begin(attempt, published).unwrap();
+    let mut ledger = limits.map_or_else(WorkLedger::new, |l| WorkLedger::with_limits(l).unwrap());
