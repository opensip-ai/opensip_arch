+/// Law X3c r8 items 9 and 12b (unit X3c-3): staging's reservation is
+/// exactly `staging_cost`, on a first commit and on a re-commit (which is not
+/// charged for the availability and pin statements it does not run). One
+/// unit short in any member refuses on the budget row before the first
+/// insert; the exact reservation commits.
+#[test]
+fn staging_one_unit_short_of_its_reservation_refuses_before_any_insert() {
+    let schemas = availability_registry();
+    let mut setup = Setup::new();
+    let first = setup.attempt(EXEC);
+    let second = setup.attempt(EXEC3);
+    let m1 = material_of(SEED, EXEC, 1, 7, &[A, B]);
+    let m2 = material_of(SEED, EXEC3, 2, 8, &[A, B]);
+    let p1 = pins(&m1.run);
+    let p2 = no_pins(&m2.run);
+    let a = availability(&schemas, &m1.run, 0);
+    let first_cost = staging_cost(&m1, &a, &p1, true);
+    let re_cost = staging_cost(&m2, &a, &p2, false);
+    assert_ne!(first_cost, re_cost);
+    for (label, attempt, m, p, cost, receipts) in [
+        ("first commit", &first, &m1, &p1, first_cost, 0),
+        ("re-commit", &second, &m2, &p2, re_cost, 1),
+    ] {
+        let (result, used) = stage_limited(&mut setup, &schemas, attempt, m, p, None);
+        assert_eq!(used, cost, "{label}: the reservation");
+        drop(result.unwrap());
+        for short in [
+            WorkCost {
+                objects: cost.objects - 1,
+                ..cost
+            },
+            WorkCost {
+                edges: cost.edges - 1,
+                ..cost
+            },
+            WorkCost {
+                bytes: cost.bytes - 1,
+                ..cost
+            },
+        ] {
+            let (result, _) = stage_limited(&mut setup, &schemas, attempt, m, p, Some(short));
+            assert!(
+                matches!(result, Err(WorkFailure::Budget(_))),
+                "{label}: {short:?}"
+            );
+            assert_eq!(setup.count("commit_receipts"), receipts, "{label}");
+            assert_eq!(setup.count("commit_run_material"), receipts, "{label}");
+            assert_eq!(setup.count("evidence_availability"), receipts, "{label}");
+        }
+        let (result, _) = stage_limited(&mut setup, &schemas, attempt, m, p, Some(cost));
+        assert!(matches!(
+            result.unwrap().commit(),
+            LedgerCommitOutcome::Committed { .. }
+        ));
+        assert_eq!(setup.count("commit_receipts"), receipts + 1, "{label}");
+    }
+    assert_eq!(setup.count("evidence_availability"), 1);
+}
