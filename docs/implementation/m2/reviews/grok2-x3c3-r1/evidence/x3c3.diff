+/// Law X3c r8 items 6a.5 and 12b (unit X3c-3): a re-commit that declares a
+/// pin is refused on the invariant row before any insert, through this
+/// crate-private construction of the staged rows (the facade declares none);
+/// the same re-commit with no declared pin commits.
+#[test]
+fn a_re_commit_that_declares_a_pin_is_refused_before_any_insert() {
+    let schemas = availability_registry();
+    let mut setup = Setup::new();
+    first_commit(&mut setup, &schemas);
+    let before = dump(&setup);
+    let second = setup.attempt(EXEC2);
+    let m = material_of(SEED, EXEC2, 2, 8, &[A, B]);
+    let declared_pins = pins(&m.run);
+    let published = setup
+        .publish(&second, vec![declared(A), declared(B)])
+        .unwrap();
+    let prepared = setup.begin(&second, published).unwrap();
+    assert_eq!(
+        row(stage(
+            &mut setup,
+            prepared,
+            &schemas,
+            rows(&m, availability(&schemas, &m.run, 0), &declared_pins),
+        )),
+        ProjectLedgerRow::Invariant
+    );
+    // Nothing inserted; only the refused attempt's own admitted row is new.
+    let mut after = dump(&setup);
+    let attempts = after.remove("attempt_custody").unwrap();
+    let mut expected = before;
+    assert!(
+        expected
+            .remove("attempt_custody")
+            .unwrap()
+            .is_subset(&attempts)
+    );
+    assert_eq!(attempts.len(), 2);
+    assert_eq!(after, expected);
+    // The transaction rolled back and released level 3.
+    let other = rusqlite::Connection::open(setup.ledger_path()).unwrap();
+    other.execute_batch("BEGIN IMMEDIATE; ROLLBACK").unwrap();
+    drop(other);
+    // The control: no declared pin, the same attempt commits.
+    let mut fresh = WorkLedger::new();
+    std::mem::swap(&mut setup.work, &mut fresh);
+    let published = setup
+        .publish(&second, vec![declared(A), declared(B)])
+        .unwrap();
+    let prepared = setup.begin(&second, published).unwrap();
+    let adapter = stage(
+        &mut setup,
+        prepared,
+        &schemas,
+        rows(&m, availability(&schemas, &m.run, 0), &no_pins(&m.run)),
+    )
+    .unwrap();
+    assert!(matches!(
+        adapter.commit(),
+        LedgerCommitOutcome::Committed { .. }
+    ));
+    assert_eq!(setup.count("commit_receipts"), 2);
+    assert_eq!(setup.count("active_run_pins"), 1);
