+
+impl WriteTransaction {
+    /// Law X3c r8 item 6a.2 (R8-2, unit X3c-3): staging's first step, in this
+    /// open transaction before any insert. It reads, under the binding's
+    /// store generation digest and N, R's current availability record
+    /// through the indexed read, and whether any Run-material row names R.
+    /// Each stored table must be its selected DDL, as every staging accessor
+    /// checks. Exactly one of the two is `LedgerError::OneSidedRun`. Attempt
+    /// rows, their phase, SEALs, objects and staging residue are never read.
+    pub(super) fn run_standing(
+        &self,
+        schemas: &RegisteredSchemas,
+        binding: &SuppliedBinding<'_>,
+        run: &str,
+        work: usize,
+    ) -> Result<RunStanding, LedgerError> {
+        if self.poisoned {
+            return Err(LedgerError::Configuration("transaction_poisoned"));
+        }
+        self.verify_material_definition()?;
+        let availability =
+            super::load_current_availability(&self.connection, schemas, binding, run, work)?;
+        let material: bool = self.connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM commit_run_material WHERE store_digest=?1 AND namespace=?2 AND run_id=?3)",
+            rusqlite::params![binding.store, binding.namespace, run],
+            |r| r.get(0),
+        )?;
+        match (availability.is_some(), material) {
+            (false, false) => Ok(RunStanding::First),
+            (true, true) => Ok(RunStanding::Committed),
+            _ => Err(LedgerError::OneSidedRun),
+        }
+    }
+    /// Law X3c r8 item 6a.3 (R8-3, unit X3c-3): on a re-commit, whether
+    /// `manifest` and `inventory` are byte-identical to R's committed Run
+    /// material, the material row of R in (S, N) with the least ExecutionId
+    /// in byte order. The stored lengths are compared first, so a stored body
+    /// longer than the attempt's own is never read. Nothing is written.
+    pub(super) fn committed_material_identical(
+        &self,
+        binding: &SuppliedBinding<'_>,
+        run: &str,
+        manifest: &[u8],
+        inventory: &[u8],
+    ) -> Result<bool, LedgerError> {
+        if self.poisoned {
+            return Err(LedgerError::Configuration("transaction_poisoned"));
+        }
+        self.verify_material_definition()?;
+        let least: Option<(String, i64, i64)> = self
+            .connection
+            .query_row(
+                "SELECT execution,length(manifest),length(inventory) FROM commit_run_material WHERE store_digest=?1 AND namespace=?2 AND run_id=?3 ORDER BY execution LIMIT 1",
+                rusqlite::params![binding.store, binding.namespace, run],
+                |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+            )
+            .optional()?;
+        let Some((execution, manifest_length, inventory_length)) = least else {
+            return Err(LedgerError::Configuration("run_material_missing"));
+        };
+        if usize::try_from(manifest_length).ok() != Some(manifest.len())
+            || usize::try_from(inventory_length).ok() != Some(inventory.len())
+        {
+            return Ok(false);
+        }
+        let mut statement = self.connection.prepare(
+            "SELECT manifest,inventory FROM commit_run_material WHERE store_digest=?1 AND namespace=?2 AND execution=?3",
+        )?;
+        let mut rows = statement.query(rusqlite::params![
+            binding.store,
+            binding.namespace,
+            execution
+        ])?;
+        let Some(row) = rows.next()? else {
+            return Err(LedgerError::Configuration("run_material_missing"));
+        };
+        let (ValueRef::Blob(stored_manifest), ValueRef::Blob(stored_inventory)) =
+            (row.get_ref(0)?, row.get_ref(1)?)
