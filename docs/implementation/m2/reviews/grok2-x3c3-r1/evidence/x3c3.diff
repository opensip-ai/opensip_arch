+/// decided only from its committed per-Run rows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum RunStanding {
+    /// Neither R's availability record nor any Run material of R exists:
+    /// this is R's first commit in (S, N).
