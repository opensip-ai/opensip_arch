on/m1/source-selection-v2/scoped-owner-succession.json", "sha256": "5c44edfe2c3c42afff95e91629f9f063550269c0a2dbc3dc07c380e041645b45"}, {"bytes": 6862, "path": "docs/implementation/m1/source-selection-v2/semantic-owner-joins.json", "sha256": "57a2ced48d76fa72c14ab5ad3d64745c81fd058ef38448cfa591604642cdb5a8"}, {"bytes": 22202, "path": "docs/implementation/m1/source-selection-v2/source-map.json", "sha256": "b997e33442a80719a366ecf964ea1f06751693ecff04c0ae5ea35f52920afd4a"}, {"bytes": 1854, "path": "docs/implementation/m1/source-selection-v3/README.md", "sha256": "781924809303faa3bb20d05a7ba9609b0c99ec1ce840e9c1d049340e1e13a29f"}, {"bytes": 6492, "path": "docs/implementation/m1/source-selection-v3/check_binding.py", "sha256": "254dc11248acbaf7ae6c9ff4893df6a283163e1e23962627ba27b4361625c2c0"}, {"bytes": 1587, "path": "docs/implementation/m1/source-selection-v3/correction.json", "sha256": "e27a834596136c6b5c7c7f89e1d48cb02ec941b9e20e3a11aa4727556c217c52"}], "passageOverrides": [{"after": "For finite CLI commands, CommandEnvelope.termination equals process termination when complete envelope admission, serialization and required delivery succeed. If required output fails, the existing machine-output-serialization-failed operation governs process termination (OUTPUT.SERIALIZATION_FAILED, operational-failed, exit4), even after an interrupted invocation aggregate. The earlier invocation aggregate, step results and committed Runs are preserved. Partial or complete earlier envelope bytes may already be visible; do not append a second normal envelope or claim atomic stream delivery. Required render-step failures retain their own DELIVERY.REQUIRED_FAILED law before this final operation.", "before": "For finite CLI commands, CommandEnvelope.termination equals process termination when serialization succeeds.", "parent": {"bytes": 131140, "path": "docs/coop/artifacts/d9-exit-contract.v1.14.json", "sha256": "8dd3303855f49bfdbb2751ee65f54a906405f0654159ebe815472f73cdf7da31"}, "selector": {"jsonPointer": "/invariants/1/text"}}, {"after": "        committed = [r['result']['runId'] for r in results if r['outcome'] == 'completed' and r.get('result', {}).get('runId')]", "before": "        committed = [r['result']['runId'] for r in required if r['outcome'] == 'completed' and r.get('result', {}).get('runId')]", "parent": {"bytes": 142811, "path": "docs/coop/design-corrections/workflows/workflows_model.v1.py", "sha256": "be37023f173f339edcd49b2019a2c6f3d424360a2c9cdcbf95bd382fa72066dc"}, "selector": {"line": 380}}], "selected": "docs/implementation/m1/source-selection-v3/successor.json", "sha256": "e638c55c3e0c807fe4540c5c0ea2e462886fc25ef5e2ee7df55efe28d3784ae4"}, {"inputs": [{"bytes": 4291, "path": "docs/implementation/m1/generator-selection-v1/README.md", "sha256": "16ca9df381c8dcc7b49db28b93f7014dd2beb54e117488a30675da82118bd1ed"}, {"bytes": 11454, "path": "docs/implementation/m1/generator-selection-v1/materialization-map.json", "sha256": "b55f2206c1fc4d9dc8f5adc477d8dcc95f5568e756376a9c15eb6f321d54df59"}, {"bytes": 20211, "path": "docs/implementation/m1/generator-selection-v1/product/schemas/registry.json", "sha256": "ec893f08c431ba4c25ddc8ffb1b3bf13ce730e55c61c31a11bcb2f50512f0554"}, {"bytes": 9564, "path": "docs/implementation/m1/generator-selection-v1/product/tools/build_contracts.py", "sha256": "dcb336dcdfd2ec8b9d363686fe883c93abef8a5233c61ed97649a8163676b8dd"}, {"bytes": 6122, "path": "docs/implementation/m1/generator-selection-v1/product/tools/contracts/Cargo.lock", "sha256": "6a31c2d958c51d38eb317f7e05345b63d6bc2625fe1f1eab98810ae6f3100a8e"}, {"bytes": 307, "path": "docs/implementation/m1/generator-selection-v1/product/tools/contracts/Cargo.toml", "sha256": "6b769285e95d2aa94a420fa63d74d6a199bbe84c9ceadef75550112fb3d88a7f"}, {"bytes": 9316, "path": "docs/implementation/m1/generator-selection-v1/product/tools/contracts/adapter.py", "sha256": "e471b4c17c334df5fd3e2511a5bf2a2e34ecfe46b7195ec5ba20d07bfa0d6aaf"}, {"bytes": 16629, "path": "docs/i