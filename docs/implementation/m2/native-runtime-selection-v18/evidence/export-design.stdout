tion/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/COPYING", "sha256": "42dcd63495f87b4eb7c7757afa379bb55a53f94afd7a5f657d9adf57236e515c"}, {"bytes": 1891, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/manifest.json", "sha256": "9cba2cdb58100a5632ddf4ae628bfa58e9b2967e9586594c080ba56dc87e8e84"}, {"bytes": 2452, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/metaschema.json", "sha256": "41da76f5afb7ce062d248f762463a92f7ca47e4e0f905b224ba6afeef91ded0f"}, {"bytes": 1659, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/applicator", "sha256": "c4a6e4147b91fef7fea6dc058cb1bf93402f7414b76578a8b16aaf1dad6aacef"}, {"bytes": 519, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/content", "sha256": "08343747764e4a5814262793cf4d652057a7913863c5950d43297e8e1fdac5b6"}, {"bytes": 1564, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/core", "sha256": "c2d12a8e4dd11d336dfc83a3f663aa4c69f0b49b3beb094ffeb25b5316f4803d"}, {"bytes": 448, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/format-annotation", "sha256": "abc775adfefd89d22358170d9bf93f4ebd2349563bbbedd60f02bef7c812bcc0"}, {"bytes": 892, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/meta-data", "sha256": "8f76d6e14f41b9b92ef933b708cdc5144c8b5268651ad11918485fb1754f1c76"}, {"bytes": 506, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/unevaluated", "sha256": "2dbfbcb73994b670b0976492adee1fffb46c21682784d2f5a4ca561f9e2d0cb4"}, {"bytes": 2834, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage-meta-2020-12/vocabularies/validation", "sha256": "7010a31e541f32d2be721e2de348df75c9b36876a3ed304877fc0abda1d37a58"}, {"bytes": 1785, "path": "docs/implementation/m2/stage-meta-reference-selection-v1/reference/stage_schema_model.v1.py", "sha256": "0353db4a8478d65631a2d9e5bce0ba65bed71a33007d8342365099a38274f784"}], "passageOverrides": [{"after": "Retained bytes are not a registration. The producer interface that owns the operation owns its output schema, so the schema is registered exactly when the Plan-selected producer closure carries it at the tree path for that operation; a new operation is registered by shipping its interface document in the admitted closure, never by a host or platform table. Document validation uses the stage-meta-reference-selection-v1 structural profile: the eight pinned Draft2020-12 default meta-schema resources with format annotations not asserted. Fixed meta-schema pattern assertions retain their published trailing-LF compatibility. Producer regex strings and references remain inert at registration; structurally admitted metadata does not certify regex compilation or instance execution. Any execution owner must separately declare deterministic executable-schema semantics and refuse unsupported or invalid schemas before claiming validated outputs.", "before": "Retained bytes are not a registration. The producer interface that owns the operation owns its output schema, so the schema is registered exactly when the Plan-selected producer closure carries it at the tree path for that operation; a new operation is registered by shipping its interface document in the admitted closure, never by a host or platform table.", "parent": {"bytes": 196987, "path": "docs/coop/design-corrections/foundation/identity-schemas.v3.json", "sha256": "a76c9e2f07e8f8e52ee611f157548f6a09061866308652e3a0f7e3c24893db21"}, "selector": {"jsonPointer": "/$defs/stage-spec/properties/outputSchemaDigest/x-opensip-digest/registeredBy/law"}}, {"after": "Retained bytes are not a registration. The producer interface that owns the operation owns its output schema, so the schema is registered exactly when the Plan-selected producer closure carries it at the tree path for that operation; a new operation is registered by shipping its interface document in the admitted closure, never by a host or platform table. Document validation uses the stage-meta-reference-selection-v1 structural profile: the eight pinned Draft2020-12 default meta-schema resources with format annotations not asserted. Fixed meta-schema pattern assertions retain their published trailing-LF compatibility. Producer regex strings and references remain inert at registration; structurally admitted metadata does not certify regex compilation or instance execution. Any execution owner must separately declare deterministic executable-schema semantics and refuse unsupported or invalid schemas before claiming validated outputs.", "before": "Retained bytes are not a registration. The producer interface that owns the operation owns its output schema, so the schema is registered exactly when the Plan-selected producer closure carries it at the tree path for that operation; a new operation is registered by shipping its interface document in the admitted closure, never by a host or platform table.", "parent": {"bytes": 197480, "path": "docs/implementation/m1/source-selection-v2/schemas/sources/identity.v3.schema.json", "sha256": "311c1feb09ff8cd0b207233d2ec0d7440bb1c72fc0470de277ee1891c24bb68f"}, "selector": {"jsonPointer": "/$defs/stage-spec/properties/outputSchemaDigest/x-opensip-digest/registeredBy/law"}}, {"after": "spec's own `operation` and `outputDomains`. The stage-meta-reference-selection-v1 profile validates against eight pinned Draft2020-12 default meta-schema resources with format annotations not asserted, preserving the two fixed meta-schema pattern assertions (including their trailing-LF compatibility). Registration does not compile producer regex strings or execute schema instances: invalid regex strings can be structurally registered, and an execution owner must separately select deterministic executable-schema semantics and fail closed before claiming validated outputs. This explicit successor changes the former ambient regex-format assertion; optional packages cannot change registration. Each failure refuses by its own name:", "before": "spec's own `operation` and `outputDomains`. Each failure refuses by its own name:", "parent": {"bytes": 135448, "path": "docs/v2/contracts/product-v1/identity-and-evidence.md", "sha256": "c82404f3a0cf56fa6cc02e99cc3ebbd5356fedc3b36aeb38f9ef284077fbd31f"}, "selector": {"line": 1314}}], "selected": "docs/implementation/m2/stage-meta-reference-selection-v1/successor.json", "sha256": "129bceca5f8e27cf3e14377453f8688b4169dd7b65aef1519f2bbdffc6880cb5"}, {"inputs": [{"bytes": 1010, "path": "docs/implementation/m2/native-runtime-selection-v13/README.md", "sha256": "0c0519a10979c4f8ca98edb8b28237aae65fe26331dce66d61870152f5b4cfa5"}, {"bytes": 179, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/archive-pin.json", "sha256": "24bcf0b88e5698293c07ebec5d54649d2a1f26b0c2896dcce46c2c39d7680b42"}, {"bytes": 40045, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/baseline.json", "sha256": "f6a1e4e7f2431b81ed04850cfc4c4ecd89b31c13bd6221ac2a838f331722722e"}, {"bytes": 0, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/contracts-dependencies.stderr", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}, {"bytes": 624, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/contracts-dependencies.stdout", "sha256": "909a2e9cbcfd59b8aa4ff349f617a6fccd44ff560eaf85262d04a6bf86383b1e"}, {"bytes": 0, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/design.stderr", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}, {"bytes": 291784, "path": "docs/implementation/m2/native-runtime-selection-v13/evidence/design.s