{
  "bodyLanguages": [
    "typescript",
    "javascript",
    "rust"
  ],
  "bundledGrammars": {
    ".cjs": "javascript",
    ".cts": "typescript",
    ".js": "javascript",
    ".json": "json",
    ".jsx": "javascript",
    ".md": "markdown",
    ".mjs": "javascript",
    ".mts": "typescript",
    ".rs": "rust",
    ".toml": "toml",
    ".ts": "typescript",
    ".tsx": "typescript",
    ".yaml": "yaml",
    ".yml": "yaml"
  },
  "grammarCapabilities": {
    "javascript": {
      "capabilities": [
        "declares@syntactic",
        "literal@syntactic",
        "control-flow@syntactic",
        "clones@normalized-body-hash",
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".cjs",
        ".js",
        ".jsx",
        ".mjs"
      ],
      "syntaxClass": "code"
    },
    "json": {
      "capabilities": [
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".json"
      ],
      "syntaxClass": "data-document"
    },
    "markdown": {
      "capabilities": [
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".md"
      ],
      "syntaxClass": "data-document"
    },
    "rust": {
      "capabilities": [
        "declares@syntactic",
        "literal@syntactic",
        "control-flow@syntactic",
        "clones@normalized-body-hash",
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".rs"
      ],
      "syntaxClass": "code"
    },
    "toml": {
      "capabilities": [
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".toml"
      ],
      "syntaxClass": "data-document"
    },
    "typescript": {
      "capabilities": [
        "declares@syntactic",
        "literal@syntactic",
        "control-flow@syntactic",
        "clones@normalized-body-hash",
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".cts",
        ".mts",
        ".ts",
        ".tsx"
      ],
      "syntaxClass": "code"
    },
    "yaml": {
      "capabilities": [
        "file@enumerated",
        "package@manifest-declared",
        "vcs-change@vcs-reported"
      ],
      "suffixes": [
        ".yaml",
        ".yml"
      ],
      "syntaxClass": "data-document"
    }
  }
}
