{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:proposed:project-registry-v1",
  "title": "Proposed371 private ProjectId registry, NOT accepted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "$defs": {
    "NativeProjectRootV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "canonicalPathBytesHex",
        "deviceId",
        "inodeId",
        "birthSeconds",
        "birthNanoseconds"
      ],
      "properties": {
        "platform": {
          "enum": [
            "macos",
            "linux"
          ]
        },
        "canonicalPathBytesHex": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8192,
          "pattern": "^(?:[0-9a-f]{2})+(?![\\s\\S])"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "inodeId": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "birthSeconds": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "birthNanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "namespaceId",
        "root",
        "status",
        "allocationKind"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^prj1-[0-9a-f]{64}(?![\\s\\S])"
        },
        "namespaceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "root": {
          "$ref": "#/$defs/NativeProjectRootV1"
        },
        "status": {
          "enum": [
            "RESERVED",
            "ACTIVE",
            "RETIRED",
            "ABANDONED"
          ]
        },
        "allocationKind": {
          "enum": [
            "random",
            "adopt"
          ]
        }
      }
    }
  },
  "$comment": "Schema is necessary but insufficient: exact lexical/canonical/4MiB byte profile, native-path grammar, decimal-u64 range, sorted globally unique N, live ProjectId/root/locator uniqueness, delta and native authorization/custody are separate mandatory rules. No schema result grants authority."
}
