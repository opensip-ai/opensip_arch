+            let (outcome, stopped) = seal_under_append_lock(
+                txn,
+                &fixtures::replay(),
+                OperatorAdapter {
+                    token,
+                    after_admission: true,
+                    committed,
+                },
+            );
+            assert!(stopped.admitted_at_close());
+            match outcome {
+                SealOutcome::Committed {
+                    latched_after_admission,
+                    committed: receipt,
+                    ..
