+                    assert!(committed && latched_after_admission);
+                    assert_eq!(receipt, "operator-test-receipt");
+                }
+                SealOutcome::CommitUndetermined { .. } => assert!(!committed),
+                SealOutcome::Refused(_) => panic!("post-admission outcome was relabelled"),
