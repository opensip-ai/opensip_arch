{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:proposed:platform-profile-set-v2",
  "$comment": "PlatformProfileSetV2 (law 458b). Derived by make_schema.py from the pinned security-lifecycle.schemas.v1.json PlatformProfileSetV1 (sha256 f66d2c617084825e3cdb9a855a151c10aa66625968b40ef91fc6bb3be39423f4). Identical to V1 except profileSetSchema const 2 and the optional macOS measured-row member installAclOmission const \"no-acl-stored\". Digest domain unchanged: opensip.metadata.platform-profile-set.1. Reader opt-in only; V1 readers keep refusing it. Values in fixtures are SYNTHETIC. No schema result qualifies a boot identity.",
  "title": "metadata: signed release profile population keyed by the ONE machine platform vocabulary (linux-aarch64-gnu, linux-x86_64-gnu, macos-aarch64, macos-x86_64; the same ids as RepoExecutionGrantV2.platformId, the native matrix platformFamilies and the workflow test-execution schema); display aliases (macos-arm64, linux-x86_64, linux-arm64) never key it; per platform: measured lanes + supported baseline; values in fixtures are SYNTHETIC",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileSetSchema",
    "standing",
    "platforms"
  ],
  "properties": {
    "profileSetSchema": {
      "const": 2
    },
    "standing": {
      "type": "string"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "macos-aarch64": {
          "$ref": "#/$defs/macos"
        },
        "macos-x86_64": {
          "$ref": "#/$defs/macos"
        },
        "linux-x86_64-gnu": {
          "$ref": "#/$defs/linux"
        },
        "linux-aarch64-gnu": {
          "$ref": "#/$defs/linux"
        }
      }
    }
  },
  "$defs": {
    "macos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installRootFilesystems",
        "projectRootFilesystems",
        "supportedMajors",
        "measuredProfiles"
      ],
      "properties": {
        "installRootFilesystems": {
          "type": "array",
          "items": {
            "const": "apfs"
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "projectRootFilesystems": {
          "type": "array",
          "items": {
            "const": "apfs"
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "supportedMajors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minBuild",
              "marketing"
            ],
            "properties": {
              "minBuild": {
                "type": "string",
                "pattern": "^[0-9]{2}[A-Z][0-9]{1,5}[a-z]?(?![\\s\\S])"
              },
              "marketing": {
                "type": "string"
              }
            }
          }
        },
        "measuredProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "build",
              "kernUuid",
              "dyldCdhash",
              "lane"
            ],
            "properties": {
              "build": {
                "type": "string",
                "pattern": "^[0-9]{2}[A-Z][0-9]{1,5}[a-z]?(?![\\s\\S])"
              },
              "kernUuid": {
                "type": "string",
                "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}(?![\\s\\S])"
              },
              "dyldCdhash": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
              },
              "lane": {
                "enum": [
                  "macos-15",
                  "macos-15-intel"
                ]
              },
              "installAclOmission": {
                "const": "no-acl-stored"
              }
            }
          },
          "x-opensip-order": "sequence"
        }
      }
    },
    "linux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distro",
        "series",
        "installRootFilesystems",
        "projectRootFilesystems",
        "archiveSigningKeyDigest",
        "bootAttestation",
        "supportedKernelLines",
        "baselineFlavors",
        "measuredProfiles"
      ],
      "properties": {
        "distro": {
          "const": "ubuntu"
        },
        "series": {
          "type": "array",
          "items": {
            "const": "24.04"
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "installRootFilesystems": {
          "type": "array",
          "items": {
            "enum": [
              "ext4",
              "xfs",
              "btrfs"
            ]
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "projectRootFilesystems": {
          "type": "array",
          "items": {
            "enum": [
              "ext4",
              "xfs",
              "btrfs"
            ]
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "archiveSigningKeyDigest": {
          "$ref": "#/$defs/Hex64"
        },
        "bootAttestation": {
          "enum": [
            "secure-boot-lockdown",
            "package-db-declared"
          ]
        },
        "supportedKernelLines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "baselineFlavors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?![\\s\\S])"
          },
          "minItems": 1,
          "x-opensip-order": "sequence"
        },
        "measuredProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "flavor",
              "lane"
            ],
            "properties": {
              "line": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
              },
              "flavor": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?![\\s\\S])"
              },
              "lane": {
                "enum": [
                  "ubuntu-24.04",
                  "ubuntu-24.04-arm"
                ]
              }
            }
          },
          "x-opensip-order": "sequence"
        }
      }
    },
    "Hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
