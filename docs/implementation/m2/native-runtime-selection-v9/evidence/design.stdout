9"}, {"bytes": 4160885, "path": "docs/implementation/m2/native-runtime-selection-v8/product/crates/host/tests/fixtures/native-context-fixtures.json", "sha256": "b5eb587462e606131e288bcd645c09218e5ef24b13dc5d49190a988b5e4e1ef8"}], "passageOverrides": [], "selected": "docs/implementation/m2/native-runtime-selection-v8/successor.json", "sha256": "8a67c99f4f608ba8ec6152b4d602a4cf5875769de51dd011fbfe92149505c9d7"}], "generationSources": {"executedGeneratorCode": false, "productQualification": false, "sourcesVerified": 40}, "inputsVerified": 46, "inventoryPassageInheritance": [{"after": "Declare pinned browser report build dependencies: TypeScript6.0.3 and esbuild0.28.2, with native DOM modules and an offline self-contained deliverable.", "before": "Declare report build dependencies and scripts; frontend framework and bundler remain undecided.", "parent": {"bytes": 140780, "path": "docs/implementation/m2/repository-file-inventory.v19.json", "sha256": "ec61d2fbee9e6fdd6000acabe263d2c455f71055b6e8843e5c973351fe9c9725"}, "selector": {"jsonPointer": "/files/13/description"}}, {"after": "Coordinate explicit maintenance scripts without npm workspace hoisting; select npm11.13.0 with independent per-package locks and Node24.16.0.", "before": "Declare TypeScript workspace membership and common script names; package manager and its lockfile remain to be selected.", "parent": {"bytes": 140780, "path": "docs/implementation/m2/repository-file-inventory.v19.json", "sha256": "ec61d2fbee9e6fdd6000acabe263d2c455f71055b6e8843e5c973351fe9c9725"}, "selector": {"jsonPointer": "/files/189/description"}}, {"after": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded metadata covered by the enclosing signed host/release artifact and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "before": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded signed release descriptor and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "parent": {"bytes": 140780, "path": "docs/implementation/m2/repository-file-inventory.v19.json", "sha256": "ec61d2fbee9e6fdd6000acabe263d2c455f71055b6e8843e5c973351fe9c9725"}, "selector": {"jsonPointer": "/files/7/description"}}], "inventorySuccessors": [{"addedFiles": 4, "parent": "docs/v2/architecture/repository-file-inventory.v1.json", "selected": "docs/implementation/m1/repository-file-inventory.v3.json", "sha256": "63027fb69f55b6fd65f3cb5baa89d355736239060bfa2750f3137e93cbb716ee"}, {"addedFiles": 44, "parent": "docs/implementation/m1/repository-file-inventory.v3.json", "selected": "docs/implementation/m1/repository-file-inventory.v4.json", "sha256": "c6c85fb8adfe6cdf50dc7b07b7f1e0816275e3e00eb7307e1acb8c1568fe84f5"}, {"addedFiles": 77, "parent": "docs/implementation/m1/repository-file-inventory.v4.json", "selected": "docs/implementation/m1/repository-file-inventory.v5.json", "sha256": "ec7292f6545e564bae77a8b56ca34ee51af94b70ab3b7484feaecb6df2f22687"}, {"addedFiles": 1, "parent": "docs/implementation/m1/repository-file-inventory.v5.json", "selected": "docs/implementation/m1/repository-file-inventory.v6.json", "sha256": "52e75edc8a30aa304d2f3e42f541a5ece1c00d9e1f21435651ac29776d0b81c1"}, {"addedFiles": 2, "parent": "docs/implementation/m1/repository-file-inventory.v6.json", "selected": "docs/implementation/m1/repository-file-inventory.v7.json", "sha256": "763a5431ebd0aac23dfdd2bb95bacc5ae930dc50763c147a97b93fd8be91e111"}, {"addedFiles": 2, "parent": "docs/implementation/m1/repository-file-inventory.v7.json", "selected": "docs/implementation/m1/repository-file-inventory.v8.json", "sha256": "c4a1242cb1ea15b260927abd4b84