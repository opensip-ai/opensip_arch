@@ -0,0 +1,146 @@
+"""Literal QD-2 table and Q1 controls; no oracle or producer execution."""
+import copy
+import pathlib
+import sys
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import Refusal
+from case_scoring import classify_outcome, compare_cell
+
+
+def score(expected, result, **changes):
+    flags = dict(positive_sound_under_deficiency=False, deficiency_matches=True,
+                 refusal_matches=False, oracle_evidence_complete=True,
+                 coverage_claimed_complete=True)
+    flags.update(changes)
+    return classify_outcome(expected, result, **flags)
+
+
+def atom(value, kind="literal", subject="body"):
+    return {"kind": kind, "subject": subject, "value": value}
+
+
+class CaseScoringTests(unittest.TestCase):
+    def test_literal_positive_table(self):
+        # Tuples: correct, hit, miss, yield loss, defect.
+        expected = {"found": (True, True, False, False, False),
+                    "no-match": (False, False, True, False, False),
+                    "indeterminate": (False, False, True, True, False),
+                    "refused": (False, False, True, False, True),
+                    "error": (False, False, True, False, True)}
+        for kind, row in expected.items():
+            r = score("determinate-positive", kind)
+            self.assertEqual(tuple(r[k] for k in ("correct", "q3Hit", "q3Miss", "yieldLoss", "defect")), row)
+            self.assertFalse(r["q4Failure"])
+            self.assertFalse(r["caseFalsePositive"])
+
+    def test_literal_negative_table(self):
+        # Tuples: correct, false positive, yield loss, defect.
+        expected = {"found": (False, True, False, False),
+                    "no-match": (True, False, False, False),
+                    "indeterminate": (False, False, True, False),
+                    "refused": (False, False, False, True),
+                    "error": (False, False, False, True)}
+        for kind, row in expected.items():
+            r = score("determinate-negative", kind)
+            self.assertEqual(tuple(r[k] for k in ("correct", "caseFalsePositive", "yieldLoss", "defect")), row)
+            self.assertFalse(r["q3Miss"])
+            self.assertFalse(r["q3Hit"])
+
+    def test_sound_positive_under_deficiency(self):
+        for sound in (False, True):
+            r = score("must-abstain", "found", positive_sound_under_deficiency=sound)
+            self.assertEqual((r["correct"], r["caseFalsePositive"]), (sound, not sound))
+            self.assertFalse(r["q4Failure"])
+            self.assertFalse(r["q3Hit"])
+
+    def test_unsupported_negative_always_q4(self):
+        r = score("must-abstain", "no-match", coverage_claimed_complete=False)
+        self.assertTrue(r["q4Failure"])
+        self.assertFalse(r["correct"])
+
+    def test_deficiency_exact_match_required(self):
+        for match in (False, True):
+            r = score("must-abstain", "indeterminate", deficiency_matches=match)
+            self.assertEqual((r["correct"], r["deficiencyMismatch"]), (match, not match))
+            self.assertFalse(r["yieldLoss"])
+
+    def test_only_pinned_typed_refusal_can_be_correct(self):
+        for match in (False, True):
+            r = score("must-abstain", "refused", refusal_matches=match)
+            self.assertEqual((r["correct"], r["defect"]), (match, not match))
+            self.assertFalse(score("must-abstain", "error", refusal_matches=match)["correct"])
+            for kind in ("determinate-positive", "determinate-negative"):
+                self.assertTrue(score(kind, "refused", refusal_matches=match)["defect"])
+
+    def test_false_completeness_retains_positive_miss(self):
+        for kind in ("determinate-positive", "determinate-negative"):
+            r = score(kind, "no-match", oracle_evidence_complete=False)
+            self.assertTrue(r["falseCompletenessClaim"])
+            self.assertTrue(r["q4Failure"])
+            self.assertFalse(r["correct"])
+            self.assertEqual(r["q3Miss"], kind == "determinate-positive")
+
+    def test_false_completeness_is_independent_of_outcome(self):
+        for result in ("found", "no-match", "indeterminate", "refused", "error"):
+            r = score("must-abstain", result, oracle_evidence_complete=False,
+                      positive_sound_under_deficiency=True, refusal_matches=True)
+            self.assertTrue(r["falseCompletenessClaim"])
+            self.assertTrue(r["q4Failure"])
+            self.assertFalse(r["correct"])
+        honest = score("must-abstain", "found", oracle_evidence_complete=False,
+                       coverage_claimed_complete=False, positive_sound_under_deficiency=True)
+        self.assertTrue(honest["correct"])
+        self.assertFalse(honest["q4Failure"])
+
+    def test_no_match_under_unclaimed_incomplete_evidence(self):
+        r = score("determinate-positive", "no-match", oracle_evidence_complete=False,
+                  coverage_claimed_complete=False)
+        self.assertTrue(r["q3Miss"])
+        self.assertFalse(r["falseCompletenessClaim"])
+
+    def test_kinds_and_flags_refuse_aliases(self):
+        with self.assertRaises(Refusal): score("positive", "found")
+        with self.assertRaises(Refusal): score("must-abstain", "missing")
+        for field in ("positive_sound_under_deficiency", "deficiency_matches", "refusal_matches",
+                      "oracle_evidence_complete", "coverage_claimed_complete"):
+            for value in (0, 1, None, "true"):
+                with self.assertRaises(Refusal):
+                    score("must-abstain", "found", **{field: value})
+
+    def test_cell_exact_sets_order_and_immutability(self):
+        expected = [atom(1), atom(2)]
+        before = copy.deepcopy(expected)
+        r = compare_cell(expected, list(reversed(expected)), "success", "success")
+        self.assertEqual(r, {"atomsMatch": True, "exitMatches": True, "matched": True,
+                             "missing": [], "unexpected": []})
+        self.assertEqual(expected, before)
+
+    def test_missing_extra_wrong_atom_coordinates(self):
+        base = atom("value")
+        for coordinate in ("kind", "subject", "value"):
+            wrong = dict(base, **{coordinate: "other"})
+            r = compare_cell([base], [wrong], 0, 0)
+            self.assertEqual(r["missing"], [base])
+            self.assertEqual(r["unexpected"], [wrong])
+            self.assertFalse(r["matched"])
+        self.assertEqual(compare_cell([base], [], 0, 0)["missing"], [base])
+        self.assertEqual(compare_cell([], [base], 0, 0)["unexpected"], [base])
+
+    def test_exit_types_and_empty_atom_sets(self):
+        self.assertTrue(compare_cell([], [], 0, 0)["matched"])
+        self.assertFalse(compare_cell([], [], 0, False)["matched"])
+        self.assertFalse(compare_cell([], [], {"class": "success"}, {"class": "fault"})["matched"])
+
+    def test_duplicate_atoms_and_closed_shapes(self):
+        for a, b in (([atom(1), atom(1)], []), ([], [atom(1), atom(1)]),
+                     ([dict(atom(1), extra=True)], []), ([atom(1, kind="")], [])):
+            with self.assertRaises(Refusal):
+                compare_cell(a, b, 0, 0)
+        with self.assertRaises(Refusal): compare_cell({}, [], 0, 0)
+        with self.assertRaises(Refusal): compare_cell([atom(1.0)], [], 0, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
