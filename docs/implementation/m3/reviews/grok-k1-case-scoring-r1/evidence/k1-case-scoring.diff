+"""Pure Q0 r13 sections 1.2/1.3: case outcomes and T1 exact comparisons.
+
+Callers independently establish the frozen oracle, subject correspondence,
+input completeness and candidate normalization. No case generation, producer
+run, admissibility/identity proof, confidence or qualification occurs here.
+"""
+from canonical import canonical
+from records import require
+
+
+def _label(value):
+    require(type(value) is str and 1 <= len(value) <= 4096, "LABEL_REQUIRED")
+    canonical(value)
+
+
+def classify_outcome(expected, result, *, positive_sound_under_deficiency,
+                     deficiency_matches, refusal_matches,
+                     oracle_evidence_complete, coverage_claimed_complete):
+    """The QD-2 table over separately admitted, case-bound observations.
+
+    expected is one of the three expectedAnswer.kind names. result is found,
+    no-match, indeterminate, refused or error. Booleans are explicit trusted
+    caller conclusions: soundness comes from the frozen oracle, deficiency
+    and typed-refusal matches from exact pre-pinned expectations. A found
+    result already refers to this case's finding through admitted subject /
+    correspondence mapping; this function does not treat arbitrary output as
+    a matched finding. No inference of these premises from Coverage is made.
+    Returned flags are local diagnostics, never ledger/envelope authority.
+    """
+    require(type(expected) is str and expected in {
+        "determinate-positive", "determinate-negative", "must-abstain"}, "EXPECTED_KIND")
+    require(type(result) is str and result in {
+        "found", "no-match", "indeterminate", "refused", "error"}, "RESULT_KIND")
+    flags = (positive_sound_under_deficiency, deficiency_matches, refusal_matches,
+             oracle_evidence_complete, coverage_claimed_complete)
+    require(all(type(v) is bool for v in flags), "EXACT_BOOLEAN_REQUIRED")
+    q3_hit = q3_miss = q4_failure = false_positive = yield_loss = defect = False
+    correct = False
+    deficiency_mismatch = False
+    if expected == "determinate-positive":
+        q3_hit = result == "found"
+        q3_miss = not q3_hit
+        correct = q3_hit
+        yield_loss = result == "indeterminate"
+        defect = result in {"refused", "error"}
+    elif expected == "determinate-negative":
+        false_positive = result == "found"
+        correct = result == "no-match"
+        yield_loss = result == "indeterminate"
+        defect = result in {"refused", "error"}
+    elif result == "found":
+        correct = positive_sound_under_deficiency
+        false_positive = not correct
+    elif result == "no-match":
+        q4_failure = True
+    elif result == "indeterminate":
+        correct = deficiency_matches
+        deficiency_mismatch = not correct
+    elif result == "refused":
+        correct = refusal_matches
+        defect = not correct
+    else:
+        defect = True
+    # Completeness claims are checked independently of the finding outcome.
+    # Even a sound positive cannot excuse a false claim of complete evidence.
+    false_completeness = coverage_claimed_complete and not oracle_evidence_complete
+    q4_failure = q4_failure or false_completeness
+    correct = correct and not q4_failure
+    return {"correct": correct, "q3Hit": q3_hit, "q3Miss": q3_miss,
+            "q4Failure": q4_failure, "caseFalsePositive": false_positive,
+            "yieldLoss": yield_loss, "defect": defect,
+            "deficiencyMismatch": deficiency_mismatch,
+            "falseCompletenessClaim": false_completeness}
+
+
+def compare_cell(expected_atoms, observed_atoms, expected_exit, observed_exit):
+    """Exact CAN atom-set and exit equality after independent normalization.
+
+    Each local atom is exactly {kind, subject, value}, Q0 section 1.4's atom
+    vocabulary. Subject and value are already-normalized CAN values, not
+    provider ids decoded here. Duplicate atoms are invalid, never silently
+    deduplicated. Work/stress bounds and semantic correspondence admission
+    remain separate; a matching comparison alone never qualifies Q1.
+    """
+    canonical({"expected": expected_atoms, "observed": observed_atoms,
+               "expectedExit": expected_exit, "observedExit": observed_exit})
+    sets = []
+    for atoms in (expected_atoms, observed_atoms):
+        require(type(atoms) is list and len(atoms) <= 100000, "ATOM_ARRAY")
+        values = {}
+        for atom in atoms:
+            require(type(atom) is dict and set(atom) == {"kind", "subject", "value"}, "ATOM_SHAPE")
+            _label(atom["kind"])
+            key = canonical(atom)
+            require(key not in values, "DUPLICATE_ATOM")
+            values[key] = atom
+        sets.append(values)
+    expected, observed = sets
+    missing = sorted(expected.keys() - observed.keys())
+    unexpected = sorted(observed.keys() - expected.keys())
+    exit_matches = canonical(expected_exit) == canonical(observed_exit)
+    return {"atomsMatch": not missing and not unexpected, "exitMatches": exit_matches,
+            "matched": not missing and not unexpected and exit_matches,
+            "missing": [expected[k] for k in missing],
+            "unexpected": [observed[k] for k in unexpected]}
diff --git a/Users/sb/code/opensip-ai/opensip-k1-case-scoring/tools/quality/test_case_scoring.py b/Users/sb/code/opensip-ai/opensip-k1-case-scoring/tools/quality/test_case_scoring.py
