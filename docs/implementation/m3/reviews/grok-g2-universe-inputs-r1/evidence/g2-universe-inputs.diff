+//! Declared retained-input joins for Rust universe authoring.
+//! These pure observations do not admit native context or bind a Plan.
+
+use crate::universe_context::{
+    UniverseContextChecks, UniverseContextError, check_declared_universe_context,
+};
+use opensip_identity::{
+    DigestError, FramedCandidate, GraphError, IdentityDomain, JsonInteger, JsonValue,
+    NativeFrameSet, RetainedInputError, RetainedInputs, hash_canonical_value,
+};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Debug)]
+pub enum UniverseInputError {
+    Context(UniverseContextError),
+    Frame(GraphError),
+    Retained(RetainedInputError),
+    Digest(DigestError),
+    Representation,
+    Missing(&'static str),
+    Mismatch(&'static str),
+}
+
+/// The selected optional records must be supplied; unselected records refuse.
+pub struct UniverseInputRequest<'a> {
+    pub universe_digest: [u8; 32],
+    pub context_digest: [u8; 32],
+    pub expected_host_digest: [u8; 32],
+    pub snapshot_id: &'a str,
+    pub prepared_digest: Option<[u8; 32]>,
+    pub ownership_digest: Option<[u8; 32]>,
+}
+
+/// Inert identity/descriptor joins. No compiler or enumerator is qualified.
+#[derive(Debug)]
+pub struct UniverseInputChecks {
+    fields: UniverseContextChecks,
+    snapshot_id: String,
+    has_ownership: bool,
+}
+impl UniverseInputChecks {
+    pub fn field_checks(&self) -> &UniverseContextChecks {
+        &self.fields
+    }
+    pub fn snapshot_id(&self) -> &str {
+        &self.snapshot_id
+    }
+    /// Presence alone grants no body dialect or clone identity, including partial enumeration.
+    pub fn has_ownership(&self) -> bool {
+        self.has_ownership
+    }
+}
+
+/// Compose the mandatory field joins with §2.1 retained-record/snapshot joins.
+///
+/// Required dependency/features frames are resolved by their declared full H.
+/// Selected prepared/ownership inputs must have the exact named digest/domain;
+/// optional absent inputs stay absent, including caller-supplied unselected bytes.
+/// The snapshot2 descriptor is recomputed, not a caller-provided path catalog.
+/// This checks descriptor correspondence, not every snapshot source/blob, nested
+/// package/artifact closure, producer correctness or context admission. Full
+/// bind_rust_universe still needs an admitted context and admitted nested inputs;
+/// success here does not mint one, authorize execution or send NativeContextVerified.
+/// No filesystem/tool/compiler/provider operation is performed.
+pub fn check_declared_universe_inputs(
+    inputs: &RetainedInputs<'_>,
+    request: &UniverseInputRequest<'_>,
+    schema_work: usize,
+) -> Result<UniverseInputChecks, UniverseInputError> {
+    let checks = check_declared_universe_context(
+        inputs,
+        request.universe_digest,
+        request.context_digest,
+        request.expected_host_digest,
+        schema_work,
+    )
+    .map_err(UniverseInputError::Context)?;
+    let universe = inputs
+        .frame_candidate(
+            request.universe_digest,
+            NativeFrameSet::SemanticUniverse,
+            schema_work,
+        )
+        .map_err(UniverseInputError::Frame)?;
+    let context = inputs
+        .frame_candidate(request.context_digest, NativeFrameSet::Context, schema_work)
+        .map_err(UniverseInputError::Frame)?;
+    let u = map(universe.descriptor())?;
+    let c = map(context.descriptor())?;
+    let snapshot = inputs
+        .object(request.snapshot_id, IdentityDomain::Snapshot, schema_work)
+        .map_err(UniverseInputError::Retained)?;
+    let mut inventory = BTreeMap::new();
+    for row in array(field(map(snapshot.descriptor())?, "sourceInventory")?)? {
+        let row = map(row)?;
+        inventory.insert(text(field(row, "path")?)?, row);
+    }
+    let dep = nested(
+        inputs,
+        sha_id(field(u, "dependencySourceSetId")?)?,
+        "native.dependency-source-set.v1",
+        schema_work,
+    )?;
+    if field(map(dep.descriptor())?, "lockfileIdentity")? != field(u, "lockfileIdentity")? {
+        return Err(UniverseInputError::Mismatch("dependency.lockfileIdentity"));
+    }
+    let features = nested(
+        inputs,
+        sha_id(field(u, "unifiedFeaturesId")?)?,
+        "native.unified-features.rust.v1",
+        schema_work,
+    )?;
+    let features = map(features.descriptor())?;
+    for name in ["targetTriple", "resolverVersion"] {
+        if field(features, name)? != field(c, name)? {
+            return Err(UniverseInputError::Mismatch(name));
+        }
+    }
+    let prepared = selected(
+        inputs,
+        field(u, "preparedOutputSetId")?,
+        request.prepared_digest,
+        "native.prepared-output-set.v3",
+        "preparedOutputSet",
+        schema_work,
+    )?;
+    if let Some(prepared) = prepared {
+        let p = map(field(map(prepared.descriptor())?, "preparation")?)?;
+        if field(p, "dependencySourceSetId")? != field(u, "dependencySourceSetId")? {
+            return Err(UniverseInputError::Mismatch(
+                "prepared.dependencySourceSetId",
+            ));
+        }
+        if field(p, "toolchain")? != field(c, "toolchain")? {
+            return Err(UniverseInputError::Mismatch("prepared.toolchain"));
+        }
+        let cfg_id = field(p, "cfgSetId")?;
+        let mut found = false;
+        for row in array(field(u, "cfgSets")?)? {
+            if field(map(row)?, "cfgSetId")? == cfg_id {
+                found = true;
+            }
+        }
+        if !found {
+            return Err(UniverseInputError::Mismatch("prepared.cfgSetId"));
+        }
+        let kind = if text(field(p, "kind")?)? == "imported-descriptor" {
+            "imported-inert"
+        } else {
+            "host-prepared"
+        };
+        if text(field(u, "preparedResolution")?)? != kind {
+            return Err(UniverseInputError::Mismatch("prepared.kind"));
+        }
+    }
+    let ownership = selected(
+        inputs,
+        field(u, "sourceUnitOwnershipId")?,
+        request.ownership_digest,
+        "native.source-unit-ownership.v1",
+        "sourceUnitOwnership",
+        schema_work,
+    )?;
+    if let Some(ownership) = &ownership {
+        let o = map(ownership.descriptor())?;
+        let mut units = BTreeSet::new();
+        for unit in array(field(o, "units")?)? {
+            let unit = map(unit)?;
+            let projection = JsonValue::Object(BTreeMap::from([
+                (
+                    "schemaVersion".into(),
+                    JsonValue::Integer(
+                        JsonInteger::new(1).map_err(|_| UniverseInputError::Representation)?,
+                    ),
+                ),
+                ("markerPath".into(), field(unit, "markerPath")?.clone()),
+                ("targetKind".into(), field(unit, "targetKind")?.clone()),
+                ("targetName".into(), field(unit, "targetName")?.clone()),
+            ]));
+            let derived = hash_canonical_value("native.compilation-unit.v1", &projection)
+                .map_err(UniverseInputError::Digest)?;
+            if sha_id(field(unit, "unitId")?)? != derived {
+                return Err(UniverseInputError::Mismatch("ownership.unitId"));
+            }
+            let id = text(field(unit, "unitId")?)?;
+            if !units.insert(id) {
+                return Err(UniverseInputError::Mismatch("ownership.duplicateUnitId"));
+            }
+            require_path(
+                &inventory,
+                field(unit, "markerPath")?,
+                "ownership.markerPath",
+            )?;
+            if matches!(field(unit, "targetEdition")?, JsonValue::Null)
+                && !map(field(u, "edition")?)?.contains_key(text(field(unit, "crateName")?)?)
+            {
+                return Err(UniverseInputError::Mismatch("ownership.crateName"));
+            }
+        }
+        for id in array(field(o, "selectedUnitIds")?)? {
+            if !units.contains(text(id)?) {
+                return Err(UniverseInputError::Mismatch("ownership.selectedUnitIds"));
+            }
+        }
+        for row in array(field(o, "ownership")?)? {
+            let row = map(row)?;
+            require_path(&inventory, field(row, "path")?, "ownership.path")?;
+            if !units.contains(text(field(row, "unitId")?)?) {
+                return Err(UniverseInputError::Mismatch("ownership.rowUnitId"));
+            }
+        }
+    }
+    let lock = map(field(u, "lockfileIdentity")?)?;
+    let lock_row = inventory
+        .get(text(field(lock, "path")?)?)
+        .ok_or(UniverseInputError::Mismatch("snapshot.lockfilePath"))?;
+    if field(lock_row, "sha256")? != field(lock, "contentSha256")? {
+        return Err(UniverseInputError::Mismatch("snapshot.lockfileDigest"));
+    }
+    for path in array(field(u, "crateRootPaths")?)? {
+        require_path(&inventory, path, "snapshot.crateRoot")?;
+    }
+    for path in array(field(
+        map(field(c, "configProjection")?)?,
+        "replacedSnapshotConfigs",
+    )?)? {
+        require_path(&inventory, path, "snapshot.replacedConfig")?;
+    }
+    Ok(UniverseInputChecks {
+        fields: checks,
+        snapshot_id: snapshot.identifier().to_owned(),
+        has_ownership: ownership.is_some(),
+    })
+}
+fn nested<'a>(
+    inputs: &RetainedInputs<'a>,
+    sha: [u8; 32],
+    domain: &str,
+    work: usize,
+) -> Result<FramedCandidate<'a>, UniverseInputError> {
+    let frame = inputs
+        .frame_candidate(sha, NativeFrameSet::Nested, work)
+        .map_err(UniverseInputError::Frame)?;
+    if frame.domain() != domain {
+        return Err(UniverseInputError::Mismatch("nested.domain"));
+    }
+    Ok(frame)
+}
+fn selected<'a>(
+    inputs: &RetainedInputs<'a>,
+    value: &JsonValue,
+    supplied: Option<[u8; 32]>,
+    domain: &str,
+    name: &'static str,
+    work: usize,
+) -> Result<Option<FramedCandidate<'a>>, UniverseInputError> {
+    if matches!(value, JsonValue::Null) {
+        if supplied.is_some() {
+            return Err(UniverseInputError::Mismatch(name));
+        }
+        return Ok(None);
+    }
+    let sha = supplied.ok_or(UniverseInputError::Missing(name))?;
+    if sha != sha_id(value)? {
+        return Err(UniverseInputError::Mismatch(name));
+    }
+    Ok(Some(nested(inputs, sha, domain, work)?))
+}
+fn require_path(
+    inventory: &BTreeMap<&str, &BTreeMap<String, JsonValue>>,
+    value: &JsonValue,
+    name: &'static str,
+) -> Result<(), UniverseInputError> {
+    if !inventory.contains_key(text(value)?) {
+        return Err(UniverseInputError::Mismatch(name));
+    }
+    Ok(())
+}
+fn map(value: &JsonValue) -> Result<&BTreeMap<String, JsonValue>, UniverseInputError> {
+    match value {
+        JsonValue::Object(v) => Ok(v),
+        _ => Err(UniverseInputError::Representation),
+    }
+}
+fn field<'a>(
+    value: &'a BTreeMap<String, JsonValue>,
+    key: &str,
+) -> Result<&'a JsonValue, UniverseInputError> {
+    value.get(key).ok_or(UniverseInputError::Representation)
+}
+fn text(value: &JsonValue) -> Result<&str, UniverseInputError> {
+    match value {
+        JsonValue::String(v) => Ok(v),
+        _ => Err(UniverseInputError::Representation),
+    }
+}
+fn array(value: &JsonValue) -> Result<&[JsonValue], UniverseInputError> {
+    match value {
+        JsonValue::Array(v) => Ok(v),
+        _ => Err(UniverseInputError::Representation),
+    }
+}
+fn sha_id(value: &JsonValue) -> Result<[u8; 32], UniverseInputError> {
+    let text = text(value)?
+        .strip_prefix("sha256:")
+        .ok_or(UniverseInputError::Representation)?;
+    if text.len() != 64 {
+        return Err(UniverseInputError::Representation);
+    }
+    let mut result = [0; 32];
+    for (i, pair) in text.as_bytes().chunks_exact(2).enumerate() {
+        let digit = |b| match b {
+            b'0'..=b'9' => Ok(b - b'0'),
+            b'a'..=b'f' => Ok(b - b'a' + 10),
+            _ => Err(UniverseInputError::Representation),
+        };
+        result[i] = digit(pair[0])? << 4 | digit(pair[1])?;
+    }
+    Ok(result)
+}
+
