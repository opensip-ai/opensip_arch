+fn id_text(sha: [u8; 32]) -> JsonValue {
+    text(&format!("sha256:{}", digest_hex(&sha)))
+}
+fn row(path: &str, bytes: &[u8]) -> JsonValue {
+    object([
+        ("path", text(path)),
+        ("sha256", hash_text(bytes)),
+        ("bytes", number(bytes.len())),
+    ])
+}
