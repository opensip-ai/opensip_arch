+    let tracking = writer
+        .observe_project_tracking_with(&root, &inputs())
+        .unwrap();
+    let registered = writer
+        .register_first_use_with(root, tracking, &inputs(), &Registration::live())
+        .unwrap();
+    let clock = scripted::Clock::new();
+    let operation = writer
