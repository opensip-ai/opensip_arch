+    def test_streaming_digest_matches_independent_large_array(self):
+        rows = [(f"file-{n:06d}", "100644", "blob", PIN) for n in range(50000)]
+        expected = hashlib.sha256(json.dumps([[p, m, h] for p, m, _, h in rows], ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+        self.assertEqual(tree_digests(reversed(rows))["treeDigest"], expected)
