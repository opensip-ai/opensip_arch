+"""Offline corpus verification and pinned workspace overlays (Q0 section 10).
+
+This module has no subprocess or network path. Acquisition lives in fetch.py.
+"""
+import hashlib
+import os
+import posixpath
+import shutil
+import stat
+import unicodedata
+from pathlib import Path
+
+from canonical import Refusal, canonical, digest, pin
+from records import require
+
+
+def logical_path(path):
+    require(type(path) is str and path and not path.startswith("/")
+            and all(p not in ("", ".", "..") for p in path.split("/"))
+            and "\x00" not in path and "\\" not in path, "UNEXPECTED-ENTRY-TYPE")
+    try:
+        path.encode("utf-8", "strict")
+    except UnicodeError as exc:
+        raise Refusal("NON-UTF8-PATH") from exc
+    return path
+
+
+def check_paths(paths):
+    """Check files and directory prefixes, without conflating repeated prefixes."""
+    names, leaves = {}, set()
+    for path in paths:
+        logical_path(path)
+        require(path not in leaves, "UNEXPECTED-ENTRY-TYPE")
+        leaves.add(path)
+        parts = path.split("/")
+        for n in range(1, len(parts) + 1):
+            prefix = "/".join(parts[:n])
+            folded = unicodedata.normalize("NFC", prefix).casefold()
+            require(folded not in names or names[folded] == prefix, "CASEFOLD-COLLISION")
+            names[folded] = prefix
+    for path in leaves:
+        parts = path.split("/")
+        require(not any("/".join(parts[:n]) in leaves for n in range(1, len(parts))), "UNEXPECTED-ENTRY-TYPE")
+
+
+def check_link(path, target):
+    require(type(target) is str and target and "\x00" not in target
+            and "\\" not in target and not target.startswith("/"), "ESCAPING-SYMLINK")
+    resolved = posixpath.normpath(posixpath.join(posixpath.dirname(path), target))
+    require(resolved != ".." and not resolved.startswith("../"), "ESCAPING-SYMLINK")
+
+
+def tree_digests(rows):
+    """Stream the exact QD-22 array preimage, including preimages over 4 MiB.
+
+    rows are (path, git mode, type, sha256(blob) or gitlink commit).
+    Each array element uses CAN; the complete preimage is not a record.
+    """
+    rows = sorted(rows, key=lambda r: r[0].encode("utf-8"))
+    check_paths([r[0] for r in rows])
+    tree, content = hashlib.sha256(), hashlib.sha256()
+    tree.update(b"[")
+    first = True
+    for path, mode, kind, value in rows:
+        require((kind == "blob" and mode in ("100644", "100755", "120000") and pin(value))
+                or (kind == "commit" and mode == "160000" and type(value) is str
+                    and len(value) == 40 and all(c in "0123456789abcdef" for c in value)), "UNEXPECTED-ENTRY-TYPE")
+        content.update((mode + " " + kind + " " + value + " " + path).encode("utf-8") + b"\x00")
+        if kind == "blob":
+            if not first:
+                tree.update(b",")
+            tree.update(canonical([path, mode, value]))
+            first = False
+    tree.update(b"]")
+    return {"treeDigest": tree.hexdigest(), "contentDigest": content.hexdigest()}
+
+
+def gitlinks(entry):
+    policy = entry["submodulePolicy"]
+    require(policy["policy"] in ("none", "exclude-pinned"), "UNDECLARED-GITLINK")
+    links = policy["gitlinks"]
+    result = {}
+    for item in links:
+        path = logical_path(item["path"])
+        require(path not in result, "UNDECLARED-GITLINK")
+        result[path] = item["commit"]
+    require(policy["policy"] != "none" or not result, "UNDECLARED-GITLINK")
+    return result
+
+
+def scan_tree(root, entry):
+    """Do not follow symlinks. Hash files through checked, no-follow fds."""
+    root = Path(root)
+    require(root.is_dir() and not root.is_symlink(), "STORE-VERIFY-MISMATCH")
+    links, rows, directories = gitlinks(entry), [], set()
+    stack = [(root, "")]
+    while stack:
+        directory, prefix = stack.pop()
+        require(stat.S_IMODE(directory.stat().st_mode) == 0o555, "STORE-VERIFY-MISMATCH")
+        for child in directory.iterdir():
+            path = prefix + child.name
+            logical_path(path)
+            st = child.lstat()
+            if stat.S_ISLNK(st.st_mode):
+                target = os.readlink(child)
+                check_link(path, target)
+                try:
+                    require(child.resolve().is_relative_to(root.resolve()), "ESCAPING-SYMLINK")
+                except (RuntimeError, OSError) as exc:
+                    raise Refusal("ESCAPING-SYMLINK") from exc
+                rows.append((path, "120000", "blob", hashlib.sha256(target.encode("utf-8")).hexdigest()))
+            elif stat.S_ISDIR(st.st_mode):
+                directories.add(path)
+                if path in links:
+                    require(not any(child.iterdir()) and stat.S_IMODE(st.st_mode) == 0o555, "UNDECLARED-GITLINK")
+                    rows.append((path, "160000", "commit", links[path]))
+                else:
+                    stack.append((child, path + "/"))
+            elif stat.S_ISREG(st.st_mode):
+                mode = stat.S_IMODE(st.st_mode)
+                require(mode in (0o444, 0o555), "STORE-VERIFY-MISMATCH")
+                h = hashlib.sha256()
+                fd = os.open(child, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+                with os.fdopen(fd, "rb") as file:
+                    opened = os.fstat(file.fileno())
+                    require((st.st_dev, st.st_ino) == (opened.st_dev, opened.st_ino), "STORE-VERIFY-MISMATCH")
+                    for block in iter(lambda: file.read(1024 * 1024), b""):
+                        h.update(block)
+                    final = os.fstat(file.fileno())
+                    require((opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns) ==
+                            (final.st_size, final.st_mtime_ns, final.st_ctime_ns), "STORE-VERIFY-MISMATCH")
+                rows.append((path, "100755" if mode == 0o555 else "100644", "blob", h.hexdigest()))
+            else:
+                raise Refusal("UNEXPECTED-ENTRY-TYPE")
+    require(set(links) <= directories, "UNDECLARED-GITLINK")
+    # Extra empty directories are not present in git trees and must not be ignored.
+    prefixes = {"/".join(r[0].split("/")[:i]) for r in rows for i in range(1, len(r[0].split("/")))}
+    require(directories == prefixes | set(links), "STORE-VERIFY-MISMATCH")
+    return tree_digests(rows)
+
+
+def verify(root, entry):
+    result = scan_tree(root, entry)
+    require(result["treeDigest"] == entry["treeDigest"]["value"]
+            and result["contentDigest"] == entry["contentDigest"]["value"], "STORE-VERIFY-MISMATCH")
+    return result
+
+
+def remove_partial(path):
+    """Remove only the caller's own staging tree, without following its links."""
+    path = Path(path)
+    if path.exists():
+        for directory, _, _ in os.walk(path, followlinks=False):
+            os.chmod(directory, 0o700)
+        shutil.rmtree(path)
+
+
+def workspace(root, store, definition, entries):
+    """Reverify members, preserve the exact overlay, render only defined Cargo links."""
+    root, store = Path(root), Path(store).resolve()
+    logical_path(definition["id"])
+    require("/" not in definition["id"], "WORKSPACE-ID")
+    overlay = definition["overlay"]
+    require(digest(overlay) == definition["overlayDigest"], "OVERLAY-DIGEST-MISMATCH")
+    members = definition["memberIds"]
+    require(len(set(members)) == len(members) and set(members) <= entries.keys(), "WORKSPACE-MEMBERS")
+    require(overlay["workspace"] == definition["id"]
+            and {m["entry"] for m in overlay["members"]} == set(members)
+            and len(overlay["members"]) == len(members), "WORKSPACE-MEMBERS")
+    for member in overlay["members"]:
+        id_ = member["entry"]
+        require(member["mount"] == id_ and "/" not in logical_path(id_)
+                and member["treeDigest"] == entries[id_]["treeDigest"]["value"], "WORKSPACE-MEMBERS")
+        verify(store / member["treeDigest"], entries[id_])
+    destination = root / definition["id"]
+    require(not destination.exists() and not destination.is_symlink(), "WORKSPACE-EXISTS")
+    root.mkdir(parents=True, exist_ok=True)
+    import tempfile
+    stage = Path(tempfile.mkdtemp(prefix=definition["id"] + ".", dir=root))
+    try:
+        for member in overlay["members"]:
+            (stage / member["mount"]).symlink_to(store / member["treeDigest"], target_is_directory=True)
+        (stage / "workspace-overlay.json").write_bytes(canonical(overlay))
+        cargo = overlay["links"].get("cargo", {})
+        if cargo:
+            lines = ["[patch.crates-io]"]
+            for name, target in sorted(cargo.items()):
+                logical_path(target)
+                require(target.split("/")[0] in members, "WORKSPACE-LINK")
+                # JSON string quoting is also valid for TOML basic strings here.
+                lines.append(canonical(name).decode() + " = { path = " + canonical(target).decode() + " }")
+            (stage / ".cargo").mkdir()
+            (stage / ".cargo/config.toml").write_text("\n".join(lines) + "\n")
+        for directory, _, files in os.walk(stage, followlinks=False):
+            for filename in files:
+                child = Path(directory) / filename
+                if not child.is_symlink():
+                    child.chmod(0o444)
+            Path(directory).chmod(0o555)
+        stage.rename(destination)
+    finally:
+        remove_partial(stage)
+    return {"workspace": definition["id"], "overlayDigest": definition["overlayDigest"],
+            "renderings": ["cargo"] if cargo else [],
+            "undefinedRenderings": sorted(set(overlay["links"]) - {"cargo"})}
