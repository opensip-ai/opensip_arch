+    def test_path_and_symlink_refusals(self):
+        for paths in (["a", "A"], ["dir/a", "DIR/b"], ["é/a", "é/b"], ["a", "a/b"]):
+            with self.assertRaises(Refusal):
+                check_paths(paths)
+        for target in ("/etc/passwd", "../outside", "a/../../outside"):
+            with self.assertRaises(Refusal):
+                check_link("link", target)
+        check_link("dir/link", "../inside")
