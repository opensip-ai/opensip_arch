+    def test_gitlinks_are_pinned_empty_directories(self):
+        commit = self.entry["commit"]
+        self.run_git("update-index", "--add", "--cacheinfo", "160000," + commit + ",module")
+        self.run_git("-c", "user.name=sfbreen", "-c", "user.email=sfbreen@hotmail.com", "commit", "-m", "Synthetic excluded gitlink")
+        entry = copy.deepcopy(self.entry)
+        entry["commit"] = self.run_git("rev-parse", "HEAD").decode().strip()
+        entry["gitTree"] = self.run_git("rev-parse", "HEAD^{tree}").decode().strip()
+        rows = []
+        for raw in self.run_git("ls-tree", "-r", "-z", "HEAD").split(b"\0"):
+            if raw:
+                info, path = raw.split(b"\t")
+                mode, kind, oid = info.decode().split()
+                rows.append((path.decode(), mode, kind, oid if kind == "commit" else sha256(self.run_git("cat-file", "blob", oid))))
+        pins = tree_digests(rows)
+        entry["treeDigest"]["value"] = pins["treeDigest"]
+        entry["contentDigest"]["value"] = pins["contentDigest"]
+        with self.assertRaisesRegex(Refusal, "UNDECLARED-GITLINK"):
+            self.fetch(entry)
+        entry["submodulePolicy"] = {"policy": "exclude-pinned", "gitlinks": [{"path": "module", "commit": commit}]}
+        self.fetch(entry)
+        module = self.store / pins["treeDigest"] / "module"
+        self.assertTrue(module.is_dir())
+        self.assertEqual(list(module.iterdir()), [])
