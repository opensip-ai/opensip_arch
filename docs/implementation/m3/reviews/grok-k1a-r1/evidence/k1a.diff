+    def test_lfs_pointer_bytes_remain_raw(self):
+        pointer = b"version https://git-lfs.github.com/spec/v1\noid sha256:" + b"f" * 64 + b"\nsize 999999\n"
+        # A pointer contributes exactly its raw bytes to QD-22; no LFS object.
+        rows = [("large.bin", "100644", "blob", sha256(pointer))]
+        expected = digest([["large.bin", "100644", sha256(pointer)]])
+        self.assertEqual(tree_digests(rows)["treeDigest"], expected)
