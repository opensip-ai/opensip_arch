+++ b/Users/sb/code/opensip-ai/opensip-k1a/tools/quality/fetch.py
@@ -0,0 +1,170 @@
+"""Explicit acquisition step. No run or verification path imports this module."""
+import datetime
+import hashlib
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from canonical import Refusal, canonical, pin
+from records import require
+from store import check_link, check_paths, gitlinks, logical_path, remove_partial, tree_digests, verify
+
+
+def git_environment(scratch):
+    # The session's owner forbids changing HOME. All Git configuration, hooks,
+    # credentials and optional checkout/filter mechanisms are disabled explicitly.
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null",
+               GIT_TERMINAL_PROMPT="0", GIT_LFS_SKIP_SMUDGE="1",
+               XDG_CONFIG_HOME=str(scratch), GIT_ALLOW_PROTOCOL="https:file")
+    return env
+
+
+def command(*args):
+    return ["git", "-c", "core.hooksPath=/dev/null", "-c", "credential.helper=",
+            "-c", "protocol.ext.allow=never", "-c", "init.templateDir=", *args]
+
+
+def git(bare, env, *args):
+    process = subprocess.run(command("--git-dir=" + str(bare), *args), env=env,
+                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+    if process.returncode:
+        # Do not disclose content or held-out paths via Git's stderr.
+        raise Refusal("NETWORK-FAILURE")
+    return process.stdout
+
+
+def entry_pin(entry):
+    for name in ("commit", "gitTree"):
+        require(type(entry.get(name)) is str and len(entry[name]) == 40
+                and all(c in "0123456789abcdef" for c in entry[name]), "MANIFEST-UNREADABLE")
+    require(pin(entry["treeDigest"]["value"]) and pin(entry["contentDigest"]["value"]), "MANIFEST-UNREADABLE")
+    require(entry["treeDigest"]["algorithm"] == "opensip-qd22-tree-sha256/1"
+            and entry["contentDigest"]["algorithm"] == "opensip-t2-content-sha256/1-draft", "MANIFEST-UNREADABLE")
+    require(entry["lfsPolicy"]["policy"] in ("none", "pointers-only"), "MANIFEST-UNREADABLE")
+    gitlinks(entry)
+
+
+def acquire(entry, manifest_digest, store, temp_root, *, local=False):
+    """Fetch one pin, verify both hashes, publish read-only, retain no failed path.
+
+    local=True admits file:// URLs for T3/local synthetic tests. The default
+    acquisition only admits HTTPS GitHub repository URLs from T2's manifest.
+    """
+    entry_pin(entry)
+    require(pin(manifest_digest), "MANIFEST-UNREADABLE")
+    url = urlsplit(entry["url"])
+    require(not url.username and not url.password and not url.query and not url.fragment
+            and ((url.scheme == "https" and url.netloc == "github.com" and url.path.startswith("/"))
+                 or (local and url.scheme == "file" and not url.netloc)), "MANIFEST-UNREADABLE")
+    store = Path(store)
+    store.mkdir(parents=True, exist_ok=True)
+    key = entry["treeDigest"]["value"]
+    destination = store / key
+    if destination.exists() or destination.is_symlink():
+        return dict(verify(destination, entry), entry=entry["id"], reused=True)
+    stage = Path(tempfile.mkdtemp(prefix=key + ".partial.", dir=store))
+    published, receipt_owned = False, False
+    receipt_path = store / (key + ".admission.json")
+    try:
+        with tempfile.TemporaryDirectory(prefix="opensip-corpus-", dir=temp_root) as work:
+            work = Path(work)
+            work.chmod(0o700)
+            bare = work / "objects"
+            env = git_environment(work)
+            result = subprocess.run(command("init", "--bare", str(bare)), env=env,
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+            require(result.returncode == 0, "NETWORK-FAILURE")
+            git(bare, env, "fetch", "--depth", "1", "--no-tags", "--", entry["url"], entry["commit"])
+            require(git(bare, env, "rev-parse", "FETCH_HEAD").decode().strip() == entry["commit"], "FETCH-COMMIT-MISMATCH")
+            require(git(bare, env, "rev-parse", entry["commit"] + "^{tree}").decode().strip() == entry["gitTree"], "GIT-TREE-MISMATCH")
+            objects = []
+            for row in git(bare, env, "ls-tree", "-r", "-z", "--full-tree", entry["commit"]).split(b"\x00"):
+                if not row:
+                    continue
+                info, path = row.split(b"\t", 1)
+                try:
+                    path = path.decode("utf-8", "strict")
+                except UnicodeError as exc:
+                    raise Refusal("NON-UTF8-PATH") from exc
+                mode, kind, oid = info.decode("ascii").split(" ")
+                require((kind == "blob" and mode in ("100644", "100755", "120000"))
+                        or (kind == "commit" and mode == "160000"), "UNEXPECTED-ENTRY-TYPE")
+                objects.append((logical_path(path), mode, kind, oid))
+            objects.sort(key=lambda r: r[0].encode("utf-8"))
+            check_paths([o[0] for o in objects])
+            require({p: oid for p, _, k, oid in objects if k == "commit"} == gitlinks(entry), "UNDECLARED-GITLINK")
+            rows, symlinks = [], []
+            with subprocess.Popen(command("--git-dir=" + str(bare), "cat-file", "--batch"), env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                  stderr=subprocess.DEVNULL) as batch:
+                try:
+                    for path, mode, kind, oid in objects:
+                        target = stage / path
+                        target.parent.mkdir(parents=True, exist_ok=True)
+                        if kind == "commit":
+                            target.mkdir()
+                            rows.append((path, mode, kind, oid))
+                            continue
+                        batch.stdin.write(oid.encode("ascii") + b"\n")
+                        batch.stdin.flush()
+                        header = batch.stdout.readline().decode("ascii").split()
+                        require(len(header) == 3 and header[0] == oid and header[1] == "blob", "UNEXPECTED-ENTRY-TYPE")
+                        size, h, link_bytes = int(header[2]), hashlib.sha256(), bytearray()
+                        with target.open("xb") as file:
+                            while size:
+                                block = batch.stdout.read(min(size, 1024 * 1024))
+                                require(bool(block), "UNEXPECTED-ENTRY-TYPE")
+                                size -= len(block)
+                                h.update(block)
+                                file.write(block)
+                                if mode == "120000":
+                                    link_bytes.extend(block)
+                        require(batch.stdout.read(1) == b"\n", "UNEXPECTED-ENTRY-TYPE")
+                        if mode == "120000":
+                            try:
+                                link = bytes(link_bytes).decode("utf-8", "strict")
+                            except UnicodeError as exc:
+                                raise Refusal("ESCAPING-SYMLINK") from exc
+                            check_link(path, link)
+                            symlinks.append((target, link))
+                        else:
+                            target.chmod(0o555 if mode == "100755" else 0o444)
+                        rows.append((path, mode, kind, h.hexdigest()))
+                    batch.stdin.close()
+                    require(batch.wait() == 0, "UNEXPECTED-ENTRY-TYPE")
+                except BaseException:
+                    batch.kill()
+                    batch.wait()
+                    raise
+            result = tree_digests(rows)
+            require(result["treeDigest"] == key, "TREE-DIGEST-MISMATCH")
+            require(result["contentDigest"] == entry["contentDigest"]["value"], "CONTENT-DIGEST-MISMATCH")
+            # Create symlinks only after all regular files are materialized.
+            for target, link in symlinks:
+                target.unlink()
+                target.symlink_to(link)
+            for directory, _, _ in os.walk(stage, followlinks=False):
+                Path(directory).chmod(0o555)
+            verify(stage, entry)
+            receipt = {k: entry[k] for k in ("id", "url", "commit", "gitTree", "treeDigest", "contentDigest", "licence", "family", "heldOut")}
+            receipt.update(manifestSha256=manifest_digest,
+                           fetchedAt=datetime.datetime.now(datetime.UTC).isoformat(),
+                           gitVersion=git(bare, env, "--version").decode().strip())
+            # A no-clobber publication: rename refuses an existing nonempty tree.
+            stage.rename(destination)
+            published = True
+            with receipt_path.open("xb") as file:
+                receipt_owned = True
+                file.write(canonical(receipt) + b"\n")
+            receipt_path.chmod(0o444)
+            return dict(result, entry=entry["id"], reused=False)
+    except BaseException:
+        if published:
+            remove_partial(destination)
+        if receipt_owned:
+            receipt_path.unlink()
+        raise
+    finally:
+        remove_partial(stage)
