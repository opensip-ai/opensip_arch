+"""Synthetic K1a controls. No public corpus or private fixture is read."""
+import copy
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from canonical import Refusal, canonical, digest, parse, sha256
+from fetch import acquire, command, git_environment
+from records import (FREEZE_PINS, HARD_COMPONENTS, append_record, carry_comparison,
+                     case_set, freeze, held_out_eligible, read_cases, read_ledger)
+from store import check_link, check_paths, remove_partial, tree_digests, verify, workspace
+
+PIN = "a" * 64
+
+
+def case(id_="case-one"):
+    return {"caseId": id_, "caseKind": "finding", "tier": "T2", "origin": "oracle-fixture",
+            "heldOut": True, "family": "family-one", "inputs": {"repository": "synthetic", "commit": "c" * 40, "treeDigest": PIN},
+            "rule": {"ruleId": "rule-one", "ruleSpecDigest": PIN}, "subject": {"kind": "file", "key": "a.rs", "universe": "synthetic"},
+            "requirement": {"relation": "imports", "rung": "resolved", "universe": "synthetic"},
+            "configuration": {"mode": "source-only"}, "expectedAnswer": {"kind": "determinate-negative"},
+            "provenance": {"author": "synthetic-oracle"}}
+
+
+class Records(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.ledger = Path(self.tmp.name) / "round.jsonl"
+
+    def frozen(self):
+        inputs = {k: canonical([]) for k in FREEZE_PINS}
+        inputs["caseSetDigest"] = case_set([case()])
+        return freeze(self.ledger, inputs)
+
+    def test_case_bytes_sorted_unique_and_pinned(self):
+        raw = case_set([case("z"), case("a")])
+        self.assertEqual([r["caseId"] for r in read_cases(raw)], ["a", "z"])
+        with self.assertRaises(Refusal):
+            case_set([case(), case()])
+        changed = read_cases(raw)[0]
+        changed["expectedAnswer"]["kind"] = "must-abstain"
+        with self.assertRaises(Refusal):
+            case_set([changed])
+
+    def test_case_set_rejects_whitespace_order_missing_pin(self):
+        rows = read_cases(case_set([case("a"), case("z")]))
+        for raw in (b"\n".join(canonical(r) for r in reversed(rows)) + b"\n",
+                    b" " + case_set(rows), case_set(rows).rstrip(b"\n")):
+            with self.assertRaises(Refusal):
+                read_cases(raw)
+        del rows[0]["caseDigest"]
+        with self.assertRaises(Refusal):
+            read_cases(canonical(rows[0]) + b"\n")
+
+    def test_abstain_and_seed_constraints(self):
+        for answer in ({"kind": "determinate-positive"}, {"kind": "must-abstain"}):
+            row = case()
+            row["expectedAnswer"] = answer
+            with self.assertRaises(Refusal):
+                case_set([row])
+        row["expectedAnswer"] = {"kind": "must-abstain", "expectedDeficiency": "missing", "positiveSoundUnderDeficiency": False}
+        read_cases(case_set([row]))
+        row["origin"] = "validated-seed"
+        with self.assertRaises(Refusal):
+            case_set([row])
+
+    def test_foundation_exact_types_and_limits(self):
+        for raw in (b'{"x":1,"x":2}', b"-0", b"1.0", b"NaN", b'"\\ud800"', b"18446744073709551616"):
+            with self.assertRaises(Refusal):
+                parse(raw)
+        for value in (1.0, {1: "x"}, "x" * (4 * 1024 * 1024)):
+            with self.assertRaises(Refusal):
+                canonical(value)
+        value = []
+        for _ in range(32):
+            value = [value]
+        with self.assertRaises(Refusal):
+            canonical(value)
+        self.assertEqual(parse(canonical({"😀": "é", "a": -(2**63)})), {"😀": "é", "a": -(2**63)})
+
+    def test_round_freeze_append_and_history(self):
+        first = self.frozen()
+        second = append_record(self.ledger, {"recordKind": "adjudicator", "voterId": "synthetic", "kind": "human", "designatedExpert": False, "conflictedRules": []})
+        self.assertEqual(second["prevRecordDigest"], first["recordDigest"])
+        old = self.ledger.read_bytes()
+        append_record(self.ledger, {"recordKind": "supersede", "replaces": second["recordDigest"], "why": "synthetic correction"})
+        self.assertTrue(self.ledger.read_bytes().startswith(old))
+        self.assertEqual(len(read_ledger(self.ledger.read_bytes())), 3)
+        with self.assertRaises(Refusal):
+            self.frozen()
+
+    def test_chain_tamper_and_torn_append_refuse(self):
+        self.frozen()
+        raw = self.ledger.read_bytes()
+        for broken in (raw[:-1], raw.replace(PIN[:8].encode(), b"bbbbbbbb", 1), raw + raw):
+            # A replacement need not find PIN in a hash-only freeze.
+            if broken == raw:
+                continue
+            self.ledger.write_bytes(broken)
+            with self.assertRaises(Refusal):
+                append_record(self.ledger, {"recordKind": "item"})
+            self.assertEqual(self.ledger.read_bytes(), broken)
+
+    def test_supersede_requires_prior_reference(self):
+        self.frozen()
+        with self.assertRaises(Refusal):
+            append_record(self.ledger, {"recordKind": "supersede", "replaces": PIN, "why": "not present"})
+
+    def test_exposure_is_permanent_across_freezes_and_supersede(self):
+        self.frozen()
+        self.assertTrue(held_out_eligible(case(), [self.ledger.read_bytes()]))
+        exposed = append_record(self.ledger, {"recordKind": "exposure", "scope": "family", "subject": "family-one", "who": "synthetic", "when": "2026-10-05", "what": "labels"})
+        append_record(self.ledger, {"recordKind": "supersede", "replaces": exposed["recordDigest"], "why": "cannot undo exposure"})
+        history = self.ledger.read_bytes()
+        self.ledger = Path(self.tmp.name) / "round-two.jsonl"
+        self.frozen()
+        self.assertFalse(held_out_eligible(case(), [history, self.ledger.read_bytes()]))
+
+    def test_each_hard_component_and_truth_closure_is_required(self):
+        key = {k: PIN for k in HARD_COMPONENTS + ("truthInputDigest",)}
+        self.assertTrue(carry_comparison(key, key, {}, {})["carried"])
+        for field in key:
+            new = dict(key, **{field: "b" * 64})
+            result = carry_comparison(key, new, {}, {})
+            self.assertFalse(result["carried"])
+            self.assertTrue(result["requeue"])
+        self.assertTrue(carry_comparison(key, key, {"evidenceRefs": []}, {"evidenceRefs": [PIN]})["determinismDefect"])
+
+
+class Store(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.store = self.root / "store"
+        self.repo = self.root / "source"
+        env = git_environment(self.root)
+        def run(*args):
+            p = subprocess.run(command(*args), cwd=self.repo if self.repo.exists() else self.root,
+                               env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
+            return p.stdout
+        self.run_git = run
+        run("init", str(self.repo))
+        (self.repo / "nested").mkdir()
+        (self.repo / "nested/a.txt").write_bytes(b"synthetic bytes\n")
+        (self.repo / "exec.sh").write_bytes(b"#!/bin/sh\nexit 99\n")
+        (self.repo / "exec.sh").chmod(0o755)
+        (self.repo / "link").symlink_to("nested/a.txt")
+        run("add", ".")
+        run("-c", "user.name=sfbreen", "-c", "user.email=sfbreen@hotmail.com", "commit", "-m", "Synthetic corpus fixture")
+        rows = []
+        for raw in run("ls-tree", "-r", "-z", "HEAD").split(b"\0"):
+            if raw:
+                info, path = raw.split(b"\t")
+                mode, kind, oid = info.decode().split()
+                rows.append((path.decode(), mode, kind, sha256(run("cat-file", "blob", oid))))
+        pins = tree_digests(rows)
+        self.entry = {"id": "synthetic", "url": self.repo.as_uri(), "commit": run("rev-parse", "HEAD").decode().strip(),
+                      "gitTree": run("rev-parse", "HEAD^{tree}").decode().strip(),
+                      "treeDigest": {"algorithm": "opensip-qd22-tree-sha256/1", "value": pins["treeDigest"]},
+                      "contentDigest": {"algorithm": "opensip-t2-content-sha256/1-draft", "value": pins["contentDigest"]},
+                      "submodulePolicy": {"policy": "none", "gitlinks": []}, "lfsPolicy": {"policy": "none"},
+                      "licence": {"spdx": "MIT"}, "family": "synthetic", "heldOut": False}
+        self.addCleanup(self.clean_store)
+
+    def clean_store(self):
+        remove_partial(self.store)
+        remove_partial(self.root / "workspaces")
+
+    def fetch(self, entry=None):
+        return acquire(entry or self.entry, PIN, self.store, self.root, local=True)
+
+    def test_local_materialization_readonly_reuse_both_digests(self):
+        self.assertFalse(self.fetch()["reused"])
+        destination = self.store / self.entry["treeDigest"]["value"]
+        self.assertTrue(self.fetch()["reused"])
+        self.assertEqual(os.readlink(destination / "link"), "nested/a.txt")
+        self.assertEqual((destination / "exec.sh").stat().st_mode & 0o777, 0o555)
+        self.assertEqual((destination / "nested/a.txt").stat().st_mode & 0o777, 0o444)
+        verify(destination, self.entry)
+
+    def test_corrupt_store_is_refused_on_reuse(self):
+        self.fetch()
+        file = self.store / self.entry["treeDigest"]["value"] / "nested/a.txt"
+        file.chmod(0o644)
+        file.write_bytes(b"forged")
+        file.chmod(0o444)
+        with self.assertRaisesRegex(Refusal, "STORE-VERIFY-MISMATCH"):
+            self.fetch()
+
+    def test_refused_digest_leaves_no_partial_store(self):
+        entry = copy.deepcopy(self.entry)
