+"""Harness-only corpus acquisition CLI. Runs use store.verify directly."""
+import argparse
+import sys
+from pathlib import Path
+
+# Explicit local imports allow the documented -I -B invocation.
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from canonical import Refusal, canonical, parse, sha256
+from records import require
+from store import verify, workspace
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=("fetch", "verify", "workspace"))
+    parser.add_argument("--manifest", type=Path, required=True)
+    parser.add_argument("--store", type=Path, required=True)
+    parser.add_argument("--temp-root", type=Path)
+    parser.add_argument("--workspaces", type=Path)
+    parser.add_argument("--id", action="append", required=True)
+    parser.add_argument("--local", action="store_true", help="explicit local-only T3/synthetic file:// acquisition")
+    args = parser.parse_args()
+    try:
+        raw = args.manifest.read_bytes()
+        manifest = parse(raw)
+        entries = {r["id"]: r for r in manifest["repositories"]}
+        require(len(entries) == len(manifest["repositories"]), "MANIFEST-UNREADABLE")
+        require(manifest["treeDigestAlgorithm"]["id"] == "opensip-qd22-tree-sha256/1"
+                and manifest["contentDigestAlgorithm"]["id"] == "opensip-t2-content-sha256/1-draft", "MANIFEST-UNREADABLE")
+        definitions = {w["id"]: w for w in manifest["workspaces"]}
+        require(len(definitions) == len(manifest["workspaces"]), "MANIFEST-UNREADABLE")
+    except (Refusal, ValueError, OSError, KeyError, TypeError):
+        print(canonical({"refusal": "MANIFEST-UNREADABLE"}).decode())
+        return 1
+    failed = False
+    for id_ in args.id:
+        try:
+            if args.action == "workspace":
+                require(args.workspaces is not None and id_ in definitions, "MANIFEST-UNREADABLE")
+                result = workspace(args.workspaces, args.store, definitions[id_], entries)
+            else:
+                require(id_ in entries, "MANIFEST-UNREADABLE")
+                entry = entries[id_]
+                if args.action == "fetch":
+                    from fetch import acquire
+                    require(args.temp_root is not None, "MANIFEST-UNREADABLE")
+                    result = acquire(entry, sha256(raw), args.store, args.temp_root, local=args.local)
+                else:
+                    result = dict(verify(args.store / entry["treeDigest"]["value"], entry), entry=id_)
+            print(canonical(result).decode())
+        except (Refusal, ValueError, OSError, KeyError, TypeError) as exc:
+            failed = True
+            # IDs and typed refusals only; no held-out tree paths or contents.
+            code = str(exc) if isinstance(exc, Refusal) else "STORE-VERIFY-MISMATCH"
+            print(canonical({"entry": id_, "refusal": code}).decode())
+    return int(failed)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
