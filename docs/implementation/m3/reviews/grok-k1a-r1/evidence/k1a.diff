+    def test_workspace_overlay_cargo_only(self):
+        self.fetch()
+        overlay = {"workspace": "synthetic-workspace", "members": [{"entry": "synthetic", "mount": "synthetic", "treeDigest": self.entry["treeDigest"]["value"]}], "links": {"cargo": {"synthetic-lib": "synthetic/nested"}, "npm": {"synthetic": "synthetic/nested"}}}
+        definition = {"id": "synthetic-workspace", "memberIds": ["synthetic"], "overlay": overlay, "overlayDigest": digest(overlay)}
+        result = workspace(self.root / "workspaces", self.store, definition, {"synthetic": self.entry})
+        self.assertEqual(result["undefinedRenderings"], ["npm"])
+        dest = self.root / "workspaces/synthetic-workspace"
+        self.assertEqual((dest / "workspace-overlay.json").read_bytes(), canonical(overlay))
+        self.assertIn('"synthetic-lib" = { path = "synthetic/nested" }', (dest / ".cargo/config.toml").read_text())
