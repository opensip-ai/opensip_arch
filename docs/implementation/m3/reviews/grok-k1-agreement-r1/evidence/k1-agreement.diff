+"""Exact Q0 r13 §4.4 agreement arithmetic over admitted ordered vote slots.
+
+Caller excludes calibration, conflicted/excluded voters and establishes the
+closed round's two independent groups and human/registration ordering. These
+local Fraction results are not ledger/envelope fields or review-trigger proof.
+"""
+from fractions import Fraction
+
+from canonical import canonical
+from records import require
+
+LABELS = ('true', 'false', 'unclear')
+
+
+def pair_statistics(pairs):
+    """Unweighted three-category Cohen kappa for post-close (A, B) slots.
+
+    Each input is the local {a, b} pair of final group labels. Slot A is the
+    human or earlier-registered human; slot B the other group. This arithmetic
+    cannot establish registration order, blindness, eligibility or closure.
+    Undefined ratios remain None rather than becoming agreement or disagreement.
+    True prevalence is the fraction of all 2*n admitted slot labels that are
+    true; both marginal true frequencies are retained to make that estimand
+    explicit. Settled-label unclear frequency, minority-class applicability,
+    rubric triggers and >=20-item voter-pair grouping remain caller checks.
+    """
+    require(type(pairs) is list, 'AGREEMENT_PAIR_ARRAY')
+    canonical(pairs)
+    a_counts = dict.fromkeys(LABELS, 0)
+    b_counts = dict.fromkeys(LABELS, 0)
+    matched = 0
+    for row in pairs:
+        require(type(row) is dict and set(row) == {'a', 'b'}, 'AGREEMENT_PAIR_SHAPE')
+        a, b = row['a'], row['b']
+        require(type(a) is str and a in LABELS and type(b) is str and b in LABELS,
+                'AGREEMENT_LABEL')
+        a_counts[a] += 1
+        b_counts[b] += 1
+        matched += a == b
+    n = len(pairs)
+    raw = Fraction(matched, n) if n else None
+    expected = Fraction(sum(a_counts[k] * b_counts[k] for k in LABELS), n*n) if n else None
+    kappa = (raw - expected) / (1 - expected) if n and expected != 1 else None
+    return {'n': n, 'matched': matched, 'aCounts': a_counts, 'bCounts': b_counts,
+            'rawAgreement': raw, 'chanceAgreement': expected, 'kappa': kappa,
+            'truePrevalence': Fraction(a_counts['true'] + b_counts['true'], 2*n) if n else None,
+            'voterAdmissionEstablished': False, 'rubricTriggerEstablished': False,
+            'productQualification': False}
