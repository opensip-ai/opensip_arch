+    # ---- VD2A-RF-01: the review list is compared as canonical JSON, not by Python equality.
+    def rewrite_review(self, text):
+        """Replace the last record's review bytes with text and rejoin its assent and lock pins."""
+        binding = self.fx.lock['contractSuccessors'][-1]
+        raw = text.encode()
+        (self.fx.root / binding['review']['path']).write_bytes(raw)
+        binding['review'] = {'path': binding['review']['path'], 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}
+        assent = json.loads((self.fx.root / binding['assent']['path']).read_bytes())
+        assent['actualClaudeReview'] = binding['review']
+        binding['assent'] = self.fx.write(binding['assent']['path'], assent)
+
+    def test_n20_review_list_is_type_exact(self):
+        # A link on doc.md line 1 whose review lists a value Python equality would coerce.
+        for label, float_in_record, change in (
+                ('a line true for line 1', False, {'selector': {'line': True}}),
+                ('b line 1.0 for line 1', False, {'selector': {'line': 1.0}}),
+                ('c a float record byte count listed for the record\'s integer one', False, 'float'),
+                ('d an integer record byte count listed for the record\'s float one', True, 'int')):
+            with self.subTest(label):
+                self.fresh()
+                root = self.contract([self.doc], [line(self.doc, 1, 'L1', 'L1a')])
+                named = {**root, 'bytes': float(root['bytes'])} if float_in_record else root
+                link = csup(self.doc, {'line': 1}, 'L1a', 'L1b', named)
+                review = copy.deepcopy(link['supersedes'])
+                if change == 'float':
+                    review['record'] = {**root, 'bytes': float(root['bytes'])}
+                elif change == 'int':
+                    review['record'] = root
+                else:
+                    review.update(change)
+                self.contract([self.doc], supersessions=[link], listed=[review])
+                self.refuse('contract review superseded passages differ from the record')
 
