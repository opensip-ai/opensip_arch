+    Fixture: inv0 rows b.py(0) d.py(1); inv1 adds c.py, so d.py is /files/2.
+    c1 introduces doc.md (lines L1, L2, L3) and doc.json; c2, the root,
+    overrides doc.md line 2, L2 to L2a. Test names carry law VD2's control IDs
+    (PROPOSAL-r1.md, "Controls"); N16 to N19, P9 and P10 are VD2-NB-01's.
+    """
+
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        fx = self.fx = Fx(tmp.name)
+        self.base = fx.base({'b.py': 'B0', 'd.py': 'D0'})
+        self.final = fx.hop({'c.py': 'C0'})
+        self.doc = self.text('doc.md', ['L1', 'L2', 'L3'])
+        self.js = fx.write('doc.json', {'text': 'T0', 'other': 'O0'})
+        fx.contract([self.base], members=[self.doc, self.js])
+        self.root = self.contract([self.doc], [line(self.doc, 2, 'L2', 'L2a')])
+
+    verify = BindingHistoryRegressionTests.verify
+    refuse = BindingHistoryRegressionTests.refuse
+
+    def text(self, path, lines):
+        raw = ('\n'.join(lines) + '\n').encode()
+        (self.fx.root / path).write_bytes(raw)
+        return {'path': path, 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}
+
+    def contract(self, parents, overrides=(), supersessions=None, listed=AUTO, members=None):
+        """Bind one record and return its pin. AUTO lists the record's supersessions in its review; None omits the list."""
+        if listed is AUTO:
+            listed = [entry['supersedes'] for entry in supersessions] if supersessions else None
+        return self.fx.contract(parents, overrides, members, supersessions, listed)['record']
+
