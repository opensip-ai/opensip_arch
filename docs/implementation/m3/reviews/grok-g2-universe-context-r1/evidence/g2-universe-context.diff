+            )))
+        } else {
+            map(projection).unwrap()["projectionSha256"].clone()
+        };
+        fields(&mut f.universe).insert("configProjectionSha256".into(), value);
+        let (u, c) = f.ids();
+        assert!(matches!(
+            f.check(u, c, c),
+            Err(UniverseContextError::FieldMismatch(
+                "configProjectionSha256"
+            ))
+        ));
+    }
+}
+#[test]
