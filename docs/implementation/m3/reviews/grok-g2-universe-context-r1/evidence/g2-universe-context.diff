+#[test]
+fn full_context_and_universe_named_context_must_match() {
+    let mut f = Fixture::new();
+    let (u, c) = f.ids();
+    assert!(matches!(
+        f.check(u, c, [0; 32]),
+        Err(UniverseContextError::HostContextMismatch)
+    ));
+    fields(&mut f.context).insert("hostTriple".into(), text("owned-other-host"));
+    let (new_u, new_c) = f.ids();
+    assert_ne!(new_c, c);
+    assert!(matches!(
+        f.check(new_u, new_c, c),
+        Err(UniverseContextError::HostContextMismatch)
+    ));
+    assert!(matches!(
+        f.check(u, new_c, new_c),
+        Err(UniverseContextError::FieldMismatch("nativeContextId"))
+    ));
+}
+#[test]
+fn missing_tampered_and_noncanonical_frames_refuse_before_field_joins() {
+    let mut f = Fixture::new();
+    let (u, c) = f.ids();
+    let bytes = f.blobs.remove(&u).unwrap();
+    assert!(matches!(
+        f.check(u, c, c),
+        Err(UniverseContextError::Frame(_))
+    ));
+    f.blobs.insert(u, b"substitution".to_vec());
+    assert!(matches!(
+        f.check(u, c, c),
+        Err(UniverseContextError::Frame(_))
+    ));
+    let mut noncanonical = bytes;
+    noncanonical.push(b'\n');
+    let bad = raw_sha256(&noncanonical);
+    f.blobs.insert(bad, noncanonical);
+    assert!(matches!(
+        f.check(bad, c, c),
+        Err(UniverseContextError::Frame(_))
+    ));
+}
+#[test]
+fn wrong_frame_sets_and_shape_unknowns_refuse() {
+    let mut f = Fixture::new();
+    let (u, c) = f.ids();
+    assert!(matches!(
+        f.check(c, c, c),
+        Err(UniverseContextError::Frame(_))
+    ));
+    assert!(matches!(
+        f.check(u, u, u),
+        Err(UniverseContextError::Frame(_))
+    ));
+    fields(&mut f.universe).insert("unknown".into(), JsonValue::Bool(true));
+    let (u, c) = f.ids();
+    assert!(matches!(
+        f.check(u, c, c),
+        Err(UniverseContextError::Frame(_))
+    ));
+}
