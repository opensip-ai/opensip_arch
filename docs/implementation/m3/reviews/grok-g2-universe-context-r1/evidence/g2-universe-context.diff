+use super::*;
+use opensip_identity::{
+    JsonInteger, ObjectInput, RegisteredSchemas, canonical_bytes, hash_preimage, raw_sha256,
+};
+use std::path::Path;
+use std::sync::OnceLock;
+
+const WORK: usize = 10_000_000;
+fn schemas() -> &'static RegisteredSchemas {
+    static REGISTRY: OnceLock<RegisteredSchemas> = OnceLock::new();
+    REGISTRY.get_or_init(|| {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        let raw: Vec<_> = RegisteredSchemas::source_requirements()
+            .iter()
+            .map(|pin| std::fs::read(root.join(pin.source_path())).unwrap())
+            .collect();
+        RegisteredSchemas::from_sources(&raw.iter().map(Vec::as_slice).collect::<Vec<_>>()).unwrap()
+    })
+}
+fn object(entries: impl IntoIterator<Item = (&'static str, JsonValue)>) -> JsonValue {
+    JsonValue::Object(
+        entries
+            .into_iter()
+            .map(|(key, value)| (key.into(), value))
+            .collect(),
+    )
+}
+fn text(value: &str) -> JsonValue {
+    JsonValue::String(value.into())
+}
+fn number(value: usize) -> JsonValue {
+    JsonValue::Integer(JsonInteger::new(value as i128).unwrap())
+}
+fn hash_text(bytes: &[u8]) -> JsonValue {
+    text(&digest_hex(&raw_sha256(bytes)))
+}
+fn fields(value: &mut JsonValue) -> &mut BTreeMap<String, JsonValue> {
+    let JsonValue::Object(value) = value else {
+        panic!("owned object fixture")
+    };
+    value
+}
+struct Fixture {
+    objects: BTreeMap<String, ObjectInput>,
+    blobs: BTreeMap<[u8; 32], Vec<u8>>,
+    context: JsonValue,
+    universe: JsonValue,
+}
+impl Fixture {
+    fn new() -> Self {
+        let context = object([
+            ("schemaVersion", number(2)),
+            ("targetTriple", text("aarch64-apple-darwin")),
+            ("hostTriple", text("aarch64-apple-darwin")),
+            (
+                "toolchain",
+                object([
+                    ("cargoVersion", text("1.95.0")),
+                    ("rustCommitHash", text(&"0".repeat(40))),
+                    ("rustcDevLlvmDigest", text(&"1".repeat(64))),
+                    ("rustcVersion", text("1.95.0")),
+                    ("standardLibraryComponentDigests", JsonValue::Array(vec![])),
+                    ("sysrootDigest", hash_text(b"unadmitted sysroot fixture")),
+                    ("targetTriple", text("aarch64-apple-darwin")),
+                ]),
+            ),
+            (
+                "toolClosure",
+                object([
+                    ("ar", hash_text(b"ar")),
+                    ("cargo", hash_text(b"cargo")),
+                    ("closureId", text(&format!("closure2:{}", "0".repeat(64)))),
+                    ("linker", hash_text(b"linker")),
+                    ("procMacroServer", hash_text(b"proc")),
+                    ("rustc", hash_text(b"rustc")),
+                ]),
+            ),
+            ("baseCfg", JsonValue::Array(vec![text("unix")])),
+            ("resolverVersion", number(3)),
+            (
+                "dependencySourceSetId",
+                text(&format!("sha256:{}", "a".repeat(64))),
+            ),
+            (
+                "unifiedFeaturesId",
+                text(&format!("sha256:{}", "b".repeat(64))),
+            ),
+            ("preparedOutputSetId", JsonValue::Null),
+            (
+                "configProjection",
+                object([
+                    ("schemaVersion", number(2)),
+                    ("ancestorCarrierVerified", JsonValue::Bool(true)),
+                    ("cargoHome", text("private-empty")),
+                    ("claimsCargoSwitch", JsonValue::Bool(false)),
+                    ("environmentProjection", text("none")),
+                    ("honoredKeys", JsonValue::Array(vec![])),
+                    ("projectionSha256", hash_text(b"unadmitted config fixture")),
+                    ("replacedSnapshotConfigs", JsonValue::Array(vec![])),
+                    (
+                        "rustflags",
+                        object([
+                            ("executableSelected", JsonValue::Bool(false)),
+                            ("honored", JsonValue::Array(vec![])),
+                            ("stripped", JsonValue::Array(vec![])),
+                        ]),
+                    ),
+                    ("strippedKeys", JsonValue::Array(vec![])),
+                ]),
+            ),
+        ]);
+        let universe = object([
+            ("schemaVersion", number(2)),
+            ("edition", object([("owned", number(2024))])),
+            (
+                "lockfileIdentity",
+                object([
+                    ("path", text("Cargo.lock")),
+                    ("contentSha256", hash_text(b"owned lock")),
+                    ("lockfileVersion", number(4)),
+                ]),
+            ),
+            (
+                "dependencySourceSetId",
+                map(&context).unwrap()["dependencySourceSetId"].clone(),
+            ),
+            (
+                "unifiedFeaturesId",
+                map(&context).unwrap()["unifiedFeaturesId"].clone(),
+            ),
+            ("nativeContextId", JsonValue::Null),
+            (
+                "cfgSets",
+                JsonValue::Array(vec![
+                    cfg("primary", &["unix"]),
+                    cfg("test", &["test", "unix"]),
+                ]),
+            ),
+            (
+                "rustflags",
+                map(&map(&context).unwrap()["configProjection"]).unwrap()["rustflags"].clone(),
+            ),
+            ("crateRootPaths", JsonValue::Array(vec![text("src/lib.rs")])),
+            (
+                "configProjectionSha256",
+                text(&digest_hex(
+                    &hash_canonical_value(
+                        "native.cargo-config-projection.v2",
+                        &map(&context).unwrap()["configProjection"],
+                    )
+                    .unwrap(),
+                )),
+            ),
+            ("preparedResolution", text("none")),
+            ("executionCapableResolution", JsonValue::Bool(false)),
+            ("preparedOutputSetId", JsonValue::Null),
+            ("sourceUnitOwnershipId", JsonValue::Null),
+        ]);
+        Self {
+            objects: BTreeMap::new(),
+            blobs: BTreeMap::new(),
+            context,
+            universe,
+        }
+    }
+    fn ids(&mut self) -> ([u8; 32], [u8; 32]) {
+        let c = hash_preimage("native.context.rust.v2", &self.context).unwrap();
+        let cs = raw_sha256(&c);
+        self.blobs.insert(cs, c);
+        fields(&mut self.universe).insert(
+            "nativeContextId".into(),
+            text(&format!("sha256:{}", digest_hex(&cs))),
+        );
+        let u = hash_preimage("native.semantic-universe.rust.v2", &self.universe).unwrap();
+        let us = raw_sha256(&u);
+        self.blobs.insert(us, u);
+        (us, cs)
+    }
+    fn check(
+        &self,
+        us: [u8; 32],
+        cs: [u8; 32],
+        host: [u8; 32],
+    ) -> Result<UniverseContextChecks, UniverseContextError> {
+        check_declared_universe_context(
+            &RetainedInputs::new(schemas(), &self.objects, &self.blobs),
+            us,
+            cs,
+            host,
+            WORK,
+        )
+    }
+    fn prepared(&mut self, kind: &str) {
+        let id = text(&format!("sha256:{}", "c".repeat(64)));
+        fields(&mut self.context).insert("preparedOutputSetId".into(), id.clone());
+        fields(&mut self.universe).insert("preparedOutputSetId".into(), id);
+        fields(&mut self.universe).insert("preparedResolution".into(), text(kind));
+        fields(&mut self.universe)
+            .insert("executionCapableResolution".into(), JsonValue::Bool(true));
+    }
+}
+fn cfg(id: &str, values: &[&str]) -> JsonValue {
+    object([
+        ("cfgSetId", text(id)),
+        (
+            "cfg",
+            JsonValue::Array(values.iter().map(|s| text(s)).collect()),
+        ),
+    ])
+}
+
+#[test]
+fn valid_owned_field_agreement_is_inert_and_preserves_cfg_sequences() {
+    let mut f = Fixture::new();
+    let (u, c) = f.ids();
+    let result = f.check(u, c, c).unwrap();
+    assert_eq!(result.context_digest(), c);
+    assert_eq!(result.universe_digest(), u);
+    assert_eq!(result.cfg_set_count(), 2);
+    assert!(!result.consumed_prepared_products());
+    assert!(f.objects.is_empty()); // No snapshot/nested records: deliberately not full binding.
+    assert_eq!(
+        map(&f.universe).unwrap()["cfgSets"],
+        JsonValue::Array(vec![
+            cfg("primary", &["unix"]),
+            cfg("test", &["test", "unix"])
+        ])
+    );
+}
+#[test]
+fn preparation_meaning_for_both_kinds_is_no_execution_grant() {
+    for kind in ["host-prepared", "imported-inert"] {
+        let mut f = Fixture::new();
+        f.prepared(kind);
+        let (u, c) = f.ids();
+        assert!(f.check(u, c, c).unwrap().consumed_prepared_products());
+        assert!(f.objects.is_empty());
+    }
+}
+#[test]
+fn each_overlapping_nested_identity_must_match() {
+    for name in [
+        "dependencySourceSetId",
+        "unifiedFeaturesId",
+        "preparedOutputSetId",
+    ] {
+        let mut f = Fixture::new();
+        fields(&mut f.universe).insert(name.into(), text(&format!("sha256:{}", "d".repeat(64))));
+        let (u, c) = f.ids();
+        assert!(matches!(f.check(u,c,c), Err(UniverseContextError::FieldMismatch(n)) if n==name));
+    }
+}
+#[test]
+fn flag_sequences_must_agree_including_order_and_stripped_values() {
+    for name in ["honored", "stripped"] {
+        let mut f = Fixture::new();
+        let flags = if name == "honored" {
+            vec![text("--cfg=owned"), text("--cfg=second")]
+        } else {
+            vec![
+                object([("flag", text("@owned")), ("reason", text("response-file"))]),
+                object([
+                    ("flag", text("--owned")),
+                    ("reason", text("not-allowlisted")),
+                ]),
+            ]
+        };
+        fields(fields(&mut f.universe).get_mut("rustflags").unwrap())
+            .insert(name.into(), JsonValue::Array(flags.clone()));
+        let (u, c) = f.ids();
+        assert!(matches!(
+            f.check(u, c, c),
+            Err(UniverseContextError::FieldMismatch("rustflags"))
+        ));
+        let value = map(&f.universe).unwrap()["rustflags"].clone();
+        fields(fields(&mut f.context).get_mut("configProjection").unwrap())
+            .insert("rustflags".into(), value);
+        let projection = &map(&f.context).unwrap()["configProjection"];
+        fields(&mut f.universe).insert(
+            "configProjectionSha256".into(),
+            text(&digest_hex(
+                &hash_canonical_value("native.cargo-config-projection.v2", projection).unwrap(),
+            )),
+        );
+        let (u, c) = f.ids();
+        f.check(u, c, c).unwrap();
+        fields(fields(&mut f.universe).get_mut("rustflags").unwrap()).insert(
+            name.into(),
+            JsonValue::Array(flags.into_iter().rev().collect()),
+        );
+        let (u, c) = f.ids();
+        assert!(matches!(
+            f.check(u, c, c),
+            Err(UniverseContextError::FieldMismatch("rustflags"))
+        ));
+    }
+}
+#[test]
+fn raw_projection_file_and_canonical_record_hashes_are_not_projection_h() {
+    for canonical in [false, true] {
+        let mut f = Fixture::new();
+        let projection = &map(&f.context).unwrap()["configProjection"];
+        let value = if canonical {
+            text(&digest_hex(&raw_sha256(
