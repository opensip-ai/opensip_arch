+//! Declared Rust universe/context field joins for compiler authoring.
+//! Success is an inert observation, not bind_rust_universe or native admission.
+
+use opensip_identity::{
+    DigestError, GraphError, JsonValue, NativeFrameSet, RetainedInputs, digest_hex,
+    hash_canonical_value,
+};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Debug)]
+pub enum UniverseContextError {
+    Frame(GraphError),
+    Digest(DigestError),
+    Representation,
+    ForeignContext,
+    ForeignUniverse,
+    HostContextMismatch,
+    FieldMismatch(&'static str),
+    MissingBaseCfg,
+    DuplicateCfgSetId,
+}
+
+/// Field agreement only. No context, universe, Plan or execution authority.
+#[derive(Debug)]
+pub struct UniverseContextChecks {
+    context_digest: [u8; 32],
+    universe_digest: [u8; 32],
+    cfg_set_count: usize,
+    consumed_prepared_products: bool,
+}
+impl UniverseContextChecks {
+    pub fn context_digest(&self) -> [u8; 32] {
+        self.context_digest
+    }
+    pub fn universe_digest(&self) -> [u8; 32] {
+        self.universe_digest
+    }
+    pub fn cfg_set_count(&self) -> usize {
+        self.cfg_set_count
+    }
+    /// Resolution meaning only; imported inert products never grant execution.
+    pub fn consumed_prepared_products(&self) -> bool {
+        self.consumed_prepared_products
+    }
+}
+
+/// Recompute both exact current frames and check the §2.1 overlapping fields.
+///
+/// The caller owns host context selection/admission. The expected digest is
+/// compared to the full context H; the universe must name that same context.
+/// Dependencies/features/prepared records and ownership, tool/configuration
+/// semantics, editions, snapshot correspondence, signatures and full context
+/// admission remain outstanding. This function deliberately does not implement
+/// bind_rust_universe: a successful observation cannot authorize Plan binding,
+/// provider execution or a NativeContextVerified message. It performs no ambient
+/// filesystem read and invokes no tool. cfg sequences retain their declared order.
+pub fn check_declared_universe_context(
+    inputs: &RetainedInputs<'_>,
+    universe_digest: [u8; 32],
+    context_digest: [u8; 32],
+    expected_host_digest: [u8; 32],
+    schema_work: usize,
+) -> Result<UniverseContextChecks, UniverseContextError> {
+    let context = inputs
+        .frame_candidate(context_digest, NativeFrameSet::Context, schema_work)
+        .map_err(UniverseContextError::Frame)?;
+    if context.domain() != "native.context.rust.v2" {
+        return Err(UniverseContextError::ForeignContext);
+    }
+    let universe = inputs
+        .frame_candidate(
+            universe_digest,
+            NativeFrameSet::SemanticUniverse,
+            schema_work,
+        )
+        .map_err(UniverseContextError::Frame)?;
+    if universe.domain() != "native.semantic-universe.rust.v2" {
+        return Err(UniverseContextError::ForeignUniverse);
+    }
+    if context.digest() != expected_host_digest {
+        return Err(UniverseContextError::HostContextMismatch);
+    }
+    let c = map(context.descriptor())?;
+    let u = map(universe.descriptor())?;
+    if text(field(u, "nativeContextId")?)? != format!("sha256:{}", digest_hex(&context.digest())) {
+        return Err(UniverseContextError::FieldMismatch("nativeContextId"));
+    }
+    for name in [
+        "dependencySourceSetId",
+        "unifiedFeaturesId",
+        "preparedOutputSetId",
+    ] {
+        if field(u, name)? != field(c, name)? {
+            return Err(UniverseContextError::FieldMismatch(name));
+        }
+    }
+    let projection = field(c, "configProjection")?;
+    if field(u, "rustflags")? != field(map(projection)?, "rustflags")? {
+        return Err(UniverseContextError::FieldMismatch("rustflags"));
+    }
+    let projection_digest = hash_canonical_value("native.cargo-config-projection.v2", projection)
+        .map_err(UniverseContextError::Digest)?;
+    if text(field(u, "configProjectionSha256")?)? != digest_hex(&projection_digest) {
+        return Err(UniverseContextError::FieldMismatch(
+            "configProjectionSha256",
+        ));
+    }
+    let prepared = text(field(u, "preparedResolution")?)? != "none";
+    if field(u, "executionCapableResolution")? != &JsonValue::Bool(prepared) {
+        return Err(UniverseContextError::FieldMismatch(
+            "executionCapableResolution",
+        ));
+    }
+    if matches!(field(u, "preparedOutputSetId")?, JsonValue::Null) == prepared {
+        return Err(UniverseContextError::FieldMismatch("preparedOutputSetId"));
+    }
+    let base = array(field(c, "baseCfg")?)?
+        .iter()
+        .map(text)
+        .collect::<Result<BTreeSet<_>, _>>()?;
+    let sets = array(field(u, "cfgSets")?)?;
+    let mut ids = BTreeSet::new();
+    for row in sets {
+        let row = map(row)?;
+        if !ids.insert(text(field(row, "cfgSetId")?)?) {
+            return Err(UniverseContextError::DuplicateCfgSetId);
+        }
+        let cfg = array(field(row, "cfg")?)?
+            .iter()
+            .map(text)
+            .collect::<Result<BTreeSet<_>, _>>()?;
+        if !base.is_subset(&cfg) {
+            return Err(UniverseContextError::MissingBaseCfg);
+        }
+    }
+    Ok(UniverseContextChecks {
+        context_digest: context.digest(),
+        universe_digest: universe.digest(),
+        cfg_set_count: sets.len(),
+        consumed_prepared_products: prepared,
+    })
+}
+fn map(value: &JsonValue) -> Result<&BTreeMap<String, JsonValue>, UniverseContextError> {
+    match value {
+        JsonValue::Object(v) => Ok(v),
+        _ => Err(UniverseContextError::Representation),
+    }
+}
+fn field<'a>(
+    value: &'a BTreeMap<String, JsonValue>,
+    key: &str,
+) -> Result<&'a JsonValue, UniverseContextError> {
+    value.get(key).ok_or(UniverseContextError::Representation)
+}
+fn text(value: &JsonValue) -> Result<&str, UniverseContextError> {
+    match value {
+        JsonValue::String(v) => Ok(v),
+        _ => Err(UniverseContextError::Representation),
+    }
+}
+fn array(value: &JsonValue) -> Result<&[JsonValue], UniverseContextError> {
+    match value {
+        JsonValue::Array(v) => Ok(v),
+        _ => Err(UniverseContextError::Representation),
+    }
+}
