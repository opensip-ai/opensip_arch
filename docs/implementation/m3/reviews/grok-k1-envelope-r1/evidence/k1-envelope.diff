+
+class EnvelopeTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.validate = staticmethod(shape_validator(SCHEMA.read_bytes(), PACKAGES, MANIFEST))
+
+    def altered(self, change):
+        value = copy.deepcopy(SYNTHETIC)
+        change(value)
+        with self.assertRaises(Refusal):
+            self.validate(canonical(value))
+
+    def test_shape_is_not_a_measurement_or_qualification_assent(self):
+        result = self.validate(canonical(SYNTHETIC))
+        self.assertTrue(result['structuralAdmission'])
+        self.assertFalse(result['crossRowEvidenceValidated'])
+        self.assertFalse(result['productQualification'])
+        # q6 has no leaves, operational records or observations and is still
+        # structurally valid. The cross-row validator must reject those joins.
+        self.assertEqual(SYNTHETIC['cgroupLeaves'], [])
+
+    def test_root_and_nested_fields_closed(self):
+        self.altered(lambda x: x.update(extra=True))
+        self.altered(lambda x: x['runner']['calibration'].update(extra=True))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(extra=True))
+
+    def test_required_root_and_nested_members(self):
+        self.altered(lambda x: x.pop('ledger'))
+        self.altered(lambda x: x['ledger'].pop('freezeRecordDigest'))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].pop('baselineBasisDigest'))
+
+    def test_qualification_and_standing_constants(self):
+        self.altered(lambda x: x.update(qualificationEvidence=True))
+        self.altered(lambda x: x.update(standing='qualified'))
+        self.altered(lambda x: x.update(schemaMajor=True))
+        self.altered(lambda x: x.update(declaration='qualified'))
+
+    def test_exact_integer_boolean_separation_and_range(self):
+        self.altered(lambda x: x['runner'].update(logicalCpus=True))
+        self.altered(lambda x: x['runner'].update(memoryBytes=0))
+        self.altered(lambda x: x['results']['q4'].update(mustAbstainCases=-1))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(yieldPpm=1000001))
+
+    def test_fixed_enumerations_and_digest_spelling(self):
+        self.altered(lambda x: x['runner'].update(runnerClass='arbitrary'))
+        self.altered(lambda x: x['ledger'].update(ledgerDigest='A'*64))
+        self.altered(lambda x: x['ledger'].update(ledgerDigest='0'*64+'\n'))
+        self.altered(lambda x: x['product'].update(commit='0'*39))
+
+    def test_conditional_baselines(self):
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(baselineMedianNanos=None))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(baselineBasisDigest=None))
+
+    def test_fixed_seven_sample_positions(self):
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(elapsedNanos=[1]*6))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(elapsedNanos=[1]*8))
+        self.altered(lambda x: x['results']['q6']['workloads'][0].update(elapsedNanos=[1]*6+[None]))
+
+    def test_sequence_positions_preserved_without_sorting_or_deduplication(self):
+        value = copy.deepcopy(SYNTHETIC)
+        value['results']['q7']['rules'][0]['scoreHistogram'] = [3,0,2,1,0]
+        before = canonical(value)
+        self.validate(before)
+        self.assertEqual(canonical(value), before)
+        self.assertEqual(value['results']['q6']['workloads'][0]['elapsedNanos'], [7,1,6,2,5,3,4])
+
+    def test_canonical_sets_sorted_unique_even_nested(self):
+        value = copy.deepcopy(SYNTHETIC)
+        rules = value['results']['q8']['shapes']
+        rules.append({'shapeId':'another', 'manualCorrections':1})
+        rules.sort(key=canonical)
+        self.validate(canonical(value))
+        rules.reverse()
+        with self.assertRaises(Refusal): self.validate(canonical(value))
+        rules[:] = [rules[0], copy.deepcopy(rules[0])]
+        with self.assertRaises(Refusal): self.validate(canonical(value))
+
+    def test_array_and_string_limits(self):
+        self.altered(lambda x: x['results']['q1'].update(cells=[{}]*4097))
+        self.altered(lambda x: x.update(roundId='x'*4097))
+        self.altered(lambda x: x.update(measuredAt='x'*65))
+
+    def test_record_parser_duplicates_floats_and_bounds(self):
+        for raw in (b'{"standing":1,"standing":2}', b'{"schemaMajor":1.0}',
+                    b'['*33+b'0'+b']'*33, b' '* (4*1024*1024+1)):
+            with self.assertRaises(Refusal): self.validate(raw)
+
+    def test_format_remains_annotation_and_provenance_remains_unproved(self):
+        value = copy.deepcopy(SYNTHETIC)
+        value['measuredAt'] = 'synthetic annotation'
+        self.assertFalse(self.validate(canonical(value))['crossRowEvidenceValidated'])
+
+    def test_schema_and_dependency_manifest_pins(self):
+        for raw in (SCHEMA.read_bytes()+b'\n', SCHEMA.read_bytes().replace(b'D13',b'D14')):
+            with self.assertRaises(Refusal): shape_validator(raw, PACKAGES, MANIFEST)
+        with self.assertRaises(Refusal): shape_validator(SCHEMA.read_bytes(), PACKAGES, MANIFEST+b' ')
+
+    def test_dependency_snapshot_tampering_missing_extra_and_links(self):
+        with tempfile.TemporaryDirectory() as name:
+            root = pathlib.Path(name)/'packages'
+            for mode in ('changed','missing','extra','linked'):
+                if root.exists(): shutil.rmtree(root)
+                shutil.copytree(PACKAGES, root)
+                target = root/'jsonschema/__init__.py'
+                if mode=='changed': target.write_bytes(target.read_bytes()+b'\n')
+                if mode=='missing': target.unlink()
+                if mode=='extra': (root/'extra.py').write_text('')
+                if mode=='linked': target.unlink(); target.symlink_to(PACKAGES/'jsonschema/__init__.py')
+                with self.assertRaises(Refusal): shape_validator(SCHEMA.read_bytes(), root, MANIFEST)
+
+    def test_preloaded_ambient_dependency_refuses_before_import(self):
+        name = 'jsonschema.ambient_control'
+        fake = types.ModuleType(name); fake.__file__ = '/tmp/ambient-control.py'
+        sys.modules[name] = fake
+        try:
+            with self.assertRaises(Refusal): shape_validator(SCHEMA.read_bytes(), PACKAGES, MANIFEST)
+        finally:
+            del sys.modules[name]
+
+
+if __name__ == '__main__':
+    unittest.main()
