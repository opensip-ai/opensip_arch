+"""Pinned Q0 r13 ENV structure and CAN ordering, not evidence acceptance.
+
+Use isolated Python -I -B -S and an explicit retained contracts dependency
+snapshot. The caller owns that snapshot and prevents concurrent mutation.
+No acquisition, producer, measurement, qualification or schema successor.
+"""
+import hashlib
+import importlib
+import json
+import stat
+import sys
+from pathlib import Path
+
+from canonical import Refusal, canonical, digest, parse
+
+SCHEMA_SHA256 = '71f682d125c956eaec7a0f015fc8a0203f78b15f4538935f7beab45a398a2eb6'
+SCHEMA_BYTES = 60241
+PACKAGES_SHA256 = 'bd1ebac8f2efec1a5a88e35f8628c12ba67764c1e601e5aca773fecdf3178a82'
+DEPENDENCIES = ('jsonschema', 'jsonschema_specifications', 'referencing',
+                'rpds', 'attrs', 'attr')
+
+
+def _dependencies(packages, manifest_raw):
+    if not (sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode):
+        raise Refusal('ISOLATED_NO_SITE_NO_BYTECODE_REQUIRED')
+    if type(manifest_raw) is not bytes or hashlib.sha256(manifest_raw).hexdigest() != PACKAGES_SHA256:
+        raise Refusal('DEPENDENCY_MANIFEST_PIN')
+    packages = Path(packages)
+    if packages.is_symlink() or not packages.is_dir():
+        raise Refusal('DEPENDENCY_DIRECTORY')
+    packages = packages.resolve(strict=True)
+    expected = json.loads(manifest_raw)['files']
+    by_path = {row['path']: row for row in expected}
+    actual = []
+    for path in sorted(packages.rglob('*'), key=lambda p: p.relative_to(packages).as_posix()):
+        info = path.lstat()
+        if stat.S_ISDIR(info.st_mode):
+            continue
+        if not stat.S_ISREG(info.st_mode):
+            raise Refusal('DEPENDENCY_NONREGULAR')
+        relative = path.relative_to(packages).as_posix()
+        if relative not in by_path or info.st_size != by_path[relative]['bytes']:
+            raise Refusal('DEPENDENCY_SNAPSHOT_PIN')
+        raw = path.read_bytes()
+        actual.append({'path': path.relative_to(packages).as_posix(), 'bytes': len(raw),
+                       'sha256': hashlib.sha256(raw).hexdigest()})
+    if actual != expected:
+        raise Refusal('DEPENDENCY_SNAPSHOT_PIN')
+    # Refuse cached ambient dependencies before resolving any package import.
+    for name, module in tuple(sys.modules.items()):
+        if name.split('.')[0] in DEPENDENCIES:
+            origin = getattr(module, '__file__', None)
+            if origin is None or not Path(origin).resolve().is_relative_to(packages):
+                raise Refusal('AMBIENT_DEPENDENCY')
+    sys.path.insert(0, str(packages))
+    try:
+        return importlib.import_module('jsonschema')
+    finally:
+        sys.path.pop(0)
+
+
+def shape_validator(schema_raw, packages, manifest_raw):
+    """Construct only the pinned structural validator; format is annotation.
+
+    ENV uses JSON Schema's default format-annotation semantics. Timestamp
+    provenance and semantic date-time admission are separate from this layer.
+    Dependencies are the existing host-specific preparation snapshot, never
+    downloaded, installed or discovered from ambient site packages here.
+    """
+    if type(schema_raw) is not bytes or len(schema_raw) != SCHEMA_BYTES or hashlib.sha256(schema_raw).hexdigest() != SCHEMA_SHA256:
+        raise Refusal('ENV_SCHEMA_PIN')
+    schema = parse(schema_raw)
+    library = _dependencies(packages, manifest_raw)
+
+    def order(validator, selected, instance, subschema):
+        if type(instance) is not list or selected == 'sequence':
+            return
+        if selected != 'canonical-set':
+            raise Refusal('ENV_ORDER_UNSELECTED')
+        previous = None
+        for item in instance:
+            raw = canonical(item)
+            if previous is not None and raw <= previous:
+                yield library.ValidationError('ENV_CANONICAL_SET')
+                return
+            previous = raw
+
+    selected = library.validators.extend(library.Draft202012Validator,
+                                         {'x-opensip-order': order})
+    validator = selected(schema)
+
+    def validate(raw):
+        value = parse(raw)
+        error = next(validator.iter_errors(value), None)
+        if error is not None:
+            # Fixed diagnostic; do not interpolate candidate record contents.
+            raise Refusal('ENV_SHAPE_OR_ORDER')
+        return {'schemaSha256': SCHEMA_SHA256, 'canonicalDigest': digest(value),
+                'structuralAdmission': True, 'crossRowEvidenceValidated': False,
+                'productQualification': False}
+
+    return validate
