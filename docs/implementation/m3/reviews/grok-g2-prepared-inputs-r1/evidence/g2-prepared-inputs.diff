+    blobs: BTreeMap<[u8; 32], Vec<u8>>,
+    context: JsonValue,
+    universe: JsonValue,
+    dependency: JsonValue,
+    features: JsonValue,
+    snapshot: JsonValue,
+    prepared: Option<JsonValue>,
+    ownership: Option<JsonValue>,
+}
