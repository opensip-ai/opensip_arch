+#[test]
+fn cycle_representative_test_pack_admits_under_its_op_law() {
+    // Law M3-I1 item 2.2: the atom is the rule's whole emitWhen over file
+    // subjects. Its op law replaces imports' source-kind check (symbol), so
+    // the file-kind rule now admits through both passes, policy and program.
+    let raw = rule_document(CYCLE, "file", None);
+    let admitted = admit_test_pack(&raw).unwrap();
+    assert_eq!(admitted.pack_id(), TEST_ID);
+    assert_eq!(admitted.policy_digest(), raw_sha256(&raw));
+    let rules = array(field(admitted.program(), "rules").unwrap()).unwrap();
+    assert_eq!(rules.len(), 1);
+    assert_eq!(field(&rules[0], "emitWhen").unwrap(), &json(CYCLE));
+    assert_eq!(
+        admitted.program_digest(),
+        raw_sha256(&canonical_bytes(admitted.program()).unwrap())
+    );
+    // The same identity again is the same admission.
+    assert_eq!(admit_test_pack(&raw).unwrap().program(), admitted.program());
+    // "For this op only": every other op keeps the shared law. An imports
+    // atom over file subjects still fails the source-kind check, and over
+    // symbol subjects it admits, in any position.
+    assert_eq!(
+        admit_test_pack(&rule_document(EXISTS_IMPORTS, "file", None)).unwrap_err(),
+        rule_law_fault()
+    );
+    for emit_when in [
+        String::from(EXISTS_IMPORTS),
+        format!(r#"{{"op":"not","operand":{EXISTS_IMPORTS}}}"#),
+    ] {
+        admit_test_pack(&rule_document(&emit_when, "symbol", None)).unwrap();
+    }
+}
