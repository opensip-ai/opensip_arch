+/// Law M3-I1 item 2.1's atom, as the preview pack's one rule writes it.
+const CYCLE: &str = r#"{"filters":[],"minResolution":"resolved-target","op":"cycle-representative","relation":"imports"}"#;
+const EXISTS_FILE: &str =
+    r#"{"filters":[],"minResolution":"enumerated","op":"exists","relation":"file"}"#;
+const EXISTS_IMPORTS: &str =
+    r#"{"filters":[],"minResolution":"resolved-target","op":"exists","relation":"imports"}"#;
+const UNKNOWN_RULE: &str = "POLICY_RULE_NOT_ADMISSIBLE:policy:no-consumer:POLICY.UNKNOWN_RULE";
+fn json(raw: &str) -> V {
+    parse_json(raw.as_bytes()).unwrap()
+}
+/// CYCLE with each (member, JSON value) set.
+fn cycle_with(members: &[(&str, &str)]) -> String {
+    let mut atom = json(CYCLE);
+    for (member, value) in members {
+        put(&mut atom, &format!("/{member}"), json(value));
+    }
+    String::from_utf8(bytes_of(&atom)).unwrap()
+}
+/// The bundled test document with its one rule's emitWhen, subjectKind and,
+/// when given, evidenceUse replaced.
+fn rule_document(emit_when: &str, subject_kind: &str, evidence_use: Option<&str>) -> Vec<u8> {
+    let mut doc = test_document();
+    put(&mut doc, "/rules/0/emitWhen", json(emit_when));
+    put(
+        &mut doc,
+        "/rules/0/subjectEnumeration/subjectKind",
+        s(subject_kind),
+    );
+    if let Some(rows) = evidence_use {
+        put(&mut doc, "/rules/0/evidenceUse", json(rows));
+    }
+    bytes_of(&doc)
+}
+/// Admit `raw` as the one document of a one-row cfg(test) registry.
+fn admit_test_pack(raw: &[u8]) -> Result<AdmittedPack, PackRefusal> {
+    let (rows, doc, _) = one_row(raw, &digest_hex(&raw_sha256(raw)), &["fixture"]);
+    let documents = [("pack.json", doc.as_slice())];
+    let registry = PackRegistry {
+        rows: &rows,
+        documents: &documents,
+    };
+    named(&registry, TEST_ID)
+}
+fn rule_law_fault() -> PackRefusal {
+    PackRefusal::HostInvariant {
+        subject: format!("pack:{TEST_ID}"),
+        defect: PackDefect::RuleLaw(UNKNOWN_RULE.into()),
+    }
+}
+/// The emitWhen violations of item 2.2, each schema-admissible. Each of the
+/// atom's own violations would pass the shared atom law with the kind check
+/// skipped, except `evidence`, which a native relation also refuses.
+fn cycle_emit_when_violations() -> Vec<(&'static str, String)> {
+    vec![
+        ("under not", format!(r#"{{"op":"not","operand":{CYCLE}}}"#)),
+        (
+            "an operand of and",
+            format!(r#"{{"op":"and","operands":[{CYCLE},{EXISTS_FILE}]}}"#),
+        ),
+        (
+            "an operand of or",
+            format!(r#"{{"op":"or","operands":[{EXISTS_FILE},{CYCLE}]}}"#),
+        ),
+        (
+            "both operands of and",
+            format!(r#"{{"op":"and","operands":[{CYCLE},{CYCLE}]}}"#),
+        ),
+        (
+            "under not under and",
+            format!(
+                r#"{{"op":"and","operands":[{{"op":"not","operand":{CYCLE}}},{EXISTS_FILE}]}}"#
+            ),
+        ),
+        (
+            "relation references",
+            cycle_with(&[
+                ("relation", r#""references""#),
+                ("minResolution", r#""resolved-binding""#),
+            ]),
+        ),
+        (
+            "relation file",
+            cycle_with(&[
+                ("relation", r#""file""#),
+                ("minResolution", r#""enumerated""#),
+            ]),
+        ),
+        (
+            "rung syntactic-specifier",
+            cycle_with(&[("minResolution", r#""syntactic-specifier""#)]),
+        ),
+        (
+            "a subject filter",
+            cycle_with(&[(
+                "filters",
+                r#"[{"cmp":"prefix","field":"subject","value":"src/"}]"#,
+            )]),
+        ),
+        (
+            "a resolution filter",
+            cycle_with(&[(
+                "filters",
+                r#"[{"cmp":"eq","field":"resolution","value":"resolved-target"}]"#,
+            )]),
+        ),
+        (
+            "endpoint target",
+            cycle_with(&[("endpoint", r#""target""#)]),
+        ),
+        (
+            "endpoint source",
+            cycle_with(&[("endpoint", r#""source""#)]),
+        ),
+        ("evidence", cycle_with(&[("evidence", r#""runtime""#)])),
+    ]
+}
