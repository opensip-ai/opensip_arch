+#[test]
+fn cycle_representative_op_law_holds_in_the_program_pass() {
+    // A compiled program reaching this pass equals its policy's compilation
+    // (compile_program here, RULE_PROGRAM_COMPILATION_JOIN for a retained one),
+    // so the program pass is exercised directly: a lawful policy beside a
+    // program whose emitWhen breaks item 2.2.
+    let meter = || Meter {
+        budget: TraversalBudget {
+            steps: PACK_TRAVERSAL_STEPS,
+            depth: 1,
+            descriptor_work: PACK_SCHEMA_WORK,
+        },
+    };
+    let compile = |policy: &V| compile_program(&mut meter(), &s(TEST_SHA), policy).unwrap();
+    let policy = test_document();
+    let program_with = |emit_when: &str| {
+        let mut program = compile(&policy);
+        put(&mut program, "/rules/0/emitWhen", json(emit_when));
+        program
+    };
+    assert_eq!(
+        check_program_laws(&mut meter(), &policy, &program_with(CYCLE)),
+        Ok(())
+    );
+    for (name, emit_when) in cycle_emit_when_violations() {
+        assert_eq!(
+            check_program_laws(&mut meter(), &policy, &program_with(&emit_when)),
+            Err(PolicyAdmissionError::Refused(
+                "POLICY_ATOM_NOT_ADMISSIBLE:program:no-consumer:POLICY.UNKNOWN_RULE".into()
+            )),
+            "{name}"
+        );
+    }
+    // A program carries no subjectEnumeration: the kind is the policy pass's,
+    // which runs first over the same rules.
+    for (kind, expected) in [
+        ("file", Ok(())),
+        (
+            "symbol",
+            Err(PolicyAdmissionError::Refused(UNKNOWN_RULE.into())),
+        ),
+    ] {
+        let policy = parse_json(&rule_document(CYCLE, kind, None)).unwrap();
+        assert_eq!(
+            check_program_laws(&mut meter(), &policy, &compile(&policy)),
+            expected,
+            "{kind}"
+        );
+    }
+}
+
+#[test]
+fn cycle_representative_op_law_stands_alone() {
+    // Item 2.2's conjuncts, independent of the atom registry. Through
+    // admission, two of them are also implied by the shared atom law today:
+    // no other relation's ladder holds `resolved-target`, and a native
+    // relation refuses `evidence`. Each still refuses on its own here.
+    let lawful = json(CYCLE);
+    assert!(cycle_representative_law(&lawful, Some("file"), true));
+    assert!(cycle_representative_law(&lawful, None, true));
+    assert!(!cycle_representative_law(&lawful, Some("file"), false));
+    assert!(!cycle_representative_law(&lawful, None, false));
+    for kind in ["symbol", "export", "package"] {
+        assert!(!cycle_representative_law(&lawful, Some(kind), true));
+    }
+    for members in [
+        &[("relation", r#""references""#)][..],
+        &[("minResolution", r#""syntactic-specifier""#)][..],
+        &[(
+            "filters",
+            r#"[{"cmp":"prefix","field":"subject","value":"src/"}]"#,
+        )][..],
+        &[("endpoint", r#""source""#)][..],
+        &[("endpoint", r#""target""#)][..],
+        &[("evidence", r#""runtime""#)][..],
+    ] {
+        let atom = json(&cycle_with(members));
+        assert!(
+            !cycle_representative_law(&atom, Some("file"), true),
+            "{members:?}"
+        );
+        assert!(!cycle_representative_law(&atom, None, true), "{members:?}");
+    }
+}
