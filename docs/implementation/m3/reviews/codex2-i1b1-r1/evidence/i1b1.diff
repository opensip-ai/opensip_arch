+#[test]
+fn cycle_representative_op_law_violations_are_row_4_rule_law() {
+    // Each violation of item 2.2 in a bundled document is X12 row 4 with the
+    // rule-law detail POLICY.UNKNOWN_RULE, never a schema refusal.
+    let mut cases: Vec<(&str, Vec<u8>)> = cycle_emit_when_violations()
+        .into_iter()
+        .map(|(name, emit_when)| (name, rule_document(&emit_when, "file", None)))
+        .collect();
+    for kind in ["symbol", "export", "package"] {
+        cases.push((kind, rule_document(CYCLE, kind, None)));
+    }
+    // Declared evidence is still refused by the op law, not admitted, and an
+    // undeclared one is POLICY.UNKNOWN_RULE, not IMPORT.ABSENT_FOR_PREDICATE.
+    cases.push((
+        "declared evidence",
+        rule_document(
+            &cycle_with(&[("evidence", r#""runtime""#)]),
+            "file",
+            Some(r#"[{"kind":"runtime","requirement":"required"}]"#),
+        ),
+    ));
+    assert_eq!(cases.len(), 17);
+    for (name, raw) in &cases {
+        let refusal = admit_test_pack(raw).unwrap_err();
+        assert_eq!(refusal, rule_law_fault(), "{name}");
+        assert_eq!(refusal.subject(), format!("pack:{TEST_ID}"));
+    }
+    // `n` is the schema's to refuse (PDS:339-363), before the rule law.
+    let raw = rule_document(&cycle_with(&[("n", "0")]), "file", None);
+    assert_eq!(
+        admit_test_pack(&raw).unwrap_err(),
+        PackRefusal::HostInvariant {
+            subject: format!("pack:{TEST_ID}"),
+            defect: PackDefect::Schema,
+        }
+    );
+}
