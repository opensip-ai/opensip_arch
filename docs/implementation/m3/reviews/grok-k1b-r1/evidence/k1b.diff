+"""K1b: Q0 r13 section 5, exact rational decisions.
+
+The result is a harness statistic, never authority.
+
+The caller supplies a separately admitted stratum and evidence set, frozen
+sample denominators, family independence, and exposure standing. This module
+does not infer any of those premises from labels or sample counts. K1c owns
+ledger/adjudication ingestion and emission of the full exploratory envelope;
+the returned components use Q0 r13's draft ENV vocabulary, without claiming
+D13 has approved that carrier. Downgrade is two calls at the preregistered
+fixed targets; no target tuning or qualification decision is performed here.
+
+Self-test: python3.14 -I -B tools/quality/test_confidence.py
+"""
+from fractions import Fraction
+from math import comb, prod
+
+ALPHA = Fraction(1, 20)
+TARGETS = (Fraction(99, 100), Fraction(9, 10))
+SCALE = 1_000_000
+
+
+def count(value):
+    if type(value) is not int or not 0 <= value <= 2**64-1:
+        raise ValueError("COUNT_REQUIRED")
+    return value
+
+
+def tail(n, x, p):
+    """P(Bin(n,p)>=x), using integers before one exact division."""
+    count(n)
+    count(x)
+    if type(p) is not Fraction or x > n or not 0 <= p <= 1:
+        raise ValueError("BINOMIAL_INPUT")
+    if x == n:
+        return p**n
+    if x == n-1:
+        return p**(n-1) * (n-(n-1)*p)
+    a, b = p.numerator, p.denominator
+    return Fraction(sum(comb(n, i) * a**i * (b-a)**(n-i) for i in range(x, n+1)), b**n)
+
+
+def ppm_floor(predicate):
+    """Largest q whose exact q/10^6 is no larger than the lower bound."""
+    lo, hi = 0, SCALE + 1
+    while hi-lo > 1:
+        mid = (lo+hi)//2
+        if predicate(Fraction(mid, SCALE)):
+            lo = mid
+        else:
+            hi = mid
+    return lo
+
+
+def cp(n, x):
+    count(n)
+    count(x)
+    if x > n:
+        raise ValueError("BINOMIAL_INPUT")
+    if not x:
+        return 0
+    return ppm_floor(lambda p: tail(n, x, p) <= ALPHA)
+
+
+def product_lower(families):
+    """families are (settled true, sampled denominator), chosen before labels."""
+    ratios = []
+    for true, sampled in families:
+        count(true)
+        count(sampled)
+        if not sampled or true > sampled:
+            raise ValueError("FAMILY_COUNTS")
+        ratios.append(Fraction(true, sampled))
+    if not ratios:
+        return 0
+    p = ALPHA * prod(ratios)
+    return ppm_floor(lambda q: q**len(ratios) <= p)
+
+
+def k_min(target):
+    if target not in TARGETS:
+        raise ValueError("FIXED_TARGET_REQUIRED")
+    k = 1
+    while target**k > ALPHA:
+        k += 1
+    return k
+
+
+def statistic(families, corpus_count, target, *, stratum, evidence_set):
+    """One stratum/evidence set only; no merging, qualification or waiver.
+
+    Each family's true/false/unclear/pending counts partition its preregistered
+    sampled denominator. The caller supplies admitted independence and exposure
+    standing; this library cannot infer either from counts or names.
+    """
+    if target not in TARGETS:
+        raise ValueError("FIXED_TARGET_REQUIRED")
+    if evidence_set not in ("held-out", "development"):
+        raise ValueError("EVIDENCE_SET_REQUIRED")
+    if type(stratum) is not dict or set(stratum) != {"ruleId", "language", "mode"}:
+        raise ValueError("STRATUM_REQUIRED")
+    if any(type(v) is not str or not 1 <= len(v) <= 4096 for v in stratum.values()):
+        raise ValueError("STRATUM_REQUIRED")
+    try:
+        for value in stratum.values():
+            value.encode("utf-8", "strict")
+    except UnicodeError as exc:
+        raise ValueError("STRATUM_REQUIRED") from exc
+    if stratum["language"] not in ("ts", "js", "rust", "python", "syntax-only"):
+        raise ValueError("STRATUM_REQUIRED")
+    if type(families) is not dict or any(type(key) is not str or not key for key in families):
+        raise ValueError("UNIQUE_FAMILY_MAP_REQUIRED")
+    observed, pending, not_true, false_total, unclear_total = [], 0, 0, 0, 0
+    for family in families.values():
+        values = [count(family[k]) for k in ("true", "false", "unclear", "pending", "sampled")]
+        true, false, unclear, waiting, sampled = values
+        if not sampled or true+false+unclear+waiting != sampled:
+            raise ValueError("FAMILY_COUNTS")
+        pending += waiting
+        not_true += false+unclear
+        false_total += false
+        unclear_total += unclear
+        observed.append((true, sampled))
+    k = len(observed)
+    single = all(a == 1 for _, a in observed)
+    method = "clopper-pearson-independent" if single else "cluster-product-bound"
+    if not k:
+        method = "none"
+    t = sum(t for t, _ in observed)
+    lower = cp(k, t) if single else product_lower(observed)
+    pass_bound = (tail(k, t, target) <= ALPHA if t else False) if single else (
+        bool(observed) and prod(Fraction(t, a) for t, a in observed) * ALPHA >= target**k)
+    sampled = count(sum(a for _, a in observed))
+    result = {"stratum": dict(stratum), "evidenceSet": evidence_set,
+              "method": method, "lowerBoundPpm": lower, "families": k,
+              "estimand": "family-weighted conservative precision", "targetPpm": int(target*SCALE),
+              "assumption": "Families are treated as independent draws from the population of repositories the claim is about; T2 is purposely selected, not randomly sampled.",
+              "qualification": False}
+    if corpus_count is not None:
+        n = count(corpus_count)
+        if sampled > n:
+            raise ValueError("SAMPLE_EXCEEDS_CORPUS")
+        result["populations"] = {"corpusFindings": n, "sampledFindings": sampled,
+                                "settledFindings": t+not_true, "pendingFindings": pending,
+                                "unlabelledFindings": n-sampled, "trueCount": t,
+                                "falseCount": false_total, "unclearCount": unclear_total}
+    if pending:
+        result.update(status="NOT-YET-ADJUDICATED", statusReason="pending-adjudication")
+        return result
+    if corpus_count is None:
+        result.update(status="INSUFFICIENT-EVIDENCE", statusReason="guard-unavailable")
+        return result
+    n = count(corpus_count)
+    u = n-t-not_true
+    verified, optimistic = (Fraction(t, n), Fraction(t+u, n)) if n else (Fraction(0), Fraction(0))
+    result.update(guardVerifiedPpm=(verified*SCALE).__floor__(), guardOptimisticPpm=(optimistic*SCALE).__ceil__(),
+                  censusPrecisionPpm=(verified*SCALE).__floor__() if u == 0 else None)
+    if not n or k < k_min(target):
+        result.update(status="INSUFFICIENT-EVIDENCE", statusReason="no-findings" if not n else "below-k-min")
+    elif optimistic < target:
+        result.update(status="FAIL", statusReason="census-below-target")
+    elif verified < target:
+        result.update(status="INSUFFICIENT-EVIDENCE", statusReason="guard-unverified")
+    elif pass_bound:
+        result.update(status="PASS", statusReason="none")
+    else:
+        result.update(status="INSUFFICIENT-EVIDENCE", statusReason="bound-below-target")
+    return result
