+"""Synthetic K1b controls; no measured or qualification data."""
+import importlib.util
+from pathlib import Path
+import unittest
+from fractions import Fraction
+from itertools import product
+
+spec = importlib.util.spec_from_file_location("confidence", Path(__file__).with_name("confidence.py"))
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+
+
+def statistic(rows, corpus, target):
+    return m.statistic(rows, corpus, target, stratum={"ruleId": "synthetic-rule", "language": "rust", "mode": "source-only"}, evidence_set="development")
+
+
+def families(k, true=1, false=0, unclear=0, pending=0):
+    return {str(i): {"true": true, "false": false, "unclear": unclear, "pending": pending,
+                     "sampled": true+false+unclear+pending} for i in range(k)}
+
+
+class Confidence(unittest.TestCase):
+    def test_exact_reference_values(self):
+        for n,x,want in [(299,299,990030),(29,29,901855),(473,472,990010),(46,45,900975)]:
+            self.assertEqual(m.cp(n,x),want)
+        for rows,want in [([(100,100)]*3,368403),([(1,1)]*30,904966),([(1,1)]*29+[(9,10)],901793),([(1,1)]*29+[(1,2)],884296)]:
+            self.assertEqual(m.product_lower(rows),want)
+
+    def test_exact_minima_and_adjacent_rounding(self):
+        self.assertEqual([m.k_min(t) for t in m.TARGETS],[299,29])
+        self.assertEqual(m.cp(298,298),989997)
+        self.assertEqual(m.cp(28,28),898534)
+        self.assertEqual(m.cp(472,471) < 990000,True)
+        self.assertEqual(m.cp(45,44) < 900000,True)
+
+    def test_family_method_chosen_from_sample_structure(self):
+        result=statistic(families(299),299,m.TARGETS[0])
+        self.assertEqual(result['method'],'clopper-pearson-independent')
+        self.assertEqual(result['status'],'PASS')
+        result=statistic(families(299,true=2),598,m.TARGETS[0])
+        self.assertEqual(result['method'],'cluster-product-bound')
+        self.assertEqual(result['status'],'PASS')
+
+    def test_zero_family_product_and_unclear(self):
+        self.assertEqual(m.cp(10,0),0)
+        self.assertEqual(m.product_lower([(1,1),(0,3)]),0)
+        result=statistic(families(300,true=0,unclear=1),300,m.TARGETS[0])
+        self.assertEqual(result['lowerBoundPpm'],0)
+        self.assertEqual(result['status'],'FAIL')
+
+    def test_pending_precedes_every_status(self):
+        for n in (None,1,10000):
+            result=statistic(families(1,true=0,pending=1),n,m.TARGETS[0])
+            self.assertEqual(result['status'],'NOT-YET-ADJUDICATED')
+
+    def test_minimum_precedes_optimistic_failure(self):
+        result=statistic(families(3,true=0,false=100),300,m.TARGETS[0])
+        self.assertEqual(result['status'],'INSUFFICIENT-EVIDENCE')
+        self.assertEqual(result['statusReason'],'below-k-min')
+
+    def test_unlabelled_cannot_be_sample_ratio_pass(self):
+        result=statistic(families(100),10099,m.TARGETS[1])
+        self.assertEqual(result['status'],'INSUFFICIENT-EVIDENCE')
+        self.assertEqual(result['statusReason'],'guard-unverified')
+        self.assertIsNone(result['censusPrecisionPpm'])
+
+    def test_optimistic_guard_failure(self):
+        result=statistic(families(300,true=1,false=1),700,m.TARGETS[1])
+        self.assertEqual(result['status'],'FAIL')
+
+    def test_guard_unavailable(self):
+        result=statistic(families(299),None,m.TARGETS[0])
+        self.assertEqual(result['statusReason'],'guard-unavailable')
+
+    def test_guard_holds_bound_does_not(self):
+        rows=families(299)
+        rows['0']={'true':0,'false':1,'unclear':0,'pending':0,'sampled':1}
+        result=statistic(rows,299,m.TARGETS[0])
+        self.assertEqual(result['statusReason'],'bound-below-target')
+
+    def test_product_partial_information(self):
+        rows=families(299)
+        rows['0']={'true':999999,'false':1,'unclear':0,'pending':0,'sampled':1000000}
+        result=statistic(rows,1000298,m.TARGETS[0])
+        self.assertEqual(result['status'],'PASS')
+
+    def test_count_and_partition_refusals(self):
+        for value in (-1,True,1.0):
+            with self.assertRaises(ValueError):m.cp(value,0)
+        for rows in (families(1,true=0),families(1)):
+            with self.assertRaises(ValueError):statistic(rows,0,m.TARGETS[0])
+        with self.assertRaises(ValueError):statistic([],0,m.TARGETS[0])
+        with self.assertRaises(ValueError):statistic(families(1),1,Fraction(95,100))
+
+    def test_binomial_tail_against_all_binary_sequences(self):
+        for n in range(1,8):
+            for p in (Fraction(1,4), Fraction(2,3), Fraction(0), Fraction(1)):
+                distribution = [Fraction(0)] * (n+1)
+                for bits in product((0,1),repeat=n):
+                    probability = Fraction(1)
+                    for bit in bits:
+                        probability *= p if bit else 1-p
+                    distribution[sum(bits)] += probability
+                for x in range(n+1):
+                    self.assertEqual(m.tail(n,x,p),sum(distribution[x:]))
+
+    def test_zero_findings_and_count_conservation(self):
+        result=statistic({},0,m.TARGETS[0])
+        self.assertEqual(result['method'],'none')
+        self.assertEqual(result['statusReason'],'no-findings')
+        result=statistic(families(30,true=9,false=1),330,m.TARGETS[1])
+        counts=result['populations']
+        self.assertEqual(counts['corpusFindings'],counts['sampledFindings']+counts['unlabelledFindings'])
+        self.assertEqual(counts['sampledFindings'],counts['settledFindings']+counts['pendingFindings'])
+        self.assertEqual(counts['settledFindings'],counts['trueCount']+counts['falseCount']+counts['unclearCount'])
+
+    def test_context_required_and_preserved(self):
+        context={'ruleId':'synthetic-rule','language':'rust','mode':'source-only'}
+        result=m.statistic(families(299),299,m.TARGETS[0],stratum=context,evidence_set='held-out')
+        self.assertEqual(result['evidenceSet'],'held-out')
+        self.assertEqual(result['stratum'],context)
+        self.assertFalse(result['qualification'])
+        for bad in ('mixed','all'):
+            with self.assertRaises(ValueError):m.statistic(families(1),1,m.TARGETS[0],stratum=context,evidence_set=bad)
+        with self.assertRaises(ValueError):m.statistic(families(1),1,m.TARGETS[0],stratum={},evidence_set='development')
+
+    def test_integer_range_and_rational_probability(self):
+        with self.assertRaises(ValueError):m.cp(2**64,0)
+        with self.assertRaises(ValueError):m.tail(5,2,0.9)
+
+    def test_method_and_bound_do_not_use_corpus_as_denominator(self):
+        rows=families(30,true=9,false=1)
+        first=statistic(rows,300,m.TARGETS[1])
+        second=statistic(rows,10000,m.TARGETS[1])
+        self.assertEqual(first['lowerBoundPpm'],second['lowerBoundPpm'])
+        self.assertEqual(first['method'],second['method'])
+        self.assertNotEqual(first['guardVerifiedPpm'],second['guardVerifiedPpm'])
+
+
+if __name__=='__main__':unittest.main()
