+"""QD-5 default truth-input closure over separately admitted complete inputs.
+
+Local preimage encoding, not a product fact identity or ENV carrier. The caller
+establishes completeness of the selected snapshot and admission of toolchain,
+closure, configuration, dependency and prepared-output identities. Native set IDs retain Sha256Text sha256: prefixes; absent
+preparation retains null. A partial
+inventory cannot acquire complete standing from this hash. No narrowed closure.
+"""
+from canonical import canonical, pin, sha256
+from records import require
+from store import check_paths
+
+
+def truth_input(snapshot, *, configuration_digest, dependency_source_set_id,
+                prepared_output_set_id, resolution_environment_digest):
+    """Hash the full QD-22 blob inventory plus all QD-5 resolution inputs.
+
+    snapshot is the UTF-8-path-sorted array [path, Git mode, content SHA-256],
+    including symlinks (whose content is their literal target) and executable
+    files. Directory prefixes are implicit. Excluded pinned gitlinks have no
+    blob row in the selected QD-22 inventory. No detector output is accepted.
+    The resolution environment digest commits to the independently admitted
+    pinned toolchain and closure identities; none is inferred or fabricated.
+    CAN's byte/depth bounds apply to this local complete preimage. An oversized
+    inventory refuses; it is never truncated, sampled or replaced by witnesses.
+    """
+    require(type(snapshot) is list, 'TRI_INVENTORY_ARRAY')
+    for row in snapshot:
+        require(type(row) is list and len(row) == 3, 'TRI_INVENTORY_ROW')
+        path, mode, content = row
+        require(type(mode) is str and mode in ('100644', '100755', '120000')
+                and pin(content), 'TRI_INVENTORY_ROW')
+    check_paths([row[0] for row in snapshot])
+    require(snapshot == sorted(snapshot, key=lambda row: row[0].encode('utf-8')),
+            'TRI_INVENTORY_ORDER')
+    fields = {'configurationDigest': configuration_digest,
+              'dependencySourceSetId': dependency_source_set_id,
+              'preparedOutputSetId': prepared_output_set_id,
+              'resolutionEnvironmentDigest': resolution_environment_digest}
+    require(pin(configuration_digest) and pin(resolution_environment_digest),
+            'TRI_RESOLUTION_PIN')
+    native_pin = lambda value: type(value) is str and value.startswith('sha256:') and pin(value[7:])
+    require(native_pin(dependency_source_set_id) and
+            (prepared_output_set_id is None or native_pin(prepared_output_set_id)),
+            'TRI_NATIVE_ID')
+    preimage = dict(snapshotInventory=snapshot, **fields)
+    raw = canonical(preimage)
+    return {'truthInputDigest': sha256(raw),
+            'snapshotAdmissionEstablished': False,
+            'resolutionAdmissionEstablished': False,
+            'productQualification': False}
