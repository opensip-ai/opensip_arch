+"""Q0 r13 section 4.3 / QD-8's pure calibration arithmetic.
+
+Inputs are a caller's declared per-voter queues and independently pre-settled
+expected answers. This component neither validates source/provenance nor
+registers voters, conducts blind voting, excludes votes or requeues items.
+"""
+from canonical import canonical
+from records import require
+
+
+def _label(value):
+    require(type(value) is str and 1 <= len(value) <= 4096, "LABEL_REQUIRED")
+
+
+def evaluate_calibration(voter_id, queues):
+    """Compute calibration-result fields; insufficient coverage fails the bar.
+
+    Each local API queue has queueId, totalItems (including calibration), and
+    items. Each item has itemId, expected (true/false), and observed
+    (true/false/unclear). No expected answer is inferred from detector output.
+    Queue assignment and original size are trusted caller inputs, not evidence
+    established by this function. All declared queues must meet the 10% rate.
+    """
+    _label(voter_id)
+    require(type(queues) is list and len(queues) <= 4096, "QUEUE_ARRAY")
+    canonical({"voterId": voter_id, "queues": queues})
+    seen_queues, seen_items = set(), set()
+    n = correct = known_false = false_labelled_true = 0
+    rate_met = True
+    for queue in queues:
+        require(type(queue) is dict and set(queue) == {"queueId", "totalItems", "items"},
+                "QUEUE_SHAPE")
+        qid = queue["queueId"]
+        _label(qid)
+        require(qid not in seen_queues, "DUPLICATE_QUEUE")
+        seen_queues.add(qid)
+        size = queue["totalItems"]
+        require(type(size) is int and 0 <= size <= 2**64 - 1, "QUEUE_SIZE")
+        items = queue["items"]
+        require(type(items) is list and len(items) <= size, "CALIBRATION_ITEMS")
+        rate_met = rate_met and len(items) * 10 >= size
+        for item in items:
+            require(type(item) is dict and set(item) == {"itemId", "expected", "observed"},
+                    "CALIBRATION_ITEM_SHAPE")
+            iid = item["itemId"]
+            _label(iid)
+            require(iid not in seen_items, "DUPLICATE_CALIBRATION_ITEM")
+            seen_items.add(iid)
+            expected, observed = item["expected"], item["observed"]
+            require(type(expected) is str and expected in {"true", "false"},
+                    "KNOWN_ANSWER_REQUIRED")
+            require(type(observed) is str and observed in {"true", "false", "unclear"},
+                    "OBSERVED_LABEL_REQUIRED")
+            n += 1
+            correct += observed == expected
+            known_false += expected == "false"
+            false_labelled_true += expected == "false" and observed == "true"
+    return {"voterId": voter_id, "items": n, "correct": correct,
+            "knownFalseLabelledTrue": false_labelled_true,
+            "passed": rate_met and n >= 5 and known_false >= 2 and
+                      correct * 10 >= 9 * n and false_labelled_true == 0}
