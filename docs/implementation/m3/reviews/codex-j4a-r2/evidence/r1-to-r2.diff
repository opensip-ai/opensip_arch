+#[cfg(target_os = "macos")]
+fn read_back_capped(file: &std::fs::File, buffer: &mut [u8]) -> std::io::Result<Option<usize>> {
+    use std::os::unix::fs::FileExt;
+    let mut filled = 0;
+    for _ in 0..SUFFIX_READBACK_CALLS {
+        if filled == buffer.len() {
+            return Ok(None);
+        }
+        match file.read_at(&mut buffer[filled..], filled as u64)? {
+            0 => return Ok(Some(filled)),
+            read => filled += read,
+        }
+    }
+    Ok(None)
