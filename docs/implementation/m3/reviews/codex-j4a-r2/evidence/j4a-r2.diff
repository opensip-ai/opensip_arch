+/// Why C-SUFFIX stopped. The file only ever holds a prefix of the owner's
+/// bytes, or all of them; nothing is truncated or removed.
+#[cfg(target_os = "macos")]
+#[derive(Debug)]
+pub(crate) enum SuffixError {
+    /// C-ACL, when the ACL was omitted.
+    Private(PreparePrivateError),
+    /// The suffix write, its early read-back or its file barrier.
+    Write(opensip_platform::NewRegularWriteError),
+    /// The parent's directory barrier.
+    Barrier(std::io::Error),
+    /// After both barriers, the name no longer opens the written file, or
+    /// the capped read-back through it is not exactly the owner's bytes
+    /// followed by the end.
+    Confirm,
+    /// The reopen, a status read or the final read-back failed.
+    ConfirmIo(std::io::Error),
+}
+
+/// The final read-back's positioned read calls. A regular file returns its
+/// bytes and then the end in two; a read that has not reached the end by the
+/// last call refuses.
+#[cfg(target_os = "macos")]
+const SUFFIX_READBACK_CALLS: usize = 4;
+
+/// The final read-back's work: one buffer of the owner's length plus one
+/// byte, and `SUFFIX_READBACK_CALLS` positioned reads into it.
+#[cfg(target_os = "macos")]
+fn suffix_readback_cost(expected: usize) -> Option<opensip_platform::WorkCost> {
+    Some(opensip_platform::WorkCost {
+        objects: 1,
+        edges: SUFFIX_READBACK_CALLS,
+        bytes: expected.checked_add(1)?,
+    })
+}
+
+/// C-SUFFIX's whole cost after the judgment: C-ACL's sample, append and
+/// sample when the ACL was omitted; the suffix write with its early
+/// read-back and file barrier; the parent's directory barrier; the no-follow
+/// reopen of the name with the two status reads that compare it to the
+/// written file; and the final capped read-back through it.
+#[cfg(target_os = "macos")]
+fn suffix_cost(
+    name: &str,
+    expected: usize,
+    existing: usize,
+    acl_omitted: bool,
+) -> Option<opensip_platform::WorkCost> {
+    let acl = if acl_omitted {
+        opensip_platform::descriptor_acl_capture_cost()
+            .checked_add(opensip_platform::append_owner_zero_allow_cost())?
+            .checked_add(opensip_platform::descriptor_acl_capture_cost())?
+    } else {
+        opensip_platform::WorkCost::default()
+    };
+    acl.checked_add(opensip_platform::write_regular_suffix_cost(
+        expected, existing,
+    ))?
+    .checked_add(opensip_platform::directory_barrier_cost())?
+    .checked_add(opensip_platform::RetainedDirectory::open_regular_cost(name))?
+    .checked_add(status_read_cost())?
+    .checked_add(status_read_cost())?
+    .checked_add(suffix_readback_cost(expected)?)
+}
+
+/// The final read-back (J-RW r4 item 3.2): positioned reads from offset zero
+/// into `buffer` (the owner's length plus one byte), at most
+/// `SUFFIX_READBACK_CALLS`, stopping at the end or a full buffer. `Some(n)`
+/// is the length read when the end was reached within the cap; `None` is a
+/// full buffer, or calls exhausted before the end.
+#[cfg(target_os = "macos")]
+fn read_back_capped(file: &std::fs::File, buffer: &mut [u8]) -> std::io::Result<Option<usize>> {
+    use std::os::unix::fs::FileExt;
+    let mut filled = 0;
+    for _ in 0..SUFFIX_READBACK_CALLS {
+        if filled == buffer.len() {
+            return Ok(None);
+        }
+        match file.read_at(&mut buffer[filled..], filled as u64)? {
+            0 => return Ok(Some(filled)),
+            read => filled += read,
+        }
+    }
+    Ok(None)
+}
+
+/// C-SUFFIX (J-RW r4 item 3.2; unit J4a): finish an interrupted write in
+/// place. Its whole cost, the final confirmation included, is reserved
+/// before the first effect. C-ACL runs first when the ACL was omitted. Then,
+/// in the law's order:
+/// 1. only the missing suffix is written, at offset = the existing length
+///    (the platform write also reads every byte back through the judged
+///    handle before its barrier);
+/// 2. the file barrier (`F_FULLFSYNC`);
+/// 3. the parent's directory barrier;
+/// 4. a no-follow reopen of `name`, whose device and inode must be the
+///    written file's, and through it an exact-length capped read-back: at
+///    most `expected.len() + 1` bytes from offset zero, which must be
+///    exactly `expected` followed by the end.
+///
+/// No existing byte is rewritten, and nothing is truncated or removed. The
+/// caller runs it inside its owner's `.repair` scope (item 10).
+#[cfg(target_os = "macos")]
+pub(crate) fn complete_private_suffix(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &str,
+    prefix: SuffixPrefix<'_>,
+    expected: &[u8],
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<(), opensip_platform::WorkFailure<SuffixError>> {
+    complete_private_suffix_with(
+        parent,
+        name,
+        prefix,
+        expected,
+        invoking_uid,
+        work,
+        read_back_capped,
+    )
+}
+
+// Private seam: `read_back` is `read_back_capped` in production; tests
+// change the file or fail the read at the confirmation point, after both
+// barriers.
+#[cfg(target_os = "macos")]
+fn complete_private_suffix_with(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &str,
+    prefix: SuffixPrefix<'_>,
+    expected: &[u8],
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+    read_back: impl FnOnce(&std::fs::File, &mut [u8]) -> std::io::Result<Option<usize>>,
+) -> Result<(), opensip_platform::WorkFailure<SuffixError>> {
+    use opensip_platform::{WorkBudgetError, WorkCost, WorkFailure};
+    use std::os::unix::fs::MetadataExt;
+    let SuffixPrefix {
+        file,
+        existing,
+        acl_omitted,
+    } = prefix;
+    fn lifted<E>(
+        error: WorkFailure<E>,
+        map: impl FnOnce(E) -> SuffixError,
+    ) -> WorkFailure<SuffixError> {
+        match error {
+            WorkFailure::Budget(budget) => WorkFailure::Budget(budget),
+            WorkFailure::Operation(error) => WorkFailure::Operation(map(error)),
+        }
+    }
+    let confirm_io = |error| WorkFailure::Operation(SuffixError::ConfirmIo(error));
+    let reserve = suffix_cost(name, expected.len(), existing, acl_omitted)
+        .ok_or(WorkFailure::Budget(WorkBudgetError::Arithmetic))?;
+    let readback = suffix_readback_cost(expected.len())
+        .ok_or(WorkFailure::Budget(WorkBudgetError::Arithmetic))?;
+    work.effect(WorkCost::default(), reserve, |post| {
+        if acl_omitted {
+            prepare_fresh_private_sample_reserved(
+                PrivateObjectKind::RegularFile,
+                invoking_uid,
+                file,
+                post,
+            )
+            .map_err(|error| lifted(error, SuffixError::Private))?;
+        }
+        // Steps 1 and 2: the suffix, then `F_FULLFSYNC`.
+        opensip_platform::write_regular_suffix_reserved(file, expected, existing, post)
+            .map_err(|error| lifted(error, SuffixError::Write))?;
+        // Step 3: the parent's barrier.
+        parent
+            .confirm_directory_barrier_reserved(post)
+            .map_err(|error| lifted(error, SuffixError::Barrier))?;
+        // Step 4: the same object by name, then its bytes and its end.
+        post.spend(opensip_platform::RetainedDirectory::open_regular_cost(name))?;
+        let reopened = parent.open_regular(name).map_err(confirm_io)?;
+        post.spend(status_read_cost())?;
+        post.spend(status_read_cost())?;
+        let (held, named) = (
+            file.metadata().map_err(confirm_io)?,
+            reopened.metadata().map_err(confirm_io)?,
+        );
+        if held.dev() != named.dev() || held.ino() != named.ino() {
+            return Err(WorkFailure::Operation(SuffixError::Confirm));
+        }
+        post.spend(readback)?;
+        let mut buffer = vec![0u8; readback.bytes];
+        match read_back(&reopened, &mut buffer).map_err(confirm_io)? {
+            Some(read) if read == expected.len() && buffer[..read] == *expected => Ok(()),
+            _ => Err(WorkFailure::Operation(SuffixError::Confirm)),
+        }
+    })
+}
