+    let before = (f.floors_identity(), f.floors_names());
+    assert_eq!(refusal(f.completing()).row(), CarrierRow::HostIo);
+    unchanged(&f, &before);
+    // A mode other than exactly `0700`.
+    let f = Fixture::new();
+    f.crashed_floors();
+    fs::set_permissions(f.floors(), fs::Permissions::from_mode(0o750)).unwrap();
+    let before = (f.floors_identity(), f.floors_names());
+    assert_eq!(refusal(f.completing()).row(), CarrierRow::HostIo);
+    unchanged(&f, &before);
+    // A busy `writer.lease`: skipped, nothing read, written or completed.
+    let f = Fixture::new();
+    f.crashed_floors();
+    let before = (f.floors_identity(), f.floors_names());
+    let held = FileLock::try_acquire(
+        File::options()
+            .read(true)
+            .write(true)
+            .open(f.namespace_path.join("writer.lease"))
+            .unwrap(),
+        LockMode::Exclusive,
+    )
+    .unwrap()
+    .unwrap();
+    let skipped = f.completing().unwrap();
+    assert_eq!(
+        (skipped.outcome, skipped.observed, skipped.completion),
+        (FloorStepOutcome::Skipped, None, None)
+    );
+    unchanged(&f, &before);
+    drop(held);
+    // A format-2 carrier is refused by classification before the judgment.
+    let f = Fixture::new();
+    f.crashed_floors();
+    let c = rusqlite::Connection::open(f.carrier()).unwrap();
+    let _: String = c
+        .query_row("PRAGMA journal_mode=WAL", [], |r| r.get(0))
+        .unwrap();
+    c.execute_batch(super::super::inherited_schema::DDL2)
+        .unwrap();
+    drop(c);
+    let before = (f.floors_identity(), f.floors_names());
+    assert_eq!(refusal(f.completing()).row(), CarrierRow::InheritedCarrier);
+    unchanged(&f, &before);
+}
+
+// RW-C12: a ledger that covers the judgment but not C-ACL's reservation
+// refuses on the budget row before the append.
+#[test]
+fn an_unreservable_carrier_floors_completion_writes_nothing() {
+    let admit = |f: &Fixture, work: &mut WorkLedger| {
+        let floors =
+            RetainedDirectory::from_retained_handle(File::open(f.floors()).unwrap()).unwrap();
+        work.scope(|w| admit_floor_directory(&f.location(), &floors, w))
+    };
+    let measured = Fixture::new();
+    measured.crashed_floors();
+    let mut work = WorkLedger::new();
+    assert_eq!(
+        admit(&measured, &mut work).unwrap(),
+        Some(RepairCompletion::CarrierFloors)
+    );
+    let barrier = opensip_platform::directory_barrier_cost();
+    let tail = opensip_platform::descriptor_name_observation_cost()
+        .checked_add(barrier)
+        .and_then(|c| c.checked_add(barrier))
+        .unwrap();
+    let used = work.used();
+    let f = Fixture::new();
+    f.crashed_floors();
+    let mut short = WorkLedger::with_limits(WorkCost {
+        edges: used.edges - tail.edges - 1,
+        ..used
+    })
+    .unwrap();
+    let result = admit(&f, &mut short);
+    assert!(matches!(result, Err(WorkFailure::Budget(_))), "{result:?}");
+    assert_eq!(
+        f.floors_acl().0,
+        opensip_platform::CapturedAclState::NotReturned
+    );
+}
