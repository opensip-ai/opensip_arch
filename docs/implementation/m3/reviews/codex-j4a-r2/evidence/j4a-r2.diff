+/// The floor step's judgment of an existing `trust/carrier-floors/` (law X3b
+/// r11 item 2; J-RW r4's RW-P3; unit J4a). A directory judged private is
+/// admitted as it stands. One whose ACL is omitted and that holds every
+/// P-ACL clause (J-RW r4 item 3.1: its fixed name, `trust`'s filesystem, the
+/// invoking user, mode exactly `0700`, empty by one bounded scan), judged
+/// before any effect, is completed by C-ACL; then the owner's remaining
+/// steps run: the exact name, the filesystem, its own barrier and `trust`'s,
+/// all in `x3b.floor.directory.repair` (J-RW item 10). Every other state
+/// keeps the host I/O row and is never changed.
+fn admit_floor_directory(
+    location: &CarrierLocation<'_>,
+    floors: &RetainedDirectory,
+    work: &mut WorkScope<'_>,
+) -> Refused<Option<RepairCompletion>> {
+    let prefix = match judge_private_directory_creation(
+        location.trust,
+        OsStr::new(FLOORS_NAME),
+        floors,
+        location.uid,
+        work,
+    )
+    .map_err(lift(CarrierRefusal::Private))?
+    {
+        CreationJudgment::Private(_) => return Ok(None),
+        CreationJudgment::Prefix(prefix) => prefix,
+    };
+    let changed = || {
+        WorkFailure::Operation(CarrierRefusal::Io(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "trust/carrier-floors changed during its completion",
+        )))
+    };
+    let barrier = lift(|e| CarrierRefusal::Create(CreationStep::DirectoryBarrier(e)));
+    opensip_platform::crash_scope!("directory", {
+        opensip_platform::crash_scope!("repair", {
+            complete_private_creation(prefix, location.uid, work)
+                .map_err(lift(CarrierRefusal::Private))?;
+            if !opensip_platform::descriptor_name_matches_accounted(
+                floors.as_file(),
+                OsStr::new(FLOORS_NAME),
+                work,
+            )
+            .map_err(lift(CarrierRefusal::Io))?
+            {
+                return Err(changed());
+            }
+            let device = |file: &File| file.metadata().map(|m| m.dev());
+            if device(floors.as_file())
+                .map_err(|e| WorkFailure::Operation(CarrierRefusal::Io(e)))?
+                != device(location.trust.as_file())
+                    .map_err(|e| WorkFailure::Operation(CarrierRefusal::Io(e)))?
+            {
+                return Err(changed());
+            }
+            floors
+                .confirm_directory_barrier_accounted(work)
+                .map_err(barrier)?;
+            location
+                .trust
+                .confirm_directory_barrier_accounted(work)
+                .map_err(lift(|e| {
+                    CarrierRefusal::Create(CreationStep::DirectoryBarrier(e))
+                }))?;
+            Ok(Some(RepairCompletion::CarrierFloors))
+        })
+    })
+}
