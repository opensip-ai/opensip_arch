+) -> Result<FileBarrierReceipt<'file>, WorkFailure<NewRegularWriteError>> {
+    work.run(write_regular_suffix_cost(bytes.len(), existing), |_| {
+        write_regular_suffix_charged(file, bytes, existing, native_file_barrier)
+            .map_err(WorkFailure::Operation)
+    })
