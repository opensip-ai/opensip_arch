+
+// ---------------------------------------------------------------- J4a
+// Law X3c r9 item 12a (J-RW r4's RW-C1 to RW-C3 and RW-C6 for RW-P1 and
+// RW-P2; unit J4a): each crash state is made by the owner's own exclusive
+// create, stopped before its owner allow, under the same fixture and lease.
+
+/// The owner's `mkdirat 0700` of `name`, killed before its owner allow.
+fn crashed_directory(parent: &RetainedDirectory, name: &str) {
+    let made = WorkLedger::new()
+        .scope(|w| parent.create_exclusive_directory_accounted(name, w))
+        .unwrap();
+    assert!(matches!(
+        made,
+        opensip_platform::ExclusiveDirectoryOutcome::Created(_)
+    ));
+}
+/// The owner's exclusive `0600` create of `name`, killed before its allow.
+fn crashed_file(parent: &RetainedDirectory, name: &str) {
+    let made = WorkLedger::new()
+        .scope(|w| parent.create_exclusive_regular_accounted(name, w))
+        .unwrap();
+    assert!(matches!(
+        made,
+        opensip_platform::ExclusiveRegularOutcome::Created(_)
+    ));
+}
+fn retained(path: &Path) -> RetainedDirectory {
+    RetainedDirectory::from_retained_handle(fs::File::open(path).unwrap()).unwrap()
+}
+fn acl_state(path: &Path) -> opensip_platform::CapturedAclState {
+    let file = fs::File::open(path).unwrap();
+    WorkLedger::new()
+        .scope(|w| opensip_platform::capture_descriptor_acl_accounted(&file, w))
+        .unwrap()
+        .acl_state()
+}
+/// Exactly the fresh path's ACL: one zero-rights allow for the user.
+fn fresh_acl(path: &Path, uid: u32) -> bool {
+    let file = fs::File::open(path).unwrap();
+    let sample = WorkLedger::new()
+        .scope(|w| opensip_platform::capture_descriptor_acl_accounted(&file, w))
+        .unwrap();
+    sample.acl_state() == opensip_platform::CapturedAclState::Entries(1)
+        && sample.entry(0).is_some_and(|entry| {
+            entry.rights == 0
+                && entry.principal == opensip_platform::CapturedAclPrincipal::User(uid)
+        })
+}
+/// Every name under `stores/S`, with its kind, permission bits and whether
+/// its ACL is exactly the fresh path's.
+fn layout_tree(s: &Scratch) -> Vec<(PathBuf, bool, u32, bool)> {
+    fn walk(s: &Scratch, dir: &Path, out: &mut Vec<(PathBuf, bool, u32, bool)>) {
+        for entry in fs::read_dir(dir).unwrap() {
+            let path = entry.unwrap().path();
+            let m = fs::symlink_metadata(&path).unwrap();
+            out.push((
+                path.strip_prefix(&s.store_path).unwrap().to_owned(),
+                m.is_dir(),
+                m.permissions().mode() & 0o7777,
+                fresh_acl(&path, s.uid),
+            ));
+            if m.is_dir() {
+                walk(s, &path, out);
+            }
+        }
+    }
+    let mut out = Vec::new();
+    walk(s, &s.store_path, &mut out);
+    out.sort();
+    out
+}
+type Dispositions = (
+    (StoreDirectoryDisposition, StoreDirectoryDisposition),
+    (StoreDirectoryDisposition, StoreDirectoryDisposition),
+    LedgerDisposition,
+    Option<RepairCompletion>,
+);
+/// `admit_layout`'s three X3c-1 steps, as `prepare_commit` runs them.
+fn layout(s: &Scratch, work: &mut WorkLedger) -> Dispositions {
+    let location = s.location();
+    let namespace = operation(work, |w| admit_namespace_directory(&location, w)).unwrap();
+    let objects = operation(work, |w| admit_object_directory(&location, &namespace, w)).unwrap();
+    let ledger = operation(work, |w| create_or_open_ledger(&location, &namespace, w)).unwrap();
+    (
+        namespace.dispositions(),
+        objects.dispositions(),
+        ledger.disposition(),
+        ledger.completion(),
+    )
+}
+fn identity(path: &Path) -> (u64, u64, u32) {
+    let m = fs::symlink_metadata(path).unwrap();
+    (m.dev(), m.ino(), m.mode())
+}
+
+// RW-C1 and RW-C3 for RW-P1, at each of the four store directories: the
+// owner's step completes the crashed directory, and the layout it reaches
+// is exactly a fresh layout's, names, modes and ACLs alike. A second
+// request completes nothing.
+#[test]
+fn each_crashed_store_directory_completes_to_the_fresh_layout() {
+    use StoreDirectoryDisposition::{Admitted as A, Completed as C, Created as F};
+    let control = Scratch::new();
+    assert_eq!(
+        layout(&control, &mut WorkLedger::new()),
+        ((F, F), (F, F), LedgerDisposition::Created, None)
+    );
+    let fresh = layout_tree(&control);
+    for (target, expected) in [
+        ("projects", ((C, F), (F, F))),
+        ("namespace", ((A, C), (F, F))),
+        ("objects", ((A, A), (C, F))),
+        ("sha256", ((A, A), (A, C))),
+    ] {
+        let s = Scratch::new();
+        let location = s.location();
+        let mut work = WorkLedger::new();
+        let projects = s.store_path.join("projects");
+        let crashed = match target {
+            "projects" => {
+                crashed_directory(&s.store, "projects");
+                projects
+            }
+            "namespace" => {
+                operation(&mut work, |w| {
+                    create_or_admit_store_directory(&s.store, "projects", s.uid, w).map_err(custody)
+                })
+                .unwrap();
+                crashed_directory(&retained(&projects), N);
+                s.namespace_path()
+            }
+            _ => {
+                let namespace =
+                    operation(&mut work, |w| admit_namespace_directory(&location, w)).unwrap();
+                let objects = s.namespace_path().join("objects");
+                if target == "objects" {
+                    crashed_directory(&namespace.directory, "objects");
+                    objects
+                } else {
+                    operation(&mut work, |w| {
+                        create_or_admit_store_directory(&namespace.directory, "objects", s.uid, w)
+                            .map_err(custody)
+                    })
+                    .unwrap();
+                    crashed_directory(&retained(&objects), "sha256");
+                    objects.join("sha256")
+                }
+            }
+        };
+        assert_eq!(
+            acl_state(&crashed),
+            opensip_platform::CapturedAclState::NotReturned
+        );
+        let before = identity(&crashed);
+        let (namespace, objects, ledger, file) = layout(&s, &mut work);
+        assert_eq!((namespace, objects), expected, "{target}");
+        let completed = [namespace.0, namespace.1, objects.0, objects.1]
+            .into_iter()
+            .filter_map(StoreDirectoryDisposition::completion)
+            .collect::<Vec<_>>();
+        assert_eq!(completed, [RepairCompletion::StoreDirectory], "{target}");
+        assert_eq!(
+            (ledger, file),
+            (LedgerDisposition::Created, None),
+            "{target}"
+        );
+        assert_eq!(identity(&crashed), before, "{target}");
+        assert_eq!(layout_tree(&s), fresh, "{target}");
+        assert_eq!(
+            layout(&s, &mut WorkLedger::new()),
+            ((A, A), (A, A), LedgerDisposition::Existing, None),
+            "{target}"
+        );
+        assert_eq!(layout_tree(&s), fresh, "{target}");
+        assert!(!work.is_failed());
+    }
+}
+
+// RW-C1 and RW-C3 for RW-P2: the crashed length-0 ledger is completed by
+// C-ACL, then X3c item 2's resumable-empty path commits the selected schema
+// in the same file; a second request admits it and completes nothing.
+#[test]
+fn a_crashed_ledger_file_completes_to_the_selected_schema() {
+    let s = Scratch::new();
+    let location = s.location();
+    let mut work = WorkLedger::new();
+    let namespace = operation(&mut work, |w| admit_namespace_directory(&location, w)).unwrap();
+    crashed_file(&namespace.directory, "ledger.sqlite");
+    let path = s.namespace_path().join("ledger.sqlite");
+    assert_eq!(
+        acl_state(&path),
+        opensip_platform::CapturedAclState::NotReturned
+    );
+    let before = identity(&path);
+    let ledger = operation(&mut work, |w| {
+        create_or_open_ledger(&location, &namespace, w)
+    })
+    .unwrap();
+    assert_eq!(ledger.disposition(), LedgerDisposition::Resumed);
+    assert_eq!(ledger.completion(), Some(RepairCompletion::LedgerFile));
+    assert!(verify_selected_schema(&open_existing(&path, true).unwrap()).unwrap());
+    let after = identity(&path);
+    assert_eq!((after.0, after.1, after.2), (before.0, before.1, before.2));
+    assert!(fresh_acl(&path, s.uid));
+    drop(ledger);
+    let again = operation(&mut work, |w| {
+        create_or_open_ledger(&location, &namespace, w)
+    })
+    .unwrap();
+    assert_eq!(again.disposition(), LedgerDisposition::Existing);
+    assert_eq!(again.completion(), None);
+    assert!(!work.is_failed());
+}
+
+// RW-C2 for RW-P1's and RW-P2's neighbours (N-P1, and RW-P2 with a `-wal`
+// beside it): each ends on today's row and subject, with nothing changed.
+#[test]
+fn the_store_states_neighbours_keep_their_rows_and_are_unchanged() {
+    // N-P1: a non-empty `objects/` whose ACL is omitted (RW-N6's state).
+    let s = Scratch::new();
+    let location = s.location();
+    let mut work = WorkLedger::new();
+    let namespace = operation(&mut work, |w| admit_namespace_directory(&location, w)).unwrap();
+    crashed_directory(&namespace.directory, "objects");
+    let objects = s.namespace_path().join("objects");
+    fs::write(objects.join("stray"), b"kept").unwrap();
+    assert_eq!(
+        row(operation(&mut WorkLedger::new(), |w| {
+            admit_object_directory(&location, &namespace, w)
+        })),
+        ProjectLedgerRow::Custody("private")
+    );
+    assert_eq!(
+        acl_state(&objects),
+        opensip_platform::CapturedAclState::NotReturned
+    );
+    assert_eq!(fs::read(objects.join("stray")).unwrap(), b"kept");
+    assert!(!objects.join("sha256").exists());
+    // N-P1: a crashed `projects/` whose mode is no longer exactly `0700`.
+    let s = Scratch::new();
+    crashed_directory(&s.store, "projects");
+    let projects = s.store_path.join("projects");
+    fs::set_permissions(&projects, fs::Permissions::from_mode(0o750)).unwrap();
+    let location = s.location();
+    assert_eq!(
+        row(operation(&mut WorkLedger::new(), |w| {
+            admit_namespace_directory(&location, w)
+        })),
+        ProjectLedgerRow::Custody("private")
+    );
+    assert_eq!(
+        acl_state(&projects),
+        opensip_platform::CapturedAclState::NotReturned
+    );
+    assert!(!projects.join(N).exists());
+    // RW-P2's neighbours: a `-wal` beside it, a byte in it, a second link.
+    for case in ["wal", "byte", "link"] {
+        let s = Scratch::new();
+        let location = s.location();
+        let mut work = WorkLedger::new();
+        let namespace = operation(&mut work, |w| admit_namespace_directory(&location, w)).unwrap();
+        crashed_file(&namespace.directory, "ledger.sqlite");
+        let path = s.namespace_path().join("ledger.sqlite");
+        match case {
+            "wal" => fs::write(s.namespace_path().join("ledger.sqlite-wal"), b"").unwrap(),
+            "byte" => fs::write(&path, b"x").unwrap(),
+            _ => fs::hard_link(&path, s.namespace_path().join("second")).unwrap(),
+        }
+        let before = (identity(&path), fs::read(&path).unwrap());
+        assert_eq!(
+            row(operation(&mut work, |w| create_or_open_ledger(
+                &location, &namespace, w
+            ))),
+            ProjectLedgerRow::Custody("private"),
+            "{case}"
+        );
+        assert_eq!(
+            acl_state(&path),
+            opensip_platform::CapturedAclState::NotReturned,
+            "{case}"
+        );
+        assert_eq!(
+            (identity(&path), fs::read(&path).unwrap()),
+            before,
+            "{case}"
+        );
+    }
+}
