+/// J-RW r4 item 7's operational record of one completion: its closed `kind`
+/// code and its item 4 state. `host.repair.completed` is O1's: until O1
+/// lands no event is emitted, and each owner returns this value in its typed
+/// result only (unit J4a's uses; J4b to J4d add theirs).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RepairCompletion {
+    /// RW-P1: an X3c store directory (`projects`, `projects/N`, `objects`,
+    /// `objects/sha256`) completed by C-ACL.
+    StoreDirectory,
+    /// RW-P2: the length-0 `ledger.sqlite` completed by C-ACL.
+    LedgerFile,
+    /// RW-P3: `trust/carrier-floors/` completed by C-ACL.
+    CarrierFloors,
+}
+impl RepairCompletion {
+    /// Item 7's closed `kind` code.
+    pub fn kind(self) -> &'static str {
+        match self {
+            Self::StoreDirectory => "store-directory",
+            Self::LedgerFile => "ledger-file",
+            Self::CarrierFloors => "carrier-floors",
+        }
+    }
+    /// Item 4's state ID.
+    pub fn state(self) -> &'static str {
+        match self {
+            Self::StoreDirectory => "RW-P1",
+            Self::LedgerFile => "RW-P2",
+            Self::CarrierFloors => "RW-P3",
+        }
+    }
+}
+
+/// P-ACL's clauses 2 and 3 (J-RW r4 item 3.1) on one sample: the ACL is
+/// omitted (`NotReturned`; a NOACL sentinel or present ACL is not omission)
+/// and the object has the fresh path's private shape (owner, exact mode, one
+/// link for a file).
+fn omitted_private_shape(
+    kind: PrivateObjectKind,
+    invoking_uid: u32,
+    metadata: &DescriptorMetadata,
+    state: CapturedAclState,
+) -> bool {
+    state == CapturedAclState::NotReturned && private_shape(kind, invoking_uid, metadata).is_ok()
+}
+
+/// The P-ACL judgment of an existing object, taken before any effect.
+pub(crate) enum CreationJudgment<'f> {
+    /// Judged private as it stands: the owner's ordinary admission, with
+    /// exactly the observation it takes today. Nothing is completed.
+    Private(Box<DescriptorAclCapture>),
+    /// P-ACL holds: the object is exactly the crash prefix of a fresh private
+    /// creation. Only `complete_private_creation` consumes it.
+    Prefix(CreationPrefix<'f>),
+}
+
+/// Proof that P-ACL held for the judged handle. Not Clone; made only by the
+/// judgments here.
+pub(crate) struct CreationPrefix<'f> {
+    object: &'f std::fs::File,
+    kind: PrivateObjectKind,
+}
+
+/// The refusal an ACL-omitted object took before J-RW: an omitted ACL is not
+/// privacy. Every state that is not exactly P-ACL's keeps it.
+#[cfg(target_os = "macos")]
+fn omitted<T>() -> Result<T, opensip_platform::WorkFailure<PreparePrivateError>> {
+    Err(opensip_platform::WorkFailure::Operation(
+        PreparePrivateError::Access(PrivateAccessRefusal::AclNotReturned),
+    ))
+}
+
+/// Run one charged native observation for a P-ACL clause. A budget refusal
+/// stays the budget row. A native failure only leaves the clause unproven,
+/// so it is `None` and the object keeps its existing refusal.
+#[cfg(target_os = "macos")]
+fn observed<T>(
+    work: &mut opensip_platform::WorkScope<'_>,
+    cost: opensip_platform::WorkCost,
+    observe: impl FnOnce() -> Option<T>,
+) -> Result<Option<T>, opensip_platform::WorkFailure<PreparePrivateError>> {
+    work.run(cost, |_| Ok(observe()))
+}
+
+/// One status read of the parent, for clause 1's filesystem.
+#[cfg(target_os = "macos")]
+fn status_read_cost() -> opensip_platform::WorkCost {
+    opensip_platform::WorkCost {
+        objects: 0,
+        edges: 1,
+        bytes: std::mem::size_of::<std::fs::Metadata>(),
+    }
+}
+
+/// The bounded empty-directory scan: its `openat(".")` stream, the union
+/// mount check, `fdopendir`, at most three entries (`.`, `..`, and the read
+/// that ends the stream or finds another entry) and `closedir`.
+#[cfg(target_os = "macos")]
+fn empty_scan_cost() -> opensip_platform::WorkCost {
+    opensip_platform::WorkCost {
+        objects: 2,
+        edges: 7,
+        bytes: EMPTY_SCAN_NAME_BYTES,
+    }
+}
+/// The name bytes the empty scan admits before it stops.
+#[cfg(target_os = "macos")]
+const EMPTY_SCAN_NAME_BYTES: usize = 3 * 256;
+
+/// P-ACL clause 1 (J-RW r4 item 3.1): the object is at the owner's fixed
+/// `name` and on its parent's filesystem. Charged before it runs.
+#[cfg(target_os = "macos")]
+fn at_fixed_name(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &std::ffi::OsStr,
+    object: &std::fs::File,
+    metadata: &DescriptorMetadata,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<bool, opensip_platform::WorkFailure<PreparePrivateError>> {
+    use std::os::unix::fs::MetadataExt;
+    let parent_device = observed(work, status_read_cost(), || {
+        parent.as_file().metadata().ok().map(|m| m.dev())
+    })?;
+    if parent_device != Some(metadata.device) {
+        return Ok(false);
+    }
+    match opensip_platform::descriptor_name_matches_accounted(object, name, work) {
+        Ok(bound) => Ok(bound),
+        Err(opensip_platform::WorkFailure::Budget(budget)) => {
+            Err(opensip_platform::WorkFailure::Budget(budget))
+        }
+        Err(opensip_platform::WorkFailure::Operation(_)) => Ok(false),
+    }
+}
+
+/// C-ACL's predicate P-ACL over an existing directory (J-RW r4 item 3.1;
+/// unit J4a), judged through the owner's retained `parent`, no-follow,
+/// charged, and before any effect:
+/// 1. at its fixed `name` and on its parent's filesystem;
+/// 2. owned by the invoking user, mode exactly `0700`;
+/// 3. its ACL omitted;
+/// 4. no entry but `.` and `..`, by one bounded scan.
+///
+/// The first sample is exactly `observe_private_directory`'s, so a directory
+/// judged private, or refused for any reason but an omitted ACL, ends exactly
+/// as it does there. An omitted ACL that fails any other clause keeps its
+/// existing refusal. Nothing here writes.
+#[cfg(target_os = "macos")]
+pub(crate) fn judge_private_directory_creation<'f>(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &std::ffi::OsStr,
+    directory: &'f opensip_platform::RetainedDirectory,
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<CreationJudgment<'f>, opensip_platform::WorkFailure<PreparePrivateError>> {
+    let kind = PrivateObjectKind::Directory;
+    let sample = match judge_or_omitted(kind, invoking_uid, directory.as_file(), work)? {
+        Judged::Private(sample) => return Ok(CreationJudgment::Private(Box::new(sample))),
+        Judged::Omitted(sample) => sample,
+    };
+    if !omitted_private_shape(kind, invoking_uid, sample.metadata(), sample.acl_state())
+        || !at_fixed_name(parent, name, directory.as_file(), sample.metadata(), work)?
+    {
+        return omitted();
+    }
+    let empty = observed(work, empty_scan_cost(), || {
+        directory
+            .visit_entry_names(3, EMPTY_SCAN_NAME_BYTES, |entry| {
+                if entry == b"." || entry == b".." {
+                    Ok(())
+                } else {
+                    Err(())
+                }
+            })
+            .ok()
+    })?;
+    if empty.is_none() {
+        return omitted();
+    }
+    Ok(CreationJudgment::Prefix(CreationPrefix {
+        object: directory.as_file(),
+        kind,
+    }))
+}
+
+/// C-ACL's predicate P-ACL over an existing regular file (J-RW r4 item
+/// 3.1; unit J4a), as for a directory, with clauses 2 and 4 read for a file:
+/// mode exactly `0600` and one link, and length 0. The first sample is
+/// exactly the private-file judgment's. A file that must instead hold a
+/// strict prefix of the owner's bytes (item 3.2's targets) is judged by
+/// `judge_private_prefix`, whose completion runs C-ACL first.
+#[cfg(target_os = "macos")]
+pub(crate) fn judge_private_file_creation<'f>(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &std::ffi::OsStr,
+    file: &'f std::fs::File,
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<CreationJudgment<'f>, opensip_platform::WorkFailure<PreparePrivateError>> {
+    let kind = PrivateObjectKind::RegularFile;
+    let sample = match judge_or_omitted(kind, invoking_uid, file, work)? {
+        Judged::Private(sample) => return Ok(CreationJudgment::Private(Box::new(sample))),
+        Judged::Omitted(sample) => sample,
+    };
+    if !omitted_private_shape(kind, invoking_uid, sample.metadata(), sample.acl_state())
+        || !at_fixed_name(parent, name, file, sample.metadata(), work)?
+    {
+        return omitted();
+    }
+    if sample.metadata().size != 0 {
+        return omitted();
+    }
+    Ok(CreationJudgment::Prefix(CreationPrefix {
+        object: file,
+        kind,
+    }))
+}
+
+#[cfg(target_os = "macos")]
+enum Judged {
+    Private(DescriptorAclCapture),
+    Omitted(DescriptorAclCapture),
+}
+/// The ordinary private judgment's one sample: private, the omitted ACL
+/// that P-ACL may complete, or the existing refusal.
+#[cfg(target_os = "macos")]
+fn judge_or_omitted(
+    kind: PrivateObjectKind,
+    invoking_uid: u32,
+    object: &std::fs::File,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<Judged, opensip_platform::WorkFailure<PreparePrivateError>> {
+    let sample =
+        opensip_platform::capture_descriptor_acl_accounted(object, work).map_err(lift_capture)?;
+    match assess_private_descendant_capture(kind, invoking_uid, &sample) {
+        Ok(()) => Ok(Judged::Private(sample)),
+        Err(PrivateAccessRefusal::AclNotReturned) => Ok(Judged::Omitted(sample)),
+        Err(refusal) => Err(opensip_platform::WorkFailure::Operation(
+            PreparePrivateError::Access(refusal),
+        )),
+    }
+}
+
+/// C-ACL (J-RW r4 item 3.1; unit J4a): append exactly one zero-rights owner
+/// allow and sample again, through the fresh path's own step
+/// (`prepare_fresh_private_sample`), with its sample, append and sample
+/// reserved before the append, as that step reserves them. The new sample
+/// must judge private, or the object refuses; the allow stays, as on the
+/// fresh path. No mode bit, other ACE, name or byte changes. The caller runs
+/// it, and the owner's remaining steps, inside its `.repair` scope (item 10).
+#[cfg(target_os = "macos")]
+pub(crate) fn complete_private_creation(
+    prefix: CreationPrefix<'_>,
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<DescriptorAclCapture, opensip_platform::WorkFailure<PreparePrivateError>> {
+    prepare_fresh_private_sample(prefix.kind, invoking_uid, prefix.object, work)
+}
+
+/// A positioned reader from offset zero that leaves the handle's shared
+/// offset alone.
+#[cfg(target_os = "macos")]
+struct FromStart<'f> {
+    file: &'f std::fs::File,
+    offset: u64,
+}
+#[cfg(target_os = "macos")]
+impl std::io::Read for FromStart<'_> {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        use std::os::unix::fs::FileExt;
+        let read = self.file.read_at(buffer, self.offset)?;
+        self.offset += read as u64;
+        Ok(read)
+    }
+}
+
+/// What a bounded read of at most `expected.len() + 1` bytes found.
+#[cfg(target_os = "macos")]
+enum PrefixRead {
+    Equal,
+    /// A strict prefix of this length (the empty prefix included).
+    StrictPrefix(usize),
+    Neither,
+}
+/// P-PREFIX's content clause (J-RW r4 item 3.2): one bounded, charged read
+/// of at most `expected.len() + 1` bytes from offset zero, whose length must
+/// also be the sampled `size`. A native read failure leaves the clause
+/// unproven (`Neither`).
+#[cfg(target_os = "macos")]
+fn read_prefix(
+    file: &std::fs::File,
+    size: u64,
+    expected: &[u8],
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<PrefixRead, opensip_platform::WorkFailure<PreparePrivateError>> {
+    if expected.is_empty() {
+        return Ok(if size == 0 {
+            PrefixRead::Equal
+        } else {
+            PrefixRead::Neither
+        });
+    }
+    let reader = FromStart { file, offset: 0 };
+    let Ok(bytes) = opensip_platform::read_bounded_observed(reader, expected.len(), work)? else {
+        return Ok(PrefixRead::Neither);
+    };
+    Ok(if bytes.len() as u64 != size {
+        PrefixRead::Neither
+    } else if bytes == expected {
+        PrefixRead::Equal
+    } else if expected.starts_with(&bytes) {
+        PrefixRead::StrictPrefix(bytes.len())
+    } else {
+        PrefixRead::Neither
+    })
+}
+
+/// P-PREFIX's judgment of a regular file at an owner's fixed name (J-RW r4
+/// item 3.2; unit J4a), before any effect.
+pub(crate) enum PrefixJudgment<'f> {
+    /// Exactly the owner's bytes, judged private: the ordinary admission.
+    /// Nothing is completed.
+    Equal(DescriptorAclCapture),
+    /// P-PREFIX holds. Only `complete_private_suffix` consumes it.
+    Prefix(SuffixPrefix<'f>),
+    /// A private file whose bytes are neither exactly equal to nor a strict
+    /// prefix of the owner's: foreign or corrupt. The owner keeps its row.
+    Neither(DescriptorAclCapture),
+}
+
+/// Proof that P-PREFIX held for the judged handle: the existing length and
+/// whether C-ACL must run first. Not Clone.
+pub(crate) struct SuffixPrefix<'f> {
+    file: &'f std::fs::File,
+    existing: usize,
+    acl_omitted: bool,
+}
+
+/// P-PREFIX (J-RW r4 item 3.2) over the regular file `name` under the
+/// owner's retained `parent`, for the exact bytes `expected` the owner's
+/// step writes there, judged before any effect:
+/// - P-ACL clauses 1 and 2: the fixed name, the parent's filesystem, the
+///   invoking user, mode exactly `0600`, one link;
+/// - the ACL omitted (C-ACL then runs first) or judged private;
+/// - the bytes, by one bounded read of at most `expected.len() + 1`, a
+///   strict prefix of `expected` (the empty prefix included).
+///
+/// A private file holding exactly `expected` is `Equal`, the owner's
+/// ordinary admission, with no clause added to it. Any other private file
+/// that is not P-PREFIX is `Neither`, for the owner's own row. An omitted
+/// ACL that is not P-PREFIX, and every other refusal of the private
+/// judgment, keeps that judgment's existing refusal. Nothing here writes.
+#[cfg(target_os = "macos")]
+pub(crate) fn judge_private_prefix<'f>(
+    parent: &opensip_platform::RetainedDirectory,
+    name: &std::ffi::OsStr,
+    file: &'f std::fs::File,
+    expected: &[u8],
+    invoking_uid: u32,
+    work: &mut opensip_platform::WorkScope<'_>,
+) -> Result<PrefixJudgment<'f>, opensip_platform::WorkFailure<PreparePrivateError>> {
+    let kind = PrivateObjectKind::RegularFile;
+    match judge_or_omitted(kind, invoking_uid, file, work)? {
+        Judged::Private(sample) => {
+            let existing = match read_prefix(file, sample.metadata().size, expected, work)? {
+                PrefixRead::Equal => return Ok(PrefixJudgment::Equal(sample)),
+                PrefixRead::Neither => return Ok(PrefixJudgment::Neither(sample)),
+                PrefixRead::StrictPrefix(existing) => existing,
+            };
+            if !at_fixed_name(parent, name, file, sample.metadata(), work)? {
+                return Ok(PrefixJudgment::Neither(sample));
+            }
+            Ok(PrefixJudgment::Prefix(SuffixPrefix {
+                file,
+                existing,
+                acl_omitted: false,
+            }))
+        }
+        Judged::Omitted(sample) => {
+            if !omitted_private_shape(kind, invoking_uid, sample.metadata(), sample.acl_state())
