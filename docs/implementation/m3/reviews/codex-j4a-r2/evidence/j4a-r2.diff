+/// Published work of one `write_regular_suffix_accounted` or `_reserved`
+/// completing `len` bytes over an existing prefix of `existing` bytes, with
+/// `s = ceil((len - existing) / 64 KiB)` and `n = ceil(len / 64 KiB)`: `s`
+/// positioned writes of at most 64 KiB each, then exactly the verification
+/// of `write_new_regular_cost(len)`: one status read, `n + 1` positioned
+/// reads into the 64 KiB verify buffer, and one file barrier.
+pub fn write_regular_suffix_cost(len: usize, existing: usize) -> WorkCost {
+    let suffix = len.saturating_sub(existing).div_ceil(VERIFY_BUFFER);
+    let chunks = len.div_ceil(VERIFY_BUFFER);
+    let status = status_read_cost();
+    WorkCost {
+        objects: 0,
+        edges: suffix
+            .saturating_add(chunks)
+            .saturating_add(1)
+            .saturating_add(status.edges)
+            .saturating_add(1),
+        bytes: VERIFY_BUFFER.saturating_add(status.bytes),
+    }
+}
