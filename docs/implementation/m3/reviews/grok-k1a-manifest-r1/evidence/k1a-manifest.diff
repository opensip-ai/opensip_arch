@@ -0,0 +1,97 @@
+"""T2 documentary decimals regression; no network or public source reads."""
+import contextlib
+from decimal import Decimal
+import io
+import json
+import pathlib
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import MAX_BYTES, Refusal, canonical, parse, sha256
+import corpus
+
+
+def document():
+    return {
+        "kind": "opensip-t2-corpus-manifest", "schemaVersion": "2-draft",
+        "treeDigestAlgorithm": {"id": "opensip-qd22-tree-sha256/1"},
+        "contentDigestAlgorithm": {"id": "opensip-t2-content-sha256/1-draft"},
+        "repositories": [{"id": "synthetic", "shapeEvidence": {"rustCfgPerKloc": 19.3}}],
+        "workspaces": [],
+    }
+
+
+class ManifestReaderTests(unittest.TestCase):
+    def test_document_decimals_preserved_exactly(self):
+        raw = b'{"observations":{"density":19.3,"tiny":1e-20},"id":"entry"}'
+        result = corpus.manifest_document(raw)
+        self.assertEqual(result["observations"]["density"], Decimal("19.3"))
+        self.assertEqual(result["observations"]["tiny"], Decimal("1e-20"))
+        self.assertEqual(result["id"], "entry")
+        with self.assertRaises(Refusal): parse(raw)
+        with self.assertRaises(Refusal): canonical(result)
+
+    def test_real_manifest_shape_reaches_offline_verification(self):
+        raw = json.dumps(document(), indent=2).encode()
+        captured = []
+        def verify(path, entry):
+            captured.append(entry)
+            return {"treeDigest": "a" * 64}
+        with tempfile.TemporaryDirectory() as tmp:
+            path = pathlib.Path(tmp)/"manifest.json"
+            path.write_bytes(raw)
+            args = ["corpus.py", "verify", "--manifest", str(path), "--store", tmp, "--id", "synthetic"]
+            # Store path is selected using the entry treeDigest, unrelated to
+            # the observational decimal. Retain that required pin explicitly.
+            doc = document()
+            doc["repositories"][0]["treeDigest"] = {"value": "a" * 64}
+            path.write_text(json.dumps(doc, indent=2))
+            with patch.object(sys, "argv", args), patch.object(corpus, "verify", verify), contextlib.redirect_stdout(io.StringIO()) as out:
+                self.assertEqual(corpus.main(), 0)
+            self.assertEqual(json.loads(out.getvalue())["entry"], "synthetic")
+        self.assertEqual(len(captured), 1)
+        self.assertEqual(captured[0]["shapeEvidence"]["rustCfgPerKloc"], Decimal("19.3"))
+
+    def test_fetch_receives_original_manifest_byte_digest(self):
+        # Mock the network boundary; the CLI must pin exact documentary bytes.
+        calls = []
+        def acquire(entry, manifest_digest, store, temp_root, *, local):
+            calls.append((manifest_digest, entry["shapeEvidence"]["rustCfgPerKloc"]))
+            return {"entry": entry["id"]}
+        with tempfile.TemporaryDirectory() as tmp:
+            path = pathlib.Path(tmp)/"manifest.json"
+            raw = json.dumps(document(), indent=2).encode() + b"\n"
+            path.write_bytes(raw)
+            args = ["corpus.py", "fetch", "--manifest", str(path), "--store", tmp,
+                    "--temp-root", tmp, "--id", "synthetic"]
+            with patch.object(sys, "argv", args), patch("fetch.acquire", acquire), contextlib.redirect_stdout(io.StringIO()):
+                self.assertEqual(corpus.main(), 0)
+        self.assertEqual(calls, [(sha256(raw), Decimal("19.3"))])
+
+    def test_malformed_document_refused(self):
+        for raw in (b'{"a":1,"a":2}', b'{"nested":{"a":1,"a":2}}',
+                    b'{"x":NaN}', b'{"x":Infinity}', b'{"x":-Infinity}',
+                    b'{"x":"\\ud800"}', b'{"x":"\xff"}', b'[]', b'null', b'{',
+                    b'{} extra', b'{"n":01}'):
+            with self.subTest(raw=raw), self.assertRaises(Refusal):
+                corpus.manifest_document(raw)
+
+    def test_document_limits_and_exact_input_type(self):
+        for raw in ("{}", bytearray(b"{}"), b" " * (MAX_BYTES + 1)):
+            with self.assertRaises(Refusal): corpus.manifest_document(raw)
+        accepted = b'{"a":' + b'['*31 + b'0' + b']'*31 + b'}'
+        self.assertIsInstance(corpus.manifest_document(accepted), dict)
+        refused = b'{"a":' + b'['*32 + b'0' + b']'*32 + b'}'
+        with self.assertRaises(Refusal): corpus.manifest_document(refused)
+
+    def test_consumed_document_decimal_cannot_enter_can_receipt(self):
+        # A decimal in an actual receipt field is still rejected by CAN.
+        parsed = corpus.manifest_document(b'{"licence":{"decimal":1.25}}')
+        with self.assertRaises(Refusal): canonical(parsed["licence"])
+
+
+if __name__ == "__main__":
+    unittest.main()
