+from canonical import MAX_BYTES, Refusal, canonical, sha256
 from records import require
 from store import verify, workspace
 
 
+def manifest_document(raw):
+    """Read the byte-pinned T2 documentary JSON, not a CAN harness record.
+
+    T2's observed shape/size statistics contain finite decimal metadata.
+    Preserve those exactly as Decimal; pins still hash the original bytes.
+    Values entering CAN admission records remain subject to canonical().
+    No canonical encoder or harness record parser is changed here.
+    """
+    require(type(raw) is bytes and len(raw) <= MAX_BYTES, "MANIFEST-UNREADABLE")
+
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            require(key not in result, "MANIFEST-UNREADABLE")
+            result[key] = value
+        return result
+
+    def invalid(_):
+        raise Refusal("MANIFEST-UNREADABLE")
+
+    def admitted(value, depth=0):
+        require(not (type(value) in (dict, list) and depth >= 32), "MANIFEST-UNREADABLE")
+        if type(value) is dict:
+            for key, child in value.items():
+                admitted(key, depth + 1)
+                admitted(child, depth + 1)
+        elif type(value) is list:
+            for child in value:
+                admitted(child, depth + 1)
+        elif type(value) is str:
+            value.encode("utf-8", "strict")
+        elif type(value) is Decimal:
+            require(value.is_finite(), "MANIFEST-UNREADABLE")
+        else:
+            require(value is None or type(value) in (int, bool), "MANIFEST-UNREADABLE")
+
+    try:
+        document = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=pairs,
+                              parse_float=Decimal, parse_constant=invalid)
+        require(type(document) is dict, "MANIFEST-UNREADABLE")
+        admitted(document)
+        return document
+    except (ValueError, UnicodeError, RecursionError) as exc:
+        raise Refusal("MANIFEST-UNREADABLE") from exc
+
+
