@@ -0,0 +1,178 @@
+"""Synthetic QD-27 controls; no producer, fixture execution or measurement."""
+import copy
+import itertools
+import pathlib
+import sys
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import Refusal
+from measurement import summarize_slots
+
+
+def batch(reset="cold"):
+    slots = [{"slot": {"kind": "warmup", "index": i}, "reasons": []}
+             for i in range(3)]
+    slots += [{"slot": {"kind": "measured", "index": i}, "reasons": [],
+               "elapsedNanos": n, "cgroupMemoryPeakBytes": 10 + i,
+               "rootReapedElapsedNanos": None}
+              for i, n in enumerate([9, 1, 8, 2, 7, 3, 6])]
+    if reset == "warm":
+        slots.append({"slot": {"kind": "priming", "index": 0}, "reasons": []})
+    return slots
+
+
+class AccountingTests(unittest.TestCase):
+    def test_complete_statistics_preserve_order(self):
+        result = summarize_slots("cold", batch())
+        self.assertEqual(result["elapsedNanos"], [9, 1, 8, 2, 7, 3, 6])
+        self.assertEqual(result["medianElapsedNanos"], 6)
+        self.assertEqual(result["maxCgroupMemoryPeakBytes"], 16)
+        self.assertFalse(result["incomplete"])
+        self.assertEqual(result["slotReasons"], [])
+
+    def test_every_named_reason_and_pair_has_exact_null_mapping(self):
+        # Independent table transcribed from QD-27, not imported module sets.
+        mapping = {
+            "run-failed": (True, True), "timeout": (True, True),
+            "cgroup-not-empty": (True, True), "settlement-failed": (True, True),
+            "cgroup-unavailable": (False, True),
+            "cgroup-v1-only": (False, True),
+            "cgroup-no-delegation": (False, True),
+            "cgroup-escape-unprevented": (False, True),
+            "cgroup-isolation-unverified": (False, True),
+            "cgroup-read-failed": (False, True),
+            "memory-peak-unverified": (False, True),
+            "memory-peak-unavailable-platform": (False, True),
+            "settlement-unverified-platform": (True, False),
+            "record-missing": (False, False), "record-invalid": (False, False),
+        }
+        combinations = [(r,) for r in mapping] + list(itertools.combinations(mapping, 2))
+        for reasons in combinations:
+            with self.subTest(reasons=reasons):
+                slots = batch()
+                slots[3]["reasons"] = list(reasons)
+                enull = any(mapping[r][0] for r in reasons)
+                mnull = any(mapping[r][1] for r in reasons)
+                slots[3]["elapsedNanos"] = None if enull else 9
+                slots[3]["cgroupMemoryPeakBytes"] = None if mnull else 10
+                result = summarize_slots("cold", slots)
+                self.assertTrue(result["incomplete"])
+                self.assertEqual(result["elapsedNanos"][0], None if enull else 9)
+                self.assertEqual(result["cgroupMemoryPeakBytes"][0], None if mnull else 10)
+                self.assertEqual(result["medianElapsedNanos"], None if enull else 6)
+                self.assertEqual(result["maxCgroupMemoryPeakBytes"], None if mnull else 16)
+                for field in ("elapsedNanos", "cgroupMemoryPeakBytes"):
+                    corrupt = copy.deepcopy(slots)
+                    corrupt[3][field] = 5 if slots[3][field] is None else None
+                    with self.assertRaises(Refusal):
+                        summarize_slots("cold", corrupt)
+
+    def test_warmup_reason_does_not_null_measured_samples(self):
+        slots = batch()
+        slots[0]["reasons"] = ["record-missing"]
+        result = summarize_slots("cold", slots)
+        self.assertTrue(result["incomplete"])
+        self.assertEqual(result["medianElapsedNanos"], 6)
+        self.assertEqual(result["maxCgroupMemoryPeakBytes"], 16)
+        slots[3]["elapsedNanos"] = None
+        with self.assertRaises(Refusal):
+            summarize_slots("cold", slots)
+
+    def test_priming_failure_has_own_slot(self):
+        slots = batch("warm")
+        slots[-1]["reasons"] = ["timeout"]
+        result = summarize_slots("warm", slots)
+        self.assertTrue(result["incomplete"])
+        self.assertEqual(result["slotReasons"], [{"slot": {"kind": "priming", "index": 0},
+                                                 "reasons": ["timeout"]}])
+        self.assertEqual(result["medianElapsedNanos"], 6)
+
+    def test_macos_retains_root_information_without_settlement_claim(self):
+        slots = batch()
+        for row in slots:
+            row["reasons"] = ["settlement-unverified-platform",
+                              "memory-peak-unavailable-platform"]
+            if row["slot"]["kind"] == "measured":
+                row["rootReapedElapsedNanos"] = row["elapsedNanos"]
+                row["elapsedNanos"] = row["cgroupMemoryPeakBytes"] = None
+        result = summarize_slots("cold", slots)
+        self.assertEqual(result["rootReapedElapsedNanos"], [9, 1, 8, 2, 7, 3, 6])
+        self.assertIsNone(result["medianElapsedNanos"])
+        self.assertIsNone(result["maxCgroupMemoryPeakBytes"])
+        self.assertTrue(result["incomplete"])
+        slots[3]["reasons"].append("run-failed")
+        slots[3]["rootReapedElapsedNanos"] = None
+        self.assertIsNone(summarize_slots("cold", slots)["rootReapedElapsedNanos"][0])
+
+    def test_exact_slot_coverage_refuses_missing_extra_duplicate(self):
+        for reset in ("cold", "warm"):
+            slots = batch(reset)
+            for bad in (slots[:-1], slots + [slots[0]], slots[:-1] + [slots[0]]):
+                with self.assertRaises(Refusal):
+                    summarize_slots(reset, bad)
+        with self.assertRaises(Refusal):
+            summarize_slots("cold", batch("warm"))
+        with self.assertRaises(Refusal):
+            summarize_slots("warm", batch())
+
+    def test_input_permutation_does_not_change_output(self):
+        slots = batch("warm")
+        slots[3]["reasons"] = ["record-invalid", "record-missing"]
+        first = summarize_slots("warm", slots)
+        slots.reverse()
+        for row in slots:
+            row["reasons"].reverse()
+        self.assertEqual(first, summarize_slots("warm", slots))
+
+    def test_no_input_mutation_or_output_alias(self):
+        slots = batch()
+        slots[0]["reasons"] = ["record-missing"]
+        before = copy.deepcopy(slots)
+        result = summarize_slots("cold", slots)
+        self.assertEqual(slots, before)
+        result["slotReasons"][0]["slot"]["index"] = 2
+        self.assertEqual(slots, before)
+
+    def test_invalid_slot_and_reason_shapes(self):
+        edits = [
+            lambda s: s[0]["slot"].update(index=True),
+            lambda s: s[0]["slot"].update(index=3),
+            lambda s: s[0]["slot"].update(kind="legacy"),
+            lambda s: s[0]["slot"].update(extra=0),
+            lambda s: s[0].update(reasons=["event-loss"]),
+            lambda s: s[0].update(reasons=["record-missing"] * 2),
+            lambda s: s[0].update(reasons=[None]),
+            lambda s: s[0].update(reasons="record-missing"),
+            lambda s: s[0].update(elapsedNanos=1),
+            lambda s: s[3].pop("rootReapedElapsedNanos"),
+            lambda s: s[3].update(rootReapedElapsedNanos=4),
+        ]
+        for edit in edits:
+            slots = batch()
+            edit(slots)
+            with self.assertRaises(Refusal):
+                summarize_slots("cold", slots)
+
+    def test_only_exact_positive_uint64_values(self):
+        for field in ("elapsedNanos", "cgroupMemoryPeakBytes"):
+            for value in (True, 1.0, "1", 0, -1, 2**64):
+                slots = batch()
+                slots[3][field] = value
+                with self.assertRaises(Refusal):
+                    summarize_slots("cold", slots)
+        slots = batch()
+        slots[3]["elapsedNanos"] = slots[3]["cgroupMemoryPeakBytes"] = 2**64 - 1
+        result = summarize_slots("cold", slots)
+        self.assertEqual(result["maxCgroupMemoryPeakBytes"], 2**64 - 1)
+
+    def test_refuses_invalid_reset_or_container(self):
+        for reset in (None, True, "cold-cache-flushed"):
+            with self.assertRaises(Refusal):
+                summarize_slots(reset, batch())
+        with self.assertRaises(Refusal):
+            summarize_slots("cold", tuple(batch()))
+
+
+if __name__ == "__main__":
+    unittest.main()
