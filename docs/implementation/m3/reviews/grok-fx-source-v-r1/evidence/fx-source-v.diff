+#[test]
+fn no_bounding_box_for_reordered_or_repeated_source() {
+    let bytes = b"abcabc";
+    let record = mapped(
+        bytes,
+        bytes,
+        vec![
+            segment("exact", 0, 3, n(3), n(6)),
+            segment("exact", 3, 6, n(0), n(3)),
+        ],
+    );
+    let mut buffers = Buffers::new(bytes);
+    buffers.blobs.insert(digest(bytes), bytes.to_vec());
+    let valid = validate(&canonical_bytes(&record).unwrap(), buffers.inputs()).unwrap();
+    assert_eq!(valid.exact_original_span(0, 0, 6), Ok(None));
+    assert_eq!(valid.exact_original_span(0, 0, 3), Ok(Some((3, 6))));
+}
