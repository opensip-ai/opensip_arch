+//! FX-COMP-1 extraction intermediates over explicit immutable input bytes.
+//!
+//! Validation proves partition/content/map consistency only. The caller owns
+//! snapshot and authenticated-closure admission and retains the supplied bytes.
+//! This module reads no filesystem, runs no parser and constructs no authority.
+use opensip_identity::{
+    JsonValue as Value, LogicalPath, canonical_bytes, digest_hex, parse_json, raw_sha256,
+};
+use std::collections::{BTreeMap, BTreeSet};
+
+const LIMIT: usize = 65_536;
+
+/// An internal intermediate defect, never a public refusal-code projection.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Error(pub &'static str);
+
+type Result<T> = std::result::Result<T, Error>;
+
+/// Already-admitted inputs supplied by the owner. These descriptors are inert;
+/// possession of this struct is not a custody, closure or snapshot proof.
+pub struct Inputs<'a> {
+    pub snapshot_id: &'a str,
+    pub files: &'a BTreeMap<String, Vec<u8>>,
+    pub producer_closures: &'a BTreeSet<String>,
+    pub derived_blobs: &'a BTreeMap<String, Vec<u8>>,
+}
+
+#[derive(Debug)]
+struct Segment {
+    kind: String,
+    start: usize,
+    end: usize,
+    source: Option<(usize, usize)>,
+}
+
+#[derive(Debug)]
+struct Derived {
+    sha256: String,
+    length: usize,
+    segments: Vec<Segment>,
+}
+
+#[derive(Debug)]
+struct Region {
+    ordinal: usize,
+    kind: String,
+    language: String,
+    start: usize,
+    end: usize,
+    state: String,
+    blockers: BTreeSet<String>,
+    derived: Option<Derived>,
+}
+
+/// A privately constructed, content-checked intermediate. It is neither a fact,
+/// Coverage value, stage input nor repair authorization. Input lifetimes keep
+/// the original and derived buffers immutable for span translation.
+#[derive(Debug)]
+pub struct ValidatedModel<'a> {
+    original: &'a [u8],
+    blobs: &'a BTreeMap<String, Vec<u8>>,
+    regions: Vec<Region>,
+    complete: bool,
+}
+
+fn require(condition: bool, error: &'static str) -> Result<()> {
+    if condition { Ok(()) } else { Err(Error(error)) }
+}
+
+fn object<'a>(v: &'a Value, fields: &[&str]) -> Result<&'a BTreeMap<String, Value>> {
+    let Value::Object(o) = v else {
+        return Err(Error("schema"));
+    };
+    require(
+        o.len() == fields.len() && fields.iter().all(|k| o.contains_key(*k)),
+        "schema",
+    )?;
+    Ok(o)
+}
+
+fn text(v: &Value) -> Result<&str> {
+    if let Value::String(s) = v {
+        Ok(s)
+    } else {
+        Err(Error("schema"))
+    }
+}
+
+fn choice(v: &Value, choices: &[&str]) -> Result<String> {
+    let s = text(v)?;
+    require(choices.contains(&s), "schema")?;
+    Ok(s.to_owned())
+}
+
+fn offset(v: &Value) -> Result<usize> {
+    let Value::Integer(n) = v else {
+        return Err(Error("schema"));
+    };
+    usize::try_from(n.get()).map_err(|_| Error("schema"))
+}
+
+fn array(v: &Value, maximum: usize) -> Result<&[Value]> {
+    let Value::Array(a) = v else {
+        return Err(Error("schema"));
+    };
+    require(a.len() <= maximum, "schema")?;
+    Ok(a)
+}
+
+fn identifier(s: &str, prefix: &str) -> bool {
+    s.strip_prefix(prefix).is_some_and(hash)
+}
+
+fn hash(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn derived(v: &Value) -> Result<Option<Derived>> {
+    if *v == Value::Null {
+        return Ok(None);
+    }
+    let d = object(v, &["sha256", "byteLength", "segments"])?;
+    let sha256 = text(&d["sha256"])?.to_owned();
+    require(hash(&sha256), "schema")?;
+    let length = offset(&d["byteLength"])?;
+    let rows = array(&d["segments"], LIMIT)?;
+    let mut segments = Vec::with_capacity(rows.len());
+    for v in rows {
+        let s = object(
+            v,
+            &[
+                "kind",
+                "derivedStart",
+                "derivedEnd",
+                "sourceStart",
+                "sourceEnd",
+            ],
+        )?;
+        let kind = choice(&s["kind"], &["exact", "anchor", "generated"])?;
+        let start = offset(&s["derivedStart"])?;
+        let end = offset(&s["derivedEnd"])?;
+        let a = if s["sourceStart"] == Value::Null {
+            None
+        } else {
+            Some(offset(&s["sourceStart"])?)
+        };
+        let b = if s["sourceEnd"] == Value::Null {
+            None
+        } else {
+            Some(offset(&s["sourceEnd"])?)
+        };
+        let source = match (a, b) {
+            (Some(a), Some(b)) => Some((a, b)),
+            (None, None) => None,
+            _ => return Err(Error("source-range")),
+        };
+        segments.push(Segment {
+            kind,
+            start,
+            end,
+            source,
+        });
+    }
+    Ok(Some(Derived {
+        sha256,
+        length,
+        segments,
+    }))
+}
+
+fn region(v: &Value) -> Result<Region> {
+    let r = object(
+        v,
+        &[
+            "regionId",
+            "kind",
+            "language",
+            "startByte",
+            "endByte",
+            "state",
+            "blockers",
+            "derived",
+        ],
+    )?;
+    let ordinal = offset(&r["regionId"])?;
+    let kind = choice(
+        &r["kind"],
+        &[
+            "whole",
+            "container",
+            "script",
+            "template",
+            "style",
+            "unmapped",
+        ],
+    )?;
+    let language = choice(
+        &r["language"],
+        &[
+            "typescript",
+            "javascript",
+            "rust",
+            "css",
+            "component-markup",
+            "vue-template",
+            "svelte-template",
+            "astro-template",
+            "unknown",
+        ],
+    )?;
+    let state = choice(
+        &r["state"],
+        &["complete", "partial", "unsupported", "malformed"],
+    )?;
+    let mut blockers = BTreeSet::new();
+    for value in array(&r["blockers"], 9)? {
+        let blocker = choice(
+            value,
+            &[
+                "grammar-unavailable",
+                "unsupported-syntax",
+                "preprocessor-unavailable",
+                "dynamic-component",
+                "dynamic-class",
+                "invalid-source-map",
+                "malformed-source",
+                "config-requires-evaluation",
+                "unmapped-region",
+            ],
+        )?;
+        require(blockers.insert(blocker), "schema")?;
+    }
+    Ok(Region {
+        ordinal,
+        kind,
+        language,
+        start: offset(&r["startByte"])?,
+        end: offset(&r["endByte"])?,
+        state,
+        blockers,
+        derived: derived(&r["derived"])?,
+    })
+}
+
+fn boundary(bytes: &[u8], offset: usize) -> bool {
+    offset <= bytes.len() && (offset == bytes.len() || bytes[offset] & 0xc0 != 0x80)
+}
+
+fn partition<'a>(ranges: impl Iterator<Item = &'a (usize, usize)>, length: usize) -> Result<()> {
+    let mut position = 0;
+    for &(start, end) in ranges {
+        require(
+            start == position && position < end && end <= length,
+            "partition",
+        )?;
+        position = end;
+    }
+    require(position == length, "partition")
+}
+
+/// Decode the closed FX-COMP-1 r2 shape before joining explicit input buffers.
+/// No later/unselected schema or adapter interpretation is accepted here.
+pub fn validate<'a>(raw: &[u8], inputs: Inputs<'a>) -> Result<ValidatedModel<'a>> {
+    let value = parse_json(raw).map_err(|_| Error("canonical-profile"))?;
+    canonical_bytes(&value).map_err(|_| Error("canonical-profile"))?;
+    let model = object(
+        &value,
+        &[
+            "schemaVersion",
+            "snapshotId",
+            "source",
+            "producerClosureId",
+            "format",
+            "state",
+            "regions",
+        ],
+    )?;
+    require(offset(&model["schemaVersion"])? == 1, "schema")?;
+    let snapshot = text(&model["snapshotId"])?;
+    let closure = text(&model["producerClosureId"])?;
+    require(
+        identifier(snapshot, "snapshot2:") && identifier(closure, "closure2:"),
+        "schema",
+    )?;
+    let source = object(&model["source"], &["path", "contentSha256", "byteLength"])?;
+    let path = text(&source["path"])?;
+    LogicalPath::parse(path).map_err(|_| Error("source-path"))?;
+    let source_hash = text(&source["contentSha256"])?;
+    require(hash(source_hash), "schema")?;
+    let length = offset(&source["byteLength"])?;
+    let format = choice(
+        &model["format"],
+        &[
+            "vue",
+            "svelte",
+            "astro",
+            "css",
+            "typescript",
+            "javascript",
+            "rust",
+        ],
+    )?;
+    let state = choice(&model["state"], &["complete", "partial"])?;
+    let rows = array(&model["regions"], LIMIT)?;
+    let regions = rows.iter().map(region).collect::<Result<Vec<_>>>()?;
+    // Complete shape has now been decoded; no input byte is consumed before it.
+    require(snapshot == inputs.snapshot_id, "snapshot-join")?;
+    let original = inputs.files.get(path).ok_or(Error("source-membership"))?;
+    require(
+        original.len() == length && digest_hex(&raw_sha256(original)) == source_hash,
+        "source-content",
+    )?;
+    require(
+        inputs.producer_closures.contains(closure),
+        "producer-closure",
+    )?;
+    let ranges: Vec<_> = regions.iter().map(|r| (r.start, r.end)).collect();
+    partition(ranges.iter(), original.len())?;
+    let valid_text = std::str::from_utf8(original).is_ok();
+    if !valid_text {
+        require(
+            regions.len() == 1
+                && regions[0].kind == "unmapped"
+                && regions[0].language == "unknown"
+                && regions[0].state == "malformed"
+                && regions[0].blockers.contains("malformed-source")
+                && regions[0].derived.is_none(),
+            "malformed-source-account",
+        )?;
+    }
+    let component = matches!(format.as_str(), "vue" | "svelte" | "astro");
+    let mut complete = true;
+    for (ordinal, r) in regions.iter().enumerate() {
+        require(r.ordinal == ordinal, "region-ordinal")?;
+        if valid_text {
+            require(
+                boundary(original, r.start) && boundary(original, r.end),
+                "utf8-boundary",
+            )?;
+        }
+        require(
+            (r.state == "complete") == r.blockers.is_empty(),
+            "state-blockers",
+        )?;
+        complete &= r.state == "complete";
+        if r.kind == "unmapped" {
+            require(
+                r.language == "unknown"
+                    && matches!(r.state.as_str(), "unsupported" | "malformed")
+                    && (!valid_text || r.blockers.contains("unmapped-region")),
+                "unmapped-state",
+            )?;
+        } else if component {
+            let compatible = match r.kind.as_str() {
+                "container" => r.language == "component-markup",
+                "script" => matches!(r.language.as_str(), "typescript" | "javascript"),
+                "template" => r.language == format!("{format}-template"),
+                "style" => r.language == "css",
+                _ => false,
+            };
+            require(compatible, "region-language")?;
+        } else {
+            require(
+                r.kind == "whole" && r.language == format && regions.len() == 1,
+                "whole-language",
+            )?;
+        }
+        if let Some(d) = &r.derived {
+            let bytes = inputs
+                .derived_blobs
+                .get(&d.sha256)
+                .ok_or(Error("derived-retention"))?;
+            require(
+                bytes.len() == d.length && digest_hex(&raw_sha256(bytes)) == d.sha256,
+                "derived-content",
+            )?;
+            require(
+                valid_text && std::str::from_utf8(bytes).is_ok(),
+                "derived-utf8",
+            )?;
+            let ranges: Vec<_> = d.segments.iter().map(|s| (s.start, s.end)).collect();
+            partition(ranges.iter(), bytes.len())?;
+            for s in &d.segments {
+                require(
+                    boundary(bytes, s.start) && boundary(bytes, s.end),
+                    "utf8-boundary",
+                )?;
+                if s.kind == "generated" {
+                    require(s.source.is_none(), "generated-source")?;
+                } else {
+                    let (a, b) = s.source.ok_or(Error("source-range"))?;
+                    require(r.start <= a && a <= b && b <= r.end, "source-range")?;
+                    require(
+                        boundary(original, a) && boundary(original, b),
+                        "utf8-boundary",
+                    )?;
+                    if s.kind == "exact" {
+                        require(
+                            s.end - s.start == b - a && bytes[s.start..s.end] == original[a..b],
+                            "exact-bytes",
+                        )?;
+                    }
+                }
+            }
+        }
+    }
+    require(
+        state == if complete { "complete" } else { "partial" },
+        "model-state",
+    )?;
+    Ok(ValidatedModel {
+        original,
+        blobs: inputs.derived_blobs,
+        regions,
+        complete,
+    })
+}
+
+impl ValidatedModel<'_> {
+    /// Extraction only, never semantic or consumer completeness.
+    pub fn extraction_complete(&self) -> bool {
+        self.complete
+    }
+
+    pub fn region_count(&self) -> usize {
+        self.regions.len()
+    }
+
+    /// Region-relative original or derived byte offsets to exact original bytes.
+    /// `None` discloses an anchor/generated/discontiguous mapping; no bounding
+    /// box or first-segment approximation is made. This grants no edit authority.
+    pub fn exact_original_span(
+        &self,
+        region_id: usize,
+        start: usize,
+        end: usize,
+    ) -> Result<Option<(usize, usize)>> {
+        require(
+            std::str::from_utf8(self.original).is_ok(),
+            "span-source-utf8",
+        )?;
+        require(start < end, "span-shape")?;
+        let r = self.regions.get(region_id).ok_or(Error("region-ordinal"))?;
+        let Some(d) = &r.derived else {
+            require(end <= r.end - r.start, "span-range")?;
+            let result = (r.start + start, r.start + end);
+            require(
+                boundary(self.original, result.0) && boundary(self.original, result.1),
+                "utf8-boundary",
+            )?;
+            return Ok(Some(result));
+        };
+        require(end <= d.length, "span-range")?;
+        let bytes = &self.blobs[&d.sha256];
+        require(
+            boundary(bytes, start) && boundary(bytes, end),
+            "utf8-boundary",
+        )?;
+        let mut result = None;
+        for s in &d.segments {
+            let a = start.max(s.start);
+            let b = end.min(s.end);
+            if a >= b {
+                continue;
+            }
+            if s.kind != "exact" {
+                return Ok(None);
+            }
+            let (source, _) = s.source.ok_or(Error("source-range"))?;
+            let mapped = (source + (a - s.start), source + (b - s.start));
+            match result {
+                None => result = Some(mapped),
+                Some((first, last)) if last == mapped.0 => result = Some((first, mapped.1)),
+                _ => return Ok(None),
+            }
+        }
+        Ok(result)
+    }
+}
