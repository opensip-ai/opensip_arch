+#[test]
+fn accepted_reference_cases_and_exact_spans() {
+    let fixtures = parse_json(include_bytes!("source_model_cases.json")).unwrap();
+    let cases = rows(field(&fixtures, "cases"));
+    assert_eq!(cases.len(), 25);
+    for case in cases {
+        let id = text(field(case, "id"));
+        let original = hex(text(field(case, "sourceHex")));
+        let mut buffers = Buffers::new(&original);
+        for blob in rows(field(case, "blobs")) {
+            buffers.blobs.insert(
+                text(field(blob, "sha256")).into(),
+                hex(text(field(blob, "contentHex"))),
+            );
+        }
+        let expected = field(case, "expected");
+        let result = validate(text(field(case, "recordJson")).as_bytes(), buffers.inputs());
+        if field(expected, "admissible") == &V::Bool(false) {
+            assert!(result.is_err(), "{id}");
+            continue;
+        }
+        let validated = result.unwrap_or_else(|e| panic!("{id}: {e:?}"));
+        for span in rows(field(expected, "spans")) {
+            let actual = validated.exact_original_span(
+                number(field(span, "regionId")),
+                number(field(span, "start")),
+                number(field(span, "end")),
+            );
+            let V::Object(span_fields) = span else {
+                panic!()
+            };
+            if let Some(expected_error) = span_fields.get("error") {
+                assert_eq!(actual.unwrap_err().0, text(expected_error), "{id}");
+            } else {
+                let expected_span = match field(span, "original") {
+                    V::Null => None,
+                    value => Some((number(&rows(value)[0]), number(&rows(value)[1]))),
+                };
+                assert_eq!(actual, Ok(expected_span), "{id}");
+            }
+        }
+    }
+}
