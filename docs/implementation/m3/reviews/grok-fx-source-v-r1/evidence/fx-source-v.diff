+fn s(text: &str) -> V {
+    V::String(text.into())
+}
+fn n(value: usize) -> V {
+    V::Integer(JsonInteger::new(value as i128).unwrap())
+}
+fn object(pairs: &[(&str, V)]) -> V {
+    V::Object(
+        pairs
+            .iter()
+            .map(|(k, v)| (k.to_string(), v.clone()))
+            .collect(),
+    )
+}
+fn field<'a>(v: &'a V, k: &str) -> &'a V {
+    let V::Object(m) = v else { panic!("object") };
+    &m[k]
+}
+fn rows(v: &V) -> &[V] {
+    let V::Array(a) = v else { panic!("array") };
+    a
+}
+fn text(v: &V) -> &str {
+    let V::String(s) = v else { panic!("string") };
+    s
+}
+fn number(v: &V) -> usize {
+    let V::Integer(i) = v else { panic!("integer") };
+    usize::try_from(i.get()).unwrap()
+}
+fn set(v: &mut V, k: &str, value: V) {
+    let V::Object(m) = v else { panic!("object") };
+    m.insert(k.into(), value);
+}
+fn hex(value: &str) -> Vec<u8> {
+    value
+        .as_bytes()
+        .chunks_exact(2)
+        .map(|b| u8::from_str_radix(std::str::from_utf8(b).unwrap(), 16).unwrap())
+        .collect()
+}
+fn digest(bytes: &[u8]) -> String {
+    digest_hex(&raw_sha256(bytes))
+}
+
+struct Buffers {
+    files: BTreeMap<String, Vec<u8>>,
+    closures: BTreeSet<String>,
+    blobs: BTreeMap<String, Vec<u8>>,
+}
+
+impl Buffers {
+    fn new(bytes: &[u8]) -> Self {
+        Self {
+            files: [("source".into(), bytes.to_vec())].into(),
+            closures: [format!("closure2:{}", "b".repeat(64))].into(),
+            blobs: BTreeMap::new(),
+        }
+    }
+    fn inputs(&self) -> Inputs<'_> {
+        Inputs {
+            snapshot_id: "snapshot2:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+            files: &self.files,
+            producer_closures: &self.closures,
+            derived_blobs: &self.blobs,
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)] // Explicit closed fixture-region fields.
+fn region(
+    kind: &str,
+    language: &str,
+    start: usize,
+    end: usize,
+    state: &str,
+    blockers: &[&str],
+    derived: V,
+) -> V {
+    object(&[
+        ("regionId", n(0)),
+        ("kind", s(kind)),
+        ("language", s(language)),
+        ("startByte", n(start)),
+        ("endByte", n(end)),
+        ("state", s(state)),
+        (
+            "blockers",
+            V::Array(blockers.iter().map(|x| s(x)).collect()),
+        ),
+        ("derived", derived),
+    ])
+}
+
+fn model(bytes: &[u8], format: &str, regions: Vec<V>, state: &str) -> V {
+    object(&[
+        ("schemaVersion", n(1)),
+        (
+            "snapshotId",
+            s("snapshot2:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
+        ),
+        (
+            "source",
+            object(&[
+                ("path", s("source")),
+                ("contentSha256", s(&digest(bytes))),
+                ("byteLength", n(bytes.len())),
+            ]),
+        ),
+        (
+            "producerClosureId",
+            s(&format!("closure2:{}", "b".repeat(64))),
+        ),
+        ("format", s(format)),
+        ("state", s(state)),
+        ("regions", V::Array(regions)),
+    ])
+}
+
+fn whole(bytes: &[u8]) -> V {
+    model(
+        bytes,
+        "javascript",
+        if bytes.is_empty() {
+            vec![]
+        } else {
+            vec![region(
+                "whole",
+                "javascript",
+                0,
+                bytes.len(),
+                "complete",
+                &[],
+                V::Null,
+            )]
+        },
+        "complete",
+    )
+}
