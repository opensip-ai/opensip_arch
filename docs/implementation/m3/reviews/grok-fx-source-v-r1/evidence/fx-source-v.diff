+#[test]
+fn multi_region_partitions_and_independent_incomplete_regions() {
+    let bytes = b"<s>abc<t>x";
+    let mut template = region(
+        "template",
+        "vue-template",
+        6,
+        bytes.len(),
+        "partial",
+        &["dynamic-component"],
+        V::Null,
+    );
+    set(&mut template, "regionId", n(2));
+    let mut script = region("script", "javascript", 3, 6, "complete", &[], V::Null);
+    set(&mut script, "regionId", n(1));
+    let record = model(
+        bytes,
+        "vue",
+        vec![
+            region(
+                "container",
+                "component-markup",
+                0,
+                3,
+                "complete",
+                &[],
+                V::Null,
+            ),
+            script,
+            template,
+        ],
+        "partial",
+    );
+    let buffers = Buffers::new(bytes);
+    let encoded = canonical_bytes(&record).unwrap();
+    let valid = validate(&encoded, buffers.inputs()).unwrap();
+    assert_eq!(valid.region_count(), 3);
+    assert!(!valid.extraction_complete());
+    assert_eq!(valid.exact_original_span(1, 0, 3), Ok(Some((3, 6))));
+    assert_eq!(valid.exact_original_span(2, 0, 3), Ok(Some((6, 9))));
+    // A physical citation remains exact even though extraction is incomplete;
+    // this API constructs neither a semantic fact nor repair permission.
+}
