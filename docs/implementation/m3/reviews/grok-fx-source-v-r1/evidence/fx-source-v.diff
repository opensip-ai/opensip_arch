+#[test]
+fn closed_shape_scalar_profile_and_logical_paths() {
+    let buffers = Buffers::new(b"abc");
+    for path in ["", "/source", "../source", "a//b", "a/./b", "a\\b"] {
+        let mut record = whole(b"abc");
+        let mut source = field(&record, "source").clone();
+        set(&mut source, "path", s(path));
+        set(&mut record, "source", source);
+        assert_eq!(
+            validate(&canonical_bytes(&record).unwrap(), buffers.inputs()).unwrap_err(),
+            Error("source-path")
+        );
+    }
+    let mut record = whole(b"abc");
+    set(&mut record, "authority", V::Bool(true));
+    assert_eq!(
+        validate(&canonical_bytes(&record).unwrap(), buffers.inputs()).unwrap_err(),
+        Error("schema")
+    );
+    for raw in [
+        b"{\"x\":0.0}".as_slice(),
+        b"{\"x\":-0}",
+        b"{\"x\":1,\"x\":2}",
+        b"{\"x\":\"\\ud800\"}",
+    ] {
+        assert_eq!(
+            validate(raw, buffers.inputs()).unwrap_err(),
+            Error("canonical-profile")
+        );
+    }
+}
