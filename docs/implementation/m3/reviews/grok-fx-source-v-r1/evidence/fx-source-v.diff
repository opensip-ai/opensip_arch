+#[test]
+fn missing_and_stale_derived_buffers_are_refused() {
+    let record = mapped(b"abc", b"abc", vec![segment("exact", 0, 3, n(0), n(3))]);
+    let mut buffers = Buffers::new(b"abc");
+    let raw = canonical_bytes(&record).unwrap();
+    assert_eq!(
+        validate(&raw, buffers.inputs()).unwrap_err(),
+        Error("derived-retention")
+    );
+    buffers.blobs.insert(digest(b"abc"), b"abd".to_vec());
+    assert_eq!(
+        validate(&raw, buffers.inputs()).unwrap_err(),
+        Error("derived-content")
+    );
+}
