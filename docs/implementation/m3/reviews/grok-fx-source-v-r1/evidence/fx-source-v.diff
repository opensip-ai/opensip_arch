+#[test]
+fn identity_depth_rule_allows_scalar_leaf_but_not_container_at_limit() {
+    // Matching the selected identity canonical predicate, not the r2 Python
+    // reference's blanket depth<32 on scalar leaves (FX-COMP-1-NB-02).
+    let scalar_at_depth_32 = format!("{}0{}", "[".repeat(32), "]".repeat(32));
+    assert!(parse_json(scalar_at_depth_32.as_bytes()).is_ok());
+    let container_at_depth_32 = format!("{}[]{}", "[".repeat(32), "]".repeat(32));
+    assert!(parse_json(container_at_depth_32.as_bytes()).is_err());
+}
