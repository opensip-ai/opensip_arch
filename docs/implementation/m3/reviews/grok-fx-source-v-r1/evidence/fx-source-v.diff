+    let mut r = rows(field(&record, "regions"))[0].clone();
+    set(&mut r, "state", s("partial"));
+    set(&mut r, "blockers", V::Array(vec![s("invalid-source-map")]));
+    set(&mut record, "regions", V::Array(vec![r]));
+    set(&mut record, "state", s("partial"));
+    let mut buffers = Buffers::new(bytes);
+    buffers.blobs.insert(digest(bytes), bytes.to_vec());
+    let valid = validate(&canonical_bytes(&record).unwrap(), buffers.inputs()).unwrap();
+    assert!(!valid.extraction_complete());
+    assert_eq!(valid.exact_original_span(0, 0, 3), Ok(Some((0, 3))));
+    // Unselected components-r3 restrictions do not replace accepted r2. Every
+    // map still passes structural/content checks; citations are not facts.
+}
