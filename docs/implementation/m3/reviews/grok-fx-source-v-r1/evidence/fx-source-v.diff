+#[test]
+fn snapshot_source_and_retained_closure_joins() {
+    let bytes = b"abc";
+    let record = whole(bytes);
+    let mut buffers = Buffers::new(bytes);
+    let raw = canonical_bytes(&record).unwrap();
+    let mut wrong_snapshot = buffers.inputs();
+    wrong_snapshot.snapshot_id =
+        "snapshot2:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
+    assert_eq!(
+        validate(&raw, wrong_snapshot).unwrap_err(),
+        Error("snapshot-join")
+    );
+    buffers.files.insert("source".into(), b"abd".to_vec());
+    assert_eq!(
+        validate(&raw, buffers.inputs()).unwrap_err(),
+        Error("source-content")
+    );
+    buffers.files.clear();
+    assert_eq!(
+        validate(&raw, buffers.inputs()).unwrap_err(),
+        Error("source-membership")
+    );
+    buffers.files.insert("source".into(), bytes.to_vec());
+    buffers.closures.clear();
+    assert_eq!(
+        validate(&raw, buffers.inputs()).unwrap_err(),
+        Error("producer-closure")
+    );
+}
+
+fn mapped(bytes: &[u8], content: &[u8], segments: Vec<V>) -> V {
+    let d = object(&[
+        ("sha256", s(&digest(content))),
+        ("byteLength", n(content.len())),
+        ("segments", V::Array(segments)),
+    ]);
+    model(
+        bytes,
+        "javascript",
+        vec![region(
+            "whole",
+            "javascript",
+            0,
+            bytes.len(),
+            "complete",
+            &[],
+            d,
+        )],
+        "complete",
+    )
+}
+
+fn segment(kind: &str, start: usize, end: usize, source_start: V, source_end: V) -> V {
+    object(&[
+        ("kind", s(kind)),
+        ("derivedStart", n(start)),
+        ("derivedEnd", n(end)),
+        ("sourceStart", source_start),
+        ("sourceEnd", source_end),
+    ])
+}
