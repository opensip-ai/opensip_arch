+"""Pure Q0 r13 §4.5-4.6 label-settlement decision after voter admission.
+
+Caller admits the roster, rule-author/conflict exclusion, calibration,
+blindness, item/rubric joins and independent group identity before this API.
+No registration, ledger append, presentation, queue or real adjudication.
+"""
+from canonical import canonical
+from records import require
+
+LABELS = frozenset({'true', 'false', 'unclear'})
+
+
+def _label(value):
+    require(type(value) is str and value in LABELS, 'SETTLEMENT_LABEL')
+
+
+def decide_settlement(groups, gating_or_repair, expert=None):
+    """Apply the two-group table; agents from one family remain one group.
+
+    Local API groups are {groupId, kind, labels}. The caller's admitted groupId
+    is the human identity for human groups or the vendor model lineage for
+    agent groups, not a model instance or shared implementation context. Agent
+    implementation context disqualifies that voter before grouping (§4.5).
+    An expert input is {label, rationale}; caller establishes that it belongs
+    to the designated registered human domain expert and is blind to detector
+    evidence. It is the final expert decision, never a third procedural vote.
+    """
+    require(type(gating_or_repair) is bool, 'SETTLEMENT_COST_CLASS')
+    require(type(groups) is list and len(groups) == 2, 'TWO_VOTE_GROUPS_REQUIRED')
+    canonical({'groups': groups, 'expert': expert})
+    identities, labels = set(), []
+    human = False
+    for row in groups:
+        require(type(row) is dict and set(row) == {'groupId', 'kind', 'labels'},
+                'SETTLEMENT_GROUP_SHAPE')
+        gid, kind, votes = row['groupId'], row['kind'], row['labels']
+        require(type(gid) is str and 1 <= len(gid) <= 4096, 'SETTLEMENT_GROUP_ID')
+        require(type(kind) is str and kind in {'human', 'agent'}, 'SETTLEMENT_GROUP_KIND')
+        key = (kind, gid)
+        require(key not in identities, 'DUPLICATE_VOTE_GROUP')
+        identities.add(key)
+        require(type(votes) is list and bool(votes), 'SETTLEMENT_GROUP_LABELS')
+        if kind == 'human':
+            human = True
+            require(len(votes) == 1, 'ONE_VOTE_PER_HUMAN')
+        for vote in votes:
+            _label(vote)
+        # QD-10: disagreement inside a model family is one unclear vote.
+        labels.append(votes[0] if all(v == votes[0] for v in votes) else 'unclear')
+    require(human, 'HUMAN_VOTE_REQUIRED')
+    reasons = []
+    if labels[0] != labels[1]:
+        reasons.append('disagreement')
+    if gating_or_repair and 'unclear' in labels:
+        reasons.append('unclear-gating')
+    if not reasons:
+        require(expert is None, 'EXPERT_WITHOUT_ESCALATION')
+        return {'status': 'resolved', 'label': labels[0], 'method': 'agreement',
+                'escalationReasons': [], 'productQualification': False}
+    if expert is None:
+        return {'status': 'pending', 'label': None, 'method': None,
+                'escalationReasons': reasons, 'productQualification': False}
+    require(type(expert) is dict and set(expert) == {'label', 'rationale'},
+            'SETTLEMENT_EXPERT_SHAPE')
+    _label(expert['label'])
+    require(type(expert['rationale']) is str and bool(expert['rationale']),
+            'EXPERT_RATIONALE_REQUIRED')
+    return {'status': 'resolved', 'label': expert['label'], 'method': 'expert',
+            'escalationReasons': reasons, 'productQualification': False}
