+"""Independent transcription of the QD-10 settlement table, synthetic only."""
+import copy
+import pathlib
+import sys
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import Refusal
+from label_settlement import decide_settlement
+
+
+def groups(a, b, kind='agent'):
+    return [{'groupId':'person-a', 'kind':'human', 'labels':[a]},
+            {'groupId':'family-b', 'kind':kind, 'labels':[b]}]
+
+
+class SettlementTests(unittest.TestCase):
+    def test_all_nine_label_pairs_both_cost_classes(self):
+        for a in ('true','false','unclear'):
+            for b in ('true','false','unclear'):
+                for gated in (False,True):
+                    r = decide_settlement(groups(a,b), gated)
+                    settles = a == b and (a != 'unclear' or not gated)
+                    self.assertEqual(r['status'], 'resolved' if settles else 'pending')
+                    self.assertEqual(r['label'], a if settles else None)
+                    self.assertEqual(r['method'], 'agreement' if settles else None)
+                    self.assertFalse(r['productQualification'])
+
+    def test_same_family_is_one_vote_and_internal_disagreement_unclear(self):
+        value = groups('true','true')
+        value[1]['labels'] = ['true','false','true']
+        r = decide_settlement(value, False)
+        self.assertEqual(r['status'],'pending')
+        self.assertEqual(r['escalationReasons'],['disagreement'])
+        value[0]['labels'] = ['unclear']
+        self.assertEqual(decide_settlement(value,False)['label'],'unclear')
+        self.assertEqual(decide_settlement(value,True)['status'],'pending')
+
+    def test_more_same_family_agents_cannot_overrule_human(self):
+        value = groups('false','true')
+        value[1]['labels'] *= 100
+        self.assertEqual(decide_settlement(value,False)['status'],'pending')
+
+    def test_two_agents_never_stand_alone(self):
+        value = groups('true','true'); value[0]['kind'] = 'agent'
+        with self.assertRaises(Refusal): decide_settlement(value,False)
+
+    def test_two_distinct_humans_can_agree(self):
+        self.assertEqual(decide_settlement(groups('false','false','human'),True)['label'],'false')
+
+    def test_a_duplicate_human_is_not_two_votes(self):
+        value = groups('true','true','human');value[1]['groupId']=value[0]['groupId']
+        with self.assertRaises(Refusal): decide_settlement(value,False)
+        value = groups('true','true');value[0]['labels'].append('true')
+        with self.assertRaises(Refusal): decide_settlement(value,False)
+
+    def test_third_procedural_vote_never_settles(self):
+        value = groups('true','false');value.append({'kind':'human','groupId':'person-c','labels':['true']})
+        with self.assertRaises(Refusal): decide_settlement(value,False)
+
+    def test_final_expert_decision_including_unclear(self):
+        for label in ('true','false','unclear'):
+            for gated in (False,True):
+                r = decide_settlement(groups('true','false'),gated,{'label':label,'rationale':'synthetic source.rs:1; admitted configuration'})
+                self.assertEqual((r['label'],r['method']), (label,'expert'))
+        with self.assertRaises(Refusal): decide_settlement(groups('true','false'),False,{'label':'true','rationale':''})
+        with self.assertRaises(Refusal): decide_settlement(groups('true','true'),False,{'label':'false','rationale':'source.rs:1'})
+
+    def test_cost_class_types_and_group_shapes(self):
+        for cost in (0,1,None,'gating'):
+            with self.assertRaises(Refusal): decide_settlement(groups('true','true'),cost)
+        mutations = [lambda x:x[0].update(extra=True), lambda x:x[1].update(labels=[]),
+                     lambda x:x[1].update(kind='model'), lambda x:x[1].update(groupId=''),
+                     lambda x:x[1].update(labels=['unknown']), lambda x:x[1].update(labels=[True])]
+        for change in mutations:
+            value = copy.deepcopy(groups('true','true'));change(value)
+            with self.assertRaises(Refusal): decide_settlement(value,False)
+
+
+if __name__ == '__main__':
+    unittest.main()
