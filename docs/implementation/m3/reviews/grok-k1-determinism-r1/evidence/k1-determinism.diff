+"""QD-18 exact same-lane comparisons of independently admitted projections.
+
+The caller establishes identical semantic input closure, a shared runner lane,
+and complete Plan-bound identity populations. RequestId, ExecutionId and timing
+are outside the projection. This performs no runs or environment mutation and
+does not establish the V0-V4 execution schedule, lane freeze or qualification.
+"""
+from canonical import canonical, pin
+from records import require
+
+KINDS = ('scope', 'fact', 'coverage', 'view', 'finding')
+
+
+def _observation(row):
+    require(type(row) is dict and set(row) == {
+        'inputClosureDigest', 'lane', 'planId', 'identities'}, 'DETERMINISM_SHAPE')
+    require(pin(row['inputClosureDigest']), 'DETERMINISM_CLOSURE_PIN')
+    for key in ('lane', 'planId'):
+        value = row[key]
+        require(type(value) is str and 1 <= len(value) <= 4096,
+                'DETERMINISM_LABEL')
+    populations = row['identities']
+    require(type(populations) is dict and set(populations) == set(KINDS),
+            'DETERMINISM_IDENTITY_KINDS')
+    for population in populations.values():
+        require(type(population) is list and all(type(value) is str and
+                1 <= len(value) <= 4096 for value in population),
+                'DETERMINISM_IDENTITY_ARRAY')
+        require(population == sorted(set(population), key=canonical),
+                'DETERMINISM_IDENTITY_SET')
+    canonical(row)
+
+
+def compare_same_lane(baseline, observed):
+    """Compare every identity category and refuse inapplicable comparisons.
+
+    The input object is a local declared projection, not a wire carrier or an
+    admission of the IDs it contains. Every category must be supplied, including
+    genuinely empty ones; hashing or sampling a selected subset is not offered.
+    The caller proves that every supplied category is its complete population.
+    Cross-lane comparisons need semantic payloads/correspondence, never this
+    identity comparator. Different input closures are not a determinism test.
+    Equal closures and lane but unequal Plans fail even with identical IDs.
+    """
+    _observation(baseline)
+    _observation(observed)
+    require(baseline['inputClosureDigest'] == observed['inputClosureDigest'],
+            'DETERMINISM_INPUTS_DIFFER')
+    require(baseline['lane'] == observed['lane'], 'DETERMINISM_CROSS_LANE')
+    changed = [kind for kind in KINDS if
+               baseline['identities'][kind] != observed['identities'][kind]]
+    plan_drift = baseline['planId'] != observed['planId']
+    return {'deterministic': not plan_drift and not changed,
+            'planIdDrift': plan_drift, 'changedIdentityKinds': changed,
+            'projectionAdmissionEstablished': False,
+            'variantScheduleEstablished': False, 'productQualification': False}
