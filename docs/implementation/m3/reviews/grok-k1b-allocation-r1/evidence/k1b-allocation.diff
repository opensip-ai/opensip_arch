+"""Pure Q0 r13 section 5.7 QD-24 advisory allocation and seeded selection.
+
+Call before reading labels, separately for each admitted stratum and evidence
+set. Callers establish population completeness, family membership, exposure
+standing and preregistration. This helper neither freezes nor scores evidence.
+"""
+from hashlib import sha256
+from canonical import canonical
+from records import require
+
+
+def _label(value):
+    require(type(value) is str and 1 <= len(value) <= 4096, "LABEL_REQUIRED")
+    canonical(value)
+
+
+def water_fill(counts):
+    """Return smallest integer cap >=1 and exact per-family sample counts."""
+    require(type(counts) is dict and len(counts) <= 4096, "FAMILY_COUNTS")
+    canonical(counts)
+    for family, n in counts.items():
+        _label(family)
+        require(type(n) is int and 0 <= n <= 2**64 - 1, "CORPUS_COUNT")
+    total = sum(counts.values())
+    require(total <= 2**64 - 1, "CORPUS_TOTAL")
+    target = min(100, total)
+    lo, hi = 1, max(1, min(100, max(counts.values(), default=0)))
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if sum(min(n, mid) for n in counts.values()) >= target:
+            hi = mid
+        else:
+            lo = mid + 1
+    return lo, {family: min(n, lo) for family, n in counts.items()}
+
+
+def selection_seed(round_id, stratum_id, evidence_set, family):
+    """QD-24 literal UTF-8 concatenation, no invented tuple framing."""
+    for value in (round_id, stratum_id, family):
+        _label(value)
+    require(type(evidence_set) is str and evidence_set in {"held-out", "development"},
+            "EVIDENCE_SET_REQUIRED")
+    return sha256((round_id + stratum_id + evidence_set + family).encode("utf-8")).digest()
+
+
+def _draw(seed, bound, counter):
+    # Rejection sampling removes modulo bias. The harness's fixed selection
+    # algorithm uses SHA-256(seed || uint64be(counter)), starting at zero.
+    limit = 2**256 - (2**256 % bound)
+    while True:
+        require(counter < 2**64, "SELECTION_STREAM_EXHAUSTED")
+        word = int.from_bytes(sha256(seed + counter.to_bytes(8, "big")).digest(), "big")
+        counter += 1
+        if word < limit:
+            return word % bound, counter
+
+
+def plan_advisory(round_id, stratum_id, evidence_set, families):
+    """Plan one declared stratum/evidence set, with no label input.
+
+    families is a local API mapping family id to unique finding ids. Output
+    is a local sampling plan, not an ENV/ledger record. Both N_j and a_j stay
+    explicit; repository-level disclosure remains a separate caller duty.
+    Partial Fisher-Yates draws uniformly without replacement from ids sorted
+    by CAN bytes. Sorting chosen ids makes reporting independent of draw order.
+    The SHA-256 stream algorithm is fixed here for reproducible harness draws;
+    QD-24 supplies its seed, rate, allocation and without-replacement rule.
+    """
+    require(type(families) is dict and len(families) <= 4096, "FAMILY_POPULATIONS")
+    canonical({"roundId": round_id, "stratumId": stratum_id,
+               "evidenceSet": evidence_set, "families": families})
+    # Validate context even for an empty population.
+    selection_seed(round_id, stratum_id, evidence_set, "validation")
+    seen = set()
+    for family, ids in families.items():
+        _label(family)
+        require(type(ids) is list and len(ids) <= 100000, "FINDING_IDS")
+        for iid in ids:
+            _label(iid)
+            require(iid not in seen, "DUPLICATE_FINDING_ID")
+            seen.add(iid)
+    require(len(seen) <= 100000, "POPULATION_LIMIT")
+    counts = {family: len(ids) for family, ids in families.items()}
+    cap, allocation = water_fill(counts)
+    result = []
+    for family in sorted(families, key=canonical):
+        ids = sorted(families[family], key=canonical)
+        seed = selection_seed(round_id, stratum_id, evidence_set, family)
+        counter = 0
+        for i in range(allocation[family]):
+            offset, counter = _draw(seed, len(ids) - i, counter)
+            j = i + offset
+            ids[i], ids[j] = ids[j], ids[i]
+        selected = sorted(ids[:allocation[family]], key=canonical)
+        result.append({"family": family, "corpusFindings": counts[family],
+                       "sampledFindings": allocation[family],
+                       "seed": seed.hex(), "findingIds": selected})
+    return {"stratumId": stratum_id, "evidenceSet": evidence_set,
+            "cap": cap, "target": min(100, len(seen)), "families": result}
