+"""Synthetic QD-24 arithmetic/selection controls; no actual evidence draws."""
+import copy
+from hashlib import sha256
+import pathlib
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import Refusal
+from allocation import water_fill, selection_seed, plan_advisory, _draw
+
+
+class AllocationTests(unittest.TestCase):
+    def test_reviewed_counterexample(self):
+        counts = {"large": 100, **{f"small-{i}": 1 for i in range(28)}}
+        cap, samples = water_fill(counts)
+        self.assertEqual(cap, 72)
+        self.assertEqual(samples, {"large": 72, **{f"small-{i}": 1 for i in range(28)}})
+        self.assertEqual(sum(samples.values()), 100)
+
+    def test_at_least_one_hundred_families(self):
+        cap, samples = water_fill({f"f-{i}": 99 for i in range(105)})
+        self.assertEqual(cap, 1)
+        self.assertEqual(set(samples.values()), {1})
+        self.assertEqual(sum(samples.values()), 105)
+
+    def test_small_populations_are_census(self):
+        for counts in ({}, {"empty": 0}, {"a": 3, "b": 20}, {"a": 99, "b": 1}):
+            cap, samples = water_fill(counts)
+            self.assertGreaterEqual(cap, 1)
+            self.assertEqual(samples, counts)
+
+    def test_cap_minimality_against_independent_exhaustion(self):
+        # Independently enumerate candidate caps instead of duplicating search.
+        for a in (0, 1, 9, 100, 1000):
+            for b in (0, 1, 37, 100, 500):
+                for c in (0, 1, 90):
+                    counts = {"a": a, "b": b, "c": c}
+                    target = min(100, a + b + c)
+                    expected = next(x for x in range(1, 101)
+                                    if min(a, x) + min(b, x) + min(c, x) >= target)
+                    cap, samples = water_fill(counts)
+                    self.assertEqual(cap, expected)
+                    self.assertGreaterEqual(sum(samples.values()), target)
+                    if a + b + c > 100:
+                        self.assertLess(sum(samples.values()) - 100, sum(n > 0 for n in counts.values()))
+
+    def test_exact_uint64_counts_and_sum(self):
+        self.assertEqual(water_fill({"large": 2**64 - 1}), (100, {"large": 100}))
+        for counts in ({"a": True}, {"a": 3.0}, {"a": -1}, {"a": 2**64},
+                       {"a": 2**64 - 1, "b": 1}, {"": 1}, {"a": "1"}):
+            with self.assertRaises(Refusal):
+                water_fill(counts)
+
+    def test_literal_seed_and_all_coordinates(self):
+        expected = sha256(b"roundstratumheld-outfamily").digest()
+        self.assertEqual(selection_seed("round", "stratum", "held-out", "family"), expected)
+        original = ("round", "stratum", "held-out", "family")
+        for i, value in enumerate(("round2", "stratum2", "development", "family2")):
+            args = list(original)
+            args[i] = value
+            self.assertNotEqual(selection_seed(*args), expected)
+
+    def test_selection_is_order_invariant_and_immutable(self):
+        families = {"b": [f"b-{i}" for i in range(120)], "a": [f"a-{i}" for i in range(80)]}
+        before = copy.deepcopy(families)
+        result = plan_advisory("r", "s", "held-out", families)
+        permuted = {k: list(reversed(v)) for k, v in reversed(list(families.items()))}
+        self.assertEqual(result, plan_advisory("r", "s", "held-out", permuted))
+        self.assertEqual(families, before)
+        self.assertEqual(result["cap"], 50)
+        for row in result["families"]:
+            self.assertEqual(row["sampledFindings"], 50)
+            self.assertEqual(len(row["findingIds"]), 50)
+            self.assertEqual(len(set(row["findingIds"])), 50)
+            self.assertTrue(set(row["findingIds"]) <= set(families[row["family"]]))
+
+    def test_small_population_and_empty_plan(self):
+        self.assertEqual(plan_advisory("r", "s", "development", {})["families"], [])
+        result = plan_advisory("r", "s", "development", {"f": ["b", "a"]})
+        row = result["families"][0]
+        self.assertEqual((result["target"], row["corpusFindings"], row["sampledFindings"]), (2, 2, 2))
+        self.assertEqual(row["findingIds"], ["a", "b"])
+
+    def test_duplicate_ids_and_context_refused(self):
+        for populations in ({"f": ["x", "x"]}, {"a": ["x"], "b": ["x"]},
+                            {"f": [True]}, {"f": [""]}, {"f": "x"}):
+            with self.assertRaises(Refusal):
+                plan_advisory("r", "s", "held-out", populations)
+        for context in [("", "s", "held-out"), ("r", True, "held-out"), ("r", "s", "other")]:
+            with self.assertRaises(Refusal):
+                plan_advisory(*context, {})
+
+    def test_rejection_removes_modulo_bias_and_increments_counter(self):
+        class Word:
+            def __init__(self, n): self.n = n
+            def digest(self): return self.n.to_bytes(32, "big")
+        with patch("allocation.sha256", side_effect=[Word(2**256 - 1), Word(7)]) as h:
+            value, counter = _draw(b"s" * 32, 3, 0)
+            self.assertEqual((value, counter), (1, 2))
+            self.assertEqual(h.call_args_list[0].args[0], b"s" * 32 + b"\0" * 8)
+            self.assertEqual(h.call_args_list[1].args[0], b"s" * 32 + (1).to_bytes(8, "big"))
+        with self.assertRaises(Refusal):
+            _draw(b"s" * 32, 3, 2**64)
+
+    def test_no_evidence_set_pooling(self):
+        families = {"f": [f"id-{i}" for i in range(150)]}
+        held = plan_advisory("r", "s", "held-out", families)
+        dev = plan_advisory("r", "s", "development", families)
+        self.assertNotEqual(held["families"][0]["seed"], dev["families"][0]["seed"])
+        self.assertEqual(held["target"], dev["target"])
+
+
+if __name__ == "__main__":
+    unittest.main()
