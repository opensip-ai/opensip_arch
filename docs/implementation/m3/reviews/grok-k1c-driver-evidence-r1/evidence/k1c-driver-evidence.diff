+"""Synthetic driver-evidence joins; no workload/producer or measurement."""
+import copy
+import hashlib
+import pathlib
+import sys
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
+from canonical import Refusal, canonical
+from driver_evidence import batch_id, validate_driver_evidence
+
+
+def slots(reset):
+    keys = [("warmup", i) for i in range(3)] + [("measured", i) for i in range(7)]
+    return ([("priming", 0)] if reset == "warm" else []) + keys
+
+
+def slot(kind, index):
+    return {"kind": kind, "index": index}
+
+
+def data(reset="cold", ordinal=1, status="no-baseline", final=True, reason=None):
+    bid = batch_id("round", "workload", "core-analyze", reset, "clean", ordinal)
+    row = {"workloadId": "workload", "workflow": "core-analyze", "reset": reset,
+           "control": "clean", "batchId": bid, "batchOrdinal": ordinal,
+           "status": status, "final": final}
+    if reason:
+        row["slotReasons"] = sorted(
+            [{"slot": slot(k, i), "reasons": [reason]} for k, i in slots(reset)],
+            key=canonical)
+    leaves = [{"batchId": bid, "slot": slot(k, i),
+               "leafName": None if reason else f"run-{bid}-{k}-{i}",
+               "leafInode": None if reason else 1,
+               "absentReason": reason} for k, i in slots(reset)]
+    observation = {"batchId": bid, "loadAverageMilli": 0, "cpuFrequencyPolicy": "fixed",
+                   "swapBytesInUse": 0, "powerState": "AC", "corpusStoreLocal": True,
+                   "onlineCpusBefore": [0, 1, 2, 3], "onlineCpusAfter": [0, 1, 2, 3]}
+    return [row], leaves, [observation]
+
+
+class EvidenceTests(unittest.TestCase):
+    def check(self, parts):
+        return validate_driver_evidence("round", *parts)
+
+    def test_canonical_tuple_matches_independent_literal_preimage(self):
+        raw = b'["round","workload","core-analyze","cold","clean",1]'
+        self.assertEqual(batch_id("round", "workload", "core-analyze", "cold", "clean", 1),
+                         hashlib.sha256(raw).hexdigest())
+        original = ["round", "workload", "core-analyze", "cold", "clean", 1]
+        alternatives = ["next", "other", "first-use", "warm", "missing-input", 2]
+        for index, replacement in enumerate(alternatives):
+            changed = list(original)
+            changed[index] = replacement
+            self.assertNotEqual(batch_id(*original), batch_id(*changed))
+
+    def test_complete_cold_and_warm_batches(self):
+        for reset, count in (("cold", 10), ("warm", 11)):
+            result = self.check(data(reset))
+            self.assertEqual(result["slots"], count)
+            self.assertEqual(result["createdLeaves"], count)
+            self.assertEqual(result["absentLeaves"], 0)
+            self.assertFalse(result["productQualification"])
+
+    def test_every_absent_host_reason_and_no_duplicate_null_leaf(self):
+        for reason in ("cgroup-unavailable", "cgroup-v1-only", "cgroup-no-delegation",
+                       "memory-peak-unavailable-platform", "cgroup-escape-unprevented",
+                       "cgroup-isolation-unverified"):
+            result = self.check(data("warm", status="incomplete", reason=reason))
+            self.assertEqual(result["absentLeaves"], 11)
+            self.assertEqual(result["createdLeaves"], 0)
+
+    def test_last_retry_is_final_even_if_worse(self):
+        for first, second in (("over", "within"), ("over", "over"),
+                              ("incomplete", "over"), ("over", "incomplete")):
+            one = data(status=first, final=False,
+                       reason="cgroup-unavailable" if first == "incomplete" else None)
+            two = data(ordinal=2, status=second,
+                       reason="cgroup-unavailable" if second == "incomplete" else None)
+            combined = tuple(a + b for a, b in zip(one, two))
+            self.assertEqual(self.check(combined)["batches"], 2)
+            combined[0][0]["final"], combined[0][1]["final"] = True, False
+            with self.assertRaises(Refusal):
+                self.check(combined)
+
+    def test_retry_needs_retained_failed_initial_batch(self):
+        with self.assertRaises(Refusal):
+            self.check(data(ordinal=2))
+        for status in ("within", "no-baseline"):
+            one, two = data(status=status, final=False), data(ordinal=2)
+            with self.assertRaises(Refusal):
+                self.check(tuple(a + b for a, b in zip(one, two)))
+
+    def test_batch_identity_duplicates_and_final_boolean(self):
+        parts = data()
+        parts[0][0]["batchId"] = "0" * 64
+        with self.assertRaises(Refusal):
+            self.check(parts)
+        parts = data()
+        parts[0].append(copy.deepcopy(parts[0][0]))
+        with self.assertRaises(Refusal):
+            self.check(parts)
+        parts = data()
+        parts[0][0]["final"] = 1
+        with self.assertRaises(Refusal):
+            self.check(parts)
+        parts[0][0]["final"] = False
+        with self.assertRaises(Refusal):
+            self.check(parts)
+
+    def test_leaf_exact_coverage_no_orphans_or_duplicates(self):
+        for corrupt in (lambda p: p[1].pop(), lambda p: p[1].append(copy.deepcopy(p[1][0])),
+                        lambda p: p[1][0].update(batchId="0" * 64),
+                        lambda p: p[1][0].update(slot=slot("priming", 0)),
+                        lambda p: p[1][0].update(leafName=p[1][1]["leafName"]),
+                        lambda p: p[1][0].update(leafInode=True),
+                        lambda p: p[1][0].update(leafInode=0)):
+            parts = data()
+            corrupt(parts)
+            with self.assertRaises(Refusal):
+                self.check(parts)
+
+    def test_observation_exact_coverage_no_orphans_or_duplicates(self):
+        for corrupt in (lambda p: p[2].clear(), lambda p: p[2].append(copy.deepcopy(p[2][0])),
+                        lambda p: p[2][0].update(batchId="0" * 64),
+                        lambda p: p[2][0].update(corpusStoreLocal=1),
+                        lambda p: p[2][0].update(onlineCpusBefore=[0, 0]),
+                        lambda p: p[2][0].update(onlineCpusBefore=[True]),
+                        lambda p: p[2][0].update(onlineCpusBefore=[65536]),
+                        lambda p: p[2][0].update(loadAverageMilli=-1)):
+            parts = data()
+            corrupt(parts)
+            with self.assertRaises(Refusal):
+                self.check(parts)
+
+    def test_after_creation_reason_cannot_be_an_absent_leaf(self):
+        for reason in ("cgroup-read-failed", "cgroup-not-empty", "record-missing"):
+            with self.assertRaises(Refusal):
+                self.check(data(status="incomplete", reason=reason))
+
+    def test_missing_operational_record_never_removes_driver_leaf(self):
+        parts = data()
+        parts[0][0].update(status="incomplete", slotReasons=[
+            {"slot": slot("warmup", 0), "reasons": ["record-missing"]}])
+        self.assertEqual(self.check(parts)["createdLeaves"], 10)
+        parts[1].pop(0)
+        with self.assertRaises(Refusal):
+            self.check(parts)
+
+    def test_absent_reason_must_match_that_specific_slot(self):
+        parts = data(status="incomplete", reason="cgroup-unavailable")
+        parts[0][0]["slotReasons"].pop(0)
+        with self.assertRaises(Refusal):
+            self.check(parts)
+        parts = data(status="incomplete", reason="cgroup-unavailable")
+        parts[1][0]["leafInode"] = 1
+        with self.assertRaises(Refusal):
+            self.check(parts)
+
+    def test_reason_status_and_canonical_uniqueness(self):
+        edits = [lambda p: p[0][0].update(slotReasons=[]),
+                 lambda p: p[0][0].update(status="within"),
+                 lambda p: p[0][0]["slotReasons"].append(copy.deepcopy(p[0][0]["slotReasons"][0])),
+                 lambda p: p[0][0]["slotReasons"][0].update(reasons=["cgroup-unavailable"] * 2),
+                 lambda p: p[0][0]["slotReasons"][0].update(reasons=["event-loss"])]
+        for edit in edits:
+            parts = data(status="incomplete", reason="cgroup-unavailable")
+            edit(parts)
+            with self.assertRaises(Refusal):
+                self.check(parts)
+        parts = data()
+        parts[0][0]["slotReasons"] = []
+        with self.assertRaises(Refusal):
+            self.check(parts)
+
+    def test_multiple_keys_do_not_mix_retry_groups(self):
+        one, two = data(), data("warm")
+        combined = tuple(a + b for a, b in zip(one, two))
+        result = self.check(combined)
+        self.assertEqual(result["batches"], 2)
+        self.assertEqual(result["slots"], 21)
+
+    def test_no_mutation_and_empty_unmeasured_population(self):
+        parts = data()
+        before = copy.deepcopy(parts)
+        self.check(parts)
+        self.assertEqual(parts, before)
+        self.assertEqual(self.check(([], [], []))["batches"], 0)
+
+    def test_key_fields_refuse_aliases_bool_and_unbounded_labels(self):
+        base = ["round", "workload", "core-analyze", "cold", "clean", 1]
+        for index, value in ((0, ""), (1, "a" * 4097), (2, "analyze"),
+                             (3, "flushed"), (4, "broken"), (5, True), (5, 3)):
+            key = list(base)
+            key[index] = value
+            with self.assertRaises(Refusal):
+                batch_id(*key)
+
+
+if __name__ == "__main__":
+    unittest.main()
