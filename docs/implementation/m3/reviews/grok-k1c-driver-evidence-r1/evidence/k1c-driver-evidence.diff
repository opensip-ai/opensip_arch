+"""Q0 r13 §9.5 driver evidence joins and retry/final selection.
+
+Pure cross-row component: no workload, cgroup or instrumentation execution.
+Schema admission, physical settlement/isolation proof, sample accounting,
+phase records, compatible baselines and D12 eligibility remain separate checks.
+"""
+from canonical import canonical, digest, pin
+from measurement import RUN_REASONS, _slot
+from records import require
+
+
+ABSENT_REASONS = frozenset({
+    "cgroup-unavailable", "cgroup-v1-only", "cgroup-no-delegation",
+    "memory-peak-unavailable-platform", "cgroup-escape-unprevented",
+    "cgroup-isolation-unverified",
+})
+
+
+def _label(value):
+    require(type(value) is str and 1 <= len(value) <= 4096, "LABEL_REQUIRED")
+
+
+def _count(value, *, positive=False, maximum=2**64 - 1):
+    require(type(value) is int and (1 if positive else 0) <= value <= maximum,
+            "EXACT_COUNT_REQUIRED")
+
+
+def batch_id(round_id, workload_id, workflow, reset, control, ordinal):
+    """QD-20's canonical ordered six-tuple, with the CAN unframed SHA-256."""
+    _label(round_id)
+    _label(workload_id)
+    require(type(workflow) is str and workflow in {
+        "core-analyze", "first-use", "prep-invalidating-edit"}, "WORKFLOW_REQUIRED")
+    require(type(reset) is str and reset in {"cold", "warm"}, "RESET_REQUIRED")
+    require(type(control) is str and control in {
+        "clean", "missing-input", "stale-prepared", "broken-build"}, "CONTROL_REQUIRED")
+    require(type(ordinal) is int and ordinal in {1, 2}, "BATCH_ORDINAL_REQUIRED")
+    return digest([round_id, workload_id, workflow, reset, control, ordinal])
+
+
+def _reasons(row, expected):
+    incomplete = row["status"] == "incomplete"
+    if not incomplete:
+        require("slotReasons" not in row, "COMPLETE_ROW_REASON_FIELD")
+        return {}
+    rows = row.get("slotReasons")
+    require(type(rows) is list and 1 <= len(rows) <= len(expected), "SLOT_REASONS_REQUIRED")
+    by_slot = {}
+    for item in rows:
+        require(type(item) is dict and set(item) == {"slot", "reasons"}, "SLOT_REASON_SHAPE")
+        key = _slot(item["slot"])
+        require(key in expected and key not in by_slot, "SLOT_REASON_COVERAGE")
+        reasons = item["reasons"]
+        require(type(reasons) is list and 1 <= len(reasons) <= 16 and
+                all(type(r) is str and r in RUN_REASONS for r in reasons), "RUN_REASONS_REQUIRED")
+        require(reasons == sorted(set(reasons), key=canonical), "RUN_REASONS_CANONICAL_SET")
+        by_slot[key] = frozenset(reasons)
+    require(rows == sorted(rows, key=canonical), "SLOT_REASONS_CANONICAL_SET")
+    return by_slot
+
+
+def validate_driver_evidence(round_id, workloads, leaves, observations):
+    """Check the component's identity, coverage, uniqueness and orphan rules.
+
+    Workloads are full Q6 rows after separate closed-schema checks; this
+    component reads their key/status/reasons/final fields only. Leaf and batch
+    observation shapes are closed here. Returned counts prove no measurement.
+    """
+    _label(round_id)
+    require(type(workloads) is list and len(workloads) <= 4096, "WORKLOAD_ARRAY")
+    require(type(leaves) is list and len(leaves) <= 100000, "LEAF_ARRAY")
+    require(type(observations) is list and len(observations) <= 100000, "OBSERVATION_ARRAY")
+    canonical({"workloads": workloads, "cgroupLeaves": leaves,
+               "batchObservations": observations})
+    batches, groups = {}, {}
+    for row in workloads:
+        required = {"workloadId", "workflow", "reset", "control", "batchId",
+                    "batchOrdinal", "final", "status"}
+        require(type(row) is dict and required <= row.keys(), "BATCH_KEY_FIELDS")
+        expected_id = batch_id(round_id, row["workloadId"], row["workflow"],
+                               row["reset"], row["control"], row["batchOrdinal"])
+        require(type(row["batchId"]) is str and row["batchId"] == expected_id,
+                "BATCH_ID_MISMATCH")
+        require(expected_id not in batches, "DUPLICATE_BATCH")
+        require(type(row["final"]) is bool, "FINAL_BOOLEAN_REQUIRED")
+        require(type(row["status"]) is str and row["status"] in {
+            "within", "over", "no-baseline", "incomplete"}, "Q6_STATUS_REQUIRED")
+        slots = {("warmup", i) for i in range(3)} | {("measured", i) for i in range(7)}
+        if row["reset"] == "warm":
+            slots.add(("priming", 0))
+        batches[expected_id] = (slots, _reasons(row, slots))
+        key = (row["workloadId"], row["workflow"], row["reset"], row["control"])
+        groups.setdefault(key, []).append(row)
+    for rows in groups.values():
+        by_ordinal = {row["batchOrdinal"]: row for row in rows}
+        require(1 in by_ordinal, "INITIAL_BATCH_MISSING")
+        if 2 in by_ordinal:
+            require(by_ordinal[1]["status"] in {"over", "incomplete"}, "RETRY_WITHOUT_FAILURE")
+        last = max(by_ordinal)
+        require(all(row["final"] == (row["batchOrdinal"] == last) for row in rows),
+                "FINAL_MUST_BE_LAST_BATCH")
+
+    observed = set()
+    observation_fields = {"batchId", "loadAverageMilli", "cpuFrequencyPolicy",
+                          "swapBytesInUse", "powerState", "corpusStoreLocal",
+                          "onlineCpusBefore", "onlineCpusAfter"}
+    for row in observations:
+        require(type(row) is dict and set(row) == observation_fields, "OBSERVATION_SHAPE")
+        bid = row["batchId"]
+        require(pin(bid) and bid in batches and bid not in observed, "OBSERVATION_BATCH_JOIN")
+        _count(row["loadAverageMilli"])
+        _count(row["swapBytesInUse"])
+        _label(row["cpuFrequencyPolicy"])
+        _label(row["powerState"])
+        require(type(row["corpusStoreLocal"]) is bool, "OBSERVATION_LOCAL_BOOLEAN")
+        for field in ("onlineCpusBefore", "onlineCpusAfter"):
+            cpus = row[field]
+            require(type(cpus) is list and len(cpus) <= 4096, "CPU_SET_REQUIRED")
+            for cpu in cpus:
+                _count(cpu, maximum=65535)
+            require(cpus == sorted(set(cpus), key=canonical), "CPU_CANONICAL_SET")
+        observed.add(bid)
+    require(observed == batches.keys(), "OBSERVATION_COVERAGE")
+
+    leaf_fields = {"batchId", "slot", "leafName", "leafInode", "absentReason"}
+    seen, created_names = set(), set()
+    absent = 0
+    for row in leaves:
+        require(type(row) is dict and set(row) == leaf_fields, "LEAF_SHAPE")
+        bid = row["batchId"]
+        require(pin(bid) and bid in batches, "LEAF_BATCH_JOIN")
+        slot = _slot(row["slot"])
+        slots, reasons = batches[bid]
+        key = bid, slot
+        require(slot in slots and key not in seen, "LEAF_SLOT_COVERAGE")
+        if row["leafName"] is None:
+            reason = row["absentReason"]
+            require(row["leafInode"] is None and type(reason) is str and
+                    reason in ABSENT_REASONS and reason in reasons.get(slot, ()),
+                    "ABSENT_LEAF_REASON_JOIN")
+            absent += 1
+        else:
+            name = f"run-{bid}-{slot[0]}-{slot[1]}"
+            require(type(row["leafName"]) is str and row["leafName"] == name and
+                    row["absentReason"] is None, "CREATED_LEAF_SHAPE")
+            _count(row["leafInode"], positive=True)
+            require(name not in created_names, "DUPLICATE_CREATED_LEAF")
+            created_names.add(name)
+        seen.add(key)
+    expected = {(bid, slot) for bid, (slots, _) in batches.items() for slot in slots}
+    require(seen == expected, "LEAF_COVERAGE")
+    return {"batches": len(batches), "slots": len(expected),
+            "createdLeaves": len(created_names), "absentLeaves": absent,
+            "productQualification": False}
