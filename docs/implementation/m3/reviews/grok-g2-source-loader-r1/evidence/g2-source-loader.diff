+//! Pinned rustc-private bridge, compiled in the coherent G2 authoring lane.
+//!
+//! Not connected to the development provider entry point. The caller must
+//! install this loader in `rustc_interface::interface::Config::file_loader`.
+//! Other compiler reads, tool closures, environment and prepared-output
+//! substitution require their separate admissions and integration.
+
+use super::sealed_vfs::SealedSource;
+use rustc_span::source_map::FileLoader;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+impl FileLoader for SealedSource {
+    fn file_exists(&self, path: &Path) -> bool {
+        SealedSource::file_exists(self, path)
+    }
+
+    fn read_file(&self, path: &Path) -> io::Result<String> {
+        SealedSource::read_file(self, path)
+    }
+
+    fn read_binary_file(&self, path: &Path) -> io::Result<Arc<[u8]>> {
+        SealedSource::read_binary_file(self, path)
+    }
+
+    fn current_directory(&self) -> io::Result<PathBuf> {
+        Ok(SealedSource::current_directory(self))
+    }
+}
