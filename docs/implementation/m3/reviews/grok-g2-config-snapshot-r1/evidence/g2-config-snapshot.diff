+//! Declared Cargo configuration/snapshot byte joins for compiler authoring.
+//!
+//! These observations do not verify an ancestor carrier, admit configuration
+//! semantics, create a materialization, invoke Cargo or authorize execution.
+
+use opensip_identity::{
+    DigestError, GraphError, IdentityDomain, JsonValue, NativeFrameSet, RetainedInputError,
+    RetainedInputs, hash_canonical_value,
+};
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+#[derive(Debug)]
+pub enum ConfigSnapshotError {
+    Frame(GraphError),
+    Retained(RetainedInputError),
+    Digest(DigestError),
+    Representation,
+    ForeignContext,
+    ReplacementInventory,
+    HostContextMismatch,
+}
+impl From<RetainedInputError> for ConfigSnapshotError {
+    fn from(value: RetainedInputError) -> Self {
+        Self::Retained(value)
+    }
+}
+
+/// Inert retained bytes and observed identities; no materialization authority.
+#[derive(Debug)]
+pub struct ConfigSnapshotChecks {
+    context_digest: [u8; 32],
+    projection_identity: [u8; 32],
+    projected_file: Arc<[u8]>,
+    replacement_count: usize,
+}
+impl ConfigSnapshotChecks {
+    pub fn context_digest(&self) -> [u8; 32] {
+        self.context_digest
+    }
+    /// H(native.cargo-config-projection.v2, record), not the raw file hash.
+    pub fn projection_identity(&self) -> [u8; 32] {
+        self.projection_identity
+    }
+    pub fn projected_file(&self) -> &[u8] {
+        &self.projected_file
+    }
+    pub fn replacement_count(&self) -> usize {
+        self.replacement_count
+    }
+}
+
+/// Retain the declared projected file and join all replaced snapshot configs.
+///
+/// Recompute the exact current Rust context frame and snapshot2 descriptor.
+/// CC-5 covers .cargo/config and .cargo/config.toml at any snapshot directory;
+/// their exact set must equal replacedSnapshotConfigs, with every original's
+/// hash and byte length checked. The projected file is retained by its raw
+/// projectionSha256; its bytes are not parsed or used to admit honored flags.
+/// The H identity of the entire projection record is computed separately.
+///
+/// Caller supplies its admitted host context selection and owns full snapshot,
+/// configuration semantics, carrier/environment/signature and process admission.
+/// A schema constant such as ancestorCarrierVerified proves no filesystem check
+/// occurred here. Success permits no Cargo/compiler invocation or ambient read.
+pub fn check_declared_config(
+    inputs: &RetainedInputs<'_>,
+    snapshot_id: &str,
+    context_digest: [u8; 32],
+    expected_host_digest: [u8; 32],
+    schema_work: usize,
+) -> Result<ConfigSnapshotChecks, ConfigSnapshotError> {
+    let context = inputs
+        .frame_candidate(context_digest, NativeFrameSet::Context, schema_work)
+        .map_err(ConfigSnapshotError::Frame)?;
+    if context.domain() != "native.context.rust.v2" {
+        return Err(ConfigSnapshotError::ForeignContext);
+    }
+    let projection_value = field(map(context.descriptor())?, "configProjection")?;
+    let projection = map(projection_value)?;
+    let snapshot = inputs.object(snapshot_id, IdentityDomain::Snapshot, schema_work)?;
+    let rows = array(field(map(snapshot.descriptor())?, "sourceInventory")?)?;
+    let mut originals = BTreeMap::new();
+    for row in rows {
+        let row = map(row)?;
+        let path = text(field(row, "path")?)?;
+        if config_path(path) {
+            originals.insert(path, row);
+        }
+    }
+    let replacements = array(field(projection, "replacedSnapshotConfigs")?)?
+        .iter()
+        .map(text)
+        .collect::<Result<BTreeSet<_>, _>>()?;
+    if replacements != originals.keys().copied().collect() {
+        return Err(ConfigSnapshotError::ReplacementInventory);
+    }
+    for row in originals.values() {
+        let sha = raw_digest(text(field(row, "sha256")?)?)?;
+        let JsonValue::Integer(length) = field(row, "bytes")? else {
+            return Err(ConfigSnapshotError::Representation);
+        };
+        let length =
+            u64::try_from(length.get()).map_err(|_| ConfigSnapshotError::Representation)?;
+        inputs.blob(sha)?.require_length(length)?;
+    }
+    let projected = inputs.blob(raw_digest(text(field(projection, "projectionSha256")?)?)?)?;
+    let projection_identity =
+        hash_canonical_value("native.cargo-config-projection.v2", projection_value)
+            .map_err(ConfigSnapshotError::Digest)?;
+    if context.digest() != expected_host_digest {
+        return Err(ConfigSnapshotError::HostContextMismatch);
+    }
+    Ok(ConfigSnapshotChecks {
+        context_digest: context.digest(),
+        projection_identity,
+        projected_file: Arc::from(projected.bytes()),
+        replacement_count: replacements.len(),
+    })
+}
+
+fn config_path(path: &str) -> bool {
+    matches!(path, ".cargo/config" | ".cargo/config.toml")
+        || path.ends_with("/.cargo/config")
+        || path.ends_with("/.cargo/config.toml")
+}
+fn map(value: &JsonValue) -> Result<&BTreeMap<String, JsonValue>, ConfigSnapshotError> {
+    match value {
+        JsonValue::Object(value) => Ok(value),
+        _ => Err(ConfigSnapshotError::Representation),
+    }
+}
+fn field<'a>(
+    value: &'a BTreeMap<String, JsonValue>,
+    key: &str,
+) -> Result<&'a JsonValue, ConfigSnapshotError> {
+    value.get(key).ok_or(ConfigSnapshotError::Representation)
+}
+fn text(value: &JsonValue) -> Result<&str, ConfigSnapshotError> {
+    match value {
+        JsonValue::String(value) => Ok(value),
+        _ => Err(ConfigSnapshotError::Representation),
+    }
+}
+fn array(value: &JsonValue) -> Result<&[JsonValue], ConfigSnapshotError> {
+    match value {
+        JsonValue::Array(value) => Ok(value),
+        _ => Err(ConfigSnapshotError::Representation),
+    }
+}
+fn raw_digest(value: &str) -> Result<[u8; 32], ConfigSnapshotError> {
+    if value.len() != 64 {
+        return Err(ConfigSnapshotError::Representation);
+    }
+    let mut result = [0; 32];
+    for (i, pair) in value.as_bytes().chunks_exact(2).enumerate() {
+        let digit = |b| match b {
+            b'0'..=b'9' => Ok(b - b'0'),
+            b'a'..=b'f' => Ok(b - b'a' + 10),
+            _ => Err(ConfigSnapshotError::Representation),
+        };
+        result[i] = digit(pair[0])? << 4 | digit(pair[1])?;
+    }
+    Ok(result)
+}
