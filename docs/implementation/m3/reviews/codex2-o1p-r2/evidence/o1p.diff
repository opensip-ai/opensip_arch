+/// User plus system CPU time of this process, from `getrusage(RUSAGE_SELF)`.
+/// Law M3-O1 item 2. It feeds `host.phase.completed`'s `cpu` once that event exists.
+#[allow(unsafe_code)]
+pub fn process_cpu_time() -> Result<Duration, ClockError> {
+    // SAFETY: rusage is a plain integer struct. Zero is a value getrusage overwrites.
+    let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+    // SAFETY: usage is a live writable rusage, and RUSAGE_SELF is the fixed target.
+    let code = unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut usage) };
+    if code != 0 {
+        return cpu_time_from_status(code, io::Error::last_os_error(), &usage);
+    }
+    rusage_duration(&usage)
+}
+pub(crate) fn cpu_time_from_status(
+    code: i32,
+    failure: io::Error,
+    usage: &libc::rusage,
+) -> Result<Duration, ClockError> {
+    if code != 0 {
+        return Err(error("process cpu time")(failure));
+    }
+    rusage_duration(usage)
+}
+fn clock_i64(value: impl Into<i64>) -> i64 {
+    value.into()
+}
+fn rusage_duration(usage: &libc::rusage) -> Result<Duration, ClockError> {
+    let user = timeval_duration(
+        clock_i64(usage.ru_utime.tv_sec),
+        clock_i64(usage.ru_utime.tv_usec),
+    )?;
+    let system = timeval_duration(
+        clock_i64(usage.ru_stime.tv_sec),
+        clock_i64(usage.ru_stime.tv_usec),
+    )?;
+    user.checked_add(system)
+        .ok_or(ClockError::InvalidObservation(
+            "process cpu time overflowed",
+        ))
+}
+fn timeval_duration(seconds: i64, micros: i64) -> Result<Duration, ClockError> {
+    if seconds < 0 || !(0..1_000_000).contains(&micros) {
+        return Err(ClockError::InvalidObservation(
+            "process cpu time is not a duration",
+        ));
+    }
+    let seconds = u64::try_from(seconds)
+        .map_err(|_| ClockError::InvalidObservation("process cpu time is not a duration"))?;
+    let nanos = u32::try_from(micros * 1_000)
+        .map_err(|_| ClockError::InvalidObservation("process cpu time is not a duration"))?;
+    Ok(Duration::new(seconds, nanos))
+}
