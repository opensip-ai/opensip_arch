+//! `dispose` consumes a `Result` and does nothing else.
+//! Law M3-O1 item 20. O1-S migrates call sites; this unit only provides the helper.
+
+/// Why a consumed failure changes no result.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Disposition {
+    /// Cleanup after the outcome is decided. Its failure changes no result.
+    BestEffortCleanup,
+    /// The failure is already carried by a typed result or a record.
+    AlreadyReported,
+    /// Termination or crash path, where nothing more can be reported.
+    /// The checker allows this only in the listed termination files.
+    ShutdownPath,
+    /// Test-support code compiled only under a test `cfg` or a test-only feature.
+    /// The checker allows this only in a test-only file.
+    TestOnly,
+    /// The callee cannot fail for this receiver.
+    Infallible,
+}
+
+/// Consume `result`. No record, no I/O and no allocation.
+pub fn dispose<T, E>(_result: Result<T, E>, _why: Disposition) {}
+
+#[cfg(test)]
+mod tests {
+    use super::{Disposition, dispose};
+
+    #[test]
+    fn dispose_consumes_a_result_and_returns_nothing() {
+        dispose(Ok::<u8, &str>(1), Disposition::Infallible);
+        dispose(
+            Err::<u8, &str>("already carried"),
+            Disposition::AlreadyReported,
+        );
+        dispose(Ok::<(), std::io::Error>(()), Disposition::BestEffortCleanup);
+    }
+}
