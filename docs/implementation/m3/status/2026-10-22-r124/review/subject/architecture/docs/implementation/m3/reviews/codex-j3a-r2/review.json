    "sourceDelta": {
      "crates/platform/src/crash_barrier.rs": "--- r1/crates/platform/src/crash_barrier.rs\n+++ r2/crates/platform/src/crash_barrier.rs\n@@ -784,7 +784,10 @@\n         .reserved\n         .insert(bytes)\n     {\n-        Ok(crate::ReservedExecutionId::reserved(bytes))\n+        Ok(crate::ReservedExecutionId {\n+            bytes,\n+            rendered: crate::render_id(\"exec1_\", &bytes),\n+        })\n     } else {\n         Err(InjectedExecutionId::Reserved)\n     }\n",
      "crates/platform/src/lib.rs": "--- r1/crates/platform/src/lib.rs\n+++ r2/crates/platform/src/lib.rs\n@@ -122,12 +122,6 @@\n     }\n }\n impl ReservedExecutionId {\n-    fn reserved(bytes: [u8; 16]) -> Self {\n-        Self {\n-            bytes,\n-            rendered: render_id(\"exec1_\", &bytes),\n-        }\n-    }\n     /// The read-only projection: identity \u00a72's `exec1_` and 32 lowercase\n     /// hex.\n     pub fn as_str(&self) -> &str {\n@@ -184,7 +178,12 @@\n         for _ in 0..8 {\n             let bytes = draw().map_err(|_| ExecutionIdUnavailable::Entropy)?;\n             if self.reserved.insert(bytes) {\n-                return Ok(ReservedExecutionId::reserved(bytes));\n+                // Constructed only after the uniqueness insert. There is no\n+                // inherent constructor (X8 r3 item 3, group F).\n+                return Ok(ReservedExecutionId {\n+                    bytes,\n+                    rendered: render_id(\"exec1_\", &bytes),\n+                });\n             }\n         }\n         Err(ExecutionIdUnavailable::CollisionExhausted)\n"
    }
