(version 1)
; CF-P provider profile (F-3 draft). Parameters: SCRATCH, TARGET, CLOSURE_ROOT (canonical paths).
(allow default)
(deny network*)
(deny file-write* (require-all (require-not (subpath (param "SCRATCH"))) (require-not (literal "/dev/null"))))
(deny file-link (require-not (subpath (param "SCRATCH")))) ;@link
(deny process-fork)
(deny process-exec (require-not (literal (param "TARGET"))))
(deny signal (target others))
(deny process-info* (target others))
(deny mach-lookup) ;@mach
