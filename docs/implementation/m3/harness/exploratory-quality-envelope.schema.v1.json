{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opensip.harness.exploratory-quality-envelope.1",
  "title": "OpenSIP exploratory quality envelope (D13 draft)",
  "description": "Draft for D13 (docs/implementation/m3/analysis-quality/PLAN.md:419-425, :535). Exploratory, never promoted, never a G13 input. References unchanged RS3 observations by digest; RS3 itself is not changed. Proportions and bounds are integer millionths (no floats; canonical bytes per docs/coop/design-corrections/foundation/canonical.py). Design: docs/implementation/m3/harness/DESIGN.md section 11.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaMajor",
    "standing",
    "qualificationEvidence",
    "declaration",
    "roundId",
    "measuredAt",
    "product",
    "harness",
    "corpus",
    "ledger",
    "definitions",
    "runner",
    "tools",
    "rs3Observations",
    "operationalRecords",
    "unqualifiedAdvisoryRules",
    "results"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "nullablePpm": {
      "oneOf": [
        { "$ref": "#/$defs/ppm" },
        { "type": "null" }
      ]
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "language": {
      "enum": ["ts", "js", "rust", "python", "syntax-only"]
    },
    "evidenceSet": {
      "enum": ["held-out", "development"]
    },
    "stratumKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "language", "mode"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/label" },
        "language": { "$ref": "#/$defs/language" },
        "mode": { "$ref": "#/$defs/label" }
      }
    },
    "samples7": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/positiveInt" },
      "x-opensip-order": "sequence"
    }
  },
  "properties": {
    "schemaMajor": { "const": 1 },
    "standing": { "const": "exploratory-never-promoted" },
    "qualificationEvidence": { "const": false },
    "declaration": {
      "const": "Exploratory measurement. Not G13 evidence, not qualification evidence, never promoted. A qualification run re-executes from scratch on the D12 lanes against the held-out set."
    },
    "roundId": { "$ref": "#/$defs/label" },
    "measuredAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "treeClean", "hostDigest", "providerClosureDigest"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "treeClean": { "const": true },
        "hostDigest": { "$ref": "#/$defs/sha256" },
        "providerClosureDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "harnessDigest", "scoringHarnessDigest"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "harnessDigest": { "$ref": "#/$defs/sha256" },
        "scoringHarnessDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t1ManifestDigest", "t2ManifestDigest", "caseSetDigest", "familyMapDigest", "heldOutSetDigest", "heldOutIncluded", "t3"],
      "properties": {
        "t1ManifestDigest": { "$ref": "#/$defs/sha256" },
        "t2ManifestDigest": { "$ref": "#/$defs/sha256" },
        "caseSetDigest": { "$ref": "#/$defs/sha256" },
        "familyMapDigest": { "$ref": "#/$defs/sha256" },
        "heldOutSetDigest": { "$ref": "#/$defs/sha256" },
        "heldOutIncluded": { "type": "boolean" },
        "t3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "localManifestDigest"],
          "properties": {
            "present": { "type": "boolean" },
            "localManifestDigest": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerDigest", "headRecordDigest", "freezeRecordDigest"],
      "properties": {
        "ledgerDigest": { "$ref": "#/$defs/sha256" },
        "headRecordDigest": { "$ref": "#/$defs/sha256" },
        "freezeRecordDigest": { "$ref": "#/$defs/sha256" },
        "t3LedgerDigest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitionsDigest", "preregistrationDigest", "ruleSpecSetDigest", "rubricSetDigest", "designRecordDigest"],
      "properties": {
        "metricDefinitionsDigest": { "$ref": "#/$defs/sha256" },
        "preregistrationDigest": { "$ref": "#/$defs/sha256" },
        "ruleSpecSetDigest": { "$ref": "#/$defs/sha256" },
        "rubricSetDigest": { "$ref": "#/$defs/sha256" },
        "designRecordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerClass", "runnerId", "cpuModel", "logicalCpus", "memoryBytes", "osVersion", "osBuild", "kernel", "filesystem", "concurrency", "networkDisabled", "compilerDigest", "runtimeDigest", "measurementToolDigest", "cacheState"],
      "properties": {
        "runnerClass": { "enum": ["d12-reference", "lead-workstation", "ci"] },
        "runnerId": { "$ref": "#/$defs/label" },
        "cpuModel": { "$ref": "#/$defs/label" },
        "logicalCpus": { "$ref": "#/$defs/positiveInt" },
        "memoryBytes": { "$ref": "#/$defs/positiveInt" },
        "osVersion": { "$ref": "#/$defs/label" },
        "osBuild": { "$ref": "#/$defs/label" },
        "kernel": { "$ref": "#/$defs/label" },
        "filesystem": { "$ref": "#/$defs/label" },
        "concurrency": { "$ref": "#/$defs/positiveInt" },
        "networkDisabled": { "type": "boolean" },
        "compilerDigest": { "$ref": "#/$defs/sha256" },
        "runtimeDigest": { "$ref": "#/$defs/sha256" },
        "measurementToolDigest": { "$ref": "#/$defs/sha256" },
        "cacheState": { "$ref": "#/$defs/label" }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "closureDigest", "role", "executesRepositoryCode"],
        "properties": {
          "name": { "$ref": "#/$defs/label" },
          "version": { "$ref": "#/$defs/label" },
          "closureDigest": { "$ref": "#/$defs/sha256" },
          "configurationDigest": { "$ref": "#/$defs/sha256" },
          "adapterDigest": { "$ref": "#/$defs/sha256" },
          "role": { "enum": ["toolchain", "differential", "formatter", "harness-dependency"] },
          "executesRepositoryCode": { "type": "boolean" }
        }
      },
      "x-opensip-order": "canonical-set"
    },
    "rs3Observations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reportSha256", "schemaId", "signed"],
        "properties": {
          "reportSha256": { "$ref": "#/$defs/sha256" },
          "schemaId": { "const": "opensip.qualification.product-report.3" },
          "signed": { "type": "boolean" }
        }
      },
      "x-opensip-order": "canonical-set"
    },
    "operationalRecords": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordSha256", "workloadId", "runIndex", "carriesReuseDisclosure"],
        "properties": {
          "recordSha256": { "$ref": "#/$defs/sha256" },
          "workloadId": { "$ref": "#/$defs/label" },
          "runIndex": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "carriesReuseDisclosure": { "type": "boolean" }
        }
      },
      "x-opensip-order": "canonical-set"
    },
    "unqualifiedAdvisoryRules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stratum", "reason"],
        "properties": {
          "stratum": { "$ref": "#/$defs/stratumKey" },
          "reason": { "enum": ["fail", "insufficient-evidence"] }
        }
      },
      "x-opensip-order": "canonical-set"
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8"],
      "properties": {
        "q1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cells"],
          "properties": {
            "cells": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cellId", "status", "expectedCount", "actualCount", "missingCount", "extraCount", "exitMatches", "rs3ReportSha256"],
                "properties": {
                  "cellId": { "$ref": "#/$defs/label" },
                  "status": { "enum": ["exact", "mismatch"] },
                  "expectedCount": { "$ref": "#/$defs/count" },
                  "actualCount": { "$ref": "#/$defs/count" },
                  "missingCount": { "$ref": "#/$defs/count" },
                  "extraCount": { "$ref": "#/$defs/count" },
                  "exitMatches": { "type": "boolean" },
                  "rs3ReportSha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        },
        "q2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strata"],
          "properties": {
            "strata": {
              "type": "array",
              "maxItems": 8192,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stratum", "evidenceSet", "targetPpm", "method", "status", "families", "findings", "trueCount", "falseCount", "unclearCount", "pendingCount", "censusPrecisionPpm", "resolvedPrecisionPpm", "lowerBoundPpm", "concentrated", "perFamily", "assumption"],
                "properties": {
                  "stratum": { "$ref": "#/$defs/stratumKey" },
                  "evidenceSet": { "$ref": "#/$defs/evidenceSet" },
                  "targetPpm": { "enum": [900000, 990000] },
                  "method": { "enum": ["clopper-pearson-independent", "cluster-product-bound", "none"] },
                  "status": { "enum": ["PASS", "FAIL", "INSUFFICIENT-EVIDENCE", "NOT-YET-ADJUDICATED"] },
                  "families": { "$ref": "#/$defs/count" },
                  "findings": { "$ref": "#/$defs/count" },
                  "trueCount": { "$ref": "#/$defs/count" },
                  "falseCount": { "$ref": "#/$defs/count" },
                  "unclearCount": { "$ref": "#/$defs/count" },
                  "pendingCount": { "$ref": "#/$defs/count" },
                  "censusPrecisionPpm": { "$ref": "#/$defs/nullablePpm" },
                  "resolvedPrecisionPpm": { "$ref": "#/$defs/nullablePpm" },
                  "lowerBoundPpm": { "$ref": "#/$defs/nullablePpm" },
                  "concentrated": { "type": "boolean" },
                  "falsePositivesPerMillionLines": { "$ref": "#/$defs/count" },
                  "findingsPerMillionLines": { "$ref": "#/$defs/count" },
                  "medianTriageMillis": { "$ref": "#/$defs/count" },
                  "perFamily": {
                    "type": "array",
                    "maxItems": 100000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["family", "findings", "trueCount", "precisionPpm"],
                      "properties": {
                        "family": { "$ref": "#/$defs/label" },
                        "findings": { "$ref": "#/$defs/positiveInt" },
                        "trueCount": { "$ref": "#/$defs/count" },
                        "precisionPpm": { "$ref": "#/$defs/ppm" }
                      }
                    },
                    "x-opensip-order": "canonical-set"
                  },
                  "assumption": {
                    "const": "Families are treated as independent draws from the population of repositories the claim is about; T2 is purposely selected, not randomly sampled."
                  }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        },
        "q3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strata", "mutants"],
          "properties": {
            "strata": {
              "type": "array",
              "maxItems": 8192,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stratum", "evidenceSet", "status", "answerablePositives", "hits", "missesDetector", "abstentionsOnAnswerable", "answerableNegatives", "negativesDeterminate", "recallPpm"],
                "properties": {
                  "stratum": { "$ref": "#/$defs/stratumKey" },
                  "evidenceSet": { "$ref": "#/$defs/evidenceSet" },
                  "status": { "enum": ["measured", "insufficient"] },
                  "answerablePositives": { "$ref": "#/$defs/count" },
                  "hits": { "$ref": "#/$defs/count" },
                  "missesDetector": { "$ref": "#/$defs/count" },
                  "abstentionsOnAnswerable": { "$ref": "#/$defs/count" },
                  "answerableNegatives": { "$ref": "#/$defs/count" },
                  "negativesDeterminate": { "$ref": "#/$defs/count" },
                  "recallPpm": { "$ref": "#/$defs/nullablePpm" }
                }
              },
              "x-opensip-order": "canonical-set"
            },
            "mutants": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ruleId", "family", "heldOut", "generated", "validPositive", "validNegative", "validAbstain", "invalid", "equivalent", "notEnumerated", "illFormed", "unvalidatable"],
                "properties": {
                  "ruleId": { "$ref": "#/$defs/label" },
                  "family": { "$ref": "#/$defs/label" },
                  "heldOut": { "type": "boolean" },
                  "generated": { "$ref": "#/$defs/count" },
                  "validPositive": { "$ref": "#/$defs/count" },
                  "validNegative": { "$ref": "#/$defs/count" },
                  "validAbstain": { "$ref": "#/$defs/count" },
                  "invalid": { "$ref": "#/$defs/count" },
                  "equivalent": { "$ref": "#/$defs/count" },
                  "notEnumerated": { "$ref": "#/$defs/count" },
                  "illFormed": { "$ref": "#/$defs/count" },
                  "unvalidatable": { "$ref": "#/$defs/count" }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        },
        "q4": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mustAbstainCases", "unsupportedDeterminateNegatives", "falseCompletenessClaims", "deficiencyMismatches"],
          "properties": {
            "status": { "enum": ["zero", "nonzero"] },
            "mustAbstainCases": { "$ref": "#/$defs/count" },
            "unsupportedDeterminateNegatives": { "$ref": "#/$defs/count" },
            "falseCompletenessClaims": { "$ref": "#/$defs/count" },
            "deficiencyMismatches": { "$ref": "#/$defs/count" }
          }
        },
        "q5": {
          "type": "object",
          "additionalProperties": false,
          "required": ["survival", "determinism"],
          "properties": {
            "survival": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ruleId", "transformation", "status", "pairsScored", "pairsDiscarded", "unaffected", "survived", "spuriousNetNew", "spuriousFixed", "ambiguous", "unmatched"],
                "properties": {
                  "ruleId": { "$ref": "#/$defs/label" },
                  "transformation": { "$ref": "#/$defs/label" },
                  "status": { "enum": ["measured", "insufficient"] },
                  "pairsScored": { "$ref": "#/$defs/count" },
                  "pairsDiscarded": { "$ref": "#/$defs/count" },
                  "unaffected": { "$ref": "#/$defs/count" },
                  "survived": { "$ref": "#/$defs/count" },
                  "spuriousNetNew": { "$ref": "#/$defs/count" },
                  "spuriousFixed": { "$ref": "#/$defs/count" },
                  "ambiguous": { "$ref": "#/$defs/count" },
                  "unmatched": { "$ref": "#/$defs/count" }
                }
              },
              "x-opensip-order": "canonical-set"
            },
            "determinism": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workloadId", "variant", "runs", "status", "differingDomains"],
                "properties": {
                  "workloadId": { "$ref": "#/$defs/label" },
                  "variant": { "enum": ["V0", "V1", "V2", "V3", "V4", "V5"] },
                  "runs": { "$ref": "#/$defs/positiveInt" },
                  "status": { "enum": ["exact", "differs", "not-run"] },
                  "differingDomains": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "$ref": "#/$defs/label" },
                    "x-opensip-order": "canonical-set"
                  }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        },
        "q6": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workloads"],
          "properties": {
            "workloads": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workloadId", "workflow", "reset", "sizeClass", "warmupRuns", "elapsedNanos", "peakRssBytes", "concurrentSumPeakRssBytes", "perProcessHighWaterSumBytes", "medianElapsedNanos", "maxPeakRssBytes", "status", "phaseTimingsPresent", "unattributedNanos", "yieldPpm", "q6Labelled"],
                "properties": {
                  "workloadId": { "$ref": "#/$defs/label" },
                  "workflow": { "enum": ["core-analyze", "first-use", "prep-invalidating-edit"] },
                  "reset": { "enum": ["cold", "warm"] },
                  "control": { "enum": ["clean", "missing-input", "stale-prepared", "broken-build"] },
                  "sizeClass": { "enum": ["small", "medium", "large", "very-large"] },
                  "warmupRuns": { "const": 3 },
                  "elapsedNanos": { "$ref": "#/$defs/samples7" },
                  "peakRssBytes": { "$ref": "#/$defs/samples7" },
                  "concurrentSumPeakRssBytes": { "$ref": "#/$defs/samples7" },
                  "perProcessHighWaterSumBytes": { "$ref": "#/$defs/samples7" },
                  "medianElapsedNanos": { "$ref": "#/$defs/positiveInt" },
                  "maxPeakRssBytes": { "$ref": "#/$defs/positiveInt" },
                  "baselineMedianNanos": {
                    "oneOf": [
                      { "$ref": "#/$defs/positiveInt" },
                      { "type": "null" }
                    ]
                  },
                  "baselinePeakRssBytes": {
                    "oneOf": [
                      { "$ref": "#/$defs/positiveInt" },
                      { "type": "null" }
                    ]
                  },
                  "status": { "enum": ["within", "over", "no-baseline"] },
                  "phaseTimingsPresent": { "type": "boolean" },
                  "unattributedNanos": {
                    "oneOf": [
                      { "$ref": "#/$defs/count" },
                      { "type": "null" }
                    ]
                  },
                  "yieldPpm": { "$ref": "#/$defs/nullablePpm" },
                  "q6Labelled": { "type": "boolean" }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        },
        "q7": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["measured", "not-measured"] },
            "fieldPresencePpm": { "$ref": "#/$defs/nullablePpm" },
            "proofJoinFailures": { "$ref": "#/$defs/count" },
            "rubricAverageMilli": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 5000
            },
            "itemsScoredAtMostTwo": { "$ref": "#/$defs/count" },
            "itemsDispositioned": { "$ref": "#/$defs/count" },
            "smallPopulation": { "type": "boolean" },
            "medianTriageMillis": { "$ref": "#/$defs/count" },
            "accepted": { "$ref": "#/$defs/count" },
            "dismissed": { "$ref": "#/$defs/count" }
          }
        },
        "q8": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "shapes"],
          "properties": {
            "status": { "enum": ["measured", "not-measured"] },
            "shapes": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["shapeId", "manualCorrections"],
                "properties": {
                  "shapeId": { "$ref": "#/$defs/label" },
                  "manualCorrections": { "$ref": "#/$defs/count" }
                }
              },
              "x-opensip-order": "canonical-set"
            }
          }
        }
      }
    }
  }
}
