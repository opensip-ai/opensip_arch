{
  "SnapshotBlob": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "sha256",
      "bytes"
    ],
    "properties": {
      "path": {
        "$ref": "#/$defs/LogicalPath"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
        "x-opensip-digest": {
          "representation": "raw-artifact",
          "artifact": "the exact retained file bytes named by path; bytes is their exact length"
        }
      },
      "bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      }
    }
  },
  "SnapshotInventory": {
    "type": "array",
    "maxItems": 100000,
    "uniqueItems": true,
    "items": {
      "$ref": "#/$defs/Blob"
    },
    "x-opensip-order": "path",
    "description": "The snapshot source inventory as a registered record in its own right, so that vcs-observation.sourceInventoryDigest names a record rather than an unnamed canonical fragment."
  },
  "NativeFileManifest": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "contentSha256",
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000\\\\]+(?![\\s\\S])"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "x-opensip-digest": {
            "representation": "raw-artifact",
            "artifact": "the exact retained bytes of that dependency source member, at its declared byteLength",
            "retention": "preimage",
            "authority": "native"
          }
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "maxItems": 1000000,
    "minItems": 0,
    "uniqueItems": true,
    "x-opensip-order": "path"
  }
}
