+/// Addendum map-r1: the constant component debit is charged before CI open,
+/// so its refusal opens nothing, pins nothing and charges nothing else.
+#[test]
+fn component_fixed_debit_refuses_before_ci_open() {
+    use crate::installation::tests::{MACOS, registry, within};
+    use opensip_security::retention_fixture::{self, Role};
+    const FILES: &[(&str, &[u8])] = &[("bin/entry", b"entry")];
+    retention_fixture::with_roles(&[Role::Toolchain], FILES, |components, _, archives| {
+        let (scratch, store, path) = ordinary_store();
+        drop(install_signed(
+            &scratch,
+            &store,
+            &components[0],
+            &archives[0],
+        ));
+        let mut preparation = WorkLedger::snapshot_profile();
+        let candidate = within(&mut preparation, |work| {
+            component_candidate(&components[0], MACOS, None, registry(), work)
+        })
+        .unwrap();
+        let mut admission = WorkLedger::with_limits(WorkCost {
+            objects: 65_536,
+            edges: COMPONENT_FEE.edges - 1,
+            bytes: 268_435_456,
+        })
+        .unwrap();
+        let result = within(&mut admission, |work| {
+            admit_component(
+                &store,
+                &components[0],
+                &candidate,
+                MACOS,
+                PinRequest::UnderFence,
+                work,
+            )
+        });
+        assert!(matches!(
+            result,
+            Err(ComponentAdmissionFailure::Budget(WorkBudgetError::Edges))
+        ));
+        assert!(admission.is_failed());
+        assert_eq!(admission.used(), WorkCost::default());
+        assert!(ordinary_pin_is_free(&path, candidate.closure()));
+    });
+}
