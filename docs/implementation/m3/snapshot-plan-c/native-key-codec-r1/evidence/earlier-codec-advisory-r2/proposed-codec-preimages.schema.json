{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:native:package-owner-codec-proposal:1",
  "$defs": {
    "PackageTupleV1": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "x-opensip-order": "sequence"
    },
    "PackageKeyV1": {
      "type": "string",
      "pattern": "^pkg1-[0-9a-f]{64}(?![\\s\\S])"
    },
    "NativeOwnerKeyV1": {
      "type": "string",
      "pattern": "^own1-[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
