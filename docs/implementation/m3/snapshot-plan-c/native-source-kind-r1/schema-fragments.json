{
  "DependencyPackageSourceV1.sourceKind": {
    "type": "string",
    "enum": [
      "registry",
      "git",
      "path",
      "vendored"
    ]
  },
  "DependencyPackageSourceV1.sourceId": {
    "type": "string",
    "maxLength": 4096
  },
  "AcquisitionV1": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "descriptorId",
      "mode",
      "vendorPath"
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "in-snapshot-path",
          "in-snapshot-vendored",
          "imported-descriptor"
        ]
      },
      "descriptorId": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^import2:[0-9a-f]{64}(?![\\s\\S])"
          },
          {
            "type": "null"
          }
        ]
      },
      "vendorPath": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000\\\\]+(?![\\s\\S])"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
