{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "standing": "PROPOSED EXACT DIGEST ANNOTATION SUCCESSOR ONLY; STRUCTURAL DEFINITIONS INHERITED BY VALUE",
  "$defs": {
    "DependencySourceManifestV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencySourceSetId",
        "entries",
        "manifestSha256"
      ],
      "properties": {
        "dependencySourceSetId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "x-opensip-digest": {
            "representation": "h-identity",
            "domain": "native.dependency-source-set.v1",
            "form": "sha256-text",
            "retention": "preimage-frame",
            "authority": "native"
          }
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "x-opensip-digest": {
            "representation": "raw-artifact",
            "artifact": "the deterministic-CBOR encoding of the exact complete entries array of DependencySourceManifestV3; no transport envelope, manifestSha256 field, dependencySourceSetId, wrapper, prefix or suffix is in this raw SHA-256 preimage",
            "retention": "owner-retained",
            "authority": "native"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "byteLength",
              "contentSha256",
              "packageKey",
              "path"
            ],
            "properties": {
              "packageKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000\\\\]+(?![\\s\\S])"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                "x-opensip-digest": {
                  "representation": "raw-artifact",
                  "artifact": "the exact retained bytes of that dependency source member",
                  "retention": "preimage",
                  "authority": "native"
                }
              }
            }
          },
          "maxItems": 1000000,
          "minItems": 0,
          "uniqueItems": true,
          "x-opensip-order": "sequence"
        }
      }
    },
    "DependencySourceSealV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencySourceSetId",
        "entryCount",
        "manifestSha256",
        "totalBytes",
        "totalChunkCount"
      ],
      "properties": {
        "dependencySourceSetId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "x-opensip-digest": {
            "representation": "h-identity",
            "domain": "native.dependency-source-set.v1",
            "form": "sha256-text",
            "retention": "preimage-frame",
            "authority": "native"
          }
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "x-opensip-digest": {
            "representation": "raw-artifact",
            "artifact": "the deterministic-CBOR encoding of the exact complete entries array of DependencySourceManifestV3; no transport envelope, manifestSha256 field, dependencySourceSetId, wrapper, prefix or suffix is in this raw SHA-256 preimage",
            "retention": "owner-retained",
            "authority": "native"
          }
        },
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "totalChunkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    }
  }
}
