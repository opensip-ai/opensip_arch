+    #[allow(dead_code)]
+    pub(crate) fn new_with_projected_values_data(
+        shell: Shell,
+        cwd: PathBuf,
+        homedir: PathBuf,
+        values: HashMap<String, ConfigValue>,
+    ) -> CargoResult<Self> {
+        let mut context = Self::new(shell, cwd, homedir);
+        context.set_values(values)?;
+        context.projected_values_data = true;
+        Ok(context)
+    }
