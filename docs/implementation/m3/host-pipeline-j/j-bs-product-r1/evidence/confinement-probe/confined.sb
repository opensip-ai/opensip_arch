(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/Users/sb/opensip-deps/native-repin-01/runs/check-1/tool-node"))
(allow file-read* (literal "/Users/sb/opensip-deps/native-repin-01/runs/check-1/tool-node") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/probe.cjs") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/inputs") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/scratch") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/output"))
(allow file-read-metadata (path-ancestors "/Users/sb/opensip-deps/native-repin-01/runs/check-1/tool-node") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/probe.cjs") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/inputs") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/scratch") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/output"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/scratch") (require-not (literal "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/scratch"))) (require-all (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/output") (require-not (literal "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/confined/output"))))
