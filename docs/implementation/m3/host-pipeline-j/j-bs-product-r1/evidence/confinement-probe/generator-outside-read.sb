(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/Users/sb/opensip-deps/contracts-generator-rebuild-02/opensip-contract-generator"))
(allow file-read* (literal "/Users/sb/opensip-deps/contracts-generator-rebuild-02/opensip-contract-generator") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/inputs") (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/generator-granted"))
(allow file-read-metadata (path-ancestors "/Users/sb/opensip-deps/contracts-generator-rebuild-02/opensip-contract-generator") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/inputs") (path-ancestors "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/generator-granted"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/generator-granted") (require-not (literal "/private/tmp/opensip-implementation/jbs-product-authoring/confinement-probe/generator-granted"))))
