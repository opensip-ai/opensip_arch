+    std::os::unix::fs::symlink("f", s.0.join("l")).unwrap();
+    std::fs::create_dir(s.0.join("d")).unwrap();
+    let f = spelling(&s.0.join("f"));
+    let l = spelling(&s.0.join("l"));
+    let d = spelling(&s.0.join("d"));
+    let absent = spelling(&s.0.join("none"));
+    let through_file = spelling(&s.0.join("f/below"));
+    let mut ledger = WorkLedger::new();
