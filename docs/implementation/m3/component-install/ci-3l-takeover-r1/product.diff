+/// and hold no NUL; otherwise nothing is charged or copied.
+fn store_path(
+    parts: &[&[u8]],
+    length: usize,
+    work: &mut WorkScope<'_>,
+) -> Result<PathBuf, WorkFailure<io::Error>> {
+    use std::os::unix::ffi::OsStringExt;
+    if parts.first().and_then(|p| p.first()) != Some(&b'/') || parts.iter().any(|p| p.contains(&0))
