+            ledger.scope(|work| {
+                work.charge(one)?;
+                match which {
+                    0 => erased(path_status_no_follow(&f, work)),
+                    _ => erased(directory_identity(&dir, work)),
+                }
+            })
+        });
+        assert!(matches!(r, Err(WorkFailure::Budget(_))), "{which}");
+        assert_eq!(n, 0, "{which}");
+    }
+    let mut ledger = WorkLedger::new();
+    ledger
+        .scope(|work| {
+            let (r, n) = allocated(|| path_status_no_follow(&f, work));
+            r.map_err(|_| WorkFailure::Operation(()))?;
+            assert_eq!(n, 0, "lstat");
+            let (r, n) = allocated(|| directory_identity(&dir, work));
+            r.map_err(|_| WorkFailure::Operation(()))?;
+            assert_eq!(n, 0, "directory fstat");
+            Ok::<_, WorkFailure<()>>(())
+        })
+        .unwrap();
+}
