diff --git a/tools/typescript-boundary/tests/product-loader-policy.test.mjs b/tools/typescript-boundary/tests/product-loader-policy.test.mjs
--- a/tools/typescript-boundary/tests/product-loader-policy.test.mjs	1969-12-31 16:00:00
+++ b/tools/typescript-boundary/tests/product-loader-policy.test.mjs	2026-10-31 18:00:11
@@ -0,0 +1,122 @@
+// DRAFT (F1-a D-1): a selected reviewed-product-package-loaders policy for a
+// bound Node-only typescript-package lane. Synthetic fixtures only (no
+// acceptance); the exception must be scoped to exact file, position and text.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { bindToolPolicy } from '../src/tool-policy.mjs';
+import { checkBoundary } from '../src/check.mjs';
+const json = value => JSON.stringify(value, null, 2) + '\n';
+const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
+const COMPILER = 'export async function load(url: string): Promise<unknown> {\n  return import(url);\n}\n';
+const GEN = 'import { createRequire } from "node:module";\nexport const ts = createRequire(import.meta.url)("/pinned/typescript.js");\n';
+
+function fixture() {
+  const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'opensip-product-policy-'));
+  const architecture = path.join(temp, 'arch'), root = path.join(temp, 'product');
+  fs.mkdirSync(architecture); fs.mkdirSync(root);
+  const write = (dir, rel, value) => { const file = path.join(dir, rel); fs.mkdirSync(path.dirname(file), {recursive:true}); fs.writeFileSync(file, typeof value === 'string' ? value : json(value)); };
+  const pin = (dir, rel) => { const raw = fs.readFileSync(path.join(dir, rel)); return {path:rel,sha256:sha(raw),bytes:raw.length}; };
+  const own = 'providers/demo';
+  const compiler = own + '/src/compiler.ts', gen = own + '/scripts/gen.mjs', other = own + '/src/other.ts';
+  const record = {schemaVersion:2,package:'typescript-provider',packageRoot:own,manifest:own+'/package.json',tsconfig:own+'/tsconfig.json',inputs:[gen,compiler,other].sort(),packageManager:{kind:'fixture-unlocked',lockfile:null},trustedUsages:[]};
+  write(root,record.manifest,{name:'demo',type:'module'});
+  write(root,record.tsconfig,{compilerOptions:{strict:true,target:'ES2022',module:'Node16',moduleResolution:'Node16',rootDir:'src',outDir:'dist',types:[]},include:['src/**/*.ts']});
+  write(root,compiler,COMPILER); write(root,gen,GEN); write(root,other,'export const value: number = 1;\n');
+  const inventory = {standing:'synthetic test only; no acceptance',packages:[{id:'typescript-provider',kind:'typescript-package',path:own,dependencies:[]}],
+    files:[...record.inputs,record.manifest,record.tsconfig].map(p=>({path:p,package:'typescript-provider',role:'source'}))};
+  write(architecture,'parent.json',inventory);write(architecture,'inventory.json',inventory);
+  for (const name of ['record','review','assent']) write(architecture,name+'.json',{fixture:true});
+  const inventoryBinding = Object.fromEntries([['parent','parent'],['candidate','inventory'],['record','record'],['review','review'],['assent','assent']].map(([k,n])=>[k,pin(architecture,n+'.json')]));
+  const designLock = path.join(root,'design-lock.json');
+  const policy = {schemaVersion:1,kind:'reviewed-product-package-loaders',lane:record,files:[],trustedUsages:[],unfollowedDynamicLoaders:[]};
+  const select = () => {
+    policy.files=[...record.inputs,record.manifest,record.tsconfig].sort().map(p=>pin(root,p));
+    for (const u of policy.trustedUsages) u.sha256 = pin(root,u.file).sha256;
+    write(architecture,'policy.json',policy);
+    write(architecture,'contract-record.json',{candidates:[pin(architecture,'policy.json')]});
+    write(architecture,'subject.json',{files:[pin(architecture,'policy.json')]});
+    const binding = {record:pin(architecture,'contract-record.json'),subjectManifest:pin(architecture,'subject.json'),review:pin(architecture,'review.json'),assent:pin(architecture,'assent.json')};
+    write(root,'design-lock.json',{inputs:[inventoryBinding.parent],inventorySuccessors:[inventoryBinding],contractSuccessors:[binding]});
+  };
+  const args = {architecture,designLock,root,record};
+  return {temp,root,record,policy,select,args,write,compiler,gen,other,close:()=>fs.rmSync(temp,{recursive:true,force:true})};
+}
+const loaders = r => r.refusals.filter(x=>x.category==='unsupported-loader');
+// The two sites as the unpatched rules see them, then the policy that names exactly them.
+async function withPolicy(f) {
+  f.select();
+  const before = await checkBoundary(f.args);
+  const sites = loaders(before);
+  assert.deepEqual(sites.map(s=>[s.from,s.message]).sort(), [[f.compiler,'computed-import: import(url)'],[f.gen,'create-require: createRequire(import.meta.url)']].sort(), JSON.stringify(before.refusals));
+  for (const s of sites) {
+    const text = s.message.slice(s.message.indexOf(': ')+2);
+    f.policy.trustedUsages.push({kind:'dynamic-loader',file:s.from,sha256:'',line:s.line,column:s.column,text,reason:'synthetic',targets:[]});
+  }
+  f.policy.trustedUsages.sort((a,b)=>a.file<b.file?-1:1);
+  f.policy.unfollowedDynamicLoaders = f.policy.trustedUsages.map(u=>({file:u.file,line:u.line,column:u.column,limitation:'reviewed-product-loader-outside-statically-enumerated-closure'}));
+  f.select();
+  return {...f.args,toolPolicyPath:'policy.json'};
+}
+
+test('product policy excepts exactly the two selected sites (gen .mjs raw; TS source by its emission)', async () => {
+  const f = fixture(); try {
+    const args = await withPolicy(f);
+    const yes = await checkBoundary(args);
+    assert.equal(yes.passed, true, JSON.stringify(yes.refusals));
+    assert.equal(yes.trustedUsagesApplied.length, 2);
+    assert.equal(yes.selectedToolPolicy.unfollowedDynamicLoaders.length, 2);
+  } finally { f.close(); }
+});
+
+test('controls: another site, another callee, a moved or retargeted record all still refuse', async t => {
+  const cases = [
+    ['second computed import at another line of the excepted file', f => f.write(f.root, f.compiler, COMPILER + 'export async function load2(u: string): Promise<unknown> {\n  return import(u);\n}\n'), 1],
+    ['same position, another callee argument', f => f.write(f.root, f.gen, GEN.replace('createRequire(import.meta.url)', 'createRequire(import.meta.dirname)')), 1],
+    ['the same loader text in another declared input', f => f.write(f.root, f.other, 'export async function load(url: string): Promise<unknown> {\n  return import(url);\n}\n'), 1],
+  ];
+  for (const [name, mutate, extra] of cases) await t.test(name, async () => {
+    const f = fixture(); try {
+      const args = await withPolicy(f);
+      mutate(f); f.select();
+      const r = await checkBoundary(args);
+      assert.equal(r.passed, false);
+      assert.ok(loaders(r).length >= extra, JSON.stringify(r.refusals));
+    } finally { f.close(); }
+  });
+  const records = [
+    ['line moved', u => { u.line += 1; }],
+    ['column moved', u => { u.column += 1; }],
+    ['text changed', u => { u.text = u.text.replace('(', '( '); }],
+  ];
+  for (const [name, change] of records) await t.test('record ' + name, async () => {
+    const f = fixture(); try {
+      const args = await withPolicy(f);
+      for (const u of f.policy.trustedUsages) change(u);
+      f.policy.unfollowedDynamicLoaders = f.policy.trustedUsages.map(u=>({file:u.file,line:u.line,column:u.column,limitation:'reviewed-product-loader-outside-statically-enumerated-closure'}));
+      f.select();
+      const r = await checkBoundary(args);
+      assert.equal(r.passed, false);
+      assert.equal(loaders(r).length, 2, JSON.stringify(r.refusals));
+      assert.equal(r.refusals.filter(x=>x.category==='lane-record-invalid').length, 2);
+    } finally { f.close(); }
+  });
+});
+
+test('binding refuses the wrong kind, an unfollowed loader outside the inputs, and caller exceptions', async t => {
+  const cases = [
+    ['developer-tool kind on a product lane', f => { f.policy.kind = 'reviewed-developer-tool-loaders'; f.select(); }, /unsupported tool policy/],
+    ['unfollowed loader in a non-input file', f => { f.policy.trustedUsages[0].file = f.record.packageRoot + '/node_modules/x/index.js'; f.policy.unfollowedDynamicLoaders[0].file = f.policy.trustedUsages[0].file; f.policy.trustedUsages.sort((a,b)=>a.file<b.file?-1:1); f.policy.unfollowedDynamicLoaders = f.policy.trustedUsages.map(u=>({file:u.file,line:u.line,column:u.column,limitation:'reviewed-product-loader-outside-statically-enumerated-closure'})); f.write(f.root, f.policy.trustedUsages[0].file, 'x'); f.select(); }, /exact sorted|only permitted in declared lane inputs/],
+    ['developer-tool limitation on a product loader', f => { f.policy.unfollowedDynamicLoaders[0].limitation = 'reviewed-tool-code-outside-statically-enumerated-closure'; f.select(); }, /only permitted in declared lane inputs/],
+    ['caller exception on the bound record', f => { f.args.record = {...f.record, trustedUsages:[f.policy.trustedUsages[0]]}; }, /no caller exceptions|lane differs/],
+  ];
+  for (const [name, mutate, expected] of cases) await t.test(name, async () => {
+    const f = fixture(); try {
+      await withPolicy(f); mutate(f);
+      await assert.rejects(() => checkBoundary({...f.args, toolPolicyPath:'policy.json'}), expected);
+    } finally { f.close(); }
+  });
+});
