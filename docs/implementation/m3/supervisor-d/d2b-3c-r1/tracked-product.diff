+        assert_eq!(selected.matches_json(&entry, raw, 100_000), Ok(ecma));
+        assert_eq!(generic.matches_json(&entry, raw, 100_000), Ok(legacy));
+        assert_eq!(foreign.matches_json("urn:probe#", raw, 100_000), Ok(legacy));
+    }
