+    let id = "opensip.product.symbol-census.1";
+    let entry = format!("{id}#");
+    let document = native_owner_document(id, NATIVE_OWNER_DOT_BODY);
+    let selected =
+        Program::compile_registered_native_owners(vec![document.clone()], &[&entry], 100_000)
+            .unwrap();
+    let generic = Program::compile(vec![document], &[&entry], 100_000).unwrap();
+    let foreign = Program::compile_registered_native_owners(
+        vec![doc(NATIVE_OWNER_DOT_BODY)],
+        &["urn:probe#"],
+        100_000,
+    )
+    .unwrap();
+    for (raw, ecma, legacy) in [
+        (br#""a/..\n""#.as_slice(), true, false),
+        (br#""a/.\n""#, true, false),
+        (br#""a/..\r""#, true, true),
+        (br#""a/..\u2028""#, true, true),
+        (br#""a/..\u2029""#, true, true),
+        (br#""a/..""#, false, false),
+        (br#""a/.""#, false, false),
+        (br#""a/../b""#, false, false),
+        (br#""x\n/../b""#, false, false),
+        (br#""x\r/../b""#, false, false),
+        (br#""x\u2028/../b""#, false, false),
+        (br#""x\u2029/../b""#, false, false),
