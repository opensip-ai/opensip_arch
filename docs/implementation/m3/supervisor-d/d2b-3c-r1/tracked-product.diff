+/// A census-bearing Complete's census (LD-D2B3C-3): `None` when it is null.
+pub(crate) fn census(v: &Value) -> R<Option<SymbolCensus1SymbolCensusV1>> {
+    if *v == Value::Null {
+        return Ok(None);
+    }
+    let f = map(v, "symbolCensus")?;
+    let state = text(f, "state")?;
+    Ok(Some(match state.as_str() {
+        "complete" => {
+            let row = |v: &Value| -> R<SymbolCensus1SymbolCensusRowV1> {
+                let r = map(v, "row")?;
+                Ok(SymbolCensus1SymbolCensusRowV1 {
+                    exported: parse(r, "exported")?,
+                    native_subject_id: parse(r, "nativeSubjectId")?,
+                    path: parse(r, "path")?,
+                    qualified_name: parse(r, "qualifiedName")?,
+                    signature_tokens: texts(r, "signatureTokens")?,
+                })
+            };
+            SymbolCensus1SymbolCensusV1::CompleteSymbolCensusV1(
+                SymbolCensus1CompleteSymbolCensusV1 {
+                    examined_paths: texts(f, "examinedPaths")?,
+                    rows: items(f, "rows")?.iter().map(row).collect::<R<_>>()?,
+                    state: constant(f, "state")?,
+                },
+            )
+        }
+        "over-bound" => SymbolCensus1SymbolCensusV1::OverBoundSymbolCensusV1(
+            SymbolCensus1OverBoundSymbolCensusV1 {
+                examined_path_count: SymbolCensus1Uint64(unsigned(f, "examinedPathCount")?),
+                row_count: SymbolCensus1Uint64(unsigned(f, "rowCount")?),
+                state: constant(f, "state")?,
+            },
+        ),
+        _ => return Err("symbolCensus: state".to_owned()),
+    }))
+}
