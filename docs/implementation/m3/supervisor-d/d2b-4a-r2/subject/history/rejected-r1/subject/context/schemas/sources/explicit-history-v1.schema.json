{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:product-v1:report:explicit-history:1",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runIds"
      ],
      "properties": {
        "mode": {
          "const": "explicit"
        },
        "runIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
          },
          "x-opensip-order": "sequence"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "requestedRunIds",
    "currentRunId",
    "slots"
  ],
  "properties": {
    "policy": {
      "const": "explicit-run-ids.1"
    },
    "requestedRunIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
      },
      "x-opensip-order": "sequence"
    },
    "currentRunId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "source"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
          },
          "source": {
            "enum": [
              "current-run",
              "exact-retained-lookup"
            ]
          }
        }
      },
      "x-opensip-order": "sequence"
    }
  }
}
