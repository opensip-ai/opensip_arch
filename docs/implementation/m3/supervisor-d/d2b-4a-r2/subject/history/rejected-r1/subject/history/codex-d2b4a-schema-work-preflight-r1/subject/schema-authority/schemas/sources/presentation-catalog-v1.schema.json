{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:product-v1:workflows:presentation-catalog:1",
  "title": "Metadata-only presentation catalogue inside an admitted contribution closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaFamily",
    "schemaMajor",
    "capabilities",
    "rules",
    "recipes"
  ],
  "properties": {
    "schemaFamily": {
      "const": "opensip.presentation-catalog"
    },
    "schemaMajor": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/CapabilityDescriptionV1"
      },
      "x-opensip-order": "canonical-set"
    },
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/RuleDescriptionV1"
      },
      "x-opensip-order": "canonical-set"
    },
    "recipes": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/RecipeDescriptionV1"
      },
      "x-opensip-order": "canonical-set"
    }
  },
  "$defs": {
    "CapabilityDescriptionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/CanonicalIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/CanonicalIdentifier"
          },
          "x-opensip-order": "utf8",
          "uniqueItems": true
        }
      }
    },
    "RuleDescriptionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleProgramRef",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "ruleProgramRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contributionId",
            "ruleStableId",
            "semanticsMajor",
            "programDigest"
          ],
          "properties": {
            "contributionId": {
              "$ref": "urn:opensip:product-v1:workflows:common#/$defs/ContributionId"
            },
            "ruleStableId": {
              "$ref": "urn:opensip:product-v1:workflows:common#/$defs/CanonicalIdentifier"
            },
            "semanticsMajor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "programDigest": {
              "$ref": "urn:opensip:product-v1:workflows:common#/$defs/Sha256Hex"
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/CanonicalIdentifier"
          },
          "x-opensip-order": "utf8",
          "uniqueItems": true
        }
      }
    },
    "RecipeDescriptionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeKey",
        "name",
        "description",
        "tags",
        "targetBounds",
        "parameterDescriptions"
      ],
      "properties": {
        "recipeKey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contributionId",
            "recipeId",
            "recipeVersion"
          ],
          "properties": {
            "contributionId": {
              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/ContributionId"
            },
            "recipeId": {
              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/CanonicalIdentifier"
            },
            "recipeVersion": {
              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/SemanticVersion"
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:4#/$defs/CanonicalIdentifier"
          },
          "x-opensip-order": "utf8",
          "uniqueItems": true
        },
        "targetBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimumTargets",
            "maximumTargets"
          ],
          "properties": {
            "kind": {
              "const": "finding-fingerprints"
            },
            "minimumTargets": {
              "const": 1
            },
            "maximumTargets": {
              "const": 4096
            }
          }
        },
        "parameterDescriptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceSource",
            "targets"
          ],
          "properties": {
            "evidenceSource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            },
            "targets": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            }
          }
        }
      }
    }
  }
}
