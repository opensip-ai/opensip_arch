  "cases": [
    {
      "id": "provider-wire-per-language-limit-maps-equal-the-published-inherited-values",
      "feedback": [
        "F1"
      ],
      "kind": "positive",
      "steps": [
        {
          "fn": "provider_wire_limits",
          "args": {
            "language": "typescript-semantic"
          },
          "bind": "t"
        },
        {
          "fn": "provider_wire_limits",
          "args": {
            "language": "rust-semantic"
          },
          "bind": "u"
        }
      ],
      "expect": {
        "$t": "$fixtures.wireTsProtocolLimits",
        "$u": "$fixtures.wireRustProtocolLimitsV3",
        "$t.maxFactBatchFacts": 4096,
        "$u.maxFactBatchCandidates": 4096
      }
    },
    {
      "id": "startup-rust3-empty-dependency-manifest-and-seal-admit",
      "feedback": [
        "F1"
      ],
      "kind": "positive",
      "steps": [
        {
          "fn": "validate",
          "args": {
            "def": "DependencySourceManifestV3",
            "value": "$fixtures.startupRustEmptyDependencyManifest"
          },
          "bind": "m"
        },
        {
          "fn": "validate",
          "args": {
            "def": "DependencySourceSealV3",
            "value": "$fixtures.startupRustEmptyDependencySeal"
          },
          "bind": "s"
        }
      ],
      "expect": {
        "$m.entries": [],
        "$s.totalChunkCount": 0
      }
    }
  ],
