+
+/// D3b-2: the in-band completion closes the logical request side only at
+/// the Cancel's last byte, after the frame already in flight, once.
+#[test]
+fn d3b2_cancel_progress_follows_the_last_byte_and_closes_the_request() {
+    struct ByteWriter<'a>(&'a mut Vec<u8>);
+    impl io::Write for ByteWriter<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            if let Some(byte) = bytes.first() {
+                self.0.push(*byte);
+                Ok(1)
+            } else {
+                Ok(0)
+            }
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let table = Table::load(Protocol::Ts2).unwrap();
+    let p = plan();
+    let request = build(&p);
+    let mut expected = wire("Hello", 0, request.hello().clone());
+    expected.extend(wire(
+        "Cancel",
+        1,
+        m(&[
+            ("executionId", Value::Null),
+            ("analysisOrdinal", Value::Null),
+            ("reason", t("user-interrupt")),
+        ]),
+    ));
+    let (mut part, mut worker) = session(&p, &table);
+    let mut bytes = Vec::new();
+    assert_eq!(
+        part.writable(&mut ByteWriter(&mut bytes)).cancel,
+        crate::supervisor::CancelProgress::default()
+    );
+    assert_eq!(
+        bytes.len(),
+        1,
+        "the current normal frame is partially written"
+    );
+    assert!(Participant::user_cancel(&mut part));
+    assert!(
+        !Participant::user_cancel(&mut part),
+        "the first request already owns the one Cancel"
+    );
+    let mut completed = 0;
+    while part.wants_write() {
+        assert!(
+            bytes.len() < expected.len(),
+            "no repeated Cancel or later frame"
+        );
+        let step = part.writable(&mut ByteWriter(&mut bytes));
+        if step.cancel.written {
+            completed += 1;
+            assert!(step.cancel.request_closed);
+            assert_eq!(bytes, expected);
+        } else {
+            assert!(!step.cancel.request_closed, "no early request closure");
+            assert!(bytes.len() < expected.len());
+        }
+    }
+    assert_eq!(completed, 1);
+    assert_eq!(bytes, expected);
+    let frames = worker.host.push(&bytes);
+    assert!(frames.refusal.is_none());
+    assert_eq!(frames.frames.len(), 2);
+    assert_eq!(get(frames.frames[0].value(), "frameType"), &t("Hello"));
+    assert_eq!(get(frames.frames[1].value(), "frameType"), &t("Cancel"));
+    let mut extra = Vec::new();
+    assert_eq!(
+        part.writable(&mut extra).cancel,
+        crate::supervisor::CancelProgress::default()
+    );
+    assert!(extra.is_empty());
+    assert!(!Participant::user_cancel(&mut part));
+}
+
+/// D3b-2 escalation drops a partially written frame and queued Cancel;
+/// the participant never reports that abandoned Cancel as written.
+#[test]
+fn d3b2_abandon_input_never_completes_or_reports_a_cancel() {
+    struct Short<'a>(&'a mut Vec<u8>);
+    impl io::Write for Short<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            let n = bytes.len().min(3);
+            self.0.extend_from_slice(&bytes[..n]);
+            Ok(n)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let table = Table::load(Protocol::Ts2).unwrap();
+    let p = plan();
+    let (mut part, _) = session(&p, &table);
+    let mut bytes = Vec::new();
+    assert_eq!(
+        part.writable(&mut Short(&mut bytes)).cancel,
+        crate::supervisor::CancelProgress::default()
+    );
+    assert_eq!(bytes.len(), 3);
+    assert!(Participant::user_cancel(&mut part));
+    Participant::abandon_input(&mut part);
+    let before = bytes.clone();
+    assert!(!part.wants_write());
+    assert_eq!(
+        part.writable(&mut bytes).cancel,
+        crate::supervisor::CancelProgress::default()
+    );
+    assert_eq!(bytes, before);
+    assert!(!Participant::user_cancel(&mut part));
+}
+
+/// D3b-2 uses the participant's existing Cancel law; a verified terminal
+/// makes the user leg unlawful and queues no additional data frame.
+#[test]
+fn d3b2_user_cancel_seam_is_not_lawful_after_a_terminal() {
+    let table = Table::load(Protocol::Ts2).unwrap();
+    let p = plan();
+    let (mut part, mut worker) = session(&p, &table);
+    let (statuses, _) = drive(&mut part, &mut worker);
+    assert_eq!(
+        statuses.last(),
+        Some(&ParticipantStatus::Terminal(TerminalKind::Complete))
+    );
+    assert!(!Participant::user_cancel(&mut part));
+    assert!(!part.wants_write());
+}
