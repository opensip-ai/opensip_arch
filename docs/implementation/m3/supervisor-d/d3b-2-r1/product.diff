+    assert_eq!(out.settlement.scratch(), ScratchFate::Retained(reason));
+    assert_eq!(
+        out.settlement
+            .revocation_evidence()
+            .unwrap()
+            .state(opensip_operability::RevocationMark::ScratchCleanup),
+        RevocationMarkState::Missed
