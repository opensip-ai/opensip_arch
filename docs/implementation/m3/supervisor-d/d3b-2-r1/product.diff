+fn d3b2_sample(
+    observed: &opensip_platform::ClockObservation,
+    elapsed: Duration,
+) -> RevocationClockSample {
+    RevocationClockSample {
+        after: observed.monotonic_before() + elapsed,
+        boot: observed.boot_id().to_owned(),
+    }
+}
+fn d3b2_arm_tracking(tool: bool, lag: Duration) -> (RevocationTracking, Vec<records::RecordFact>) {
+    let observed = opensip_platform::observe_clock().unwrap();
+    let read = d3b2_sample(&observed, lag);
+    RevocationTracking::arm(
+        observed,
+        tool,
+        Ok(read),
+        Instant::now(),
+        &[false; 5],
+        &[false; 5],
+        &std::array::from_fn(|_| None),
+    )
