+fn d3b2_root_gate_keeps_capacity_signals_order_and_exact_close_counts() {
+    let gate = TriggerGate::new();
+    for _ in 0..TRIGGER_CAPACITY {
+        assert!(gate.admit(Trigger::HostFault));
+    }
+    assert!(!gate.admit(Trigger::HostFault));
+    assert!(gate.user_signal());
+    assert!(gate.user_signal());
+    for _ in 0..100 {
+        assert!(gate.user_signal());
+    }
+    assert_eq!(gate.take_extra_signals(), 0);
+    for _ in 0..TRIGGER_CAPACITY {
+        assert!(matches!(
+            gate.take(),
+            Some(GateMessage::Queued(Trigger::HostFault))
+        ));
+    }
+    assert!(matches!(gate.take(), Some(GateMessage::FirstSignal)));
+    assert_eq!(gate.take_extra_signals(), 0);
+    assert!(matches!(gate.take(), Some(GateMessage::SecondSignal)));
+    assert_eq!(gate.take_extra_signals(), 100);
+    assert_eq!(gate.close(), 0);
+    assert_eq!(gate.late(), 0);
+    assert!(!gate.user_signal());
+    assert_eq!(gate.late(), 1);
+    let gate = TriggerGate::new();
+    assert!(gate.user_signal());
+    assert!(gate.admit(Trigger::HostFault));
+    assert!(gate.user_signal());
+    assert!(gate.user_signal());
+    assert_eq!(gate.close(), 3);
+    assert_eq!(gate.late(), 4);
+    assert_eq!(gate.close(), 0);
+    assert_eq!(gate.late(), 4);
+}
