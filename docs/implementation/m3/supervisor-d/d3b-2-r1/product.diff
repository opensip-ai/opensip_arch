+/// D3b-2's type-only double keeps the current frame whole before Cancel,
+/// and drops normal snapshot frames it had queued but not started.
+#[test]
+fn d3b2_fixture_cancel_keeps_the_current_frame_and_discards_later_frames() {
+    struct One<'a>(&'a mut Vec<u8>);
+    impl Write for One<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            if let Some(byte) = bytes.first() {
+                self.0.push(*byte);
+                Ok(1)
+            } else {
+                Ok(0)
+            }
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut participant = FixtureParticipant::new(FIXTURE_WAITS);
+    let mut hello = Vec::new();
+    participant.writable(&mut hello);
+    let frame = |name: &str| {
+        write_frame(&Value::Map(vec![("type".into(), Value::Text(name.into()))])).unwrap()
+    };
+    participant.readable(&mut frame("HelloAck").as_slice());
+    participant.writable(&mut Vec::new());
+    participant.chunk = Some(8);
+    participant.readable(&mut frame("UniverseAccepted").as_slice());
+    assert_eq!(participant.pending_ends.len(), 3);
+    let current_frame_end = participant.pending_ends[0];
+    let mut bytes = Vec::new();
+    let partial = participant.writable(&mut One(&mut bytes));
+    assert_eq!(partial.cancel, CancelProgress::default());
+    assert_eq!(bytes.len(), 1);
+    assert!(participant.user_cancel());
+    assert!(!participant.user_cancel());
+    assert_eq!(participant.pending_ends.len(), 2);
+    assert_eq!(participant.pending_ends[0], current_frame_end);
+    let done = participant.writable(&mut bytes);
+    assert_eq!(
+        done.cancel,
+        CancelProgress {
+            written: true,
+            request_closed: true
+        }
+    );
+    assert!(!participant.wants_write());
+    let mut frames = FrameAccumulator::new(Profile::Rust3, 16, None);
+    let pushed = frames.push(&bytes);
+    assert!(pushed.refusal.is_none());
+    assert_eq!(
+        pushed
+            .frames
+            .iter()
+            .map(|f| type_of(f.value()))
+            .collect::<Vec<_>>(),
+        ["SnapshotManifest", "Cancel"]
+    );
+    assert_eq!(
+        participant.writable(&mut Vec::new()).cancel,
+        CancelProgress::default()
+    );
+}
