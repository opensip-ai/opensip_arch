+fn d3b2_clean_reap_observer<P: Participant>(mut supervision: Supervision<P>, fail_stop: bool) {
+    let dir = test_dir();
+    let events: Events = Rc::default();
+    let sink = Rc::clone(&events);
+    supervision.observer = Some(Box::new(move |event| {
+        sink.borrow_mut().push((Instant::now(), event.clone()))
+    }));
+    let facts = Rc::clone(&supervision.seams.facts);
+    let sink = Rc::clone(&facts);
+    supervision.record_facts(Box::new(move |fact| sink.borrow_mut().push(fact)));
+    supervision.seams.reap_blocked = true;
+    let mut root = root_in(&dir);
+    supervision.start(&mut root).unwrap();
+    let cap = Instant::now() + HANDSHAKE;
+    while !(supervision.state == State::Reaping
+        && supervision.clean_at.is_some()
+        && supervision.ladder.is_none())
+    {
+        assert!(
+            Instant::now() < cap,
+            "clean Reaping never reached: {:?}",
+            events.borrow()
+        );
+        assert_ne!(supervision.state, State::Settled);
+        supervision.turn();
+    }
+    let observed = opensip_platform::observe_clock().unwrap();
+    assert!(if fail_stop {
+        supervision.handle().observer_fail_stop(observed)
+    } else {
+        supervision.handle().revoked(observed)
+    });
+    supervision.turn();
+    let cause = if fail_stop {
+        Cause::ObserverFailStop
+    } else {
+        Cause::Revoked
+    };
+    let first = supervision.first_cause;
+    let ladder = supervision.ladder;
+    // If the regression assertion fails, Drop can still finish native
+    // cleanup promptly; the seam never pins a negative control's root.
+    supervision.seams.reap_blocked = false;
+    assert_eq!(
+        first,
+        Some(cause),
+        "observer was suppressed behind provisional Clean"
+    );
+    assert!(
+        ladder.is_some(),
+        "observer in clean reap needs its fault ladder"
+    );
+    assert!(
+        ladder.unwrap().term_at.is_some(),
+        "T2 attempted before reap"
+    );
+    assert!(
+        ladder.unwrap().kill_at.is_some(),
+        "dead root's group/tree step before reap"
+    );
+    while supervision.state != State::Settled {
+        assert!(Instant::now() < cap);
+        supervision.turn();
+    }
+    let mut settlement = supervision.take_settlement().unwrap();
+    assert_eq!(settlement.first_cause(), cause);
+    assert!(!settlement.admissible());
+    assert!(settlement.release().is_none());
+    assert_eq!(settlement.exit(), ExitClass::Exited(0));
+    let evidence = settlement.revocation_evidence().unwrap();
+    assert!(
+        evidence
+            .states
+            .iter()
+            .all(|s| *s != RevocationMarkState::Pending)
+    );
+    let is_tool = settlement.is_tool();
+    assert_eq!(
+        evidence.normal_shutdown_completed_before_arming(),
+        !is_tool,
+        "Q12 retains the actual fully written normal shutdown"
+    );
+    assert!(
+        !evidence.control_input_open_at_arming(),
+        "no cancel was writable on the already closed host input"
+    );
+    assert_eq!(
+        evidence.state(opensip_operability::RevocationMark::ProtocolCancel),
+        if is_tool {
+            RevocationMarkState::Inapplicable
+        } else {
+            RevocationMarkState::Missed
+        }
+    );
+    let list = facts.borrow();
+    assert_eq!(
+        list.iter()
+            .filter(|f| matches!(
+                f,
