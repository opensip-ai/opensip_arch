+fn d3b2_control_failure_after_arm(reader_closes: bool) {
+    let dir = test_dir();
+    let (mut supervision, _) = prepared("hang", FixtureParticipant::new(ProtocolWaits::TS2), None);
+    let mut root = root_in(&dir);
+    supervision.start(&mut root).unwrap();
+    let cap = Instant::now() + HANDSHAKE;
+    while supervision.state != State::Running || !supervision.control_out.bytes.is_empty() {
+        assert!(Instant::now() < cap);
+        supervision.turn();
+    }
+    supervision.observer_trigger(Cause::Revoked, opensip_platform::observe_clock().unwrap());
+    supervision.queue_control_cancel(CancelReason::SupervisorFault);
+    assert_eq!(supervision.cancel_control, Some(ControlCancel::Queued));
+    if reader_closes {
+        let (writer, reader) = std::os::unix::net::UnixStream::pair().unwrap();
+        let owned: OwnedFd = writer.into();
+        supervision.ends.fd3 = Some(File::from(owned));
+        drop(reader);
+    } else {
+        supervision.seams.control_write_fails = true;
+    }
+    supervision.service_control_write();
+    assert_eq!(supervision.cancel_control, Some(ControlCancel::Failed));
+    assert_eq!(
+        supervision
+            .revocation
+            .as_ref()
+            .unwrap()
+            .evidence
+            .state(opensip_operability::RevocationMark::ProtocolCancel),
+        RevocationMarkState::Missed
+    );
+    while supervision.state != State::Settled {
+        assert!(Instant::now() < cap);
+        supervision.turn();
+    }
+    let settlement = supervision.take_settlement().unwrap();
+    assert_eq!(settlement.first_cause(), Cause::Revoked);
+    assert_eq!(
+        supervision
+            .seams
+            .facts
+            .borrow()
+            .iter()
+            .filter(|f| matches!(
+                f,
+                records::RecordFact::RevocationMissed {
+                    mark: opensip_operability::RevocationMark::ProtocolCancel,
+                    ..
+                }
+            ))
+            .count(),
+        1
+    );
+    assert!(
+        !supervision
+            .seams
+            .facts
+            .borrow()
+            .iter()
+            .any(|f| matches!(f, records::RecordFact::CancelSent { .. }))
+    );
+}
