+#[test]
+fn d3b2_final_delayed_clock_reads_sample_instants_after_the_reads() {
+    use std::cell::Cell;
+    let (mut supervision, _) =
+        prepared("normal", FixtureParticipant::new(ProtocolWaits::TS2), None);
+    supervision.ends.fd3 = Some(
+        std::fs::OpenOptions::new()
+            .write(true)
+            .open("/dev/null")
+            .unwrap(),
+    );
+    let arm_done = Rc::new(Cell::new(None));
+    let determine_done = Rc::new(Cell::new(None));
+    let a = Rc::clone(&arm_done);
+    let d = Rc::clone(&determine_done);
+    let mut calls = 0;
+    supervision.seams.revocation_read_hook = Some(RevocationReadHook(Box::new(move || {
+        std::thread::sleep(Duration::from_millis(20));
+        calls += 1;
+        if calls == 1 {
+            let read = RevocationClockSample::native();
+            a.set(Some(Instant::now()));
+            read
+        } else {
+            d.set(Some(Instant::now()));
+            Err(d3b2_clock_failure())
+        }
+    })));
+    let observed = opensip_platform::observe_clock().unwrap();
+    supervision.observer_trigger(Cause::Revoked, observed);
+    let tracking = supervision.revocation.as_ref().unwrap();
+    let armed = tracking.evidence.armed_at.unwrap();
+    let lag = tracking.evidence.arming_lag.unwrap();
+    assert!(
+        armed >= arm_done.get().unwrap(),
+        "arming Instant before read would double-count the read interval"
+    );
+    supervision.resolve_revocation_mark(opensip_operability::RevocationMark::ProtocolCancel, false);
+    let after = Instant::now();
+    let facts = supervision.seams.facts.borrow();
+    let value = facts
+        .iter()
+        .find_map(|f| match f {
+            records::RecordFact::RevocationMissed {
+                mark: opensip_operability::RevocationMark::ProtocolCancel,
+                measurement: records::RevocationMeasurement::LowerBound(elapsed),
+                ..
+            } => Some(*elapsed),
+            _ => None,
+        })
+        .unwrap();
+    assert!(
+        value >= lag + determine_done.get().unwrap().duration_since(armed),
+        "decision Instant must include the failed read interval"
+    );
+    assert!(
+        value <= lag + after.duration_since(armed),
+        "no arming-read interval counted twice"
+    );
+    assert_eq!(supervision.seams.revocation_clock_reads, 2);
+}
