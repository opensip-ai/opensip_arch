+            .seams
+            .facts
+            .borrow()
+            .iter()
+            .any(|f| matches!(f, records::RecordFact::CancelSent { .. }))
+    );
+    supervision.seams.stall_control_writes = false;
+    while supervision.state != State::Settled {
+        assert!(Instant::now() < cap);
+        supervision.turn();
+    }
+    assert!(supervision.take_settlement().unwrap().user_interrupted());
+}
+fn d3b2_late_timer_fault(which: usize) {
+    let dir = test_dir();
+    let (mut supervision, events) = prepared(
+        "cancel-ignore",
+        FixtureParticipant::new(ProtocolWaits::TS2),
+        None,
+    );
+    let mut root = root_in(&dir);
+    supervision.start(&mut root).unwrap();
+    supervision.user_signal(false);
+    assert!(supervision.stage1_active());
+    let now = Instant::now();
+    // Both deadlines passed before the next inspected turn. The fault
+    // precedes the Stage1 grace by one full second, without shortening waits.
+    supervision.stage1.as_mut().unwrap().started =
+        now - ProtocolWaits::TS2.stage1_cancel_grace - Duration::from_secs(1);
+    supervision.next_sample = None;
+    let (wait, cause) = match which {
+        0 => {
+            supervision.handshake_done = false;
+            supervision.spawned_at =
+                Some(now - supervision.waits.handshake - Duration::from_secs(2));
+            (BoundedWait::Handshake, Cause::HandshakeDeadline)
+        }
+        1 => {
+            supervision.handshake_done = true;
+            supervision.spawned_at =
+                Some(now - supervision.waits.wall_clock - Duration::from_secs(2));
+            (BoundedWait::WallClock, Cause::Deadline)
+        }
+        2 => {
+            supervision.handshake_done = true;
+            supervision.health_due = Some(now - Duration::from_secs(2));
+            (BoundedWait::LivenessWindow, Cause::Liveness)
+        }
+        _ => unreachable!(),
+    };
+    supervision.timers();
+    assert_eq!(supervision.first_cause, Some(Cause::UserCancel));
+    assert!(supervision.user_interrupted);
+    assert!(
+        supervision.later_causes.contains(&cause),
+        "older {wait:?} fault suppressed by later grace"
+    );
+    assert!(
+        events
+            .borrow()
+            .iter()
+            .any(|(_, e)| *e == SupervisionEvent::WaitExpired(wait))
+    );
+    assert!(
+        !supervision
+            .seams
+            .facts
+            .borrow()
+            .iter()
+            .any(|f| matches!(f, records::RecordFact::CancelForced { .. })),
+        "fault forces T2 without cancel.forced"
+    );
+    assert!(supervision.ladder.unwrap().term_at.is_some());
+    let cap = Instant::now() + HANDSHAKE;
+    while supervision.state != State::Settled {
+        assert!(Instant::now() < cap);
+        supervision.turn();
+    }
+    assert_eq!(
+        supervision.take_settlement().unwrap().first_cause(),
+        Cause::UserCancel
+    );
+}
+#[test]
+fn d3b2_review_older_handshake_deadline_precedes_later_grace() {
+    d3b2_late_timer_fault(0);
+}
+#[test]
+fn d3b2_review_older_wall_deadline_precedes_later_grace() {
+    d3b2_late_timer_fault(1);
+}
+#[test]
+fn d3b2_review_older_liveness_deadline_precedes_later_grace() {
+    d3b2_late_timer_fault(2);
+}
