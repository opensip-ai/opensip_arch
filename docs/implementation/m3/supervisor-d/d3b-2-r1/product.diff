+        tracking.evidence.state(M::Sigterm),
+        RevocationMarkState::Satisfied
+    );
+    assert_eq!(
+        tracking.evidence.state(M::ProtocolCancel),
+        RevocationMarkState::Missed
+    );
+    assert_eq!(tracking.evidence.observation.monotonic_before(), reference);
+    assert_eq!(
+        tracking.deadlines[M::KillAndReap as usize],
