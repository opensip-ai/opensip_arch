+fn d3b2_marks_failed_determinations_through_settlement_are_once_and_lower_bound() {
+    for recover in [false, true] {
+        let dir = test_dir();
+        let (mut supervision, _) = prepared(
+            "cancel-ignore",
+            FixtureParticipant::new(ProtocolWaits::TS2),
+            None,
+        );
+        let observed = opensip_platform::observe_clock().unwrap();
+        supervision
+            .seams
+            .revocation_reads
+            .push_back(Ok(d3b2_sample(&observed, Duration::ZERO)));
+        supervision
+            .seams
+            .revocation_reads
+            .push_back(Err(d3b2_clock_failure()));
+        if !recover {
+            for _ in 0..6 {
+                supervision
+                    .seams
+                    .revocation_reads
+                    .push_back(Err(d3b2_clock_failure()));
+            }
+        }
+        assert!(supervision.handle().revoked(observed));
+        let mut root = root_in(&dir);
+        supervision.start(&mut root).unwrap();
+        let cap = Instant::now() + HANDSHAKE;
+        while supervision.state != State::Settled {
+            assert!(Instant::now() < cap);
+            supervision.turn();
+        }
+        let settlement = supervision.take_settlement().unwrap();
+        let evidence = settlement.revocation_evidence().unwrap();
+        assert!(
+            evidence
+                .states
+                .iter()
+                .all(|s| *s != RevocationMarkState::Pending)
+        );
+        let facts = supervision.seams.facts.borrow();
+        let misses: Vec<_> = facts
+            .iter()
+            .filter_map(|f| match f {
+                records::RecordFact::RevocationMissed {
+                    mark, measurement, ..
+                } => Some((*mark, *measurement)),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(misses.len(), if recover { 1 } else { 4 });
+        assert_eq!(evidence.determination_failures().len(), misses.len());
+        for (index, (mark, measurement)) in misses.iter().enumerate() {
+            assert!(matches!(
+                measurement,
+                records::RevocationMeasurement::LowerBound(_)
+            ));
+            assert!(!misses[..index].iter().any(|(earlier, _)| earlier == mark));
+        }
+        if recover {
+            assert_eq!(
+                evidence.state(opensip_operability::RevocationMark::ScratchCleanup),
+                RevocationMarkState::Satisfied
+            );
+        } else {
+            assert_eq!(supervision.seams.revocation_clock_reads, 5);
+        }
+    }
