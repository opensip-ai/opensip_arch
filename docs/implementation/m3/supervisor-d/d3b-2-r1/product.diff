+fn d3b2_queue_kind(handle: &SupervisionHandle, kind: u8) -> bool {
+    match kind {
+        0 => handle.user_signal(),
+        1 => {
+            let first = handle.user_signal();
+            let second = handle.user_signal();
+            first && second
+        }
+        2 => handle.revoked(opensip_platform::observe_clock().unwrap()),
+        3 => handle.observer_fail_stop(opensip_platform::observe_clock().unwrap()),
+        _ => unreachable!(),
+    }
+}
+fn d3b2_state_case<P: Participant>(mut supervision: Supervision<P>, phase: &str, kind: u8) {
+    let dir = test_dir();
+    let events: Events = Rc::default();
+    let sink = Rc::clone(&events);
+    let handle = supervision.handle();
+    let at_spawn = phase == "spawning";
+    let spawned_handle = handle.clone();
+    supervision.observer = Some(Box::new(move |event| {
+        sink.borrow_mut().push((Instant::now(), event.clone()));
+        if at_spawn && matches!(event, SupervisionEvent::Spawned { .. }) {
+            assert!(d3b2_queue_kind(&spawned_handle, kind));
+        }
+    }));
+    let facts = Rc::clone(&supervision.seams.facts);
+    let sink = Rc::clone(&facts);
+    supervision.record_facts(Box::new(move |fact| sink.borrow_mut().push(fact)));
+    if phase == "prepared" {
+        assert!(d3b2_queue_kind(&handle, kind));
+    }
+    if phase == "reaping" {
+        supervision.seams.reap_blocked = true;
+    }
+    let is_tool = supervision.class == Class::Tool;
+    let mut root = root_in(&dir);
+    supervision.start(&mut root).unwrap();
+    let cap = Instant::now() + HANDSHAKE;
+    if !matches!(phase, "prepared" | "spawning" | "handshaking") {
+        if matches!(phase, "reaping" | "settled") {
+            while if phase == "settled" {
+                supervision.state != State::Settled
+            } else {
+                !(supervision.state == State::Reaping
+                    && supervision.clean_at.is_some()
+                    && supervision.ladder.is_none())
+            } {
+                assert!(
+                    Instant::now() < cap,
+                    "{phase}, kind{kind}: {:?}",
+                    events.borrow()
+                );
+                supervision.turn();
+            }
+        } else {
+            while supervision.state != State::Running {
+                assert!(Instant::now() < cap);
+                supervision.turn();
+            }
+            if matches!(phase, "stopping" | "killing") {
+                supervision.trigger(Cause::HostFault);
+                if phase == "killing" {
+                    // A delayed turn after TERM: actual native KILL, before
+                    // the separate exit source has been serviced.
+                    supervision.ladder_step();
+                    supervision.ladder.as_mut().unwrap().term_at =
+                        Some(Instant::now() - TERM_TO_KILL);
+                    supervision.ladder_step();
+                    assert_eq!(supervision.state, State::Killing);
+                }
+            }
+        }
+    }
+    if !matches!(phase, "prepared" | "spawning") {
+        let accepted = d3b2_queue_kind(&handle, kind);
+        assert_eq!(accepted, phase != "settled");
+    }
+    if phase == "settled" {
+        assert_eq!(supervision.late_events(), if kind == 1 { 2 } else { 1 });
+    } else {
+        supervision.turn();
+        supervision.seams.reap_blocked = false;
+        while supervision.state != State::Settled {
+            assert!(
+                Instant::now() < cap,
+                "{phase}, kind{kind}: {:?}",
+                events.borrow()
+            );
+            supervision.turn();
+        }
+    }
+    let settlement = supervision.take_settlement().unwrap();
+    let expected = if phase == "settled" {
+        Cause::Clean
+    } else if matches!(phase, "stopping" | "killing") {
+        Cause::HostFault
+    } else if phase == "reaping" && !is_tool && kind == 0 {
+        Cause::Clean
+    } else {
+        match kind {
+            0 | 1 => Cause::UserCancel,
+            2 => Cause::Revoked,
+            3 => Cause::ObserverFailStop,
+            _ => unreachable!(),
+        }
+    };
+    assert_eq!(
+        settlement.first_cause(),
+        expected,
+        "{phase}, kind{kind}: {:?}",
+        events.borrow()
+    );
+    assert_eq!(
+        settlement.user_interrupted(),
+        kind < 2 && phase != "settled"
+    );
+    if kind >= 2 && phase != "settled" {
+        let evidence = settlement.revocation_evidence().unwrap();
+        assert!(
+            evidence
+                .states
+                .iter()
+                .all(|s| *s != RevocationMarkState::Pending)
+        );
+        if is_tool {
+            assert_eq!(
+                evidence.state(opensip_operability::RevocationMark::ProtocolCancel),
+                RevocationMarkState::Inapplicable
+            );
+        }
+        assert!(!settlement.admissible());
+    }
+    assert_eq!(
+        events
+            .borrow()
+            .iter()
+            .filter(|(_, e)| matches!(e, SupervisionEvent::Settled(_)))
+            .count(),
+        1
+    );
+    if is_tool || matches!(phase, "stopping" | "killing" | "settled") {
+        assert!(
+            !facts
+                .borrow()
+                .iter()
+                .any(|f| matches!(f, records::RecordFact::CancelForced { .. }))
+        );
+        assert!(settlement.stage1_evidence().is_none());
+    }
+}
