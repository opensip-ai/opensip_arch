+fn d3b2_root_stalled_inband_does_not_extend_grace_or_complete_after_force() {
+    let dir = test_dir();
+    let (mut supervision, _) = prepared(
+        "cancel-ignore",
+        FixtureParticipant::new(ProtocolWaits::TS2),
