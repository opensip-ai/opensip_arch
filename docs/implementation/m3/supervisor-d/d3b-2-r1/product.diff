+/// Bridge owned by the root tests: phase checks use the real participant's
+/// public phase, without exposing production loop or descriptor internals.
+pub(crate) fn ts2_root_phase_control(
+    participant: crate::provider_protocol::ts2::Ts2Participant<'_>,
+    bundle: Value,
+    phase: &str,
+) {
+    let dir = test_dir();
+    let bundle_path = dir.0.join("ts2-first-party-responses.cbor");
+    std::fs::write(&bundle_path, write_frame(&bundle).unwrap()).unwrap();
+    let script = format!("ts2-root:{}", bundle_path.display());
+    let mut spec = spec_for(&fixture(), &script);
+    spec.selection.tuple.role_subprotocol = "typescript-semantic".to_owned();
+    spec.selection.tuple.subprotocol_version = 2;
+    let mut supervision = Supervision::prepare(spec, participant).unwrap();
+    let facts = Rc::new(RefCell::new(Vec::new()));
+    let sink = Rc::clone(&facts);
+    supervision.record_facts(Box::new(move |fact| sink.borrow_mut().push(fact)));
+    let events: Events = Rc::default();
+    let sink = Rc::clone(&events);
+    supervision.observer = Some(Box::new(move |event| {
+        sink.borrow_mut().push((Instant::now(), event.clone()))
+    }));
+    let mut root = root_in(&dir);
+    supervision.start(&mut root).unwrap();
+    let cap = Instant::now() + HANDSHAKE;
+    loop {
+        let at = match phase {
+            "handshake" => supervision.state == State::Handshaking,
+            "startup" => supervision.state == State::Running,
+            "snapshot" => supervision
+                .participant
+                .as_ref()
+                .unwrap()
+                .phase()
+                .contains("SNAPSHOT"),
+            "analysis" => supervision.participant.as_ref().unwrap().phase() == "ANALYZING",
+            "terminal" => supervision.terminal == Some(TerminalKind::Complete),
+            _ => unreachable!(),
+        };
+        if at {
+            break;
+        }
+        assert!(
+            Instant::now() < cap,
+            "phase {phase} never reached; actual {:?}, {:?}",
+            supervision.state,
+            supervision.participant.as_ref().unwrap().phase()
+        );
+        assert_ne!(
+            supervision.state,
+            State::Settled,
+            "premature settlement reaching {phase}: {:?}",
+            events.borrow()
+        );
+        supervision.turn();
+    }
+    assert!(supervision.handle().user_signal());
+    while supervision.state != State::Settled {
+        assert!(
+            Instant::now() < cap,
+            "{phase} did not settle: {:?}",
+            events.borrow()
+        );
+        supervision.turn();
+    }
+    let mut settlement = supervision.take_settlement().unwrap();
+    assert!(settlement.user_interrupted(), "{phase}");
+    assert_eq!(
+        settlement.exit(),
+        ExitClass::Exited(0),
+        "{phase}: {:?}",
+        events.borrow()
+    );
+    assert!(
+        !settlement.later_causes().contains(&Cause::ProviderProtocol),
+        "{phase}: {:?}",
+        events.borrow()
+    );
+    assert_eq!(
+        records::settlement_route(&settlement),
+        records::OwnerRoute::Interrupted
+    );
+    if phase == "terminal" {
+        assert_eq!(settlement.first_cause(), Cause::Clean);
+        assert!(settlement.stage1_evidence().is_none());
+        assert!(
+            !facts
+                .borrow()
+                .iter()
+                .any(|f| matches!(f, records::RecordFact::CancelSent { .. }))
+        );
+    } else {
+        assert_eq!(
+            settlement.first_cause(),
+            Cause::UserCancel,
+            "{phase}: {:?}",
+            events.borrow()
+        );
+        assert_eq!(settlement.terminal(), Some(TerminalKind::Cancelled));
+        assert_eq!(
+            settlement.stage1_evidence(),
+            Some(Stage1Evidence {
+                inband: InbandCancel::Written,
+                control: Some(ControlCancel::Written)
+            })
+        );
+        assert!(!settlement.admissible());
+        assert!(settlement.release().is_none());
+        assert_eq!(
+            facts
+                .borrow()
+                .iter()
+                .filter(|f| matches!(
+                    f,
+                    records::RecordFact::CancelSent {
+                        inband: true,
+                        control_reason: opensip_operability::ControlCancelReason::User
+                    }
+                ))
+                .count(),
+            1
+        );
+        assert!(
+            !facts
+                .borrow()
+                .iter()
+                .any(|f| matches!(f, records::RecordFact::CancelForced { .. }))
+        );
+    }
+    assert_eq!(
+        events
+            .borrow()
+            .iter()
+            .filter(|(_, e)| matches!(e, SupervisionEvent::Settled(_)))
+            .count(),
+        1
+    );
+    assert_eq!(settlement.scratch(), ScratchFate::Removed);
+}
