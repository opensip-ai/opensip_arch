+
+fn cbor_member<'a>(value: &'a Value, key: &str) -> &'a Value {
+    if let Value::Map(pairs) = value
+        && let Some((_, v)) = pairs.iter().find(|(k, _)| k == key)
+    {
+        return v;
+    }
+    panic!("first-party fixture value lacks {key}");
+}
+fn cbor_text(value: &Value) -> &str {
+    if let Value::Text(s) = value {
+        s
+    } else {
+        panic!("first-party text")
+    }
+}
+fn ts2_reply(data: &mut Data, sequence: &mut u64, kind: &str, payload: Value) {
+    let envelope = Value::Map(vec![
+        ("protocolMajor".to_owned(), Value::Unsigned(2)),
+        ("frameType".to_owned(), Value::Text(kind.to_owned())),
+        ("sequence".to_owned(), Value::Unsigned(*sequence)),
+        ("payload".to_owned(), payload),
+    ]);
+    *sequence += 1;
+    data.out
+        .as_mut()
+        .unwrap()
+        .write_all(&write_frame(&envelope).unwrap())
+        .unwrap();
+}
+/// Responses are schema-valid payloads generated by the real codec's
+/// first-party tests. Sequence and Cancel echo follow actual received bytes.
+fn ts2_root_data(input: &mut File, data: &mut Data, ack: &mpsc::Receiver<()>, bundle_path: &str) {
+    let bytes = std::fs::read(bundle_path).unwrap();
+    let bundle = read_frame(&mut bytes.as_slice(), Profile::Rust3, 16, None)
+        .unwrap()
+        .unwrap();
+    let bundle = bundle.value();
+    let mode = cbor_text(cbor_member(bundle, "mode"));
+    let mut sequence = 0;
+    let mut observed = "handshake";
+    while let Some(frame) = read_frame(
+        input,
+        Profile::Ts2,
+        opensip_components::provider_protocol::ts2::TS2_FRAME_MAX_DEPTH,
+        None,
+    )
+    .unwrap()
+    {
+        let kind = cbor_text(cbor_member(frame.value(), "frameType"));
+        match kind {
+            "Hello" if !matches!(mode, "handshake" | "startup") => ts2_reply(
+                data,
+                &mut sequence,
+                "HelloAck",
+                cbor_member(bundle, "HelloAck").clone(),
+            ),
+            "OpenUniverse" => {
+                observed = "universe";
+                ts2_reply(
+                    data,
+                    &mut sequence,
+                    "UniverseAccepted",
+                    cbor_member(bundle, "UniverseAccepted").clone(),
+                );
+            }
+            "SnapshotManifest" => observed = "snapshot",
+            "SnapshotSeal" if mode != "snapshot" => {
+                ts2_reply(
+                    data,
+                    &mut sequence,
+                    "SnapshotAccepted",
+                    cbor_member(bundle, "SnapshotAccepted").clone(),
+                );
+                ts2_reply(
+                    data,
+                    &mut sequence,
+                    "NativeContextVerified",
+                    cbor_member(bundle, "NativeContextVerified").clone(),
+                );
+            }
+            "Analyze" => {
+                observed = "analysis";
+                if mode == "terminal" {
+                    let Value::Array(replies) = cbor_member(bundle, "analysis") else {
+                        panic!("first-party replies")
+                    };
+                    for reply in replies {
+                        ts2_reply(
+                            data,
+                            &mut sequence,
+                            cbor_text(cbor_member(reply, "kind")),
+                            cbor_member(reply, "payload").clone(),
+                        );
+                    }
+                }
+            }
+            "Cancel" => {
+                let payload = cbor_member(frame.value(), "payload");
+                let reply = Value::Map(vec![
+                    (
+                        "executionId".to_owned(),
+                        cbor_member(payload, "executionId").clone(),
+                    ),
+                    (
+                        "analysisOrdinal".to_owned(),
+                        cbor_member(payload, "analysisOrdinal").clone(),
+                    ),
+                    ("observedPhase".to_owned(), Value::Text(observed.to_owned())),
+                ]);
+                ts2_reply(data, &mut sequence, "Cancelled", reply);
+            }
+            _ => {}
+        }
+    }
+    // Control cancel (or normal shutdown) is fully received before exit.
+    assert!(ack.recv_timeout(Duration::from_secs(10)).is_ok());
+}
