kpoint-378/archive-pin.json", "sha256": "2ae7e34cf5b5b388ca7a8774de9ba9c32b3dd91cc816a100670cb49ff015c678"}, {"bytes": 1806, "path": "docs/implementation/m2/trials/directory-volume-checkpoint-378/subject.json", "sha256": "431f57f7c603e7f8b7c36c49aa39970ca2515b1e5972c95a77eb89690e22254b"}, {"bytes": 49560, "path": "docs/implementation/m2/trials/directory-volume-checkpoint-378/subject.tar.xz", "sha256": "fc263be1464603c6a49009ac399fce9024d66138eff713b06dbc34807dced2de"}, {"bytes": 1708, "path": "docs/implementation/m2/trials/native-observation-integration-checkpoint-380/README.md", "sha256": "9a6fb3b861d2deb15c2f6d13b215bc2e35355d0a539d4870d9bbd21f2f0ac39e"}, {"bytes": 207, "path": "docs/implementation/m2/trials/native-observation-integration-checkpoint-380/archive-pin.json", "sha256": "db397ed3d282e967021601cd336070a61afdf2c0d401589b582b82a428222862"}, {"bytes": 113163, "path": "docs/implementation/m2/trials/native-observation-integration-checkpoint-380/subject.json", "sha256": "6f09409c83b94968686c6a9164c15ec3c05e5b3808df0c2d651284c33bf1b72a"}, {"bytes": 6856252, "path": "docs/implementation/m2/trials/native-observation-integration-checkpoint-380/subject.tar.xz", "sha256": "4bdbeb920f778df4f20423335d2201fb7f3e001292887c36dc92627c9b9274b6"}], "passageOverrides": [], "passageSupersessions": [], "selected": "docs/implementation/m2/native-runtime-selection-v27/successor.json", "sha256": "8fdf8fea3d87a2fed875a912797e8990178e6747b265286b6c8e04a25c44c5d7"}, {"inputs": [{"bytes": 356, "path": "docs/implementation/m2/project-registry-owner-selection-v2/COUNT-CORRECTION.md", "sha256": "333a5023f19b8d59388d6c5f0dcd9fcd30fdedec4e4fe77006fa15c86d42d658"}, {"bytes": 3031, "path": "docs/implementation/m2/project-registry-owner-selection-v2/README.md", "sha256": "d31cf6adb13f2337337f2653df035e29d9b64d34301942ca9f36eaf72c44f7ab"}, {"bytes": 11887, "path": "docs/implementation/m2/project-registry-owner-selection-v2/effective-owner-overrides.json", "sha256": "1da494b05bbc7a8cfe5dac279