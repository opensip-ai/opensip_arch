entation/m3/preview-pack-i1/i1-a/successor.json", "sha256": "7d6c04e9914809409e01027e63d7b9cde670c6e8757538a13b743b9d0af5a03d"}, {"inputs": [{"bytes": 3615, "path": "docs/implementation/m2/read-endpoint-x3a2-descriptions/README.md", "sha256": "dd6ca016f823724cb96c7ce9b63c207fbb6e7bad5420bde1b929cc6e805f1dcc"}, {"bytes": 4363, "path": "docs/implementation/m2/read-endpoint-x3a2-descriptions/evidence/build_descriptions.py", "sha256": "38604551356fa6149887bb9538cc920786b78c90b4e89b3cd336fc2579678212"}, {"bytes": 2780, "path": "docs/implementation/m2/read-endpoint-x3a2-descriptions/evidence/descriptions.json", "sha256": "d0a7dead11bf8e69e578df7c70958049a2ec04af55e31cf4a3e2f53a8b126af3"}], "passageOverrides": [{"after": "Host-owned provisional pair/marker bundle over the read session's selected store endpoint (law X3a r5 item 4, unit X3a-2): the pair through the host's provisional selection and the endpoint marker through storage's provisional marker, bound to the pair's S, both from the session's one read and never captured again. One full session recheck covers both and compares their full samples; the contributing samples are I's, the fence carrier's and the marker's, then the pair's, each after a full recheck and on H's filesystem. The bundle is no namespace, project, profile, active-slot or current authority admission.", "before": "Host-owned provisional pair/marker bundle. S equality is not full S/G/K, namespace/lineage, core/profile, active-slot or current authority admission.", "parent": {"bytes": 555473, "path": "docs/implementation/m2/repository-file-inventory.v136.json", "sha256": "ba124e21d23c8cd100eb2031203fd5c04fd8aeaab056872af54d1fa8c92bacea"}, "selector": {"jsonPointer": "/files/122/description"}}, {"after": "Host-owned provisional selection (law X3a r5 item 4, unit X3a-2): the decoded selection pair of the read session's selected store endpoint, taken through the session's endpoint admission from its one read and never captured again. Its recheck, run before the pair is handed out, is the session's full recheck and compares the pair's full sample; its filesystem sample follows that recheck, with the pair reopened by name under the retained I, its full sample unchanged and on H's filesystem. A pair the session cannot read or decode refuses the fence, never an invitation to create I. Grants no namespace, project, profile, active slot, current authority or initialization permission.", "before": "Host-owned provisional selection capture. Does not admit a selected store, core, profile, active slot, current authority or initialization permission.", "parent": {"bytes": 555473, "path": "docs/implementation/m2/repository-file-inventory.v136.json", "sha256": "ba124e21d23c8cd100eb2031203fd5c04fd8aeaab056872af54d1fa8c92bacea"}, "selector": {"jsonPointer": "/files/123/description"}}, {"after": "Storage-owned marker syntax over the read session's selected store endpoint (law X3a r5 item 4, unit X3a-2): the endpoint marker bytes of the session's one read, never captured again, decoded by the shared store-marker codec and bound to the requested S, so a request for any other store refuses on the binding row; an invalid requested S refuses before any native step. Its recheck is the session's full recheck, which compares the marker's full sample; its samples follow that recheck and are I's, the fence carrier's and the marker's, the marker reopened by name under the retained I with its full sample unchanged, each on H's filesystem. A matched marker identifies S only. No full G/K, profile or current authority.", "before": "Storage-owned marker syntax on the original native-fenced descendant capture. A matched marker identifies S only. No full G/K, profile or current authority.", "parent": {"bytes": 555473, "path": "docs/implementation/m2/repository-file-inventory.v136.json", "sha256": "ba124e21d23c8cd100eb2031203fd5c04fd8aeaab056872af54d1fa8c92bacea"}, "selector": {"jsonPointer": "/files/747/description"}}], "passageSupersessions": [], "selected": "docs/implementation/m2/read-endpoint-x3a2-descriptions/successor.json", "sha256": "1e1a1f736db1d387f742626be49bd2c96275c3838b31ba88e5f8f84891096b0e"}, {"inputs": [{"bytes": 8473, "path": "docs/implementation/m3/verify-design-vd2/f8c/README.md", "sha256": "e004c4f08fa94e792166a4945a83b4a29eb1b822cf81ce9fd4d35960552b0f09"}, {"bytes": 4468, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/apply_pins_f8c.py", "sha256": "bd5dd0512c92c13fb41778dc591dbc2b8f5bc0113fd5feca480576a2fc8abfaa"}, {"bytes": 3011, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/drift_scratch_f8c.py", "sha256": "616c79415f304bc88246b6ede672ea19a499206129dc803f47a61208b8b99051"}, {"bytes": 7228, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/freeze_f8c.py", "sha256": "e60cd7dd874bb7b161e6943dc97247ca1bf7d8c1c503b54542e2bb6cdf271db9"}, {"bytes": 1632, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/generation-summary.json", "sha256": "b878a368efc4d9c46752342c24e64c8b5b9d8562d42b6b66d9a97f2aa8cf5618"}, {"bytes": 1445, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/pins-report.json", "sha256": "ec3d6101d593a675153aa68e05365763402ca56231e918aa1dca4e6801e75e2e"}, {"bytes": 4782, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/run_generation_f8c.py", "sha256": "2d1eb6771382bd1410aa9b8f6b5d3a20b7b970a2a347eb0e47cb6344296917c4"}, {"bytes": 1658, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/stage_lock_f8c.py", "sha256": "bc18c86f8157e8646c76941e6ea85b5656a7fb772641eb7ec0b7f49e03226d86"}, {"bytes": 5003, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/typescript_scratch_f8c.py", "sha256": "924687a6129bb8b993733bc03bf11060cd27a85402c1e162bbe4e719bf68262d"}, {"bytes": 8189, "path": "docs/implementation/m3/verify-design-vd2/f8c/evidence/verify_scratch_f8c.py", "sha256": "2cde08b446ec1550e0445141a24e6c4d8847464be25ea7df3a0d771d5cc84a8d"}, {"bytes": 2946, "path": "docs/implementat