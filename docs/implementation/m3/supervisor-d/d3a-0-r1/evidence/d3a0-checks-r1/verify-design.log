snapshot-plan-c/r3-mr1-r1/evidence/check.py", "sha256": "259c3bcdf5f8b9da0169ecd7313071d1c83b9e828d0261350f5e9e11263d9d8f"}, {"bytes": 833, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/evidence/dependencies.json", "sha256": "44204f549a68dc6b6cf435a3d813a8572135d5b45e1519f5b63a0e0e3067993b"}, {"bytes": 7547, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/evidence/recipe-controls.json", "sha256": "e1c2d2ade937d1dc0a5a531f2a33d50989071b435373b7487409f106680e3cf1"}, {"bytes": 1341, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/materialization-map.json", "sha256": "e6ffb479dafc11c7ae49f84bb11bd32d2fa5dc3fb00724a9d0ed88f5455683ba"}, {"bytes": 4489, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/owner-file-manifest-recipes.schema.json", "sha256": "cd0a1f73633d4a1e8c8f5ce770133c5a3173253bfe20635ba759d08af1da83ae"}, {"bytes": 1408, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/recipe-table.json", "sha256": "7f38b43aa4eca8b3a1c4c9be30e4af5230d08329e4160ec3815c9e1f22cc0442"}, {"bytes": 1830, "path": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/source.json", "sha256": "aef20cd9f67d5783af966bd8bb71751f290485ada833a734158557b7ed59c643"}], "passageOverrides": [{"after": "## S10. Execution principal `repository-code`\n\n**R3-MR1 prospective owner file-manifest membership and raw recipes.** The exact CONTRACT.md, recipe-table.json, owner-file-manifest-recipes.schema.json and materialization-map.json under docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/ select complete retained sealed snapshot sourceInventory for admitted snapshot owners and one complete admitted dependency package file manifest for dependency owners. ownerFileManifestSha256 is raw SHA256 of the exact source-selected canonical array, preserving snapshot Blob fields and dependency manifest fields without row expansion/filter/wrapper. Source admission remains indispensable; equal files do not transfer owner/source authority. Existing canonical/order/shape/custody/bounds and native domain/security owner-row digest distinctions remain. Snapshot recipe adds no descriptor capacity restriction. One future security-owned library function is also used by the harness. This narrow membership/recipe selection does not resolve complete R3: exact package/owner witness codecs, producer/provenance/failure publication and actual owning library/product controls remain required before C3c. Historical records and recipe/schema selections are not rewritten.\n", "before": "## S10. Execution principal `repository-code`", "parent": {"bytes": 119915, "path": "docs/v2/contracts/product-v1/security-and-lifecycle.md", "sha256": "a319da39b9f90aff4483a295af3fe004540c71861fb2bd34e84c7e1318bad9d6"}, "selector": {"line": 1056}}, {"after": "### 3.6 `PreparedOutputSetV3`: inert rows only (feedback 4, R2)\n\n**R3-MR1 prospective prepared owner-file-manifest recipes.** docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/CONTRACT.md and exact source-specific schema/recipe table select the security-owned raw owner digest preimage for new-M3 prepared inputBinding. Complete retained snapshot Blob array or admitted dependency package manifest array is chosen only by actual admitted source witness. No ambient path, caller subset, source default, raw-vs-domain digest substitution or extra snapshot capacity restriction. PO1 stale checks, dependencySourceSetId/toolchain/cfg and inert owner/site/generated joins remain unchanged. Complete R3/package-owner codec/failure publication and actual product controls remain open; this selection alone does not admit prepared owners or enable C3c.\n", "before": "### 3.6 `PreparedOutputSetV3`: inert rows only (feedback 4, R2)", "parent": {"bytes": 329013, "path": "docs/v2/contracts/product-v1/native-evidence.md", "sha256": "83b99783893bec4bcca76bc043310e1d33305fc41ef85e012fbcb19e5b222ca0"}, "selector": {"line": 1803}}], "passageSupersessions": [], "selected": "docs/implementation/m3/snapshot-plan-c/r3-mr1-r1/successor.json", "sha256": "92dee50de2303d99f9111c14d8cda528a06bae2400c1dc4f1350e1f8acffbce9"}, {"inputs": [{"bytes": 2404, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/CONTRACT.md", "sha256": "5d904b206e23d8134cf6b261922a49c9922af49d1a7a9d156c10833f38311ad8"}, {"bytes": 966, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/README.md", "sha256": "554a548f0f85139140f98a1156bbb9c300663bfb986bd439970679af0c45453a"}, {"bytes": 1874, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/evidence/check.py", "sha256": "3d6ace9f15a1e92c6c6a6b83d2e86d4edfe677013417c05c8bc67aa797eb1935"}, {"bytes": 833, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/evidence/dependencies.json", "sha256": "44204f549a68dc6b6cf435a3d813a8572135d5b45e1519f5b63a0e0e3067993b"}, {"bytes": 5011, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/evidence/reference-controls.json", "sha256": "2ac368cd7b0b5db343572f21bd81a91da1ca4e04e2ab7e2d7d7ca54c9622c1d2"}, {"bytes": 829, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/materialization-map.json", "sha256": "cf748b6c01275e62c1bf545f0a0b80f7e07f9f38e32ae7a2850cfa366169d468"}, {"bytes": 1249, "path": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/source.json", "sha256": "83ac5ba54f9286f08468315cb4e4241b90f177769659757578edefbdac21b751"}], "passageOverrides": [{"after": "### 3.3 Cargo configuration: verified carrier, exact flags (feedback 5, 10)\n\n**C-ENV1 prospective CC2/CC3 private-home exception clarification.** The exact CONTRACT.md and materialization-map.json under docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/ make the existing native model/positive-case exception explicit: CC3 admits exactly the host-constructed CARGO_HOME assignment to this invocation's actual fresh private empty CC2 directory, and no other CARGO override. It is required, not inherited/caller-selected; a claimed string or the symbolic model marker <private-empty> cannot substitute for actual admitted directory provenance. Missing/nonprivate CARGO_HOME and other prohibited overrides keep existing CC owners/order/public composition. Native schema facts cargoHome=private-empty/environmentProjection=none, CC1/4/5/metadata/incomplete rules and historical identities/schemas stay unchanged. The private path stays operational and enters no content identity; no HOME mutation, ambient source read, new source/failure vocabulary, actual adapter/carrier or platform qualification is selected. Exact symbolic reference controls are design evidence only; owning native product implementation and its actual controls remain open.\n", "before": "### 3.3 Cargo configuration: verified carrier, exact flags (feedback 5, 10)", "parent": {"bytes": 329013, "path": "docs/v2/contracts/product-v1/native-evidence.md", "sha256": "83b99783893bec4bcca76bc043310e1d33305fc41ef85e012fbcb19e5b222ca0"}, "selector": {"line": 1714}}], "passageSupersessions": [], "selected": "docs/implementation/m3/snapshot-plan-c/cargo-carrier-env-r1/successor.json", "sha256": "df15a56540f26c9c64fd567b1af064e5191f9de7d9021cc9ecd0aca5f12be509"}, {"inputs": [{"bytes": 6119, "path": "docs/implementation/m3/snapshot-plan-c/native-key-codec-r1/CONTRACT.md", "sha256": "e00369f2d3791e524534a48c752375c601db0bc568c137c62fe44d6859989982"}, {"bytes": 426, "path": "docs/implementation/m3/snapshot-plan-c/native-key-codec-r1/README.md", "sha256": "9ba3c5acad011a3c54fb414ba6dd231f952a5e0be09ddd20889e3c02da7e33df"}, {"bytes": 6973, "path": "docs/implementation/m3/snapshot-plan-c/native-key-codec-r1/evidence/check.py", "sha256": "8ea0f6a56ff6c974e2feed908e0157694ffdd003a8740d4c9d0ec659cec68f1f"}, {"bytes": 12704, "path": "docs/implementation/m3/snapshot-plan-c/native-key-codec-r1/evidence/codec-controls.json", "sha256": "4c36440253abba85d39d40bdaa905f0ddcaff5096df4a737e15634d88246fbf1"}, {"bytes": 833, "path": "docs/implementation/m3/snapshot-plan-c/native-key-codec-r1/evidence/depend