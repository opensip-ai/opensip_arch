"}, {"bytes": 65062, "path": "docs/implementation/m2/existing-root-diagnostics-468a/product/schemas/sources/common-v4.schema.json", "sha256": "661b9fdae1b15238160cd4812456c5bc91cadfd5202ea3201a3ac8aabe4708d4"}, {"bytes": 68280, "path": "docs/implementation/m2/existing-root-diagnostics-468a/product/tools/contracts/generator-closure.json", "sha256": "7fcfa1049aec2d9f92f262c4a58099ca712fb2dfd166fa225defe6ccb3c7f3d8"}, {"bytes": 62827, "path": "docs/implementation/m2/existing-root-diagnostics-468a/reference/public-detail-registry.json", "sha256": "2832bf1f3e7c76bb91fd1ee99fce29e00cd472b9ea3a554d7751be165cc3d1f0"}, {"bytes": 17170, "path": "docs/implementation/m2/existing-root-diagnostics-468a/schemas/admission-registry.json", "sha256": "595fc28d3ebf5442c6737e00c76729e83d5f707ca4e858a69b355a14761c5f11"}, {"bytes": 65062, "path": "docs/implementation/m2/existing-root-diagnostics-468a/schemas/common.v4.schema.json", "sha256": "661b9fdae1b15238160cd4812456c5bc91cadfd5202ea3201a3ac8aabe4708d4"}], "passageOverrides": [{"after": "Own the initial creator's pre-installation attempt: one per process, the only work ledger for the whole act and a failure latch, with private non-Clone receipts bound to the attempt. Mint the InitialActor (equal real and effective UID, a plain absolute home spelling that fits I within 4096 bytes and 256 components) and recheck it; classify storage (constant UNKNOWN), apply the first-creation backup choice, write and flush the first-write disclosure, and mint, recheck and consume the single-use CreationIntent with its request and execution ids at StepId 0. It opens no installation path, creates nothing, and does not enable the creator.", "before": "Allocate the one pre-installation attempt per process, owning the single work ledger and a failure latch, and mint the attempt-bound InitialActor from the charged account observation: equal real and effective UID and a plain absolute home spelling that fits I within 4096 bytes and 256 components. It opens no path, creates nothing, and does not enable the creator.", "parent": {"bytes": 297759, "path": "docs/implementation/m2/repository-file-inventory.v74.json", "sha256": "90ccda7e0b199ad4705661e5303581f4b6b4ab220b560a8ec93d9809dd982279"}, "selector": {"jsonPointer": "/files/242/description"}}, {"after": "Judge private-descendant ACL evidence and create private objects. Omission and the NOACL sentinel are unavailable, not an empty ACL; a present ACL must grant no group or other access, and mode must be exactly 0700 or 0600 for the invoking user. Charged helpers create one private file or directory, append the zero-rights owner allow of a fresh private creation when the sample omitted the ACL, observe a private directory, and spend an existing reservation for the creator's OpenSIP step. This grants no profile qualification, parent admission or creator authority.", "before": "Judge one already captured ACL sample for a private descendant. Omission and the NOACL sentinel are unavailable, not an empty ACL. A present ACL must grant no group or other access, including read and search, and mode must be exactly 0700 or 0600 for the invoking user. This predicate does not capture, qualify a profile, or create custody or creator authority.", "parent": {"bytes": 297759, "path": "docs/implementation/m2/repository-file-inventory.v74.json", "sha256": "90ccda7e0b199ad4705661e5303581f4b6b4ab220b560a8ec93d9809dd982279"}, "selector": {"jsonPointer": "/files/258/description"}}, {"after": "Own alloc-only full-triple lineage keys, the one relative node spelling transitions/lineage/S/G/K.node that every crate joins, closed canonical 4096-byte node decoding and bounded iterative supplied-chain inspection. Callers assemble OS paths from those components; the spelling is not resolution. Decoded chains do not prove native existence, publication, complete operation budget or authority.", "before": "Own alloc-only full-triple lineage keys, closed canonical4096-byte node decoding and bounded iterative supplied-chain inspection. Keep OS-path assembly in lifecycle; decoded chains do not prove native existence, publication, complete operation budget or authority.", "parent": {"bytes": 297759, "path": "docs/implementation/m2/repository-file-inventory.v74.json", "sha256": "90ccda7e0b199ad4705661e5303581f4b6b4ab220b560a8ec93d9809dd982279"}, "selector": {"jsonPointer": "/files/158/description"}}, {"after": "backup-managed storage root detected in CI without --allow-backup-custody", "before": "backup-managed storage root detected in CI without --allow-backup-custody or an admitted storage-policy record", "parent": {"bytes": 66800, "path": "docs/coop/design-corrections/workflows/command-inventory.v3.json", "sha256": "d303cc640154ff2b4473452c52f6578b5ffa3f20d6ed03c3976e0ddd397a4e66"}, "selector": {"jsonPointer": "/goldens/37/situation"}}, {"after": "pass --allow-backup-custody or choose --ephemeral", "before": "pass --allow-backup-custody, choose --ephemeral, or select another admitted root", "parent": {"bytes": 66800, "path": "docs/coop/design-corrections/workflows/command-inventory.v3.json", "sha256": "d303cc640154ff2b4473452c52f6578b5ffa3f20d6ed03c3976e0ddd397a4e66"}, "selector": {"jsonPointer": "/goldens/37/remedy"}}, {"after": "none; retention DEFAULTED durable-unbounded, the account-derived installation root and backup status unknown were disclosed before first write; no policy file written", "before": "none; retention DEFAULTED durable-unbounded was disclosed before first write; no policy file written", "parent": {"bytes": 66800, "path": "docs/coop/design-corrections/workflows/command-inventory.v3.json", "sha256": "d303cc640154ff2b4473452c52f6578b5ffa3f20d6ed03c3976e0ddd397a4e66"}, "selector": {"jsonPointer": "/goldens/0/remedy"}}, {"after": "backup-managed storage root detected in CI without --allow-backup-custody", "before": "backup-managed storage root detected in CI without --allow-backup-custody or an admitted storage-policy record", "parent": {"bytes": 67211