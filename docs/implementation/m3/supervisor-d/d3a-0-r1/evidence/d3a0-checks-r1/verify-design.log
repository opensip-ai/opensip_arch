": 19556, "path": "docs/implementation/m3/config-discovery-b/b2-b-reference/evidence/check.py", "sha256": "be618884e783c90ef7ff5dd33a1c2052ac2ee5ac54cfa5b3316e48c8065785cb"}, {"bytes": 34085, "path": "docs/implementation/m3/config-discovery-b/b2-b-reference/evidence/checks.json", "sha256": "7db7d5ce0d6c20735ad0220fd90e93162ae0e559d06afc4e484586c74cd19b15"}, {"bytes": 12574, "path": "docs/implementation/m3/config-discovery-b/b2-b-reference/reference/discovery_scan_reference.py", "sha256": "6714575ccee1474e2d7c20c4e5e9b6c95b498ad155ec1e69fc9d6ba5f3e7e32b"}], "passageOverrides": [], "passageSupersessions": [], "selected": "docs/implementation/m3/config-discovery-b/b2-b-reference/successor.json", "sha256": "45008a6c43bad96b7d882aec778f605b2acbc3cd2c9c94e824b497a0b3b16660"}, {"inputs": [{"bytes": 1699, "path": "docs/implementation/m3/config-discovery-b/b2-b4-descriptions/README.md", "sha256": "7fa7bb6ac5229065f9f0cc2650625d1e9140cf7cb8a0af8ef5b90205738a192a"}], "passageOverrides": [{"after": "B2-b4a T2 census record, regenerated through B2-b4b3 (the caps M3-B r7 item 12 records): per lead-readable entry and composed workspace, the integrity-verified pins, counts, and modeled objects, edges and bytes (affine in the root spelling length, reported at three root lengths) with per-mille margins against the discovery profile limits; the failing entries and the caps state (recorded-margin-holds, or returned-to-law when any entry fails); workspace rows walker-only for the full ledger; held-out rows outstanding, stale, or composed from a current B2-b4c blind receipt, with the held-out state. Design evidence, not qualification.", "before": "B2-b4a T2 census record: per lead-readable entry and composed workspace, the integrity-verified pins, counts and modeled objects and edges against the discovery profile limits; the failing entries and the caps returned to the law; held-out entries outstanding. Design evidence, not qualification.", "parent": {"bytes": 687868, "path": "docs/implementation/m2/repository-file-inventory.v199.json", "sha256": "239f95f58513c0d8573c7b837ba460acee1099fc3bf329124f70460d63eadb90"}, "selector": {"jsonPointer": "/files/547/description"}}, {"after": "Check the T2 census on scratch trees: the walker uses no more objects and edges than the census cost model predicts on every walk vector and composed-workspace vector; the census pins the cost closure and size inventory as compiled; each censused entry is classified against the discovery profile limits in objects, edges and bytes at the largest root length by charging a fresh ledger, and no lead-readable entry fails; composed held-out rows are classified by their blind margins, with coverage and the held-out state checked, and only a holding state meets the gate.", "before": "Check the T2 census on scratch trees: the walker uses no more objects and edges than the census cost model predicts on every walk vector and composed-workspace vector; the census pins the cost closure as compiled; each censused entry is classified against the discovery profile limits by charging a fresh ledger, and no margin is claimed for a failing entry.", "parent": {"bytes": 687868, "path": "docs/implementation/m2/repository-file-inventory.v199.json", "sha256": "239f95f58513c0d8573c7b837ba460acee1099fc3bf329124f70460d63eadb90"}, "selector": {"jsonPointer": "/files/548/description"}}, {"after": "M3-B units B2-b4a to B2-b4c: the T2 discovery census. Re-verifies each lead-readable T2 store against its pinned gitTree and QD-22 digest from stored bytes, no-follow; checks every modeled walk against the B2-b0 reference population; converts it to objects, edges and bytes (affine in the root spelling length, sizes from a closed inventory) by an abstract walk mirroring the redesigned walker, with unknowns at their dearer branch and constants read by anchors from a whole-pinned cost closure; censuses workspaces as composed checkouts; writes the census record and the soundness vectors. Its --held-out-blind mode (B2-b4 plan r6 section 2.5) measures each held-out store through one guarded join and writes only a closed-format receipt of margins or error classes, bound to its inputs; the ordinary mode never opens a held-out store and composes held-out rows only from a current receipt.", "before": "M3-B unit B2-b4a: the T2 discovery census. Re-verifies each lead-readable T2 store against its pinned gitTree and QD-22 digest from stored bytes, no-follow, never opening a held-out entry; checks every modeled walk against the B2-b0 reference population; converts it to objects and edges by an abstract walk mirroring the walker, with unknowns at their dearer branch and constants read by anchors from a whole-pinned cost closure; censuses workspaces as composed checkouts; writes the census record and the soundness vectors.", "parent": {"bytes": 687868, "path": "docs/implementation/m2/repository-file-inventory.v199.json", "sha256": "239f95f58513c0d8573c7b837ba460acee1099fc3bf329124f70460d63eadb90"}, "selector": {"jsonPointer": "/files/1180/description"}}], "passageSupersessions": [], "selected": "docs/implementation/m3/config-discovery-b/b2-b4-descriptions/successor.json", "sha256": "ce2a7f7ca44b99e547f19668909c8b013fe3a6e537ed87a95efbe24f4ae2ea33"}, {"inputs": [{"bytes": 8457, "path": "docs/implementation/m3/config-discovery-b/b2-c-reference/README.md", "sha256": "9649e60155fff23ed027e563a77f8da6c81af31c5139136688e972dafa4f6e11"}, {"bytes": 18122, "path": "docs/implementation/m3/config-discovery-b/b2-c-reference/evidence/check.py", "sha256": "ea7efcdc47f61c341ef2df3de9579a74215cfb9bdea8e1740750b52b3b1a116d"}, {"bytes": 17003, "path": "docs/implementation/m3/config-discovery-b/b2-c-reference/evidence/checks.json", "sha256": "4cb7fd6fdbf03a8f553f4addbddccf7871628c9a0cc3cc9d44c02e65f870fdb6"}, {"bytes": 13706, "path": "docs/implementation/m3/config-discovery-b/b2-c-reference/reference/native_unit_reference.py", "sha256": "51acab4825d8a7d99090ed544b20c9c18e1ac499c4a988513e366d4e20bd2e8a"}], "passageOverrides": [{"after": "  inventory outside every admitted boundary must appear in the admitted inventory with the SAME `reason` (contract successor B2-c0, LD-B2C0-1: security S3 records a nested repository or project and never enters it, so an anchor at or below an admitted boundary is not compared); a missing", "before": "  inventory must appear in the admitted inventory with the SAME `reason`; a missing", "parent": {"bytes": 329013, "path": "docs/v2/contracts/product-v1/native-evidence.md", "sha256": "83b99783893bec4bcca76bc043310e1d33305fc41ef85e012fbcb19e5b222ca0"}, "selector": {"line": 838}}], "passageSupersessions": [], "selected": "docs/implementation/m3/config-discovery-b/b2-c-reference/successor.json", "sha256": "c84c7a25bf6c384c53ceff84568eec28b03c42b628bcf7708bfc6f08af86bc5d"}, {"inputs": [{"bytes": 13286, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/README.md", "sha256": "1d62434ff596a33c67904e6c75c7cb320797b86c521b7798d48111b8ab24f512"}, {"bytes": 17672, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/admission-registry.json", "sha256": "effe9153eb511e0fd94eb49b7e05b40c8ac3b5eed961b4372b986b1ea9e92d58"}, {"bytes": 56020, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/design/common.schema.json", "sha256": "dbd28a666d96aad947f7ad80f054f190c5b81779ebfbb163c4948d4542e7f539"}, {"bytes": 4254, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/evidence/build_s10_tsc_package.py", "sha256": "c2712dd436a285cd4bbbe99e1b09b50a923ae993dc391460e4377977d06bf64f"}, {"bytes": 12331, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/evidence/check_s10_tsc.py", "sha256": "8cebb37b8081a5c4e6e127c3aa0d25fa6f285521521f0e7da1f022f0ba77fc60"}, {"bytes": 681, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/evidence/checks-r1.log", "sha256": "c3c857249a486372ff01f3bb11667bd74c8fec4006e124dd933be0e61b54e1e5"}, {"bytes": 511, "path": "docs/implementation/m3/config-discovery-b/s10-tsc/evidence/checks-r1/b