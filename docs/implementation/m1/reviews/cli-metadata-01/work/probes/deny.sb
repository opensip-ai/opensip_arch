(version 1)
(allow default)
(deny network*)
(deny file-write* (require-not (literal "/dev/null")) (require-not (literal "/dev/stdout")) (require-not (literal "/dev/stderr")) (require-not (regex #"^/dev/(tty|fd/).*")))
(deny file-read* (subpath "/tmp/opensip-implementation/m1-cli-metadata-review-01/work/probes/fixture"))
(deny file-read* (subpath "/Users"))
