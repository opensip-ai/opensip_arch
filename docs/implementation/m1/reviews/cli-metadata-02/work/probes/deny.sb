(version 1)
(allow default)
(deny network*)
(deny file-write* (require-not (literal "/dev/null")) (require-not (regex #"^/dev/(tty|fd/|stdout|stderr).*")))
(deny file-read* (subpath "/private/tmp/opensip-implementation/m1-cli-metadata-review-02/work/probes/fixture"))
(deny file-read* (subpath "/Users"))
(deny file-read* (subpath "/private/etc"))
