(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/tool-node"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/tool-node") (subpath "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/snapshot/tools/contracts") (subpath "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/prepared") (subpath "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/base"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/tool-node") (path-ancestors "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/snapshot/tools/contracts") (path-ancestors "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/prepared") (path-ancestors "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/base"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/base") (require-not (literal "/private/tmp/opensip-implementation/m1-grok-fresh-consumer-01/review/evidence/generate-fresh/base"))))
