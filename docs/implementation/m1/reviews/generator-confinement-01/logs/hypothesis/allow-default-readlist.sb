(version 1)
(allow default)
(deny file-read-data (require-all (require-not (literal "/")) (require-not (subpath "/System")) (require-not (subpath "/usr/lib")) (require-not (subpath "/usr/share")) (require-not (subpath "/private/var/db/timezone")) (require-not (subpath "/dev")) (require-not (literal "/Users/sb/.nvm/versions/node/v24.16.0/bin/node"))))
