(version 1)
(deny default)
(import "system.sb")
(allow process-exec (literal "/Users/sb/.nvm/versions/node/v24.16.0/bin/node"))
(allow file-read* (literal "/Users/sb/.nvm/versions/node/v24.16.0/bin/node"))
(allow file-read-metadata (require-all (require-not (subpath "/Users")) (require-not (subpath "/private"))))
