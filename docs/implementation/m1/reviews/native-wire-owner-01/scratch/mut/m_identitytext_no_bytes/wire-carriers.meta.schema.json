{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:opensip:m1:native-wire-carriers-input:1",
 "title": "Closed grammar of wire-carriers.v1.json (AUTHOR candidate)",
 "description": "Shape of the declarative carrier input only. It proves nothing about CBOR canonicality, NFC, UTF-8 byte bounds, joins or commitments; check.py and handwritten admission own those. All integer literals are decimal strings. An absent maxItems/maxBytes/maxScalars/maxUtf8Bytes means bounded only by the protocol's maxFramePayloadBytes (admission FRAME-LIMIT).",
 "type": "object",
 "additionalProperties": false,
 "required": ["artifact", "version", "standing", "sourcePins", "typeGrammar", "profiles", "privateRepresentation", "scalars", "records", "preimageOnlyRecords", "protocols", "admission", "commitmentMap"],
 "properties": {
  "artifact": {"const": "opensip.m1.native-wire-carriers"},
  "version": {"const": "1"},
  "standing": {"type": "string"},
  "typeGrammar": {"const": "wire-carriers.meta.schema.json"},
  "sourcePins": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "path", "sha256", "bytes"], "properties": {"key": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hex64"}, "bytes": {"type": "integer", "minimum": 0}}}},
  "profiles": {"type": "object", "required": ["ts2-cbor", "rust3-cbor", "mapOrderEquivalence", "notProvedByJsonSchema"]},
  "privateRepresentation": {"type": "object", "required": ["uint64", "text", "bytes", "bool", "null", "nullable", "optional", "array", "enum", "const", "record", "variant-record", "alias", "extern", "frame-payload", "selectors", "namespaces", "orders"]},
  "scalars": {"type": "object", "propertyNames": {"$ref": "#/$defs/typeName"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": {"type": {"$ref": "#/$defs/scalarType"}, "source": {"$ref": "#/$defs/source"}, "sameShapeAs": {"type": "string"}, "note": {"type": "string"}}}},
  "records": {"type": "object", "propertyNames": {"$ref": "#/$defs/typeName"}, "additionalProperties": {"oneOf": [{"$ref": "#/$defs/record"}, {"$ref": "#/$defs/variantRecord"}, {"$ref": "#/$defs/alias"}]}},
  "preimageOnlyRecords": {"type": "array", "items": {"$ref": "#/$defs/typeName"}, "uniqueItems": true},
  "protocols": {"type": "object", "additionalProperties": false, "required": ["typescript-semantic", "rust-semantic"], "properties": {"typescript-semantic": {"$ref": "#/$defs/protocol"}, "rust-semantic": {"$ref": "#/$defs/protocol"}}},
  "admission": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "appliesTo", "kind", "rule", "owner"], "properties": {"id": {"type": "string", "pattern": "^[A-Z0-9-]+$"}, "appliesTo": {"enum": ["both", "typescript-semantic", "rust-semantic"]}, "kind": {"enum": ["bound", "state", "echo", "join", "order", "commitment", "shape"]}, "rule": {"type": "string"}, "owner": {"type": "string"}}}},
  "commitmentMap": {"type": "object", "required": ["function", "rows", "basis"]}
 },
 "$defs": {
  "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "dec": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
  "typeName": {"type": "string", "pattern": "^(Ts2|Rust3)[A-Z][A-Za-z0-9]*$"},
  "source": {"type": "object", "additionalProperties": false, "required": ["pin", "selector"], "properties": {"pin": {"type": "string"}, "selector": {"type": "string"}}},
  "scalarType": {"oneOf": [{"$ref": "#/$defs/tUint"}, {"$ref": "#/$defs/tText"}, {"$ref": "#/$defs/tBytes"}, {"$ref": "#/$defs/tBool"}, {"$ref": "#/$defs/tNull"}]},
  "tUint": {"type": "object", "additionalProperties": false, "required": ["t"], "properties": {"t": {"const": "uint64"}, "min": {"$ref": "#/$defs/dec"}, "max": {"$ref": "#/$defs/dec"}, "const": {"$ref": "#/$defs/dec"}}},
  "tText": {"type": "object", "additionalProperties": false, "required": ["t", "nfc"], "properties": {"t": {"const": "text"}, "nfc": {"const": true}, "minScalars": {"$ref": "#/$defs/dec"}, "maxScalars": {"$ref": "#/$defs/dec"}, "maxUtf8Bytes": {"$ref": "#/$defs/dec"}, "pattern": {"type": "string"}, "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "const": {"type": "string"}, "forbidC0C1": {"const": true}}},
  "tBytes": {"type": "object", "additionalProperties": false, "required": ["t", "minBytes", "maxBytes"], "properties": {"t": {"const": "bytes"}, "minBytes": {"$ref": "#/$defs/dec"}, "maxBytes": {"$ref": "#/$defs/dec"}}},
  "tBool": {"type": "object", "additionalProperties": false, "required": ["t"], "properties": {"t": {"const": "bool"}, "const": {"type": "boolean"}}},
  "tNull": {"type": "object", "additionalProperties": false, "required": ["t"], "properties": {"t": {"const": "null"}}},
  "tArray": {"type": "object", "additionalProperties": false, "required": ["t", "items", "minItems", "order"], "properties": {"t": {"const": "array"}, "items": {"$ref": "#/$defs/type"}, "minItems": {"$ref": "#/$defs/dec"}, "maxItems": {"$ref": "#/$defs/dec"}, "order": {"type": "string"}}},
  "tRef": {"type": "object", "additionalProperties": false, "required": ["t", "ref"], "properties": {"t": {"const": "ref"}, "ref": {"$ref": "#/$defs/typeName"}}},
  "tExtern": {"type": "object", "additionalProperties": false, "required": ["t", "schemaRef", "generatedType"], "properties": {"t": {"const": "extern"}, "schemaRef": {"type": "string", "pattern": "#"}, "generatedType": {"type": "string", "pattern": "^(Handshake1|Startup1|Native2|Occupancy1)[A-Za-z0-9]+$"}}},
  "tNullable": {"type": "object", "additionalProperties": false, "required": ["t", "of"], "properties": {"t": {"const": "nullable"}, "of": {"$ref": "#/$defs/type"}}},
  "tFramePayload": {"type": "object", "additionalProperties": false, "required": ["t", "protocol"], "properties": {"t": {"const": "frame-payload"}, "protocol": {"enum": ["typescript-semantic", "rust-semantic"]}}},
  "type": {"oneOf": [{"$ref": "#/$defs/tUint"}, {"$ref": "#/$defs/tText"}, {"$ref": "#/$defs/tBytes"}, {"$ref": "#/$defs/tBool"}, {"$ref": "#/$defs/tNull"}, {"$ref": "#/$defs/tArray"}, {"$ref": "#/$defs/tRef"}, {"$ref": "#/$defs/tExtern"}, {"$ref": "#/$defs/tNullable"}, {"$ref": "#/$defs/tFramePayload"}]},
  "member": {"type": "object", "additionalProperties": false, "required": ["name", "type", "presence"], "properties": {"name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}, "type": {"$ref": "#/$defs/type"}, "presence": {"enum": ["required", "optional"]}, "note": {"type": "string"}}},
  "record": {"type": "object", "additionalProperties": false, "required": ["kind", "members", "source", "admission"], "properties": {"kind": {"const": "record"}, "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}}, "source": {"$ref": "#/$defs/source"}, "admission": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}},
  "variantRecord": {"type": "object", "additionalProperties": false, "required": ["kind", "discriminator", "memberOrder", "variants", "source", "admission"], "properties": {"kind": {"const": "variant-record"}, "discriminator": {"type": "string"}, "memberOrder": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "variants": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/type"}}}, "source": {"$ref": "#/$defs/source"}, "admission": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}},
  "alias": {"type": "object", "additionalProperties": false, "required": ["kind", "target", "source"], "properties": {"kind": {"const": "alias"}, "target": {"$ref": "#/$defs/tExtern"}, "source": {"$ref": "#/$defs/source"}, "note": {"type": "string"}}},
  "selection": {"type": "object", "additionalProperties": false, "required": ["select", "alternatives"], "properties": {"select": {"enum": ["negotiated-target-attribution-v2", "host-phase"]}, "alternatives": {"type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": {"$ref": "#/$defs/type"}}}},
  "protocol": {"type": "object", "additionalProperties": false, "required": ["major", "profile", "envelope", "frames", "limits", "transitions"], "properties": {"major": {"$ref": "#/$defs/dec"}, "profile": {"enum": ["ts2-cbor", "rust3-cbor"]}, "envelope": {"$ref": "#/$defs/typeName"}, "frames": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frameType", "direction", "workerTerminal", "payload"], "properties": {"frameType": {"type": "string"}, "direction": {"enum": ["host-to-worker", "worker-to-host"]}, "workerTerminal": {"type": "boolean"}, "payload": {"oneOf": [{"$ref": "#/$defs/type"}, {"$ref": "#/$defs/selection"}]}}}}, "limits": {"type": "string"}, "transitions": {"type": "object"}}}
 }
}
