{
  "subject": "m1-workflow-timing-subject-01",
  "probes": [
    {
      "id": "TIM-D0",
      "kind": "derivation",
      "expectation": "fixture ExecutionId valid under pinned common",
      "observed": {
        "pattern": "^exec1_[0-9a-f]{32}(?![\\s\\S])",
        "fixture": "exec1_11111111111111111111111111111111"
      },
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-C1",
      "kind": "control-valid",
      "expectation": "completed + measured Attempt valid under v4",
      "observed": null,
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-C2",
      "kind": "control-invalid",
      "expectation": "v4 Attempt without observedDuration invalid; not-retained invalid",
      "observed": null,
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-C3",
      "kind": "control-valid",
      "expectation": "20000 random (origin, delta) pairs equal floor(delta/1e6) or overflow",
      "observed": {
        "mismatches": []
      },
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-C4",
      "kind": "control-valid",
      "expectation": "abandoned never measured; supervisor-lost only for abandoned (reference helper)",
      "observed": null,
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-F1",
      "kind": "finding",
      "expectation": "invocation:4 Attempt schema enforces the contract outcome/reason law",
      "observed": {
        "abandoned+measured": true,
        "completed+supervisor-lost": true,
        "abandoned+clock-unavailable": true
      },
      "expectationHolds": true,
      "note": "Attempt already uses allOf if/then (installationRecoveryStartRef); the join exists only in timing.admit_duration"
    },
    {
      "id": "TIM-F2",
      "kind": "finding",
      "expectation": "malformed caller types are admission errors, not clock states (contract)",
      "observed": [
        {
          "returned": {
            "state": "unavailable",
            "reason": "clock-unavailable"
          }
        },
        {
          "returned": {
            "state": "unavailable",
            "reason": "clock-unavailable"
          }
        },
        {
          "returned": {
            "state": "unavailable",
            "reason": "clock-unavailable"
          }
        }
      ],
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-F3",
      "kind": "finding",
      "expectation": "step sum refuses unadmitted/duplicate-ExecutionId/negative projections",
      "observed": [
        {
          "raised": "KeyError",
          "message": "'milliseconds'"
        },
        {
          "returned": {
            "state": "measured",
            "attemptCount": 2,
            "milliseconds": 2
          }
        },
        {
          "returned": {
            "state": "measured",
            "attemptCount": 1,
            "milliseconds": -5
          }
        }
      ],
      "expectationHolds": true,
      "note": ""
    },
    {
      "id": "TIM-F4",
      "kind": "finding",
      "expectation": "retained older majors map to a disclosed report state rather than a projection refusal",
      "observed": {
        "legacyMajor": {
          "const": 1
        },
        "projection": {
          "raised": "TimingRefusal",
          "message": "unsupported invocation source major"
        },
        "reportIncompatibleState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "incompatible"
            },
            "reason": {
              "const": "retained-schema-major-unsupported"
            },
            "detail": {
              "$ref": "urn:opensip:product-v1:workflows:evaluator3:common:3#/$defs/DomainDetail"
            }
          }
        }
      },
      "expectationHolds": true,
      "note": "contract \"Other source majors are refused\" leaves the ledger state for retained major-1 records unowned"
    },
    {
      "id": "TIM-D1",
      "kind": "derivation",
      "expectation": "report LedgerStepV1 attempts still $ref invocation:3 and have no duration member",
      "observed": [
        "executionId",
        "faultCause",
        "outcome",
        "retried"
      ],
      "expectationHolds": true,
      "note": ""
    }
  ],
  "controlsHold": true,
  "findingsReproduced": [
    "TIM-F1",
    "TIM-F2",
    "TIM-F3",
    "TIM-F4"
  ]
