{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "entries",
    "entriesProjection",
    "provenance"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "evidenceId"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence3:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 3956,
      "x-opensip-order": "sequence",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coverageId",
          "descriptor",
          "result"
        ],
        "properties": {
          "coverageId": {
            "type": "string",
            "pattern": "^coverage2:[0-9a-f]{64}(?![\\s\\S])"
          },
          "descriptor": {
            "$ref": "urn:opensip:product-v1:identity:v3#/$defs/coverage"
          },
          "result": {
            "$ref": "urn:opensip:product-v1:native:evidence-schemas:v2#/$defs/CoverageResultV3"
          }
        }
      }
    },
    "entriesProjection": {
      "$ref": "urn:opensip:product-v1:workflows:evaluator3:report-projection:1#/$defs/ItemProjectionV1"
    },
    "provenance": {
      "const": {
        "verifiedInDocument": [
          "entry-coverage-ids-unique-and-in-canonical-order",
          "entry-descriptor-and-payload-identities-match",
          "entry-payload-schema-is-selected-native-document",
          "item-counts-consistent",
          "rejected-whole-row-delta-arithmetic"
        ],
        "hostAsserted": [
          "source-is-exact-admitted-run-evidence",
          "entries-are-canonical-prefix-of-source-evidence-coverage-ids",
          "total-is-source-evidence-coverage-id-count",
          "rejected-whole-row-byte-measurement"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:implementation:report-coverage-budget:experiment:1",
  "description": "Unaccepted source-bound coverage/shared-prefix integration experiment; no final report carrier version or product host selected."
}
