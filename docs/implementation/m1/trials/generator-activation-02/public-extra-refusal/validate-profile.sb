(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/tool-node"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/tool-node") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/snapshot/tools/contracts") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/prepared") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/runtime"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/tool-node") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/snapshot/tools/contracts") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/prepared") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/runtime"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/runtime") (require-not (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-extra-refusal/runtime"))))
