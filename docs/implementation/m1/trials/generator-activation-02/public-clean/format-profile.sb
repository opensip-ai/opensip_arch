(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-generator"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-generator") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/protocol-unformatted.rs") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly/output"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-generator") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/protocol-unformatted.rs") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly/output"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly/output") (require-not (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly/output"))))
