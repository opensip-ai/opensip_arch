(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-node"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-node") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/snapshot/tools/contracts") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/base") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/native-work/generated") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/prepared") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/tool-node") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/snapshot/tools/contracts") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/base") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/native-work/generated") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/prepared") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly") (require-not (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-clean/assembly"))))
