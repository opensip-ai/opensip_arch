(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/tool-node"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/tool-node") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/snapshot/tools/contracts") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/base") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/native-work/generated") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/prepared") (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/assembly"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/tool-node") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/snapshot/tools/contracts") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/base") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/native-work/generated") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/prepared") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/assembly"))
(allow file-write* (require-all (subpath "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/assembly") (require-not (literal "/private/tmp/opensip-implementation/m1-generator-activation-02/public-drift/assembly"))))
