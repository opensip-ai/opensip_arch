b45"}, {"bytes": 6862, "path": "docs/implementation/m1/source-selection-v2/semantic-owner-joins.json", "sha256": "57a2ced48d76fa72c14ab5ad3d64745c81fd058ef38448cfa591604642cdb5a8"}, {"bytes": 22202, "path": "docs/implementation/m1/source-selection-v2/source-map.json", "sha256": "b997e33442a80719a366ecf964ea1f06751693ecff04c0ae5ea35f52920afd4a"}, {"bytes": 1854, "path": "docs/implementation/m1/source-selection-v3/README.md", "sha256": "781924809303faa3bb20d05a7ba9609b0c99ec1ce840e9c1d049340e1e13a29f"}, {"bytes": 6492, "path": "docs/implementation/m1/source-selection-v3/check_binding.py", "sha256": "254dc11248acbaf7ae6c9ff4893df6a283163e1e23962627ba27b4361625c2c0"}, {"bytes": 1587, "path": "docs/implementation/m1/source-selection-v3/correction.json", "sha256": "e27a834596136c6b5c7c7f89e1d48cb02ec941b9e20e3a11aa4727556c217c52"}], "passageOverrides": [{"after": "For finite CLI commands, CommandEnvelope.termination equals process termination when complete envelope admission, serialization and required delivery succeed. If required output fails, the existing machine-output-serialization-failed operation governs process termination (OUTPUT.SERIALIZATION_FAILED, operational-failed, exit4), even after an interrupted invocation aggregate. The earlier invocation aggregate, step results and committed Runs are preserved. Partial or complete earlier envelope bytes may already be visible; do not append a second normal envelope or claim atomic stream delivery. Required render-step failures retain their own DELIVERY.REQUIRED_FAILED law before this final operation.", "before": "For finite CLI commands, CommandEnvelope.termination equals process termination when serialization succeeds.", "parent": {"bytes": 131140, "path": "docs/coop/artifacts/d9-exit-contract.v1.14.json", "sha256": "8dd3303855f49bfdbb2751ee65f54a906405f0654159ebe815472f73cdf7da31"}, "selector": {"jsonPointer": "/invariants/1/text"}}, {"after": "        committed = [r['result']['runId'] for r in results if r['outcome'] == 'completed' and r.get('result', {}).get('runId')]", "before": "        committed = [r['result']['runId'] for r in required if r['outcome'] == 'completed' and r.get('result', {}).get('runId')]", "parent": {"bytes": 142811, "path": "docs/coop/design-corrections/workflows/workflows_model.v1.py", "sha256": "be37023f173f339edcd49b2019a2c6f3d424360a2c9cdcbf95bd382fa72066dc"}, "selector": {"line": 380}}], "selected": "docs/implementation/m1/source-selection-v3/successor.json", "sha256": "e638c55c3e0c807fe4540c5c0ea2e462886fc25ef5e2ee7df55efe28d3784ae4"}], "inputsVerified": 46, "inventoryPassageInheritance": [{"after": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded metadata covered by the enclosing signed host/release artifact and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "before": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded signed release descriptor and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "parent": {"bytes": 87766, "path": "docs/implementation/m1/repository-file-inventory.v4.json", "sha256": "c6c85fb8adfe6cdf50dc7b07b7f1e0816275e3e00eb7307e1acb8c1568fe84f5"}, "selector": {"jsonPointer": "/files/7/description"}}], "inventorySuccessors": [{"addedFiles": 4, "parent": "docs/v2/architecture/repository-file-inventory.v1.json", "selected": "docs/implementation/m1/repository-file-inventory.v3.json", "sha256": "63027fb69f55b6fd65f3cb5baa89d355736239060bfa2750f3137e93cbb716ee"}, {"addedFiles": 44, "parent": "docs/implementation/m1/repository-file-inventory.v3.json", "selected": "docs/implementation/m1/repository-file-inventory.v4.json", "sha256": "c6c85fb8adfe6cdf50dc7b07b7f1e0816275e3e00eb7307e1acb8c1568fe84f5"}], "passed": true, "productQualification": false, "selectedInventory": {"bytes": 87766, "path": "docs/implementation/m1/repository-file-inventory.v4.json", "sha256": "c6c85fb8adfe6cdf50dc7b07b7f1e0816275e3e00eb7307e1acb8c1568fe84f5"}}
