(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny network-outbound (literal "/private/var/run/syslog"))
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-network-denial-04/probe"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-network-denial-04/probe") (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-04") (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-04/out"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-04/probe") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-04") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-04/out"))
(allow file-write* (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-04/out"))
