(version 1)
(deny default)
(import "system.sb")
(deny network*)
(deny file-read* (literal "/private/etc/passwd") (literal "/private/etc/master.passwd"))
(deny file-write* (subpath "/cores"))
(allow process-exec (literal "/private/tmp/opensip-implementation/m1-generator-network-denial-03/probe"))
(allow file-read* (literal "/private/tmp/opensip-implementation/m1-generator-network-denial-03/probe") (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-03") (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-03/out"))
(allow file-read-metadata (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-03/probe") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-03") (path-ancestors "/private/tmp/opensip-implementation/m1-generator-network-denial-03/out"))
(allow file-write* (subpath "/private/tmp/opensip-implementation/m1-generator-network-denial-03/out"))
