ces": {"executedGeneratorCode": false, "productQualification": false, "sourcesVerified": 40}, "inputsVerified": 46, "inventoryPassageInheritance": [{"after": "Declare pinned browser report build dependencies: TypeScript6.0.3 and esbuild0.28.2, with native DOM modules and an offline self-contained deliverable.", "before": "Declare report build dependencies and scripts; frontend framework and bundler remain undecided.", "parent": {"bytes": 121810, "path": "docs/implementation/m1/repository-file-inventory.v10.json", "sha256": "6608fabd31f1fb89feb565ad5b930c4be49f096a30dd92ecdc21466251fd8bc9"}, "selector": {"jsonPointer": "/files/13/description"}}, {"after": "Coordinate explicit maintenance scripts without npm workspace hoisting; select npm11.13.0 with independent per-package locks and Node24.16.0.", "before": "Declare TypeScript workspace membership and common script names; package manager and its lockfile remain to be selected.", "parent": {"bytes": 121810, "path": "docs/implementation/m1/repository-file-inventory.v10.json", "sha256": "6608fabd31f1fb89feb565ad5b930c4be49f096a30dd92ecdc21466251fd8bc9"}, "selector": {"jsonPointer": "/files/158/description"}}, {"after": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded metadata covered by the enclosing signed host/release artifact and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "before": "Assemble command-scoped host services lazily; help/version must not open a project, store or component session or access the network. For version metadata, read the build-embedded signed release descriptor and its exact declared closure IDs without opening a component/project/store session; do not claim these are currently loaded closures.", "parent": {"bytes": 121810, "path": "docs/implementation/m1/repository-file-inv