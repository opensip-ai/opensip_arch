{
  "standing": "Unaccepted owner fragments, not a selected schema major or complete report integration",
  "invocation": {
    "addDef": {
      "FitQueryFromAnalysisParams": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "operation",
          "sourceStep"
        ],
        "properties": {
          "kind": {
            "const": "query"
          },
          "operation": {
            "const": "candidate.list"
          },
          "sourceStep": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        }
      }
    },
    "appendQueryParamsOneOf": {
      "$ref": "#/$defs/FitQueryFromAnalysisParams"
    }
  },
  "envelope": {
    "appendFitAdvisoryReportOneOf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "queryOutcome",
        "parity"
      ],
      "properties": {
        "state": {
          "const": "unavailable-query-result"
        },
        "queryOutcome": {
          "enum": [
            "cancelled",
            "skipped",
            "failed",
            "rejected"
          ]
        },
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "candidates",
            "evidenceLevels",
            "candidatesTruncated",
            "candidatesTotalItems",
            "candidatesNextCursor",
            "candidatesAvailability"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
            },
            "candidates": {
              "type": "null"
            },
            "evidenceLevels": {
              "type": "null"
            },
            "candidatesTruncated": {
              "type": "null"
            },
            "candidatesTotalItems": {
              "type": "null"
            },
            "candidatesNextCursor": {
              "type": "null"
            },
            "candidatesAvailability": {
              "const": "unavailable-query-result"
            }
          }
        }
      }
    },
    "appendRootAllOf": {
      "if": {
        "required": [
          "advisoryReport"
        ],
        "properties": {
          "advisoryReport": {
            "properties": {
              "state": {
                "const": "unavailable-query-result"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "run"
          },
          "termination": {
            "properties": {
              "class": {
                "const": "interrupted"
              }
            }
          },
          "run": {
            "required": [
              "runId"
            ],
            "properties": {
              "authority": {
                "const": "authoritative"
              }
            }
          }
        }
      }
    }
  },
  "semanticJoins": [
    "source step is earlier analysis and explicit completed dependency",
    "resolve project from invocation and exact Run from source result",
    "completed response binds request/step/attempt and exact query summary",
    "unavailable query outcome matches actual noncompleted query",
    "RunId and all null parity fields match interrupted run carrier"
  ],
  "finalSourceDuties": [
    "Choose and bind invocation/envelope successor majors",
    "Compose timing and interruption successors",
    "Update builtin planning grammar, query dispatcher and inventory descriptions",
    "Update report builder, admission and every parity rendering",
    "Implement private completion response custody"
  ]
}
