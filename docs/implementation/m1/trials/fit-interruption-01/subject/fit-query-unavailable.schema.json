{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "queryOutcome",
    "parity"
  ],
  "properties": {
    "state": {
      "const": "unavailable-query-result"
    },
    "queryOutcome": {
      "enum": [
        "cancelled",
        "skipped",
        "failed",
        "rejected"
      ]
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "candidates",
        "evidenceLevels",
        "candidatesTruncated",
        "candidatesTotalItems",
        "candidatesNextCursor",
        "candidatesAvailability"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^run3:[0-9a-f]{64}(?![\\s\\S])"
        },
        "candidates": {
          "type": "null"
        },
        "evidenceLevels": {
          "type": "null"
        },
        "candidatesTruncated": {
          "type": "null"
        },
        "candidatesTotalItems": {
          "type": "null"
        },
        "candidatesNextCursor": {
          "type": "null"
        },
        "candidatesAvailability": {
          "const": "unavailable-query-result"
        }
      }
    }
  }
}
