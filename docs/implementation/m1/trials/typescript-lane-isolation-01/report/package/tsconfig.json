{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "dist/modules",
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
