{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensip:design:component-source-model:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "source",
    "producerClosureId",
    "format",
    "state",
    "regions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentSha256",
        "byteLength"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "producerClosureId": {
      "type": "string",
      "pattern": "^closure2:[0-9a-f]{64}(?![\\s\\S])"
    },
    "format": {
      "enum": [
        "vue",
        "svelte",
        "astro",
        "css",
        "typescript",
        "javascript",
        "rust"
      ]
    },
    "state": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "regions": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "kind",
        "language",
        "startByte",
        "endByte",
        "state",
        "blockers",
        "derived"
      ],
      "properties": {
        "regionId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "kind": {
          "enum": [
            "whole",
            "container",
            "script",
            "template",
            "style",
            "unmapped"
          ]
        },
        "language": {
          "enum": [
            "typescript",
            "javascript",
            "rust",
            "css",
            "component-markup",
            "vue-template",
            "svelte-template",
            "astro-template",
            "unknown"
          ]
        },
        "startByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "endByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "unsupported",
            "malformed"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 9,
          "items": {
            "enum": [
              "grammar-unavailable",
              "unsupported-syntax",
              "preprocessor-unavailable",
              "dynamic-component",
              "dynamic-class",
              "invalid-source-map",
              "malformed-source",
              "config-requires-evaluation",
              "unmapped-region"
            ]
          }
        },
        "derived": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/derived"
            }
          ]
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byteLength",
        "segments"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "segments": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "derivedStart",
        "derivedEnd",
        "sourceStart",
        "sourceEnd"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "anchor",
            "generated"
          ]
        },
        "derivedStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "derivedEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sourceStart": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceEnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "x-opensip-standing": "Extraction intermediate only. No fact, Coverage, Run, new identifier domain or capability authority."
}
